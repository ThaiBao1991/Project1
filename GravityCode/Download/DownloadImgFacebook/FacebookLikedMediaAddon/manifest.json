{
  "manifest_version": 3,
  "name": "FB Liked Media Downloader & Unlike",
  "version": "1.0.0",
  "description": "Tự động tải ảnh & video bài viết đã thích trên Facebook (bỏ qua bài > 500 ký tự) và hủy thích.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "http://127.0.0.1:48765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Liked Media Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
