{
  "name": "Custom TikTok Downloader (Stop on Error)",
  "version": "1.12.84.1",
  "description": "Custom TikTok Downloader with Fast Auto-Skip & Python Queue (Side-by-Side Edition)",
  "manifest_version": 3,
  "action": {
    "default_title": "Custom TikTok Downloader"
  },
  "background": {
    "service_worker": "b.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "c.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "<all_urls>"
      ],
      "resources": [
        "rl.html",
        "s.js",
        "ui/*",
        "ui/assets/*"
      ]
    }
  ],
  "icons": {
    "256": "icon-256.png"
  },
  "permissions": [
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tiktok.com/api/*favorite/item_list*",
    "https://*.tiktok.com/api/*user/collect/item_list*",
    "https://*.tiktok.com/api/*user/list*",
    "https://*.tiktok.com/api/*post/item_list*"
  ]
}