{
   "action": {
      "default_title": "myfaveTT"
   },
   "background": {
      "service_worker": "b.js"
   },
   "content_scripts": [ {
      "css": [ "style.css" ],
      "js": [ "c.js" ],
      "matches": [ "https://www.tiktok.com/*" ]
   } ],
   "description": "A tiktok downloader to export all your Likes, Favorites, and Follows to MP4s for safekeeping.",
   "host_permissions": [ "https://*.tiktok.com/api/post/item_list/" ],
   "icons": {
      "256": "icon-256.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "myfaveTT - download all TikToks you've loved",
   "permissions": [ "webRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.12.84",
   "web_accessible_resources": [ {
      "matches": [ "https://www.tiktok.com/*" ],
      "resources": [ "rl.html", "s.js" ]
   } ]
}
