a nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 426","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"blätterを 使います。","line_vi":"Tôi dùng blätter.","focus_words":["blätter"]},{"speaker":"B","line_target":"börse は 何ですか。","line_vi":"börse là cái gì?","focus_words":["börse"]},{"speaker":"A","line_target":"büchernです。","line_vi":"Đó là büchern.","focus_words":["büchern"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_86d46ef7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「blätter」 có nghĩa là gì?","options":["lá","sở giao dịch chứng khoán","sách","sau đó"],"answer_index":0,"explanation":"blätter = lá"},{"question":"Từ 「börse」 có nghĩa là gì?","options":["sở giao dịch chứng khoán","lá","sách","sau đó"],"answer_index":0,"explanation":"börse = sở giao dịch chứng khoán"},{"question":"Từ 「büchern」 có nghĩa là gì?","options":["sách","lá","sở giao dịch chứng khoán","sau đó"],"answer_index":0,"explanation":"büchern = sách"},{"question":"Từ 「dan」 có nghĩa là gì?","options":["sau đó","lá","sở giao dịch chứng khoán","sách"],"answer_index":0,"explanation":"dan = sau đó"},{"question":"Từ 「dicken」 có nghĩa là gì?","options":["dày","lá","sở giao dịch chứng khoán","sách"],"answer_index":0,"explanation":"dicken = dày"},{"question":"Từ 「donald」 có nghĩa là gì?","options":["Donald","lá","sở giao dịch chứng khoán","sách"],"answer_index":0,"explanation":"donald = Donald"},{"question":"Từ 「doof」 có nghĩa là gì?","options":["ngu ngố