":[{"question":"Chọn từ đúng cho nghĩa: công chúa","options":["princess","promo","provence","prächtige"],"answer_index":0,"explanation":"princess = công chúa"},{"question":"Chọn từ đúng cho nghĩa: khuyến mãi","options":["promo","princess","provence","prächtige"],"answer_index":0,"explanation":"promo = khuyến mãi"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}