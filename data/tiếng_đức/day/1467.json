ferences":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1467","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"coreを 使います。","line_vi":"Tôi dùng core.","focus_words":["core"]},{"speaker":"B","line_target":"curry は 何ですか。","line_vi":"curry là cái gì?","focus_words":["curry"]},{"speaker":"A","line_target":"damaskusです。","line_vi":"Đó là damaskus.","focus_words":["damaskus"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「core」 có nghĩa là gì?","options":["cốt lõi","cà ri","Damacus","sự thông giải"],"answer_index":0,"explanation":"core = cốt lõi"},{"question":"Từ 「curry」 có nghĩa là gì?","options":["cà ri","cốt lõi","Damacus","sự thông giải"],"answer_index":0,"explanation":"curry = cà ri"},{"question":"Từ 「damaskus」 có nghĩa là gì?","options":["Damacus","cốt lõi","cà ri","sự thông giải"],"answer_index":0,"explanation":"damaskus = Damacus"},{"question":"Từ 「deutung」 có nghĩa là gì?","options":["sự thông giải","cốt lõi","cà ri","Damacus"],"answer_index":0,"explanation":"deutung = sự thông giải"},{"question":"Từ 「dezent」 có nghĩa là gì?","options":["tinh tế","cốt lõi","cà ri","Damacus"],"answer_index":0,"explanation":"dezent = tinh tế"},{"question":"Từ 「digitaler」 có nghĩa là gì?","options":["kỹ thuật số hơn","cốt lõi","cà ri","Damacus"],"answer_index":0,"explanation":"digitaler = kỹ thuật số hơn"},{"question":"Từ 「doppelter」 có nghĩa là gì?","options":["gấp đôi","cốt lõi","cà ri","Damacus"],"answer_index":0,"explanation":"doppelter = gấp đôi"},{"question":"Từ 「dreist」 có nghĩa là gì?","options":["thô lỗ","cốt lõi","cà ri","Damacus"],"answer_index":0,"explanation":"dreist = thô lỗ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cốt lõi","options":["core","curry","damaskus","deutung"],"answer_i