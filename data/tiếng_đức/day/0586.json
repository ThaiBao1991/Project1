ence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 586","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"bildschirmを 使います。","line_vi":"Tôi dùng bildschirm.","focus_words":["bildschirm"]},{"speaker":"B","line_target":"braut は 何ですか。","line_vi":"braut là cái gì?","focus_words":["braut"]},{"speaker":"A","line_target":"charaktereです。","line_vi":"Đó là charaktere.","focus_words":["charaktere"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4830a963","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「bildschirm」 có nghĩa là gì?","options":["màn hình","cô dâu","nhân vật","đã cài đặt"],"answer_index":0,"explanation":"bildschirm = màn hình"},{"question":"Từ 「braut」 có nghĩa là gì?","options":["cô dâu","màn hình","nhân vật","đã cài đặt"],"answer_index":0,"explanation":"braut = cô dâu"},{"question":"Từ 「charaktere」 có nghĩa là gì?","options":["nhân vật","màn hình","cô dâu","đã cài đặt"],"answer_index":0,"explanation":"charaktere = nhân vật"},{"question":"Từ 「eingebaut」 có nghĩa là gì?","options":["đã cài đặt","màn hình","cô dâu","nhân vật"],"answer_index":0,"explanation":"eingebaut = đã cài đặt"},{"question":"Từ 「eishockey」 có nghĩa là gì?","options":["khúc côn cầu trên băng","màn hình","cô dâu","nhân vật"],"answer_index":0,"explanation":"eishockey = khúc côn cầu trên băng"},{"question":"Từ 「elbe」 có nghĩa là gì?","options":["giống nhau","màn hình","cô dâu","nhân vật"],"answer_index":0,"explanation":"elbe = giống nhau"},{"question":"Từ 「ensemble」 có nghĩa là gì?","options":["quần thể","màn hình","cô dâu","nhân vật"],"answer_index":0,"explanation":"ensemble = quần thể"},{"question":"Từ 「evangelische」 có nghĩa là gì?","options":["truyền giáo","màn hình","cô dâu","nhân vật"],"answer_index":0,"explanation":"evangelische = truyền giáo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: màn hình","options":["bildschirm","braut","charaktere","eingebaut"],"answer_index":0,"explanation":"bildschirm = màn hình"},{"question":"Chọn từ đúng cho nghĩa: cô dâu","options":["braut","bildschirm","charaktere","eingebaut"],"answer_index":0,"explanation":"braut = cô dâu"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"bildschirm":"m_5b31a772","braut":"m_68bf25c7","charaktere":"m_e78d30e6","eingebaut":"m_9f873e80","eishockey":"m_1f11a5e2","elbe":"m_2da1606f","ensemble":"m_98c9c8b6","evangelische":"m_b034ed36","extreme":"m_c42f53e8","feierte":"m_bc789bd3"},"dialogue_audio":{"0":"m_4830a963"}},"media_map":{"m_a05ce6d0":"media/tiếng_đức/d0586/word_00_81e6e208.webp","m_67cb4443":"media/tiếng_đức/d0586/word_01_fa8c26fe.webp","m_8d0ab202":"media/tiếng_đức/d0586/word_02_217aaf63.webp","m_68f18e81":"media/tiếng_đức/d0586/word_03_5aeebad3.webp","m_49582b0c":"media/tiếng_đức/d0586/word_04_b4d4c278.webp","m_efc1e2fa":"media/tiếng_đức/d0586/word_05_40054274.webp","m_60b22706":"media/tiếng_đức/d0586/word_06_eac8e865.webp","m_b91f5b3b":"media/tiếng_đức/d0586/word_07_64b8f1ae.webp","m_861baa8b":"media/tiếng_đức/d0586/word_08_1cfb3b73.webp","m_c78e9fd7":"media/tiếng_đức/d0586/word_09_bdfcedc7.webp","m_5b31a772":"media/tiếng_đức/d0586/audio_vocab_00_e37ebb72.mp3","m_a2a5cfce":"media/tiếng_đức/d0586/audio_vocab_00_vi_d8f3f8e1.mp3","m_68bf25c7":"media/tiếng_đức/d0586/audio_vocab_01_63cdd7a9.mp3","m_2908343b":"media/tiếng_đức/d0586/audio_vocab_01_vi_63cdd7a9.mp3","m_e78d30e6":"media/tiếng_đức/d0586/audio_vocab_02_9ba444d6.mp3","m_a433696a":"media/tiếng_đức/d0586/audio_vocab_02_vi_9ba444d6.mp3","m_9f873e80":"medi