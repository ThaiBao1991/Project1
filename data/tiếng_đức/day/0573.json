ation":"Chúa Kitô","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_894dc5e6","audio_ref":"m_4d6c5afb","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_883b5fce"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanatio