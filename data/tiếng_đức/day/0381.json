:"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 381","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"blockを 使います。","line_vi":"Tôi dùng block.","focus_words":["block"]},{"speaker":"B","line_target":"bochum は 何ですか。","line_vi":"bochum là cái gì?","focus_words":["bochum"]},{"speaker":"A","line_target":"dialogです。","line_vi":"Đó là dialog.","focus_words":["dialog"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_be4c32ee","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「block」 có nghĩa là gì?","options":["khối","bochum","đối thoại","thảo luận"],"answer_index":0,"explanation":"block = khối"},{"question":"Từ 「bochum」 có nghĩa là gì?","options":["bochum","khối","đối thoại","thảo luận"],"answer_index":0,"explanation":"bochum = bochum"},{"question":"Từ 「dialog」 có nghĩa là gì?","options":["đối thoại","khối","bochum","thảo luận"],"answer_index":0,"explanation":"dialog = đối thoại"},{"question":"Từ 「diskussionen」 có nghĩa là gì?","options":["thảo luận","khối","bochum","đối thoại"],"answer_index":0,"explanation":"diskussionen = thảo luận"},{"question":"Từ 「dunkle」 có nghĩa là gì?","options":["tối","khối","bochum","đối thoại"],"answer_index":0,"explanation":"dunkle = tối"},{"question":"Từ 「einheiten」 có nghĩa là gì?","options":["đơn vị","khối","bochum","đối thoại"],"answer_index":0,"explanation":"einheiten = đơn vị"},{"question":"Từ 「einnahmen」 có nghĩa là gì?","options":["thu nhập","khối","boc