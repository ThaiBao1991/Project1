です"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 352","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"fischを 使います。","line_vi":"Tôi dùng fisch.","focus_words":["fisch"]},{"speaker":"B","line_target":"fit は 何ですか。","line_vi":"fit là cái gì?","focus_words":["fit"]},{"speaker":"A","line_target":"galerieです。","line_vi":"Đó là galerie.","focus_words":["galerie"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ae5c5e02","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fisch」 có nghĩa là gì?","options":["cá","phù hợp","phòng trưng bày","khu vực"],"answer_index":0,"explanation":"fisch = cá"},{"question":"Từ 「fit」 có nghĩa là gì?","options":["phù hợp","cá","phòng trưng bày","khu vực"],"answer_index":0,"explanation":"fit = phù hợp"},{"question":"Từ 「galerie」 có nghĩa là gì?","options":["phòng trưng bày","cá","phù hợp","khu vực"],"answer_index":0,"explanation":"galerie = phòng trưng bày"},{"question":"Từ 「gebiete」 có nghĩa là gì?","options":["khu vực","cá","phù hợp","phòng trưng bày"],"answer_index":0,"explanation":"gebiete = khu vực"},{"question":"Từ 「gefördert」 có nghĩa là gì?","options":["thăng chức","cá","phù hợp","phòng trưng bày"],"answer_index":0,"explanation":"gefördert = thăng chức"},{"question"