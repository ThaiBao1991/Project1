i bản xứ — Ngày 2387","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"lionを 使います。","line_vi":"Tôi dùng lion.","focus_words":["lion"]},{"speaker":"B","line_target":"liu は 何ですか。","line_vi":"liu là cái gì?","focus_words":["liu"]},{"speaker":"A","line_target":"lmaoです。","line_vi":"Đó là lmao.","focus_words":["lmao"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「lion」 có nghĩa là gì?","options":["sư tử","lưu","lmao","vùng trời"],"answer_index":0,"explanation":"lion = sư tử"},{"question":"Từ 「liu」 có nghĩa là gì?","options":["lưu","sư tử","lmao","vùng trời"],"answer_index":0,"explanation":"liu = lưu"},{"question":"Từ 「lmao」 có nghĩa là gì?","options":["lmao","sư tử","lưu","vùng trời"],"answer_index":0,"explanation":"lmao = lmao"},{"question":"Từ 「luftraum」 có nghĩa là gì?","options":["vùng trời","sư tử","lưu","lmao"],"answer_index":0,"explanation":"luftraum = vùng trời"},{"question":"Từ 「ländereien」 có nghĩa là gì?","options":["vùng đất","sư tử","lưu","lmao"],"answer_index":0,"explanation":"ländereien = vùng đất"},{"question":"Từ 「löse」 có nghĩa là gì?","options":["giải quyết","sư tử","lưu","lmao"],"answer_index":0,"explanation":"löse = giải quyết"},{"question":"Từ 「mailänder」 có nghĩa là gì?","options":["người Milano","sư tử","lưu","lmao"],"answer_index":0,"explanation":"mailänder = người Milano"},{"question":"Từ 「marilyn」 có nghĩa là gì?","options":["Marilyn","sư tử","lưu","lmao"],"answer_index":0,"explanation":"marilyn = Marilyn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sư tử","options":["lion","liu","lmao","luftraum"],"answer_index":0,"explanation":"lion = sư tử"},{"question":"Chọn từ đúng cho nghĩa: lưu","options":["liu","lion","lmao","luftraum"],"answer_index":0,"explanation":"liu = l