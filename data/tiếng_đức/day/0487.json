: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 487","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"weiblichenを 使います。","line_vi":"Tôi dùng weiblichen.","focus_words":["weiblichen"]},{"speaker":"B","line_target":"weisser は 何ですか。","line_vi":"weisser là cái gì?","focus_words":["weisser"]},{"speaker":"A","line_target":"weiterbildungです。","line_vi":"Đó là weiterbildung.","focus_words":["weiterbildung"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dd1aa1e8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「weiblichen」 có nghĩa là gì?","options":["nữ","trắng hơn","giáo dục nâng cao","góc"],"answer_index":0,"explanation":"weiblichen = nữ"},{"question":"Từ 「weisser」 có nghĩa là gì?","options":["trắng hơn","nữ","giáo dục nâng cao","góc"],"answer_index":0,"explanation":"weisser = trắng hơn"},{"question":"Từ 「weiterbildung」 có nghĩa là gì?","options":["giáo dục nâng cao","nữ","trắng hơn","góc"],"answer_index":0,"explanation":"weiterbildung = giáo dục nâng cao"},{"question":"Từ 「winkel」 có nghĩa là gì?","options":["góc","nữ","trắng hơn","giáo dục nâng cao"],"answer_index":0,"explanation":"winkel = góc"},{"question":"Từ 「wolfsburg」 có nghĩa là gì?","options":["Wolfsburg","nữ","trắng hơn","giáo dục nâng cao"],"answer_index":0,"explanation":"wolfsburg = Wolfsburg"},{"question":"Từ 「zuviel」 có nghĩa là gì?","options":["quá nhiều","nữ","trắng hơn","giáo dục nâng c