ferences":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 546","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"rechtlichを 使います。","line_vi":"Tôi dùng rechtlich.","focus_words":["rechtlich"]},{"speaker":"B","line_target":"rumänien は 何ですか。","line_vi":"rumänien là cái gì?","focus_words":["rumänien"]},{"speaker":"A","line_target":"sabineです。","line_vi":"Đó là sabine.","focus_words":["sabine"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_092fca4f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「rechtlich」 có nghĩa là gì?","options":["hợp pháp","Rumani","Sabine","hội thảo"],"answer_index":0,"explanation":"rechtlich = hợp pháp"},{"question":"Từ 「rumänien」 có nghĩa là gì?","options":["Rumani","hợp pháp","Sabine","hội thảo"],"answer_index":0,"explanation":"rumänien = Rumani"},{"question":"Từ 「sabine」 có nghĩa là gì?","options":["Sabine","hợp pháp","Rumani","hội thảo"],"answer_index":0,"explanation":"sabine = Sabine"},{"question":"Từ 「seminar」 có nghĩa là gì?","options":["hội thảo","hợp pháp","Rumani","Sabine"],"answer_index":0,"explanation":"seminar = hội thảo"},{"question":"Từ 「senioren」 có nghĩa là gì?","options":["người cao tuổi","hợp pháp","Rumani","Sabine"],"answer_index":0,"explanation":"senioren = người cao tuổi"},{"question":"Từ 「sicherung」 có nghĩa là g