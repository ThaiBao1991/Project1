_words":["flache"]},{"speaker":"B","line_target":"formal は 何ですか。","line_vi":"formal là cái gì?","focus_words":["formal"]},{"speaker":"A","line_target":"freundeskreisです。","line_vi":"Đó là freundeskreis.","focus_words":["freundeskreis"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「flache」 có nghĩa là gì?","options":["bằng phẳng","chính thức","vòng tròn bạn bè","yên bình"],"answer_index":0,"explanation":"flache = bằng phẳng"},{"question":"Từ 「formal」 có nghĩa là gì?","options":["chính thức","bằng phẳng","vòng tròn bạn bè","yên bình"],"answer_index":0,"explanation":"formal = chính thức"},{"question":"Từ 「freundeskreis」 có nghĩa là gì?","options":["vòng tròn bạn bè","bằng phẳng","chính thức","yên bình"],"answer_index":0,"explanation":"freundeskreis = vòng tròn bạn bè"},{"question":"Từ 「friedlichen」 có nghĩa là gì?","options":["yên bình","bằng phẳng","chính thức","vòng tròn bạn bè"],"answer_index":0,"explanation":"friedlichen = yên bình"},{"question":"Từ 「frust」 có nghĩa là gì?","options":["sự thất vọng","bằng phẳng","chính thức","vòng tròn bạn bè"],"answer_index":0,"explanation":"frust = sự thất vọng"},{"question":"Từ 「fährst」 có nghĩa là gì?","options":["lái xe","bằng phẳng","chính thức","vòng tròn bạn bè"],"answer_index":0,"explanation":"fährst = lái xe"},{"question":"Từ 「förmlich」 có nghĩa là gì?","options":["chính thức","bằng phẳng","vòng tròn bạn bè","yên bình"],"answer_index":0,"explanation":"förmlich = chính thức"},{"question":"Từ 「für's」 có nghĩa là gì?","options":["vì nó","bằng phẳng","chính thức","vòng tròn bạn bè"],"answer_index":0,"explanation":"für's = vì nó"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bằng phẳng","options":["flache","formal","freundeskreis","friedlichen"],"answer_index":0,"explanation":"flache = bằng phẳng"},{"question":