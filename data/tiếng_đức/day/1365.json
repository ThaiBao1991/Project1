 Ngày 1365","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"auszugleichenを 使います。","line_vi":"Tôi dùng auszugleichen.","focus_words":["auszugleichen"]},{"speaker":"B","line_target":"autounfall は 何ですか。","line_vi":"autounfall là cái gì?","focus_words":["autounfall"]},{"speaker":"A","line_target":"bayerischerです。","line_vi":"Đó là bayerischer.","focus_words":["bayerischer"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「auszugleichen」 có nghĩa là gì?","options":["để cân bằng","tai nạn xe hơi","tiếng Bavaria","ghi chú"],"answer_index":0,"explanation":"auszugleichen = để cân bằng"},{"question":"Từ 「autounfall」 có nghĩa là gì?","options":["tai nạn xe hơi","để cân bằng","tiếng Bavaria","ghi chú"],"answer_index":0,"explanation":"autounfall = tai nạn xe hơi"},{"question":"Từ 「bayerischer」 có nghĩa là gì?","options":["tiếng Bavaria","để cân bằng","tai nạn xe hơi","ghi chú"],"answer_index":0,"explanation":"bayerischer = tiếng Bavaria"},{"question":"Từ 「beachte」 có nghĩa là gì?","options":["ghi chú","để cân bằng","tai nạn xe hơi","tiếng Bavaria"],"answer_index":0,"explanation":"beachte = ghi chú"},{"question":"Từ 「behindern」 có nghĩa là gì?","options":["cản trở","để cân bằng","tai nạn xe hơi","tiếng Bavaria"],"answer_index":0,"explanation":"behindern = cản trở"},{"question":"Từ 「bekanntgegeben」 có nghĩa là gì?","options":["công bố","để cân bằng","tai nạn xe hơi","tiếng Bavaria"],"answer_index":0,"explanation":"bekanntgegeben = công bố"},{"question":"Từ 「benennung」 có nghĩa là gì?","options":["đặt tên","để cân bằng","tai nạn xe hơi","tiếng Bavaria"],"answer_index":0,"explanation":"benennung = đặt tên"},{"question":"Từ 「berechtigung」 có nghĩa là gì?","options":["ủy quyền","để cân bằng","tai nạn xe hơi","tiếng