 án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 914","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ladeを 使います。","line_vi":"Tôi dùng lade.","focus_words":["lade"]},{"speaker":"B","line_target":"landung は 何ですか。","line_vi":"landung là cái gì?","focus_words":["landung"]},{"speaker":"A","line_target":"langeweileです。","line_vi":"Đó là langeweile.","focus_words":["langeweile"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「lade」 có nghĩa là gì?","options":["tải","hạ cánh","sự buồn chán","sự nghiệp"],"answer_index":0,"explanation":"lade = tải"},{"question":"Từ 「landung」 có nghĩa là gì?","options":["hạ cánh","tải","sự buồn chán","sự nghiệp"],"answer_index":0,"explanation":"landung = hạ cánh"},{"question":"Từ 「langeweile」 có nghĩa là gì?","options":["sự buồn chán","tải","hạ cánh","sự nghiệp"],"answer_index":0,"explanation":"langeweile = sự buồn chán"},{"question":"Từ 「laufbahn」 có nghĩa là gì?","options":["sự nghiệp","tải","hạ cánh","sự buồn chán"],"answer_index":0,"explanation":"laufbahn = sự nghiệp"},{"question":"Từ 「lehnen」 có nghĩa là gì?","options":["nạc","tải","hạ cánh","sự buồn chán"],"answer_index":0,"explanation":"lehnen = nạc"},{"question":"Từ 「leistungsfähigkeit」 có nghĩa là gì?","options":["hiệu suất","tải","hạ cánh","sự buồn chán"],"answer_index":0,"explanation":"leistungsfähigkeit = hiệu suất"},{"question":"Từ 「leitungen」 có nghĩa là gì?","options":["dòng","tải","hạ cánh","sự buồn chán"],"answer_index":0,"explanation":"leitungen = dòng"},{"question":"Từ 「leuchtet」 có nghĩa là gì?","options":["sáng lên","tải","hạ cánh","sự buồn chán"],"answer_index":0,"explanation":"leuchtet = sáng lên"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tải","options":["lade","l