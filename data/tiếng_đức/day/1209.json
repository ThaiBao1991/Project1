"grammar":[{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1209","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"württembergischenを 使います。","line_vi":"Tôi dùng württembergischen.","focus_words":["württembergischen"]},{"speaker":"B","line_target":"zehen は 何ですか。","line_vi":"zehen là cái gì?","focus_words":["zehen"]},{"speaker":"A","line_target":"zeitlicheです。","line_vi":"Đó là zeitliche.","focus_words":["zeitliche"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「württembergischen」 có nghĩa là gì?","options":["Württemberg","ngón chân","tạm thời","nhân chứng"],"answer_index":0,"explanation":"württembergischen = Württemberg"},{"question":"Từ 「zehen」 có nghĩa là gì?","options":["ngón chân","Württemberg","tạm thời","nhân chứng"],"answer_index":0,"explanation":"zehen = ngón chân"},{"question":"Từ 「zeitliche」 có nghĩa là gì?","options":["tạm thời","Württemberg","ngón chân","nhân chứng"],"answer_index":0,"explanation":"zeitliche = tạm thời"},{"question":"Từ 「zeugt」 có nghĩa là gì?","options":["nhân chứng","Württemberg","ngón chân","tạm thời"],"answer_index":0,"explanation":"zeugt = nhân chứng"},{"question":"Từ 「zitieren」 có nghĩa là gì?","options":["trích dẫn","Württemberg","ngón chân","tạm thời"],"answer_index":0,"explanation":"zitieren = trích dẫn"},{"question":"Từ 「zunehmender」 có nghĩa là gì?","options":["ngày càng tăng","Württemberg","ngón chân","tạm thời"],"answer_index":0,"explanation":"zunehmender = ngày càng tăng"},{"question":"Từ 「zusammenspiel」 có nghĩa là gì?","options":["sự tương tác","Württemberg","ngón chân","tạm thời"],"answer_index":0,"explanation":"zusammenspiel = s