a là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 423","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"psychologieを 使います。","line_vi":"Tôi dùng psychologie.","focus_words":["psychologie"]},{"speaker":"B","line_target":"risiken は 何ですか。","line_vi":"risiken là cái gì?","focus_words":["risiken"]},{"speaker":"A","line_target":"schenkenです。","line_vi":"Đó là schenken.","focus_words":["schenken"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_81d25a41","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「psychologie」 có nghĩa là gì?","options":["tâm lý học","rủi ro","cho","Thượng viện"],"answer_index":0,"explanation":"psychologie = tâm lý học"},{"question":"Từ 「risiken」 có nghĩa là gì?","options":["rủi ro","tâm lý học","cho","Thượng viện"],"answer_index":0,"explanation":"risiken = rủi ro"},{"question":"Từ 「schenken」 có nghĩa là gì?","options":["cho","tâm lý học","rủi ro","Thượng viện"],"answer_index":0,"explanation":"schenken = cho"},{"question":"Từ 「senat」 có nghĩa là gì?","options":["Thượng viện","tâm lý học","rủi ro","cho"],"answer_index":0,"explanation":"senat = Thượng viện"},{"question":"Từ 「sky」 có nghĩa là gì?","options":["bầu trời","tâm lý học","rủi ro","cho"],"answer_index":0,"explanation":"sky = bầu trời"},{"question":"Từ 「soeben」 có nghĩa là gì?","options":["ngay bây giờ","tâm lý học","rủi ro","cho"],"answer_index":0,"explanation":"soeben = ngay bây giờ"},{"question":"Từ 「staatsanwaltschaft」 có nghĩa là gì?","options":["công tố vi