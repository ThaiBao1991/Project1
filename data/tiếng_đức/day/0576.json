","explanation":"bí mật","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c5c89700","audio_ref":"m_a5e4b213","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e7ea1b94"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 576","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"flotteを 使います。","line_vi":"Tôi dùng flotte.","focus_words":["flotte"]},{"speaker":"B","line_target":"frankreichs は 何ですか。","line_vi":"frankreichs là cái gì?","focus_words":["frankreichs"]},{"speaker":"A","line_target":"freiwilligenです。","line_vi":"Đó là freiwilligen.","focus_words":["freiwilligen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b64db55e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「flotte」 có nghĩa là gì?","options":["nhanh nhẹn","Pháp","tình nguyện viên","tươi"],"answer_index":0,"explanation":"flotte = nhanh nhẹn"},{"question":"Từ 「frankreichs」 có nghĩa là gì?","options":["Pháp","nhanh nhẹn","tình nguyện viên","tươi"],"answer_index":0,"explanation":"frankreichs = Pháp"},{"question":"Từ 「freiwilligen」 có nghĩa là gì?","options":["tình nguyện viên","nhanh nhẹn","Pháp","tươi"],"answer_index":0,"explanation":"freiwilligen = tình nguyện viên"},{"question":"Từ 「frischen」 có nghĩa là gì?","options":["tươi","nhanh nhẹn","Pháp","tình nguyện viên"],"answer_index":0,"explanation":"frischen = tươi"},{"question":"Từ 「fröhlich」 có nghĩa là gì?","options":["vui vẻ","nhanh nhẹn","Pháp","tình nguyện viên"],"answer_index":0,"explanation":"fröhlich = vui vẻ"},{"question":"Từ 「gaming」 có nghĩa là gì?","o