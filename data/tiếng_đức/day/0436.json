":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 436","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"gestiegenを 使います。","line_vi":"Tôi dùng gestiegen.","focus_words":["gestiegen"]},{"speaker":"B","line_target":"gestohlen は 何ですか。","line_vi":"gestohlen là cái gì?","focus_words":["gestohlen"]},{"speaker":"A","line_target":"getestetです。","line_vi":"Đó là getestet.","focus_words":["getestet"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_358ee3b9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「gestiegen」 có nghĩa là gì?","options":["tăng lên","bị đánh cắp","đã thử nghiệm","vàng"],"answer_index":0,"explanation":"gestiegen = tăng lên"},{"question":"Từ 「gestohlen」 có nghĩa là gì?","options":["bị đánh cắp","tăng lên","đã thử nghiệm","vàng"],"answer_index":0,"explanation":"gestohlen = bị đánh cắp"},{"question":"Từ 「getestet」 có nghĩa là gì?","options":["đã thử nghiệm","tăng lên","bị đánh cắp","vàng"],"answer_index":0,"explanation":"getestet = đã thử nghiệm"},{"question":"Từ 「goldenen」 có nghĩa là gì?","options":["vàng","tăng lên","bị đánh cắp","đã thử nghiệm"],"answer_index":0,"explanation":"goldenen = vàng"},{"question":"Từ 「grau」 có nghĩa là gì?","options":["màu xám","tăng lên","bị đánh cắp","đã thử nghiệm"],"answer_index":0,"explanation":"grau = màu xám"},{"question":"Từ 「handelte」 có nghĩa l