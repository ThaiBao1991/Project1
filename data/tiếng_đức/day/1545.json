uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"deaktivierenを 使います。","line_vi":"Tôi dùng deaktivieren.","focus_words":["deaktivieren"]},{"speaker":"B","line_target":"dekoration は 何ですか。","line_vi":"dekoration là cái gì?","focus_words":["dekoration"]},{"speaker":"A","line_target":"delegiertenです。","line_vi":"Đó là delegierten.","focus_words":["delegierten"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「deaktivieren」 có nghĩa là gì?","options":["vô hiệu hóa","trang trí","đại biểu","giám đốc"],"answer_index":0,"explanation":"deaktivieren = vô hiệu hóa"},{"question":"Từ 「dekoration」 có nghĩa là gì?","options":["trang trí","vô hiệu hóa","đại biểu","giám đốc"],"answer_index":0,"explanation":"dekoration = trang trí"},{"question":"Từ 「delegierten」 có nghĩa là gì?","options":["đại biểu","vô hiệu hóa","trang trí","giám đốc"],"answer_index":0,"explanation":"delegierten = đại biểu"},{"question":"Từ 「direktorin」 có nghĩa là gì?","options":["giám đốc","vô hiệu hóa","trang trí","đại biểu"],"answer_index":0,"explanation":"direktorin = giám đốc"},{"question":"Từ 「disposition」 có nghĩa là gì?","options":["bố trí","vô hiệu hóa","trang trí","đại biểu"],"answer_index":0,"explanation":"disposition = bố trí"},{"question":"Từ 「donna」 có nghĩa là gì?","options":["Donna","vô hiệu hóa","trang trí","đại biểu"],"answer_index":0,"explanation":"donna = Donna"},{"question":"Từ 「dorothea」 có nghĩa là gì?","options":["dorothea","vô hiệu hóa","trang trí","đại biểu"],"answer_index":0,"explanation":"dorothea = dorothea"},{"question":"Từ 「dreifach」 có nghĩa là gì?","options":["gấp ba","vô hiệu hóa","trang trí","đại biểu"],"answer_index":0,"explanation":"dreifach = gấp ba"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: vô hiệu hóa","