ogue":[{"title":"Cao cấp học thuật — Ngày 2100","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ambulanteを 使います。","line_vi":"Tôi dùng ambulante.","focus_words":["ambulante"]},{"speaker":"B","line_target":"ambulanten は 何ですか。","line_vi":"ambulanten là cái gì?","focus_words":["ambulanten"]},{"speaker":"A","line_target":"angeblicherです。","line_vi":"Đó là angeblicher.","focus_words":["angeblicher"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ambulante」 có nghĩa là gì?","options":["bệnh nhân ngoại trú","bị cáo buộc","sắp xếp","trưởng thành"],"answer_index":0,"explanation":"ambulante = bệnh nhân ngoại trú"},{"question":"Từ 「ambulanten」 có nghĩa là gì?","options":["bệnh nhân ngoại trú","bị cáo buộc","sắp xếp","trưởng thành"],"answer_index":0,"explanation":"ambulanten = bệnh nhân ngoại trú"},{"question":"Từ 「angeblicher」 có nghĩa là gì?","options":["bị cáo buộc","bệnh nhân ngoại trú","bệnh nhân ngoại trú","sắp xếp"],"answer_index":0,"explanation":"angeblicher = bị cáo buộc"},{"question":"Từ 「angeordneten」 có nghĩa là gì?","options":["sắp xếp","bệnh nhân ngoại trú","bệnh nhân ngoại trú","bị cáo buộc"],"answer_index":0,"explanation":"angeordneten = sắp xếp"},{"question":"Từ 「angewachsen」 có nghĩa là gì?","options":["trưởng thành","bệnh nhân ngoại trú","bệnh nhân ngoại trú","bị cáo buộc"],"answer_index":0,"explanation":"angewachsen = trưởng thành"},{"question":"Từ 「anstehende」 có nghĩa là gì?","options":["sắp tới","bệnh nhân ngoại trú","bệnh nhân ngoại trú","bị cáo buộc"],"answer_index":0,"explanation":"anstehende = sắp tới"},{"question":"Từ 「ansässige」 có nghĩa là gì?","options":["thường trú","bệnh nhân ngoại trú","bệnh nhân ngoại trú","bị cáo buộc"],"answer_index":0,"explanation":"ansässige = thường t