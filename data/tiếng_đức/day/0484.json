:[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 484","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"organisierenを 使います。","line_vi":"Tôi dùng organisieren.","focus_words":["organisieren"]},{"speaker":"B","line_target":"pfund は 何ですか。","line_vi":"pfund là cái gì?","focus_words":["pfund"]},{"speaker":"A","line_target":"profisです。","line_vi":"Đó là profis.","focus_words":["profis"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2adeda56","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「organisieren」 có nghĩa là gì?","options":["tổ chức","bảng Anh","chuyên gia","giải cứu"],"answer_index":0,"explanation":"organisieren = tổ chức"},{"question":"Từ 「pfund」 có nghĩa là gì?","options":["bảng Anh","tổ chức","chuyên gia","giải cứu"],"answer_index":0,"explanation":"pfund = bảng Anh"},{"question":"Từ 「profis」 có nghĩa là gì?","options":["chuyên gia","tổ chức","bảng Anh","giải cứu"],"answer_index":0,"explanation":"profis = chuyên gia"},{"question":"Từ 「rettung」 có nghĩa là gì?","options":["giải cứu","tổ chức","bảng Anh","chuyên gia"],"answer_index":0,"explanation":"rettung = giải cứu"},{"question":"Từ 「sam」 có nghĩa là gì?","options":["Sâm","tổ chức","bảng Anh","chuyên gia"],"answer_index":0,"explanation":"sam = Sâm"},{"question":"Từ 「schiesst」 có nghĩa là gì?","options":["chồi","tổ chức","bảng Anh","chuyên gia"],"answer_index":0,"explanation":"schiesst = chồi"},{"question":"Từ 「schlampe」 có