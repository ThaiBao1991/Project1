:[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 395","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"zugänglichを 使います。","line_vi":"Tôi dùng zugänglich.","focus_words":["zugänglich"]},{"speaker":"B","line_target":"affäre は 何ですか。","line_vi":"affäre là cái gì?","focus_words":["affäre"]},{"speaker":"A","line_target":"anerkanntです。","line_vi":"Đó là anerkannt.","focus_words":["anerkannt"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_78b04bd4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「zugänglich」 có nghĩa là gì?","options":["có thể truy cập","chuyện tình","được công nhận","họ hàng"],"answer_index":0,"explanation":"zugänglich = có thể truy cập"},{"question":"Từ 「affäre」 có nghĩa là gì?","options":["chuyện tình","có thể truy cập","được công nhận","họ hàng"],"answer_index":0,"explanation":"affäre = chuyện tình"},{"question":"Từ 「anerkannt」 có nghĩa là gì?","options":["được công nhận","có thể truy cập","chuyện tình","họ hàng"],"answer_index":0,"explanation":"anerkannt = được công nhận"},{"question":"Từ 「angehörigen」 có nghĩa là gì?","options":["họ hàng","có thể truy cập","chuyện tình","được công nhận"],"answer_index":0,"explanation":"angehörigen = họ hàng"},{"question":"Từ 「angenehm」 có nghĩa là gì?","options":["dễ chịu","có thể truy cập","chuyện tình","đượ