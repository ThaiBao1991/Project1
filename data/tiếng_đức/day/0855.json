uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"totaleを 使います。","line_vi":"Tôi dùng totale.","focus_words":["totale"]},{"speaker":"B","line_target":"tätigen は 何ですか。","line_vi":"tätigen là cái gì?","focus_words":["tätigen"]},{"speaker":"A","line_target":"uffです。","line_vi":"Đó là uff.","focus_words":["uff"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「totale」 có nghĩa là gì?","options":["tổng cộng","làm","ôi","đồng hồ"],"answer_index":0,"explanation":"totale = tổng cộng"},{"question":"Từ 「tätigen」 có nghĩa là gì?","options":["làm","tổng cộng","ôi","đồng hồ"],"answer_index":0,"explanation":"tätigen = làm"},{"question":"Từ 「uff」 có nghĩa là gì?","options":["ôi","tổng cộng","làm","đồng hồ"],"answer_index":0,"explanation":"uff = ôi"},{"question":"Từ 「uhren」 có nghĩa là gì?","options":["đồng hồ","tổng cộng","làm","ôi"],"answer_index":0,"explanation":"uhren = đồng hồ"},{"question":"Từ 「umgebracht」 có nghĩa là gì?","options":["bị giết","tổng cộng","làm","ôi"],"answer_index":0,"explanation":"umgebracht = bị giết"},{"question":"Từ 「unsicherheit」 có nghĩa là gì?","options":["sự không chắc chắn","tổng cộng","làm","ôi"],"answer_index":0,"explanation":"unsicherheit = sự không chắc chắn"},{"question":"Từ 「untersagt」 có nghĩa là gì?","options":["bị cấm","tổng cộng","làm","ôi"],"answer_index":0,"explanation":"untersagt = bị cấm"},{"question":"Từ 「verdammte」 có nghĩa là gì?","options":["chết tiệt","tổng cộng","làm","ôi"],"answer_index":0,"explanation":"verdammte = chết tiệt"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tổng cộng","options":["totale","tätigen","uff","uhren"],"answer_index":0,"explanation":"totale = tổng cộng"},{"question":"Chọn từ đúng cho nghĩa: làm","options":["tätigen","totale","uff","uhren"