n rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 520","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"hohesを 使います。","line_vi":"Tôi dùng hohes.","focus_words":["hohes"]},{"speaker":"B","line_target":"häusern は 何ですか。","line_vi":"häusern là cái gì?","focus_words":["häusern"]},{"speaker":"A","line_target":"identifizierenです。","line_vi":"Đó là identifizieren.","focus_words":["identifizieren"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e0fce2de","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「hohes」 có nghĩa là gì?","options":["cao","nhà ở","xác định","quan tâm"],"answer_index":0,"explanation":"hohes = cao"},{"question":"Từ 「häusern」 có nghĩa là gì?","options":["nhà ở","cao","xác định","quan tâm"],"answer_index":0,"explanation":"häusern = nhà ở"},{"question":"Từ 「identifizieren」 có nghĩa là gì?","options":["xác định","cao","nhà ở","quan tâm"],"answer_index":0,"explanation":"identifizieren = xác định"},{"question":"Từ 「interessierte」 có nghĩa là gì?","options":["quan tâm","cao","nhà ở","xác định"],"answer_index":0,"explanation":"interessierte = quan tâm"},{"question":"Từ 「kandidat」 có nghĩa là gì?","options":["ứng cử viên","cao","nhà ở","xác định"],"answer_index":0,"explanation":"kandidat = ứng cử viên"},{"question":"Từ 「kanzlerin」 có nghĩa là gì?","options":["thủ tướng","cao","nhà ở","xác định"],"answer_index":0,"explanation":"kanzlerin = thủ tướng"},{"question":"Từ 「kaufe」 có nghĩa là gì?","options":["m