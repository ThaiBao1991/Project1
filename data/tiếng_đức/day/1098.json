":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1098","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"manipulationを 使います。","line_vi":"Tôi dùng manipulation.","focus_words":["manipulation"]},{"speaker":"B","line_target":"masken は 何ですか。","line_vi":"masken là cái gì?","focus_words":["masken"]},{"speaker":"A","line_target":"meisternです。","line_vi":"Đó là meistern.","focus_words":["meistern"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「manipulation」 có nghĩa là gì?","options":["thao túng","mặt nạ","bậc thầy","của bà Merkel"],"answer_index":0,"explanation":"manipulation = thao túng"},{"question":"Từ 「masken」 có nghĩa là gì?","options":["mặt nạ","thao túng","bậc thầy","của bà Merkel"],"answer_index":0,"explanation":"masken = mặt nạ"},{"question":"Từ 「meistern」 có nghĩa là gì?","options":["bậc thầy","thao túng","mặt nạ","của bà Merkel"],"answer_index":0,"explanation":"meistern = bậc thầy"},{"question":"Từ 「merkels」 có nghĩa là gì?","options":["của bà Merkel","thao túng","mặt nạ","bậc thầy"],"answer_index":0,"explanation":"merkels = của bà Merkel"},{"question":"Từ 「militärisch」 có nghĩa là gì?","options":["quân sự","thao túng","mặt nạ","bậc thầy"],"answer_index":0,"explanation":"militärisch = quân sự"},{"question":"Từ 「mittelstand」 có nghĩa là gì?","options":["tầng lớp trung lưu","thao túng","mặt nạ","bậc thầy"],"answer_index":0,"explanation":"mittelstand = tầng lớp trung lưu"},{"question":"Từ 「mod」 có nghĩa là gì?","options":["mod","thao túng","mặt nạ","bậc thầy"],"answer_index":0,"explanation":"mod = mod"},{"question":"Từ 「moll」 có nghĩa là gì?","options":["thứ yếu","thao túng","mặt nạ","bậc thầy"],"answer_index":0,"explanation":"moll = thứ yếu"}],"pattern":[{"question":"Chọn từ đúng cho ng