ấp công việc — Ngày 1097","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"kontaktierenを 使います。","line_vi":"Tôi dùng kontaktieren.","focus_words":["kontaktieren"]},{"speaker":"B","line_target":"kopien は 何ですか。","line_vi":"kopien là cái gì?","focus_words":["kopien"]},{"speaker":"A","line_target":"kundgebungです。","line_vi":"Đó là kundgebung.","focus_words":["kundgebung"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「kontaktieren」 có nghĩa là gì?","options":["liên hệ","bản sao","tập hợp","chữa bệnh"],"answer_index":0,"explanation":"kontaktieren = liên hệ"},{"question":"Từ 「kopien」 có nghĩa là gì?","options":["bản sao","liên hệ","tập hợp","chữa bệnh"],"answer_index":0,"explanation":"kopien = bản sao"},{"question":"Từ 「kundgebung」 có nghĩa là gì?","options":["tập hợp","liên hệ","bản sao","chữa bệnh"],"answer_index":0,"explanation":"kundgebung = tập hợp"},{"question":"Từ 「kur」 có nghĩa là gì?","options":["chữa bệnh","liên hệ","bản sao","tập hợp"],"answer_index":0,"explanation":"kur = chữa bệnh"},{"question":"Từ 「könntet」 có nghĩa là gì?","options":["có thể","liên hệ","bản sao","tập hợp"],"answer_index":0,"explanation":"könntet = có thể"},{"question":"Từ 「lat」 có nghĩa là gì?","options":["vĩ độ","liên hệ","bản sao","tập hợp"],"answer_index":0,"explanation":"lat = vĩ độ"},{"question":"Từ 「leckere」 có nghĩa là gì?","options":["thơm ngon","liên hệ","bản sao","tập hợp"],"answer_index":0,"explanation":"leckere = thơm ngon"},{"question":"Từ 「leihen」 có nghĩa là gì?","options":["mượn","liên hệ","bản sao","tập hợp"],"answer_index":0,"explanation":"leihen = mượn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: liên hệ","options":["kontaktieren","kopien","kundgebung","kur"],"answer_index":0,"explanation":"konta