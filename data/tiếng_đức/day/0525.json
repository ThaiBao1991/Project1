explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 525","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"treueを 使います。","line_vi":"Tôi dùng treue.","focus_words":["treue"]},{"speaker":"B","line_target":"trick は 何ですか。","line_vi":"trick là cái gì?","focus_words":["trick"]},{"speaker":"A","line_target":"täglichenです。","line_vi":"Đó là täglichen.","focus_words":["täglichen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2706e23a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「treue」 có nghĩa là gì?","options":["lòng trung thành","thủ thuật","hàng ngày","lẫn nhau"],"answer_index":0,"explanation":"treue = lòng trung thành"},{"question":"Từ 「trick」 có nghĩa là gì?","options":["thủ thuật","lòng trung thành","hàng ngày","lẫn nhau"],"answer_index":0,"explanation":"trick = thủ thuật"},{"question":"Từ 「täglichen」 có nghĩa là gì?","options":["hàng ngày","lòng trung thành","thủ thuật","lẫn nhau"],"answer_index":0,"explanation":"täglichen = hàng ngày"},{"question":"Từ 「untereinander」 có nghĩa là gì?","options":["lẫn nhau","lòng trung thành","thủ thuật","hàng ngày"],"answer_index":0,"explanation":"untereinander = lẫn nhau"},{"question":"T