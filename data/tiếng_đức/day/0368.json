 danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 368","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"gerufenを 使います。","line_vi":"Tôi dùng gerufen.","focus_words":["gerufen"]},{"speaker":"B","line_target":"gesichert は 何ですか。","line_vi":"gesichert là cái gì?","focus_words":["gesichert"]},{"speaker":"A","line_target":"gipfelです。","line_vi":"Đó là gipfel.","focus_words":["gipfel"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d8430f47","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「gerufen」 có nghĩa là gì?","options":["được gọi là","bảo đảm","đỉnh điểm","lời chào"],"answer_index":0,"explanation":"gerufen = được gọi là"},{"question":"Từ 「gesichert」 có nghĩa là gì?","options":["bảo đảm","được gọi là","đỉnh điểm","lời chào"],"answer_index":0,"explanation":"gesichert = bảo đảm"},{"question":"Từ 「gipfel」 có nghĩa là gì?","options":["đỉnh điểm","được gọi là","bảo đảm","lời chào"],"answer_index":0,"explanation":"gipfel = đỉnh điểm"},{"question":"Từ 「grüsse」 có nghĩa là gì?","options":["lời chào","được gọi là","bảo đảm","đỉnh điểm"],"answer_index":0,"explanation":"grüsse = lời chào"},{"question":"Từ 「harten」 có nghĩa là gì?","options":["cứng","được gọi là","bảo đảm","đỉnh điểm"],"answer_index":0,"explanation":"harten = cứng"},{"question":"Từ 「intensiv」 có nghĩa là gì?","options":["mãnh liệt","được gọi là","bảo đảm","đỉnh điểm"],"answer_index":0,"explanation":"intensiv =