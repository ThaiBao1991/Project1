ai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 451","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ältestenを 使います。","line_vi":"Tôi dùng ältesten.","focus_words":["ältesten"]},{"speaker":"B","line_target":"angepasst は 何ですか。","line_vi":"angepasst là cái gì?","focus_words":["angepasst"]},{"speaker":"A","line_target":"aufbauenです。","line_vi":"Đó là aufbauen.","focus_words":["aufbauen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_391a5e3a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ältesten」 có nghĩa là gì?","options":["lâu đời nhất","thích nghi","xây dựng","lẫn nhau"],"answer_index":0,"explanation":"ältesten = lâu đời nhất"},{"question":"Từ 「angepasst」 có nghĩa là gì?","options":["thích nghi","lâu đời nhất","xây dựng","lẫn nhau"],"answer_index":0,"explanation":"angepasst = thích nghi"},{"question":"Từ 「aufbauen」 có nghĩa là gì?","options":["xây dựng","lâu đời nhất","thích nghi","lẫn nhau"],"answer_index":0,"explanation":"aufbauen = xây dựng"},{"question":"Từ 「aufeinander」 có nghĩa là gì?","options":["lẫn nhau","lâu đời nhất","thích nghi","xây dựng"],"answer_index":0,"explanation":"aufeinander = lẫn nhau"},{"question":"Từ 「aufgeregt」 có nghĩa là gì?","options":["vui mừng","lâu đời nhất","thích nghi","xây dựng"],"answer_index":0,"explanation":"aufgeregt = vui mừng"},{"question":"Từ 「ausgebildet」 có nghĩa là gì?","options":["được đào tạo","lâu đời nhất","thích 