anation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 783","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"fälligを 使います。","line_vi":"Tôi dùng fällig.","focus_words":["fällig"]},{"speaker":"B","line_target":"fühlst は 何ですか。","line_vi":"fühlst là cái gì?","focus_words":["fühlst"]},{"speaker":"A","line_target":"geantwortetです。","line_vi":"Đó là geantwortet.","focus_words":["geantwortet"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fällig」 có nghĩa là gì?","options":["đến hạn","cảm nhận","đã trả lời","sinh ra"],"answer_index":0,"explanation":"fällig = đến hạn"},{"question":"Từ 「fühlst」 có nghĩa là gì?","options":["cảm nhận","đến hạn","đã trả lời","sinh ra"],"answer_index":0,"explanation":"fühlst = cảm nhận"},{"question":"Từ 「geantwortet」 có nghĩa là gì?","options":["đã trả lời","đến hạn","cảm nhận","sinh ra"],"answer_index":0,"explanation":"geantwortet = đã trả lời"},{"question":"Từ 「geborene」 có nghĩa là gì?","options":["sinh ra","đến hạn","cảm nhận","đã trả lời"],"answer_index":0,"explanation":"geborene = sinh ra"},{"question":"Từ 「gegenwärtig」 có nghĩa là gì?","options":["hiện tại","đến hạn","cảm nhận","đã trả lời"],"answer_index":0,"explanation":"gegenwärtig = hiện tại"},{"question":"Từ 「geheimnisse」 có nghĩa là gì?","options":["bí mật","đến hạn","cảm nhận","đã trả lời"],"answer_index":0,"explanation":"geheimnisse = bí mật"},{"question":"Từ 「geliebte」 có nghĩa là gì?","options":["những người thân yêu","đến hạn","cảm nhận","đã trả lời"],"answer_index":0,"explanation":"geliebte = những người thân yêu"},{"question":"Từ 「genie」 có nghĩa là gì?","options":["thiên tài","đến hạn","cảm nhận","đã trả lời"],"answer_index":0,"explanation":"genie = thiên tài"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đến hạn","options":["fällig","fühlst