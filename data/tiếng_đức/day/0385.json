ing_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 385","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"redaktionを 使います。","line_vi":"Tôi dùng redaktion.","focus_words":["redaktion"]},{"speaker":"B","line_target":"räumen は 何ですか。","line_vi":"räumen là cái gì?","focus_words":["räumen"]},{"speaker":"A","line_target":"schneidenです。","line_vi":"Đó là schneiden.","focus_words":["schneiden"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_95a704ce","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「redaktion」 có nghĩa là gì?","options":["biên tập","rõ ràng","cắt","sinh viên"],"answer_index":0,"explanation":"redaktion = biên tập"},{"question":"Từ 「räumen」 có nghĩa là gì?","options":["rõ ràng","biên tập","cắt","sinh viên"],"answer_index":0,"explanation":"räumen = rõ ràng"},{"question":"Từ 「schneiden」 có nghĩa là gì?","options":["cắt","biên tập","rõ ràng","sinh viên"],"answer_index":0,"explanation":"schneiden = cắt"},{"question":"Từ 「schülern」 có nghĩa là gì?","options":["sinh viên","biên tập","rõ ràng","cắt"],"answer_index":0,"explanation":"schülern = sinh viên"},{"question":"Từ 「sekunde」 có nghĩa là gì?","options":["thứ hai","biên tập","rõ ràng","cắt"],"answer_index":0,"explanation":"sekunde = thứ hai"},{"question":"Từ 「seltsam」 có nghĩa là gì?","options":["kỳ lạ","biên tập","rõ ràng","cắt"],"answer_index":0,"explanation":"seltsam = kỳ lạ"},{"question":"Từ 「set」 có nghĩa là gì?","options":["đặt","biên tập","rõ ràng","cắt