 = lượt tải xuống"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nhà dân chủ","options":["demokrat","diplomarbeit","direktem","disqualifiziert"],"answer_index":0,"explanation":"demokrat = nhà dân chủ"},{"question":"Chọn từ đúng cho nghĩa: luận văn tốt nghiệp","options":["diplomarbeit","demokrat","direktem","disqualifiziert"],"answer_index":0,"explanation":"diplomarbeit = luận văn tốt nghiệp"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}