amples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 821","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"researchを 使います。","line_vi":"Tôi dùng research.","focus_words":["research"]},{"speaker":"B","line_target":"rezepte は 何ですか。","line_vi":"rezepte là cái gì?","focus_words":["rezepte"]},{"speaker":"A","line_target":"satです。","line_vi":"Đó là sat.","focus_words":["sat"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「research」 có nghĩa là gì?","options":["nghiên cứu","công thức nấu ăn","ngồi","vỏ"],"answer_index":0,"explanation":"research = nghiên cứu"},{"question":"Từ 「rezepte」 có nghĩa là gì?","options":["công thức nấu ăn","nghiên cứu","ngồi","vỏ"],"answer_index":0,"explanation":"rezepte = công thức nấu ăn"},{"question":"Từ 「sat」 có nghĩa là gì?","options":["ngồi","nghiên cứu","công thức nấu ăn","vỏ"],"answer_index":0,"explanation":"sat = ngồi"},{"question":"Từ 「schale」 có nghĩa là gì?","options":["vỏ","nghiên cứu","công thức nấu ăn","ngồi"],"answer_index":0,"explanation":"schale = vỏ"},{"question":"Từ 「schnauze」 có nghĩa là gì?","options":["im đi","nghiên cứu","công thức nấu ăn","ngồi"],"answer_index":0,"explanation":"schnauze = im đi"},{"question":"Từ 「selbstbewusstsein」 có nghĩa là gì?","options":["sự tự tin","nghiên cứu","công thức nấu ăn","ngồi"],"answer_index":0,"explanation":"selbstbewusstsein = sự tự tin"},{"question":"Từ 「solide」 có nghĩa là gì?","options":["chất rắn","nghiên cứu","công thức nấu ăn","ngồi"],"answer_index":0,"explanation":"solide = chất rắn"},{"question":"Từ 「souverän」 có nghĩa là gì?","options":["có chủ quyền","nghiên cứu","công thức nấu ăn","ngồi"],"answer_index":0,"explanation":"souverän = có chủ quyền"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nghiên cứu","options":["research","rezepte","sat","schale"],"answer_index":0,"explanation":"research = nghiên cứu"},{"question":"Chọn từ đúng cho nghĩa: công thức nấu ăn","options":["rezepte","research","s