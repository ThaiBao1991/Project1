nation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 823","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"unglaublicheを 使います。","line_vi":"Tôi dùng unglaubliche.","focus_words":["unglaubliche"]},{"speaker":"B","line_target":"unterliegt は 何ですか。","line_vi":"unterliegt là cái gì?","focus_words":["unterliegt"]},{"speaker":"A","line_target":"unterrichtenです。","line_vi":"Đó là unterrichten.","focus_words":["unterrichten"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「unglaubliche」 có nghĩa là gì?","options":["không thể tin được","tùy thuộc vào","dạy","thẩm phán"],"answer_index":0,"explanation":"unglaubliche = không thể tin được"},{"question":"Từ 「unterliegt」 có nghĩa là gì?","options":["tùy thuộc vào","không thể tin được","dạy","thẩm phán"],"answer_index":0,"explanation":"unterliegt = tùy thuộc vào"},{"question":"Từ 「unterrichten」 có nghĩa là gì?","options":["dạy","không thể tin được","tùy thuộc vào","thẩm phán"],"answer_index":0,"explanation":"unterrichten = dạy"},{"question":"Từ 「urteilen」 có nghĩa là gì?","options":["thẩm phán","không thể tin được","tùy thuộc vào","dạy"],"answer_index":0,"explanation":"urteilen = thẩm phán"},{"question":"Từ 「verbraucht」 có nghĩa là gì?","options":["tiêu thụ","không thể tin được","tùy thuộc vào","dạy"],"answer_index":0,"explanation":"verbraucht = tiêu thụ"},{"question":"Từ 「verbreitete」 có nghĩa là gì?","options":["lây lan","không thể tin được","tùy thuộc vào","dạy"],"answer_index":0,"explanation":"verbreitete = lây lan"},{"question":"Từ 「verfahrens」 có nghĩa là gì?","options":["thủ tục","không thể tin được","tùy thuộc vào","dạy"],"answer_index":0,"explanation":"verfahrens = thủ tục"},{"question":"Từ 「verknüpft」 có nghĩa là gì?","options":["liên kết","không thể tin được","tùy thuộc vào","dạy"],"answer_index":0,"explanation":"verknüpft = liên kết"}],"pattern":[{"question":"Chọn từ đúng