":[{"question":"Chọn từ đúng cho nghĩa: được bảo vệ","options":["beschützt","betraf","betriebskosten","betrunkene"],"answer_index":0,"explanation":"beschützt = được bảo vệ"},{"question":"Chọn từ đúng cho nghĩa: liên quan","options":["betraf","beschützt","betriebskosten","betrunkene"],"answer_index":0,"explanation":"betraf = liên quan"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}