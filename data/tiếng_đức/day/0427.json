:[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 427","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"engenを 使います。","line_vi":"Tôi dùng engen.","focus_words":["engen"]},{"speaker":"B","line_target":"entwicklungen は 何ですか。","line_vi":"entwicklungen là cái gì?","focus_words":["entwicklungen"]},{"speaker":"A","line_target":"ereignisです。","line_vi":"Đó là ereignis.","focus_words":["ereignis"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7093aef9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「engen」 có nghĩa là gì?","options":["chặt chẽ","sự phát triển","sự kiện","phát minh ra"],"answer_index":0,"explanation":"engen = chặt chẽ"},{"question":"Từ 「entwicklungen」 có nghĩa là gì?","options":["sự phát triển","chặt chẽ","sự kiện","phát minh ra"],"answer_index":0,"explanation":"entwicklungen = sự phát triển"},{"question":"Từ 「ereignis」 có nghĩa là gì?","options":["sự kiện","chặt chẽ","sự phát triển","phát minh ra"],"answer_index":0,"explanation":"ereignis = sự kiện"},{"question":"Từ 「erfunden」 có nghĩa là gì?","options":["phát minh ra","chặt chẽ","sự phát triển","sự kiện"],"answer_index":0,"explanation":"erfunden = phát minh ra"},{"question":"Từ 「erkenntnisse」 có nghĩa là gì?","options":["hiểu biết sâu sắc","chặt chẽ","sự phát triển","sự kiện"],"answer_index":0,"explanation":"erkenntnisse = hiểu biết sâu sắc"},{"question":"Từ 「ermordet」 có nghĩa là gì?","options":["