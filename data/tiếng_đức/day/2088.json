に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2088","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"raiffeisenbankを 使います。","line_vi":"Tôi dùng raiffeisenbank.","focus_words":["raiffeisenbank"]},{"speaker":"B","line_target":"ratsam は 何ですか。","line_vi":"ratsam là cái gì?","focus_words":["ratsam"]},{"speaker":"A","line_target":"rausgekommenです。","line_vi":"Đó là rausgekommen.","focus_words":["rausgekommen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「raiffeisenbank」 có nghĩa là gì?","options":["Ngân hàng Raiffeisen","nên làm","đi ra","những người cấp tiến cánh hữu"],"answer_index":0,"explanation":"raiffeisenbank = Ngân hàng Raiffeisen"},{"question":"Từ 「ratsam」 có nghĩa là gì?","options":["nên làm","Ngân hàng Raiffeisen","đi ra","những người cấp tiến cánh hữu"],"answer_index":0,"explanation":"ratsam = nên làm"},{"question":"Từ 「rausgekommen」 có nghĩa là gì?","options":["đi ra","Ngân hàng Raiffeisen","nên làm","những người cấp tiến cánh hữu"],"answer_index":0,"explanation":"rausgekommen = đi ra"},{"question":"Từ 「rechtsradikalen」 có nghĩa là gì?","options":["những người cấp tiến cánh hữu","Ngân hàng Raiffeisen","nên làm","đi ra"],"answer_index":0,"explanation":"rechtsradikalen = những người cấp tiến cánh hữu"},{"question":"Từ 「regeneration」 có nghĩa là gì?","options":["tái sinh","Ngân hàng Raiffeisen","nên làm","đi ra"],"answer_index":0,"explanation":"regeneration = tái sinh"},{"question":"Từ 「rennstrecke」 có nghĩa là gì?","options":["đường đua","Ngân hàng Raiffeisen","nên làm","đi ra"],"answer_index":0,"explanation":"rennstrecke = đường đua"},{"question":"Từ 「republikanischen」 có nghĩa là gì?","options":["người theo chủ nghĩa c