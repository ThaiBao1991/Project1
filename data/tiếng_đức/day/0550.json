 từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 550","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"bargeldを 使います。","line_vi":"Tôi dùng bargeld.","focus_words":["bargeld"]},{"speaker":"B","line_target":"bauarbeiten は 何ですか。","line_vi":"bauarbeiten là cái gì?","focus_words":["bauarbeiten"]},{"speaker":"A","line_target":"bemühungenです。","line_vi":"Đó là bemühungen.","focus_words":["bemühungen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_95690214","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「bargeld」 có nghĩa là gì?","options":["tiền mặt","công trình xây dựng","nỗ lực","tính đến"],"answer_index":0,"explanation":"bargeld = tiền mặt"},{"question":"Từ 「bauarbeiten」 có nghĩa là gì?","options":["công trình xây dựng","tiền mặt","nỗ lực","tính đến"],"answer_index":0,"explanation":"bauarbeiten = công trình xây dựng"},{"question":"Từ 「bemühungen」 có nghĩa là gì?","options":["nỗ lực","tiền mặt","công trình xây dựng","tính đến"],"answer_index":0,"explanation":"bemühungen = nỗ lực"},{"question":"Từ 「berücksichtigen」 có nghĩa là gì?","options":["tính đến","tiền mặt","công trình xây dựng","nỗ lực"],"answer_index":0,"explanation":"berücksichtigen = tính đến"},{"question":"Từ 「brd」 có nghĩa là gì?","options":["brd","tiền mặt","công trình xây dựng","nỗ lực"],"answer_index":0,"explanation":"brd = brd"},{"question":"Từ 「bring」 có n