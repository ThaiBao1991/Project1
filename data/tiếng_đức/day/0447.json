."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 447","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"leidetを 使います。","line_vi":"Tôi dùng leidet.","focus_words":["leidet"]},{"speaker":"B","line_target":"lord は 何ですか。","line_vi":"lord là cái gì?","focus_words":["lord"]},{"speaker":"A","line_target":"mailsです。","line_vi":"Đó là mails.","focus_words":["mails"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1fdd4a08","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「leidet」 có nghĩa là gì?","options":["đau khổ","chúa tể","email","chuột"],"answer_index":0,"explanation":"leidet = đau khổ"},{"question":"Từ 「lord」 có nghĩa là gì?","options":["chúa tể","đau khổ","email","chuột"],"answer_index":0,"explanation":"lord = chúa tể"},{"question":"Từ 「mails」 có nghĩa là gì?","options":["email","đau khổ","chúa tể","chuột"],"answer_index":0,"explanation":"mails = email"},{"question":"Từ 「maus」 có nghĩa là gì?","options":["chuột","đau khổ","chúa tể","email"],"answer_index":0,"explanation":"maus = chuột"},{"question":"Từ 「monster」 có nghĩa là gì?","options":["quái vật","đau khổ","chúa tể","email"],"answer_index":0,"explanation":"monster = quái vật"},{"question":"Từ 「npd」 có nghĩa là gì?","options":["npd","đau khổ","chúa tể","email"],"answer_index":0,"explanation":"npd = npd"},{"question":"Từ 「persönlichkeit」 có nghĩa là gì?","options":["cá tính","đau khổ","chúa tể","email"],"answer_index":0,"explanation":"persönlichkeit = cá tính"},{"question":"Từ 「platte」 có nghĩa là gì?",