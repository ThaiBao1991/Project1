ogue":[{"title":"Cao cấp học thuật — Ngày 1860","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ungeklärtを 使います。","line_vi":"Tôi dùng ungeklärt.","focus_words":["ungeklärt"]},{"speaker":"B","line_target":"unternehmungen は 何ですか。","line_vi":"unternehmungen là cái gì?","focus_words":["unternehmungen"]},{"speaker":"A","line_target":"unterzubringenです。","line_vi":"Đó là unterzubringen.","focus_words":["unterzubringen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ungeklärt」 có nghĩa là gì?","options":["không rõ ràng","sự mạo hiểm","để chứa","mạo hiểm"],"answer_index":0,"explanation":"ungeklärt = không rõ ràng"},{"question":"Từ 「unternehmungen」 có nghĩa là gì?","options":["sự mạo hiểm","không rõ ràng","để chứa","mạo hiểm"],"answer_index":0,"explanation":"unternehmungen = sự mạo hiểm"},{"question":"Từ 「unterzubringen」 có nghĩa là gì?","options":["để chứa","không rõ ràng","sự mạo hiểm","mạo hiểm"],"answer_index":0,"explanation":"unterzubringen = để chứa"},{"question":"Từ 「venture」 có nghĩa là gì?","options":["mạo hiểm","không rõ ràng","sự mạo hiểm","để chứa"],"answer_index":0,"explanation":"venture = mạo hiểm"},{"question":"Từ 「verlangten」 có nghĩa là gì?","options":["yêu cầu","không rõ ràng","sự mạo hiểm","để chứa"],"answer_index":0,"explanation":"verlangten = yêu cầu"},{"question":"Từ 「vermessen」 có nghĩa là gì?","options":["đo","không rõ ràng","sự mạo hiểm","để chứa"],"answer_index":0,"explanation":"vermessen = đo"},{"question":"Từ 「vernommen」 có nghĩa là gì?","options":["nghe thấy","không rõ ràng","sự mạo hiểm","để chứa"],"answer_index":0,"explanation":"vernommen = nghe thấy"},{"question":"Từ 「vernünftiger」 có nghĩa là gì?","options":["hợp lý hơn","không rõ ràng","sự mạo hiểm","để chứa"],"answer_