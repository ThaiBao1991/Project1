s":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 758","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"profitiertを 使います。","line_vi":"Tôi dùng profitiert.","focus_words":["profitiert"]},{"speaker":"B","line_target":"ralph は 何ですか。","line_vi":"ralph là cái gì?","focus_words":["ralph"]},{"speaker":"A","line_target":"rechtsprechungです。","line_vi":"Đó là rechtsprechung.","focus_words":["rechtsprechung"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「profitiert」 có nghĩa là gì?","options":["lợi ích","ralph","luật học","chuyến đi"],"answer_index":0,"explanation":"profitiert = lợi ích"},{"question":"Từ 「ralph」 có nghĩa là gì?","options":["ralph","lợi ích","luật học","chuyến đi"],"answer_index":0,"explanation":"ralph = ralph"},{"question":"Từ 「rechtsprechung」 có nghĩa là gì?","options":["luật học","lợi ích","ralph","chuyến đi"],"answer_index":0,"explanation":"rechtsprechung = luật học"},{"question":"Từ 「reist」 có nghĩa là gì?","options":["chuyến đi","lợi ích","ralph","luật học"],"answer_index":0,"explanation":"reist = chuyến đi"},{"question":"Từ 「ruhr」 có nghĩa là gì?","options":["bệnh lỵ","lợi ích","ralph","luật học"],"answer_index":0,"explanation":"ruhr = bệnh lỵ"},{"question":"Từ 「ruhrgebiet」 có nghĩa là gì?","options":["khu vực ruhr","lợi ích","ralph","luật học"],"answer_index":0,"explanation":"ruhrgebiet = khu vực ruhr"},{"question":"Từ 「russischer」 có nghĩa là gì?","options":["tiếng Nga","lợi ích","ralph","luật học"],"answer_index":0,"explanation":"russischer = tiếng Nga"},{"question":"Từ 「räder」 có nghĩa là gì?","options":["bánh xe","lợi ích","ralph","luật học"],"answer_index":0,"explanation":"räder = bánh xe"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: lợi ích","options":["profitiert","ralph","rechtsprechung","reist"],"answer_index