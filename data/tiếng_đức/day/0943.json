{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 943","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"controlを 使います。","line_vi":"Tôi dùng control.","focus_words":["control"]},{"speaker":"B","line_target":"cross は 何ですか。","line_vi":"cross là cái gì?","focus_words":["cross"]},{"speaker":"A","line_target":"demokratischです。","line_vi":"Đó là demokratisch.","focus_words":["demokratisch"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「control」 có nghĩa là gì?","options":["kiểm soát","chéo","dân chủ","tên trộm"],"answer_index":0,"explanation":"control = kiểm soát"},{"question":"Từ 「cross」 có nghĩa là gì?","options":["chéo","kiểm soát","dân chủ","tên trộm"],"answer_index":0,"explanation":"cross = chéo"},{"question":"Từ 「demokratisch」 có nghĩa là gì?","options":["dân chủ","kiểm soát","chéo","tên trộm"],"answer_index":0,"explanation":"demokratisch = dân chủ"},{"question":"Từ 「dieb」 có nghĩa là gì?","options":["tên trộm","kiểm soát","chéo","dân chủ"],"answer_index":0,"explanation":"dieb = tên trộm"},{"question":"Từ 「dschungel」 có nghĩa là gì?","options":["rừng nhiệt đới","kiểm soát","chéo","dân chủ"],"answer_index":0,"explanation":"dschungel = rừng nhiệt đới"},{"question":"Từ 「eberhard」 có nghĩa là gì?","options":["eberhard","kiểm soát","chéo","dân chủ"],"answer_index":0,"explanation":"eberhard = eberhard"},{"question":"Từ 「eck」 có nghĩa là gì?","options":["ừm","kiểm soát","chéo","dân chủ"],"answer_index":0,"explanation":"eck = ừm"},{"question":"Từ 「eindeutige」 có nghĩa là gì?","options":["rõ ràng","kiểm soát","chéo","dân chủ"],"answer_index":0,"explanation":"eindeutige = rõ ràng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: kiểm soát","options":["control","cross","demokratisch","dieb"],"answer_index":0,"explanation":"control = kiểm soát"},{