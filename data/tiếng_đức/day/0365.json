_vi":"bãi bỏ","explanation":"bãi bỏ","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_bf6c6372","audio_ref":"m_cd697d37","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_2936530d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 365","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"würdを 使います。","line_vi":"Tôi dùng würd.","focus_words":["würd"]},{"speaker":"B","line_target":"zentralen は 何ですか。","line_vi":"zentralen là cái gì?","focus_words":["zentralen"]},{"speaker":"A","line_target":"ähnlichenです。","line_vi":"Đó là ähnlichen.","focus_words":["ähnlichen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b18782c5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「würd」 có nghĩa là gì?","options":["sẽ","trung tâm","tương tự","Áo"],"answer_index":0,"explanation":"würd = sẽ"},{"question":"Từ 「zentralen」 có nghĩa là gì?","options":["trung tâm","sẽ","tương tự","Áo"],"answer_index":0,"explanation":"zentralen = trung tâm"},{"question":"Từ 「ähnlichen」 có nghĩa là gì?","options":["tương tự","sẽ","trung tâm","Áo"],"answer_index":0,"explanation":"ähnlichen = tương tự"},{"question":"Từ 「österreicher」 có nghĩa là gì?","options":["Áo","sẽ","trung tâm","tương tự"],"answer_index":0,"explanation":"österreicher = Áo"},{"question":"Từ 「übernahme」 có nghĩa là gì?","options":["tiếp quản","sẽ","trung tâm","tương tự"],"answer_index":0,"explanation":"übernahme = tiếp quản"},{"question":"Từ 「anlässlich」 có nghĩa là gì?","options":["nhân dịp này","sẽ","trung tâm","tương tự"],"answer_index":0,"explanation":"anlässlich = nhân dịp