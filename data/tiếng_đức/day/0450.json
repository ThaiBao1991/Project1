xamples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 450","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"unklarを 使います。","line_vi":"Tôi dùng unklar.","focus_words":["unklar"]},{"speaker":"B","line_target":"unterhalb は 何ですか。","line_vi":"unterhalb là cái gì?","focus_words":["unterhalb"]},{"speaker":"A","line_target":"variantenです。","line_vi":"Đó là varianten.","focus_words":["varianten"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_db158974","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「unklar」 có nghĩa là gì?","options":["không rõ ràng","bên dưới","biến thể","vết thương"],"answer_index":0,"explanation":"unklar = không rõ ràng"},{"question":"Từ 「unterhalb」 có nghĩa là gì?","options":["bên dưới","không rõ ràng","biến thể","vết thương"],"answer_index":0,"explanation":"unterhalb = bên dưới"},{"question":"Từ 「varianten」 có nghĩa là gì?","options":["biến thể","không rõ ràng","bên dưới","vết thương"],"answer_index":0,"explanation":"varianten = biến thể"},{"question":"Từ 「verletzungen」 có nghĩa là gì?","options":["vết thương","không rõ ràng","bên dưới","biến thể"],"answer_index":0,"explanation":"verletzungen = vết thương"},{"question":"Từ 「verwirrt」 có nghĩa là gì?","options":["bối rối","không rõ ràng","bên dưới","biến thể"],"answer_index":0,"explanation":"verwirrt = bối rối"},{"question":"Từ 「warf」 có nghĩa là gì?","options":["ném","không rõ ràng","bên dưới","biến thể"],"answer_index":0,"explan