ds":["dip"]},{"speaker":"B","line_target":"disturbing は 何ですか。","line_vi":"disturbing là cái gì?","focus_words":["disturbing"]},{"speaker":"A","line_target":"doesntです。","line_vi":"Đó là doesnt.","focus_words":["doesnt"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「dip」 có nghĩa là gì?","options":["nhúng","làm phiền","không","dấu chấm"],"answer_index":0,"explanation":"dip = nhúng"},{"question":"Từ 「disturbing」 có nghĩa là gì?","options":["làm phiền","nhúng","không","dấu chấm"],"answer_index":0,"explanation":"disturbing = làm phiền"},{"question":"Từ 「doesnt」 có nghĩa là gì?","options":["không","nhúng","làm phiền","dấu chấm"],"answer_index":0,"explanation":"doesnt = không"},{"question":"Từ 「dot」 có nghĩa là gì?","options":["dấu chấm","nhúng","làm phiền","không"],"answer_index":0,"explanation":"dot = dấu chấm"},{"question":"Từ 「dresses」 có nghĩa là gì?","options":["váy","nhúng","làm phiền","không"],"answer_index":0,"explanation":"dresses = váy"},{"question":"Từ 「dylan」 có nghĩa là gì?","options":["dylan","nhúng","làm phiền","không"],"answer_index":0,"explanation":"dylan = dylan"},{"question":"Từ 「effectiveness」 có nghĩa là gì?","options":["hiệu quả","nhúng","làm phiền","không"],"answer_index":0,"explanation":"effectiveness = hiệu quả"},{"question":"Từ 「eliminated」 có nghĩa là gì?","options":["loại bỏ","nhúng","làm phiền","không"],"answer_index":0,"explanation":"eliminated = loại bỏ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nhúng","options":["dip","disturbing","doesnt","dot"],"answer_index":0,"explanation":"dip = nhúng"},{"question":"Chọn từ đúng cho nghĩa: làm phiền","options":["disturbing","dip","doesnt","dot"],"answer_index":0,"explanation":"disturbing = làm phiền"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{