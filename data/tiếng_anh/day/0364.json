ferences":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 364","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"bandsを 使います。","line_vi":"Tôi dùng bands.","focus_words":["bands"]},{"speaker":"B","line_target":"christians は 何ですか。","line_vi":"christians là cái gì?","focus_words":["christians"]},{"speaker":"A","line_target":"collectです。","line_vi":"Đó là collect.","focus_words":["collect"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1591c0f5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「bands」 có nghĩa là gì?","options":["ban nhạc","người theo đạo thiên chúa","thu thập","thương mại"],"answer_index":0,"explanation":"bands = ban nhạc"},{"question":"Từ 「christians」 có nghĩa là gì?","options":["người theo đạo thiên chúa","ban nhạc","thu thập","thương mại"],"answer_index":0,"explanation":"christians = người theo đạo thiên chúa"},{"question":"Từ 「collect」 có nghĩa là gì?","options":["thu thập","ban nhạc","người theo đạo thiên chúa","thương mại"],"answer_index":0,"explanation":"collect = thu thập"},{"question":"Từ 「commerce」 có nghĩa là gì?","options":["thương mại","ban nhạc","người theo đạo thiên chúa","thu thập"],"answer_index":0,"explanation":"commerce = thương mại"},{"question":"Từ 「cop」 có nghĩa là gì?","options":["cảnh sát","ban nhạc","người theo đạo thi