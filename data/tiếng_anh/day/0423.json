aning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 423","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"performancesを 使います。","line_vi":"Tôi dùng performances.","focus_words":["performances"]},{"speaker":"B","line_target":"philippines は 何ですか。","line_vi":"philippines là cái gì?","focus_words":["philippines"]},{"speaker":"A","line_target":"polishです。","line_vi":"Đó là polish.","focus_words":["polish"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2e571304","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「performances」 có nghĩa là gì?","options":["biểu diễn","philippines","đánh bóng","khuyến nghị"],"answer_index":0,"explanation":"performances = biểu diễn"},{"question":"Từ 「philippines」 có nghĩa là gì?","options":["philippines","biểu diễn","đánh bóng","khuyến nghị"],"answer_index":0,"explanation":"philippines = philippines"},{"question":"Từ 「polish」 có nghĩa là gì?","options":["đánh bóng","biểu diễn","philippines","khuyến nghị"],"answer_index":0,"explanation":"polish = đánh bóng"},{"question":"Từ 「recommendations」 có nghĩa là gì?","options":["khuyến nghị","biểu diễn","philippines","đánh bóng"],"answer_index":0,"explanation":"recommendations = khuyến nghị"},{"question":"Từ 「recover」 có nghĩa là gì?","options":["phục hồi","biểu diễn","philippines","đánh bóng"],"answer_index":0,"explanation":"recover = phục hồi"},{"question":"Từ 「regarded」 có nghĩa là gì?","options":["coi","biểu diễn","philippines","đánh bóng"],"answe