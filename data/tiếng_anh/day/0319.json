ter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 319","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"uncleを 使います。","line_vi":"Tôi dùng uncle.","focus_words":["uncle"]},{"speaker":"B","line_target":"unusual は 何ですか。","line_vi":"unusual là cái gì?","focus_words":["unusual"]},{"speaker":"A","line_target":"watersです。","line_vi":"Đó là waters.","focus_words":["waters"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_522fa4a3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「uncle」 có nghĩa là gì?","options":["chú","bất thường","nước","rừng"],"answer_index":0,"explanation":"uncle = chú"},{"question":"Từ 「unusual」 có nghĩa là gì?","options":["bất thường","chú","nước","rừng"],"answer_index":0,"explanation":"unusual = bất thường"},{"question":"Từ 「waters」 có nghĩa là gì?","options":["nước","chú","bất thường","rừng"],"answer_index":0,"explanation":"waters = nước"},{"question":"Từ 「woods」 có nghĩa là gì?","options":["rừng","chú","bất thường","nước"],"answer_index":0,"explanation":"woods = rừng"},{"question":"Từ 「arrival」 có nghĩa là gì?","options":["sự đến","chú","bất thường","nước"],"answer_index":0,"explanation":"arrival = sự đến"},{"question":"Từ 「asks」 có nghĩa là gì?","options":["hỏi","chú","bất thường","nước"],"answer_index":0,"explanation":"asks = hỏi"},{"question":"Từ 「assault」 có nghĩa là gì?","options":["tấn công","chú","bất thường","nước"],"answer_index":0,"explanation":"assault = tấn công"},{"question":"Từ 「awareness」 có nghĩa là g