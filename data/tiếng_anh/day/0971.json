ation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"comparativeを 使います。","line_vi":"Tôi dùng comparative.","focus_words":["comparative"]},{"speaker":"B","line_target":"complement は 何ですか。","line_vi":"complement là cái gì?","focus_words":["complement"]},{"speaker":"A","line_target":"connorです。","line_vi":"Đó là connor.","focus_words":["connor"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「comparative」 có nghĩa là gì?","options":["so sánh","bổ sung","Connor","chinh phục"],"answer_index":0,"explanation":"comparative = so sánh"},{"question":"Từ 「complement」 có nghĩa là gì?","options":["bổ sung","so sánh","Connor","chinh phục"],"answer_index":0,"explanation":"complement = bổ sung"},{"question":"Từ 「connor」 có nghĩa là gì?","options":["Connor","so sánh","bổ sung","chinh phục"],"answer_index":0,"explanation":"connor = Connor"},{"question":"Từ 「conquer」 có nghĩa là gì?","options":["chinh phục","so sánh","bổ sung","Connor"],"answer_index":0,"explanation":"conquer = chinh phục"},{"question":"Từ 「conquest」 có nghĩa là gì?","options":["chinh phục","so sánh","bổ sung","Connor"],"answer_index":0,"explanation":"conquest = chinh phục"},{"question":"Từ 「contested」 có nghĩa là gì?","options":["tranh cãi","so sánh","bổ sung","Connor"],"answer_index":0,"explanation":"contested = tranh cãi"},{"question":"Từ 「continuity」 có nghĩa là gì?","options":["sự liên tục","so sánh","bổ sung","Connor"],"answer_index":0,"explanation":"continuity = sự liên tục"},{"question":"Từ 「cornwall」 có nghĩa là gì?","options":["bức tường ngô","so sánh","bổ sung","Connor"],"answer_index":0,"explanation":"cornwall = bức tường ngô"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: so sánh","options":["comparative","complement","connor","conquer"],"ans