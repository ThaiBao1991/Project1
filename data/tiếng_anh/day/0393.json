 + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 393","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"infectionを 使います。","line_vi":"Tôi dùng infection.","focus_words":["infection"]},{"speaker":"B","line_target":"instagram は 何ですか。","line_vi":"instagram là cái gì?","focus_words":["instagram"]},{"speaker":"A","line_target":"intentionです。","line_vi":"Đó là intention.","focus_words":["intention"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_180600cc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「infection」 có nghĩa là gì?","options":["nhiễm trùng","instagram","ý định","Iowa"],"answer_index":0,"explanation":"infection = nhiễm trùng"},{"question":"Từ 「instagram」 có nghĩa là gì?","options":["instagram","nhiễm trùng","ý định","Iowa"],"answer_index":0,"explanation":"instagram = instagram"},{"question":"Từ 「intention」 có nghĩa là gì?","options":["ý định","nhiễm trùng","instagram","Iowa"],"answer_index":0,"explanation":"intention = ý định"},{"question":"Từ 「iowa」 có nghĩa là gì?","options":["Iowa","nhiễm trùng","instagram","ý định"],"answer_index":0,"explanation":"iowa = Iowa"},{"question":"Từ 「jokes」 có nghĩa là gì?","options":["truyện cười","nhiễm trùng","instagram","ý định"],"answer_index":0,"explanation":"jokes = truyện cười"},{"question":"Từ 「knee」 có nghĩa là gì?","options":["đầu gối","nhiễm trùng"