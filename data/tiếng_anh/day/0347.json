ences":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 347","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"hadn'tを 使います。","line_vi":"Tôi dùng hadn't.","focus_words":["hadn't"]},{"speaker":"B","line_target":"hire は 何ですか。","line_vi":"hire là cái gì?","focus_words":["hire"]},{"speaker":"A","line_target":"hopです。","line_vi":"Đó là hop.","focus_words":["hop"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b631fc40","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「hadn't」 có nghĩa là gì?","options":["đã không","thuê","nhảy","hy vọng"],"answer_index":0,"explanation":"hadn't = đã không"},{"question":"Từ 「hire」 có nghĩa là gì?","options":["thuê","đã không","nhảy","hy vọng"],"answer_index":0,"explanation":"hire = thuê"},{"question":"Từ 「hop」 có nghĩa là gì?","options":["nhảy","đã không","thuê","hy vọng"],"answer_index":0,"explanation":"hop = nhảy"},{"question":"Từ 「hopes」 có nghĩa là gì?","options":["hy vọng","đã không","thuê","nhảy"],"answer_index":0,"explanation":"hopes = hy vọng"},{"question":"Từ 「insane」 có nghĩa là gì?","options":["điên rồ","đã không","thuê","nhảy"],"answer_index":0,"explanation":"insane = điên rồ"},{"question":"Từ 「installed」 có nghĩa là gì?","options":["đã cài đặt","đã không","thuê","nhảy"],"answer_index":0,"explanation":"installed = đã cài đặ