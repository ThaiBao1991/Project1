ary"]},{"speaker":"B","line_target":"exited は 何ですか。","line_vi":"exited là cái gì?","focus_words":["exited"]},{"speaker":"A","line_target":"expansiveです。","line_vi":"Đó là expansive.","focus_words":["expansive"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「exemplary」 có nghĩa là gì?","options":["mẫu mực","đã thoát","mở rộng","bà già"],"answer_index":0,"explanation":"exemplary = mẫu mực"},{"question":"Từ 「exited」 có nghĩa là gì?","options":["đã thoát","mẫu mực","mở rộng","bà già"],"answer_index":0,"explanation":"exited = đã thoát"},{"question":"Từ 「expansive」 có nghĩa là gì?","options":["mở rộng","mẫu mực","đã thoát","bà già"],"answer_index":0,"explanation":"expansive = mở rộng"},{"question":"Từ 「fife」 có nghĩa là gì?","options":["bà già","mẫu mực","đã thoát","mở rộng"],"answer_index":0,"explanation":"fife = bà già"},{"question":"Từ 「firm's」 có nghĩa là gì?","options":["của công ty","mẫu mực","đã thoát","mở rộng"],"answer_index":0,"explanation":"firm's = của công ty"},{"question":"Từ 「flakes」 có nghĩa là gì?","options":["vảy","mẫu mực","đã thoát","mở rộng"],"answer_index":0,"explanation":"flakes = vảy"},{"question":"Từ 「flavours」 có nghĩa là gì?","options":["hương vị","mẫu mực","đã thoát","mở rộng"],"answer_index":0,"explanation":"flavours = hương vị"},{"question":"Từ 「geez」 có nghĩa là gì?","options":["ôi","mẫu mực","đã thoát","mở rộng"],"answer_index":0,"explanation":"geez = ôi"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: mẫu mực","options":["exemplary","exited","expansive","fife"],"answer_index":0,"explanation":"exemplary = mẫu mực"},{"question":"Chọn từ đúng cho nghĩa: đã thoát","options":["exited","exemplary","expansive","fife"],"answer_index":0,"explanation":"exited = đã thoát"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":