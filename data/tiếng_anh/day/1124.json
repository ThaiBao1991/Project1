ません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1124","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"reviveを 使います。","line_vi":"Tôi dùng revive.","focus_words":["revive"]},{"speaker":"B","line_target":"rigorous は 何ですか。","line_vi":"rigorous là cái gì?","focus_words":["rigorous"]},{"speaker":"A","line_target":"ringingです。","line_vi":"Đó là ringing.","focus_words":["ringing"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「revive」 có nghĩa là gì?","options":["hồi sinh","khắt khe","đổ chuông","rna"],"answer_index":0,"explanation":"revive = hồi sinh"},{"question":"Từ 「rigorous」 có nghĩa là gì?","options":["khắt khe","hồi sinh","đổ chuông","rna"],"answer_index":0,"explanation":"rigorous = khắt khe"},{"question":"Từ 「ringing」 có nghĩa là gì?","options":["đổ chuông","hồi sinh","khắt khe","rna"],"answer_index":0,"explanation":"ringing = đổ chuông"},{"question":"Từ 「rna」 có nghĩa là gì?","options":["rna","hồi sinh","khắt khe","đổ chuông"],"answer_index":0,"explanation":"rna = rna"},{"question":"Từ 「scarf」 có nghĩa là gì?","options":["khăn choàng","hồi sinh","khắt khe","đổ chuông"],"answer_index":0,"explanation":"scarf = khăn choàng"},{"question":"Từ 「scenery」 có nghĩa là gì?","options":["phong cảnh","hồi sinh","khắt khe","đổ chuông"],"answer_index":0,"explanation":"scenery = phong cảnh"},{"question":"Từ 「selections」 có nghĩa là gì?","options":["sự lựa chọn","hồi sinh","khắt khe","đổ chuông"],"answer_index":0,"explanation":"selections = sự lựa chọn"},{"question":"Từ 「sensory」 có nghĩa là gì?","options":["giác quan","hồi sinh","khắt khe","đổ chuông"],"answer_index":0,"explanation":"sensory = giác quan"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: hồi sinh","options":["revive",