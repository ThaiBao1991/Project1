 Ngày 887","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"decayを 使います。","line_vi":"Tôi dùng decay.","focus_words":["decay"]},{"speaker":"B","line_target":"declining は 何ですか。","line_vi":"declining là cái gì?","focus_words":["declining"]},{"speaker":"A","line_target":"depressingです。","line_vi":"Đó là depressing.","focus_words":["depressing"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「decay」 có nghĩa là gì?","options":["phân rã","suy giảm","chán nản","món tráng miệng"],"answer_index":0,"explanation":"decay = phân rã"},{"question":"Từ 「declining」 có nghĩa là gì?","options":["suy giảm","phân rã","chán nản","món tráng miệng"],"answer_index":0,"explanation":"declining = suy giảm"},{"question":"Từ 「depressing」 có nghĩa là gì?","options":["chán nản","phân rã","suy giảm","món tráng miệng"],"answer_index":0,"explanation":"depressing = chán nản"},{"question":"Từ 「dessert」 có nghĩa là gì?","options":["món tráng miệng","phân rã","suy giảm","chán nản"],"answer_index":0,"explanation":"dessert = món tráng miệng"},{"question":"Từ 「destinations」 có nghĩa là gì?","options":["điểm đến","phân rã","suy giảm","chán nản"],"answer_index":0,"explanation":"destinations = điểm đến"},{"question":"Từ 「diagnostic」 có nghĩa là gì?","options":["chẩn đoán","phân rã","suy giảm","chán nản"],"answer_index":0,"explanation":"diagnostic = chẩn đoán"},{"question":"Từ 「diane」 có nghĩa là gì?","options":["diane","phân rã","suy giảm","chán nản"],"answer_index":0,"explanation":"diane = diane"},{"question":"Từ 「differential」 có nghĩa là gì?","options":["sự khác biệt","phân rã","suy giảm","chán nản"],"answer_index":0,"explanation":"differential = sự khác biệt"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: phân rã","options":["decay",