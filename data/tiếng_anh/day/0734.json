":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"offenceを 使います。","line_vi":"Tôi dùng offence.","focus_words":["offence"]},{"speaker":"B","line_target":"packaging は 何ですか。","line_vi":"packaging là cái gì?","focus_words":["packaging"]},{"speaker":"A","line_target":"patriotsです。","line_vi":"Đó là patriots.","focus_words":["patriots"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「offence」 có nghĩa là gì?","options":["sự xúc phạm","bao bì","những người yêu nước","đi tiểu"],"answer_index":0,"explanation":"offence = sự xúc phạm"},{"question":"Từ 「packaging」 có nghĩa là gì?","options":["bao bì","sự xúc phạm","những người yêu nước","đi tiểu"],"answer_index":0,"explanation":"packaging = bao bì"},{"question":"Từ 「patriots」 có nghĩa là gì?","options":["những người yêu nước","sự xúc phạm","bao bì","đi tiểu"],"answer_index":0,"explanation":"patriots = những người yêu nước"},{"question":"Từ 「pee」 có nghĩa là gì?","options":["đi tiểu","sự xúc phạm","bao bì","những người yêu nước"],"answer_index":0,"explanation":"pee = đi tiểu"},{"question":"Từ 「pillow」 có nghĩa là gì?","options":["cái gối","sự xúc phạm","bao bì","những người yêu nước"],"answer_index":0,"explanation":"pillow = cái gối"},{"question":"Từ 「pirate」 có nghĩa là gì?","options":["cướp biển","sự xúc phạm","bao bì","những người yêu nước"],"answer_index":0,"explanation":"pirate = cướp biển"},{"question":"Từ 「polar」 có nghĩa là gì?","options":["vùng cực","sự xúc phạm","bao bì","những người yêu nước"],"answer_index":0,"explanation":"polar = vùng cực"},{"question":"Từ 「prediction」 có nghĩa là gì?","options":["dự đoán","sự xúc phạm","bao bì","những người yêu nước"],"answer_index":0,"explanation":"prediction = dự đoán"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: s