ogue":[{"title":"Cao cấp học thuật — Ngày 1837","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"persuasionを 使います。","line_vi":"Tôi dùng persuasion.","focus_words":["persuasion"]},{"speaker":"B","line_target":"phased は 何ですか。","line_vi":"phased là cái gì?","focus_words":["phased"]},{"speaker":"A","line_target":"phyllisです。","line_vi":"Đó là phyllis.","focus_words":["phyllis"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「persuasion」 có nghĩa là gì?","options":["sự thuyết phục","theo từng giai đoạn","cây diên vĩ","kẻ sọc"],"answer_index":0,"explanation":"persuasion = sự thuyết phục"},{"question":"Từ 「phased」 có nghĩa là gì?","options":["theo từng giai đoạn","sự thuyết phục","cây diên vĩ","kẻ sọc"],"answer_index":0,"explanation":"phased = theo từng giai đoạn"},{"question":"Từ 「phyllis」 có nghĩa là gì?","options":["cây diên vĩ","sự thuyết phục","theo từng giai đoạn","kẻ sọc"],"answer_index":0,"explanation":"phyllis = cây diên vĩ"},{"question":"Từ 「plaid」 có nghĩa là gì?","options":["kẻ sọc","sự thuyết phục","theo từng giai đoạn","cây diên vĩ"],"answer_index":0,"explanation":"plaid = kẻ sọc"},{"question":"Từ 「playback」 có nghĩa là gì?","options":["phát lại","sự thuyết phục","theo từng giai đoạn","cây diên vĩ"],"answer_index":0,"explanation":"playback = phát lại"},{"question":"Từ 「plush」 có nghĩa là gì?","options":["sang trọng","sự thuyết phục","theo từng giai đoạn","cây diên vĩ"],"answer_index":0,"explanation":"plush = sang trọng"},{"question":"Từ 「portraying」 có nghĩa là gì?","options":["vẽ chân dung","sự thuyết phục","theo từng giai đoạn","cây diên vĩ"],"answer_index":0,"explanation":"portraying = vẽ chân dung"},{"question":"Từ 「portrays」 có nghĩa là gì?","options":["miêu tả","sự thuyết phục","theo