 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 260","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"mateを 使います。","line_vi":"Tôi dùng mate.","focus_words":["mate"]},{"speaker":"B","line_target":"matt は 何ですか。","line_vi":"matt là cái gì?","focus_words":["matt"]},{"speaker":"A","line_target":"nearbyです。","line_vi":"Đó là nearby.","focus_words":["nearby"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_184f23a9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「mate」 có nghĩa là gì?","options":["bạn đời","mờ","gần đó","tiếng ồn"],"answer_index":0,"explanation":"mate = bạn đời"},{"question":"Từ 「matt」 có nghĩa là gì?","options":["mờ","bạn đời","gần đó","tiếng ồn"],"answer_index":0,"explanation":"matt = mờ"},{"question":"Từ 「nearby」 có nghĩa là gì?","options":["gần đó","bạn đời","mờ","tiếng ồn"],"answer_index":0,"explanation":"nearby = gần đó"},{"question":"Từ 「noise」 có nghĩa là gì?","options":["tiếng ồn","bạn đời","mờ","gần đó"],"answer_index":0,"explanation":"noise = tiếng ồn"},{"question":"Từ 「origin」 có nghĩa là gì?","options":["nguồn gốc","bạn đời","mờ","gần đó"],"answer_index":0,"explanation":"origin = nguồn gốc"},{"question":"Từ 「pakistan」 có nghĩa là gì?","options":["Pakistan","bạn đời","mờ","gần đó"],"answer_index":0,"explanation":"pakistan = Pakistan"},{"question":"Từ 「panel」 có nghĩa là gì?","options":["bảng điều khiển","bạn đời","mờ","gần đó"],"answer_index":0,"explanation"