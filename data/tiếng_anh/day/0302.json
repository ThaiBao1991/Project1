 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 302","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"harmを 使います。","line_vi":"Tôi dùng harm.","focus_words":["harm"]},{"speaker":"B","line_target":"healthcare は 何ですか。","line_vi":"healthcare là cái gì?","focus_words":["healthcare"]},{"speaker":"A","line_target":"householdです。","line_vi":"Đó là household.","focus_words":["household"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_48f4779e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「harm」 có nghĩa là gì?","options":["làm hại","chăm sóc sức khỏe","hộ gia đình","nhập cư"],"answer_index":0,"explanation":"harm = làm hại"},{"question":"Từ 「healthcare」 có nghĩa là gì?","options":["chăm sóc sức khỏe","làm hại","hộ gia đình","nhập cư"],"answer_index":0,"explanation":"healthcare = chăm sóc sức khỏe"},{"question":"Từ 「household」 có nghĩa là gì?","options":["hộ gia đình","làm hại","chăm sóc sức khỏe","nhập cư"],"answer_index":0,"explanation":"household = hộ gia đình"},{"question":"Từ 「immigration」 có nghĩa là gì?","options":["nhập cư","làm hại","chăm sóc sức khỏe","hộ gia đình"],"answer_index":0,"explanation":"immigration = nhập cư"},{"question":"Từ 「impressive」 có nghĩa là gì?","options":["ấn tượng","làm hại","chăm sóc sức khỏe","hộ gia đình"],"answer_index":0,"explanation":"impressive = ấn tượng"},{"question":"Từ 「jews」 có nghĩa là gì?","options":["người Do Thái",