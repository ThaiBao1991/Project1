s":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 396","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"spotsを 使います。","line_vi":"Tôi dùng spots.","focus_words":["spots"]},{"speaker":"B","line_target":"stats は 何ですか。","line_vi":"stats là cái gì?","focus_words":["stats"]},{"speaker":"A","line_target":"strugglingです。","line_vi":"Đó là struggling.","focus_words":["struggling"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c1c8b3db","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「spots」 có nghĩa là gì?","options":["đốm","số liệu thống kê","đấu tranh","đáng kể"],"answer_index":0,"explanation":"spots = đốm"},{"question":"Từ 「stats」 có nghĩa là gì?","options":["số liệu thống kê","đốm","đấu tranh","đáng kể"],"answer_index":0,"explanation":"stats = số liệu thống kê"},{"question":"Từ 「struggling」 có nghĩa là gì?","options":["đấu tranh","đốm","số liệu thống kê","đáng kể"],"answer_index":0,"explanation":"struggling = đấu tranh"},{"question":"Từ 「substantial」 có nghĩa là gì?","options":["đáng kể","đốm","số liệu thống kê","đấu tranh"],"answer_index":0,"explanation":"substantial = đáng kể"},{"question":"Từ 「teen」 có nghĩa là gì?","options":["thiếu niên","đốm","số liệu thống kê","đấu tranh"],"answer_index":0,"explanation":"teen = thiếu niên"},{"question":"Từ 「temperatures」