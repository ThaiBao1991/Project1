go công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2389","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"quirkを 使います。","line_vi":"Tôi dùng quirk.","focus_words":["quirk"]},{"speaker":"B","line_target":"rabid は 何ですか。","line_vi":"rabid là cái gì?","focus_words":["rabid"]},{"speaker":"A","line_target":"rafaです。","line_vi":"Đó là rafa.","focus_words":["rafa"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「quirk」 có nghĩa là gì?","options":["kỳ quặc","bệnh dại","rafa","rasmussen"],"answer_index":0,"explanation":"quirk = kỳ quặc"},{"question":"Từ 「rabid」 có nghĩa là gì?","options":["bệnh dại","kỳ quặc","rafa","rasmussen"],"answer_index":0,"explanation":"rabid = bệnh dại"},{"question":"Từ 「rafa」 có nghĩa là gì?","options":["rafa","kỳ quặc","bệnh dại","rasmussen"],"answer_index":0,"explanation":"rafa = rafa"},{"question":"Từ 「rasmussen」 có nghĩa là gì?","options":["rasmussen","kỳ quặc","bệnh dại","rafa"],"answer_index":0,"explanation":"rasmussen = rasmussen"},{"question":"Từ 「redneck」 có nghĩa là gì?","options":["người lỗ mãng","kỳ quặc","bệnh dại","rafa"],"answer_index":0,"explanation":"redneck = người lỗ mãng"},{"question":"Từ 「reformer」 có nghĩa là gì?","options":["người cải cách","kỳ quặc","bệnh dại","rafa"],"answer_index":0,"explanation":"reformer = người cải cách"},{"question":"Từ 「reformers」 có nghĩa là gì?","options":["những người cải cách","kỳ quặc","bệnh dại","rafa"],"answer_index":0,"explanation":"reformers = những người cải cách"},{"question":"Từ 「registrations」 có nghĩa là gì?","options":["đăng ký","kỳ quặc","bệnh dại","rafa"],"answer_index":0,"explanation":"registrations = đăng ký"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: kỳ quặc","options":["quirk","rabid","r