ogue":[{"title":"Trung cấp công việc — Ngày 862","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"brotherhoodを 使います。","line_vi":"Tôi dùng brotherhood.","focus_words":["brotherhood"]},{"speaker":"B","line_target":"buddhist は 何ですか。","line_vi":"buddhist là cái gì?","focus_words":["buddhist"]},{"speaker":"A","line_target":"builderです。","line_vi":"Đó là builder.","focus_words":["builder"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「brotherhood」 có nghĩa là gì?","options":["tình huynh đệ","phật tử","người xây dựng","bánh ngọt"],"answer_index":0,"explanation":"brotherhood = tình huynh đệ"},{"question":"Từ 「buddhist」 có nghĩa là gì?","options":["phật tử","tình huynh đệ","người xây dựng","bánh ngọt"],"answer_index":0,"explanation":"buddhist = phật tử"},{"question":"Từ 「builder」 có nghĩa là gì?","options":["người xây dựng","tình huynh đệ","phật tử","bánh ngọt"],"answer_index":0,"explanation":"builder = người xây dựng"},{"question":"Từ 「cakes」 có nghĩa là gì?","options":["bánh ngọt","tình huynh đệ","phật tử","người xây dựng"],"answer_index":0,"explanation":"cakes = bánh ngọt"},{"question":"Từ 「carriage」 có nghĩa là gì?","options":["vận chuyển","tình huynh đệ","phật tử","người xây dựng"],"answer_index":0,"explanation":"carriage = vận chuyển"},{"question":"Từ 「celebrations」 có nghĩa là gì?","options":["lễ kỷ niệm","tình huynh đệ","phật tử","người xây dựng"],"answer_index":0,"explanation":"celebrations = lễ kỷ niệm"},{"question":"Từ 「censorship」 có nghĩa là gì?","options":["sự kiểm duyệt","tình huynh đệ","phật tử","người xây dựng"],"answer_index":0,"explanation":"censorship = sự kiểm duyệt"},{"question":"Từ 「clarify」 có nghĩa là gì?","options":["làm rõ","tình huynh đệ","phật tử","người xây dựng"],"answer_i