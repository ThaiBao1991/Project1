akes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1816","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"socioeconomicを 使います。","line_vi":"Tôi dùng socioeconomic.","focus_words":["socioeconomic"]},{"speaker":"B","line_target":"solicitors は 何ですか。","line_vi":"solicitors là cái gì?","focus_words":["solicitors"]},{"speaker":"A","line_target":"spontaneouslyです。","line_vi":"Đó là spontaneously.","focus_words":["spontaneously"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「socioeconomic」 có nghĩa là gì?","options":["kinh tế xã hội","luật sư","một cách tự phát","hấp"],"answer_index":0,"explanation":"socioeconomic = kinh tế xã hội"},{"question":"Từ 「solicitors」 có nghĩa là gì?","options":["luật sư","kinh tế xã hội","một cách tự phát","hấp"],"answer_index":0,"explanation":"solicitors = luật sư"},{"question":"Từ 「spontaneously」 có nghĩa là gì?","options":["một cách tự phát","kinh tế xã hội","luật sư","hấp"],"answer_index":0,"explanation":"spontaneously = một cách tự phát"},{"question":"Từ 「steamed」 có nghĩa là gì?","options":["hấp","kinh tế xã hội","luật sư","một cách tự phát"],"answer_index":0,"explanation":"steamed = hấp"},{"question":"Từ 「stockton」 có nghĩa là gì?","options":["stockton","kinh tế xã hội","luật sư","một cách tự phát"],"answer_index":0,"explanation":"stockton = stockton"},{"question":"Từ 「stratford」 có nghĩa là gì?","options":["Stratford","kinh tế xã hội","luật sư","một cách tự phát"],"answer_index":0,"explanation":"stratford = Stratford"},{"question":"Từ 「studs」 có nghĩa là gì?","options":["đinh tán","kinh t