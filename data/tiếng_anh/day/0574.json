shita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 574","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"cognitiveを 使います。","line_vi":"Tôi dùng cognitive.","focus_words":["cognitive"]},{"speaker":"B","line_target":"competitors は 何ですか。","line_vi":"competitors là cái gì?","focus_words":["competitors"]},{"speaker":"A","line_target":"connecticutです。","line_vi":"Đó là connecticut.","focus_words":["connecticut"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e0e0376c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「cognitive」 có nghĩa là gì?","options":["nhận thức","đối thủ cạnh tranh","Connecticut","chuyển đổi"],"answer_index":0,"explanation":"cognitive = nhận thức"},{"question":"Từ 「competitors」 có nghĩa là gì?","options":["đối thủ cạnh tranh","nhận thức","Connecticut","chuyển đổi"],"answer_index":0,"explanation":"competitors = đối thủ cạnh tranh"},{"question":"Từ 「connecticut」 có nghĩa là gì?","options":["Connecticut","nhận thức","đối thủ cạnh tranh","chuyển đổi"],"answer_index":0,"explanation":"connecticut = Connecticut"},{"question":"Từ 「convert」 có nghĩa là gì?","options":["chuyển đổi","nhận thức","đối thủ cạnh tranh","Connecticut"],"answer_index":0,"explanation":"convert = chuyển đổi"},{"question":"Từ 「cooked」 có nghĩa là gì?","options":["nấu chín","nhận thức","đối thủ cạnh tranh"