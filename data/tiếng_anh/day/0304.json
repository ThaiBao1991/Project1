 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 304","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"proposalを 使います。","line_vi":"Tôi dùng proposal.","focus_words":["proposal"]},{"speaker":"B","line_target":"province は 何ですか。","line_vi":"province là cái gì?","focus_words":["province"]},{"speaker":"A","line_target":"purchasedです。","line_vi":"Đó là purchased.","focus_words":["purchased"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_776b5960","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「proposal」 có nghĩa là gì?","options":["đề nghị","tỉnh","đã mua","sự công nhận"],"answer_index":0,"explanation":"proposal = đề nghị"},{"question":"Từ 「province」 có nghĩa là gì?","options":["tỉnh","đề nghị","đã mua","sự công nhận"],"answer_index":0,"explanation":"province = tỉnh"},{"question":"Từ 「purchased」 có nghĩa là gì?","options":["đã mua","đề nghị","tỉnh","sự công nhận"],"answer_index":0,"explanation":"purchased = đã mua"},{"question":"Từ 「recognition」 có nghĩa là gì?","options":["sự công nhận","đề nghị","tỉnh","đã mua"],"answer_index":0,"explanation":"recognition = sự công nhận"},{"question":"Từ 「reputation」 có nghĩa là gì?","options":["danh tiếng","đề nghị","tỉnh","đã mua"],"answer_index":0,"explanation":"reputation = danh tiếng"},{"question":"Từ 「rolling」 có nghĩa là gì?","options":["lăn","đề nghị","tỉnh","đã mua"],"answer_index":0,"explanation":"rolling = lăn"},{