ence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 267","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"widelyを 使います。","line_vi":"Tôi dùng widely.","focus_words":["widely"]},{"speaker":"B","line_target":"worldwide は 何ですか。","line_vi":"worldwide là cái gì?","focus_words":["worldwide"]},{"speaker":"A","line_target":"agesです。","line_vi":"Đó là ages.","focus_words":["ages"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_58ced67a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「widely」 có nghĩa là gì?","options":["rộng rãi","trên toàn thế giới","lứa tuổi","ngày kỷ niệm"],"answer_index":0,"explanation":"widely = rộng rãi"},{"question":"Từ 「worldwide」 có nghĩa là gì?","options":["trên toàn thế giới","rộng rãi","lứa tuổi","ngày kỷ niệm"],"answer_index":0,"explanation":"worldwide = trên toàn thế giới"},{"question":"Từ 「ages」 có nghĩa là gì?","options":["lứa tuổi","rộng rãi","trên toàn thế giới","ngày kỷ niệm"],"answer_index":0,"explanation":"ages = lứa tuổi"},{"question":"Từ 「anniversary」 có nghĩa là gì?","options":["ngày kỷ niệm","rộng rãi","trên toàn thế giới","lứa tuổi"],"answer_index":0,"explanation":"anniversary = ngày kỷ niệm"},{"question":"Từ 「attractive」 có nghĩa là gì?","options":["hấp dẫn","rộng rãi","trên toàn thế giới","lứa tuổi"],"answer_index":0,"explanation":"attractive = hấp dẫn"},{"question":"Từ 「bike」 có nghĩa là gì?","options":["xe đạp","rộng rãi","trên toàn thế giới","lứa tuổi"],"answ