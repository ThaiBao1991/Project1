ôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 449","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"dvdを 使います。","line_vi":"Tôi dùng dvd.","focus_words":["dvd"]},{"speaker":"B","line_target":"emperor は 何ですか。","line_vi":"emperor là cái gì?","focus_words":["emperor"]},{"speaker":"A","line_target":"employersです。","line_vi":"Đó là employers.","focus_words":["employers"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f240d3b1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「dvd」 có nghĩa là gì?","options":["đĩa DVD","hoàng đế","người sử dụng lao động","to lớn"],"answer_index":0,"explanation":"dvd = đĩa DVD"},{"question":"Từ 「emperor」 có nghĩa là gì?","options":["hoàng đế","đĩa DVD","người sử dụng lao động","to lớn"],"answer_index":0,"explanation":"emperor = hoàng đế"},{"question":"Từ 「employers」 có nghĩa là gì?","options":["người sử dụng lao động","đĩa DVD","hoàng đế","to lớn"],"answer_index":0,"explanation":"employers = người sử dụng lao động"},{"question":"Từ 「enormous」 có nghĩa là gì?","options":["to lớn","đĩa DVD","hoàng đế","người sử dụng lao động"],"answer_index":0,"explanation":"enormous = to lớn"},{"question":"Từ 「errors」 có nghĩa là gì?","options":["lỗi","đĩa DVD","hoàng đế","người sử dụng lao động"],"answer_index":0,"explanation":"errors = lỗi"},{"question":"Từ 「focusing」 có nghĩa là gì?","options":["tập trung","đĩa DVD","hoàng đế","người sử dụng lao động"],"answer_index":0,"explanation":"focusing = tập trung"},{"question":"Từ 「forgive」 có