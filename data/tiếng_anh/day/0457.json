ôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 457","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"democratを 使います。","line_vi":"Tôi dùng democrat.","focus_words":["democrat"]},{"speaker":"B","line_target":"deposit は 何ですか。","line_vi":"deposit là cái gì?","focus_words":["deposit"]},{"speaker":"A","line_target":"destinationです。","line_vi":"Đó là destination.","focus_words":["destination"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_efbaf6a6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「democrat」 có nghĩa là gì?","options":["nhà dân chủ","đặt cọc","điểm đến","bụi bẩn"],"answer_index":0,"explanation":"democrat = nhà dân chủ"},{"question":"Từ 「deposit」 có nghĩa là gì?","options":["đặt cọc","nhà dân chủ","điểm đến","bụi bẩn"],"answer_index":0,"explanation":"deposit = đặt cọc"},{"question":"Từ 「destination」 có nghĩa là gì?","options":["điểm đến","nhà dân chủ","đặt cọc","bụi bẩn"],"answer_index":0,"explanation":"destination = điểm đến"},{"question":"Từ 「dirt」 có nghĩa là gì?","options":["bụi bẩn","nhà dân chủ","đặt cọc","điểm đến"],"answer_index":0,"explanation":"dirt = bụi bẩn"},{"question":"Từ 「diverse」 có nghĩa là gì?","options":["đa dạng","nhà dân chủ","đặt cọc","điểm đến"],"answer_index":0,"explanation":"diverse = đa dạng"},{"question":"Từ 「divine」 có nghĩa là gì?","options":["thần thánh","nhà dân chủ","đặt cọc","điểm đến"],"answer_index":0,"explanation":"divine = thần thánh"},{"question":"Từ 「emails」 có nghĩa là gì?","options":["email","nhà dân 