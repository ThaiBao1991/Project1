:[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 597","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"should'veを 使います。","line_vi":"Tôi dùng should've.","focus_words":["should've"]},{"speaker":"B","line_target":"skull は 何ですか。","line_vi":"skull là cái gì?","focus_words":["skull"]},{"speaker":"A","line_target":"slotです。","line_vi":"Đó là slot.","focus_words":["slot"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c96fcb5b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「should've」 có nghĩa là gì?","options":["lẽ ra phải","hộp sọ","khe cắm","đập vỡ"],"answer_index":0,"explanation":"should've = lẽ ra phải"},{"question":"Từ 「skull」 có nghĩa là gì?","options":["hộp sọ","lẽ ra phải","khe cắm","đập vỡ"],"answer_index":0,"explanation":"skull = hộp sọ"},{"question":"Từ 「slot」 có nghĩa là gì?","options":["khe cắm","lẽ ra phải","hộp sọ","đập vỡ"],"answer_index":0,"explanation":"slot = khe cắm"},{"question":"Từ 「smash」 có nghĩa là gì?","options":["đập vỡ","lẽ ra phải","hộp sọ","khe cắm"],"answer_index":0,"explanation":"smash = đập vỡ"},{"question":"Từ 「statue」 có nghĩa là gì?","options":["bức tượng","lẽ ra phải","hộp sọ","khe cắm"],"answer_index":0,"explanation":"statue = bức tượng"},{"question":"Từ 「surprisingly」 có nghĩa là gì?","options":["thật ngạc nhiên","lẽ ra phải","hộp sọ","khe cắm"],"answer_index":0,"explanation":"surprisingly = thật ngạc nhiên"},{"question":"Từ 「surrender」 có n