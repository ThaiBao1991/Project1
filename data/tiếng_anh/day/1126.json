es":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1126","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"stunnedを 使います。","line_vi":"Tôi dùng stunned.","focus_words":["stunned"]},{"speaker":"B","line_target":"suppression は 何ですか。","line_vi":"suppression là cái gì?","focus_words":["suppression"]},{"speaker":"A","line_target":"sushiです。","line_vi":"Đó là sushi.","focus_words":["sushi"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「stunned」 có nghĩa là gì?","options":["choáng váng","đàn áp","sushi","đình chỉ"],"answer_index":0,"explanation":"stunned = choáng váng"},{"question":"Từ 「suppression」 có nghĩa là gì?","options":["đàn áp","choáng váng","sushi","đình chỉ"],"answer_index":0,"explanation":"suppression = đàn áp"},{"question":"Từ 「sushi」 có nghĩa là gì?","options":["sushi","choáng váng","đàn áp","đình chỉ"],"answer_index":0,"explanation":"sushi = sushi"},{"question":"Từ 「suspend」 có nghĩa là gì?","options":["đình chỉ","choáng váng","đàn áp","sushi"],"answer_index":0,"explanation":"suspend = đình chỉ"},{"question":"Từ 「swelling」 có nghĩa là gì?","options":["sưng tấy","choáng váng","đàn áp","sushi"],"answer_index":0,"explanation":"swelling = sưng tấy"},{"question":"Từ 「tails」 có nghĩa là gì?","options":["đuôi","choáng váng","đàn áp","sushi"],"answer_index":0,"explanation":"tails = đuôi"},{"question":"Từ 「terminology」 có nghĩa là gì?","options":["thuật ngữ","choáng váng","đàn áp","sushi"],"answer_index":0,"explanation":"terminology = thuật ngữ"},{"question":"Từ 「theatrical」 có nghĩa là gì?","options":["sân khấu","choáng váng","đàn áp","sushi"],"answer_index":0,"explanation":"theatrical = sân khấu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: choáng váng","options":["stunned","suppression","sushi","suspend"],"answer_index":0,"expl