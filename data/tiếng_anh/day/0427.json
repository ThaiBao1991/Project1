ence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 427","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"crucialを 使います。","line_vi":"Tôi dùng crucial.","focus_words":["crucial"]},{"speaker":"B","line_target":"daughters は 何ですか。","line_vi":"daughters là cái gì?","focus_words":["daughters"]},{"speaker":"A","line_target":"dependentです。","line_vi":"Đó là dependent.","focus_words":["dependent"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f452a364","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「crucial」 có nghĩa là gì?","options":["quan trọng","con gái","phụ thuộc","thảo luận"],"answer_index":0,"explanation":"crucial = quan trọng"},{"question":"Từ 「daughters」 có nghĩa là gì?","options":["con gái","quan trọng","phụ thuộc","thảo luận"],"answer_index":0,"explanation":"daughters = con gái"},{"question":"Từ 「dependent」 có nghĩa là gì?","options":["phụ thuộc","quan trọng","con gái","thảo luận"],"answer_index":0,"explanation":"dependent = phụ thuộc"},{"question":"Từ 「discussions」 có nghĩa là gì?","options":["thảo luận","quan trọng","con gái","phụ thuộc"],"answer_index":0,"explanation":"discussions = thảo luận"},{"question":"Từ 「drives」 có nghĩa là gì?","options":["ổ đĩa","quan trọng","con gái","phụ thuộc"],"answer_index":0,"explanation":"drives = ổ đĩa"},{"question":"Từ 「dual」 có nghĩa là gì?","options":["kép","quan trọng","con gái","phụ thuộc"],"answer_index":0,"explanation":"d