 được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 479","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"pleasantを 使います。","line_vi":"Tôi dùng pleasant.","focus_words":["pleasant"]},{"speaker":"B","line_target":"portrait は 何ですか。","line_vi":"portrait là cái gì?","focus_words":["portrait"]},{"speaker":"A","line_target":"productiveです。","line_vi":"Đó là productive.","focus_words":["productive"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ae38c77a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「pleasant」 có nghĩa là gì?","options":["dễ chịu","chân dung","năng suất","nhắc nhở"],"answer_index":0,"explanation":"pleasant = dễ chịu"},{"question":"Từ 「portrait」 có nghĩa là gì?","options":["chân dung","dễ chịu","năng suất","nhắc nhở"],"answer_index":0,"explanation":"portrait = chân dung"},{"question":"Từ 「productive」 có nghĩa là gì?","options":["năng suất","dễ chịu","chân dung","nhắc nhở"],"answer_index":0,"explanation":"productive = năng suất"},{"question":"Từ 「reminds」 có nghĩa là gì?","options":["nhắc nhở","dễ chịu","chân dung","năng suất"],"answer_index":0,"explanation":"reminds = nhắc nhở"},{"question":"Từ 「reserves」 có nghĩa là gì?","options":["dự trữ","dễ chịu","chân dung","năng suất"],"answer_index":0,"explanation":"reserves = dự trữ"},{"question":"Từ 「ron」 có nghĩa là gì?","options":["ron","dễ chịu","chân dung","năn