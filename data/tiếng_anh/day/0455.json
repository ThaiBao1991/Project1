 cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 455","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"wellsを 使います。","line_vi":"Tôi dùng wells.","focus_words":["wells"]},{"speaker":"B","line_target":"wheels は 何ですか。","line_vi":"wheels là cái gì?","focus_words":["wheels"]},{"speaker":"A","line_target":"8thです。","line_vi":"Đó là 8th.","focus_words":["8th"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_611f2eb5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「wells」 có nghĩa là gì?","options":["giếng","bánh xe","ngày 8","abc"],"answer_index":0,"explanation":"wells = giếng"},{"question":"Từ 「wheels」 có nghĩa là gì?","options":["bánh xe","giếng","ngày 8","abc"],"answer_index":0,"explanation":"wheels = bánh xe"},{"question":"Từ 「8th」 có nghĩa là gì?","options":["ngày 8","giếng","bánh xe","abc"],"answer_index":0,"explanation":"8th = ngày 8"},{"question":"Từ 「abc」 có nghĩa là gì?","options":["abc","giếng","bánh xe","ngày 8"],"answer_index":0,"explanation":"abc = abc"},{"question":"Từ 「abortion」 có nghĩa là gì?","options":["phá thai","giếng","bánh xe","ngày 8"],"answer_index":0,"explanation":"abortion = phá thai"},{"question":"Từ 「accuracy」 có nghĩa là gì?","options":["độ chính xác","giếng","bánh xe","ngày 8"],"answer_index":0,"explanation":"accuracy = độ chính xác"},{"question":"Từ 「albert」 có nghĩa là gì?","options":["albert","giếng","bánh xe","ngày 8"],"answer_index":0,"explanation":"albert = albert"},{"question":"Từ 「applying」 có nghĩa là gì?","options":["áp dụng","giếng","bánh xe","ngày 8"],"answer_