 động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 391","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"constitutionalを 使います。","line_vi":"Tôi dùng constitutional.","focus_words":["constitutional"]},{"speaker":"B","line_target":"crossing は 何ですか。","line_vi":"crossing là cái gì?","focus_words":["crossing"]},{"speaker":"A","line_target":"d.cです。","line_vi":"Đó là d.c.","focus_words":["d.c"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5833495a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「constitutional」 có nghĩa là gì?","options":["hiến pháp","băng qua","dc","phòng thủ"],"answer_index":0,"explanation":"constitutional = hiến pháp"},{"question":"Từ 「crossing」 có nghĩa là gì?","options":["băng qua","hiến pháp","dc","phòng thủ"],"answer_index":0,"explanation":"crossing = băng qua"},{"question":"Từ 「d.c」 có nghĩa là gì?","options":["dc","hiến pháp","băng qua","phòng thủ"],"answer_index":0,"explanation":"d.c = dc"},{"question":"Từ 「defending」 có nghĩa là gì?","options":["phòng thủ","hiến pháp","băng qua","dc"],"answer_index":0,"explanation":"defending = phòng thủ"},{"question":"Từ 「density」 có nghĩa là gì?","options":["mật độ","hiến pháp","băng qua","dc"],"answer_index":0,"explanation":"density = mật độ"},{"question":"Từ 「difficulty」 có nghĩa là gì?","options":["khó khăn","hiến pháp","băng qua","dc"],"answer_index":0,"explanation"