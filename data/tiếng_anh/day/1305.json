 việc — Ngày 1305","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"advisingを 使います。","line_vi":"Tôi dùng advising.","focus_words":["advising"]},{"speaker":"B","line_target":"affirmative は 何ですか。","line_vi":"affirmative là cái gì?","focus_words":["affirmative"]},{"speaker":"A","line_target":"agnesです。","line_vi":"Đó là agnes.","focus_words":["agnes"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「advising」 có nghĩa là gì?","options":["tư vấn","khẳng định","agnes","báo động"],"answer_index":0,"explanation":"advising = tư vấn"},{"question":"Từ 「affirmative」 có nghĩa là gì?","options":["khẳng định","tư vấn","agnes","báo động"],"answer_index":0,"explanation":"affirmative = khẳng định"},{"question":"Từ 「agnes」 có nghĩa là gì?","options":["agnes","tư vấn","khẳng định","báo động"],"answer_index":0,"explanation":"agnes = agnes"},{"question":"Từ 「alarms」 có nghĩa là gì?","options":["báo động","tư vấn","khẳng định","agnes"],"answer_index":0,"explanation":"alarms = báo động"},{"question":"Từ 「alliances」 có nghĩa là gì?","options":["liên minh","tư vấn","khẳng định","agnes"],"answer_index":0,"explanation":"alliances = liên minh"},{"question":"Từ 「alma」 có nghĩa là gì?","options":["ông già","tư vấn","khẳng định","agnes"],"answer_index":0,"explanation":"alma = ông già"},{"question":"Từ 「ambiguous」 có nghĩa là gì?","options":["mơ hồ","tư vấn","khẳng định","agnes"],"answer_index":0,"explanation":"ambiguous = mơ hồ"},{"question":"Từ 「archaeology」 có nghĩa là gì?","options":["khảo cổ học","tư vấn","khẳng định","agnes"],"answer_index":0,"explanation":"archaeology = khảo cổ học"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tư vấn","options":["advising","affirmative","agnes","alarms"],"answer_index":0,"explanation