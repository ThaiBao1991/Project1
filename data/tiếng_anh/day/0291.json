lanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 291","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"formationを 使います。","line_vi":"Tôi dùng formation.","focus_words":["formation"]},{"speaker":"B","line_target":"fought は 何ですか。","line_vi":"fought là cái gì?","focus_words":["fought"]},{"speaker":"A","line_target":"gainedです。","line_vi":"Đó là gained.","focus_words":["gained"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8997e2dd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「formation」 có nghĩa là gì?","options":["sự hình thành","đã chiến đấu","đạt được","phòng trưng bày"],"answer_index":0,"explanation":"formation = sự hình thành"},{"question":"Từ 「fought」 có nghĩa là gì?","options":["đã chiến đấu","sự hình thành","đạt được","phòng trưng bày"],"answer_index":0,"explanation":"fought = đã chiến đấu"},{"question":"Từ 「gained」 có nghĩa là gì?","options":["đạt được","sự hình thành","đã chiến đấu","phòng trưng bày"],"answer_index":0,"explanation":"gained = đạt được"},{"question":"Từ 「gallery」 có nghĩa là gì?","options":["phòng trưng bày","sự hình thành","đã chiến đấu","đạt được"],"answer_index":0,"explanation":"gallery = phòng trưng bày"},{"question":"Từ 「highway」 có nghĩa là gì?","options":["đường cao 