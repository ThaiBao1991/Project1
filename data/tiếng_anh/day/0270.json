aning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 270","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"motorを 使います。","line_vi":"Tôi dùng motor.","focus_words":["motor"]},{"speaker":"B","line_target":"officially は 何ですか。","line_vi":"officially là cái gì?","focus_words":["officially"]},{"speaker":"A","line_target":"peakです。","line_vi":"Đó là peak.","focus_words":["peak"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c60faa50","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「motor」 có nghĩa là gì?","options":["động cơ","chính thức","đỉnh điểm","phần"],"answer_index":0,"explanation":"motor = động cơ"},{"question":"Từ 「officially」 có nghĩa là gì?","options":["chính thức","động cơ","đỉnh điểm","phần"],"answer_index":0,"explanation":"officially = chính thức"},{"question":"Từ 「peak」 có nghĩa là gì?","options":["đỉnh điểm","động cơ","chính thức","phần"],"answer_index":0,"explanation":"peak = đỉnh điểm"},{"question":"Từ 「portion」 có nghĩa là gì?","options":["phần","động cơ","chính thức","đỉnh điểm"],"answer_index":0,"explanation":"portion = phần"},{"question":"Từ 「pounds」 có nghĩa là gì?","options":["bảng Anh","động cơ","chính thức","đỉnh điểm"],"answer_index":0,"explanation":"pounds = bảng Anh"},{"question":"Từ 「princess」 có nghĩa là gì?","options":["công chúa","động cơ","chính thức","đỉnh điểm"],"answer_index":0,"explanation":"princess = công chúa"},{"question":"Từ 「protein」 có nghĩa là gì?","options":["chất đạm","động cơ","chính thức","đỉnh điểm"],"answer_index":0,"explanat