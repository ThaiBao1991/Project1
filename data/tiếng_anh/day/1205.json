 Ngày 1205","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"giganticを 使います。","line_vi":"Tôi dùng gigantic.","focus_words":["gigantic"]},{"speaker":"B","line_target":"gill は 何ですか。","line_vi":"gill là cái gì?","focus_words":["gill"]},{"speaker":"A","line_target":"groomです。","line_vi":"Đó là groom.","focus_words":["groom"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「gigantic」 có nghĩa là gì?","options":["khổng lồ","mang","chú rể","canh gác"],"answer_index":0,"explanation":"gigantic = khổng lồ"},{"question":"Từ 「gill」 có nghĩa là gì?","options":["mang","khổng lồ","chú rể","canh gác"],"answer_index":0,"explanation":"gill = mang"},{"question":"Từ 「groom」 có nghĩa là gì?","options":["chú rể","khổng lồ","mang","canh gác"],"answer_index":0,"explanation":"groom = chú rể"},{"question":"Từ 「guarded」 có nghĩa là gì?","options":["canh gác","khổng lồ","mang","chú rể"],"answer_index":0,"explanation":"guarded = canh gác"},{"question":"Từ 「guitarist」 có nghĩa là gì?","options":["nghệ sĩ guitar","khổng lồ","mang","chú rể"],"answer_index":0,"explanation":"guitarist = nghệ sĩ guitar"},{"question":"Từ 「halftime」 có nghĩa là gì?","options":["giờ nghỉ giải lao","khổng lồ","mang","chú rể"],"answer_index":0,"explanation":"halftime = giờ nghỉ giải lao"},{"question":"Từ 「hamas」 có nghĩa là gì?","options":["hamas","khổng lồ","mang","chú rể"],"answer_index":0,"explanation":"hamas = hamas"},{"question":"Từ 「harriet」 có nghĩa là gì?","options":["con thỏ rừng","khổng lồ","mang","chú rể"],"answer_index":0,"explanation":"harriet = con thỏ rừng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: khổng lồ","options":["gigantic","gill","groom","guarded"],"answer_index":0,"explanation":"gigantic = khổng lồ"},{"question":"Chọn từ đ