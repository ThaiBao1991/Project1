ch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 451","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"loadedを 使います。","line_vi":"Tôi dùng loaded.","focus_words":["loaded"]},{"speaker":"B","line_target":"lonely は 何ですか。","line_vi":"lonely là cái gì?","focus_words":["lonely"]},{"speaker":"A","line_target":"maintainingです。","line_vi":"Đó là maintaining.","focus_words":["maintaining"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cd913f59","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「loaded」 có nghĩa là gì?","options":["đã nạp","cô đơn","duy trì","đo"],"answer_index":0,"explanation":"loaded = đã nạp"},{"question":"Từ 「lonely」 có nghĩa là gì?","options":["cô đơn","đã nạp","duy trì","đo"],"answer_index":0,"explanation":"lonely = cô đơn"},{"question":"Từ 「maintaining」 có nghĩa là gì?","options":["duy trì","đã nạp","cô đơn","đo"],"answer_index":0,"explanation":"maintaining = duy trì"},{"question":"Từ 「measured」 có nghĩa là gì?","options":["đo","đã nạp","cô đơn","duy trì"],"answer_index":0,"explanation":"measured = đo"},{"question":"Từ 「mercy」 có nghĩa là gì?","options":["lòng thương xót","đã nạp","cô đơn","duy trì"],"answer_index":0,"explanation":"mercy = lòng thương xót"},{"question":"Từ 「nevertheless」 có nghĩa là gì?","options":["tuy nhiên","đã nạp","cô đơn","duy trì"],"answer_index":0,"explanation":"nevertheless = tuy nhiên"},{"question":"Từ 「newspapers」 có nghĩa là gì?","options":["báo chí","đã nạp","cô đơn","duy trì"],"answer_index":0,"explanation":"newspapers