 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 598","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"tenderを 使います。","line_vi":"Tôi dùng tender.","focus_words":["tender"]},{"speaker":"B","line_target":"thoroughly は 何ですか。","line_vi":"thoroughly là cái gì?","focus_words":["thoroughly"]},{"speaker":"A","line_target":"toddです。","line_vi":"Đó là todd.","focus_words":["todd"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fbc78d36","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「tender」 có nghĩa là gì?","options":["đấu thầu","triệt để","trẻ mới biết đi","phương pháp điều trị"],"answer_index":0,"explanation":"tender = đấu thầu"},{"question":"Từ 「thoroughly」 có nghĩa là gì?","options":["triệt để","đấu thầu","trẻ mới biết đi","phương pháp điều trị"],"answer_index":0,"explanation":"thoroughly = triệt để"},{"question":"Từ 「todd」 có nghĩa là gì?","options":["trẻ mới biết đi","đấu thầu","triệt để","phương pháp điều trị"],"answer_index":0,"explanation":"todd = trẻ mới biết đi"},{"question":"Từ 「treatments」 có nghĩa là gì?","options":["phương pháp điều trị","đấu thầu","triệt để","trẻ mới biết đi"],"answer_index":0,"explanation":"treatments = phương pháp điều trị"},{"question":"Từ 「tweeted」 có nghĩa là gì?","options":["đã tweet","đấu thầu","triệt để","trẻ mới biết đi"],"answer_index":0,"explanation":"tweeted = đã tweet"},{"question":"Từ 「vacuum」 có nghĩa là gì