 が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 546","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"awakeを 使います。","line_vi":"Tôi dùng awake.","focus_words":["awake"]},{"speaker":"B","line_target":"beam は 何ですか。","line_vi":"beam là cái gì?","focus_words":["beam"]},{"speaker":"A","line_target":"beansです。","line_vi":"Đó là beans.","focus_words":["beans"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7f6fede1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「awake」 có nghĩa là gì?","options":["thức dậy","chùm tia","đậu","ràng buộc"],"answer_index":0,"explanation":"awake = thức dậy"},{"question":"Từ 「beam」 có nghĩa là gì?","options":["chùm tia","thức dậy","đậu","ràng buộc"],"answer_index":0,"explanation":"beam = chùm tia"},{"question":"Từ 「beans」 có nghĩa là gì?","options":["đậu","thức dậy","chùm tia","ràng buộc"],"answer_index":0,"explanation":"beans = đậu"},{"question":"Từ 「binding」 có nghĩa là gì?","options":["ràng buộc","thức dậy","chùm tia","đậu"],"answer_index":0,"explanation":"binding = ràng buộc"},{"question":"Từ 「blank」 có nghĩa là gì?","options":["chỗ trống","thức dậy","chùm tia","đậu"],"answer_index":0,"explanation":"blank = chỗ trống"},{"question":"Từ 「buffalo」 có nghĩa là gì?","options":["trâu","thức dậy","chùm tia","đậu"],"answer_index":0,"explanation":"buffalo = t