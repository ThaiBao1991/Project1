i":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 452","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"pissedを 使います。","line_vi":"Tôi dùng pissed.","focus_words":["pissed"]},{"speaker":"B","line_target":"poem は 何ですか。","line_vi":"poem là cái gì?","focus_words":["poem"]},{"speaker":"A","line_target":"powderです。","line_vi":"Đó là powder.","focus_words":["powder"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_92fe3060","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「pissed」 có nghĩa là gì?","options":["tức giận","bài thơ","bột","được hỗ trợ"],"answer_index":0,"explanation":"pissed = tức giận"},{"question":"Từ 「poem」 có nghĩa là gì?","options":["bài thơ","tức giận","bột","được hỗ trợ"],"answer_index":0,"explanation":"poem = bài thơ"},{"question":"Từ 「powder」 có nghĩa là gì?","options":["bột","tức giận","bài thơ","được hỗ trợ"],"answer_index":0,"explanation":"powder = bột"},{"question":"Từ 「powered」 có nghĩa là gì?","options":["được hỗ trợ","tức giận","bài thơ","bột"],"answer_index":0,"explanation":"powered = được hỗ trợ"},{"question":"Từ 「promises」 có nghĩa là gì?","options":["lời hứa","tức giận","bài thơ","bột"],"answer_index":0,"explanation":"promises = lời hứa"},{"question":"Từ 「quotes」 có nghĩa là gì?","options":["dấu ngoặc kép","tức giận","bài thơ","bột"],"answer_index":0,"explanation":"quotes = dấu ngoặc kép"},{"question":"Từ 「racism」 có nghĩa là gì?","options":["phân biệt chủng tộc","tức giận","bài thơ","bột"],"answer_index":0,"ex