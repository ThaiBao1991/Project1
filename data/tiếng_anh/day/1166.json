ogue":[{"title":"Trung cấp công việc — Ngày 1166","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"crownedを 使います。","line_vi":"Tôi dùng crowned.","focus_words":["crowned"]},{"speaker":"B","line_target":"cynthia は 何ですか。","line_vi":"cynthia là cái gì?","focus_words":["cynthia"]},{"speaker":"A","line_target":"dangです。","line_vi":"Đó là dang.","focus_words":["dang"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「crowned」 có nghĩa là gì?","options":["đăng quang","cynthia","dang","sự lừa dối"],"answer_index":0,"explanation":"crowned = đăng quang"},{"question":"Từ 「cynthia」 có nghĩa là gì?","options":["cynthia","đăng quang","dang","sự lừa dối"],"answer_index":0,"explanation":"cynthia = cynthia"},{"question":"Từ 「dang」 có nghĩa là gì?","options":["dang","đăng quang","cynthia","sự lừa dối"],"answer_index":0,"explanation":"dang = dang"},{"question":"Từ 「deception」 có nghĩa là gì?","options":["sự lừa dối","đăng quang","cynthia","dang"],"answer_index":0,"explanation":"deception = sự lừa dối"},{"question":"Từ 「decor」 có nghĩa là gì?","options":["trang trí","đăng quang","cynthia","dang"],"answer_index":0,"explanation":"decor = trang trí"},{"question":"Từ 「defeating」 có nghĩa là gì?","options":["đánh bại","đăng quang","cynthia","dang"],"answer_index":0,"explanation":"defeating = đánh bại"},{"question":"Từ 「derivative」 có nghĩa là gì?","options":["phái sinh","đăng quang","cynthia","dang"],"answer_index":0,"explanation":"derivative = phái sinh"},{"question":"Từ 「discomfort」 có nghĩa là gì?","options":["khó chịu","đăng quang","cynthia","dang"],"answer_index":0,"explanation":"discomfort = khó chịu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đăng quang","options":["crowned","cynthia","dang","deception"],"answ