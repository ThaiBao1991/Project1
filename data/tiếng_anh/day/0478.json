 = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 478","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"magicalを 使います。","line_vi":"Tôi dùng magical.","focus_words":["magical"]},{"speaker":"B","line_target":"mills は 何ですか。","line_vi":"mills là cái gì?","focus_words":["mills"]},{"speaker":"A","line_target":"motivationです。","line_vi":"Đó là motivation.","focus_words":["motivation"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f178bcb4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「magical」 có nghĩa là gì?","options":["huyền diệu","nhà máy","động lực","khó chịu"],"answer_index":0,"explanation":"magical = huyền diệu"},{"question":"Từ 「mills」 có nghĩa là gì?","options":["nhà máy","huyền diệu","động lực","khó chịu"],"answer_index":0,"explanation":"mills = nhà máy"},{"question":"Từ 「motivation」 có nghĩa là gì?","options":["động lực","huyền diệu","nhà máy","khó chịu"],"answer_index":0,"explanation":"motivation = động lực"},{"question":"Từ 「nasty」 có nghĩa là gì?","options":["khó chịu","huyền diệu","nhà máy","động lực"],"answer_index":0,"explanation":"nasty = khó chịu"},{"question":"Từ 「oliver」 có nghĩa là gì?","options":["ô liu","huyền diệu","nhà máy","động lực"],"answer_index":0,"explanation":"oliver = ô liu"},{"question":"Từ 「outfit」 có nghĩa là gì?","options":["trang phục","huyền diệu","nhà máy","động lực"],"answer_i