ừ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 549","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"hornを 使います。","line_vi":"Tôi dùng horn.","focus_words":["horn"]},{"speaker":"B","line_target":"hurry は 何ですか。","line_vi":"hurry là cái gì?","focus_words":["hurry"]},{"speaker":"A","line_target":"immuneです。","line_vi":"Đó là immune.","focus_words":["immune"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e8b1bd0c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「horn」 có nghĩa là gì?","options":["sừng","nhanh lên","miễn dịch","lạm phát"],"answer_index":0,"explanation":"horn = sừng"},{"question":"Từ 「hurry」 có nghĩa là gì?","options":["nhanh lên","sừng","miễn dịch","lạm phát"],"answer_index":0,"explanation":"hurry = nhanh lên"},{"question":"Từ 「immune」 có nghĩa là gì?","options":["miễn dịch","sừng","nhanh lên","lạm phát"],"answer_index":0,"explanation":"immune = miễn dịch"},{"question":"Từ 「inflation」 có nghĩa là gì?","options":["lạm phát","sừng","nhanh lên","miễn dịch"],"answer_index":0,"explanation":"inflation = lạm phát"},{"question":"Từ 「ingredients」 có nghĩa là gì?","options":["thành phần","sừng","nhanh lên","miễn dịch"],"answer_index":0,"explanation":"ingredients = thành phần"},{"question":"Từ 「inspection」 có nghĩa là gì?","options":["kiểm tra","sừng","nhanh lên","miễn dịch"],"answer_index":0,"explanation":"inspection 