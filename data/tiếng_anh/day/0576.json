ã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 576","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"grandmaを 使います。","line_vi":"Tôi dùng grandma.","focus_words":["grandma"]},{"speaker":"B","line_target":"grip は 何ですか。","line_vi":"grip là cái gì?","focus_words":["grip"]},{"speaker":"A","line_target":"handfulです。","line_vi":"Đó là handful.","focus_words":["handful"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8343a099","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「grandma」 có nghĩa là gì?","options":["bà","nắm chặt","một số ít","hạnh phúc"],"answer_index":0,"explanation":"grandma = bà"},{"question":"Từ 「grip」 có nghĩa là gì?","options":["nắm chặt","bà","một số ít","hạnh phúc"],"answer_index":0,"explanation":"grip = nắm chặt"},{"question":"Từ 「handful」 có nghĩa là gì?","options":["một số ít","bà","nắm chặt","hạnh phúc"],"answer_index":0,"explanation":"handful = một số ít"},{"question":"Từ 「happily」 có nghĩa là gì?","options":["hạnh phúc","bà","nắm chặt","một số ít"],"answer_index":0,"explanation":"happily = hạnh phúc"},{"question":"Từ 「harmony」 có nghĩa là gì?","options":["sự hòa hợp","bà","nắm chặt","một số ít"],"answer_index":0,"explanation":"harmony = sự hòa hợp"},{"question":"Từ 「hmm」 có nghĩa là gì?","options":["ừm","bà","nắm chặt","một số ít"],"answer_index":0,"explanation":"hmm = ừm"},{"question":"Từ 「humble」 có nghĩa là gì?","options":["khi