":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 293","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"promisedを 使います。","line_vi":"Tôi dùng promised.","focus_words":["promised"]},{"speaker":"B","line_target":"repeat は 何ですか。","line_vi":"repeat là cái gì?","focus_words":["repeat"]},{"speaker":"A","line_target":"returningです。","line_vi":"Đó là returning.","focus_words":["returning"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_67353c49","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「promised」 có nghĩa là gì?","options":["đã hứa","lặp lại","trở về","cưỡi ngựa"],"answer_index":0,"explanation":"promised = đã hứa"},{"question":"Từ 「repeat」 có nghĩa là gì?","options":["lặp lại","đã hứa","trở về","cưỡi ngựa"],"answer_index":0,"explanation":"repeat = lặp lại"},{"question":"Từ 「returning」 có nghĩa là gì?","options":["trở về","đã hứa","lặp lại","cưỡi ngựa"],"answer_index":0,"explanation":"returning = trở về"},{"question":"Từ 「riding」 có nghĩa là gì?","options":["cưỡi ngựa","đã hứa","lặp lại","trở về"],"answer_index":0,"explanation":"riding = cưỡi ngựa"},{"question":"Từ 「rough」 có nghĩa là gì?","options":["thô","đã hứa","lặp lại","trở về"],"answer_index":0,"explanation":"rough = thô"},{"question":"Từ 「santa」 có nghĩa là gì?","options":["ông già Noel","đã hứa","lặp lại","trở về"],"answer_inde