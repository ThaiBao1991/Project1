","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 295","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"autoを 使います。","line_vi":"Tôi dùng auto.","focus_words":["auto"]},{"speaker":"B","line_target":"consistent は 何ですか。","line_vi":"consistent là cái gì?","focus_words":["consistent"]},{"speaker":"A","line_target":"continuingです。","line_vi":"Đó là continuing.","focus_words":["continuing"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4de6d176","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「auto」 có nghĩa là gì?","options":["tự động","nhất quán","tiếp tục","kiếm tiền"],"answer_index":0,"explanation":"auto = tự động"},{"question":"Từ 「consistent」 có nghĩa là gì?","options":["nhất quán","tự động","tiếp tục","kiếm tiền"],"answer_index":0,"explanation":"consistent = nhất quán"},{"question":"Từ 「continuing」 có nghĩa là gì?","options":["tiếp tục","tự động","nhất quán","kiếm tiền"],"answer_index":0,"explanation":"continuing = tiếp tục"},{"question":"Từ 「earn」 có nghĩa là gì?","options":["kiếm tiền","tự động","nhất quán","tiếp tục"],"answer_index":0,"explanation":"earn = kiếm tiền"},{"question":"Từ 「exists」 có nghĩa là gì?","options":["tồn tại","tự động","nhất quán","tiếp tục"],"answer_index":0,"explanation":"exists = tồn tại"},{"question":"Từ 「finger」 có nghĩa là gì?","options":[