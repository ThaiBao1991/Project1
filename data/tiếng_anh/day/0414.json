ence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_04ec10ca","audio_ref":"m_bcc7044d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d46f69d8"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 414","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"gatesを 使います。","line_vi":"Tôi dùng gates.","focus_words":["gates"]},{"speaker":"B","line_target":"goodbye は 何ですか。","line_vi":"goodbye là cái gì?","focus_words":["goodbye"]},{"speaker":"A","line_target":"grahamです。","line_vi":"Đó là graham.","focus_words":["graham"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_93a1a997","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「gates」 có nghĩa là gì?","options":["cổng","tạm biệt","graham","phần cứng"],"answer_index":0,"explanation":"gates = cổng"},{"question":"Từ 「goodbye」 có nghĩa là gì?","options":["tạm biệt","cổng","graham","phần cứng"],"answer_index":0,"explanation":"goodbye = tạm biệt"},{"question":"Từ 「graham」 có nghĩa là gì?","options":["graham","cổng","tạm biệt","phần cứng"],"answer_index":0,"explanation":"graham = graham"},{"question":"Từ 「hardware」 có nghĩa là gì?","options":["phần cứng","cổng","tạm biệt","graham"],"answer_index":0,"explanation":"hardware = phần cứng"},{"question":"Từ 「hillary」 có nghĩa là gì?","options":["Hillary","cổng","tạm biệt","graham"],"answer_index":0,"explanation":"hillary = Hillary"},{"question":"Từ 「hurts」 có nghĩa là gì?","options":["đau","cổng","tạm biệt","graham"],"answer_index":0,"explanation":"hurts = đau"},{"question":"Từ 「intellectual」 có nghĩa là gì?","options":["trí tuệ","cổng","tạm biệt","graham"],"answer_index":0,"explanati