ộng từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 390","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"adapterを 使います。","line_vi":"Tôi dùng adapter.","focus_words":["adapter"]},{"speaker":"B","line_target":"affronter は 何ですか。","line_vi":"affronter là cái gì?","focus_words":["affronter"]},{"speaker":"A","line_target":"africainです。","line_vi":"Đó là africain.","focus_words":["africain"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4360594a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「adapter」 có nghĩa là gì?","options":["thích nghi","đối đầu","Châu Phi","Châu Phi"],"answer_index":0,"explanation":"adapter = thích nghi"},{"question":"Từ 「affronter」 có nghĩa là gì?","options":["đối đầu","thích nghi","Châu Phi","Châu Phi"],"answer_index":0,"explanation":"affronter = đối đầu"},{"question":"Từ 「africain」 có nghĩa là gì?","options":["Châu Phi","thích nghi","đối đầu","cánh"],"answer_index":0,"explanation":"africain = Châu Phi"},{"question":"Từ 「africaine」 có nghĩa là gì?","options":["Châu Phi","thích nghi","đối đầu","cánh"],"answer_index":0,"explanation":"africaine = Châu Phi"},{"question":"Từ 「ailes」 có nghĩa là gì?","options":["cánh","thích nghi","đối đầu","Châu Phi"],"answer_index":0,"explanation":"ailes = cánh"},{"question":"Từ 「alsace」 có nghĩa là gì?","options":["alsace","thích nghi","đối đầu","Châu Phi"],"answer_index":0,"expl