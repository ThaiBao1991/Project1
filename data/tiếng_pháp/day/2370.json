akes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2370","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"décrisを 使います。","line_vi":"Tôi dùng décris.","focus_words":["décris"]},{"speaker":"B","line_target":"dédie は 何ですか。","line_vi":"dédie là cái gì?","focus_words":["dédie"]},{"speaker":"A","line_target":"déficitaireです。","line_vi":"Đó là déficitaire.","focus_words":["déficitaire"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「décris」 có nghĩa là gì?","options":["mô tả","cống hiến","thâm hụt","hoang tưởng"],"answer_index":0,"explanation":"décris = mô tả"},{"question":"Từ 「dédie」 có nghĩa là gì?","options":["cống hiến","mô tả","thâm hụt","hoang tưởng"],"answer_index":0,"explanation":"dédie = cống hiến"},{"question":"Từ 「déficitaire」 có nghĩa là gì?","options":["thâm hụt","mô tả","cống hiến","hoang tưởng"],"answer_index":0,"explanation":"déficitaire = thâm hụt"},{"question":"Từ 「délirant」 có nghĩa là gì?","options":["hoang tưởng","mô tả","cống hiến","thâm hụt"],"answer_index":0,"explanation":"délirant = hoang tưởng"},{"question":"Từ 「déléguer」 có nghĩa là gì?","options":["đại biểu","mô tả","cống hiến","thâm hụt"],"answer_index":0,"explanation":"déléguer = đại biểu"},{"question":"Từ 「démagogie」 có nghĩa là gì?","options":["sự mị dân","mô tả","cống hiến","thâm hụt"],"answer_index":0,"explanation":"démagogie = sự mị dân"},{"question":"Từ 「démanteler」 có nghĩa là gì?","options":["tháo dỡ","mô tả","cống hiến","thâm hụt"],"answer_index":0,"explanation":"démanteler = tháo dỡ"},{"question":"Từ 「démocratiquement」 có nghĩa là gì?