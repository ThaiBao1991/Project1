iaste","eure"],"answer_index":0,"explanation":"embarque = lên đường"},{"question":"Chọn từ đúng cho nghĩa: làm giàu","options":["enrichissement","embarque","enthousiaste","eure"],"answer_index":0,"explanation":"enrichissement = làm giàu"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}