iers"]},{"speaker":"B","line_target":"foyers は 何ですか。","line_vi":"foyers là cái gì?","focus_words":["foyers"]},{"speaker":"A","line_target":"futuresです。","line_vi":"Đó là futures.","focus_words":["futures"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fiers」 có nghĩa là gì?","options":["tự hào","nhà","tương lai","đảm bảo"],"answer_index":0,"explanation":"fiers = tự hào"},{"question":"Từ 「foyers」 có nghĩa là gì?","options":["nhà","tự hào","tương lai","đảm bảo"],"answer_index":0,"explanation":"foyers = nhà"},{"question":"Từ 「futures」 có nghĩa là gì?","options":["tương lai","tự hào","nhà","đảm bảo"],"answer_index":0,"explanation":"futures = tương lai"},{"question":"Từ 「garanties」 có nghĩa là gì?","options":["đảm bảo","tự hào","nhà","tương lai"],"answer_index":0,"explanation":"garanties = đảm bảo"},{"question":"Từ 「grain」 có nghĩa là gì?","options":["ngũ cốc","tự hào","nhà","tương lai"],"answer_index":0,"explanation":"grain = ngũ cốc"},{"question":"Từ 「humide」 có nghĩa là gì?","options":["ướt","tự hào","nhà","tương lai"],"answer_index":0,"explanation":"humide = ướt"},{"question":"Từ 「intégrité」 có nghĩa là gì?","options":["tính chính trực","tự hào","nhà","tương lai"],"answer_index":0,"explanation":"intégrité = tính chính trực"},{"question":"Từ 「irlandais」 có nghĩa là gì?","options":["người Ireland","tự hào","nhà","tương lai"],"answer_index":0,"explanation":"irlandais = người Ireland"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tự hào","options":["fiers","foyers","futures","garanties"],"answer_index":0,"explanation":"fiers = tự hào"},{"question":"Chọn từ đúng cho nghĩa: nhà","options":["foyers","fiers","futures","garanties"],"answer_index":0,"explanation":"foyers = nhà"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},