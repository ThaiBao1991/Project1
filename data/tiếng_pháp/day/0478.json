:"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 478","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"comportementsを 使います。","line_vi":"Tôi dùng comportements.","focus_words":["comportements"]},{"speaker":"B","line_target":"comprenant は 何ですか。","line_vi":"comprenant là cái gì?","focus_words":["comprenant"]},{"speaker":"A","line_target":"confusionです。","line_vi":"Đó là confusion.","focus_words":["confusion"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fde82538","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「comportements」 có nghĩa là gì?","options":["hành vi","bao gồm cả","sự nhầm lẫn","đóng góp"],"answer_index":0,"explanation":"comportements = hành vi"},{"question":"Từ 「comprenant」 có nghĩa là gì?","options":["bao gồm cả","hành vi","sự nhầm lẫn","đóng góp"],"answer_index":0,"explanation":"comprenant = bao gồm cả"},{"question":"Từ 「confusion」 có nghĩa là gì?","options":["sự nhầm lẫn","hành vi","bao gồm cả","đóng góp"],"answer_index":0,"explanation":"confusion = sự nhầm lẫn"},{"question":"Từ 「contribuer」 có nghĩa là gì?","options":["đóng góp","hành vi","bao gồm cả","sự nhầm lẫn"],"answer_index":0,"explanation":"contribuer = đóng góp"},{"question":"Từ 「contribué」 có nghĩa là gì?","options":["đóng góp","hành vi","bao gồm cả","sự nhầm lẫn"],"answer_index":0,"explanation":"con