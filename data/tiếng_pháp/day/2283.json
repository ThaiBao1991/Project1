i bản xứ — Ngày 2283","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"pacifisteを 使います。","line_vi":"Tôi dùng pacifiste.","focus_words":["pacifiste"]},{"speaker":"B","line_target":"paieront は 何ですか。","line_vi":"paieront là cái gì?","focus_words":["paieront"]},{"speaker":"A","line_target":"paraboleです。","line_vi":"Đó là parabole.","focus_words":["parabole"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「pacifiste」 có nghĩa là gì?","options":["người theo chủ nghĩa hoà bình","sẽ trả tiền","chuyện ngụ ngôn","trượt ván"],"answer_index":0,"explanation":"pacifiste = người theo chủ nghĩa hoà bình"},{"question":"Từ 「paieront」 có nghĩa là gì?","options":["sẽ trả tiền","người theo chủ nghĩa hoà bình","chuyện ngụ ngôn","trượt ván"],"answer_index":0,"explanation":"paieront = sẽ trả tiền"},{"question":"Từ 「parabole」 có nghĩa là gì?","options":["chuyện ngụ ngôn","người theo chủ nghĩa hoà bình","sẽ trả tiền","trượt ván"],"answer_index":0,"explanation":"parabole = chuyện ngụ ngôn"},{"question":"Từ 「patin」 có nghĩa là gì?","options":["trượt ván","người theo chủ nghĩa hoà bình","sẽ trả tiền","chuyện ngụ ngôn"],"answer_index":0,"explanation":"patin = trượt ván"},{"question":"Từ 「pentecôte」 có nghĩa là gì?","options":["Lễ Ngũ Tuần","người theo chủ nghĩa hoà bình","sẽ trả tiền","chuyện ngụ ngôn"],"answer_index":0,"explanation":"pentecôte = Lễ Ngũ Tuần"},{"question":"Từ 「phénix」 có nghĩa là gì?","options":["phượng hoàng","người theo chủ nghĩa hoà bình","sẽ trả tiền","chuyện ngụ ngôn"],"answer_index":0,"explanation":"phénix = phượng hoàng"},{"question":"Từ 「plessis」 có nghĩa là gì?","options":["plessis","người theo chủ nghĩa hoà bình","sẽ trả tiền","chuyện ngụ ngôn"],"answer_index":0,"explanation":"plessis = plessis"},{"