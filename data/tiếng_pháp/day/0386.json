an; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 386","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"enseignantsを 使います。","line_vi":"Tôi dùng enseignants.","focus_words":["enseignants"]},{"speaker":"B","line_target":"entré は 何ですか。","line_vi":"entré là cái gì?","focus_words":["entré"]},{"speaker":"A","line_target":"exemplairesです。","line_vi":"Đó là exemplaires.","focus_words":["exemplaires"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d7dfd51f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「enseignants」 có nghĩa là gì?","options":["giáo viên","đã nhập","bản sao","tuyệt vời"],"answer_index":0,"explanation":"enseignants = giáo viên"},{"question":"Từ 「entré」 có nghĩa là gì?","options":["đã nhập","giáo viên","bản sao","tuyệt vời"],"answer_index":0,"explanation":"entré = đã nhập"},{"question":"Từ 「exemplaires」 có nghĩa là gì?","options":["bản sao","giáo viên","đã nhập","tuyệt vời"],"answer_index":0,"explanation":"exemplaires = bản sao"},{"question":"Từ 「fantastique」 có nghĩa là gì?","options":["tuyệt vời","giáo viên","đã nhập","bản sao"],"answer_index":0,"explanation":"fantastique = tuyệt vời"},{"question":"Từ 「fenêtres」 có nghĩa là gì?","options":["các cửa sổ","giáo viên","đã nhập","bản sao"],"answer_index":0,"explanation":"fenêtres = các cửa sổ"},{"question":"Từ 「game」 có nghĩa là gì?","options":["trò chơi","giáo viên","đã nh