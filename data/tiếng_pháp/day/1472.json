":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1472","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"équateurを 使います。","line_vi":"Tôi dùng équateur.","focus_words":["équateur"]},{"speaker":"B","line_target":"établissant は 何ですか。","line_vi":"établissant là cái gì?","focus_words":["établissant"]},{"speaker":"A","line_target":"étalonです。","line_vi":"Đó là étalon.","focus_words":["étalon"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「équateur」 có nghĩa là gì?","options":["đường xích đạo","thành lập","ngựa giống","trốn thoát"],"answer_index":0,"explanation":"équateur = đường xích đạo"},{"question":"Từ 「établissant」 có nghĩa là gì?","options":["thành lập","đường xích đạo","ngựa giống","trốn thoát"],"answer_index":0,"explanation":"établissant = thành lập"},{"question":"Từ 「étalon」 có nghĩa là gì?","options":["ngựa giống","đường xích đạo","thành lập","trốn thoát"],"answer_index":0,"explanation":"étalon = ngựa giống"},{"question":"Từ 「évader」 có nghĩa là gì?","options":["trốn thoát","đường xích đạo","thành lập","ngựa giống"],"answer_index":0,"explanation":"évader = trốn thoát"},{"question":"Từ 「2h00」 có nghĩa là gì?","options":["2:00","đường xích đạo","thành lập","ngựa giống"],"answer_index":0,"explanation":"2h00 = 2:00"},{"question":"Từ 「abolir」 có nghĩa là gì?","options":["bãi bỏ","đường xích đạo","thành lập","ngựa giống"],"answer_index":0,"explanation":"abolir = bãi bỏ"},{"question":"Từ 「acquitter」 có nghĩa là gì?","options":["tha bổng","đường xích đạo","thành lập","ngựa giống"],"answer_index":0,"explanation":"acquitter = tha bổng"},{"question":"Từ 「admirable」 có nghĩa là gì?","options":["đáng ngưỡng mộ","đường xích đạo","thành lập","ngựa giống"],"answer_index":0,"explanation":"admirable = đ