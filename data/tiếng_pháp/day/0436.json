ng tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 436","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"joindreを 使います。","line_vi":"Tôi dùng joindre.","focus_words":["joindre"]},{"speaker":"B","line_target":"las は 何ですか。","line_vi":"las là cái gì?","focus_words":["las"]},{"speaker":"A","line_target":"libérerです。","line_vi":"Đó là libérer.","focus_words":["libérer"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e8a41c5d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「joindre」 có nghĩa là gì?","options":["tham gia","mệt mỏi","miễn phí","bất hạnh"],"answer_index":0,"explanation":"joindre = tham gia"},{"question":"Từ 「las」 có nghĩa là gì?","options":["mệt mỏi","tham gia","miễn phí","bất hạnh"],"answer_index":0,"explanation":"las = mệt mỏi"},{"question":"Từ 「libérer」 có nghĩa là gì?","options":["miễn phí","tham gia","mệt mỏi","bất hạnh"],"answer_index":0,"explanation":"libérer = miễn phí"},{"question":"Từ 「malheur」 có nghĩa là gì?","options":["bất hạnh","tham gia","mệt mỏi","miễn phí"],"answer_index":0,"explanation":"malheur = bất hạnh"},{"question":"Từ 「mali」 có nghĩa là gì?","options":["Mali","tham gia","mệt mỏi","miễn phí"],"answer_index":0,"explanation":"mali = Mali"},{"question":"Từ 「manifestants」 có nghĩa là gì?","options":["người biểu tình","tham gia","mệt mỏi","miễn phí"],"answer_index":0,"explanation":"manifestants = người biểu tình"},{"question":"Từ 「marn