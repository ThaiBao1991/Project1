uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"tabagismeを 使います。","line_vi":"Tôi dùng tabagisme.","focus_words":["tabagisme"]},{"speaker":"B","line_target":"tchécoslovaquie は 何ですか。","line_vi":"tchécoslovaquie là cái gì?","focus_words":["tchécoslovaquie"]},{"speaker":"A","line_target":"thatcherです。","line_vi":"Đó là thatcher.","focus_words":["thatcher"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「tabagisme」 có nghĩa là gì?","options":["hút thuốc","Tiệp Khắc","người thợ lợp cỏ","ngã"],"answer_index":0,"explanation":"tabagisme = hút thuốc"},{"question":"Từ 「tchécoslovaquie」 có nghĩa là gì?","options":["Tiệp Khắc","hút thuốc","người thợ lợp cỏ","ngã"],"answer_index":0,"explanation":"tchécoslovaquie = Tiệp Khắc"},{"question":"Từ 「thatcher」 có nghĩa là gì?","options":["người thợ lợp cỏ","hút thuốc","Tiệp Khắc","ngã"],"answer_index":0,"explanation":"thatcher = người thợ lợp cỏ"},{"question":"Từ 「tombez」 có nghĩa là gì?","options":["ngã","hút thuốc","Tiệp Khắc","người thợ lợp cỏ"],"answer_index":0,"explanation":"tombez = ngã"},{"question":"Từ 「toro」 có nghĩa là gì?","options":["toro","hút thuốc","Tiệp Khắc","người thợ lợp cỏ"],"answer_index":0,"explanation":"toro = toro"},{"question":"Từ 「turbine」 có nghĩa là gì?","options":["tua-bin","hút thuốc","Tiệp Khắc","người thợ lợp cỏ"],"answer_index":0,"explanation":"turbine = tua-bin"},{"question":"Từ 「ténacité」 có nghĩa là gì?","options":["sự kiên trì","hút thuốc","Tiệp Khắc","người thợ lợp cỏ"],"answer_index":0,"explanation":"ténacité = sự kiên trì"},{"question":"Từ 「vacciner」 có nghĩa là gì?","options":["tiêm chủng","hút thuốc","Tiệp Khắc","người thợ lợp cỏ"],"answer_index":0,"explanation":"vacciner = tiêm chủng"}],"pattern":[{"question":"Chọn từ đúng cho n