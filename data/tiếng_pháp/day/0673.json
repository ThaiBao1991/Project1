":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]},{"title":"Dạng nối 〜て","level":"N3","explanation":"Dạng te nối hai động từ: 書いて + 読む; cũng dùng cho lý do nhẹ (寒くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]},{"title":"Từ chỉ người (の)","level":"N3","explanation":"の + danh từ: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]},{"title":"Quá khứ xa (〜た)","level":"N3","explanation":"Ngữ cảnh quá khứ: 子供の時に、学校に通っていました.","examples":[{"sentence":"子供の頃、学校に通っていました。","meaning_vi":"Thời thơ ấy tôi có đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 673","situation":"Hội thoại ngắn dùng từ của bài hôm na