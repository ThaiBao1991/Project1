n","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6f8f2f1e","audio_ref":"m_7bd2e5c6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_8a6824b6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 452","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"curiositéを 使います。","line_vi":"Tôi dùng curiosité.","focus_words":["curiosité"]},{"speaker":"B","line_target":"célibataire は 何ですか。","line_vi":"célibataire là cái gì?","focus_words":["célibataire"]},{"speaker":"A","line_target":"descenteです。","line_vi":"Đó là descente.","focus_words":["descente"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bfd0a53e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「curiosité」 có nghĩa là gì?","options":["sự tò mò","độc thân","đi xuống","phân biệt"],"answer_index":0,"explanation":"curiosité = sự tò mò"},{"question":"Từ 「célibataire」 có nghĩa là gì?","options":["độc thân","sự tò mò","đi xuống","phân biệt"],"answer_index":0,"explanation":"célibataire = độc thân"},{"question":"Từ 「descente」 có nghĩa là gì?","options":["đi xuống","sự tò mò","độc thân","phân biệt"],"answer_index":0,"explanation":"descente = đi xuống"},{"question":"Từ 「distingue」 có nghĩa là gì?","options":["phân biệt","sự tò mò","độc thân","đi xuống"],"answer_index":0,"explanation":"distingue = phân biệt"},{"question":"Từ 「doc」 có nghĩa là gì?","options":["bác sĩ","sự tò mò","độc thân","đi xuống"],"answer_index":0,"explanation":"doc = bác sĩ"},{"question":"Từ 「duquel」 có nghĩa là gì?","options":["từ đó","sự tò mò","độc thân","đi xuống"],"answer_index":0,"explanation":"duquel = từ đó"},{"question":"Từ 「dépit」 có nghĩa là gì?","options":["bất chấp","s