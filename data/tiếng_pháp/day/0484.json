3","explanation":"Dạng te nối hai động từ: 書いて + 読む; cũng dùng cho lý do nhẹ (寒くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 484","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"régionalesを 使います。","line_vi":"Tôi dùng régionales.","focus_words":["régionales"]},{"speaker":"B","line_target":"réparer は 何ですか。","line_vi":"réparer là cái gì?","focus_words":["réparer"]},{"speaker":"A","line_target":"républicainです。","line_vi":"Đó là républicain.","focus_words":["républicain"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3f6528e1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「régionales」 có nghĩa là gì?","options":["khu vực","sửa chữa","người theo chủ nghĩa cộng hòa","thỏa mãn"],"answer_index":0,"explanation":"régionales = khu vực"},{"question":"Từ 「réparer」 có nghĩa là gì?","options":["sửa chữa","khu vực","người theo chủ nghĩa cộng hòa","thỏa mãn"],"answer_index":0,"explanation":"réparer = sửa chữa"},{"question":"Từ 「républicain」 có nghĩa là gì?","options":["người theo chủ nghĩa cộng hòa","khu vực","sửa chữa","thỏa mãn"],"answer_index":0,"explanation":"républicain = người theo chủ nghĩa cộng hòa"},{"question":"Từ 「satisfaire」 có nghĩa là gì?","options":["thỏa mãn","khu vực","sửa chữa","người theo chủ nghĩa cộng hòa"],"answer_index":0,"explanation":"satisfaire = thỏa mãn"},{"question":"Từ 「sauvages」 có nghĩa là gì?","options":["hoang dã","khu vực","sửa chữa","n