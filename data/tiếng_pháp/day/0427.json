ません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 427","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"cannesを 使います。","line_vi":"Tôi dùng cannes.","focus_words":["cannes"]},{"speaker":"B","line_target":"catastrophe は 何ですか。","line_vi":"catastrophe là cái gì?","focus_words":["catastrophe"]},{"speaker":"A","line_target":"chairです。","line_vi":"Đó là chair.","focus_words":["chair"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_561048a7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「cannes」 có nghĩa là gì?","options":["gậy","thảm họa","thịt","tìm kiếm"],"answer_index":0,"explanation":"cannes = gậy"},{"question":"Từ 「catastrophe」 có nghĩa là gì?","options":["thảm họa","gậy","thịt","tìm kiếm"],"answer_index":0,"explanation":"catastrophe = thảm họa"},{"question":"Từ 「chair」 có nghĩa là gì?","options":["thịt","gậy","thảm họa","tìm kiếm"],"answer_index":0,"explanation":"chair = thịt"},{"question":"Từ 「cherchez」 có nghĩa là gì?","options":["tìm kiếm","gậy","thảm họa","thịt"],"answer_index":0,"explanation":"cherchez = tìm kiếm"},{"question":"Từ 「clan」 có nghĩa là gì?","options":["thị tộc","gậy","thảm họa","thịt"],"answer_index":0,"explanation":"clan = thị tộc"},{"question":"Từ 「clip」 có nghĩa là gì?","options":["cái kẹp","gậy","thảm họa","thịt"],"answer_index":0,"explanation":"clip = cái kẹp"},{"question":"Từ 「collectivités」 có nghĩa là gì?","options":["cộng đồng","gậy","thảm họa","thịt"],