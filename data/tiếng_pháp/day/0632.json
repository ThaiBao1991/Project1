":"N5","turns":[{"speaker":"A","line_target":"diminueを 使います。","line_vi":"Tôi dùng diminue.","focus_words":["diminue"]},{"speaker":"B","line_target":"distances は 何ですか。","line_vi":"distances là cái gì?","focus_words":["distances"]},{"speaker":"A","line_target":"dollarです。","line_vi":"Đó là dollar.","focus_words":["dollar"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「diminue」 có nghĩa là gì?","options":["giảm","khoảng cách","đô la","cuộc đấu tay đôi"],"answer_index":0,"explanation":"diminue = giảm"},{"question":"Từ 「distances」 có nghĩa là gì?","options":["khoảng cách","giảm","đô la","cuộc đấu tay đôi"],"answer_index":0,"explanation":"distances = khoảng cách"},{"question":"Từ 「dollar」 có nghĩa là gì?","options":["đô la","giảm","khoảng cách","cuộc đấu tay đôi"],"answer_index":0,"explanation":"dollar = đô la"},{"question":"Từ 「duel」 có nghĩa là gì?","options":["cuộc đấu tay đôi","giảm","khoảng cách","đô la"],"answer_index":0,"explanation":"duel = cuộc đấu tay đôi"},{"question":"Từ 「défilé」 có nghĩa là gì?","options":["cuộc diễu hành","giảm","khoảng cách","đô la"],"answer_index":0,"explanation":"défilé = cuộc diễu hành"},{"question":"Từ 「dépôts」 có nghĩa là gì?","options":["tiền gửi","giảm","khoảng cách","đô la"],"answer_index":0,"explanation":"dépôts = tiền gửi"},{"question":"Từ 「détenus」 có nghĩa là gì?","options":["người bị giam giữ","giảm","khoảng cách","đô la"],"answer_index":0,"explanation":"détenus = người bị giam giữ"},{"question":"Từ 「entretiens」 có nghĩa là gì?","options":["phỏng vấn","giảm","khoảng cách","đô la"],"answer_index":0,"explanation":"entretiens = phỏng vấn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: giảm","options":["diminue","distances","dollar","duel"],"answer_index":0,"explanation":"diminue = giảm"},{"question":"Chọn từ đúng ch