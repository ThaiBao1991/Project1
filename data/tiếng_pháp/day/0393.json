planation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 393","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"couvrirを 使います。","line_vi":"Tôi dùng couvrir.","focus_words":["couvrir"]},{"speaker":"B","line_target":"dan は 何ですか。","line_vi":"dan là cái gì?","focus_words":["dan"]},{"speaker":"A","line_target":"donnezです。","line_vi":"Đó là donnez.","focus_words":["donnez"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d7eca166","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「couvrir」 có nghĩa là gì?","options":["che","đàn","cho","quyên góp"],"answer_index":0,"explanation":"couvrir = che"},{"question":"Từ 「dan」 có nghĩa là gì?","options":["đàn","che","cho","quyên góp"],"answer_index":0,"explanation":"dan = đàn"},{"question":"Từ 「donnez」 có nghĩa là gì?","options":["cho","che","đàn","quyên góp"],"answer_index":0,"explanation":"donnez = cho"},{"question":"Từ 「dons」 có nghĩa là gì?","options":["quyên góp","che","đàn","cho"],"answer_index":0,"explanation":"dons = quyên góp"},{"question":"Từ 「décédé」 có nghĩa là gì?","options":["đã chết","che","đàn","cho"],"answer_index":0,"explanation":"décédé = đã chết"},{"question":"Từ 「déplacer」 có nghĩa là gì?","options":["di chuyển","che","đàn","cho"],"answer_index":0,"explanation":"déplacer = di chuyển"},{"question":"Từ 「déposer」 có nghĩa là gì?","options":["thả ra","che","đàn","cho"],"answer_index