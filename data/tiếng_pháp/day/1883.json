_words":["cubain"]},{"speaker":"B","line_target":"cueillir は 何ですか。","line_vi":"cueillir là cái gì?","focus_words":["cueillir"]},{"speaker":"A","line_target":"cuvetteです。","line_vi":"Đó là cuvette.","focus_words":["cuvette"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「cubain」 có nghĩa là gì?","options":["người Cuba","chọn","bát","thiên nga"],"answer_index":0,"explanation":"cubain = người Cuba"},{"question":"Từ 「cueillir」 có nghĩa là gì?","options":["chọn","người Cuba","bát","thiên nga"],"answer_index":0,"explanation":"cueillir = chọn"},{"question":"Từ 「cuvette」 có nghĩa là gì?","options":["bát","người Cuba","chọn","thiên nga"],"answer_index":0,"explanation":"cuvette = bát"},{"question":"Từ 「cygne」 có nghĩa là gì?","options":["thiên nga","người Cuba","chọn","bát"],"answer_index":0,"explanation":"cygne = thiên nga"},{"question":"Từ 「cérébrales」 có nghĩa là gì?","options":["não","người Cuba","chọn","bát"],"answer_index":0,"explanation":"cérébrales = não"},{"question":"Từ 「demeures」 có nghĩa là gì?","options":["biệt thự","người Cuba","chọn","bát"],"answer_index":0,"explanation":"demeures = biệt thự"},{"question":"Từ 「descends」 có nghĩa là gì?","options":["đi xuống","người Cuba","chọn","bát"],"answer_index":0,"explanation":"descends = đi xuống"},{"question":"Từ 「desserts」 có nghĩa là gì?","options":["món tráng miệng","người Cuba","chọn","bát"],"answer_index":0,"explanation":"desserts = món tráng miệng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: người Cuba","options":["cubain","cueillir","cuvette","cygne"],"answer_index":0,"explanation":"cubain = người Cuba"},{"question":"Chọn từ đúng cho nghĩa: chọn","options":["cueillir","cubain","cuvette","cygne"],"answer_index":0,"explanation":"cueillir = chọn"}],"common":[],"grammar":[],"mixed":[]},"source":"offli