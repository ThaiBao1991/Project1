ces":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 346","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"êtresを 使います。","line_vi":"Tôi dùng êtres.","focus_words":["êtres"]},{"speaker":"B","line_target":"absolue は 何ですか。","line_vi":"absolue là cái gì?","focus_words":["absolue"]},{"speaker":"A","line_target":"adamです。","line_vi":"Đó là adam.","focus_words":["adam"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7d4053b4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「êtres」 có nghĩa là gì?","options":["chúng sinh","tuyệt đối","Adam","đối thủ"],"answer_index":0,"explanation":"êtres = chúng sinh"},{"question":"Từ 「absolue」 có nghĩa là gì?","options":["tuyệt đối","chúng sinh","Adam","đối thủ"],"answer_index":0,"explanation":"absolue = tuyệt đối"},{"question":"Từ 「adam」 có nghĩa là gì?","options":["Adam","chúng sinh","tuyệt đối","đối thủ"],"answer_index":0,"explanation":"adam = Adam"},{"question":"Từ 「adversaire」 có nghĩa là gì?","options":["đối thủ","chúng sinh","tuyệt đối","Adam"],"answer_index":0,"explanation":"adversaire = đối thủ"},{"question":"Từ 「aidé」 có nghĩa là gì?","options":["đã giúp","chúng sinh","tuyệt đối","Adam"],"answer_index":0,"explanation":"aidé = đã giúp"},{"question":"Từ 「albert」 có nghĩa là gì?","options":["albert","chúng sinh","tuyệt đối",