lanation":"có liên quan","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_001541e1","audio_ref":"m_abaf9401","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_16dd9fd2"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 550","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"espéranceを 使います。","line_vi":"Tôi dùng espérance.","focus_words":["espérance"]},{"speaker":"B","line_target":"façade は 何ですか。","line_vi":"façade là cái gì?","focus_words":["façade"]},{"speaker":"A","line_target":"fermesです。","line_vi":"Đó là fermes.","focus_words":["fermes"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_49d5ef8f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「espérance」 có nghĩa là gì?","options":["hy vọng","mặt tiền","trang trại","tập tin"],"answer_index":0,"explanation":"espérance = hy vọng"},{"question":"Từ 「façade」 có nghĩa là gì?","options":["mặt tiền","hy vọng","trang trại","tập tin"],"answer_index":0,"explanation":"façade = mặt tiền"},{"question":"Từ 「fermes」 có nghĩa là gì?","options":["trang trại","hy vọng","mặt tiền","tập tin"],"answer_index":0,"explanation":"fermes = trang trại"},{"question":"Từ 「fichier」 có nghĩa là gì?","options":["tập tin","hy vọng","mặt tiền","trang trại"],"answer_index":0,"explanation":"fichier = tập tin"},{"question":"Từ 「fusil」 có nghĩa là gì?","options":["súng trường","hy vọng","mặt tiền","trang trại"],"answer_index":0,"explanation":"fusil = súng trường"},{"question":"Từ 「gamins」 có nghĩa là gì?","options":["bọn trẻ","hy vọng","mặt tiền","trang trại"],"answer_index":0,"explanat