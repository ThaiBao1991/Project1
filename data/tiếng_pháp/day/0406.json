i bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 406","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"trôneを 使います。","line_vi":"Tôi dùng trône.","focus_words":["trône"]},{"speaker":"B","line_target":"uniforme は 何ですか。","line_vi":"uniforme là cái gì?","focus_words":["uniforme"]},{"speaker":"A","line_target":"variétéです。","line_vi":"Đó là variété.","focus_words":["variété"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a173a1fd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「trône」 có nghĩa là gì?","options":["ngai vàng","đồng phục","đa dạng","các cửa sổ"],"answer_index":0,"explanation":"trône = ngai vàng"},{"question":"Từ 「uniforme」 có nghĩa là gì?","options":["đồng phục","ngai vàng","đa dạng","các cửa sổ"],"answer_index":0,"explanation":"uniforme = đồng phục"},{"question":"Từ 「variété」 có nghĩa là gì?","options":["đa dạng","ngai vàng","đồng phục","các cửa sổ"],"answer_index":0,"explanation":"variété = đa dạng"},{"question":"Từ 「windows」 có nghĩa là gì?","options":["các cửa sổ","ngai vàng","đồng phục","đa dạng"],"answer_index":0,"explanation":"windows = các cửa sổ"},{"question":"Từ 「world」 có nghĩa là gì?","options":["thế giới","ngai vàng","đồng phục","đa dạng"],"answer_index":0,"explanation":"world = thế giới"},{"question":"Từ 「énergétique」 có nghĩa là gì?","options":["năng lượng","ngai vàng","đồng phục","đa dạng"],"answer_index":0,"explanation":"énergétique = năng lượng"},{"question":"Từ 「éthique」 có nghĩa là gì?","options":["đạo đức","ngai vàng","đồng phục","đa d