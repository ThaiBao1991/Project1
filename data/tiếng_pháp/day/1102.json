 Ngày 1102","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"repousséを 使います。","line_vi":"Tôi dùng repoussé.","focus_words":["repoussé"]},{"speaker":"B","line_target":"reproduit は 何ですか。","line_vi":"reproduit là cái gì?","focus_words":["reproduit"]},{"speaker":"A","line_target":"requêtesです。","line_vi":"Đó là requêtes.","focus_words":["requêtes"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「repoussé」 có nghĩa là gì?","options":["đẩy lùi","được sao chép","truy vấn","yêu sách"],"answer_index":0,"explanation":"repoussé = đẩy lùi"},{"question":"Từ 「reproduit」 có nghĩa là gì?","options":["được sao chép","đẩy lùi","truy vấn","yêu sách"],"answer_index":0,"explanation":"reproduit = được sao chép"},{"question":"Từ 「requêtes」 có nghĩa là gì?","options":["truy vấn","đẩy lùi","được sao chép","yêu sách"],"answer_index":0,"explanation":"requêtes = truy vấn"},{"question":"Từ 「revendication」 có nghĩa là gì?","options":["yêu sách","đẩy lùi","được sao chép","truy vấn"],"answer_index":0,"explanation":"revendication = yêu sách"},{"question":"Từ 「réacteurs」 có nghĩa là gì?","options":["lò phản ứng","đẩy lùi","được sao chép","truy vấn"],"answer_index":0,"explanation":"réacteurs = lò phản ứng"},{"question":"Từ 「réduisant」 có nghĩa là gì?","options":["giảm bớt","đẩy lùi","được sao chép","truy vấn"],"answer_index":0,"explanation":"réduisant = giảm bớt"},{"question":"Từ 「rémi」 có nghĩa là gì?","options":["remi","đẩy lùi","được sao chép","truy vấn"],"answer_index":0,"explanation":"rémi = remi"},{"question":"Từ 「résidant」 có nghĩa là gì?","options":["thường trú","đẩy lùi","được sao chép","truy vấn"],"answer_index":0,"explanation":"résidant = thường trú"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đẩy lùi","options":[