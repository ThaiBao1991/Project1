nation":"trình tự","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f81e5465","audio_ref":"m_6edbc4ac","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_db31900f"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 565","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"régléを 使います。","line_vi":"Tôi dùng réglé.","focus_words":["réglé"]},{"speaker":"B","line_target":"régulier は 何ですか。","line_vi":"régulier là cái gì?","focus_words":["régulier"]},{"speaker":"A","line_target":"rénovationです。","line_vi":"Đó là rénovation.","focus_words":["rénovation"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_387ba2f8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「réglé」 có nghĩa là gì?","options":["giải quyết","đều đặn","cải tạo","thư mục"],"answer_index":0,"explanation":"réglé = giải quyết"},{"question":"Từ 「régulier」 có nghĩa là gì?","options":["đều đặn","giải quyết","cải tạo","thư mục"],"answer_index":0,"explanation":"régulier = đều đặn"},{"question":"Từ 「rénovation」 có nghĩa là gì?","options":["cải tạo","giải quyết","đều đặn","thư mục"],"answer_index":0,"explanation":"rénovation = cải tạo"},{"question":"Từ 「répertoire」 có nghĩa là gì?","options":["thư mục","giải quyết","đều đặn","cải tạo"],"answer_index":0,"explanation":"répertoire = thư mục"},{"question":"Từ 「réside」 có nghĩa là gì?","options":["cư trú","giải quyết","đều đặn","cải tạo"],"answer_index":0,"explanation":"réside = cư trú"},{"question":"Từ 「semblable」 có nghĩa là gì?","options":["tương tự","giải quyết","đều đặn","cải tạo"],"answer_index":0,"explanation":"semblable = tương tự"},{"question":"Từ 「