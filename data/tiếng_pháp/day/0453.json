ing_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 453","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"faussesを 使います。","line_vi":"Tôi dùng fausses.","focus_words":["fausses"]},{"speaker":"B","line_target":"fontaine は 何ですか。","line_vi":"fontaine là cái gì?","focus_words":["fontaine"]},{"speaker":"A","line_target":"fuirです。","line_vi":"Đó là fuir.","focus_words":["fuir"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dbd4eb6b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fausses」 có nghĩa là gì?","options":["sai","đài phun nước","chạy trốn","khói"],"answer_index":0,"explanation":"fausses = sai"},{"question":"Từ 「fontaine」 có nghĩa là gì?","options":["đài phun nước","sai","chạy trốn","khói"],"answer_index":0,"explanation":"fontaine = đài phun nước"},{"question":"Từ 「fuir」 có nghĩa là gì?","options":["chạy trốn","sai","đài phun nước","khói"],"answer_index":0,"explanation":"fuir = chạy trốn"},{"question":"Từ 「fumée」 có nghĩa là gì?","options":["khói","sai","đài phun nước","chạy trốn"],"answer_index":0,"explanation":"fumée = khói"},{"question":"Từ 「féminine」 có nghĩa là gì?","options":["nữ tính","sai","đài phun nước","chạy trốn"],"answer_index":0,"explanation":"féminine = nữ tính"},{"question":"Từ 「genoux」 có nghĩa là gì?","options":["đầu gối","sai","đài phun nước","chạy trốn"],"answer_index":0,"explanation":"genoux = đầu gối"},{"question":"Từ 「guitare」 có nghĩa là gì?","options":["đàn ghi-ta","sai","đài phun nước","chạy trốn"],"answer_index":0,"explanation":"guitare = đàn ghi-ta"}