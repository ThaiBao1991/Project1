:"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 480","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"germainを 使います。","line_vi":"Tôi dùng germain.","focus_words":["germain"]},{"speaker":"B","line_target":"identique は 何ですか。","line_vi":"identique là cái gì?","focus_words":["identique"]},{"speaker":"A","line_target":"indiensです。","line_vi":"Đó là indiens.","focus_words":["indiens"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6ddbd4c0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「germain」 có nghĩa là gì?","options":["tiếng Đức","giống hệt nhau","người Ấn Độ","cá nhân"],"answer_index":0,"explanation":"germain = tiếng Đức"},{"question":"Từ 「identique」 có nghĩa là gì?","options":["giống hệt nhau","tiếng Đức","người Ấn Độ","cá nhân"],"answer_index":0,"explanation":"identique = giống hệt nhau"},{"question":"Từ 「indiens」 có nghĩa là gì?","options":["người Ấn Độ","tiếng Đức","giống hệt nhau","cá nhân"],"answer_index":0,"explanation":"indiens = người Ấn Độ"},{"question":"Từ 「individuelle」 có nghĩa là gì?","options":["cá nhân","tiếng Đức","giống hệt nhau","người Ấn Độ"],"answer_index":0,"explanation":"individuelle = cá nhân"},{"question":"Từ 「isabelle」 có nghĩa là gì?","options":["Isabelle","tiếng Đức","giống hệt nhau","người Ấn Độ"],"answer_index":0,"explanation":"isabelle = Isa