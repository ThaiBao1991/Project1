ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_18ac8fb2","audio_ref":"m_38b4c024","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_6913152e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 426","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ambitionを 使います。","line_vi":"Tôi dùng ambition.","focus_words":["ambition"]},{"speaker":"B","line_target":"anges は 何ですか。","line_vi":"anges là cái gì?","focus_words":["anges"]},{"speaker":"A","line_target":"appuieです。","line_vi":"Đó là appuie.","focus_words":["appuie"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b4005505","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ambition」 có nghĩa là gì?","options":["tham vọng","thiên thần","hỗ trợ","bị tấn công"],"answer_index":0,"explanation":"ambition = tham vọng"},{"question":"Từ 「anges」 có nghĩa là gì?","options":["thiên thần","tham vọng","hỗ trợ","bị tấn công"],"answer_index":0,"explanation":"anges = thiên thần"},{"question":"Từ 「appuie」 có nghĩa là gì?","options":["hỗ trợ","tham vọng","thiên thần","bị tấn công"],"answer_index":0,"explanation":"appuie = hỗ trợ"},{"question":"Từ 「attaqué」 có nghĩa là gì?","options":["bị tấn công","tham vọng","thiên thần","hỗ trợ"],"answer_index":0,"explanation":"attaqué = bị tấn công"},{"question":"Từ 「aube」 có nghĩa là gì?","options":["bình minh","tham vọng","thiên thần","hỗ trợ"],"answer_index":0,"explanation":"aube = bình minh"},{"question":"Từ 「aventures」 có nghĩa là gì?","options":["cuộc phiêu lưu","tham vọng","thiên thần","hỗ trợ"],"answer_index":0,"explanation":"aventures = cuộc phiêu lưu"},{"question":"Từ 「blanches」 có nghĩa