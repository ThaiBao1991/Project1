idan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 570","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"distinguerを 使います。","line_vi":"Tôi dùng distinguer.","focus_words":["distinguer"]},{"speaker":"B","line_target":"décoration は 何ですか。","line_vi":"décoration là cái gì?","focus_words":["décoration"]},{"speaker":"A","line_target":"définitiveです。","line_vi":"Đó là définitive.","focus_words":["définitive"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a6229c6e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「distinguer」 có nghĩa là gì?","options":["phân biệt","trang trí","dứt khoát","đã đính hôn"],"answer_index":0,"explanation":"distinguer = phân biệt"},{"question":"Từ 「décoration」 có nghĩa là gì?","options":["trang trí","phân biệt","dứt khoát","đã đính hôn"],"answer_index":0,"explanation":"décoration = trang trí"},{"question":"Từ 「définitive」 có nghĩa là gì?","options":["dứt khoát","phân biệt","trang trí","đã đính hôn"],"answer_index":0,"explanation":"définitive = dứt khoát"},{"question":"Từ 「engagée」 có nghĩa là gì?","options":["đã đính hôn","phân biệt","trang trí","dứt khoát"],"answer_index":0,"explanation":"engagée = đã đính hôn"},{"question":"Từ 「enregistrer」 có nghĩa là gì?","options":["lưu lại","phân biệt","trang trí","dứt khoát"],"answer_index":0,"explanation":"enregistrer = lưu lại"},{"question":"Từ 「entraîné」 có nghĩa l