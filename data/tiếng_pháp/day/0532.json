ces":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 532","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"lookを 使います。","line_vi":"Tôi dùng look.","focus_words":["look"]},{"speaker":"B","line_target":"manchester は 何ですか。","line_vi":"manchester là cái gì?","focus_words":["manchester"]},{"speaker":"A","line_target":"manteauです。","line_vi":"Đó là manteau.","focus_words":["manteau"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ddc869ba","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「look」 có nghĩa là gì?","options":["nhìn","Manchester","áo khoác","Matt"],"answer_index":0,"explanation":"look = nhìn"},{"question":"Từ 「manchester」 có nghĩa là gì?","options":["Manchester","nhìn","áo khoác","Matt"],"answer_index":0,"explanation":"manchester = Manchester"},{"question":"Từ 「manteau」 có nghĩa là gì?","options":["áo khoác","nhìn","Manchester","Matt"],"answer_index":0,"explanation":"manteau = áo khoác"},{"question":"Từ 「matt」 có nghĩa là gì?","options":["Matt","nhìn","Manchester","áo khoác"],"answer_index":0,"explanation":"matt = Matt"},{"question":"Từ 「messe」 có nghĩa là gì?","options":["khối lượng","nhìn","Manchester","áo khoác"],"answer_index":0,"explanation":"messe = khối lượng"},{"question":"Từ 「mixte」 có nghĩa là gì?","options":["hỗn hợp","nhìn","Manchester","áo k