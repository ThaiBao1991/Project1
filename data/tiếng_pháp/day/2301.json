ai」 có nghĩa là gì?","options":["sẽ tiếp tục","nhận thức","thương mại hóa","chủ nghĩa cộng sản"],"answer_index":0,"explanation":"continuerai = sẽ tiếp tục"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nhận thức","options":["cognitif","commercialiser","communautarisme","confesse"],"answer_index":0,"explanation":"cognitif = nhận thức"},{"question":"Chọn từ đúng cho nghĩa: thương mại hóa","options":["commercialiser","cognitif","communautarisme","confesse"],"answer_index":0,"explanation":"commercialiser = thương mại hóa"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}