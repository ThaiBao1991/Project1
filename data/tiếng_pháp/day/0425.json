i":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 425","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"traverseを 使います。","line_vi":"Tôi dùng traverse.","focus_words":["traverse"]},{"speaker":"B","line_target":"tribune は 何ですか。","line_vi":"tribune là cái gì?","focus_words":["tribune"]},{"speaker":"A","line_target":"troubleです。","line_vi":"Đó là trouble.","focus_words":["trouble"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_43a7515a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「traverse」 có nghĩa là gì?","options":["thánh giá","diễn đàn","rối loạn","làm ơn"],"answer_index":0,"explanation":"traverse = thánh giá"},{"question":"Từ 「tribune」 có nghĩa là gì?","options":["diễn đàn","thánh giá","rối loạn","làm ơn"],"answer_index":0,"explanation":"tribune = diễn đàn"},{"question":"Từ 「trouble」 có nghĩa là gì?","options":["rối loạn","thánh giá","diễn đàn","làm ơn"],"answer_index":0,"explanation":"trouble = rối loạn"},{"question":"Từ 「veuillez」 có nghĩa là gì?","options":["làm ơn","thánh giá","diễn đàn","rối loạn"],"answer_index":0,"explanation":"veuillez = làm ơn"},{"question":"Từ 「vieilles」 có nghĩa là gì?","options":["cũ","thánh giá","diễn đàn","rối loạn"],"answer_index":0,"explanation":"vieilles = cũ"},{"question":"Từ 「élite」 có nghĩa là gì?","options":["ưu tú","thánh giá","diễn đàn","rối loạn"],"answer_index":0,"explanation":"élite = ưu tú"},{"question":"Từ 「éventuellement」 có nghĩa là gì?","option