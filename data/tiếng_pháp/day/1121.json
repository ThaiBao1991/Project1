":"N5","turns":[{"speaker":"A","line_target":"seriesを 使います。","line_vi":"Tôi dùng series.","focus_words":["series"]},{"speaker":"B","line_target":"serions は 何ですか。","line_vi":"serions là cái gì?","focus_words":["serions"]},{"speaker":"A","line_target":"sincèresです。","line_vi":"Đó là sincères.","focus_words":["sincères"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「series」 có nghĩa là gì?","options":["loạt","sẽ là","chân thành","thống nhất"],"answer_index":0,"explanation":"series = loạt"},{"question":"Từ 「serions」 có nghĩa là gì?","options":["sẽ là","loạt","chân thành","thống nhất"],"answer_index":0,"explanation":"serions = sẽ là"},{"question":"Từ 「sincères」 có nghĩa là gì?","options":["chân thành","loạt","sẽ là","thống nhất"],"answer_index":0,"explanation":"sincères = chân thành"},{"question":"Từ 「solidaires」 có nghĩa là gì?","options":["thống nhất","loạt","sẽ là","chân thành"],"answer_index":0,"explanation":"solidaires = thống nhất"},{"question":"Từ 「surcroît」 có nghĩa là gì?","options":["ngoài ra","loạt","sẽ là","chân thành"],"answer_index":0,"explanation":"surcroît = ngoài ra"},{"question":"Từ 「switch」 có nghĩa là gì?","options":["chuyển đổi","loạt","sẽ là","chân thành"],"answer_index":0,"explanation":"switch = chuyển đổi"},{"question":"Từ 「tank」 có nghĩa là gì?","options":["xe tăng","loạt","sẽ là","chân thành"],"answer_index":0,"explanation":"tank = xe tăng"},{"question":"Từ 「tarn」 có nghĩa là gì?","options":["vết bẩn","loạt","sẽ là","chân thành"],"answer_index":0,"explanation":"tarn = vết bẩn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: loạt","options":["series","serions","sincères","solidaires"],"answer_index":0,"explanation":"series = loạt"},{"question":"Chọn từ đúng cho nghĩa: sẽ là","options":["serions","series","sincères","solidaires"],"an