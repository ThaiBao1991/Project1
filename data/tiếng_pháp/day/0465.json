[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 465","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"prononcéを 使います。","line_vi":"Tôi dùng prononcé.","focus_words":["prononcé"]},{"speaker":"B","line_target":"provisoire は 何ですか。","line_vi":"provisoire là cái gì?","focus_words":["provisoire"]},{"speaker":"A","line_target":"prévenuです。","line_vi":"Đó là prévenu.","focus_words":["prévenu"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_714dff40","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「prononcé」 có nghĩa là gì?","options":["phát âm","tạm thời","cảnh báo","tâm lý"],"answer_index":0,"explanation":"prononcé = phát âm"},{"question":"Từ 「provisoire」 có nghĩa là gì?","options":["tạm thời","phát âm","cảnh báo","tâm lý"],"answer_index":0,"explanation":"provisoire = tạm thời"},{"question":"Từ 「prévenu」 có nghĩa là gì?","options":["cảnh báo","phát âm","tạm thời","tâm lý"],"answer_index":0,"explanation":"prévenu = cảnh báo"},{"question":"Từ 「psychologique」 có nghĩa là gì?","options":["tâm lý","phát âm","tạm thời","cảnh báo"],"answer_index":0,"explanation":"psychologique = tâm lý"},{"question":"Từ 「purement」 có nghĩa là gì?","options":["hoàn toàn","phát âm","tạm thời","cảnh báo"],"answer_index":0,"explanation":"purement = hoàn toàn"},{"question":"Từ 「représenté」 có nghĩa là gì?","options":["đại diện","phát âm","tạm thời","cảnh báo"],"answer_index":0,"explanation