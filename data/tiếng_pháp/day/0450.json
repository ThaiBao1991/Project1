ence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 450","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"aimaitを 使います。","line_vi":"Tôi dùng aimait.","focus_words":["aimait"]},{"speaker":"B","line_target":"ampleur は 何ですか。","line_vi":"ampleur là cái gì?","focus_words":["ampleur"]},{"speaker":"A","line_target":"apparaissentです。","line_vi":"Đó là apparaissent.","focus_words":["apparaissent"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2d134bd4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「aimait」 có nghĩa là gì?","options":["yêu","độ lớn","xuất hiện","sẽ đến"],"answer_index":0,"explanation":"aimait = yêu"},{"question":"Từ 「ampleur」 có nghĩa là gì?","options":["độ lớn","yêu","xuất hiện","sẽ đến"],"answer_index":0,"explanation":"ampleur = độ lớn"},{"question":"Từ 「apparaissent」 có nghĩa là gì?","options":["xuất hiện","yêu","độ lớn","sẽ đến"],"answer_index":0,"explanation":"apparaissent = xuất hiện"},{"question":"Từ 「arrivera」 có nghĩa là gì?","options":["sẽ đến","yêu","độ lớn","xuất hiện"],"answer_index":0,"explanation":"arrivera = sẽ đến"},{"question":"Từ 「attire」 có nghĩa là gì?","options":["thu hút","yêu","độ lớn","xuất hiện"],"answer_index":0,"explanation":"attire = thu hút"},{"question":"Từ 「barbe」 có nghĩa là gì?","options":["râu","yêu","độ lớn","xuất hiện"],"answer_index":0,"explanation":"barbe = râu"},{"question":"Từ 「blonde」 có nghĩa là gì?","options":["tóc vàng","yêu","độ lớn","xuất hiện"],"answer_index":0,"explanation":"blonde = tóc vàng"},{"question":"Từ 「bloqué