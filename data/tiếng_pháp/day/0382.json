ạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 382","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"peintreを 使います。","line_vi":"Tôi dùng peintre.","focus_words":["peintre"]},{"speaker":"B","line_target":"personnelles は 何ですか。","line_vi":"personnelles là cái gì?","focus_words":["personnelles"]},{"speaker":"A","line_target":"potです。","line_vi":"Đó là pot.","focus_words":["pot"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c823555b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「peintre」 có nghĩa là gì?","options":["họa sĩ","cá nhân","bình","trình bày"],"answer_index":0,"explanation":"peintre = họa sĩ"},{"question":"Từ 「personnelles」 có nghĩa là gì?","options":["cá nhân","họa sĩ","bình","trình bày"],"answer_index":0,"explanation":"personnelles = cá nhân"},{"question":"Từ 「pot」 có nghĩa là gì?","options":["bình","họa sĩ","cá nhân","trình bày"],"answer_index":0,"explanation":"pot = bình"},{"question":"Từ 「présentée」 có nghĩa là gì?","options":["trình bày","họa sĩ","cá nhân","bình"],"answer_index":0,"explanation":"présentée = trình bày"},{"question":"Từ 「racisme」 có nghĩa là gì?","options":["phân biệt chủng tộc","họa sĩ","cá nhân","bình"],"answer_index":0,"explanation":"racisme = phân biệt chủng tộc"},{"question":"Từ 「remercie」 có nghĩa là gì?","options":["cảm ơn","họa sĩ","cá nhân","bình"],"answer_index":0,"explanation":"remercie = cảm ơn"},{"question":"Từ 「récente」 có nghĩa là gì?","options