n bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 421","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"listesを 使います。","line_vi":"Tôi dùng listes.","focus_words":["listes"]},{"speaker":"B","line_target":"marier は 何ですか。","line_vi":"marier là cái gì?","focus_words":["marier"]},{"speaker":"A","line_target":"masterです。","line_vi":"Đó là master.","focus_words":["master"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_90319705","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「listes」 có nghĩa là gì?","options":["danh sách","kết hôn","bậc thầy","nói dối"],"answer_index":0,"explanation":"listes = danh sách"},{"question":"Từ 「marier」 có nghĩa là gì?","options":["kết hôn","danh sách","bậc thầy","nói dối"],"answer_index":0,"explanation":"marier = kết hôn"},{"question":"Từ 「master」 có nghĩa là gì?","options":["bậc thầy","danh sách","kết hôn","nói dối"],"answer_index":0,"explanation":"master = bậc thầy"},{"question":"Từ 「mentir」 có nghĩa là gì?","options":["nói dối","danh sách","kết hôn","bậc thầy"],"answer_index":0,"explanation":"mentir = nói dối"},{"question":"Từ 「menée」 có nghĩa là gì?","options":["dẫn đầu","danh sách","kết hôn","bậc thầy"],"answer_index":0,"explanation":"menée = dẫn đầu"},{"question":"Từ 「merveilleux」 có nghĩa là gì?","options":["tuyệt vời","danh sách","kết hôn","bậc thầy"],"answer_index":0,"explanation":"merveilleux = tuyệt vời"},{"question":"Từ 「mince」 có nghĩa là gì?","options":["gầy","danh sách","kết hôn","bậc thầy"],"answer_index":0,"explanation":"mince = gầy"},{"question":"