iểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 370","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"comparerを 使います。","line_vi":"Tôi dùng comparer.","focus_words":["comparer"]},{"speaker":"B","line_target":"connard は 何ですか。","line_vi":"connard là cái gì?","focus_words":["connard"]},{"speaker":"A","line_target":"conseillersです。","line_vi":"Đó là conseillers.","focus_words":["conseillers"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_603ff398","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「comparer」 có nghĩa là gì?","options":["so sánh","thằng khốn nạn","cố vấn","bảo thủ"],"answer_index":0,"explanation":"comparer = so sánh"},{"question":"Từ 「connard」 có nghĩa là gì?","options":["thằng khốn nạn","so sánh","cố vấn","bảo thủ"],"answer_index":0,"explanation":"connard = thằng khốn nạn"},{"question":"Từ 「conseillers」 có nghĩa là gì?","options":["cố vấn","so sánh","thằng khốn nạn","bảo thủ"],"answer_index":0,"explanation":"conseillers = cố vấn"},{"question":"Từ 「conservateur」 có nghĩa là gì?","options":["bảo thủ","so sánh","thằng khốn nạn","cố vấn"],"answer_index":0,"explanation":"conservateur = bảo thủ"},{"question":"Từ 「constituent」 có nghĩa là gì?","options":["cấu thành","so sánh","thằng khốn nạn","cố vấn"],"answer_index":0,"explanation":"constituent = cấu thành"},{"question":"Từ 「descendre」 có nghĩa là gì?","options":["đi xuống","so sánh","thằng khốn nạn","cố vấn"],"a