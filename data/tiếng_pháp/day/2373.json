_。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2373","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"fürを 使います。","line_vi":"Tôi dùng für.","focus_words":["für"]},{"speaker":"B","line_target":"gao は 何ですか。","line_vi":"gao là cái gì?","focus_words":["gao"]},{"speaker":"A","line_target":"gbagboです。","line_vi":"Đó là gbagbo.","focus_words":["gbagbo"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「für」 có nghĩa là gì?","options":["cho","gao","gbagbo","quý ông"],"answer_index":0,"explanation":"für = cho"},{"question":"Từ 「gao」 có nghĩa là gì?","options":["gao","cho","gbagbo","quý ông"],"answer_index":0,"explanation":"gao = gao"},{"question":"Từ 「gbagbo」 có nghĩa là gì?","options":["gbagbo","cho","gao","quý ông"],"answer_index":0,"explanation":"gbagbo = gbagbo"},{"question":"Từ 「gent」 có nghĩa là gì?","options":["quý ông","cho","gao","gbagbo"],"answer_index":0,"explanation":"gent = quý ông"},{"question":"Từ 「gerry」 có nghĩa là gì?","options":["vui vẻ","cho","gao","gbagbo"],"answer_index":0,"explanation":"gerry = vui vẻ"},{"question":"Từ 「gin」 có nghĩa là gì?","options":["rượu gin","cho","gao","gbagbo"],"answer_index":0,"explanation":"gin = rượu gin"},{"question":"Từ 「gitans」 có nghĩa là gì?","options":["người gypsies","cho","gao","gbagbo"],"answer_index":0,"explanation":"gitans = người gypsies"},{"question":"Từ 「glucides」 có nghĩa là gì?","options":["carbohydrate","cho","gao","gbagbo"],"answer_index":0,"explanation":"glucides = carbohydrate"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cho","options":["für","gao","gbagbo","gent"],"answer_index":0,"explanation":"für = cho"},{"question":"Chọn từ đúng c