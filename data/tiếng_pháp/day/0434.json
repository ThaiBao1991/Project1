a nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 434","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"criminelを 使います。","line_vi":"Tôi dùng criminel.","focus_words":["criminel"]},{"speaker":"B","line_target":"césar は 何ですか。","line_vi":"césar là cái gì?","focus_words":["césar"]},{"speaker":"A","line_target":"danserです。","line_vi":"Đó là danser.","focus_words":["danser"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f4cb79e0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「criminel」 có nghĩa là gì?","options":["tội phạm","Caesar","khiêu vũ","sẽ phải"],"answer_index":0,"explanation":"criminel = tội phạm"},{"question":"Từ 「césar」 có nghĩa là gì?","options":["Caesar","tội phạm","khiêu vũ","sẽ phải"],"answer_index":0,"explanation":"césar = Caesar"},{"question":"Từ 「danser」 có nghĩa là gì?","options":["khiêu vũ","tội phạm","Caesar","sẽ phải"],"answer_index":0,"explanation":"danser = khiêu vũ"},{"question":"Từ 「devront」 có nghĩa là gì?","options":["sẽ phải","tội phạm","Caesar","khiêu vũ"],"answer_index":0,"explanation":"devront = sẽ phải"},{"question":"Từ 「domination」 có nghĩa là gì?","options":["sự thống trị","tội phạm","Caesar","khiêu vũ"],"answer_index":0,"explanation":"domination = sự thống trị"},{"question":"Từ 「dvd」 có nghĩa là gì?","options":["đĩa DVD","tội phạm","Caesar","khiêu vũ"],"answer_index":0,"explanation":"dvd = đĩa DVD"},{"que