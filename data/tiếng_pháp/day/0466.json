on":"","ipa":"","part_of_speech":"","meaning_vi":"riêng biệt","explanation":"riêng biệt","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_534c2177","audio_ref":"m_3652361f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b98bc73b"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 466","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"satisfactionを 使います。","line_vi":"Tôi dùng satisfaction.","focus_words":["satisfaction"]},{"speaker":"B","line_target":"sauvé は 何ですか。","line_vi":"sauvé là cái gì?","focus_words":["sauvé"]},{"speaker":"A","line_target":"similairesです。","line_vi":"Đó là similaires.","focus_words":["similaires"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cc9c09e3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「satisfaction」 có nghĩa là gì?","options":["sự hài lòng","đã lưu","tương tự","điện thoại thông minh"],"answer_index":0,"explanation":"satisfaction = sự hài lòng"},{"question":"Từ 「sauvé」 có nghĩa là gì?","options":["đã lưu","sự hài lòng","tương tự","điện thoại thông minh"],"answer_index":0,"explanation":"sauvé = đã lưu"},{"question":"Từ 「similaires」 có nghĩa là gì?","options":["tương tự","sự hài lòng","đã lưu","điện thoại thông minh"],"answer_index":0,"explanation":"similaires = tương tự"},{"question":"Từ 「smartphone」 có nghĩa là gì?","options":["điện thoại thông minh","sự hài lòng","đã lưu","tương tự"],"answer_index":0,"explanation":"smartphone = điện thoại thông minh"},{"question":"Từ 「souligne」 có nghĩa là gì?","options":["gạch chân","sự hài lòng","đã lưu","tương tự"],"answer_index":0,"ex