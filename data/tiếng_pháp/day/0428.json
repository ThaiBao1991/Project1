_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 428","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"diamètreを 使います。","line_vi":"Tôi dùng diamètre.","focus_words":["diamètre"]},{"speaker":"B","line_target":"dénonce は 何ですか。","line_vi":"dénonce là cái gì?","focus_words":["dénonce"]},{"speaker":"A","line_target":"existerです。","line_vi":"Đó là exister.","focus_words":["exister"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_78bb34c5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「diamètre」 có nghĩa là gì?","options":["đường kính","tố cáo","tồn tại","hóa đơn"],"answer_index":0,"explanation":"diamètre = đường kính"},{"question":"Từ 「dénonce」 có nghĩa là gì?","options":["tố cáo","đường kính","tồn tại","hóa đơn"],"answer_index":0,"explanation":"dénonce = tố cáo"},{"question":"Từ 「exister」 có nghĩa là gì?","options":["tồn tại","đường kính","tố cáo","hóa đơn"],"answer_index":0,"explanation":"exister = tồn tại"},{"question":"Từ 「facture」 có nghĩa là gì?","options":["hóa đơn","đường kính","tố cáo","tồn tại"],"answer_index":0,"explanation":"facture = hóa đơn"},{"question":"Từ 「façons」 có nghĩa là gì?","options":["cách","đường kính","tố cáo","tồn tại"],"answer_index":0,"explanation":"façons = cách"},{"question":"Từ 「félicitations」 có nghĩa là gì?","options":["xin chúc mừng","đường kính","tố cáo","tồn tại"],"answer_index":0,"explanation":"félicitations = xin chúc mừng"},{"question":"Từ 「habitant」 có nghĩ