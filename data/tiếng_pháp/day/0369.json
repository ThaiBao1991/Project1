ích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 369","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ambassadeurを 使います。","line_vi":"Tôi dùng ambassadeur.","focus_words":["ambassadeur"]},{"speaker":"B","line_target":"autorisé は 何ですか。","line_vi":"autorisé là cái gì?","focus_words":["autorisé"]},{"speaker":"A","line_target":"cachéです。","line_vi":"Đó là caché.","focus_words":["caché"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_aaf88cc9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ambassadeur」 có nghĩa là gì?","options":["đại sứ","được ủy quyền","ẩn giấu","cacbon"],"answer_index":0,"explanation":"ambassadeur = đại sứ"},{"question":"Từ 「autorisé」 có nghĩa là gì?","options":["được ủy quyền","đại sứ","ẩn giấu","cacbon"],"answer_index":0,"explanation":"autorisé = được ủy quyền"},{"question":"Từ 「caché」 có nghĩa là gì?","options":["ẩn giấu","đại sứ","được ủy quyền","cacbon"],"answer_index":0,"explanation":"caché = ẩn giấu"},{"question":"Từ 「carbone」 có nghĩa là gì?","options":["cacbon","đại sứ","được ủy quyền","ẩn giấu"],"answer_index":0,"explanation":"carbone = cacbon"},{"question":"Từ 「cellule」 có nghĩa là gì?","options":["tế bào","đại sứ","được ủy quyền","ẩn giấu"],"answer_index":0,"explanation":"cellule = tế bào"},{"question":"Từ 「chantier」 có nghĩa là gì?","options":["công trường xây dựng","đại sứ","được 