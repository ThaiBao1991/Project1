unciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 403","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"métropoleを 使います。","line_vi":"Tôi dùng métropole.","focus_words":["métropole"]},{"speaker":"B","line_target":"napoléon は 何ですか。","line_vi":"napoléon là cái gì?","focus_words":["napoléon"]},{"speaker":"A","line_target":"noiresです。","line_vi":"Đó là noires.","focus_words":["noires"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6e5b428f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「métropole」 có nghĩa là gì?","options":["đô thị","napoléon","màu đen","quan sát"],"answer_index":0,"explanation":"métropole = đô thị"},{"question":"Từ 「napoléon」 có nghĩa là gì?","options":["napoléon","đô thị","màu đen","quan sát"],"answer_index":0,"explanation":"napoléon = napoléon"},{"question":"Từ 「noires」 có nghĩa là gì?","options":["màu đen","đô thị","napoléon","quan sát"],"answer_index":0,"explanation":"noires = màu đen"},{"question":"Từ 「observation」 có nghĩa là gì?","options":["quan sát","đô thị","napoléon","màu đen"],"answer_index":0,"explanation":"observation = quan sát"},{"question":"Từ 「ondes」 có nghĩa là gì?","options":["sóng biển","đô thị","napoléon","màu đen"],"answer_index":0,"explanation":"ondes = sóng biển"},{"question":"Từ 「opinions」 có nghĩa là gì?","options":["ý kiến","đô thị","napoléon","màu đen"],"answer_index":0,"explanation":"opinions = ý kiến"},{"question":"Từ 「pacifique」 có nghĩa là gì?","options":["yên bình","đô thị","napoléon","màu đen"],"answer_index":0,"explanation":"pacifiqu