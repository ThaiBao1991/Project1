) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 547","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"actionnairesを 使います。","line_vi":"Tôi dùng actionnaires.","focus_words":["actionnaires"]},{"speaker":"B","line_target":"adhésion は 何ですか。","line_vi":"adhésion là cái gì?","focus_words":["adhésion"]},{"speaker":"A","line_target":"agendaです。","line_vi":"Đó là agenda.","focus_words":["agenda"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1a8182ed","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「actionnaires」 có nghĩa là gì?","options":["cổ đông","tư cách thành viên","nhật ký","khu vực"],"answer_index":0,"explanation":"actionnaires = cổ đông"},{"question":"Từ 「adhésion」 có nghĩa là gì?","options":["tư cách thành viên","cổ đông","nhật ký","khu vực"],"answer_index":0,"explanation":"adhésion = tư cách thành viên"},{"question":"Từ 「agenda」 có nghĩa là gì?","options":["nhật ký","cổ đông","tư cách thành viên","khu vực"],"answer_index":0,"explanation":"agenda = nhật ký"},{"question":"Từ 「aire」 có nghĩa là gì?","options":["khu vực","cổ đông","tư cách thành viên","nhật ký"],"answer_index":0,"explanation":"aire = khu vực"},{"question":"Từ 「antique」 có nghĩa là gì?","options":["cổ xưa","cổ đông","tư cách thành viên","nhật ký"],"answer_index":0,"explanation":"antique = cổ xưa"},{"question":"Từ 「ar