ech":"","meaning_vi":"tài chính","explanation":"tài chính","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_5a6aa48b","audio_ref":"m_8355164d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_3e20d5cb"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Đại từ 私 (watashi)","level":"N5","explanation":"Từ chỉ tự ngôn: 私 / 僕・俺 (nam) / 私たち.","examples":[{"sentence":"私は田中です。","meaning_vi":"Tôi là Tanaka."}],"pronunciation_focus":"私 = watashi.","common_mistakes":"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 409","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"dirigéを 使います。","line_vi":"Tôi dùng dirigé.","focus_words":["dirigé"]},{"speaker":"B","line_target":"distinction は 何ですか。","line_vi":"distinction là cái gì?","focus_words":["distinction"]},{"speaker":"A","line_target":"dégâtsです。","line_vi":"Đó là dégâts.","focus_words":["dégâts"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ebfde47d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「dirigé」 có nghĩa là gì?","options":["chỉ đạo","sự phân biệt","thiệt hại","vượt quá"],"answer_index":0,"explanation":"dirigé = chỉ đạo"},{"question":"Từ 「distinction」 có nghĩa là gì?","options":["sự phân biệt","chỉ đạo","thiệt hại","vượt quá"],"answer_index":0,"explanation":"distinction = sự phân biệt"},{"question":"Từ 「dégâts」 có nghĩa là gì?","options":["thiệt hại","chỉ đạo","sự phân biệt","vượt quá"],"answer_index":0,"explanation":"dégâts = thiệt hại"},{"question":"Từ 「dépasser」 có nghĩa là gì?","options":["vượt quá","chỉ đạo","sự phân biệt","thiệt hại"],"answer_index":0,"explanation":"dépasser = vượt quá"},{"question":"Từ 「excellence」 có nghĩa là gì?","options":["sự xuất sắc","chỉ đạo","sự phân biệt","thiệt hại"],"answer_index":0,"explanation":"excellence = sự xuất sắc"},{"question":"Từ 「exceptionnel」 có nghĩa là gì?","options":["đặc biệt","chỉ đạo","sự phân biệt","thiệt hại"],"answer_index":0,"explanation":"exceptionnel = đặc biệt"},{"question":"Từ 「exercer」 có nghĩa là g