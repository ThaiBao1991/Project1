ạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 435","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"fessesを 使います。","line_vi":"Tôi dùng fesses.","focus_words":["fesses"]},{"speaker":"B","line_target":"genres は 何ですか。","line_vi":"genres là cái gì?","focus_words":["genres"]},{"speaker":"A","line_target":"girlです。","line_vi":"Đó là girl.","focus_words":["girl"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e4554d80","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fesses」 có nghĩa là gì?","options":["mông","thể loại","cô gái","đứa trẻ"],"answer_index":0,"explanation":"fesses = mông"},{"question":"Từ 「genres」 có nghĩa là gì?","options":["thể loại","mông","cô gái","đứa trẻ"],"answer_index":0,"explanation":"genres = thể loại"},{"question":"Từ 「girl」 có nghĩa là gì?","options":["cô gái","mông","thể loại","đứa trẻ"],"answer_index":0,"explanation":"girl = cô gái"},{"question":"Từ 「gosse」 có nghĩa là gì?","options":["đứa trẻ","mông","thể loại","cô gái"],"answer_index":0,"explanation":"gosse = đứa trẻ"},{"question":"Từ 「graphique」 có nghĩa là gì?","options":["đồ họa","mông","thể loại","cô gái"],"answer_index":0,"explanation":"graphique = đồ họa"},{"question":"Từ 「gâteau」 có nghĩa là gì?","options":["bánh ngọt","mông","thể loại","cô gái"],"answer_index":0,"explanation":"gâteau = bánh ngọt"},{"question":"Từ 「indépendants」 có nghĩ