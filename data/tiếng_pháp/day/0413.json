xamples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 413","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"photographeを 使います。","line_vi":"Tôi dùng photographe.","focus_words":["photographe"]},{"speaker":"B","line_target":"plaindre は 何ですか。","line_vi":"plaindre là cái gì?","focus_words":["plaindre"]},{"speaker":"A","line_target":"poitrineです。","line_vi":"Đó là poitrine.","focus_words":["poitrine"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_64564f70","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「photographe」 có nghĩa là gì?","options":["nhiếp ảnh gia","phàn nàn","ngực","bột"],"answer_index":0,"explanation":"photographe = nhiếp ảnh gia"},{"question":"Từ 「plaindre」 có nghĩa là gì?","options":["phàn nàn","nhiếp ảnh gia","ngực","bột"],"answer_index":0,"explanation":"plaindre = phàn nàn"},{"question":"Từ 「poitrine」 có nghĩa là gì?","options":["ngực","nhiếp ảnh gia","phàn nàn","bột"],"answer_index":0,"explanation":"poitrine = ngực"},{"question":"Từ 「poudre」 có nghĩa là gì?","options":["bột","nhiếp ảnh gia","phàn nàn","ngực"],"answer_index":0,"explanation":"poudre = bột"},{"question":"Từ 「professeurs」 có nghĩa là gì?","options":["giáo viên","nhiếp ảnh gia","phàn nàn","ngực"],"answer_index":0,"explanation":"professeurs = giáo viên"},{"question":"Từ 「prétexte」 có nghĩa là gì?","options":["cớ","nhiếp ảnh gia","phàn nàn","ngực"],"answer_index":0,"explanation":"prétexte = cớ"},{"