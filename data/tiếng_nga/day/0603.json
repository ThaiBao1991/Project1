e.","focus_words":["life"]},{"speaker":"B","line_target":"африке は 何ですか。","line_vi":"африке là cái gì?","focus_words":["африке"]},{"speaker":"A","line_target":"бакуです。","line_vi":"Đó là баку.","focus_words":["баку"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「life」 có nghĩa là gì?","options":["cuộc sống","Châu Phi","baku","bể bơi"],"answer_index":0,"explanation":"life = cuộc sống"},{"question":"Từ 「африке」 có nghĩa là gì?","options":["Châu Phi","cuộc sống","baku","bể bơi"],"answer_index":0,"explanation":"африке = Châu Phi"},{"question":"Từ 「баку」 có nghĩa là gì?","options":["baku","cuộc sống","Châu Phi","bể bơi"],"answer_index":0,"explanation":"баку = baku"},{"question":"Từ 「бассейн」 có nghĩa là gì?","options":["bể bơi","cuộc sống","Châu Phi","baku"],"answer_index":0,"explanation":"бассейн = bể bơi"},{"question":"Từ 「благодарность」 có nghĩa là gì?","options":["lòng biết ơn","cuộc sống","Châu Phi","baku"],"answer_index":0,"explanation":"благодарность = lòng biết ơn"},{"question":"Từ 「боги」 có nghĩa là gì?","options":["vị thần","cuộc sống","Châu Phi","baku"],"answer_index":0,"explanation":"боги = vị thần"},{"question":"Từ 「бригада」 có nghĩa là gì?","options":["lữ đoàn","cuộc sống","Châu Phi","baku"],"answer_index":0,"explanation":"бригада = lữ đoàn"},{"question":"Từ 「важная」 có nghĩa là gì?","options":["quan trọng","cuộc sống","Châu Phi","baku"],"answer_index":0,"explanation":"важная = quan trọng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cuộc sống","options":["life","африке","баку","бассейн"],"answer_index":0,"explanation":"life = cuộc sống"},{"question":"Chọn từ đúng cho nghĩa: Châu Phi","options":["африке","life","баку","бассейн"],"answer_index":0,"explanation":"африке = Châu Phi"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","med