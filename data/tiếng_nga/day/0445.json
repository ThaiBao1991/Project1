ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4fe68742","audio_ref":"m_9516d3df","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_38c41e70"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 445","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"справитьсяを 使います。","line_vi":"Tôi dùng справиться.","focus_words":["справиться"]},{"speaker":"B","line_target":"спросила は 何ですか。","line_vi":"спросила là cái gì?","focus_words":["спросила"]},{"speaker":"A","line_target":"стратегииです。","line_vi":"Đó là стратегии.","focus_words":["стратегии"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b216d3df","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「справиться」 có nghĩa là gì?","options":["đối phó","hỏi","chiến lược","nghiêm ngặt"],"answer_index":0,"explanation":"справиться = đối phó"},{"question":"Từ 「спросила」 có nghĩa là gì?","options":["hỏi","đối phó","chiến lược","nghiêm ngặt"],"answer_index":0,"explanation":"спросила = hỏi"},{"question":"Từ 「стратегии」 có nghĩa là gì?","options":["chiến lược","đối phó","hỏi","nghiêm ngặt"],"answer_index":0,"explanation":"стратегии = chiến lược"},{"question":"Từ 「строго」 có nghĩa là gì?","options":["nghiêm ngặt","đối phó","hỏi","chiến lược"],"answer_index":0,"explanation":"строго = nghiêm ngặt"},{"question":"Từ 「структур」 có nghĩa là gì?","options":["cấu trúc","đối phó","hỏi","chiến lược"],"answer_index":0,"explanation":"структур = cấu trúc"},{"question":"Từ 「сука」 có nghĩa là gì?","options":["con khốn","đối phó","hỏi","chiến lược"],"answer_index":0,"explanation":"сука = con khốn"},{"question":"Từ 「территорий」 có nghĩa là gì?","options":["lãnh t