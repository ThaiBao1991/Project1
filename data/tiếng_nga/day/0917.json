だきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 917","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"содержатьを 使います。","line_vi":"Tôi dùng содержать.","focus_words":["содержать"]},{"speaker":"B","line_target":"создается は 何ですか。","line_vi":"создается là cái gì?","focus_words":["создается"]},{"speaker":"A","line_target":"сомнениеです。","line_vi":"Đó là сомнение.","focus_words":["сомнение"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「содержать」 có nghĩa là gì?","options":["chứa đựng","được tạo ra","nghi ngờ","đã báo cáo"],"answer_index":0,"explanation":"содержать = chứa đựng"},{"question":"Từ 「создается」 có nghĩa là gì?","options":["được tạo ra","chứa đựng","nghi ngờ","đã báo cáo"],"answer_index":0,"explanation":"создается = được tạo ra"},{"question":"Từ 「сомнение」 có nghĩa là gì?","options":["nghi ngờ","chứa đựng","được tạo ra","đã báo cáo"],"answer_index":0,"explanation":"сомнение = nghi ngờ"},{"question":"Từ 「сообщается」 có nghĩa là gì?","options":["đã báo cáo","chứa đựng","được tạo ra","nghi ngờ"],"answer_index":0,"explanation":"сообщается = đã báo cáo"},{"question":"Từ 「соперника」 có nghĩa là gì?","options":["đối thủ","chứa đựng","được tạo ra","nghi ngờ"],"answer_index":0,"explanation":"соперника = đối thủ"},{"question":"Từ 「специальным」 có nghĩa là gì?","options":["đặc biệt","chứa đựng","được tạo ra","nghi ngờ"],"answer_index":0,"explanation":"специальным = đặc biệt"},{"question":"Từ 「способа」 có nghĩa là gì?","options":["đường","chứa đựng","được tạo ra","nghi ngờ"],"answer_index":0,"explanation":"способа = đường"},{"question":"Từ 「ставка」 có nghĩa là gì?","options":["tỷ lệ","chứa đựng","được tạo ra","nghi ngờ"],"answer_index":0,"explanation":"ставка = tỷ lệ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chứa đựng","options":["содержать","создается","сомнение","сообщается"],"answer_index":0,"explanation":"содержать = chứa đựng"},{"question":"Chọn từ đúng cho nghĩa: được tạo ra","options":["создается","содержать","сомнение","сообщается"],"answer_index":0,"explanation":"создается = được tạo ra"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}