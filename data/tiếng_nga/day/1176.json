ạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1176","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"семействоを 使います。","line_vi":"Tôi dùng семейство.","focus_words":["семейство"]},{"speaker":"B","line_target":"сервиса は 何ですか。","line_vi":"сервиса là cái gì?","focus_words":["сервиса"]},{"speaker":"A","line_target":"сильнымиです。","line_vi":"Đó là сильными.","focus_words":["сильными"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「семейство」 có nghĩa là gì?","options":["gia đình","dịch vụ","mạnh mẽ","theo dõi"],"answer_index":0,"explanation":"семейство = gia đình"},{"question":"Từ 「сервиса」 có nghĩa là gì?","options":["dịch vụ","gia đình","mạnh mẽ","theo dõi"],"answer_index":0,"explanation":"сервиса = dịch vụ"},{"question":"Từ 「сильными」 có nghĩa là gì?","options":["mạnh mẽ","gia đình","dịch vụ","theo dõi"],"answer_index":0,"explanation":"сильными = mạnh mẽ"},{"question":"Từ 「следуют」 có nghĩa là gì?","options":["theo dõi","gia đình","dịch vụ","mạnh mẽ"],"answer_index":0,"explanation":"следуют = theo dõi"},{"question":"Từ 「смертельно」 có nghĩa là gì?","options":["gây tử vong","gia đình","dịch vụ","mạnh mẽ"],"answer_index":0,"explanation":"смертельно = gây tử vong"},{"question":"Từ 「снимал」 có nghĩa là gì?","options":["đã quay phim","gia đình","dịch vụ","mạnh mẽ"],"answer_index":0,"explanation":"снимал = đã quay phim"},{"question":"Từ 「совершила」 có nghĩa là gì?","options":["cam kết","gia đình","dịch vụ","mạnh mẽ"],"answer_index":0,"explanation":"совершила = cam kết"},{"question":"Từ 「сожгли」 có nghĩa là gì?","options":["đốt cháy","gia đình","dịch vụ","mạnh mẽ"],"answer_index":0,"explanation":"сожгли = đốt cháy"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: gia đình","options":["семейство","сервиса","сильными","следуют"],