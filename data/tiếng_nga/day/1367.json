ntence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1367","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"въездを 使います。","line_vi":"Tôi dùng въезд.","focus_words":["въезд"]},{"speaker":"B","line_target":"выбран は 何ですか。","line_vi":"выбран là cái gì?","focus_words":["выбран"]},{"speaker":"A","line_target":"выгляделиです。","line_vi":"Đó là выглядели.","focus_words":["выглядели"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「въезд」 có nghĩa là gì?","options":["lối vào","đã chọn","nhìn","gọi"],"answer_index":0,"explanation":"въезд = lối vào"},{"question":"Từ 「выбран」 có nghĩa là gì?","options":["đã chọn","lối vào","nhìn","gọi"],"answer_index":0,"explanation":"выбран = đã chọn"},{"question":"Từ 「выглядели」 có nghĩa là gì?","options":["nhìn","lối vào","đã chọn","gọi"],"answer_index":0,"explanation":"выглядели = nhìn"},{"question":"Từ 「вызова」 có nghĩa là gì?","options":["gọi","lối vào","đã chọn","nhìn"],"answer_index":0,"explanation":"вызова = gọi"},{"question":"Từ 「выражает」 có nghĩa là gì?","options":["bày tỏ","lối vào","đã chọn","nhìn"],"answer_index":0,"explanation":"выражает = bày tỏ"},{"question":"Từ 「выстрелы」 có nghĩa là gì?","options":["bức ảnh","lối vào","đã chọn","nhìn"],"answer_index":0,"explanation":"выстрелы = bức ảnh"},{"question":"Từ 「галерея」 có nghĩa là gì?","options":["phòng trưng bày","lối vào","đã chọn","nhìn"],"answer_index":0,"explanation":"галерея = phòng trưng bày"},{"question":"Từ 「гамма」 có nghĩa là gì?","options":["gamma","lối vào","đã chọn","nhìn"],"answer_index":0,"explanation":"гамма = gamma"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: lối vào","options":["въезд","выбран","выглядели","вызова"],"answer_index":0,"explanation":"въезд = lối vào"},{"question":"Chọn từ đúng cho nghĩa: đã chọn","options":["выбран","въезд","выглядели","вызова"],"answer_index":0,"explanation":"выбран = đã chọn"}],"common":[],"grammar":[],"mixed":