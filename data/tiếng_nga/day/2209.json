":[{"speaker":"A","line_target":"глубокимを 使います。","line_vi":"Tôi dùng глубоким.","focus_words":["глубоким"]},{"speaker":"B","line_target":"годового は 何ですか。","line_vi":"годового là cái gì?","focus_words":["годового"]},{"speaker":"A","line_target":"годовщинаです。","line_vi":"Đó là годовщина.","focus_words":["годовщина"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「глубоким」 có nghĩa là gì?","options":["sâu","hàng năm","ngày kỷ niệm","núi"],"answer_index":0,"explanation":"глубоким = sâu"},{"question":"Từ 「годового」 có nghĩa là gì?","options":["hàng năm","sâu","ngày kỷ niệm","núi"],"answer_index":0,"explanation":"годового = hàng năm"},{"question":"Từ 「годовщина」 có nghĩa là gì?","options":["ngày kỷ niệm","sâu","hàng năm","núi"],"answer_index":0,"explanation":"годовщина = ngày kỷ niệm"},{"question":"Từ 「горой」 có nghĩa là gì?","options":["núi","sâu","hàng năm","ngày kỷ niệm"],"answer_index":0,"explanation":"горой = núi"},{"question":"Từ 「готовимся」 có nghĩa là gì?","options":["chuẩn bị sẵn sàng","sâu","hàng năm","ngày kỷ niệm"],"answer_index":0,"explanation":"готовимся = chuẩn bị sẵn sàng"},{"question":"Từ 「грамматика」 có nghĩa là gì?","options":["ngữ pháp","sâu","hàng năm","ngày kỷ niệm"],"answer_index":0,"explanation":"грамматика = ngữ pháp"},{"question":"Từ 「графу」 có nghĩa là gì?","options":["Đếm","sâu","hàng năm","ngày kỷ niệm"],"answer_index":0,"explanation":"графу = Đếm"},{"question":"Từ 「громкие」 có nghĩa là gì?","options":["ồn ào","sâu","hàng năm","ngày kỷ niệm"],"answer_index":0,"explanation":"громкие = ồn ào"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sâu","options":["глубоким","годового","годовщина","горой"],"answer_index":0,"explanation":"глубоким = sâu"},{"question":"Chọn từ đúng cho nghĩa: hàng năm","options":["годового","глубоким","годо