tion":"","ipa":"","part_of_speech":"","meaning_vi":"nhiều nhất","explanation":"nhiều nhất","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f8e59aaa","audio_ref":"m_4da2dd72","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_cf5f3eac"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 454","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"принципыを 使います。","line_vi":"Tôi dùng принципы.","focus_words":["принципы"]},{"speaker":"B","line_target":"промышленность は 何ですか。","line_vi":"промышленность là cái gì?","focus_words":["промышленность"]},{"speaker":"A","line_target":"процессыです。","line_vi":"Đó là процессы.","focus_words":["процессы"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6c0c70b5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「принципы」 có nghĩa là gì?","options":["nguyên tắc","ngành công nghiệp","quá trình","đã thử"],"answer_index":0,"explanation":"принципы = nguyên tắc"},{"question":"Từ 「промышленность」 có nghĩa là gì?","options":["ngành công nghiệp","nguyên tắc","quá trình","đã thử"],"answer_index":0,"explanation":"промышленность = ngành công nghiệp"},{"question":"Từ 「процессы」 có nghĩa là gì?","options":["quá trình","nguyên tắc","ngành công nghiệp","đã thử"],"answer_index":0,"explanation":"процессы = quá trình"},{"question":"Từ 「пыталась」 có nghĩa là gì?","options":["đã thử","nguyên tắc","ngành công nghiệp","quá trình"],"answer_index":0,"explanation":"пыталась = đã thử"},{"question":"Từ 「разговаривать」 có nghĩa là gì?","options":["nói chuyện","nguyên tắc","ngành công nghiệp","quá trình"],"answer_index":0,"explanation":"разговаривать = nói chuyện"},{"question":"Từ 「рассматривать」 có nghĩa là gì?","op