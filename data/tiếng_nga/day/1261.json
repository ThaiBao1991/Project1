takes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1261","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"изменяетを 使います。","line_vi":"Tôi dùng изменяет.","focus_words":["изменяет"]},{"speaker":"B","line_target":"интеллектуальной は 何ですか。","line_vi":"интеллектуальной là cái gì?","focus_words":["интеллектуальной"]},{"speaker":"A","line_target":"исполнилです。","line_vi":"Đó là исполнил.","focus_words":["исполнил"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「изменяет」 có nghĩa là gì?","options":["gian lận","trí tuệ","thực hiện","người biểu diễn"],"answer_index":0,"explanation":"изменяет = gian lận"},{"question":"Từ 「интеллектуальной」 có nghĩa là gì?","options":["trí tuệ","gian lận","thực hiện","người biểu diễn"],"answer_index":0,"explanation":"интеллектуальной = trí tuệ"},{"question":"Từ 「исполнил」 có nghĩa là gì?","options":["thực hiện","gian lận","trí tuệ","người biểu diễn"],"answer_index":0,"explanation":"исполнил = thực hiện"},{"question":"Từ 「исполнителя」 có nghĩa là gì?","options":["người biểu diễn","gian lận","trí tuệ","thực hiện"],"answer_index":0,"explanation":"исполнителя = người biểu diễn"},{"question":"Từ 「исполняется」 có nghĩa là gì?","options":["thực hiện","gian lận","trí tuệ","người biểu diễn"],"answer_index":0,"explanation":"исполняется = thực hiện"},{"question":"Từ 「исследовать」 có nghĩa là gì?","options":["khám phá","gian lận","trí tuệ","thực hiện"],"answer_index":0,"explanation":"исследовать = khám phá"},{"question":"Từ 「историческую」 có nghĩa là gì?","options":["lịch sử","gian lận","trí tuệ","thự