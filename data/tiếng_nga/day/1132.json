s":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1132","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"установленныхを 使います。","line_vi":"Tôi dùng установленных.","focus_words":["установленных"]},{"speaker":"B","line_target":"участию は 何ですか。","line_vi":"участию là cái gì?","focus_words":["участию"]},{"speaker":"A","line_target":"учебниковです。","line_vi":"Đó là учебников.","focus_words":["учебников"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「установленных」 có nghĩa là gì?","options":["thành lập","sự tham gia","sách giáo khoa","phía trước"],"answer_index":0,"explanation":"установленных = thành lập"},{"question":"Từ 「участию」 có nghĩa là gì?","options":["sự tham gia","thành lập","sách giáo khoa","phía trước"],"answer_index":0,"explanation":"участию = sự tham gia"},{"question":"Từ 「учебников」 có nghĩa là gì?","options":["sách giáo khoa","thành lập","sự tham gia","phía trước"],"answer_index":0,"explanation":"учебников = sách giáo khoa"},{"question":"Từ 「фас」 có nghĩa là gì?","options":["phía trước","thành lập","sự tham gia","sách giáo khoa"],"answer_index":0,"explanation":"фас = phía trước"},{"question":"Từ 「фиг」 có nghĩa là gì?","options":["sung","thành lập","sự tham gia","sách giáo khoa"],"answer_index":0,"explanation":"фиг = sung"},{"question":"Từ 「футболе」 có nghĩa là gì?","options":["bóng đá","thành lập","sự tham gia","sách giáo khoa"],"answer_index":0,"explanation":"футболе = bóng đá"},{"question":"Từ 「характерно」 có nghĩa là gì?","options":["điển hình","thành lập","sự tham gia","sách giáo khoa"],"answer_index":0,"explanation":"характерно = điển hình"},{"question":"Từ 「холодильник」 có nghĩa là gì?","options":["tủ lạnh","thành lập","sự tham gia","sách giáo khoa"],"answer_index":0,"ex