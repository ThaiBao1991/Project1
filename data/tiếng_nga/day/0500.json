ないわけではありません。","meaning_vi":"Không phải là không đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 500","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"смехを 使います。","line_vi":"Tôi dùng смех.","focus_words":["смех"]},{"speaker":"B","line_target":"сна は 何ですか。","line_vi":"сна là cái gì?","focus_words":["сна"]},{"speaker":"A","line_target":"согласныです。","line_vi":"Đó là согласны.","focus_words":["согласны"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_13a5b798","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「смех」 có nghĩa là gì?","options":["tiếng cười","ngủ","đồng ý","đặc biệt"],"answer_index":0,"explanation":"смех = tiếng cười"},{"question":"Từ 「сна」 có nghĩa là gì?","options":["ngủ","tiếng cười","đồng ý","đặc biệt"],"answer_index":0,"explanation":"сна = ngủ"},{"question":"Từ 「согласны」 có nghĩa là gì?","options":["đồng ý","tiếng cười","ngủ","đặc biệt"],"answer_index":0,"explanation":"согласны = đồng ý"},{"question":"Từ 「специальной」 có nghĩa là gì?","options":["đặc biệt","tiếng cười","ngủ","đồng ý"],"answer_index":0,"explanation":"специальной = đặc biệt"},{"question":"Từ 「спортсменов」 có nghĩa là gì?","options":["vận động viên","tiếng cười","ngủ","đồng ý"],"answer_index":0,"explanation":"спортсменов = vận động viên"},{"question":"Từ 「старт」 có nghĩa là gì?","options":["bắt đầu","tiếng cười","ngủ","đồng ý"],"answer_index":0,"explanation":"старт = bắt đầu"},{"question":"Từ 「статистика」 có nghĩa là gì?","options":["thống kê","tiếng cười","ngủ","đồng ý"],"answer_index":0,"explanation":"статистик