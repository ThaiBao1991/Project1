ng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2417","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"спискамを 使います。","line_vi":"Tôi dùng спискам.","focus_words":["спискам"]},{"speaker":"B","line_target":"сплавов は 何ですか。","line_vi":"сплавов là cái gì?","focus_words":["сплавов"]},{"speaker":"A","line_target":"справиласьです。","line_vi":"Đó là справилась.","focus_words":["справилась"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「спискам」 có nghĩa là gì?","options":["danh sách","hợp kim","đối phó","lão hóa"],"answer_index":0,"explanation":"спискам = danh sách"},{"question":"Từ 「сплавов」 có nghĩa là gì?","options":["hợp kim","danh sách","đối phó","lão hóa"],"answer_index":0,"explanation":"сплавов = hợp kim"},{"question":"Từ 「справилась」 có nghĩa là gì?","options":["đối phó","danh sách","hợp kim","lão hóa"],"answer_index":0,"explanation":"справилась = đối phó"},{"question":"Từ 「старения」 có nghĩa là gì?","options":["lão hóa","danh sách","hợp kim","đối phó"],"answer_index":0,"explanation":"старения = lão hóa"},{"question":"Từ 「стержень」 có nghĩa là gì?","options":["gậy","danh sách","hợp kim","đối phó"],"answer_index":0,"explanation":"стержень = gậy"},{"question":"Từ 「стефана」 có nghĩa là gì?","options":["Stefana","danh sách","hợp kim","đối phó"],"answer_index":0,"explanation":"стефана = Stefana"},{"question":"Từ 「столичный」 có nghĩa là gì?","options":["đô thị","danh sách","hợp kim","đối phó"],"answer_index":0,"explanation":"столичный = đô thị"},{"question":"Từ 「сторонник」 có nghĩa là gì?","options":["người ủng hộ","danh sách","hợp kim","đối phó"],"answer_index":0,"explanation":"сторонник = người ủng hộ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: danh sách","options":["спискам","сплавов","справилась","ст