ech":"","meaning_vi":"con sông","explanation":"con sông","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_59b5b803","audio_ref":"m_5f9b1a2f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_a22ec134"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 571","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"промышленнойを 使います。","line_vi":"Tôi dùng промышленной.","focus_words":["промышленной"]},{"speaker":"B","line_target":"промышленных は 何ですか。","line_vi":"промышленных là cái gì?","focus_words":["промышленных"]},{"speaker":"A","line_target":"профессиональныхです。","line_vi":"Đó là профессиональных.","focus_words":["профессиональных"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_99fde50d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「промышленной」 có nghĩa là gì?","options":["công nghiệp","chuyên nghiệp","quá khứ","hoạt động"],"answer_index":0,"explanation":"промышленной = công nghiệp"},{"question":"Từ 「промышленных」 có nghĩa là gì?","options":["công nghiệp","chuyên nghiệp","quá khứ","hoạt động"],"answer_index":0,"explanation":"промышленных = công nghiệp"},{"question":"Từ 「профессиональных」 có nghĩa là gì?","options":["chuyên nghiệp","công nghiệp","công nghiệp","quá khứ"],"answer_index":0,"explanation":"профессиональных = chuyên nghiệp"},{"question":"Từ 「прошлым」 có nghĩa là gì?","options":["quá khứ","công nghiệp","công nghiệp","chuyên nghiệp"],"answer_index":0,"explanation":"прошлым = quá khứ"},{"question":"Từ 「работах」 có nghĩa là gì?","options":["hoạt động","công nghiệp","công nghiệp","chuyên nghiệp"],"answer