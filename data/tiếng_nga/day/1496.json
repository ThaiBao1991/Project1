ences":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1496","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"предыдущемを 使います。","line_vi":"Tôi dùng предыдущем.","focus_words":["предыдущем"]},{"speaker":"B","line_target":"преступлениях は 何ですか。","line_vi":"преступлениях là cái gì?","focus_words":["преступлениях"]},{"speaker":"A","line_target":"привезтиです。","line_vi":"Đó là привезти.","focus_words":["привезти"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「предыдущем」 có nghĩa là gì?","options":["trước đó","tội ác","mang theo","mang theo"],"answer_index":0,"explanation":"предыдущем = trước đó"},{"question":"Từ 「преступлениях」 có nghĩa là gì?","options":["tội ác","trước đó","mang theo","mang theo"],"answer_index":0,"explanation":"преступлениях = tội ác"},{"question":"Từ 「привезти」 có nghĩa là gì?","options":["mang theo","trước đó","tội ác","được đưa ra"],"answer_index":0,"explanation":"привезти = mang theo"},{"question":"Từ 「приводить」 có nghĩa là gì?","options":["mang theo","trước đó","tội ác","được đưa ra"],"answer_index":0,"explanation":"приводить = mang theo"},{"question":"Từ 「приводятся」 có nghĩa là gì?","options":["được đưa ra","trước đó","tội ác","mang theo"],"answer_index":0,"explanation":"приводятся = được đưa ra"},{"question":"Từ 「приготовила」 có nghĩa là gì?","options":["chuẩn bị sẵn sàng","trước đó","tội ác","mang theo"],"answer_index":0,"explanation":"приготовила = chuẩn bị sẵn sàng"},{"question":"Từ 「приезжать」 có nghĩa là gì?","options":["đến","trước đó","tội ác","mang theo"],"answer_index":0,"explanation":"приезжать = đến"},{"question":"Từ 「прикрытием」 có nghĩa là gì?","options":["che","trước đó","tội ác","mang theo"],"answer_index":0,"explanation":"прикрытием = che"}],"patt