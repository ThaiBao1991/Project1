ông đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 427","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"заметилиを 使います。","line_vi":"Tôi dùng заметили.","focus_words":["заметили"]},{"speaker":"B","line_target":"запрет は 何ですか。","line_vi":"запрет là cái gì?","focus_words":["запрет"]},{"speaker":"A","line_target":"изображенияです。","line_vi":"Đó là изображения.","focus_words":["изображения"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6eb1a5cc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「заметили」 có nghĩa là gì?","options":["nhận thấy","lệnh cấm","hình ảnh","khác"],"answer_index":0,"explanation":"заметили = nhận thấy"},{"question":"Từ 「запрет」 có nghĩa là gì?","options":["lệnh cấm","nhận thấy","hình ảnh","khác"],"answer_index":0,"explanation":"запрет = lệnh cấm"},{"question":"Từ 「изображения」 có nghĩa là gì?","options":["hình ảnh","nhận thấy","lệnh cấm","khác"],"answer_index":0,"explanation":"изображения = hình ảnh"},{"question":"Từ 「иных」 có nghĩa là gì?","options":["khác","nhận thấy","lệnh cấm","hình ảnh"],"answer_index":0,"explanation":"иных = khác"},{"question":"Từ 「казахстан」 có nghĩa là gì?","options":["Kazakhstan","nhận thấy","lệnh cấm","hình ảnh"],"answer_index":0,"explanation":"казахстан = Kazakhstan"},{"question":"Từ 「конкретно」 có nghĩa là gì?","options":["cụ thể","nhận thấy","lệnh cấm","hình ảnh"],"answer_index":0,"explanation":"конкретно = cụ thể"},{"question":"Từ 「костюм」 có nghĩa là gì?","options":["bộ đ