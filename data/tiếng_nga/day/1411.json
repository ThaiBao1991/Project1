 Ngày 1411","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"позицияхを 使います。","line_vi":"Tôi dùng позициях.","focus_words":["позициях"]},{"speaker":"B","line_target":"покажите は 何ですか。","line_vi":"покажите là cái gì?","focus_words":["покажите"]},{"speaker":"A","line_target":"показаです。","line_vi":"Đó là показа.","focus_words":["показа"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「позициях」 có nghĩa là gì?","options":["chức vụ","cho tôi xem","hiển thị","chỉ số"],"answer_index":0,"explanation":"позициях = chức vụ"},{"question":"Từ 「покажите」 có nghĩa là gì?","options":["cho tôi xem","chức vụ","hiển thị","chỉ số"],"answer_index":0,"explanation":"покажите = cho tôi xem"},{"question":"Từ 「показа」 có nghĩa là gì?","options":["hiển thị","chức vụ","cho tôi xem","chỉ số"],"answer_index":0,"explanation":"показа = hiển thị"},{"question":"Từ 「показателям」 có nghĩa là gì?","options":["chỉ số","chức vụ","cho tôi xem","hiển thị"],"answer_index":0,"explanation":"показателям = chỉ số"},{"question":"Từ 「политически」 có nghĩa là gì?","options":["về mặt chính trị","chức vụ","cho tôi xem","hiển thị"],"answer_index":0,"explanation":"политически = về mặt chính trị"},{"question":"Từ 「послали」 có nghĩa là gì?","options":["đã gửi","chức vụ","cho tôi xem","hiển thị"],"answer_index":0,"explanation":"послали = đã gửi"},{"question":"Từ 「последующим」 có nghĩa là gì?","options":["tiếp theo","chức vụ","cho tôi xem","hiển thị"],"answer_index":0,"explanation":"последующим = tiếp theo"},{"question":"Từ 「поставку」 có nghĩa là gì?","options":["giao hàng","chức vụ","cho tôi xem","hiển thị"],"answer_index":0,"explanation":"поставку = giao hàng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chức vụ","options":["позициях","покажит