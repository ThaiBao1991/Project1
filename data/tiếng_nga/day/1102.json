 Ngày 1102","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"полонを 使います。","line_vi":"Tôi dùng полон.","focus_words":["полон"]},{"speaker":"B","line_target":"получен は 何ですか。","line_vi":"получен là cái gì?","focus_words":["получен"]},{"speaker":"A","line_target":"популярностьюです。","line_vi":"Đó là популярностью.","focus_words":["популярностью"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「полон」 có nghĩa là gì?","options":["đầy đủ","đã nhận được","sự nổi tiếng","khiêu dâm"],"answer_index":0,"explanation":"полон = đầy đủ"},{"question":"Từ 「получен」 có nghĩa là gì?","options":["đã nhận được","đầy đủ","sự nổi tiếng","khiêu dâm"],"answer_index":0,"explanation":"получен = đã nhận được"},{"question":"Từ 「популярностью」 có nghĩa là gì?","options":["sự nổi tiếng","đầy đủ","đã nhận được","khiêu dâm"],"answer_index":0,"explanation":"популярностью = sự nổi tiếng"},{"question":"Từ 「порно」 có nghĩa là gì?","options":["khiêu dâm","đầy đủ","đã nhận được","sự nổi tiếng"],"answer_index":0,"explanation":"порно = khiêu dâm"},{"question":"Từ 「посетили」 có nghĩa là gì?","options":["đã đến thăm","đầy đủ","đã nhận được","sự nổi tiếng"],"answer_index":0,"explanation":"посетили = đã đến thăm"},{"question":"Từ 「посмотрели」 có nghĩa là gì?","options":["nhìn","đầy đủ","đã nhận được","sự nổi tiếng"],"answer_index":0,"explanation":"посмотрели = nhìn"},{"question":"Từ 「потребовали」 có nghĩa là gì?","options":["yêu cầu","đầy đủ","đã nhận được","sự nổi tiếng"],"answer_index":0,"explanation":"потребовали = yêu cầu"},{"question":"Từ 「правая」 có nghĩa là gì?","options":["đúng","đầy đủ","đã nhận được","sự nổi tiếng"],"answer_index":0,"explanation":"правая = đúng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đầy đủ","options"