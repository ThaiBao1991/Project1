ds":["эрмитаж"]},{"speaker":"B","line_target":"явилось は 何ですか。","line_vi":"явилось là cái gì?","focus_words":["явилось"]},{"speaker":"A","line_target":"ясностьです。","line_vi":"Đó là ясность.","focus_words":["ясность"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「эрмитаж」 có nghĩa là gì?","options":["ẩn thất","xuất hiện","sự rõ ràng","Yatsenyuk"],"answer_index":0,"explanation":"эрмитаж = ẩn thất"},{"question":"Từ 「явилось」 có nghĩa là gì?","options":["xuất hiện","ẩn thất","sự rõ ràng","Yatsenyuk"],"answer_index":0,"explanation":"явилось = xuất hiện"},{"question":"Từ 「ясность」 có nghĩa là gì?","options":["sự rõ ràng","ẩn thất","xuất hiện","Yatsenyuk"],"answer_index":0,"explanation":"ясность = sự rõ ràng"},{"question":"Từ 「яценюка」 có nghĩa là gì?","options":["Yatsenyuk","ẩn thất","xuất hiện","sự rõ ràng"],"answer_index":0,"explanation":"яценюка = Yatsenyuk"},{"question":"Từ 「capital」 có nghĩa là gì?","options":["vốn","ẩn thất","xuất hiện","sự rõ ràng"],"answer_index":0,"explanation":"capital = vốn"},{"question":"Từ 「gear」 có nghĩa là gì?","options":["thiết bị","ẩn thất","xuất hiện","sự rõ ràng"],"answer_index":0,"explanation":"gear = thiết bị"},{"question":"Từ 「king」 có nghĩa là gì?","options":["vua","ẩn thất","xuất hiện","sự rõ ràng"],"answer_index":0,"explanation":"king = vua"},{"question":"Từ 「limited」 có nghĩa là gì?","options":["hạn chế","ẩn thất","xuất hiện","sự rõ ràng"],"answer_index":0,"explanation":"limited = hạn chế"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: ẩn thất","options":["эрмитаж","явилось","ясность","яценюка"],"answer_index":0,"explanation":"эрмитаж = ẩn thất"},{"question":"Chọn từ đúng cho nghĩa: xuất hiện","options":["явилось","эрмитаж","ясность","яценюка"],"answer_index":0,"explanation":"явилось = xuất hiện"}],"common":[],"gr