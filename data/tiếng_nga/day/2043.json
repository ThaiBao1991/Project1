ấp học thuật — Ngày 2043","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"другеを 使います。","line_vi":"Tôi dùng друге.","focus_words":["друге"]},{"speaker":"B","line_target":"дум は 何ですか。","line_vi":"дум là cái gì?","focus_words":["дум"]},{"speaker":"A","line_target":"еврейскийです。","line_vi":"Đó là еврейский.","focus_words":["еврейский"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「друге」 có nghĩa là gì?","options":["người bạn","sự diệt vong","người Do Thái","Châu Âu"],"answer_index":0,"explanation":"друге = người bạn"},{"question":"Từ 「дум」 có nghĩa là gì?","options":["sự diệt vong","người bạn","người Do Thái","Châu Âu"],"answer_index":0,"explanation":"дум = sự diệt vong"},{"question":"Từ 「еврейский」 có nghĩa là gì?","options":["người Do Thái","người bạn","sự diệt vong","Châu Âu"],"answer_index":0,"explanation":"еврейский = người Do Thái"},{"question":"Từ 「европой」 có nghĩa là gì?","options":["Châu Âu","người bạn","sự diệt vong","người Do Thái"],"answer_index":0,"explanation":"европой = Châu Âu"},{"question":"Từ 「естественные」 có nghĩa là gì?","options":["tự nhiên","người bạn","sự diệt vong","người Do Thái"],"answer_index":0,"explanation":"естественные = tự nhiên"},{"question":"Từ 「забываю」 có nghĩa là gì?","options":["tôi quên","người bạn","sự diệt vong","người Do Thái"],"answer_index":0,"explanation":"забываю = tôi quên"},{"question":"Từ 「заживо」 có nghĩa là gì?","options":["còn sống","người bạn","sự diệt vong","người Do Thái"],"answer_index":0,"explanation":"заживо = còn sống"},{"question":"Từ 「заинтересовался」 có nghĩa là gì?","options":["đã quan tâm","người bạn","sự diệt vong","người Do Thái"],"answer_index":0,"explanation":"заинтересовался = đã quan tâm"}],"pattern":[{"question":"Chọn từ đ