: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 485","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"нападающийを 使います。","line_vi":"Tôi dùng нападающий.","focus_words":["нападающий"]},{"speaker":"B","line_target":"находит は 何ですか。","line_vi":"находит là cái gì?","focus_words":["находит"]},{"speaker":"A","line_target":"небольшихです。","line_vi":"Đó là небольших.","focus_words":["небольших"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9d48b7b2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「нападающий」 có nghĩa là gì?","options":["phía trước","tìm thấy","nhỏ bé","tiếng Đức"],"answer_index":0,"explanation":"нападающий = phía trước"},{"question":"Từ 「находит」 có nghĩa là gì?","options":["tìm thấy","phía trước","nhỏ bé","tiếng Đức"],"answer_index":0,"explanation":"находит = tìm thấy"},{"question":"Từ 「небольших」 có nghĩa là gì?","options":["nhỏ bé","phía trước","tìm thấy","tiếng Đức"],"answer_index":0,"explanation":"небольших = nhỏ bé"},{"question":"Từ 「немецкой」 có nghĩa là gì?","options":["tiếng Đức","phía trước","tìm thấy","nhỏ bé"],"answer_index":0,"explanation":"немецкой = tiếng Đức"},{"question":"Từ 「непонятно」 có nghĩa là gì?","options":["không rõ ràng","phía trước","tìm thấy","nhỏ bé"],"answer_index":0,"explanation":"непонятно = không rõ ràng"},{"question":"Từ 「несет」 có nghĩa là gì?","options":["mang theo","phía trước","tìm thấy","nhỏ bé"],"a