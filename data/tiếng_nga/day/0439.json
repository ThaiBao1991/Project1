)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 439","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"завтракを 使います。","line_vi":"Tôi dùng завтрак.","focus_words":["завтрак"]},{"speaker":"B","line_target":"задачей は 何ですか。","line_vi":"задачей là cái gì?","focus_words":["задачей"]},{"speaker":"A","line_target":"зарубежныхです。","line_vi":"Đó là зарубежных.","focus_words":["зарубежных"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_239a1d39","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「завтрак」 có nghĩa là gì?","options":["bữa ăn sáng","nhiệm vụ","nước ngoài","âm thanh"],"answer_index":0,"explanation":"завтрак = bữa ăn sáng"},{"question":"Từ 「задачей」 có nghĩa là gì?","options":["nhiệm vụ","bữa ăn sáng","nước ngoài","âm thanh"],"answer_index":0,"explanation":"задачей = nhiệm vụ"},{"question":"Từ 「зарубежных」 có nghĩa là gì?","options":["nước ngoài","bữa ăn sáng","nhiệm vụ","âm thanh"],"answer_index":0,"explanation":"зарубежных = nước ngoài"},{"question":"Từ 「звуки」 có nghĩa là gì?","options":["âm thanh","bữa ăn sáng","nhiệm vụ","nước ngoài"],"answer_index":0,"explanation":"звуки = âm thanh"},{"question":"Từ 「изделий」 có nghĩa là gì?","options":["sản phẩm","bữa ăn sáng","nhiệm vụ","nước ngoài"],"answer_index":0,"explanation":"изделий = sản phẩm"},{"question":"Từ 「искусств」 có ng