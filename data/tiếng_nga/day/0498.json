nciation":"","ipa":"","part_of_speech":"","meaning_vi":"bố mẹ","explanation":"bố mẹ","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_169ed923","audio_ref":"m_7d66e26f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_75b89c7f"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Từ chỉ người (の)","level":"N3","explanation":"の + danh từ: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]},{"title":"Quá khứ xa (〜た)","level":"N3","explanation":"Ngữ cảnh quá khứ: 子供の時に、学校に通っていました.","examples":[{"sentence":"子供の頃、学校に通っていました。","meaning_vi":"Thời thơ ấy tôi có đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]},{"title":"So sánh mức độ (〜より)","level":"N2","explanation":"Câu so sánh: 大阪より大阪のほうが大きい.","examples":[{"sentence":"大阪のほうが大きいです。","meaning_vi":"Osaka lớn hơn."},{"sentence":"月曜日より土曜日の方が楽しい。","meaning_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]},{"title":"Phủ định một phần (〜わけではない)","level":"N2","explanation":"〜わけではない = không hẳn là: 嫌いなわけではない.","examples":[{"sentence":"嫌いなわけではありません。","meaning_vi":"Không hẳn là ghét."},{"sentence":"行かないわけではありません。","meaning_vi":"Không phải là không đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 498","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"проблемойを 使います。","line_vi":"Tôi dùng проблемой.","focus_words":["проблемой"]},{"speaker":"B","line_target":"происходят は 何ですか。","line_vi":"происходят là cái gì?","focus_words":["происходят"]},{"speaker":"A","line_target":"пропустилです。","line_vi":"Đó là пропустил.","focus_words":["пропустил"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f2f33270","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「проблемой」 có nghĩa là gì?","options":["vấn đề","đang xảy ra","đã bỏ lỡ nó","tâm lý học"],"answer_index":0,"explanation":"проблемой = vấn đề"},{"question":"Từ 「происходят」 có nghĩa là gì?","options":["đang xảy ra","vấn đề","đã bỏ lỡ nó","tâm lý học"],"answer_index":0,"explanation":"происходят = đang xảy ra"},{"question":"Từ 「пропустил」 có nghĩa là gì?","options":["đã bỏ lỡ nó","vấn đề","đang xảy ra","tâm lý học"],"answer_index":0,"explanation":"пропустил = đã bỏ lỡ nó"},{"question":"Từ 「психологии」 có nghĩa là gì?","options":["tâm lý học","vấn đề","đang xảy ra","đã bỏ lỡ nó"],"answer_index":0,"explanation":"психологии = tâm lý học"},{"question":"Từ 「работаю」 có nghĩa là gì?","options":["tôi đang làm việc","vấn đề","đang xảy ra","đã bỏ lỡ nó"],"answer_index":0,"explanation":"работаю = tôi đang làm việc"},{"question":"Từ 「рассказы」 có nghĩa là gì?","options":["câu chuy