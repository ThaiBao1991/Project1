きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 521","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"профессиональногоを 使います。","line_vi":"Tôi dùng профессионального.","focus_words":["профессионального"]},{"speaker":"B","line_target":"прошёл は 何ですか。","line_vi":"прошёл là cái gì?","focus_words":["прошёл"]},{"speaker":"A","line_target":"путешествияです。","line_vi":"Đó là путешествия.","focus_words":["путешествия"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f83e0307","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「профессионального」 có nghĩa là gì?","options":["chuyên nghiệp","đã vượt qua","du lịch","năm mươi"],"answer_index":0,"explanation":"профессионального = chuyên nghiệp"},{"question":"Từ 「прошёл」 có nghĩa là gì?","options":["đã vượt qua","chuyên nghiệp","du lịch","năm mươi"],"answer_index":0,"explanation":"прошёл = đã vượt qua"},{"question":"Từ 「путешествия」 có nghĩa là gì?","options":["du lịch","chuyên nghiệp","đã vượt qua","năm mươi"],"answer_index":0,"explanation":"путешествия = du lịch"},{"question":"Từ 「пятьдесят」 có nghĩa là gì?","options":["năm mươi","chuyên nghiệp","đã vượt qua","du lịch"],"answer_index":0,"explanation":"пятьдесят = năm mươi"},{"question":"Từ 「рака」 có nghĩa là gì?","options":["ung thư","chuyên nghiệp","đã vượt qua","du lịch"],"a