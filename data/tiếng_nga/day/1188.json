planation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1188","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"заряを 使います。","line_vi":"Tôi dùng заря.","focus_words":["заря"]},{"speaker":"B","line_target":"здоровьем は 何ですか。","line_vi":"здоровьем là cái gì?","focus_words":["здоровьем"]},{"speaker":"A","line_target":"зоветです。","line_vi":"Đó là зовет.","focus_words":["зовет"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「заря」 có nghĩa là gì?","options":["bình minh","sức khỏe","đang gọi điện","lý tưởng"],"answer_index":0,"explanation":"заря = bình minh"},{"question":"Từ 「здоровьем」 có nghĩa là gì?","options":["sức khỏe","bình minh","đang gọi điện","lý tưởng"],"answer_index":0,"explanation":"здоровьем = sức khỏe"},{"question":"Từ 「зовет」 có nghĩa là gì?","options":["đang gọi điện","bình minh","sức khỏe","lý tưởng"],"answer_index":0,"explanation":"зовет = đang gọi điện"},{"question":"Từ 「идеал」 có nghĩa là gì?","options":["lý tưởng","bình minh","sức khỏe","đang gọi điện"],"answer_index":0,"explanation":"идеал = lý tưởng"},{"question":"Từ 「иностранный」 có nghĩa là gì?","options":["nước ngoài","bình minh","sức khỏe","đang gọi điện"],"answer_index":0,"explanation":"иностранный = nước ngoài"},{"question":"Từ 「инспектора」 có nghĩa là gì?","options":["thanh tra","bình minh","sức khỏe","đang gọi điện"],"answer_index":0,"explanation":"инспектора = thanh tra"},{"question":"Từ 「информационного」 có nghĩa là gì?","options":["thông tin","bình minh","sức khỏe","đang gọi điện"],"answer_index":0,"explanation":"информационного = thông tin"},{"question":"Từ 「испанской」 có nghĩa là gì?","options":["tiếng Tây Ban Nha","bình minh","sức khỏe","đang gọi điện"],"answer_index":0,"explanation":"испанской = tiếng Tây Ban Nha"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bình minh","options":["заря","здоровьем","зов