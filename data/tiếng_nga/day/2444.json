y.","level_tag":"N5","turns":[{"speaker":"A","line_target":"обостренияを 使います。","line_vi":"Tôi dùng обострения.","focus_words":["обострения"]},{"speaker":"B","line_target":"образованный は 何ですか。","line_vi":"образованный là cái gì?","focus_words":["образованный"]},{"speaker":"A","line_target":"обрядыです。","line_vi":"Đó là обряды.","focus_words":["обряды"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「обострения」 có nghĩa là gì?","options":["tình trạng trầm trọng hơn","có học thức","nghi lễ","do"],"answer_index":0,"explanation":"обострения = tình trạng trầm trọng hơn"},{"question":"Từ 「образованный」 có nghĩa là gì?","options":["có học thức","tình trạng trầm trọng hơn","nghi lễ","do"],"answer_index":0,"explanation":"образованный = có học thức"},{"question":"Từ 「обряды」 có nghĩa là gì?","options":["nghi lễ","tình trạng trầm trọng hơn","có học thức","do"],"answer_index":0,"explanation":"обряды = nghi lễ"},{"question":"Từ 「обусловлена」 có nghĩa là gì?","options":["do","tình trạng trầm trọng hơn","có học thức","nghi lễ"],"answer_index":0,"explanation":"обусловлена = do"},{"question":"Từ 「обучать」 có nghĩa là gì?","options":["dạy","tình trạng trầm trọng hơn","có học thức","nghi lễ"],"answer_index":0,"explanation":"обучать = dạy"},{"question":"Từ 「обыграв」 có nghĩa là gì?","options":["đã đánh đập","tình trạng trầm trọng hơn","có học thức","nghi lễ"],"answer_index":0,"explanation":"обыграв = đã đánh đập"},{"question":"Từ 「обязательные」 có nghĩa là gì?","options":["bắt buộc","tình trạng trầm trọng hơn","có học thức","nghi lễ"],"answer_index":0,"explanation":"обязательные = bắt buộc"},{"question":"Từ 「огней」 có nghĩa là gì?","options":["đèn","tình trạng trầm trọng hơn","có học thức","nghi lễ"],"answer_index":0,"explanation":"огней = đèn"}],"pattern":[{"question":"Chọn