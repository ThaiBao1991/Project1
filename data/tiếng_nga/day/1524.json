":"N5","turns":[{"speaker":"A","line_target":"общественностьを 使います。","line_vi":"Tôi dùng общественность.","focus_words":["общественность"]},{"speaker":"B","line_target":"объектах は 何ですか。","line_vi":"объектах là cái gì?","focus_words":["объектах"]},{"speaker":"A","line_target":"опасноеです。","line_vi":"Đó là опасное.","focus_words":["опасное"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「общественность」 có nghĩa là gì?","options":["công khai","đồ vật","nguy hiểm","nhất định"],"answer_index":0,"explanation":"общественность = công khai"},{"question":"Từ 「объектах」 có nghĩa là gì?","options":["đồ vật","công khai","nguy hiểm","nhất định"],"answer_index":0,"explanation":"объектах = đồ vật"},{"question":"Từ 「опасное」 có nghĩa là gì?","options":["nguy hiểm","công khai","đồ vật","nhất định"],"answer_index":0,"explanation":"опасное = nguy hiểm"},{"question":"Từ 「определенную」 có nghĩa là gì?","options":["nhất định","công khai","đồ vật","nguy hiểm"],"answer_index":0,"explanation":"определенную = nhất định"},{"question":"Từ 「освобожден」 có nghĩa là gì?","options":["phát hành","công khai","đồ vật","nguy hiểm"],"answer_index":0,"explanation":"освобожден = phát hành"},{"question":"Từ 「оставляя」 có nghĩa là gì?","options":["rời đi","công khai","đồ vật","nguy hiểm"],"answer_index":0,"explanation":"оставляя = rời đi"},{"question":"Từ 「остатков」 có nghĩa là gì?","options":["thức ăn thừa","công khai","đồ vật","nguy hiểm"],"answer_index":0,"explanation":"остатков = thức ăn thừa"},{"question":"Từ 「осуществляют」 có nghĩa là gì?","options":["thực hiện","công khai","đồ vật","nguy hiểm"],"answer_index":0,"explanation":"осуществляют = thực hiện"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: công khai","options":["общественность","объектах","опасное","определенную"],"answer_ind