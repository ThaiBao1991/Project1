:[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"refere