ộng từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 393","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"текстаを 使います。","line_vi":"Tôi dùng текста.","focus_words":["текста"]},{"speaker":"B","line_target":"томас は 何ですか。","line_vi":"томас là cái gì?","focus_words":["томас"]},{"speaker":"A","line_target":"тренеромです。","line_vi":"Đó là тренером.","focus_words":["тренером"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3c9118a1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「текста」 có nghĩa là gì?","options":["văn bản","Thomas","huấn luyện viên","đường phố"],"answer_index":0,"explanation":"текста = văn bản"},{"question":"Từ 「томас」 có nghĩa là gì?","options":["Thomas","văn bản","huấn luyện viên","đường phố"],"answer_index":0,"explanation":"томас = Thomas"},{"question":"Từ 「тренером」 có nghĩa là gì?","options":["huấn luyện viên","văn bản","Thomas","đường phố"],"answer_index":0,"explanation":"тренером = huấn luyện viên"},{"question":"Từ 「улиц」 có nghĩa là gì?","options":["đường phố","văn bản","Thomas","huấn luyện viên"],"answer_index":0,"explanation":"улиц = đường phố"},{"question":"Từ 「уровнем」 có nghĩa là gì?","options":["cấp độ","văn bản","Thomas","huấn luyện viên"],"answer_index":0,"explanation":"уровнем = cấp độ"},{"question":"Từ 「участник」 có nghĩa là gì?","options":["người tham gia","văn 