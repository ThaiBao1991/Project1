planation":"Rio","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_abec7f27","audio_ref":"m_a674b769","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_54355b48"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 432","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"примерыを 使います。","line_vi":"Tôi dùng примеры.","focus_words":["примеры"]},{"speaker":"B","line_target":"принимают は 何ですか。","line_vi":"принимают là cái gì?","focus_words":["принимают"]},{"speaker":"A","line_target":"присутствиеです。","line_vi":"Đó là присутствие.","focus_words":["присутствие"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f9c855ef","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「примеры」 có nghĩa là gì?","options":["ví dụ","chấp nhận","sự hiện diện","hỏi"],"answer_index":0,"explanation":"примеры = ví dụ"},{"question":"Từ 「принимают」 có nghĩa là gì?","options":["chấp nhận","ví dụ","sự hiện diện","hỏi"],"answer_index":0,"explanation":"принимают = chấp nhận"},{"question":"Từ 「присутствие」 có nghĩa là gì?","options":["sự hiện diện","ví dụ","chấp nhận","hỏi"],"answer_index":0,"explanation":"присутствие = sự hiện diện"},{"question":"Từ 「просить」 có nghĩa là gì?","options":["hỏi","ví dụ","chấp nhận","sự hiện diện"],"answer_index":0,"explanation":"просить = hỏi"},{"question":"Từ 「проходили」 có nghĩa là gì?","options":["đã vượt qua","ví dụ","chấp nhận","sự hiện diện"],"answer_index":0,"explanation":"проходили = đã vượt qua"},{"question":"Từ 「птиц」 có nghĩa là gì?","options":["chim","ví dụ","chấp nhận","sự hiện diện"],"answer_index":0,"explanation":"птиц = 