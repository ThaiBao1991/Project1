 điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 556","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"любимаяを 使います。","line_vi":"Tôi dùng любимая.","focus_words":["любимая"]},{"speaker":"B","line_target":"магазины は 何ですか。","line_vi":"магазины là cái gì?","focus_words":["магазины"]},{"speaker":"A","line_target":"манчестерです。","line_vi":"Đó là манчестер.","focus_words":["манчестер"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_63e394b3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「любимая」 có nghĩa là gì?","options":["người yêu dấu","cửa hàng","Manchester","bậc thầy"],"answer_index":0,"explanation":"любимая = người yêu dấu"},{"question":"Từ 「магазины」 có nghĩa là gì?","options":["cửa hàng","người yêu dấu","Manchester","bậc thầy"],"answer_index":0,"explanation":"магазины = cửa hàng"},{"question":"Từ 「манчестер」 có nghĩa là gì?","options":["Manchester","người yêu dấu","cửa hàng","bậc thầy"],"answer_index":0,"explanation":"манчестер = Manchester"},{"question":"Từ 「мастеров」 có nghĩa là gì?","options":["bậc thầy","người yêu dấu","cửa hàng","Manchester"],"answer_index":0,"explanation":"мастеров = bậc thầy"},{"question":"Từ 「медицины」 có nghĩa là gì?","options":["y học","người yêu dấu","cửa hàng","Manchester"],"answer_index":0,"explanation":"медицины = y học"},{"question":"Từ 「месторождения」 có nghĩa là gì?","options":["tiền gửi","người yêu dấu","cửa hàng","Manchest