ệc — Ngày 1412","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"предварительныйを 使います。","line_vi":"Tôi dùng предварительный.","focus_words":["предварительный"]},{"speaker":"B","line_target":"предназначен は 何ですか。","line_vi":"предназначен là cái gì?","focus_words":["предназначен"]},{"speaker":"A","line_target":"представленийです。","line_vi":"Đó là представлений.","focus_words":["представлений"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「предварительный」 có nghĩa là gì?","options":["sơ bộ","dự định","bài nộp","trước đây"],"answer_index":0,"explanation":"предварительный = sơ bộ"},{"question":"Từ 「предназначен」 có nghĩa là gì?","options":["dự định","sơ bộ","bài nộp","trước đây"],"answer_index":0,"explanation":"предназначен = dự định"},{"question":"Từ 「представлений」 có nghĩa là gì?","options":["bài nộp","sơ bộ","dự định","trước đây"],"answer_index":0,"explanation":"представлений = bài nộp"},{"question":"Từ 「прежний」 có nghĩa là gì?","options":["trước đây","sơ bộ","dự định","bài nộp"],"answer_index":0,"explanation":"прежний = trước đây"},{"question":"Từ 「прекрасную」 có nghĩa là gì?","options":["đẹp","sơ bộ","dự định","bài nộp"],"answer_index":0,"explanation":"прекрасную = đẹp"},{"question":"Từ 「прекрасных」 có nghĩa là gì?","options":["đẹp","sơ bộ","dự định","bài nộp"],"answer_index":0,"explanation":"прекрасных = đẹp"},{"question":"Từ 「престарелых」 có nghĩa là gì?","options":["người già","sơ bộ","dự định","bài nộp"],"answer_index":0,"explanation":"престарелых = người già"},{"question":"Từ 「придерживаться」 có nghĩa là gì?","options":["bám vào","sơ bộ","dự định","bài nộp"],"answer_index":0,"explanation":"придерживаться = bám vào"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sơ bộ","options":["пр