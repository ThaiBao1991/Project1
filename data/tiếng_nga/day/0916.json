 án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 916","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"рекомендуетсяを 使います。","line_vi":"Tôi dùng рекомендуется.","focus_words":["рекомендуется"]},{"speaker":"B","line_target":"ресторана は 何ですか。","line_vi":"ресторана là cái gì?","focus_words":["ресторана"]},{"speaker":"A","line_target":"священникаです。","line_vi":"Đó là священника.","focus_words":["священника"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「рекомендуется」 có nghĩa là gì?","options":["đề nghị","nhà hàng","linh mục","phương bắc"],"answer_index":0,"explanation":"рекомендуется = đề nghị"},{"question":"Từ 「ресторана」 có nghĩa là gì?","options":["nhà hàng","đề nghị","linh mục","phương bắc"],"answer_index":0,"explanation":"ресторана = nhà hàng"},{"question":"Từ 「священника」 có nghĩa là gì?","options":["linh mục","đề nghị","nhà hàng","phương bắc"],"answer_index":0,"explanation":"священника = linh mục"},{"question":"Từ 「северных」 có nghĩa là gì?","options":["phương bắc","đề nghị","nhà hàng","linh mục"],"answer_index":0,"explanation":"северных = phương bắc"},{"question":"Từ 「сестре」 có nghĩa là gì?","options":["chị gái","đề nghị","nhà hàng","linh mục"],"answer_index":0,"explanation":"сестре = chị gái"},{"question":"Từ 「системах」 có nghĩa là gì?","options":["hệ thống","đề nghị","nhà hàng","linh mục"],"answer_index":0,"explanation":"системах = hệ thống"},{"question":"Từ 「смеси」 có nghĩa là gì?","options":["hỗn hợp","đề nghị","nhà hàng","linh mục"],"answer_index":0,"explanation":"смеси = hỗn hợp"},{"question":"Từ 「снимает」 có nghĩa là gì?","options":["loại bỏ","đề nghị","nhà hàng","linh mục"],"answer_index":0,"explanation":"снимает = loại bỏ"}],"pattern":[{"question":"