anation":"quê hương","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_cbb97adb","audio_ref":"m_70059f59","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b06d2fc6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","exam