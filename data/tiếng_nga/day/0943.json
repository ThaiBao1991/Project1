ogue":[{"title":"Trung cấp công việc — Ngày 943","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"британскаяを 使います。","line_vi":"Tôi dùng британская.","focus_words":["британская"]},{"speaker":"B","line_target":"британских は 何ですか。","line_vi":"британских là cái gì?","focus_words":["британских"]},{"speaker":"A","line_target":"величестваです。","line_vi":"Đó là величества.","focus_words":["величества"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「британская」 có nghĩa là gì?","options":["người Anh","uy nghi","hay đúng hơn là","xác suất"],"answer_index":0,"explanation":"британская = người Anh"},{"question":"Từ 「британских」 có nghĩa là gì?","options":["người Anh","uy nghi","hay đúng hơn là","xác suất"],"answer_index":0,"explanation":"британских = người Anh"},{"question":"Từ 「величества」 có nghĩa là gì?","options":["uy nghi","người Anh","người Anh","hay đúng hơn là"],"answer_index":0,"explanation":"величества = uy nghi"},{"question":"Từ 「вернее」 có nghĩa là gì?","options":["hay đúng hơn là","người Anh","người Anh","uy nghi"],"answer_index":0,"explanation":"вернее = hay đúng hơn là"},{"question":"Từ 「вероятности」 có nghĩa là gì?","options":["xác suất","người Anh","người Anh","uy nghi"],"answer_index":0,"explanation":"вероятности = xác suất"},{"question":"Từ 「верхнего」 có nghĩa là gì?","options":["phía trên","người Anh","người Anh","uy nghi"],"answer_index":0,"explanation":"верхнего = phía trên"},{"question":"Từ 「ветви」 có nghĩa là gì?","options":["chi nhánh","người Anh","người Anh","uy nghi"],"answer_index":0,"explanation":"ветви = chi nhánh"},{"question":"Từ 「взглянуть」 có nghĩa là gì?","options":["hãy nhìn","người Anh","người Anh","uy nghi"],"answer_index":0,"explanation":"взглянуть = hãy nhìn"}],"patte