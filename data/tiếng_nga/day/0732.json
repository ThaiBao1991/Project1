 án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 732","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"раненыхを 使います。","line_vi":"Tôi dùng раненых.","focus_words":["раненых"]},{"speaker":"B","line_target":"расписание は 何ですか。","line_vi":"расписание là cái gì?","focus_words":["расписание"]},{"speaker":"A","line_target":"сахарです。","line_vi":"Đó là сахар.","focus_words":["сахар"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「раненых」 có nghĩa là gì?","options":["bị thương","lịch trình","đường","giấy chứng nhận"],"answer_index":0,"explanation":"раненых = bị thương"},{"question":"Từ 「расписание」 có nghĩa là gì?","options":["lịch trình","bị thương","đường","giấy chứng nhận"],"answer_index":0,"explanation":"расписание = lịch trình"},{"question":"Từ 「сахар」 có nghĩa là gì?","options":["đường","bị thương","lịch trình","giấy chứng nhận"],"answer_index":0,"explanation":"сахар = đường"},{"question":"Từ 「свидетельство」 có nghĩa là gì?","options":["giấy chứng nhận","bị thương","lịch trình","đường"],"answer_index":0,"explanation":"свидетельство = giấy chứng nhận"},{"question":"Từ 「свободные」 có nghĩa là gì?","options":["miễn phí","bị thương","lịch trình","đường"],"answer_index":0,"explanation":"свободные = miễn phí"},{"question":"Từ 「сделана」 có nghĩa là gì?","options":["xong","bị thương","lịch trình","đường"],"answer_index":0,"explanation":"сделана = xong"},{"question":"Từ 「седьмой」 có nghĩa là gì?","options":["thứ bảy","bị thương","lịch trình","đường"],"answer_index":0,"explanation":"седьмой = thứ bảy"},{"question":"Từ 「семейства」 có nghĩa là gì?","options":["gia đình","bị thương","lịch trình","đường"],"answer_index":0,"explanation":"семейства = gia đình"}],"pattern":[{"question":"Ch