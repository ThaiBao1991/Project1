i là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 388","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"канадыを 使います。","line_vi":"Tôi dùng канады.","focus_words":["канады"]},{"speaker":"B","line_target":"лист は 何ですか。","line_vi":"лист là cái gì?","focus_words":["лист"]},{"speaker":"A","line_target":"личныеです。","line_vi":"Đó là личные.","focus_words":["личные"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3f73280f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「канады」 có nghĩa là gì?","options":["Canada","lá","cá nhân","mọi người"],"answer_index":0,"explanation":"канады = Canada"},{"question":"Từ 「лист」 có nghĩa là gì?","options":["lá","Canada","cá nhân","mọi người"],"answer_index":0,"explanation":"лист = lá"},{"question":"Từ 「личные」 có nghĩa là gì?","options":["cá nhân","Canada","lá","mọi người"],"answer_index":0,"explanation":"личные = cá nhân"},{"question":"Từ 「людях」 có nghĩa là gì?","options":["mọi người","Canada","lá","cá nhân"],"answer_index":0,"explanation":"людях = mọi người"},{"question":"Từ 「максимум」 có nghĩa là gì?","options":["tối đa","Canada","lá","cá nhân"],"answer_index":0,"explanation":"максимум = tối đa"},{"question":"Từ 「мам」 có nghĩa là gì?","options":["mẹ","Canada","lá","cá nhân"],"answer_index":0,"explanation":"мам = mẹ"},{"question":"Từ 「мартин」 có nghĩa là gì?","options":["Martin","Canada","lá","cá nhân"],"answer_index":0,"explanation":"мартин = Martin"},{"question":"Từ 「масло」 có nghĩa là gì?","o