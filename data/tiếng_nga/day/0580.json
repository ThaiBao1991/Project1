5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 580","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"елеを 使います。","line_vi":"Tôi dùng еле.","focus_words":["еле"]},{"speaker":"B","line_target":"ждёт は 何ですか。","line_vi":"ждёт là cái gì?","focus_words":["ждёт"]},{"speaker":"A","line_target":"женскогоです。","line_vi":"Đó là женского.","focus_words":["женского"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7710f49b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「еле」 có nghĩa là gì?","options":["hầu như không","chờ đợi","nữ","nhà ở"],"answer_index":0,"explanation":"еле = hầu như không"},{"question":"Từ 「ждёт」 có nghĩa là gì?","options":["chờ đợi","hầu như không","nữ","nhà ở"],"answer_index":0,"explanation":"ждёт = chờ đợi"},{"question":"Từ 「женского」 có nghĩa là gì?","options":["nữ","hầu như không","chờ đợi","nhà ở"],"answer_index":0,"explanation":"женского = nữ"},{"question":"Từ 「жилья」 có nghĩa là gì?","options":["nhà ở","hầu như không","chờ đợi","nữ"],"answer_index":0,"explanation":"жилья = nhà ở"},{"question":"Từ 「зависимость」 có nghĩa là gì?","options":["nghiện","hầu như không","chờ đợi","nữ"],"answer_index":0,"explanation":"зависимость = nghiện"},{"question":"Từ 「закрыт」 có nghĩa là gì?","options":["đóng cửa","hầu như không","chờ đợi","nữ"],"answer_index":0,"explanation":"закрыт = đóng cửa"},{"question":"Từ 「за