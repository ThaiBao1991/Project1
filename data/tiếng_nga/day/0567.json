lanation":"pháo đài","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_46f44d1e","audio_ref":"m_faf7d1fe","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ea6bb9a4"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 567","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"знакомыを 使います。","line_vi":"Tôi dùng знакомы.","focus_words":["знакомы"]},{"speaker":"B","line_target":"значительное は 何ですか。","line_vi":"значительное là cái gì?","focus_words":["значительное"]},{"speaker":"A","line_target":"игройです。","line_vi":"Đó là игрой.","focus_words":["игрой"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cc433a7b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「знакомы」 có nghĩa là gì?","options":["quen thuộc","đáng kể","trò chơi","công cụ"],"answer_index":0,"explanation":"знакомы = quen thuộc"},{"question":"Từ 「значительное」 có nghĩa là gì?","options":["đáng kể","quen thuộc","trò chơi","công cụ"],"answer_index":0,"explanation":"значительное = đáng kể"},{"question":"Từ 「игрой」 có nghĩa là gì?","options":["trò chơi","quen thuộc","đáng kể","công cụ"],"answer_index":0,"explanation":"игрой = trò chơi"},{"question":"Từ 「инструменты」 có nghĩa là gì?","options":["công cụ","quen thuộc","đáng kể","trò chơi"],"answer_index":0,"explanation":"инструменты = công cụ"},{"question":"Từ 「каталог」 có nghĩa là gì?","options":["danh mục","quen thuộc","đáng kể","trò chơi"],"answer_index":0,"explanation":"каталог = danh mục"},{"question":"Từ 「клубом」 có nghĩa là gì?","options":["câu lạc bộ","quen thuộc","đáng kể","trò chơi"],"answer_index":0,"explanation":"клубом = câu lạc bộ