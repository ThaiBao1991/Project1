 sẽ ghé quý vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 503","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"входаを 使います。","line_vi":"Tôi dùng входа.","focus_words":["входа"]},{"speaker":"B","line_target":"выбрал は 何ですか。","line_vi":"выбрал là cái gì?","focus_words":["выбрал"]},{"speaker":"A","line_target":"вырослаです。","line_vi":"Đó là выросла.","focus_words":["выросла"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9a95e40c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「входа」 có nghĩa là gì?","options":["lối vào","đã chọn","lớn lên","nói chuyện"],"answer_index":0,"explanation":"входа = lối vào"},{"question":"Từ 「выбрал」 có nghĩa là gì?","options":["đã chọn","lối vào","lớn lên","nói chuyện"],"answer_index":0,"explanation":"выбрал = đã chọn"},{"question":"Từ 「выросла」 có nghĩa là gì?","options":["lớn lên","lối vào","đã chọn","nói chuyện"],"answer_index":0,"explanation":"выросла = lớn lên"},{"question":"Từ 「выступили」 có nghĩa là gì?","options":["nói chuyện","lối vào","đã chọn","lớn lên"],"answer_index":0,"explanation":"выступили = nói chuyện"},{"question":"Từ 「давал」 có nghĩa là gì?","options":["đã cho","lối vào","đã chọn","lớn lên"],"answer_index":0,"explanation":"давал = đã cho"},{"question":"Từ 「дворца」 có nghĩa là gì?","options":["cung điện","lối vào","đã chọn","lớn lên"],"answer_index":0,"explanation":"дворца = cung điện"},{"question":"Từ 「девушке」 có nghĩa là gì?","options":["cô gái","lối và