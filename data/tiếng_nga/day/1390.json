 Ngày 1390","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"существенноеを 使います。","line_vi":"Tôi dùng существенное.","focus_words":["существенное"]},{"speaker":"B","line_target":"сэкономить は 何ですか。","line_vi":"сэкономить là cái gì?","focus_words":["сэкономить"]},{"speaker":"A","line_target":"тайныеです。","line_vi":"Đó là тайные.","focus_words":["тайные"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「существенное」 có nghĩa là gì?","options":["thiết yếu","tiết kiệm tiền","bí mật","hiện tại"],"answer_index":0,"explanation":"существенное = thiết yếu"},{"question":"Từ 「сэкономить」 có nghĩa là gì?","options":["tiết kiệm tiền","thiết yếu","bí mật","hiện tại"],"answer_index":0,"explanation":"сэкономить = tiết kiệm tiền"},{"question":"Từ 「тайные」 có nghĩa là gì?","options":["bí mật","thiết yếu","tiết kiệm tiền","hiện tại"],"answer_index":0,"explanation":"тайные = bí mật"},{"question":"Từ 「текущей」 có nghĩa là gì?","options":["hiện tại","thiết yếu","tiết kiệm tiền","bí mật"],"answer_index":0,"explanation":"текущей = hiện tại"},{"question":"Từ 「террорист」 có nghĩa là gì?","options":["khủng bố","thiết yếu","tiết kiệm tiền","bí mật"],"answer_index":0,"explanation":"террорист = khủng bố"},{"question":"Từ 「тигр」 có nghĩa là gì?","options":["hổ","thiết yếu","tiết kiệm tiền","bí mật"],"answer_index":0,"explanation":"тигр = hổ"},{"question":"Từ 「тимур」 có nghĩa là gì?","options":["Timur","thiết yếu","tiết kiệm tiền","bí mật"],"answer_index":0,"explanation":"тимур = Timur"},{"question":"Từ 「томаса」 có nghĩa là gì?","options":["Thomas","thiết yếu","tiết kiệm tiền","bí mật"],"answer_index":0,"explanation":"томаса = Thomas"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: thiết yếu","options":["существенное","сэконо