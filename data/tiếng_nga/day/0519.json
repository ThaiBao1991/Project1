ôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 519","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"отмечаютを 使います。","line_vi":"Tôi dùng отмечают.","focus_words":["отмечают"]},{"speaker":"B","line_target":"первоначально は 何ですか。","line_vi":"первоначально là cái gì?","focus_words":["первоначально"]},{"speaker":"A","line_target":"переводаです。","line_vi":"Đó là перевода.","focus_words":["перевода"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3cee678e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「отмечают」 có nghĩa là gì?","options":["ghi chú","ban đầu","dịch thuật","bánh răng"],"answer_index":0,"explanation":"отмечают = ghi chú"},{"question":"Từ 「первоначально」 có nghĩa là gì?","options":["ban đầu","ghi chú","dịch thuật","bánh răng"],"answer_index":0,"explanation":"первоначально = ban đầu"},{"question":"Từ 「перевода」 có nghĩa là gì?","options":["dịch thuật","ghi chú","ban đầu","bánh răng"],"answer_index":0,"explanation":"перевода = dịch thuật"},{"question":"Từ 「передач」 có nghĩa là gì?","options":["bánh răng","ghi chú","ban đầu","dịch thuật"],"answer_index":0,"explanation":"передач = bánh răng"},{"question":"Từ 「передача」 có nghĩa là gì?","options":["chuyển nhượng","ghi chú","ban đầu","dịch thuật"],"answer_index":0,"explanation":"передача = chuyển nhượng"},{"question":"Từ 「победой」 có nghĩa là gì?","options":["chiến thắng","ghi chú","ban đầu","dịch thuật"],"answer_index":0,"explanation"