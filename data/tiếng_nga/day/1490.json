uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"набережнаяを 使います。","line_vi":"Tôi dùng набережная.","focus_words":["набережная"]},{"speaker":"B","line_target":"навести は 何ですか。","line_vi":"навести là cái gì?","focus_words":["навести"]},{"speaker":"A","line_target":"наглядноです。","line_vi":"Đó là наглядно.","focus_words":["наглядно"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「набережная」 có nghĩa là gì?","options":["bờ kè","chuyến thăm","rõ ràng","tải"],"answer_index":0,"explanation":"набережная = bờ kè"},{"question":"Từ 「навести」 có nghĩa là gì?","options":["chuyến thăm","bờ kè","rõ ràng","tải"],"answer_index":0,"explanation":"навести = chuyến thăm"},{"question":"Từ 「наглядно」 có nghĩa là gì?","options":["rõ ràng","bờ kè","chuyến thăm","tải"],"answer_index":0,"explanation":"наглядно = rõ ràng"},{"question":"Từ 「нагрузку」 có nghĩa là gì?","options":["tải","bờ kè","chuyến thăm","rõ ràng"],"answer_index":0,"explanation":"нагрузку = tải"},{"question":"Từ 「наибольший」 có nghĩa là gì?","options":["vĩ đại nhất","bờ kè","chuyến thăm","rõ ràng"],"answer_index":0,"explanation":"наибольший = vĩ đại nhất"},{"question":"Từ 「напоминать」 có nghĩa là gì?","options":["nhắc nhở","bờ kè","chuyến thăm","rõ ràng"],"answer_index":0,"explanation":"напоминать = nhắc nhở"},{"question":"Từ 「народно」 có nghĩa là gì?","options":["phổ biến","bờ kè","chuyến thăm","rõ ràng"],"answer_index":0,"explanation":"народно = phổ biến"},{"question":"Từ 「народном」 có nghĩa là gì?","options":["dân gian","bờ kè","chuyến thăm","rõ ràng"],"answer_index":0,"explanation":"народном = dân gian"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bờ kè","options":["набережная","навести","наглядно","нагрузку"],"answer_index":0,"explanation":"набере