n":"Đáp án: はずです"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 536","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"стенを 使います。","line_vi":"Tôi dùng стен.","focus_words":["стен"]},{"speaker":"B","line_target":"стиля は 何ですか。","line_vi":"стиля là cái gì?","focus_words":["стиля"]},{"speaker":"A","line_target":"структуруです。","line_vi":"Đó là структуру.","focus_words":["структуру"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d24955b0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「стен」 có nghĩa là gì?","options":["bức tường","phong cách","cấu trúc","bạn có nghĩ không"],"answer_index":0,"explanation":"стен = bức tường"},{"question":"Từ 「стиля」 có nghĩa là gì?","options":["phong cách","bức tường","cấu trúc","bạn có nghĩ không"],"answer_index":0,"explanation":"стиля = phong cách"},{"question":"Từ 「структуру」 có nghĩa là gì?","options":["cấu trúc","bức tường","phong cách","bạn có nghĩ không"],"answer_index":0,"explanation":"структуру = cấu trúc"},{"question":"Từ 「считаете」 có nghĩa là gì?","options":["bạn có nghĩ không","bức tường","phong cách","cấu trúc"],"answer_index":0,"explanation":"считаете = bạn có nghĩ không"},{"question":"Từ 「считая」 có nghĩa là gì?","options":["đếm","bức tường","pho