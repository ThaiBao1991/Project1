 nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 464","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"оставилиを 使います。","line_vi":"Tôi dùng оставили.","focus_words":["оставили"]},{"speaker":"B","line_target":"отдых は 何ですか。","line_vi":"отдых là cái gì?","focus_words":["отдых"]},{"speaker":"A","line_target":"отличаютсяです。","line_vi":"Đó là отличаются.","focus_words":["отличаются"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2eb63f87","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「оставили」 có nghĩa là gì?","options":["trái","nghỉ ngơi","khác nhau","tượng đài"],"answer_index":0,"explanation":"оставили = trái"},{"question":"Từ 「отдых」 có nghĩa là gì?","options":["nghỉ ngơi","trái","khác nhau","tượng đài"],"answer_index":0,"explanation":"отдых = nghỉ ngơi"},{"question":"Từ 「отличаются」 có nghĩa là gì?","options":["khác nhau","trái","nghỉ ngơi","tượng đài"],"answer_index":0,"explanation":"отличаются = khác nhau"},{"question":"Từ 「памятника」 có nghĩa là gì?","options":["tượng đài","trái","nghỉ ngơi","khác nhau"],"answer_index":0,"explanation":"памятника = tượng đài"},{"question":"Từ 「пенсии」 có nghĩa là gì?","options":["lương hưu","trái","nghỉ ngơi","khác nhau"],"answer_index":0,"explanation":"пенсии = lương hưu"},{"question":"Từ 「поддержать」 có nghĩa là gì?","options":["hỗ trợ","trái","nghỉ ngơi","khác nhau"],"answer_index":0,"explanation":"поддержать = hỗ trợ"},{"question":"Từ 「подмосковье」 có nghĩa là gì?