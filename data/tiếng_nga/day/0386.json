idan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 386","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"экономическийを 使います。","line_vi":"Tôi dùng экономический.","focus_words":["экономический"]},{"speaker":"B","line_target":"языков は 何ですか。","line_vi":"языков là cái gì?","focus_words":["языков"]},{"speaker":"A","line_target":"автомобилиです。","line_vi":"Đó là автомобили.","focus_words":["автомобили"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1c7b2259","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「экономический」 có nghĩa là gì?","options":["kinh tế","ngôn ngữ","xe ô tô","bỏ cuộc"],"answer_index":0,"explanation":"экономический = kinh tế"},{"question":"Từ 「языков」 có nghĩa là gì?","options":["ngôn ngữ","kinh tế","xe ô tô","bỏ cuộc"],"answer_index":0,"explanation":"языков = ngôn ngữ"},{"question":"Từ 「автомобили」 có nghĩa là gì?","options":["xe ô tô","kinh tế","ngôn ngữ","bỏ cuộc"],"answer_index":0,"explanation":"автомобили = xe ô tô"},{"question":"Từ 「бросить」 có nghĩa là gì?","options":["bỏ cuộc","kinh tế","ngôn ngữ","xe ô tô"],"answer_index":0,"explanation":"бросить = bỏ cuộc"},{"question":"Từ 「вашингтон」 có nghĩa là gì?","options":["Washington","kinh tế","ngôn ngữ","xe ô tô"],"answer_index":0,"explanation":"вашингтон = Washington"},{"question":"Từ 「взаимодействия」 có nghĩa là gì?","options":["tương tác","kinh tế","ngôn n