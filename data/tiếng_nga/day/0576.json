ện hạt nhân","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e76adeba","audio_ref":"m_3fe114e8","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_73d3c3b1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 576","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"художественногоを 使います。","line_vi":"Tôi dùng художественного.","focus_words":["художественного"]},{"speaker":"B","line_target":"целиком は 何ですか。","line_vi":"целиком là cái gì?","focus_words":["целиком"]},{"speaker":"A","line_target":"черныхです。","line_vi":"Đó là черных.","focus_words":["черных"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bf657bda","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「художественного」 có nghĩa là gì?","options":["nghệ thuật","hoàn toàn","màu đen","màu đen"],"answer_index":0,"explanation":"художественного = nghệ thuật"},{"question":"Từ 「целиком」 có nghĩa là gì?","options":["hoàn toàn","nghệ thuật","màu đen","màu đen"],"answer_index":0,"explanation":"целиком = hoàn toàn"},{"question":"Từ 「черных」 có nghĩa là gì?","options":["màu đen","nghệ thuật","hoàn toàn","bước"],"answer_index":0,"explanation":"черных = màu đen"},{"question":"Từ 「чёрный」 có nghĩa là gì?","options":["màu đen","nghệ thuật","hoàn toàn","bước"],"answer_index":0,"explanation":"чёрный = màu đen"},{"question":"Từ 「шаги」 có nghĩa là gì?","options":["bước","nghệ thuật","hoàn toàn","màu đen"],"answer_index":0,"explanation":"шаги = bước"},{"question":"Từ 「элемент」 có nghĩa là gì?","options":["phần tử","nghệ thuật","hoàn toàn","màu đen"],"answer_index":0,"explanation":"элемент = phần tử"},{"question":"Từ 「эрик」 có nghĩa là gì?","options":["Eric","nghệ thuật","hoàn toàn","màu đen"],"answer_index":0,"explanation":"эрик = Eric"},{"question":"Từ 「активное」 có nghĩa là gì?","options":["hoạt động","nghệ thuật","hoàn toàn","màu đen"],"answer_index":0,"explanation":"активное = hoạt động"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nghệ thuật","options":["художественного","целиком","черных","чёрный"],"answer_index":0,"explanation":"художественного = nghệ thuật"},{"question":"Chọn từ đúng cho nghĩa: hoàn toàn","options":["целиком","художественного","черных","чёрный"],"answer_index":0,"explanation":"целиком = hoàn toàn"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"художественного":"m_74f018fb","целиком":"m_1d0413db","черных":"m_126c286f","чёрный":"m_b35a7283","шаги":"m_2e88c278","элемент":"m_eb5d5b36","эрик":"m_8e60440f","активное":"m_650e89b5","арестовали":"m_e6e5cabb","аэс":"m_3fe114e8"},"dialogue_audio":{"0":"m_bf657bda"}},"media_map":{"m_0f4f8505":"media/tiếng_nga/d0576/word_00_ac886b74.webp","m_121a45a9":"media/tiếng_nga/d0576/word_01_01edc421.webp","m_ced1caf7":"media/tiếng_nga/d0576/word_02_25bca67c.webp","m_932c7ca6":"media/tiếng_nga/d0576/word_03_038906c9.webp","m_dd18751d":"media/tiếng_nga/d0576/word_04_2329ff58.webp","m_a64f4747":"media/tiếng_nga/d0576/word_05_fc26c07d.webp","m_a17fa038":"media/tiếng_nga/d0576/word_06_49b5ff45.webp","m_658af6ba":"media/tiếng_nga/d0576/word_07_39cac17f.webp","m_cd19c517":"media/tiếng_nga/d0576/word_08_dded28a3.webp","m_e76adeba":"media/tiếng_nga/d0576/word_09_153fdf58.webp","m_74f018fb":"media/tiếng_nga/d0576/audio_vocab_00_b8c71bed.mp3","m_e17cf87d":"media/tiếng_nga/d0576/audio_vocab_00_vi_004e1654.mp3","m_1d0413db":"media/tiếng_nga/d0576/audio_vocab_01_a15d10d5.mp3","m_8208a4b7":"media/tiếng_nga/d0576/audio_vocab_01_vi_a15d10d5.mp3","m_126c286f":"media/tiếng_nga/d0576/audio_vocab_02_c8f159cb.mp3","m_2101c4ab":"med