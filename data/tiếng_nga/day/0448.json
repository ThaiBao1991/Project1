.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 448","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"военнымを 使います。","line_vi":"Tôi dùng военным.","focus_words":["военным"]},{"speaker":"B","line_target":"возникла は 何ですか。","line_vi":"возникла là cái gì?","focus_words":["возникла"]},{"speaker":"A","line_target":"вступилです。","line_vi":"Đó là вступил.","focus_words":["вступил"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e91f89cd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「военным」 có nghĩa là gì?","options":["quân sự","nảy sinh","đã nhập","bị ép buộc"],"answer_index":0,"explanation":"военным = quân sự"},{"question":"Từ 「возникла」 có nghĩa là gì?","options":["nảy sinh","quân sự","đã nhập","bị ép buộc"],"answer_index":0,"explanation":"возникла = nảy sinh"},{"question":"Từ 「вступил」 có nghĩa là gì?","options":["đã nhập","quân sự","nảy sinh","bị ép buộc"],"answer_index":0,"explanation":"вступил = đã nhập"},{"question":"Từ 「вынуждены」 có nghĩa là gì?","options":["bị ép buộc","quân sự","nảy sinh","đã nhập"],"answer_index":0,"explanation":"вынуждены = bị ép buộc"},{"question":"Từ 「говорим」 có nghĩa là gì?","options":["chúng tôi nói chuyện","quân sự","nảy sinh","đã nhập"],"answer_index":0,"explanation":"говорим = chúng tôi nói chuyện"},{"question":"Từ 「дальнейшего」 có nghĩa là gì?","options":["hơn nữa","quân sự","nảy sinh","đã nhập"],"answer_index":0,"explanation":"дальнейшего = hơn 