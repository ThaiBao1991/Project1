бной"]},{"speaker":"B","line_target":"рычаг は 何ですか。","line_vi":"рычаг là cái gì?","focus_words":["рычаг"]},{"speaker":"A","line_target":"связьюです。","line_vi":"Đó là связью.","focus_words":["связью"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「рыбной」 có nghĩa là gì?","options":["cá","đòn bẩy","giao tiếp","thay đổi"],"answer_index":0,"explanation":"рыбной = cá"},{"question":"Từ 「рычаг」 có nghĩa là gì?","options":["đòn bẩy","cá","giao tiếp","thay đổi"],"answer_index":0,"explanation":"рычаг = đòn bẩy"},{"question":"Từ 「связью」 có nghĩa là gì?","options":["giao tiếp","cá","đòn bẩy","thay đổi"],"answer_index":0,"explanation":"связью = giao tiếp"},{"question":"Từ 「сдачу」 có nghĩa là gì?","options":["thay đổi","cá","đòn bẩy","giao tiếp"],"answer_index":0,"explanation":"сдачу = thay đổi"},{"question":"Từ 「севернее」 có nghĩa là gì?","options":["phía bắc","cá","đòn bẩy","giao tiếp"],"answer_index":0,"explanation":"севернее = phía bắc"},{"question":"Từ 「северное」 có nghĩa là gì?","options":["phương bắc","cá","đòn bẩy","giao tiếp"],"answer_index":0,"explanation":"северное = phương bắc"},{"question":"Từ 「селения」 có nghĩa là gì?","options":["làng","cá","đòn bẩy","giao tiếp"],"answer_index":0,"explanation":"селения = làng"},{"question":"Từ 「семейным」 có nghĩa là gì?","options":["gia đình","cá","đòn bẩy","giao tiếp"],"answer_index":0,"explanation":"семейным = gia đình"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cá","options":["рыбной","рычаг","связью","сдачу"],"answer_index":0,"explanation":"рыбной = cá"},{"question":"Chọn từ đúng cho nghĩa: đòn bẩy","options":["рычаг","рыбной","связью","сдачу"],"answer_index":0,"explanation":"рычаг = đòn bẩy"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":