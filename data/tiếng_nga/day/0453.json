aning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 453","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"постуを 使います。","line_vi":"Tôi dùng посту.","focus_words":["посту"]},{"speaker":"B","line_target":"пошло は 何ですか。","line_vi":"пошло là cái gì?","focus_words":["пошло"]},{"speaker":"A","line_target":"правойです。","line_vi":"Đó là правой.","focus_words":["правой"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e1dcd9af","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「посту」 có nghĩa là gì?","options":["bài đăng","nó đã biến mất","đúng","đúng"],"answer_index":0,"explanation":"посту = bài đăng"},{"question":"Từ 「пошло」 có nghĩa là gì?","options":["nó đã biến mất","bài đăng","đúng","đúng"],"answer_index":0,"explanation":"пошло = nó đã biến mất"},{"question":"Từ 「правой」 có nghĩa là gì?","options":["đúng","bài đăng","nó đã biến mất","giới hạn"],"answer_index":0,"explanation":"правой = đúng"},{"question":"Từ 「правый」 có nghĩa là gì?","options":["đúng","bài đăng","nó đã biến mất","giới hạn"],"answer_index":0,"explanation":"правый = đúng"},{"question":"Từ 「пределы」 có nghĩa là gì?","options":["giới hạn","bài đăng","nó đã biến mất","đúng"],"answer_index":0,"explanation":"пределы = giới hạn"},{"question":"Từ 「прекрасная」 có nghĩa là gì?","options":["đẹp","bài đăng","nó đã biến mất","đúng"],"answer_index":0,"explanation":"прекрасная = đẹp"},{"question":"Từ 「привел」 có nghĩa là gì?","options":["mang đến","bài đăng","nó đã biến mất","đúng"],"answer_index":0,"explanation":"привел = mang đến"},