_words":["нагрузок"]},{"speaker":"B","line_target":"нажал は 何ですか。","line_vi":"нажал là cái gì?","focus_words":["нажал"]},{"speaker":"A","line_target":"названныеです。","line_vi":"Đó là названные.","focus_words":["названные"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「нагрузок」 có nghĩa là gì?","options":["tải","ép","đặt tên","tên"],"answer_index":0,"explanation":"нагрузок = tải"},{"question":"Từ 「нажал」 có nghĩa là gì?","options":["ép","tải","đặt tên","tên"],"answer_index":0,"explanation":"нажал = ép"},{"question":"Từ 「названные」 có nghĩa là gì?","options":["đặt tên","tải","ép","tên"],"answer_index":0,"explanation":"названные = đặt tên"},{"question":"Từ 「назовите」 có nghĩa là gì?","options":["tên","tải","ép","đặt tên"],"answer_index":0,"explanation":"назовите = tên"},{"question":"Từ 「называемым」 có nghĩa là gì?","options":["được gọi là","tải","ép","đặt tên"],"answer_index":0,"explanation":"называемым = được gọi là"},{"question":"Từ 「налогом」 có nghĩa là gì?","options":["thuế","tải","ép","đặt tên"],"answer_index":0,"explanation":"налогом = thuế"},{"question":"Từ 「наступлении」 có nghĩa là gì?","options":["xúc phạm","tải","ép","đặt tên"],"answer_index":0,"explanation":"наступлении = xúc phạm"},{"question":"Từ 「натуральных」 có nghĩa là gì?","options":["tự nhiên","tải","ép","đặt tên"],"answer_index":0,"explanation":"натуральных = tự nhiên"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tải","options":["нагрузок","нажал","названные","назовите"],"answer_index":0,"explanation":"нагрузок = tải"},{"question":"Chọn từ đúng cho nghĩa: ép","options":["нажал","нагрузок","названные","назовите"],"answer_index":0,"explanation":"нажал = ép"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}