":"N5","turns":[{"speaker":"A","line_target":"темойを 使います。","line_vi":"Tôi dùng темой.","focus_words":["темой"]},{"speaker":"B","line_target":"темп は 何ですか。","line_vi":"темп là cái gì?","focus_words":["темп"]},{"speaker":"A","line_target":"техническиです。","line_vi":"Đó là технически.","focus_words":["технически"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「темой」 có nghĩa là gì?","options":["chủ đề","nhịp độ","về mặt kỹ thuật","loại"],"answer_index":0,"explanation":"темой = chủ đề"},{"question":"Từ 「темп」 có nghĩa là gì?","options":["nhịp độ","chủ đề","về mặt kỹ thuật","loại"],"answer_index":0,"explanation":"темп = nhịp độ"},{"question":"Từ 「технически」 có nghĩa là gì?","options":["về mặt kỹ thuật","chủ đề","nhịp độ","loại"],"answer_index":0,"explanation":"технически = về mặt kỹ thuật"},{"question":"Từ 「типу」 có nghĩa là gì?","options":["loại","chủ đề","nhịp độ","về mặt kỹ thuật"],"answer_index":0,"explanation":"типу = loại"},{"question":"Từ 「тканей」 có nghĩa là gì?","options":["vải","chủ đề","nhịp độ","về mặt kỹ thuật"],"answer_index":0,"explanation":"тканей = vải"},{"question":"Từ 「томск」 có nghĩa là gì?","options":["Tomsk","chủ đề","nhịp độ","về mặt kỹ thuật"],"answer_index":0,"explanation":"томск = Tomsk"},{"question":"Từ 「торговлю」 có nghĩa là gì?","options":["buôn bán","chủ đề","nhịp độ","về mặt kỹ thuật"],"answer_index":0,"explanation":"торговлю = buôn bán"},{"question":"Từ 「уважением」 có nghĩa là gì?","options":["tôn trọng","chủ đề","nhịp độ","về mặt kỹ thuật"],"answer_index":0,"explanation":"уважением = tôn trọng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chủ đề","options":["темой","темп","технически","типу"],"answer_index":0,"explanation":"темой = chủ đề"},{"question":"Chọn từ đúng cho nghĩa: nhịp độ","options":["темп","темой","техниче