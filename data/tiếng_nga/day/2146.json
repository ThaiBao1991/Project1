 Ngày 2146","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"противникуを 使います。","line_vi":"Tôi dùng противнику.","focus_words":["противнику"]},{"speaker":"B","line_target":"противодействие は 何ですか。","line_vi":"противодействие là cái gì?","focus_words":["противодействие"]},{"speaker":"A","line_target":"пустымです。","line_vi":"Đó là пустым.","focus_words":["пустым"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「противнику」 có nghĩa là gì?","options":["đến kẻ thù","sự phản đối","trống rỗng","đốm"],"answer_index":0,"explanation":"противнику = đến kẻ thù"},{"question":"Từ 「противодействие」 có nghĩa là gì?","options":["sự phản đối","đến kẻ thù","trống rỗng","đốm"],"answer_index":0,"explanation":"противодействие = sự phản đối"},{"question":"Từ 「пустым」 có nghĩa là gì?","options":["trống rỗng","đến kẻ thù","sự phản đối","đốm"],"answer_index":0,"explanation":"пустым = trống rỗng"},{"question":"Từ 「пятен」 có nghĩa là gì?","options":["đốm","đến kẻ thù","sự phản đối","trống rỗng"],"answer_index":0,"explanation":"пятен = đốm"},{"question":"Từ 「пятую」 có nghĩa là gì?","options":["thứ năm","đến kẻ thù","sự phản đối","trống rỗng"],"answer_index":0,"explanation":"пятую = thứ năm"},{"question":"Từ 「равным」 có nghĩa là gì?","options":["bằng nhau","đến kẻ thù","sự phản đối","trống rỗng"],"answer_index":0,"explanation":"равным = bằng nhau"},{"question":"Từ 「разбиты」 có nghĩa là gì?","options":["bị hỏng","đến kẻ thù","sự phản đối","trống rỗng"],"answer_index":0,"explanation":"разбиты = bị hỏng"},{"question":"Từ 「разворачивается」 có nghĩa là gì?","options":["mở ra","đến kẻ thù","sự phản đối","trống rỗng"],"answer_index":0,"explanation":"разворачивается = mở ra"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đến kẻ t