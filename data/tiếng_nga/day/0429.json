n","explanation":"thảo luận","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1fb0797e","audio_ref":"m_025e91a9","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_c4aa280b"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 429","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"молодаяを 使います。","line_vi":"Tôi dùng молодая.","focus_words":["молодая"]},{"speaker":"B","line_target":"награды は 何ですか。","line_vi":"награды là cái gì?","focus_words":["награды"]},{"speaker":"A","line_target":"нападениеです。","line_vi":"Đó là нападение.","focus_words":["нападение"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c07ca2bc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「молодая」 có nghĩa là gì?","options":["trẻ","giải thưởng","tấn công","bằng cách này"],"answer_index":0,"explanation":"молодая = trẻ"},{"question":"Từ 「награды」 có nghĩa là gì?","options":["giải thưởng","trẻ","tấn công","bằng cách này"],"answer_index":0,"explanation":"награды = giải thưởng"},{"question":"Từ 「нападение」 có nghĩa là gì?","options":["tấn công","trẻ","giải thưởng","bằng cách này"],"answer_index":0,"explanation":"нападение = tấn công"},{"question":"Từ 「настоящим」 có nghĩa là gì?","options":["bằng cách này","trẻ","giải thưởng","tấn công"],"answer_index":0,"explanation":"настоящим = bằng cách này"},{"question":"Từ 「нижнем」 có nghĩa là gì?","options":["thấp hơn","trẻ","giải thưởng","tấn công"],"answer_index":0,"explanation":"нижнем = thấp hơn"},{"question":"Từ 「нижний」 có nghĩa là gì?","options":["thấp hơn","trẻ","giải thưởng","tấn công"],"answer_index":0,"explanati