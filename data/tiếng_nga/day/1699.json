ивали"]},{"speaker":"B","line_target":"убийствах は 何ですか。","line_vi":"убийствах là cái gì?","focus_words":["убийствах"]},{"speaker":"A","line_target":"увлечениеです。","line_vi":"Đó là увлечение.","focus_words":["увлечение"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「убивали」 có nghĩa là gì?","options":["bị giết","vụ giết người","sở thích","mối đe dọa"],"answer_index":0,"explanation":"убивали = bị giết"},{"question":"Từ 「убийствах」 có nghĩa là gì?","options":["vụ giết người","bị giết","sở thích","mối đe dọa"],"answer_index":0,"explanation":"убийствах = vụ giết người"},{"question":"Từ 「увлечение」 có nghĩa là gì?","options":["sở thích","bị giết","vụ giết người","mối đe dọa"],"answer_index":0,"explanation":"увлечение = sở thích"},{"question":"Từ 「угроз」 có nghĩa là gì?","options":["mối đe dọa","bị giết","vụ giết người","sở thích"],"answer_index":0,"explanation":"угроз = mối đe dọa"},{"question":"Từ 「ужасные」 có nghĩa là gì?","options":["khủng khiếp","bị giết","vụ giết người","sở thích"],"answer_index":0,"explanation":"ужасные = khủng khiếp"},{"question":"Từ 「узлы」 có nghĩa là gì?","options":["nút","bị giết","vụ giết người","sở thích"],"answer_index":0,"explanation":"узлы = nút"},{"question":"Từ 「уик」 có nghĩa là gì?","options":["tuần","bị giết","vụ giết người","sở thích"],"answer_index":0,"explanation":"уик = tuần"},{"question":"Từ 「украинскими」 có nghĩa là gì?","options":["tiếng Ukraina","bị giết","vụ giết người","sở thích"],"answer_index":0,"explanation":"украинскими = tiếng Ukraina"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bị giết","options":["убивали","убийствах","увлечение","угроз"],"answer_index":0,"explanation":"убивали = bị giết"},{"question":"Chọn từ đúng cho nghĩa: vụ giết người","options":["убийствах","убивали","увлечение","угроз"],"answ