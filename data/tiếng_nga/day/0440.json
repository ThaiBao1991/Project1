ốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 440","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"крупногоを 使います。","line_vi":"Tôi dùng крупного.","focus_words":["крупного"]},{"speaker":"B","line_target":"лига は 何ですか。","line_vi":"лига là cái gì?","focus_words":["лига"]},{"speaker":"A","line_target":"малыхです。","line_vi":"Đó là малых.","focus_words":["малых"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ff12ee76","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「крупного」 có nghĩa là gì?","options":["lớn","giải đấu","nhỏ bé","y tế"],"answer_index":0,"explanation":"крупного = lớn"},{"question":"Từ 「лига」 có nghĩa là gì?","options":["giải đấu","lớn","nhỏ bé","y tế"],"answer_index":0,"explanation":"лига = giải đấu"},{"question":"Từ 「малых」 có nghĩa là gì?","options":["nhỏ bé","lớn","giải đấu","y tế"],"answer_index":0,"explanation":"малых = nhỏ bé"},{"question":"Từ 「медицинских」 có nghĩa là gì?","options":["y tế","lớn","giải đấu","nhỏ bé"],"answer_index":0,"explanation":"медицинских = y tế"},{"question":"Từ 「морского」 có nghĩa là gì?","options":["biển","lớn","giải đấu","nhỏ bé"],"answer_index":0,"explanation":"морского = biển"},{"question":"Từ 「московская」 có nghĩa là gì?","options":["Mátxcơva","lớn","giải đấu","nhỏ bé"],"answer_index":0,"explanation":"московская = Mátxcơva"},{"question":"Từ 「набрал」 có nghĩa là gì?","options":["đã q