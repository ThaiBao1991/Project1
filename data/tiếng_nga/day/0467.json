u trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 467","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"родителямを 使います。","line_vi":"Tôi dùng родителям.","focus_words":["родителям"]},{"speaker":"B","line_target":"русскому は 何ですか。","line_vi":"русскому là cái gì?","focus_words":["русскому"]},{"speaker":"A","line_target":"садуです。","line_vi":"Đó là саду.","focus_words":["саду"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_36270577","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「родителям」 có nghĩa là gì?","options":["bố mẹ","tiếng Nga","vườn","bạc"],"answer_index":0,"explanation":"родителям = bố mẹ"},{"question":"Từ 「русскому」 có nghĩa là gì?","options":["tiếng Nga","bố mẹ","vườn","bạc"],"answer_index":0,"explanation":"русскому = tiếng Nga"},{"question":"Từ 「саду」 có nghĩa là gì?","options":["vườn","bố mẹ","tiếng Nga","bạc"],"answer_index":0,"explanation":"саду = vườn"},{"question":"Từ 「серебро」 có nghĩa là gì?","options":["bạc","bố mẹ","tiếng Nga","vườn"],"answer_index":0,"explanation":"серебро = bạc"},{"question":"Từ 「символ」 có nghĩa là gì?","options":["biểu tượng","bố mẹ","tiếng Nga","vườn"],"answer_index":0,"explanation":"символ = biểu tượng"},{"question":"Từ 「смотришь」 có nghĩa là gì?","options":["nhìn","bố mẹ","tiếng Nga","vườn"],"answer_index":0,"explanation":"смотришь = nhìn"},{"question":"Từ 「снижения」 có nghĩa là gì?","options":["giảm bớt","bố mẹ","tiếng Nga","vườn"],"answer_index":0,"expla