ательно」 có nghĩa là gì?","options":["đáng chú ý","thiết thực","sơ bộ","điều kiện tiên quyết"],"answer_index":0,"explanation":"примечательно = đáng chú ý"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: thiết thực","options":["практическая","предварительные","предпосылки","предыдущий"],"answer_index":0,"explanation":"практическая = thiết thực"},{"question":"Chọn từ đúng cho nghĩa: sơ bộ","options":["предварительные","практическая","предпосылки","предыдущий"],"answer_index":0,"explanation":"предварительные = sơ bộ"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}