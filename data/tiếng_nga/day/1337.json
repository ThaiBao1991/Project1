_words":["штурма"]},{"speaker":"B","line_target":"электрический は 何ですか。","line_vi":"электрический là cái gì?","focus_words":["электрический"]},{"speaker":"A","line_target":"эффективногоです。","line_vi":"Đó là эффективного.","focus_words":["эффективного"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「штурма」 có nghĩa là gì?","options":["tấn công","điện","hiệu quả","cái hố"],"answer_index":0,"explanation":"штурма = tấn công"},{"question":"Từ 「электрический」 có nghĩa là gì?","options":["điện","tấn công","hiệu quả","cái hố"],"answer_index":0,"explanation":"электрический = điện"},{"question":"Từ 「эффективного」 có nghĩa là gì?","options":["hiệu quả","tấn công","điện","cái hố"],"answer_index":0,"explanation":"эффективного = hiệu quả"},{"question":"Từ 「яму」 có nghĩa là gì?","options":["cái hố","tấn công","điện","hiệu quả"],"answer_index":0,"explanation":"яму = cái hố"},{"question":"Từ 「ярмарка」 có nghĩa là gì?","options":["công bằng","tấn công","điện","hiệu quả"],"answer_index":0,"explanation":"ярмарка = công bằng"},{"question":"Từ 「edition」 có nghĩa là gì?","options":["ấn bản","tấn công","điện","hiệu quả"],"answer_index":0,"explanation":"edition = ấn bản"},{"question":"Từ 「rus」 có nghĩa là gì?","options":["Nga","tấn công","điện","hiệu quả"],"answer_index":0,"explanation":"rus = Nga"},{"question":"Từ 「австрия」 có nghĩa là gì?","options":["Áo","tấn công","điện","hiệu quả"],"answer_index":0,"explanation":"австрия = Áo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tấn công","options":["штурма","электрический","эффективного","яму"],"answer_index":0,"explanation":"штурма = tấn công"},{"question":"Chọn từ đúng cho nghĩa: điện","options":["электрический","штурма","эффективного","яму"],"answer_index":0,"explanation":"электрический = điện"}],"common":[],"grammar":[],