 tệ"},{"question":"Từ 「вариации」 có nghĩa là gì?","options":["biến thể","đi ngang","tiếng Bungari","người Bolshevik"],"answer_index":0,"explanation":"вариации = biến thể"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đi ngang","options":["боком","болгарского","большевики","бригаде"],"answer_index":0,"explanation":"боком = đi ngang"},{"question":"Chọn từ đúng cho nghĩa: tiếng Bungari","options":["болгарского","боком","большевики","бригаде"],"answer_index":0,"explanation":"болгарского = tiếng Bungari"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}