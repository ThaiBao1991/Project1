ó đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 491","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"умеюを 使います。","line_vi":"Tôi dùng умею.","focus_words":["умею"]},{"speaker":"B","line_target":"урожай は 何ですか。","line_vi":"урожай là cái gì?","focus_words":["урожай"]},{"speaker":"A","line_target":"училсяです。","line_vi":"Đó là учился.","focus_words":["учился"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fe16822b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「умею」 có nghĩa là gì?","options":["tôi có thể","thu hoạch","đã học","ngôi đền"],"answer_index":0,"explanation":"умею = tôi có thể"},{"question":"Từ 「урожай」 có nghĩa là gì?","options":["thu hoạch","tôi có thể","đã học","ngôi đền"],"answer_index":0,"explanation":"урожай = thu hoạch"},{"question":"Từ 「учился」 có nghĩa là gì?","options":["đã học","tôi có thể","thu hoạch","ngôi đền"],"answer_index":0,"explanation":"учился = đã học"},{"question":"Từ 「храма」 có nghĩa là gì?","options":["ngôi đền","tôi có thể","thu hoạch","đã học"],"answer_index":0,"explanation":"храма = ngôi đền"},{"question":"Từ 「человеческого」 có nghĩa là gì?","options":["con người","tôi có thể","thu hoạch","đã học"],"answer_index":0,"explanation":"человеческого = con người"},{"question":"Từ 「чьи」 có nghĩa là gì?","options":["của ai","tôi có thể","thu hoạch","đã học"],"answer_index":0,"explanation":"чьи = của ai"},{"question":"Từ 「шутка」 có nghĩa là gì?","options":["trò đùa","tôi có