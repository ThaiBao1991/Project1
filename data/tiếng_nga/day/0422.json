":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 422","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"судноを 使います。","line_vi":"Tôi dùng судно.","focus_words":["судно"]},{"speaker":"B","line_target":"сферы は 何ですか。","line_vi":"сферы là cái gì?","focus_words":["сферы"]},{"speaker":"A","line_target":"такомуです。","line_vi":"Đó là такому.","focus_words":["такому"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2e258ae9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「судно」 có nghĩa là gì?","options":["tàu","quả cầu","như vậy","nhiệt độ"],"answer_index":0,"explanation":"судно = tàu"},{"question":"Từ 「сферы」 có nghĩa là gì?","options":["quả cầu","tàu","như vậy","nhiệt độ"],"answer_index":0,"explanation":"сферы = quả cầu"},{"question":"Từ 「такому」 có nghĩa là gì?","options":["như vậy","tàu","quả cầu","nhiệt độ"],"answer_index":0,"explanation":"такому = như vậy"},{"question":"Từ 「температуры」 có nghĩa là gì?","options":["nhiệt độ","tàu","quả cầu","như vậy"],"answer_index":0,"explanation":"температуры = nhiệt độ"},{"question":"Từ 「тени」 có nghĩa là gì?","options":["bóng tối","tàu","quả cầu","như vậy"],"answer_index":0,"explanation":"тени = bóng tối"},{"question":"Từ 「технология」 có nghĩa là gì?","options":["công nghệ","tàu","quả cầu","như vậy"],"answer_index":0,"explanation":"технология = công nghệ"},{"question":"Từ 「трудового」 có nghĩa là gì?","options":["lao động","tàu","quả cầu","như vậy"],"answer_index":0,"explanation":"трудового = lao động"},{"question":"Từ 「трудом」 có nghĩa là gì?",