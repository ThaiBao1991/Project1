 thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 457","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"точекを 使います。","line_vi":"Tôi dùng точек.","focus_words":["точек"]},{"speaker":"B","line_target":"тратить は 何ですか。","line_vi":"тратить là cái gì?","focus_words":["тратить"]},{"speaker":"A","line_target":"убиватьです。","line_vi":"Đó là убивать.","focus_words":["убивать"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7f0f6770","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「точек」 có nghĩa là gì?","options":["điểm","chi tiêu","giết","sinh viên"],"answer_index":0,"explanation":"точек = điểm"},{"question":"Từ 「тратить」 có nghĩa là gì?","options":["chi tiêu","điểm","giết","sinh viên"],"answer_index":0,"explanation":"тратить = chi tiêu"},{"question":"Từ 「убивать」 có nghĩa là gì?","options":["giết","điểm","chi tiêu","sinh viên"],"answer_index":0,"explanation":"убивать = giết"},{"question":"Từ 「учеников」 có nghĩa là gì?","options":["sinh viên","điểm","chi tiêu","giết"],"answer_index":0,"explanation":"учеников = sinh viên"},{"question":"Từ 「учета」 có nghĩa là gì?","options":["kế toán","điểm","chi tiêu","giết"],"answer_index":0,"explanation":"учета = kế toán"},{"question":"Từ 「ушёл」 có nghĩa là gì?","options":["trái","điểm","chi tiêu","giết"],"answer_index":0,"explanation":"ушёл = trái"},{"question":"Từ 「ходят」 có nghĩa là gì?","options":["đi bộ","điểm","chi tiêu","giết"],"answer_index":0,"explanation":"ходят = đi bộ"},{"question":"Từ 「христа」 có nghĩa là gì?","options":["Chúa Kitô","điểm","chi tiêu","giết"],"answer_inde