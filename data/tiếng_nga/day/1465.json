: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1465","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"нормамを 使います。","line_vi":"Tôi dùng нормам.","focus_words":["нормам"]},{"speaker":"B","line_target":"общин は 何ですか。","line_vi":"общин là cái gì?","focus_words":["общин"]},{"speaker":"A","line_target":"определенноеです。","line_vi":"Đó là определенное.","focus_words":["определенное"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「нормам」 có nghĩa là gì?","options":["tiêu chuẩn","cộng đồng","nhất định","người sáng lập"],"answer_index":0,"explanation":"нормам = tiêu chuẩn"},{"question":"Từ 「общин」 có nghĩa là gì?","options":["cộng đồng","tiêu chuẩn","nhất định","người sáng lập"],"answer_index":0,"explanation":"общин = cộng đồng"},{"question":"Từ 「определенное」 có nghĩa là gì?","options":["nhất định","tiêu chuẩn","cộng đồng","người sáng lập"],"answer_index":0,"explanation":"определенное = nhất định"},{"question":"Từ 「основателя」 có nghĩa là gì?","options":["người sáng lập","tiêu chuẩn","cộng đồng","nhất định"],"answer_index":0,"explanation":"основателя = người sáng lập"},{"question":"Từ 「отвести」 có nghĩa là gì?","options":["mang đi","tiêu chuẩn","cộng đồng","nhất định"],"answer_index":0,"explanation":"отвести = mang đi"},{"question":"Từ 「ответный」 có nghĩa là gì?","options":["tương hỗ","tiêu chuẩn","cộng đồng","nhất định"],"answer_index":0,"explanation":"ответный = tương hỗ"},{"question":"Từ 「отказе」 có nghĩa là gì?","options":["từ chối","tiêu chuẩn","cộng đồng","nhất định"],"answer_index":0,"explanation":"отказе = từ chối"},{"question":"Từ 「открытыми」 có nghĩa là gì?","options":["mở","tiêu chuẩn","cộng đồng","nhất định"],"answer_index":0,"explanation":"открытыми = mở"}],"pat