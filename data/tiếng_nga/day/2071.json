ation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"употребленииを 使います。","line_vi":"Tôi dùng употреблении.","focus_words":["употреблении"]},{"speaker":"B","line_target":"установленном は 何ですか。","line_vi":"установленном là cái gì?","focus_words":["установленном"]},{"speaker":"A","line_target":"ухудшениеです。","line_vi":"Đó là ухудшение.","focus_words":["ухудшение"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「употреблении」 có nghĩa là gì?","options":["sử dụng","thành lập","sự xuống cấp","tham gia"],"answer_index":0,"explanation":"употреблении = sử dụng"},{"question":"Từ 「установленном」 có nghĩa là gì?","options":["thành lập","sử dụng","sự xuống cấp","tham gia"],"answer_index":0,"explanation":"установленном = thành lập"},{"question":"Từ 「ухудшение」 có nghĩa là gì?","options":["sự xuống cấp","sử dụng","thành lập","tham gia"],"answer_index":0,"explanation":"ухудшение = sự xuống cấp"},{"question":"Từ 「участвующих」 có nghĩa là gì?","options":["tham gia","sử dụng","thành lập","sự xuống cấp"],"answer_index":0,"explanation":"участвующих = tham gia"},{"question":"Từ 「учениях」 có nghĩa là gì?","options":["bài tập","sử dụng","thành lập","sự xuống cấp"],"answer_index":0,"explanation":"учениях = bài tập"},{"question":"Từ 「учитывает」 có nghĩa là gì?","options":["tính đến","sử dụng","thành lập","sự xuống cấp"],"answer_index":0,"explanation":"учитывает = tính đến"},{"question":"Từ 「факто」 có nghĩa là gì?","options":["sự thật","sử dụng","thành lập","sự xuống cấp"],"answer_index":0,"explanation":"факто = sự thật"},{"question":"Từ 「физическими」 có nghĩa là gì?","options":["thể chất","sử dụng","thành lập","sự xuống cấp"],"answer_index":0,"explanation":"физическими = thể chất"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa