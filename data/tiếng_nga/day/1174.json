ogue":[{"title":"Trung cấp công việc — Ngày 1174","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"продолжалосьを 使います。","line_vi":"Tôi dùng продолжалось.","focus_words":["продолжалось"]},{"speaker":"B","line_target":"проезда は 何ですか。","line_vi":"проезда là cái gì?","focus_words":["проезда"]},{"speaker":"A","line_target":"промышленныеです。","line_vi":"Đó là промышленные.","focus_words":["промышленные"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「продолжалось」 có nghĩa là gì?","options":["tiếp tục","du lịch","công nghiệp","cuộc biểu tình"],"answer_index":0,"explanation":"продолжалось = tiếp tục"},{"question":"Từ 「проезда」 có nghĩa là gì?","options":["du lịch","tiếp tục","công nghiệp","cuộc biểu tình"],"answer_index":0,"explanation":"проезда = du lịch"},{"question":"Từ 「промышленные」 có nghĩa là gì?","options":["công nghiệp","tiếp tục","du lịch","cuộc biểu tình"],"answer_index":0,"explanation":"промышленные = công nghiệp"},{"question":"Từ 「протесты」 có nghĩa là gì?","options":["cuộc biểu tình","tiếp tục","du lịch","công nghiệp"],"answer_index":0,"explanation":"протесты = cuộc biểu tình"},{"question":"Từ 「прощание」 có nghĩa là gì?","options":["tạm biệt","tiếp tục","du lịch","công nghiệp"],"answer_index":0,"explanation":"прощание = tạm biệt"},{"question":"Từ 「пустить」 có nghĩa là gì?","options":["cho vào","tiếp tục","du lịch","công nghiệp"],"answer_index":0,"explanation":"пустить = cho vào"},{"question":"Từ 「пьет」 có nghĩa là gì?","options":["đồ uống","tiếp tục","du lịch","công nghiệp"],"answer_index":0,"explanation":"пьет = đồ uống"},{"question":"Từ 「различного」 có nghĩa là gì?","options":["khác nhau","tiếp tục","du lịch","công nghiệp"],"answer_index":0,"explanation":"различного = khác nhau"}],"pat