ân","options":["фермер","учете","финского","фотографией"],"answer_index":0,"explanation":"фермер = nông dân"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}