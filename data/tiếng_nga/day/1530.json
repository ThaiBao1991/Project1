ấp công việc — Ngày 1530","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"профессионаловを 使います。","line_vi":"Tôi dùng профессионалов.","focus_words":["профессионалов"]},{"speaker":"B","line_target":"пустых は 何ですか。","line_vi":"пустых là cái gì?","focus_words":["пустых"]},{"speaker":"A","line_target":"работаешьです。","line_vi":"Đó là работаешь.","focus_words":["работаешь"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「профессионалов」 có nghĩa là gì?","options":["chuyên gia","trống rỗng","bạn đang làm việc","đang làm việc"],"answer_index":0,"explanation":"профессионалов = chuyên gia"},{"question":"Từ 「пустых」 có nghĩa là gì?","options":["trống rỗng","chuyên gia","bạn đang làm việc","đang làm việc"],"answer_index":0,"explanation":"пустых = trống rỗng"},{"question":"Từ 「работаешь」 có nghĩa là gì?","options":["bạn đang làm việc","chuyên gia","trống rỗng","đang làm việc"],"answer_index":0,"explanation":"работаешь = bạn đang làm việc"},{"question":"Từ 「работающие」 có nghĩa là gì?","options":["đang làm việc","chuyên gia","trống rỗng","bạn đang làm việc"],"answer_index":0,"explanation":"работающие = đang làm việc"},{"question":"Từ 「разговаривали」 có nghĩa là gì?","options":["nói chuyện","chuyên gia","trống rỗng","bạn đang làm việc"],"answer_index":0,"explanation":"разговаривали = nói chuyện"},{"question":"Từ 「разрабатывает」 có nghĩa là gì?","options":["phát triển","chuyên gia","trống rỗng","bạn đang làm việc"],"answer_index":0,"explanation":"разрабатывает = phát triển"},{"question":"Từ 「районной」 có nghĩa là gì?","options":["huyện","chuyên gia","trống rỗng","bạn đang làm việc"],"answer_index":0,"explanation":"районной = huyện"},{"question":"Từ 「раннее」 có nghĩa là gì?","options":["sớm","chuyên gia","trống