ư thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 512","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"терминを 使います。","line_vi":"Tôi dùng термин.","focus_words":["термин"]},{"speaker":"B","line_target":"ткани は 何ですか。","line_vi":"ткани là cái gì?","focus_words":["ткани"]},{"speaker":"A","line_target":"томаです。","line_vi":"Đó là тома.","focus_words":["тома"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_05f8dbe4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「термин」 có nghĩa là gì?","options":["kỳ hạn","vải","tập","điện thoại"],"answer_index":0,"explanation":"термин = kỳ hạn"},{"question":"Từ 「ткани」 có nghĩa là gì?","options":["vải","kỳ hạn","tập","điện thoại"],"answer_index":0,"explanation":"ткани = vải"},{"question":"Từ 「тома」 có nghĩa là gì?","options":["tập","kỳ hạn","vải","điện thoại"],"answer_index":0,"explanation":"тома = tập"},{"question":"Từ 「трубку」 có nghĩa là gì?","options":["điện thoại","kỳ hạn","vải","tập"],"answer_index":0,"explanation":"трубку = điện thoại"},{"question":"Từ 「туре」 có nghĩa là gì?","options":["chuyến tham quan","kỳ hạn","vải","tập"],"answer_index":0,"explanation":"туре = chuyến tham quan"},{"question":"Từ 「условии」 có nghĩa là gì?","options":["điều kiện","kỳ hạn","vải","tập"],"answer_index":0,"explanation":"условии = điều kiện"},{"question":"Từ 「устала」 có nghĩa là gì?","options":["mệt mỏi","kỳ hạn","vải","tập"],"answer_index":0,"explanation":"устала = mệt mỏi"},{"question":"Từ 「февраль」 có nghĩa