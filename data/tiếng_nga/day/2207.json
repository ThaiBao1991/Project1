ên minh"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: trả lại","options":["возвратился","возможностях","волшебной","воскресение"],"answer_index":0,"explanation":"возвратился = trả lại"},{"question":"Chọn từ đúng cho nghĩa: khả năng","options":["возможностях","возвратился","волшебной","воскресение"],"answer_index":0,"explanation":"возможностях = khả năng"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}