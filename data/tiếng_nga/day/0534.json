anation":"Đáp án: はずです"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 534","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"реальныхを 使います。","line_vi":"Tôi dùng реальных.","focus_words":["реальных"]},{"speaker":"B","line_target":"режиссер は 何ですか。","line_vi":"режиссер là cái gì?","focus_words":["режиссер"]},{"speaker":"A","line_target":"российскимです。","line_vi":"Đó là российским.","focus_words":["российским"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fa2363fe","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「реальных」 có nghĩa là gì?","options":["thực","giám đốc","tiếng Nga","hãy làm điều đó"],"answer_index":0,"explanation":"реальных = thực"},{"question":"Từ 「режиссер」 có nghĩa là gì?","options":["giám đốc","thực","tiếng Nga","hãy làm điều đó"],"answer_index":0,"explanation":"режиссер = giám đốc"},{"question":"Từ 「российским」 có nghĩa là gì?","options":["tiếng Nga","thực","giám đốc","hãy làm điều đó"],"answer_index":0,"explanation":"российским = tiếng Nga"},{"question":"Từ 「сделаем」 có nghĩa là gì?","options":["hãy làm điều đó","thực","giám đốc","tiếng Nga"],"answer_index":0,"explanation":"сделаем = hãy làm điều đó"},{"question":"Từ 「сектор」 có nghĩa là gì?","options":["lĩnh vực","thực",