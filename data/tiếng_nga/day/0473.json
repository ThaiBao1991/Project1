":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 473","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"корреспондентを 使います。","line_vi":"Tôi dùng корреспондент.","focus_words":["корреспондент"]},{"speaker":"B","line_target":"кровью は 何ですか。","line_vi":"кровью là cái gì?","focus_words":["кровью"]},{"speaker":"A","line_target":"маленькойです。","line_vi":"Đó là маленькой.","focus_words":["маленькой"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_83759bee","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「корреспондент」 có nghĩa là gì?","options":["phóng viên","máu","nhỏ bé","mẹ"],"answer_index":0,"explanation":"корреспондент = phóng viên"},{"question":"Từ 「кровью」 có nghĩa là gì?","options":["máu","phóng viên","nhỏ bé","mẹ"],"answer_index":0,"explanation":"кровью = máu"},{"question":"Từ 「маленькой」 có nghĩa là gì?","options":["nhỏ bé","phóng viên","máu","mẹ"],"answer_index":0,"explanation":"маленькой = nhỏ bé"},{"question":"Từ 「маму」 có nghĩa là gì?","options":["mẹ","phóng viên","máu","nhỏ bé"],"answer_index":0,"explanation":"маму = mẹ"},{"question":"Từ 「массы」 có nghĩa là gì?","options":["quần chúng","phóng viên","máu","nhỏ bé"],"answer_index":0,"explanation":"массы = quần chúng"},{"question":"Từ 「надолго」 có nghĩa là gì?","options":["trong một thời gian dài","phó