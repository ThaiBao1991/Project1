, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 599","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"пройдутを 使います。","line_vi":"Tôi dùng пройдут.","focus_words":["пройдут"]},{"speaker":"B","line_target":"пропаганды は 何ですか。","line_vi":"пропаганды là cái gì?","focus_words":["пропаганды"]},{"speaker":"A","line_target":"пропуститьです。","line_vi":"Đó là пропустить.","focus_words":["пропустить"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_89183c59","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「пройдут」 có nghĩa là gì?","options":["sẽ vượt qua","tuyên truyền","bỏ qua","trực tiếp"],"answer_index":0,"explanation":"пройдут = sẽ vượt qua"},{"question":"Từ 「пропаганды」 có nghĩa là gì?","options":["tuyên truyền","sẽ vượt qua","bỏ qua","trực tiếp"],"answer_index":0,"explanation":"пропаганды = tuyên truyền"},{"question":"Từ 「пропустить」 có nghĩa là gì?","options":["bỏ qua","sẽ vượt qua","tuyên truyền","trực tiếp"],"answer_index":0,"explanation":"пропустить = bỏ qua"},{"question":"Từ 「прямом」 có nghĩa là gì?","options":["trực tiếp","sẽ vượt qua","tuyên truyền","bỏ qua"],"answer_index":0,"explanation":"прямом = trực tiếp"},{"question":"Từ 「прямые」 có nghĩa là gì?","options":["thẳng","sẽ vượt qua","tuyên truyền","bỏ qua"],"answer_index":0,"explanation":"прямые = thẳng"},{"question":"Từ 「расположен」 có nghĩa là gì?","options":["nằm","sẽ vượt qua","tuyên truyền","bỏ