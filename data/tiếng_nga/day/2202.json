ười bản xứ — Ngày 2202","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"эмбаргоを 使います。","line_vi":"Tôi dùng эмбарго.","focus_words":["эмбарго"]},{"speaker":"B","line_target":"эмми は 何ですか。","line_vi":"эмми là cái gì?","focus_words":["эмми"]},{"speaker":"A","line_target":"энергетическаяです。","line_vi":"Đó là энергетическая.","focus_words":["энергетическая"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「эмбарго」 có nghĩa là gì?","options":["lệnh cấm vận","em yêu","năng lượng","công bằng"],"answer_index":0,"explanation":"эмбарго = lệnh cấm vận"},{"question":"Từ 「эмми」 có nghĩa là gì?","options":["em yêu","lệnh cấm vận","năng lượng","công bằng"],"answer_index":0,"explanation":"эмми = em yêu"},{"question":"Từ 「энергетическая」 có nghĩa là gì?","options":["năng lượng","lệnh cấm vận","em yêu","công bằng"],"answer_index":0,"explanation":"энергетическая = năng lượng"},{"question":"Từ 「ярмарке」 có nghĩa là gì?","options":["công bằng","lệnh cấm vận","em yêu","năng lượng"],"answer_index":0,"explanation":"ярмарке = công bằng"},{"question":"Từ 「amazon」 có nghĩa là gì?","options":["amazon","lệnh cấm vận","em yêu","năng lượng"],"answer_index":0,"explanation":"amazon = amazon"},{"question":"Từ 「auto」 có nghĩa là gì?","options":["tự động","lệnh cấm vận","em yêu","năng lượng"],"answer_index":0,"explanation":"auto = tự động"},{"question":"Từ 「euro」 có nghĩa là gì?","options":["đồng euro","lệnh cấm vận","em yêu","năng lượng"],"answer_index":0,"explanation":"euro = đồng euro"},{"question":"Từ 「girls」 có nghĩa là gì?","options":["cô gái","lệnh cấm vận","em yêu","năng lượng"],"answer_index":0,"explanation":"girls = cô gái"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: lệnh cấm vận","options":["эмбарго","эмми","энер