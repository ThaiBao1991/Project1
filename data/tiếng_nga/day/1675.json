uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"воробьевを 使います。","line_vi":"Tôi dùng воробьев.","focus_words":["воробьев"]},{"speaker":"B","line_target":"воров は 何ですか。","line_vi":"воров là cái gì?","focus_words":["воров"]},{"speaker":"A","line_target":"воспринимаетсяです。","line_vi":"Đó là воспринимается.","focus_words":["воспринимается"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「воробьев」 có nghĩa là gì?","options":["chim sẻ","tên trộm","nhận thấy","có hại"],"answer_index":0,"explanation":"воробьев = chim sẻ"},{"question":"Từ 「воров」 có nghĩa là gì?","options":["tên trộm","chim sẻ","nhận thấy","có hại"],"answer_index":0,"explanation":"воров = tên trộm"},{"question":"Từ 「воспринимается」 có nghĩa là gì?","options":["nhận thấy","chim sẻ","tên trộm","có hại"],"answer_index":0,"explanation":"воспринимается = nhận thấy"},{"question":"Từ 「вредно」 có nghĩa là gì?","options":["có hại","chim sẻ","tên trộm","nhận thấy"],"answer_index":0,"explanation":"вредно = có hại"},{"question":"Từ 「входило」 có nghĩa là gì?","options":["bao gồm","chim sẻ","tên trộm","nhận thấy"],"answer_index":0,"explanation":"входило = bao gồm"},{"question":"Từ 「выдающиеся」 có nghĩa là gì?","options":["xuất sắc","chim sẻ","tên trộm","nhận thấy"],"answer_index":0,"explanation":"выдающиеся = xuất sắc"},{"question":"Từ 「выпадает」 có nghĩa là gì?","options":["rơi ra ngoài","chim sẻ","tên trộm","nhận thấy"],"answer_index":0,"explanation":"выпадает = rơi ra ngoài"},{"question":"Từ 「выполняя」 có nghĩa là gì?","options":["biểu diễn","chim sẻ","tên trộm","nhận thấy"],"answer_index":0,"explanation":"выполняя = biểu diễn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chim sẻ","options":["воробьев","воров","воспринимается","вредно"],"answer_