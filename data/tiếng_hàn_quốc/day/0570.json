にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 570","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"파이프を 使います。","line_vi":"Tôi dùng 파이프.","focus_words":["파이프"]},{"speaker":"B","line_target":"파인 は 何ですか。","line_vi":"파인 là cái gì?","focus_words":["파인"]},{"speaker":"A","line_target":"포위です。","line_vi":"Đó là 포위.","focus_words":["포위"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_64026ae8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「파이프」 có nghĩa là gì?","options":["ống","Tốt","bao vây","xin lỗi"],"answer_index":0,"explanation":"파이프 = ống"},{"question":"Từ 「파인」 có nghĩa là gì?","options":["Tốt","ống","bao vây","xin lỗi"],"answer_index":0,"explanation":"파인 = Tốt"},{"question":"Từ 「포위」 có nghĩa là gì?","options":["bao vây","ống","Tốt","xin lỗi"],"answer_index":0,"explanation":"포위 = bao vây"},{"question":"Từ 「핑계」 có nghĩa là gì?","options":["xin lỗi","ống","Tốt","bao vây"],"answer_index":0,"explanation":"핑계 = xin lỗi"},{"question":"Từ 「하사」 có nghĩa là gì?","options":["trung sĩ","ống","Tốt","bao vây"],"answer_index":0,"explanation":"하사 = trung sĩ"},{"question":"Từ 「한창」 có nghĩa là gì?","options":["Đang trong giai đoạn sôi động","ống","Tốt","bao vây"],"answer_index":0,"explanation":"한창 = Đang trong giai đoạn sôi động"},{"question":"Từ 「art」 có nghĩa là gì?","options":["nghệ thuật","ống","Tốt","bao vây"],"answer_index":0,"explanation":"art = nghệ thuật"},{"question":"Từ 「cut」 có nghĩa là gì?","options":["cắt","ống","Tốt","bao vây"],"answer_index":0,"explanation