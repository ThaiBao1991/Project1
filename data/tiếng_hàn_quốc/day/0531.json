:"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b70e5589","audio_ref":"m_93629391","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_3f874f6d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 531","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"충족を 使います。","line_vi":"Tôi dùng 충족.","focus_words":["충족"]},{"speaker":"B","line_target":"취지 は 何ですか。","line_vi":"취지 là cái gì?","focus_words":["취지"]},{"speaker":"A","line_target":"코로나です。","line_vi":"Đó là 코로나.","focus_words":["코로나"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_259dd933","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「충족」 có nghĩa là gì?","options":["gặp gỡ","Mục đích","hào quang","hài kịch"],"answer_index":0,"explanation":"충족 = gặp gỡ"},{"question":"Từ 「취지」 có nghĩa là gì?","options":["Mục đích","gặp gỡ","hào quang","hài kịch"],"answer_index":0,"explanation":"취지 = Mục đích"},{"question":"Từ 「코로나」 có nghĩa là gì?","options":["hào quang","gặp gỡ","Mục đích","hài kịch"],"answer_index":0,"explanation":"코로나 = hào quang"},{"question":"Từ 「코미디」 có nghĩa là gì?","options":["hài kịch","gặp gỡ","Mục đích","hào quang"],"answer_index":0,"explanation":"코미디 = hài kịch"},{"question":"Từ 「키워드」 có nghĩa là gì?","options":["từ khóa","gặp gỡ","Mục đích","hào quang"],"answer_index":0,"explanation":"키워드 = từ khóa"},{"question":"Từ 「터졌」 có nghĩa là gì?","options":["Nó phát nổ","gặp gỡ","Mục đích","hào quang"],"answer_index":0,"explanation":"터졌 = Nó phát nổ"},{"question":"Từ 「테일러