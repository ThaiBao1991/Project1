 nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 476","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"가르침を 使います。","line_vi":"Tôi dùng 가르침.","focus_words":["가르침"]},{"speaker":"B","line_target":"가속 は 何ですか。","line_vi":"가속 là cái gì?","focus_words":["가속"]},{"speaker":"A","line_target":"개통です。","line_vi":"Đó là 개통.","focus_words":["개통"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cc1736d8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「가르침」 có nghĩa là gì?","options":["giảng dạy","tăng tốc","khai mạc","phòng khách"],"answer_index":0,"explanation":"가르침 = giảng dạy"},{"question":"Từ 「가속」 có nghĩa là gì?","options":["tăng tốc","giảng dạy","khai mạc","phòng khách"],"answer_index":0,"explanation":"가속 = tăng tốc"},{"question":"Từ 「개통」 có nghĩa là gì?","options":["khai mạc","giảng dạy","tăng tốc","phòng khách"],"answer_index":0,"explanation":"개통 = khai mạc"},{"question":"Từ 「거실」 có nghĩa là gì?","options":["phòng khách","giảng dạy","tăng tốc","khai mạc"],"answer_index":0,"explanation":"거실 = phòng khách"},{"question":"Từ 「겁니까」 có nghĩa là gì?","options":["Bạn có sợ không?","giảng dạy","tăng tốc","khai mạc"],"answer_index":0,"explanation":"겁니까 = Bạn có sợ không?"},{"question":"Từ 「결승」 có nghĩa là gì?","options":["cuối cùng","giảng dạy","tăng tốc","khai mạc"],"answer_index":0,"explanation":"결승 = cuối cùng"},{"question":"Từ 「결의」 có ngh