ề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 991","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"경도を 使います。","line_vi":"Tôi dùng 경도.","focus_words":["경도"]},{"speaker":"B","line_target":"경지 は 何ですか。","line_vi":"경지 là cái gì?","focus_words":["경지"]},{"speaker":"A","line_target":"곡물です。","line_vi":"Đó là 곡물.","focus_words":["곡물"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「경도」 có nghĩa là gì?","options":["độ cứng","biên giới","ngũ cốc","doanh nghiệp công cộng"],"answer_index":0,"explanation":"경도 = độ cứng"},{"question":"Từ 「경지」 có nghĩa là gì?","options":["biên giới","độ cứng","ngũ cốc","doanh nghiệp công cộng"],"answer_index":0,"explanation":"경지 = biên giới"},{"question":"Từ 「곡물」 có nghĩa là gì?","options":["ngũ cốc","độ cứng","biên giới","doanh nghiệp công cộng"],"answer_index":0,"explanation":"곡물 = ngũ cốc"},{"question":"Từ 「공기업」 có nghĩa là gì?","options":["doanh nghiệp công cộng","độ cứng","biên giới","ngũ cốc"],"answer_index":0,"explanation":"공기업 = doanh nghiệp công cộng"},{"question":"Từ 「공직자」 có nghĩa là gì?","options":["công chức","độ cứng","biên giới","ngũ cốc"],"answer_index":0,"explanation":"공직자 = công chức"},{"question":"Từ 「관내」 có nghĩa là gì?","options":["Bên trong khuôn viên","độ cứng","biên giới","ngũ cốc"],"answer_index":0,"explanation":"관내 = Bên trong khuôn viên"},{"question":"Từ 「광기」 có nghĩa là gì?","options":["sự điên rồ","độ cứng","biên giới","ngũ cốc"],"answer_index":0,"explanation":"광기 = sự điên rồ"},{"question":"Từ 「광역시」 có nghĩa là gì?","options":["thành phố đô thị","độ cứng","biên giới","ngũ cốc"],"answer_index":0,"explanation":"광역시 = thành phố đô thị"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: độ cứng","options":["경도","경지","곡물","공기업"],"answer_index":0,"explanati