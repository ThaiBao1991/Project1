_words":["밝혀져"]},{"speaker":"B","line_target":"배움 は 何ですか。","line_vi":"배움 là cái gì?","focus_words":["배움"]},{"speaker":"A","line_target":"버퍼です。","line_vi":"Đó là 버퍼.","focus_words":["버퍼"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「밝혀져」 có nghĩa là gì?","options":["Hóa ra","học tập","đệm","rắc rối"],"answer_index":0,"explanation":"밝혀져 = Hóa ra"},{"question":"Từ 「배움」 có nghĩa là gì?","options":["học tập","Hóa ra","đệm","rắc rối"],"answer_index":0,"explanation":"배움 = học tập"},{"question":"Từ 「버퍼」 có nghĩa là gì?","options":["đệm","Hóa ra","học tập","rắc rối"],"answer_index":0,"explanation":"버퍼 = đệm"},{"question":"Từ 「번거」 có nghĩa là gì?","options":["rắc rối","Hóa ra","học tập","đệm"],"answer_index":0,"explanation":"번거 = rắc rối"},{"question":"Từ 「번호판」 có nghĩa là gì?","options":["biển số xe","Hóa ra","học tập","đệm"],"answer_index":0,"explanation":"번호판 = biển số xe"},{"question":"Từ 「법무법인」 có nghĩa là gì?","options":["công ty luật","Hóa ra","học tập","đệm"],"answer_index":0,"explanation":"법무법인 = công ty luật"},{"question":"Từ 「병리」 có nghĩa là gì?","options":["bệnh lý","Hóa ra","học tập","đệm"],"answer_index":0,"explanation":"병리 = bệnh lý"},{"question":"Từ 「병실」 có nghĩa là gì?","options":["phòng bệnh","Hóa ra","học tập","đệm"],"answer_index":0,"explanation":"병실 = phòng bệnh"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Hóa ra","options":["밝혀져","배움","버퍼","번거"],"answer_index":0,"explanation":"밝혀져 = Hóa ra"},{"question":"Chọn từ đúng cho nghĩa: học tập","options":["배움","밝혀져","버퍼","번거"],"answer_index":0,"explanation":"배움 = học tập"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}