i."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 518","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"마셨を 使います。","line_vi":"Tôi dùng 마셨.","focus_words":["마셨"]},{"speaker":"B","line_target":"메달 は 何ですか。","line_vi":"메달 là cái gì?","focus_words":["메달"]},{"speaker":"A","line_target":"모른です。","line_vi":"Đó là 모른.","focus_words":["모른"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_266ab187","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「마셨」 có nghĩa là gì?","options":["uống","huy chương","không biết","không người lái"],"answer_index":0,"explanation":"마셨 = uống"},{"question":"Từ 「메달」 có nghĩa là gì?","options":["huy chương","uống","không biết","không người lái"],"answer_index":0,"explanation":"메달 = huy chương"},{"question":"Từ 「모른」 có nghĩa là gì?","options":["không biết","uống","huy chương","không người lái"],"answer_index":0,"explanation":"모른 = không biết"},{"question":"Từ 「무인」 có nghĩa là gì?","options":["không người lái","uống","huy chương","không biết"],"answer_index":0,"explanation":"무인 = không người lái"},{"question":"Từ 「무효」 có nghĩa là gì?","options":["không hợp lệ","uống","huy chương","không biết"],"answer_index":0,"explanation":"무효 = không hợp lệ"},{"question":"Từ 「미녀」 có nghĩa là gì?","options":["sắc đẹp","uống","huy chương","không biết"],"answer_index":0,"explanation":"미녀 = sắc đẹp"},{"question":"Từ 「미워」 có nghĩa là gì?","options":["Tôi ghét bạn","uống","huy chương","không biết"],"answer_index":0,"explanation":"미워 = Tôi ghét bạn"},{"question":"Từ 「미인」 có nghĩa là gì?","options"