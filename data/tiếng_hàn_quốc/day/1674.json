":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1674","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"오로を 使います。","line_vi":"Tôi dùng 오로.","focus_words":["오로"]},{"speaker":"B","line_target":"오마이갓 は 何ですか。","line_vi":"오마이갓 là cái gì?","focus_words":["오마이갓"]},{"speaker":"A","line_target":"오예です。","line_vi":"Đó là 오예.","focus_words":["오예"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「오로」 có nghĩa là gì?","options":["Oro","Ôi Chúa ơi","ồ vâng","Chúng ta sẽ đến chứ?"],"answer_index":0,"explanation":"오로 = Oro"},{"question":"Từ 「오마이갓」 có nghĩa là gì?","options":["Ôi Chúa ơi","Oro","ồ vâng","Chúng ta sẽ đến chứ?"],"answer_index":0,"explanation":"오마이갓 = Ôi Chúa ơi"},{"question":"Từ 「오예」 có nghĩa là gì?","options":["ồ vâng","Oro","Ôi Chúa ơi","Chúng ta sẽ đến chứ?"],"answer_index":0,"explanation":"오예 = ồ vâng"},{"question":"Từ 「올까요」 có nghĩa là gì?","options":["Chúng ta sẽ đến chứ?","Oro","Ôi Chúa ơi","ồ vâng"],"answer_index":0,"explanation":"올까요 = Chúng ta sẽ đến chứ?"},{"question":"Từ 「와야지」 có nghĩa là gì?","options":["Bạn nên đến","Oro","Ôi Chúa ơi","ồ vâng"],"answer_index":0,"explanation":"와야지 = Bạn nên đến"},{"question":"Từ 「왕십리」 có nghĩa là gì?","options":["Wangsimni","Oro","Ôi Chúa ơi","ồ vâng"],"answer_index":0,"explanation":"왕십리 = Wangsimni"},{"question":"Từ 「외신」 có nghĩa là gì?","options":["báo chí nước ngoài","Oro","Ôi Chúa ơi","ồ vâng"],"answer_index":0,"explanation":"외신 = báo chí nước ngoài"},{"question":"Từ 「원년」 có nghĩa là gì?","options":["năm đầu tiên","Oro","Ôi Chúa ơi","ồ vâng"],"answer_index":0,"explanation":"원년 = năm đầu tiên"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Oro","options":["오로","오마이갓","오예","올까요"],"answer_index":0,"explanation":"오로 = Oro"},{"question":"Chọn từ đúng cho nghĩa: Ôi Chúa ơi","options":["오마이갓","오로","오예","올까요"],"answer_index":0,"explanation":"오마이갓 = Ôi Chúa ơi"}],"common":[],