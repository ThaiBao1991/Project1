à không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 535","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"매출を 使います。","line_vi":"Tôi dùng 매출.","focus_words":["매출"]},{"speaker":"B","line_target":"메가 は 何ですか。","line_vi":"메가 là cái gì?","focus_words":["메가"]},{"speaker":"A","line_target":"멘토です。","line_vi":"Đó là 멘토.","focus_words":["멘토"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_572ad59b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「매출」 có nghĩa là gì?","options":["bán hàng","lớn","người hướng dẫn","tập hợp lại"],"answer_index":0,"explanation":"매출 = bán hàng"},{"question":"Từ 「메가」 có nghĩa là gì?","options":["lớn","bán hàng","người hướng dẫn","tập hợp lại"],"answer_index":0,"explanation":"메가 = lớn"},{"question":"Từ 「멘토」 có nghĩa là gì?","options":["người hướng dẫn","bán hàng","lớn","tập hợp lại"],"answer_index":0,"explanation":"멘토 = người hướng dẫn"},{"question":"Từ 「모였」 có nghĩa là gì?","options":["tập hợp lại","bán hàng","lớn","người hướng dẫn"],"answer_index":0,"explanation":"모였 = tập hợp lại"},{"question":"Từ 「목적지」 có nghĩa là gì?","options":["điểm đến","bán hàng","lớn","người hướng dẫn"],"answer_index":0,"explanation":"목적지 = điểm đến"},{"question":"Từ 「몸매」 có nghĩa là gì?","options":["cơ thể","bán hàng","lớn","người hướng dẫn"],"answer_index":0,"ex