ning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 944","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"노원を 使います。","line_vi":"Tôi dùng 노원.","focus_words":["노원"]},{"speaker":"B","line_target":"느껴진다 は 何ですか。","line_vi":"느껴진다 là cái gì?","focus_words":["느껴진다"]},{"speaker":"A","line_target":"달아나です。","line_vi":"Đó là 달아나.","focus_words":["달아나"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「노원」 có nghĩa là gì?","options":["bây giờ","tôi cảm thấy nó","chạy trốn","thanh toán"],"answer_index":0,"explanation":"노원 = bây giờ"},{"question":"Từ 「느껴진다」 có nghĩa là gì?","options":["tôi cảm thấy nó","bây giờ","chạy trốn","thanh toán"],"answer_index":0,"explanation":"느껴진다 = tôi cảm thấy nó"},{"question":"Từ 「달아나」 có nghĩa là gì?","options":["chạy trốn","bây giờ","tôi cảm thấy nó","thanh toán"],"answer_index":0,"explanation":"달아나 = chạy trốn"},{"question":"Từ 「대금」 có nghĩa là gì?","options":["thanh toán","bây giờ","tôi cảm thấy nó","chạy trốn"],"answer_index":0,"explanation":"대금 = thanh toán"},{"question":"Từ 「대명사」 có nghĩa là gì?","options":["đại từ","bây giờ","tôi cảm thấy nó","chạy trốn"],"answer_index":0,"explanation":"대명사 = đại từ"},{"question":"Từ 「데스크」 có nghĩa là gì?","options":["bàn","bây giờ","tôi cảm thấy nó","chạy trốn"],"answer_index":0,"explanation":"데스크 = bàn"},{"question":"Từ 「데이즈」 có nghĩa là gì?","options":["Ngày","bây giờ","tôi cảm thấy nó","chạy trốn"],"answer_index":0,"explanation":"데이즈 = Ngày"},{"question":"Từ 「도당」 có nghĩa là gì?","options":["hội nhóm","bây giờ","tôi cảm thấy nó","chạy trốn"],"answer_index":0,"explanation":"도당 = hội nhóm"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bây giờ","options":["노원","느껴진다","달아나","대금"],"answer_index":0,"explanation":"노원 = bây giờ"},{"question":"Chọn từ đúng cho nghĩa: tôi cảm thấy nó","options":["느껴진다","노원","달아나","대금"],"answer_index":0,"explanation":"느껴진다 = tôi cảm thấy nó"}