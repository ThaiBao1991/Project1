uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"극단주의を 使います。","line_vi":"Tôi dùng 극단주의.","focus_words":["극단주의"]},{"speaker":"B","line_target":"근시 は 何ですか。","line_vi":"근시 là cái gì?","focus_words":["근시"]},{"speaker":"A","line_target":"금년です。","line_vi":"Đó là 금년.","focus_words":["금년"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「극단주의」 có nghĩa là gì?","options":["chủ nghĩa cực đoan","cận thị","năm nay","tiền lương"],"answer_index":0,"explanation":"극단주의 = chủ nghĩa cực đoan"},{"question":"Từ 「근시」 có nghĩa là gì?","options":["cận thị","chủ nghĩa cực đoan","năm nay","tiền lương"],"answer_index":0,"explanation":"근시 = cận thị"},{"question":"Từ 「금년」 có nghĩa là gì?","options":["năm nay","chủ nghĩa cực đoan","cận thị","tiền lương"],"answer_index":0,"explanation":"금년 = năm nay"},{"question":"Từ 「급료」 có nghĩa là gì?","options":["tiền lương","chủ nghĩa cực đoan","cận thị","năm nay"],"answer_index":0,"explanation":"급료 = tiền lương"},{"question":"Từ 「급성장」 có nghĩa là gì?","options":["tăng trưởng nhanh","chủ nghĩa cực đoan","cận thị","năm nay"],"answer_index":0,"explanation":"급성장 = tăng trưởng nhanh"},{"question":"Từ 「급행」 có nghĩa là gì?","options":["thể hiện","chủ nghĩa cực đoan","cận thị","năm nay"],"answer_index":0,"explanation":"급행 = thể hiện"},{"question":"Từ 「기자단」 có nghĩa là gì?","options":["đoàn báo chí","chủ nghĩa cực đoan","cận thị","năm nay"],"answer_index":0,"explanation":"기자단 = đoàn báo chí"},{"question":"Từ 「긴가」 có nghĩa là gì?","options":["dài","chủ nghĩa cực đoan","cận thị","năm nay"],"answer_index":0,"explanation":"긴가 = dài"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chủ nghĩa cực đoan","options":["극단주의","근시","금년","급료"],"answer_index":0,"explanation":"극단주의 = chủ nghĩa cực đoan"},{"questio