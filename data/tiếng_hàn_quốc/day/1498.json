les":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1498","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"유관を 使います。","line_vi":"Tôi dùng 유관.","focus_words":["유관"]},{"speaker":"B","line_target":"유라시아 は 何ですか。","line_vi":"유라시아 là cái gì?","focus_words":["유라시아"]},{"speaker":"A","line_target":"은평です。","line_vi":"Đó là 은평.","focus_words":["은평"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「유관」 có nghĩa là gì?","options":["liên quan","Á-Âu","Eunpyeong","dải ngân hà"],"answer_index":0,"explanation":"유관 = liên quan"},{"question":"Từ 「유라시아」 có nghĩa là gì?","options":["Á-Âu","liên quan","Eunpyeong","dải ngân hà"],"answer_index":0,"explanation":"유라시아 = Á-Âu"},{"question":"Từ 「은평」 có nghĩa là gì?","options":["Eunpyeong","liên quan","Á-Âu","dải ngân hà"],"answer_index":0,"explanation":"은평 = Eunpyeong"},{"question":"Từ 「은하수」 có nghĩa là gì?","options":["dải ngân hà","liên quan","Á-Âu","Eunpyeong"],"answer_index":0,"explanation":"은하수 = dải ngân hà"},{"question":"Từ 「음대」 có nghĩa là gì?","options":["trường âm nhạc","liên quan","Á-Âu","Eunpyeong"],"answer_index":0,"explanation":"음대 = trường âm nhạc"},{"question":"Từ 「의왕」 có nghĩa là gì?","options":["Uiwang","liên quan","Á-Âu","Eunpyeong"],"answer_index":0,"explanation":"의왕 = Uiwang"},{"question":"Từ 「이누야샤」 có nghĩa là gì?","options":["inuyasha","liên quan","Á-Âu","Eunpyeong"],"answer_index":0,"explanation":"이누야샤 = inuyasha"},{"question":"Từ 「이랜드」 có nghĩa là gì?","options":["đất điện tử","liên quan","Á-Âu","Eunpyeong"],"answer_index":0,"explanation":"이랜드 = đất điện tử"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: liên quan","options":["유관","유라시아","은평","은하수"],"answer_index":0,"explanation":"유관 = liên quan"},{"question":"Chọn từ đúng cho nghĩa: Á-Âu","options":["유라시아","유관","은평","은하수"],"answer_index