5","turns":[{"speaker":"A","line_target":"코스트を 使います。","line_vi":"Tôi dùng 코스트.","focus_words":["코스트"]},{"speaker":"B","line_target":"쿄코 は 何ですか。","line_vi":"쿄코 là cái gì?","focus_words":["쿄코"]},{"speaker":"A","line_target":"크나큰です。","line_vi":"Đó là 크나큰.","focus_words":["크나큰"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「코스트」 có nghĩa là gì?","options":["chi phí","Kyoko","lớn","lạch"],"answer_index":0,"explanation":"코스트 = chi phí"},{"question":"Từ 「쿄코」 có nghĩa là gì?","options":["Kyoko","chi phí","lớn","lạch"],"answer_index":0,"explanation":"쿄코 = Kyoko"},{"question":"Từ 「크나큰」 có nghĩa là gì?","options":["lớn","chi phí","Kyoko","lạch"],"answer_index":0,"explanation":"크나큰 = lớn"},{"question":"Từ 「크릭」 có nghĩa là gì?","options":["lạch","chi phí","Kyoko","lớn"],"answer_index":0,"explanation":"크릭 = lạch"},{"question":"Từ 「킬링」 có nghĩa là gì?","options":["Giết chóc","chi phí","Kyoko","lớn"],"answer_index":0,"explanation":"킬링 = Giết chóc"},{"question":"Từ 「탈리」 có nghĩa là gì?","options":["kiểm đếm","chi phí","Kyoko","lớn"],"answer_index":0,"explanation":"탈리 = kiểm đếm"},{"question":"Từ 「태조」 có nghĩa là gì?","options":["Taejo","chi phí","Kyoko","lớn"],"answer_index":0,"explanation":"태조 = Taejo"},{"question":"Từ 「토해」 có nghĩa là gì?","options":["nôn mửa","chi phí","Kyoko","lớn"],"answer_index":0,"explanation":"토해 = nôn mửa"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chi phí","options":["코스트","쿄코","크나큰","크릭"],"answer_index":0,"explanation":"코스트 = chi phí"},{"question":"Chọn từ đúng cho nghĩa: Kyoko","options":["쿄코","코스트","크나큰","크릭"],"answer_index":0,"explanation":"쿄코 = Kyoko"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}