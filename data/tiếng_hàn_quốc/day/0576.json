":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_53158a27","audio_ref":"m_10daf454","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_358c8278"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 576","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"서점を 使います。","line_vi":"Tôi dùng 서점.","focus_words":["서점"]},{"speaker":"B","line_target":"섬세 は 何ですか。","line_vi":"섬세 là cái gì?","focus_words":["섬세"]},{"speaker":"A","line_target":"성령です。","line_vi":"Đó là 성령.","focus_words":["성령"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_467a0acb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「서점」 có nghĩa là gì?","options":["hiệu sách","tinh tế","thánh thần","xu"],"answer_index":0,"explanation":"서점 = hiệu sách"},{"question":"Từ 「섬세」 có nghĩa là gì?","options":["tinh tế","hiệu sách","thánh thần","xu"],"answer_index":0,"explanation":"섬세 = tinh tế"},{"question":"Từ 「성령」 có nghĩa là gì?","options":["thánh thần","hiệu sách","tinh tế","xu"],"answer_index":0,"explanation":"성령 = thánh thần"},{"question":"Từ 「센트」 có nghĩa là gì?","options":["xu","hiệu sách","tinh tế","thánh thần"],"answer_index":0,"explanation":"센트 = xu"},{"question":"Từ 「수시」 có nghĩa là gì?","options":["Thỉnh thoảng","hiệu sách","tinh tế","thánh thần"],"answer_index":0,"explanation":"수시 = Thỉnh thoảng"},{"question":"Từ 「시급」 có nghĩa là gì?","options":["tỷ lệ hàng giờ","hiệu sách","tinh tế","thánh thần"],"answer_index":0,"explanation":"시급 = tỷ lệ hàng giờ"},{"question":"Từ 「시력」 có nghĩa là gì?","options":["tầm nhìn","hiệu sách","tinh tế","thánh thần"],"answer_index":0,"explanation":"시력 = tầm nhìn"},{"que