ong cách viết","options":["문체","무서워서","미츠","밀집"],"answer_index":0,"explanation":"문체 = phong cách viết"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}