y mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 504","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"찰리を 使います。","line_vi":"Tôi dùng 찰리.","focus_words":["찰리"]},{"speaker":"B","line_target":"체중 は 何ですか。","line_vi":"체중 là cái gì?","focus_words":["체중"]},{"speaker":"A","line_target":"최우선です。","line_vi":"Đó là 최우선.","focus_words":["최우선"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ca7fa489","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「찰리」 có nghĩa là gì?","options":["Charlie","trọng lượng","ưu tiên hàng đầu","lưu đày"],"answer_index":0,"explanation":"찰리 = Charlie"},{"question":"Từ 「체중」 có nghĩa là gì?","options":["trọng lượng","Charlie","ưu tiên hàng đầu","lưu đày"],"answer_index":0,"explanation":"체중 = trọng lượng"},{"question":"Từ 「최우선」 có nghĩa là gì?","options":["ưu tiên hàng đầu","Charlie","trọng lượng","lưu đày"],"answer_index":0,"explanation":"최우선 = ưu tiên hàng đầu"},{"question":"Từ 「추방」 có nghĩa là gì?","options":["lưu đày","Charlie","trọng lượng","ưu tiên hàng đầu"],"answer_index":0,"explanation":"추방 = lưu đày"},{"question":"Từ 「추후」 có nghĩa là gì?","options":["sau này","Charlie","trọng lượng","ưu tiên hàng đầu"],"answer_index":0,"explanation":"추후 = sau này"},{"question":"Từ 「출동」 có nghĩa là gì?","options":["gửi đi","Charlie","trọng lượng","ưu tiên hàng đầu"],"answer_index":0,"explanation":"출동 = gửi đi"},{"question":"Từ 「취한」 có nghĩa là gì?","options":["say rượu","Charlie","trọng lượng","ưu tiên hàng đầu"],"answer_index":0,"explanation":"취한 = say rư