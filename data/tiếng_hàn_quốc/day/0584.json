:"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 584","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"감탄を 使います。","line_vi":"Tôi dùng 감탄.","focus_words":["감탄"]},{"speaker":"B","line_target":"거론 は 何ですか。","line_vi":"거론 là cái gì?","focus_words":["거론"]},{"speaker":"A","line_target":"거미です。","line_vi":"Đó là 거미.","focus_words":["거미"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4ae5ec10","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「감탄」 có nghĩa là gì?","options":["cảm thán","đã đề cập","nhện","kiểm tra"],"answer_index":0,"explanation":"감탄 = cảm thán"},{"question":"Từ 「거론」 có nghĩa là gì?","options":["đã đề cập","cảm thán","nhện","kiểm tra"],"answer_index":0,"explanation":"거론 = đã đề cập"},{"question":"Từ 「거미」 có nghĩa là gì?","options":["nhện","cảm thán","đã đề cập","kiểm tra"],"answer_index":0,"explanation":"거미 = nhện"},{"question":"Từ 「견제」 có nghĩa là gì?","options":["kiểm tra","cảm thán","đã đề cập","nhện"],"answer_index":0,"explanation":"견제 = kiểm tra"},{"question":"Từ 「계열사」 có nghĩa là gì?","options":["liên kết","cảm thán","đã đề cập","nhện"],"answer_index":0,"explanation":"계열사 = liên kết"},{"question":"Từ 「고인」 có nghĩa là gì?","options":["đã chết","cảm thán","đã đề cập","nhện"],"answer_index":0,"explanation":"고인 = đã chết"},{"question":"Từ 「교원」 có nghĩa là gì?","options":["giáo viên","cảm thán","đã đề cập","nhện"],"answer_index":0,"explanation":"교원 = giáo viên"},{"question":"Từ 「군주」 có nghĩa là gì?","options":["quốc vương","cảm thán","đã đề cập","nhện"],"answer_index":0,"explanation":"군주 = quốc vương"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cảm thán","options":["감탄","거