t":"","example_vi":"","image_prompt":null,"image_ref":"m_18fb32b5","audio_ref":"m_eae2983f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_36e96e47"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 522","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"처지を 使います。","line_vi":"Tôi dùng 처지.","focus_words":["처지"]},{"speaker":"B","line_target":"철회 は 何ですか。","line_vi":"철회 là cái gì?","focus_words":["철회"]},{"speaker":"A","line_target":"출국です。","line_vi":"Đó là 출국.","focus_words":["출국"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_089fe519","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「처지」 có nghĩa là gì?","options":["tình huống","rút tiền","Khởi hành","sự trở lại"],"answer_index":0,"explanation":"처지 = tình huống"},{"question":"Từ 「철회」 có nghĩa là gì?","options":["rút tiền","tình huống","Khởi hành","sự trở lại"],"answer_index":0,"explanation":"철회 = rút tiền"},{"question":"Từ 「출국」 có nghĩa là gì?","options":["Khởi hành","tình huống","rút tiền","sự trở lại"],"answer_index":0,"explanation":"출국 = Khởi hành"},{"question":"Từ 「컴백」 có nghĩa là gì?","options":["sự trở lại","tình huống","rút tiền","Khởi hành"],"answer_index":0,"explanation":"컴백 = sự trở lại"},{"question":"Từ 「컴퍼니」 có nghĩa là gì?","options":["Công ty","tình huống","rút tiền","Khởi hành"],"answer_index":0,"explanation":"컴퍼니 = Công ty"},{"question":"Từ 「킬로미터」 có nghĩa là gì?","options":["km","tình huống","rút tiền","Khởi hành"],"answer_index":0,"explanation":"킬로미터 = km"},{"question":"Từ 「튜브」 có nghĩa là gì?","options":["ống","tình huống","rút tiền","Khởi hành"],"answer_index":0,"explanation":"튜브 = ống"},{"question":"Từ 「푸드