:[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2417","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"결렬を 使います。","line_vi":"Tôi dùng 결렬.","focus_words":["결렬"]},{"speaker":"B","line_target":"겸한 は 何ですか。","line_vi":"겸한 là cái gì?","focus_words":["겸한"]},{"speaker":"A","line_target":"경산시です。","line_vi":"Đó là 경산시.","focus_words":["경산시"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「결렬」 có nghĩa là gì?","options":["sự cố","kết hợp","thành phố gyeongsan","nhà khảo cổ học"],"answer_index":0,"explanation":"결렬 = sự cố"},{"question":"Từ 「겸한」 có nghĩa là gì?","options":["kết hợp","sự cố","thành phố gyeongsan","nhà khảo cổ học"],"answer_index":0,"explanation":"겸한 = kết hợp"},{"question":"Từ 「경산시」 có nghĩa là gì?","options":["thành phố gyeongsan","sự cố","kết hợp","nhà khảo cổ học"],"answer_index":0,"explanation":"경산시 = thành phố gyeongsan"},{"question":"Từ 「고고학자」 có nghĩa là gì?","options":["nhà khảo cổ học","sự cố","kết hợp","thành phố gyeongsan"],"answer_index":0,"explanation":"고고학자 = nhà khảo cổ học"},{"question":"Từ 「고관절」 có nghĩa là gì?","options":["khớp hông","sự cố","kết hợp","thành phố gyeongsan"],"answer_index":0,"explanation":"고관절 = khớp hông"},{"question":"Từ 「고덕」 có nghĩa là gì?","options":["Godeok","sự cố","kết hợp","thành phố gyeongsan"],"answer_index":0,"explanation":"고덕 = Godeok"},{"question":"Từ 「고속철」 có nghĩa là gì?","options":["đường sắt tốc độ cao","sự cố","kết hợp","thành phố gyeongsan"],"answer_index":0,"explanation":"고속철 = đường sắt tốc độ cao"},{"question":"Từ 「고질라」 có nghĩa là gì?","options":["Godzilla","sự cố","kết hợp","thành phố gyeongsan"],"answer_index":0,"explanation":"고질라 = Godzilla"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sự cố","options":["결렬","겸한","경산시","고고학자"],"answer_index":0,"explanation":"결렬 = sự cố"},