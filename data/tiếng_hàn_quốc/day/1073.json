uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"초상화を 使います。","line_vi":"Tôi dùng 초상화.","focus_words":["초상화"]},{"speaker":"B","line_target":"충청남도 は 何ですか。","line_vi":"충청남도 là cái gì?","focus_words":["충청남도"]},{"speaker":"A","line_target":"카페인です。","line_vi":"Đó là 카페인.","focus_words":["카페인"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「초상화」 có nghĩa là gì?","options":["Chân dung","Chungcheongnam-do","cà phê","lưỡi dao"],"answer_index":0,"explanation":"초상화 = Chân dung"},{"question":"Từ 「충청남도」 có nghĩa là gì?","options":["Chungcheongnam-do","Chân dung","cà phê","lưỡi dao"],"answer_index":0,"explanation":"충청남도 = Chungcheongnam-do"},{"question":"Từ 「카페인」 có nghĩa là gì?","options":["cà phê","Chân dung","Chungcheongnam-do","lưỡi dao"],"answer_index":0,"explanation":"카페인 = cà phê"},{"question":"Từ 「칼날」 có nghĩa là gì?","options":["lưỡi dao","Chân dung","Chungcheongnam-do","cà phê"],"answer_index":0,"explanation":"칼날 = lưỡi dao"},{"question":"Từ 「캐치」 có nghĩa là gì?","options":["bắt","Chân dung","Chungcheongnam-do","cà phê"],"answer_index":0,"explanation":"캐치 = bắt"},{"question":"Từ 「코팅」 có nghĩa là gì?","options":["lớp phủ","Chân dung","Chungcheongnam-do","cà phê"],"answer_index":0,"explanation":"코팅 = lớp phủ"},{"question":"Từ 「콤비」 có nghĩa là gì?","options":["sự kết hợp","Chân dung","Chungcheongnam-do","cà phê"],"answer_index":0,"explanation":"콤비 = sự kết hợp"},{"question":"Từ 「클론」 có nghĩa là gì?","options":["nhân bản","Chân dung","Chungcheongnam-do","cà phê"],"answer_index":0,"explanation":"클론 = nhân bản"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Chân dung","options":["초상화","충청남도","카페인","칼날"],"answer_index":0,"explanation":"초상화 = Chân dung"},{"question":"Chọn từ đúng cho nghĩa: Chungcheongnam-do