 Ngày 2204","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"터져서を 使います。","line_vi":"Tôi dùng 터져서.","focus_words":["터져서"]},{"speaker":"B","line_target":"터커 は 何ですか。","line_vi":"터커 là cái gì?","focus_words":["터커"]},{"speaker":"A","line_target":"통한다です。","line_vi":"Đó là 통한다.","focus_words":["통한다"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「터져서」 có nghĩa là gì?","options":["Nó phát nổ","Tucker","Nó hoạt động","nông dân"],"answer_index":0,"explanation":"터져서 = Nó phát nổ"},{"question":"Từ 「터커」 có nghĩa là gì?","options":["Tucker","Nó phát nổ","Nó hoạt động","nông dân"],"answer_index":0,"explanation":"터커 = Tucker"},{"question":"Từ 「통한다」 có nghĩa là gì?","options":["Nó hoạt động","Nó phát nổ","Tucker","nông dân"],"answer_index":0,"explanation":"통한다 = Nó hoạt động"},{"question":"Từ 「파머」 có nghĩa là gì?","options":["nông dân","Nó phát nổ","Tucker","Nó hoạt động"],"answer_index":0,"explanation":"파머 = nông dân"},{"question":"Từ 「패러데이」 có nghĩa là gì?","options":["ngày xa xưa","Nó phát nổ","Tucker","Nó hoạt động"],"answer_index":0,"explanation":"패러데이 = ngày xa xưa"},{"question":"Từ 「패한」 có nghĩa là gì?","options":["bị đánh bại","Nó phát nổ","Tucker","Nó hoạt động"],"answer_index":0,"explanation":"패한 = bị đánh bại"},{"question":"Từ 「펩타이드」 có nghĩa là gì?","options":["peptit","Nó phát nổ","Tucker","Nó hoạt động"],"answer_index":0,"explanation":"펩타이드 = peptit"},{"question":"Từ 「포장마차」 có nghĩa là gì?","options":["gian hàng thực phẩm","Nó phát nổ","Tucker","Nó hoạt động"],"answer_index":0,"explanation":"포장마차 = gian hàng thực phẩm"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Nó phát nổ","options":["터져서","터커","통한다","파머"],"answer_index":0,"explanation":"터져서 = Nó phát nổ"},{"question":"Chọn từ đúng cho nghĩ