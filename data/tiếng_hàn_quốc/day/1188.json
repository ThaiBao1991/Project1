":"Tôi dùng 이어받.","focus_words":["이어받"]},{"speaker":"B","line_target":"일과 は 何ですか。","line_vi":"일과 là cái gì?","focus_words":["일과"]},{"speaker":"A","line_target":"일러스트레이터です。","line_vi":"Đó là 일러스트레이터.","focus_words":["일러스트레이터"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「이어받」 có nghĩa là gì?","options":["Tiếp quản","thói quen","họa sĩ minh họa","đứng lên"],"answer_index":0,"explanation":"이어받 = Tiếp quản"},{"question":"Từ 「일과」 có nghĩa là gì?","options":["thói quen","Tiếp quản","họa sĩ minh họa","đứng lên"],"answer_index":0,"explanation":"일과 = thói quen"},{"question":"Từ 「일러스트레이터」 có nghĩa là gì?","options":["họa sĩ minh họa","Tiếp quản","thói quen","đứng lên"],"answer_index":0,"explanation":"일러스트레이터 = họa sĩ minh họa"},{"question":"Từ 「일어」 có nghĩa là gì?","options":["đứng lên","Tiếp quản","thói quen","họa sĩ minh họa"],"answer_index":0,"explanation":"일어 = đứng lên"},{"question":"Từ 「자른」 có nghĩa là gì?","options":["bị cắt xén","Tiếp quản","thói quen","họa sĩ minh họa"],"answer_index":0,"explanation":"자른 = bị cắt xén"},{"question":"Từ 「자판기」 có nghĩa là gì?","options":["máy bán hàng tự động","Tiếp quản","thói quen","họa sĩ minh họa"],"answer_index":0,"explanation":"자판기 = máy bán hàng tự động"},{"question":"Từ 「잔류」 có nghĩa là gì?","options":["dư lượng","Tiếp quản","thói quen","họa sĩ minh họa"],"answer_index":0,"explanation":"잔류 = dư lượng"},{"question":"Từ 「잘랐」 có nghĩa là gì?","options":["cắt nó","Tiếp quản","thói quen","họa sĩ minh họa"],"answer_index":0,"explanation":"잘랐 = cắt nó"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Tiếp quản","options":["이어받","일과","일러스트레이터","일어"],"answer_index":0,"explanation":"이어받 = Tiếp quản"},{"question":"Chọn từ đúng cho nghĩa: thói quen","options":["일과","이어받","일러스트레이터","일어"],"answer_index":0,"explanation":"일과 = th