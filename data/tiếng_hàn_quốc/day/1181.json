ence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1181","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"바뀐다を 使います。","line_vi":"Tôi dùng 바뀐다.","focus_words":["바뀐다"]},{"speaker":"B","line_target":"백혈병 は 何ですか。","line_vi":"백혈병 là cái gì?","focus_words":["백혈병"]},{"speaker":"A","line_target":"버논です。","line_vi":"Đó là 버논.","focus_words":["버논"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「바뀐다」 có nghĩa là gì?","options":["thay đổi","bệnh bạch cầu","Vernon","không thay đổi"],"answer_index":0,"explanation":"바뀐다 = thay đổi"},{"question":"Từ 「백혈병」 có nghĩa là gì?","options":["bệnh bạch cầu","thay đổi","Vernon","không thay đổi"],"answer_index":0,"explanation":"백혈병 = bệnh bạch cầu"},{"question":"Từ 「버논」 có nghĩa là gì?","options":["Vernon","thay đổi","bệnh bạch cầu","không thay đổi"],"answer_index":0,"explanation":"버논 = Vernon"},{"question":"Từ 「변함없」 có nghĩa là gì?","options":["không thay đổi","thay đổi","bệnh bạch cầu","Vernon"],"answer_index":0,"explanation":"변함없 = không thay đổi"},{"question":"Từ 「보인다는」 có nghĩa là gì?","options":["có thể nhìn thấy","thay đổi","bệnh bạch cầu","Vernon"],"answer_index":0,"explanation":"보인다는 = có thể nhìn thấy"},{"question":"Từ 「부검」 có nghĩa là gì?","options":["khám nghiệm tử thi","thay đổi","bệnh bạch cầu","Vernon"],"answer_index":0,"explanation":"부검 = khám nghiệm tử thi"},{"question":"Từ 「부적」 có nghĩa là gì?","options":["bùa hộ mệnh","thay đổi","bệnh bạch cầu","Vernon"],"answer_index":0,"explanation":"부적 = bùa hộ mệnh"},{"question":"Từ 「불로」 có nghĩa là gì?","options":["Với lửa","thay đổi","bệnh bạch cầu","Vernon"],"answer_index":0,"explanation":"불로 = Với lửa"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: thay đổi","options":["바뀐다","백혈병","버논","변함없"],"answer_index":0,"explanation":"바뀐다 = thay đổi"},{"question":"Chọn từ đúng cho nghĩa: bệnh bạch cầu","options":["백혈병","바뀐다","버논","변함없"],"answer_index":0,"explanation":"백혈병 = b