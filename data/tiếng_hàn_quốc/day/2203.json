aning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2203","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"추문を 使います。","line_vi":"Tôi dùng 추문.","focus_words":["추문"]},{"speaker":"B","line_target":"출사 は 何ですか。","line_vi":"출사 là cái gì?","focus_words":["출사"]},{"speaker":"A","line_target":"충무です。","line_vi":"Đó là 충무.","focus_words":["충무"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「추문」 có nghĩa là gì?","options":["vụ bê bối","đi ra ngoài","chungmu","Tsune"],"answer_index":0,"explanation":"추문 = vụ bê bối"},{"question":"Từ 「출사」 có nghĩa là gì?","options":["đi ra ngoài","vụ bê bối","chungmu","Tsune"],"answer_index":0,"explanation":"출사 = đi ra ngoài"},{"question":"Từ 「충무」 có nghĩa là gì?","options":["chungmu","vụ bê bối","đi ra ngoài","Tsune"],"answer_index":0,"explanation":"충무 = chungmu"},{"question":"Từ 「츠네」 có nghĩa là gì?","options":["Tsune","vụ bê bối","đi ra ngoài","chungmu"],"answer_index":0,"explanation":"츠네 = Tsune"},{"question":"Từ 「친지」 có nghĩa là gì?","options":["tương đối","vụ bê bối","đi ra ngoài","chungmu"],"answer_index":0,"explanation":"친지 = tương đối"},{"question":"Từ 「카스트」 có nghĩa là gì?","options":["đẳng cấp","vụ bê bối","đi ra ngoài","chungmu"],"answer_index":0,"explanation":"카스트 = đẳng cấp"},{"question":"Từ 「카슨」 có nghĩa là gì?","options":["carson","vụ bê bối","đi ra ngoài","chungmu"],"answer_index":0,"explanation":"카슨 = carson"},{"question":"Từ 「컨버터블」 có nghĩa là gì?","options":["có thể chuyển đổi","vụ bê bối","đi ra ngoài","chungmu"],"answer_index":0,"explanation":"컨버터블 = có thể chuyển đổi"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: vụ bê bối","options":["추문","출사","충무","츠네"],"answer_index":0,"explanation":"추문 = vụ bê bối"},{"question":"Chọn từ đúng cho nghĩa: đi ra ngoài","options":["출사","추문","충무","츠네"],"answer_