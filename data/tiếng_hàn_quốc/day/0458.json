.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 458","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"공구を 使います。","line_vi":"Tôi dùng 공구.","focus_words":["공구"]},{"speaker":"B","line_target":"공군 は 何ですか。","line_vi":"공군 là cái gì?","focus_words":["공군"]},{"speaker":"A","line_target":"구단です。","line_vi":"Đó là 구단.","focus_words":["구단"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a82a5aa1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「공구」 có nghĩa là gì?","options":["công cụ","lực lượng không quân","câu lạc bộ","đạo sư"],"answer_index":0,"explanation":"공구 = công cụ"},{"question":"Từ 「공군」 có nghĩa là gì?","options":["lực lượng không quân","công cụ","câu lạc bộ","đạo sư"],"answer_index":0,"explanation":"공군 = lực lượng không quân"},{"question":"Từ 「구단」 có nghĩa là gì?","options":["câu lạc bộ","công cụ","lực lượng không quân","đạo sư"],"answer_index":0,"explanation":"구단 = câu lạc bộ"},{"question":"Từ 「구로」 có nghĩa là gì?","options":["đạo sư","công cụ","lực lượng không quân","câu lạc bộ"],"answer_index":0,"explanation":"구로 = đạo sư"},{"question":"Từ 「군산」 có nghĩa là gì?","options":["Gunsan","công cụ","lực lượng không quân","câu lạc bộ"],"answer_index":0,"explanation":"군산 = Gunsan"},{"question":"Từ 「그걸로」 có nghĩa là gì?","options":["Với điều đó","công cụ","lực lượng không quân","câu lạc bộ"],"answer_index":0,"explanation":"그걸로 = Với điều đó"},{"question":"Từ 「급하」 có nghĩa là gì?","options":["đang vội","công cụ","lực lượng không quân","câu lạc bộ"],"answer_index":0,"explanation":"급하 = đang vội"},{"question":"Từ 「껍질」 có nghĩa là gì?","options":["vỏ","công cụ","lực lư