 = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 480","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"선교사を 使います。","line_vi":"Tôi dùng 선교사.","focus_words":["선교사"]},{"speaker":"B","line_target":"섭취 は 何ですか。","line_vi":"섭취 là cái gì?","focus_words":["섭취"]},{"speaker":"A","line_target":"세라です。","line_vi":"Đó là 세라.","focus_words":["세라"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7d58e6a2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「선교사」 có nghĩa là gì?","options":["nhà truyền giáo","lượng tiêu thụ","Sarah","giác quan"],"answer_index":0,"explanation":"선교사 = nhà truyền giáo"},{"question":"Từ 「섭취」 có nghĩa là gì?","options":["lượng tiêu thụ","nhà truyền giáo","Sarah","giác quan"],"answer_index":0,"explanation":"섭취 = lượng tiêu thụ"},{"question":"Từ 「세라」 có nghĩa là gì?","options":["Sarah","nhà truyền giáo","lượng tiêu thụ","giác quan"],"answer_index":0,"explanation":"세라 = Sarah"},{"question":"Từ 「센스」 có nghĩa là gì?","options":["giác quan","nhà truyền giáo","lượng tiêu thụ","Sarah"],"answer_index":0,"explanation":"센스 = giác quan"},{"question":"Từ 「수상자」 có nghĩa là gì?","options":["người chiến thắng","nhà truyền giáo","lượng tiêu thụ","Sarah"],"answer_index":0,"explanation":"수상자 = người chiến thắng"},{"question":"Từ 「수신」 có nghĩa là gì?","options":["nhận được","nhà truyền giáo","lượng tiêu thụ","Sarah"],"answer_i