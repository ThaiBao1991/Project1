t":"","example_vi":"","image_prompt":null,"image_ref":"m_d3e6b7b0","audio_ref":"m_f450226e","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_6afc377c"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 457","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"후드を 使います。","line_vi":"Tôi dùng 후드.","focus_words":["후드"]},{"speaker":"B","line_target":"off は 何ですか。","line_vi":"off là cái gì?","focus_words":["off"]},{"speaker":"A","line_target":"openです。","line_vi":"Đó là open.","focus_words":["open"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1bd48c8c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「후드」 có nghĩa là gì?","options":["mui xe","tắt","mở","hai"],"answer_index":0,"explanation":"후드 = mui xe"},{"question":"Từ 「off」 có nghĩa là gì?","options":["tắt","mui xe","mở","hai"],"answer_index":0,"explanation":"off = tắt"},{"question":"Từ 「open」 có nghĩa là gì?","options":["mở","mui xe","tắt","hai"],"answer_index":0,"explanation":"open = mở"},{"question":"Từ 「two」 có nghĩa là gì?","options":["hai","mui xe","tắt","mở"],"answer_index":0,"explanation":"two = hai"},{"question":"Từ 「type」 có nghĩa là gì?","options":["loại","mui xe","tắt","mở"],"answer_index":0,"explanation":"type = loại"},{"question":"Từ 「각오」 có nghĩa là gì?","options":["quyết tâm","mui xe","tắt","mở"],"answer_index":0,"explanation":"각오 = quyết tâm"},{"question":"Từ 「간섭」 có nghĩa là gì?","options":["sự can thiệp","mui xe","tắt","mở"],"answer_index":0,"explanation":"간섭 = sự can thiệp"},{"question":"Từ 「강연」 có nghĩa là gì?","options":["bài giảng","mui xe","tắt","mở"],"answer_index":0,"explanation":"강연 = bài giảng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: mui xe","options":["후드","off","open","two"],"answer_index":0,"explanation":"후드 = mui xe"},{"question":"Chọn từ đúng cho nghĩa: tắt","options":["off","후드","open","two"],"answer_index":0,"explanation":"off = tắt"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"후드":"m_3dcfb917","off":"m_ea8a7f81","open":"m_f9b62fb1","two":"m_f421210a","type":"m_7240973d","각오":"m_1f76811e","간섭":"m_da63a2c3","강연":"m_67a2420a","경보":"m_f2c42761","곳곳":"m_f450226e"},"dialogue_audio":{"0":"m_1bd48c8c"}},"media_map":{"m_12d3550d":"media/tiếng_hàn_quốc/d0457/word_00_14f0ea0f.webp","m_e878866d":"media/tiếng_hàn_quốc/d0457/word_01_ea908acf.webp","m_9228891b":"media/tiếng_hàn_quốc/d0457/word_02_57457d10.webp","m_12a6dfee":"media/tiếng_hàn_quốc/d0457/word_03_25c57b3d.webp","m_1cca5a91":"media/tiếng_hàn_quốc/d0457/word_04_73d47961.webp","m_c1ceceae":"media/tiếng_hàn_quốc/d0457/word_05_2f3c7d07.webp","m_06632208":"media/tiếng_hàn_quốc/d0457/word_06_ced02d34.webp","m_3606a373":"media/tiếng_hàn_quốc/d0457/word_07_488be049.webp","m_e2abefca":"media/tiếng_hàn_quốc/d0457/word_08_6ee71325.webp","m_d3e6b7b0":"media/tiếng_hàn_quốc/d0457/word_09_068461d7.webp","m_3dcfb917":"media/tiếng_hàn_quốc/d0457/audio_vocab_00_87cc3dc0.mp3","m_ccbff6e4":"media/tiếng_hàn_quốc/d0457/audio_vocab_00_vi_87cc3dc0.mp3","m_ea8a7f81":"media/tiếng_hàn_quốc/d0457/audio_vocab_01_cb6cdf6c.mp3","m_6c8835f8":"media/tiếng_hàn_quốc/d0457/audio_vocab_01_vi_cb6cdf6c.mp3","m_f9b62fb1":"media/tiếng_hàn_quốc/d0457/audio_vocab_02_77d0745e.mp3","m_a51bea00":"media/tiếng_hàn_quốc/d0457/audio_vocab_02_vi_77d0745e.mp3","m_f421210a":"media/tiếng_hàn_quốc/d0457/audio_vocab_03_8cbfe04a.mp3","m_535083d7":"media/tiếng_hàn_quốc/d0457/audio_vocab_03_vi_8cbfe04a.mp3","m_7240973d":"media/tiếng_hàn_quốc/d0457/audio_vocab_04_eb1eda62.mp3","m_ee447fe4":"media/tiếng_hàn_quốc/d0457/audio_vocab_04_vi_eb1eda62.mp3","m_1f76811e":"media/tiếng_hàn_quốc/d0457/audio_vocab_05_4fe99eab.mp3","m_4b0a3dda":"media/tiếng_hàn_quốc/d0457/audio_vocab_05_vi_c7a77c1a.mp3","m_da63a2c3":"media/tiếng_hàn_quốc/d0457/audio_vocab_06_20017924.mp3","m_483e25