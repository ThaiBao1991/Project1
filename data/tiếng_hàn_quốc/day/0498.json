n là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 498","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"데드を 使います。","line_vi":"Tôi dùng 데드.","focus_words":["데드"]},{"speaker":"B","line_target":"떠올리 は 何ですか。","line_vi":"떠올리 là cái gì?","focus_words":["떠올리"]},{"speaker":"A","line_target":"루프です。","line_vi":"Đó là 루프.","focus_words":["루프"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_59fd14e2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「데드」 có nghĩa là gì?","options":["đã chết","Hãy nghĩ về nó","vòng lặp","Masan"],"answer_index":0,"explanation":"데드 = đã chết"},{"question":"Từ 「떠올리」 có nghĩa là gì?","options":["Hãy nghĩ về nó","đã chết","vòng lặp","Masan"],"answer_index":0,"explanation":"떠올리 = Hãy nghĩ về nó"},{"question":"Từ 「루프」 có nghĩa là gì?","options":["vòng lặp","đã chết","Hãy nghĩ về nó","Masan"],"answer_index":0,"explanation":"루프 = vòng lặp"},{"question":"Từ 「마산」 có nghĩa là gì?","options":["Masan","đã chết","Hãy nghĩ về nó","vòng lặp"],"answer_index":0,"explanation":"마산 = Masan"},{"question":"Từ 「메탈」 có nghĩa là gì?","options":["kim loại","đã chết","Hãy nghĩ về nó","vòng lặp"],"answer_index":0,"explanation":"메탈 = kim loại"},{"question":"Từ 「목걸이」 có nghĩa là gì?","options":["vòng cổ","đã chết","Hãy nghĩ về nó","vòng lặp"],"answer_index":0,"explanation":"목걸이 = vòng cổ"},{"question":"Từ 「무거운」 có nghĩa là gì?","options":["nặng nề","đã chết","Hãy nghĩ về nó","vòng lặp"],"answer_index":0,"explanation":"무거운 = nặng nề"},{"question":"Từ 「문법」 có nghĩa là gì?","options":["ngữ pháp","đã chết","Hãy nghĩ về nó","vòng lặp"],"answer_index":0,"expla