_words":["유어"]},{"speaker":"B","line_target":"은총 は 何ですか。","line_vi":"은총 là cái gì?","focus_words":["은총"]},{"speaker":"A","line_target":"은평구です。","line_vi":"Đó là 은평구.","focus_words":["은평구"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「유어」 có nghĩa là gì?","options":["của bạn","ân sủng","Eunpyeong-gu","bất thường"],"answer_index":0,"explanation":"유어 = của bạn"},{"question":"Từ 「은총」 có nghĩa là gì?","options":["ân sủng","của bạn","Eunpyeong-gu","bất thường"],"answer_index":0,"explanation":"은총 = ân sủng"},{"question":"Từ 「은평구」 có nghĩa là gì?","options":["Eunpyeong-gu","của bạn","ân sủng","bất thường"],"answer_index":0,"explanation":"은평구 = Eunpyeong-gu"},{"question":"Từ 「이례」 có nghĩa là gì?","options":["bất thường","của bạn","ân sủng","Eunpyeong-gu"],"answer_index":0,"explanation":"이례 = bất thường"},{"question":"Từ 「이뤄졌」 có nghĩa là gì?","options":["Nó đã thành sự thật","của bạn","ân sủng","Eunpyeong-gu"],"answer_index":0,"explanation":"이뤄졌 = Nó đã thành sự thật"},{"question":"Từ 「이윤」 có nghĩa là gì?","options":["lợi nhuận","của bạn","ân sủng","Eunpyeong-gu"],"answer_index":0,"explanation":"이윤 = lợi nhuận"},{"question":"Từ 「이토」 có nghĩa là gì?","options":["Ito","của bạn","ân sủng","Eunpyeong-gu"],"answer_index":0,"explanation":"이토 = Ito"},{"question":"Từ 「이프」 có nghĩa là gì?","options":["Nếu","của bạn","ân sủng","Eunpyeong-gu"],"answer_index":0,"explanation":"이프 = Nếu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: của bạn","options":["유어","은총","은평구","이례"],"answer_index":0,"explanation":"유어 = của bạn"},{"question":"Chọn từ đúng cho nghĩa: ân sủng","options":["은총","유어","은평구","이례"],"answer_index":0,"explanation":"은총 = ân sủng"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}