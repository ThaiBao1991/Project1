ệc — Ngày 938","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"트렌드を 使います。","line_vi":"Tôi dùng 트렌드.","focus_words":["트렌드"]},{"speaker":"B","line_target":"표방 は 何ですか。","line_vi":"표방 là cái gì?","focus_words":["표방"]},{"speaker":"A","line_target":"퓨전です。","line_vi":"Đó là 퓨전.","focus_words":["퓨전"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「트렌드」 có nghĩa là gì?","options":["xu hướng","tuyên bố","sự hợp nhất","nhượng quyền thương mại"],"answer_index":0,"explanation":"트렌드 = xu hướng"},{"question":"Từ 「표방」 có nghĩa là gì?","options":["tuyên bố","xu hướng","sự hợp nhất","nhượng quyền thương mại"],"answer_index":0,"explanation":"표방 = tuyên bố"},{"question":"Từ 「퓨전」 có nghĩa là gì?","options":["sự hợp nhất","xu hướng","tuyên bố","nhượng quyền thương mại"],"answer_index":0,"explanation":"퓨전 = sự hợp nhất"},{"question":"Từ 「프랜차이즈」 có nghĩa là gì?","options":["nhượng quyền thương mại","xu hướng","tuyên bố","sự hợp nhất"],"answer_index":0,"explanation":"프랜차이즈 = nhượng quyền thương mại"},{"question":"Từ 「플레이오프」 có nghĩa là gì?","options":["vòng loại trực tiếp","xu hướng","tuyên bố","sự hợp nhất"],"answer_index":0,"explanation":"플레이오프 = vòng loại trực tiếp"},{"question":"Từ 「피크」 có nghĩa là gì?","options":["đỉnh cao","xu hướng","tuyên bố","sự hợp nhất"],"answer_index":0,"explanation":"피크 = đỉnh cao"},{"question":"Từ 「하군」 có nghĩa là gì?","options":["Vâng","xu hướng","tuyên bố","sự hợp nhất"],"answer_index":0,"explanation":"하군 = Vâng"},{"question":"Từ 「하이퍼」 có nghĩa là gì?","options":["siêu","xu hướng","tuyên bố","sự hợp nhất"],"answer_index":0,"explanation":"하이퍼 = siêu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: xu hướng","options":["트렌드","표방","퓨전","프랜차이즈"],"answer_index":0,"explanation":"트렌드 = xu hư