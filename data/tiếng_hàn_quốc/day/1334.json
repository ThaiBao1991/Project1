.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1334","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"져도を 使います。","line_vi":"Tôi dùng 져도.","focus_words":["져도"]},{"speaker":"B","line_target":"조문 は 何ですか。","line_vi":"조문 là cái gì?","focus_words":["조문"]},{"speaker":"A","line_target":"조선인です。","line_vi":"Đó là 조선인.","focus_words":["조선인"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「져도」 có nghĩa là gì?","options":["Ngay cả khi bạn thua","chia buồn","Tiếng Hàn","thành viên công đoàn"],"answer_index":0,"explanation":"져도 = Ngay cả khi bạn thua"},{"question":"Từ 「조문」 có nghĩa là gì?","options":["chia buồn","Ngay cả khi bạn thua","Tiếng Hàn","thành viên công đoàn"],"answer_index":0,"explanation":"조문 = chia buồn"},{"question":"Từ 「조선인」 có nghĩa là gì?","options":["Tiếng Hàn","Ngay cả khi bạn thua","chia buồn","thành viên công đoàn"],"answer_index":0,"explanation":"조선인 = Tiếng Hàn"},{"question":"Từ 「조합원」 có nghĩa là gì?","options":["thành viên công đoàn","Ngay cả khi bạn thua","chia buồn","Tiếng Hàn"],"answer_index":0,"explanation":"조합원 = thành viên công đoàn"},{"question":"Từ 「종래」 có nghĩa là gì?","options":["truyền thống","Ngay cả khi bạn thua","chia buồn","Tiếng Hàn"],"answer_index":0,"explanation":"종래 = truyền thống"},{"question":"Từ 「주마」 có nghĩa là gì?","options":["Zuma","Ngay cả khi bạn thua","chia buồn","Tiếng Hàn"],"answer_index":0,"explanation":"주마 = Zuma"},{"question":"Từ 「주의보」 có nghĩa là gì?","options":["tư vấn","Ngay cả khi bạn thua","chia buồn","Tiếng Hàn"],"answer_index":0,"explanation":"주의보 = tư vấn"},{"question":"Từ 「진부」 có nghĩa là gì?","options":["sáo ngữ","Ngay cả khi bạn thua","chia buồn","Tiếng Hàn"],"answer_index":0,"explanation":"진부 = sáo ngữ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Ngay cả khi bạn thua","options":["져도","조문","조선인","조합원"],"answer_index":0,"explanation":"져도 = Ngay cả k