akes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 593","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"peopleを 使います。","line_vi":"Tôi dùng people.","focus_words":["people"]},{"speaker":"B","line_target":"real は 何ですか。","line_vi":"real là cái gì?","focus_words":["real"]},{"speaker":"A","line_target":"sayです。","line_vi":"Đó là say.","focus_words":["say"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8c5b484f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「people」 có nghĩa là gì?","options":["mọi người","thực","nói","ngôi sao"],"answer_index":0,"explanation":"people = mọi người"},{"question":"Từ 「real」 có nghĩa là gì?","options":["thực","mọi người","nói","ngôi sao"],"answer_index":0,"explanation":"real = thực"},{"question":"Từ 「say」 có nghĩa là gì?","options":["nói","mọi người","thực","ngôi sao"],"answer_index":0,"explanation":"say = nói"},{"question":"Từ 「star」 có nghĩa là gì?","options":["ngôi sao","mọi người","thực","nói"],"answer_index":0,"explanation":"star = ngôi sao"},{"question":"Từ 「there」 có nghĩa là gì?","options":["ở đó","mọi người","thực","nói"],"answer_index":0,"explanation":"there = ở đó"},{"question":"Từ 「vip」 có nghĩa là gì?","options":["vip","mọi người","thực","nói"],"answer_index":0,"explanation":"vip = vip"},{"question":"Từ 「강서구」 có nghĩa là gì?","options":["Gangseo-gu","mọi người","thực","nói"],"answer_index":0,"explanation":"강서구 = Gangseo-gu"},{"question":"Từ 「개구리」 có nghĩa là gì?","options":["ếch","mọi người","thực","nói"],"answer_index":0,"explanation":"개구리 = ếch"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: mọi người","options":["people","real","say","star"],"a