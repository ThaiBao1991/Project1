h từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 549","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"특검を 使います。","line_vi":"Tôi dùng 특검.","focus_words":["특검"]},{"speaker":"B","line_target":"특전 は 何ですか。","line_vi":"특전 là cái gì?","focus_words":["특전"]},{"speaker":"A","line_target":"펭귄です。","line_vi":"Đó là 펭귄.","focus_words":["펭귄"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4cd8b13c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「특검」 có nghĩa là gì?","options":["công tố viên đặc biệt","đặc quyền","chim cánh cụt","vạch trần"],"answer_index":0,"explanation":"특검 = công tố viên đặc biệt"},{"question":"Từ 「특전」 có nghĩa là gì?","options":["đặc quyền","công tố viên đặc biệt","chim cánh cụt","vạch trần"],"answer_index":0,"explanation":"특전 = đặc quyền"},{"question":"Từ 「펭귄」 có nghĩa là gì?","options":["chim cánh cụt","công tố viên đặc biệt","đặc quyền","vạch trần"],"answer_index":0,"explanation":"펭귄 = chim cánh cụt"},{"question":"Từ 「폭로」 có nghĩa là gì?","options":["vạch trần","công tố viên đặc biệt","đặc quyền","chim cánh cụt"],"answer_index":0,"explanation":"폭로 = vạch trần"},{"question":"Từ 「하키」 có nghĩa là gì?","options":["khúc côn cầu","công tố viên đặc biệt","đặc quyền","chim cánh cụt"],"answer_index":0,"explanation":"하키 = khúc côn cầu"},{"question":"Từ 「할수록」 có nghĩa là gì?","options":["Càng nhiều","công tố viên đặc biệt","đặc quyền","chim cánh cụt"],"answer_index