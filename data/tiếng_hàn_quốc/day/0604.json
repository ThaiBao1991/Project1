す.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 604","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"가축を 使います。","line_vi":"Tôi dùng 가축.","focus_words":["가축"]},{"speaker":"B","line_target":"각기 は 何ですか。","line_vi":"각기 là cái gì?","focus_words":["각기"]},{"speaker":"A","line_target":"강당です。","line_vi":"Đó là 강당.","focus_words":["강당"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「가축」 có nghĩa là gì?","options":["vật nuôi","tương ứng","khán phòng","kiến"],"answer_index":0,"explanation":"가축 = vật nuôi"},{"question":"Từ 「각기」 có nghĩa là gì?","options":["tương ứng","vật nuôi","khán phòng","kiến"],"answer_index":0,"explanation":"각기 = tương ứng"},{"question":"Từ 「강당」 có nghĩa là gì?","options":["khán phòng","vật nuôi","tương ứng","kiến"],"answer_index":0,"explanation":"강당 = khán phòng"},{"question":"Từ 「개미」 có nghĩa là gì?","options":["kiến","vật nuôi","tương ứng","khán phòng"],"answer_index":0,"explanation":"개미 = kiến"},{"question":"Từ 「걸어서」 có nghĩa là gì?","options":["đi bộ","vật nuôi","tương ứng","khán phòng"],"answer_index":0,"explanation":"걸어서 = đi bộ"},{"question":"Từ 「경매」 có nghĩa là gì?","options":["đấu giá","vật nuôi","tương ứng","khán phòng"],"answer_index":0,"explanation":"경매 = đấu giá"},{"question":"Từ 「계세요」 có nghĩa là gì?","options":["Bạn có ở đó không?","vật nuôi","tương ứng","khán phòng"],"answer_index":0,"explanation":"계세요 = Bạn có ở đó không?"},{"question":"Từ 「계약서」 có nghĩa là gì?","options":["hợp đồng","vật nuôi","tương ứng","khán phòng"],"answer_index":0,"explanation":"계약서 = hợp đồng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: vật nuôi","options":["가축","각기","강당","개미"],"answer_index":0,"explanation":"가축 = vật nuôi"},{"question":"Chọn từ đúng cho nghĩa: tương ứng","options":["각기","가축","강당","개미"],"answer_index":0,"explanation":"각기 = tương ứng"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"