onetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_867ac8d8","audio_ref":"m_e920938d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_db3656cd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 461","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"분열を 使います。","line_vi":"Tôi dùng 분열.","focus_words":["분열"]},{"speaker":"B","line_target":"사라져 は 何ですか。","line_vi":"사라져 là cái gì?","focus_words":["사라져"]},{"speaker":"A","line_target":"사명です。","line_vi":"Đó là 사명.","focus_words":["사명"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b58406bd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「분열」 có nghĩa là gì?","options":["sự phân chia","biến mất","sứ mệnh","bánh sandwich"],"answer_index":0,"explanation":"분열 = sự phân chia"},{"question":"Từ 「사라져」 có nghĩa là gì?","options":["biến mất","sự phân chia","sứ mệnh","bánh sandwich"],"answer_index":0,"explanation":"사라져 = biến mất"},{"question":"Từ 「사명」 có nghĩa là gì?","options":["sứ mệnh","sự phân chia","biến mất","bánh sandwich"],"answer_index":0,"explanation":"사명 = sứ mệnh"},{"question":"Từ 「샌드위치」 có nghĩa là gì?","options":["bánh sandwich","sự phân chia","biến mất","sứ mệnh"],"answer_index":0,"explanation":"샌드위치 = bánh sandwich"},{"question":"Từ 「선교」 có nghĩa là gì?","options":["nhà truyền giáo","sự phân chia","biến mất","sứ mệnh"],"answer_index":0,"explanation":"선교 = nhà truyền giáo"},{"question":"Từ 「세운」 có nghĩa là gì?","options":["seun","sự phân chia","biến mất","sứ mệnh"],"answer_index":0,"explanation":"세운 = seun"},{"question":"Từ 「소름」 có nghĩa là gì?","options":["đáng sợ","sự phân chia","biến mất","sứ mệnh"],"answer_index":0,"explanation":"소름 = đáng sợ"},{"question":"Từ 「수동」 có nghĩa là gì