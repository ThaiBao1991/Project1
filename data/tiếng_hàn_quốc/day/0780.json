_vi":"Tôi dùng security.","focus_words":["security"]},{"speaker":"B","line_target":"three は 何ですか。","line_vi":"three là cái gì?","focus_words":["three"]},{"speaker":"A","line_target":"가위です。","line_vi":"Đó là 가위.","focus_words":["가위"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「security」 có nghĩa là gì?","options":["an ninh","ba","kéo","kiểm phiếu"],"answer_index":0,"explanation":"security = an ninh"},{"question":"Từ 「three」 có nghĩa là gì?","options":["ba","an ninh","kéo","kiểm phiếu"],"answer_index":0,"explanation":"three = ba"},{"question":"Từ 「가위」 có nghĩa là gì?","options":["kéo","an ninh","ba","kiểm phiếu"],"answer_index":0,"explanation":"가위 = kéo"},{"question":"Từ 「개표」 có nghĩa là gì?","options":["kiểm phiếu","an ninh","ba","kéo"],"answer_index":0,"explanation":"개표 = kiểm phiếu"},{"question":"Từ 「거려」 có nghĩa là gì?","options":["khoảng cách","an ninh","ba","kéo"],"answer_index":0,"explanation":"거려 = khoảng cách"},{"question":"Từ 「건들」 có nghĩa là gì?","options":["Súng","an ninh","ba","kéo"],"answer_index":0,"explanation":"건들 = Súng"},{"question":"Từ 「검색어」 có nghĩa là gì?","options":["thuật ngữ tìm kiếm","an ninh","ba","kéo"],"answer_index":0,"explanation":"검색어 = thuật ngữ tìm kiếm"},{"question":"Từ 「경쟁력」 có nghĩa là gì?","options":["khả năng cạnh tranh","an ninh","ba","kéo"],"answer_index":0,"explanation":"경쟁력 = khả năng cạnh tranh"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: an ninh","options":["security","three","가위","개표"],"answer_index":0,"explanation":"security = an ninh"},{"question":"Chọn từ đúng cho nghĩa: ba","options":["three","security","가위","개표"],"answer_index":0,"explanation":"three = ba"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}