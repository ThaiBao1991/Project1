le_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e7348ff7","audio_ref":"m_4f19f7be","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_715b5828"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 454","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"육군を 使います。","line_vi":"Tôi dùng 육군.","focus_words":["육군"]},{"speaker":"B","line_target":"으려면 は 何ですか。","line_vi":"으려면 là cái gì?","focus_words":["으려면"]},{"speaker":"A","line_target":"이득です。","line_vi":"Đó là 이득.","focus_words":["이득"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cb099e0c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「육군」 có nghĩa là gì?","options":["quân đội","để làm","lợi ích","Hồi giáo"],"answer_index":0,"explanation":"육군 = quân đội"},{"question":"Từ 「으려면」 có nghĩa là gì?","options":["để làm","quân đội","lợi ích","Hồi giáo"],"answer_index":0,"explanation":"으려면 = để làm"},{"question":"Từ 「이득」 có nghĩa là gì?","options":["lợi ích","quân đội","để làm","Hồi giáo"],"answer_index":0,"explanation":"이득 = lợi ích"},{"question":"Từ 「이슬람」 có nghĩa là gì?","options":["Hồi giáo","quân đội","để làm","lợi ích"],"answer_index":0,"explanation":"이슬람 = Hồi giáo"},{"question":"Từ 「자바」 có nghĩa là gì?","options":["java","quân đội","để làm","lợi ích"],"answer_index":0,"explanation":"자바 = java"},{"question":"Từ 「전진」 có nghĩa là gì?","options":["phía trước","quân đội","để làm","lợi ích"],"answer_index":0,"explanation":"전진 = phía trước"},{"question":"Từ 「정복」 có nghĩa là gì?","options":["chinh phục","quân đội","để làm","lợi ích"],"answer_index":0,"explanation":"정복 = chinh phục"},{"question":"Từ 「좌파」 có nghĩa là gì?","options":["cánh trái","quân đội","để làm","lợi ích"],"answer_index":0,"explanation":"좌파 = cánh trái"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: q