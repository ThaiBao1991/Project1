onetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c3a42eea","audio_ref":"m_aece4353","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d7d7b8b6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 464","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"중국인を 使います。","line_vi":"Tôi dùng 중국인.","focus_words":["중국인"]},{"speaker":"B","line_target":"즐길 は 何ですか。","line_vi":"즐길 là cái gì?","focus_words":["즐길"]},{"speaker":"A","line_target":"지난주です。","line_vi":"Đó là 지난주.","focus_words":["지난주"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_30d226c0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「중국인」 có nghĩa là gì?","options":["Tiếng Trung","thưởng thức","tuần trước","trí thông minh"],"answer_index":0,"explanation":"중국인 = Tiếng Trung"},{"question":"Từ 「즐길」 có nghĩa là gì?","options":["thưởng thức","Tiếng Trung","tuần trước","trí thông minh"],"answer_index":0,"explanation":"즐길 = thưởng thức"},{"question":"Từ 「지난주」 có nghĩa là gì?","options":["tuần trước","Tiếng Trung","thưởng thức","trí thông minh"],"answer_index":0,"explanation":"지난주 = tuần trước"},{"question":"Từ 「지능」 có nghĩa là gì?","options":["trí thông minh","Tiếng Trung","thưởng thức","tuần trước"],"answer_index":0,"explanation":"지능 = trí thông minh"},{"question":"Từ 「첨부」 có nghĩa là gì?","options":["đính kèm","Tiếng Trung","thưởng thức","tuần trước"],"answer_index":0,"explanation":"첨부 = đính kèm"},{"question":"Từ 「최적」 có nghĩa là gì?","options":["tối ưu","Tiếng Trung","thưởng thức","tuần trước"],"answer_index":0,"explanation":"최적 = tối ưu"},{"question":"Từ 「취해」 có nghĩa là gì?","options":["say rượu","Tiếng Trung","thưởng thức","tuần trước"],"answer_index":0,"explanation":"취해 = say rượu