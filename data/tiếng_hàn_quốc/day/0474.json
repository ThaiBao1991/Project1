来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 474","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"폭스を 使います。","line_vi":"Tôi dùng 폭스.","focus_words":["폭스"]},{"speaker":"B","line_target":"폭염 は 何ですか。","line_vi":"폭염 là cái gì?","focus_words":["폭염"]},{"speaker":"A","line_target":"폴더です。","line_vi":"Đó là 폴더.","focus_words":["폴더"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e6678be5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「폭스」 có nghĩa là gì?","options":["cáo","đợt nắng nóng","thư mục","giao thức"],"answer_index":0,"explanation":"폭스 = cáo"},{"question":"Từ 「폭염」 có nghĩa là gì?","options":["đợt nắng nóng","cáo","thư mục","giao thức"],"answer_index":0,"explanation":"폭염 = đợt nắng nóng"},{"question":"Từ 「폴더」 có nghĩa là gì?","options":["thư mục","cáo","đợt nắng nóng","giao thức"],"answer_index":0,"explanation":"폴더 = thư mục"},{"question":"Từ 「프로토콜」 có nghĩa là gì?","options":["giao thức","cáo","đợt nắng nóng","thư mục"],"answer_index":0,"explanation":"프로토콜 = giao thức"},{"question":"Từ 「하와이」 có nghĩa là gì?","options":["hawaii","cáo","đợt nắng nóng","thư mục"],"answer_index":0,"explanation":"하와이 = hawaii"},{"question":"Từ 「학력」 có nghĩa là gì?","options":["giáo dục","cáo","đợt nắng nóng","thư mục"],"answer_index":0,"explanation":"학력 = giáo dục"},{"question":"Từ 「현명」 có nghĩa là gì?","options":["khôn ngoan","cáo","đợt nắng nóng","thư mục"],"answer_index":0,"explanation":"현명 = khôn n