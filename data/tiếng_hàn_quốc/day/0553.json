i dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 553","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"리우を 使います。","line_vi":"Tôi dùng 리우.","focus_words":["리우"]},{"speaker":"B","line_target":"마이너 は 何ですか。","line_vi":"마이너 là cái gì?","focus_words":["마이너"]},{"speaker":"A","line_target":"만점です。","line_vi":"Đó là 만점.","focus_words":["만점"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9b6b273c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「리우」 có nghĩa là gì?","options":["Rio","thứ yếu","điểm tuyệt đối","ở lại"],"answer_index":0,"explanation":"리우 = Rio"},{"question":"Từ 「마이너」 có nghĩa là gì?","options":["thứ yếu","Rio","điểm tuyệt đối","ở lại"],"answer_index":0,"explanation":"마이너 = thứ yếu"},{"question":"Từ 「만점」 có nghĩa là gì?","options":["điểm tuyệt đối","Rio","thứ yếu","ở lại"],"answer_index":0,"explanation":"만점 = điểm tuyệt đối"},{"question":"Từ 「머무르」 có nghĩa là gì?","options":["ở lại","Rio","thứ yếu","điểm tuyệt đối"],"answer_index":0,"explanation":"머무르 = ở lại"},{"question":"Từ 「모자라」 có nghĩa là gì?","options":["Không đủ","Rio","thứ yếu","điểm tuyệt đối"],"answer_index":0,"explanation":"모자라 = Không đủ"},{"question":"Từ 「물리학」 có nghĩa là gì?","options":["vật lý","Rio","thứ yếu","điểm tuyệt đối"],"answer_index":0,"explanation":"물리학 = vật lý"},{"question":"Từ 「바꾼」 có nghĩa là gì?","options":["đã thay đổi","Rio","thứ yếu","điểm tuyệt đối"],"answer_index":0,"explanation":"바꾼 = đã thay đổi"},{"question":"Từ 「발급」 có nghĩa là gì?","options":["ban hành","Rio","thứ yếu","điểm tuyệt đối"],"answer_index":