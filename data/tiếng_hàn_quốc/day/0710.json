ない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 710","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"증대を 使います。","line_vi":"Tôi dùng 증대.","focus_words":["증대"]},{"speaker":"B","line_target":"지출 は 何ですか。","line_vi":"지출 là cái gì?","focus_words":["지출"]},{"speaker":"A","line_target":"지칭です。","line_vi":"Đó là 지칭.","focus_words":["지칭"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「증대」 có nghĩa là gì?","options":["tăng lên","chi tiêu","tài liệu tham khảo","viết"],"answer_index":0,"explanation":"증대 = tăng lên"},{"question":"Từ 「지출」 có nghĩa là gì?","options":["chi tiêu","tăng lên","tài liệu tham khảo","viết"],"answer_index":0,"explanation":"지출 = chi tiêu"},{"question":"Từ 「지칭」 có nghĩa là gì?","options":["tài liệu tham khảo","tăng lên","chi tiêu","viết"],"answer_index":0,"explanation":"지칭 = tài liệu tham khảo"},{"question":"Từ 「집필」 có nghĩa là gì?","options":["viết","tăng lên","chi tiêu","tài liệu tham khảo"],"answer_index":0,"explanation":"집필 = viết"},{"question":"Từ 「처치」 có nghĩa là gì?","options":["Giết","tăng lên","chi tiêu","tài liệu tham khảo"],"answer_index":0,"explanation":"처치 = Giết"},{"question":"Từ 「최상」 có nghĩa là gì?","options":["tốt nhất","tăng lên","chi tiêu","tài liệu tham khảo"],"answer_index":0,"explanation":"최상 = tốt nhất"},{"question":"Từ 「컨테이너」 có nghĩa là gì?","options":["thùng chứa","tăng lên","chi tiêu","tài liệu tham khảo"],"answer_index":0,"explanation":"컨테이너 = thùng chứa"},{"question":"Từ 「코엑스」 có nghĩa là gì?","options":["COEX","tăng lên","chi tiêu","tài liệu tham khảo"],"answer_index":0,"explanation":"코엑스 = COEX"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tăng lên","options":["증대","지출","지칭","집필"],"answer_index":0,"explanation":"증대 = tăng lên"},{"q