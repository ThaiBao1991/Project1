ing_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1468","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"앙리を 使います。","line_vi":"Tôi dùng 앙리.","focus_words":["앙리"]},{"speaker":"B","line_target":"앙코르 は 何ですか。","line_vi":"앙코르 là cái gì?","focus_words":["앙코르"]},{"speaker":"A","line_target":"앞날です。","line_vi":"Đó là 앞날.","focus_words":["앞날"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「앙리」 có nghĩa là gì?","options":["Henri","encore","tương lai","Nó sẽ như thế nào?"],"answer_index":0,"explanation":"앙리 = Henri"},{"question":"Từ 「앙코르」 có nghĩa là gì?","options":["encore","Henri","tương lai","Nó sẽ như thế nào?"],"answer_index":0,"explanation":"앙코르 = encore"},{"question":"Từ 「앞날」 có nghĩa là gì?","options":["tương lai","Henri","encore","Nó sẽ như thế nào?"],"answer_index":0,"explanation":"앞날 = tương lai"},{"question":"Từ 「어떨지」 có nghĩa là gì?","options":["Nó sẽ như thế nào?","Henri","encore","tương lai"],"answer_index":0,"explanation":"어떨지 = Nó sẽ như thế nào?"},{"question":"Từ 「어울려요」 có nghĩa là gì?","options":["Nó phù hợp với bạn","Henri","encore","tương lai"],"answer_index":0,"explanation":"어울려요 = Nó phù hợp với bạn"},{"question":"Từ 「어주」 có nghĩa là gì?","options":["Ôi trời","Henri","encore","tương lai"],"answer_index":0,"explanation":"어주 = Ôi trời"},{"question":"Từ 「어쩌구」 có nghĩa là gì?","options":["bla","Henri","encore","tương lai"],"answer_index":0,"explanation":"어쩌구 = bla"},{"question":"Từ 「얽힌」 có nghĩa là gì?","options":["rối rắm","Henri","encore","tương lai"],"answer_index":0,"explanation":"얽힌 = rối rắm"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Henri","options":["앙리","앙코르","앞날","어떨지"],"answer_index":0,"explanation":"앙리 = Henri"},{"question":"Chọn từ đúng cho nghĩa: encore","options":["앙코르","앙리","앞날","어떨지"],"answer_index":0,