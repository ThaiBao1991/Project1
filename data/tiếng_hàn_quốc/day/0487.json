nciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 487","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"더러운を 使います。","line_vi":"Tôi dùng 더러운.","focus_words":["더러운"]},{"speaker":"B","line_target":"더럽 は 何ですか。","line_vi":"더럽 là cái gì?","focus_words":["더럽"]},{"speaker":"A","line_target":"도모です。","line_vi":"Đó là 도모.","focus_words":["도모"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_58d41fe9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「더러운」 có nghĩa là gì?","options":["dơ bẩn","Domo","quay lại","nhìn xung quanh"],"answer_index":0,"explanation":"더러운 = dơ bẩn"},{"question":"Từ 「더럽」 có nghĩa là gì?","options":["dơ bẩn","Domo","quay lại","nhìn xung quanh"],"answer_index":0,"explanation":"더럽 = dơ bẩn"},{"question":"Từ 「도모」 có nghĩa là gì?","options":["Domo","dơ bẩn","dơ bẩn","quay lại"],"answer_index":0,"explanation":"도모 = Domo"},{"question":"Từ 「돌아올」 có nghĩa là gì?","options":["quay lại","dơ bẩn","dơ bẩn","Domo"],"answer_index":0,"explanation":"돌아올 = quay lại"},{"question":"Từ 「둘러보」 có nghĩa là gì?","options":["nhìn xung quanh","dơ bẩn","dơ bẩn","Domo"],"answer_index":0,"explanation":"둘러보 = nhìn xung quanh"},{"question":"Từ 「들여」 có nghĩa là gì?","options":["trong","dơ bẩn","dơ bẩn","Domo"],"answer_index":0,"explanation":"들여 = trong"},{"question":"Từ 「라스」 có nghĩa là gì?","options":["las","dơ bẩn","dơ bẩn","Domo"],"answer_index":0,"explanation":"라스 = las"},{"question":"Từ 「루이」 có nghĩa là gì?","options":["Louis","dơ bẩn","dơ bẩn","Domo"],"answer_index":0,"explanation":"루이 = Louis"}],"pattern":[{"question":"Chọn từ đún