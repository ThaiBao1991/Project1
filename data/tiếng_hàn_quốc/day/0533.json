nai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 533","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"그리워を 使います。","line_vi":"Tôi dùng 그리워.","focus_words":["그리워"]},{"speaker":"B","line_target":"기술자 は 何ですか。","line_vi":"기술자 là cái gì?","focus_words":["기술자"]},{"speaker":"A","line_target":"나빠です。","line_vi":"Đó là 나빠.","focus_words":["나빠"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0ad52d57","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「그리워」 có nghĩa là gì?","options":["tôi nhớ bạn","kỹ thuật viên","tệ","bạn trai"],"answer_index":0,"explanation":"그리워 = tôi nhớ bạn"},{"question":"Từ 「기술자」 có nghĩa là gì?","options":["kỹ thuật viên","tôi nhớ bạn","tệ","bạn trai"],"answer_index":0,"explanation":"기술자 = kỹ thuật viên"},{"question":"Từ 「나빠」 có nghĩa là gì?","options":["tệ","tôi nhớ bạn","kỹ thuật viên","bạn trai"],"answer_index":0,"explanation":"나빠 = tệ"},{"question":"Từ 「남친」 có nghĩa là gì?","options":["bạn trai","tôi nhớ bạn","kỹ thuật viên","tệ"],"answer_index":0,"explanation":"남친 = bạn trai"},{"question":"Từ 「노아」 có nghĩa là gì?","options":["Nô-ê","tôi nhớ bạn","kỹ thuật viên","tệ"],"answer_index":0,"explanation":"노아 = Nô-ê"},{"question":"Từ 「놀래」 có nghĩa là gì?","options":["ngạc nhiên","tôi nhớ bạn","kỹ thuật viên","tệ"],"answer_index":0,"explanation":"놀래 = ngạc nhiên"},{"question":"Từ 「놓여」 có n