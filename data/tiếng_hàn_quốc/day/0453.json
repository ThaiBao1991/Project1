mple_target":"","example_vi":"","image_prompt":null,"image_ref":"m_95828dbe","audio_ref":"m_c8e3b80b","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_df526bbd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 453","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"안타を 使います。","line_vi":"Tôi dùng 안타.","focus_words":["안타"]},{"speaker":"B","line_target":"압축 は 何ですか。","line_vi":"압축 là cái gì?","focus_words":["압축"]},{"speaker":"A","line_target":"양국です。","line_vi":"Đó là 양국.","focus_words":["양국"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_851d746f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「안타」 có nghĩa là gì?","options":["lượt truy cập","nén","cả hai nước","lãnh thổ"],"answer_index":0,"explanation":"안타 = lượt truy cập"},{"question":"Từ 「압축」 có nghĩa là gì?","options":["nén","lượt truy cập","cả hai nước","lãnh thổ"],"answer_index":0,"explanation":"압축 = nén"},{"question":"Từ 「양국」 có nghĩa là gì?","options":["cả hai nước","lượt truy cập","nén","lãnh thổ"],"answer_index":0,"explanation":"양국 = cả hai nước"},{"question":"Từ 「영토」 có nghĩa là gì?","options":["lãnh thổ","lượt truy cập","nén","cả hai nước"],"answer_index":0,"explanation":"영토 = lãnh thổ"},{"question":"Từ 「예민」 có nghĩa là gì?","options":["nhạy cảm","lượt truy cập","nén","cả hai nước"],"answer_index":0,"explanation":"예민 = nhạy cảm"},{"question":"Từ 「예시」 có nghĩa là gì?","options":["ví dụ","lượt truy cập","nén","cả hai nước"],"answer_index":0,"explanation":"예시 = ví dụ"},{"question":"Từ 「오페라」 có nghĩa là gì?","options":["opera","lượt truy cập","nén","cả hai nước"],"answer_index":0,"explanation":"오페라 = opera"},{"question":"Từ 「올바른」 có nghĩa là gì?","options":["đúng","lượt truy cập","nén","cả hai nước"],"answer_index":0,"explanation":"올바른 = đúng"}],"pattern":[{"quest