ote":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a0aba024","audio_ref":"m_fdf1532b","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_297137ed"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 578","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"예매を 使います。","line_vi":"Tôi dùng 예매.","focus_words":["예매"]},{"speaker":"B","line_target":"예배 は 何ですか。","line_vi":"예배 là cái gì?","focus_words":["예배"]},{"speaker":"A","line_target":"옥상です。","line_vi":"Đó là 옥상.","focus_words":["옥상"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_57090f18","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「예매」 có nghĩa là gì?","options":["Đặt chỗ","tôn sùng","mái nhà","phẫu thuật"],"answer_index":0,"explanation":"예매 = Đặt chỗ"},{"question":"Từ 「예배」 có nghĩa là gì?","options":["tôn sùng","Đặt chỗ","mái nhà","phẫu thuật"],"answer_index":0,"explanation":"예배 = tôn sùng"},{"question":"Từ 「옥상」 có nghĩa là gì?","options":["mái nhà","Đặt chỗ","tôn sùng","phẫu thuật"],"answer_index":0,"explanation":"옥상 = mái nhà"},{"question":"Từ 「외과」 có nghĩa là gì?","options":["phẫu thuật","Đặt chỗ","tôn sùng","mái nhà"],"answer_index":0,"explanation":"외과 = phẫu thuật"},{"question":"Từ 「웨이브」 có nghĩa là gì?","options":["làn sóng","Đặt chỗ","tôn sùng","mái nhà"],"answer_index":0,"explanation":"웨이브 = làn sóng"},{"question":"Từ 「유무」 có nghĩa là gì?","options":["sự hiện diện hay vắng mặt","Đặt chỗ","tôn sùng","mái nhà"],"answer_index":0,"explanation":"유무 = sự hiện diện hay vắng mặt"},{"question":"Từ 「유키」 có nghĩa là gì?","options":["Yuki","Đặt chỗ","tôn sùng","mái nhà"]