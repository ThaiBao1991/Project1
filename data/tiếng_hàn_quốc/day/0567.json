onetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c6578b11","audio_ref":"m_6a396d40","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_597dca02"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 567","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"외면を 使います。","line_vi":"Tôi dùng 외면.","focus_words":["외면"]},{"speaker":"B","line_target":"요가 は 何ですか。","line_vi":"요가 là cái gì?","focus_words":["요가"]},{"speaker":"A","line_target":"울프です。","line_vi":"Đó là 울프.","focus_words":["울프"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_31d61f58","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「외면」 có nghĩa là gì?","options":["quay đi","yoga","chó sói","buồn cười"],"answer_index":0,"explanation":"외면 = quay đi"},{"question":"Từ 「요가」 có nghĩa là gì?","options":["yoga","quay đi","chó sói","buồn cười"],"answer_index":0,"explanation":"요가 = yoga"},{"question":"Từ 「울프」 có nghĩa là gì?","options":["chó sói","quay đi","yoga","buồn cười"],"answer_index":0,"explanation":"울프 = chó sói"},{"question":"Từ 「웃긴」 có nghĩa là gì?","options":["buồn cười","quay đi","yoga","chó sói"],"answer_index":0,"explanation":"웃긴 = buồn cười"},{"question":"Từ 「위안」 có nghĩa là gì?","options":["sự thoải mái","quay đi","yoga","chó sói"],"answer_index":0,"explanation":"위안 = sự thoải mái"},{"question":"Từ 「유족」 có nghĩa là gì?","options":["gia đình tang quyến","quay đi","yoga","chó sói"],"answer_index":0,"explanation":"유족 = gia đình tang quyến"},{"question":"Từ 「이것저것」 có nghĩa là gì?","options":["cái này cái kia","quay đi","yoga","chó sói"],"answer_index":0,"explanation":"이것저것 = cái này cái kia"},{"question":"Từ 「이요」 có nghĩa là gì?","options":["Đâ