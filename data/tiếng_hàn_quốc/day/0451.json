s":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a0ae7e44","audio_ref":"m_f0a403bd","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_91ec656d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 451","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"본능を 使います。","line_vi":"Tôi dùng 본능.","focus_words":["본능"]},{"speaker":"B","line_target":"분포 は 何ですか。","line_vi":"분포 là cái gì?","focus_words":["분포"]},{"speaker":"A","line_target":"분해です。","line_vi":"Đó là 분해.","focus_words":["분해"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f1dd9bf7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「본능」 có nghĩa là gì?","options":["bản năng","phân phối","sự phân hủy","điện thờ"],"answer_index":0,"explanation":"본능 = bản năng"},{"question":"Từ 「분포」 có nghĩa là gì?","options":["phân phối","bản năng","sự phân hủy","điện thờ"],"answer_index":0,"explanation":"분포 = phân phối"},{"question":"Từ 「분해」 có nghĩa là gì?","options":["sự phân hủy","bản năng","phân phối","điện thờ"],"answer_index":0,"explanation":"분해 = sự phân hủy"},{"question":"Từ 「사당」 có nghĩa là gì?","options":["điện thờ","bản năng","phân phối","sự phân hủy"],"answer_index":0,"explanation":"사당 = điện thờ"},{"question":"Từ 「사도」 có nghĩa là gì?","options":["sứ đồ","bản năng","phân phối","sự phân hủy"],"answer_index":0,"explanation":"사도 = sứ đồ"},{"question":"Từ 「사드」 có nghĩa là gì?","options":["THAAD","bản năng","phân phối","sự phân hủy"],"answer_index":0,"explanation":"사드 = THAAD"},{"question":"Từ 「상금」 có nghĩa là gì?","options":["tiền thưởng","bản năng","phân phối","sự phân hủy"],"answer_index":0,"explanation":"상금 = tiền thưởng"},{"question":"Từ 「선포」 có nghĩa là gì?","options":["lời tuyên bố","bản năng","phân phối","sự phân hủy"],"answer_in