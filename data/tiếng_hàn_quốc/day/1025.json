 Ngày 1025","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"단결を 使います。","line_vi":"Tôi dùng 단결.","focus_words":["단결"]},{"speaker":"B","line_target":"단말기 は 何ですか。","line_vi":"단말기 là cái gì?","focus_words":["단말기"]},{"speaker":"A","line_target":"단자です。","line_vi":"Đó là 단자.","focus_words":["단자"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「단결」 có nghĩa là gì?","options":["đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối","lỗi"],"answer_index":0,"explanation":"단결 = đoàn kết"},{"question":"Từ 「단말기」 có nghĩa là gì?","options":["thiết bị đầu cuối","đoàn kết","lỗi","bám vào"],"answer_index":0,"explanation":"단말기 = thiết bị đầu cuối"},{"question":"Từ 「단자」 có nghĩa là gì?","options":["thiết bị đầu cuối","đoàn kết","lỗi","bám vào"],"answer_index":0,"explanation":"단자 = thiết bị đầu cuối"},{"question":"Từ 「단층」 có nghĩa là gì?","options":["lỗi","đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối"],"answer_index":0,"explanation":"단층 = lỗi"},{"question":"Từ 「달라붙」 có nghĩa là gì?","options":["bám vào","đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối"],"answer_index":0,"explanation":"달라붙 = bám vào"},{"question":"Từ 「당당히」 có nghĩa là gì?","options":["tự tin","đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối"],"answer_index":0,"explanation":"당당히 = tự tin"},{"question":"Từ 「데려」 có nghĩa là gì?","options":["đưa tôi đi","đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối"],"answer_index":0,"explanation":"데려 = đưa tôi đi"},{"question":"Từ 「동공」 có nghĩa là gì?","options":["học sinh","đoàn kết","thiết bị đầu cuối","thiết bị đầu cuối"],"answer_index":0,"explanation":"동공 = học sinh"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đoàn kết","options":["단결","단말기","단자","단층"],"answer_index":0,"explanation":"단결 = đoàn kết"},{"qu