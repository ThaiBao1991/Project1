ng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1682","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"흐려を 使います。","line_vi":"Tôi dùng 흐려.","focus_words":["흐려"]},{"speaker":"B","line_target":"흐른 は 何ですか。","line_vi":"흐른 là cái gì?","focus_words":["흐른"]},{"speaker":"A","line_target":"흑자です。","line_vi":"Đó là 흑자.","focus_words":["흑자"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「흐려」 có nghĩa là gì?","options":["nhiều mây","chảy","dư thừa","ướt đẫm"],"answer_index":0,"explanation":"흐려 = nhiều mây"},{"question":"Từ 「흐른」 có nghĩa là gì?","options":["chảy","nhiều mây","dư thừa","ướt đẫm"],"answer_index":0,"explanation":"흐른 = chảy"},{"question":"Từ 「흑자」 có nghĩa là gì?","options":["dư thừa","nhiều mây","chảy","ướt đẫm"],"answer_index":0,"explanation":"흑자 = dư thừa"},{"question":"Từ 「흠뻑」 có nghĩa là gì?","options":["ướt đẫm","nhiều mây","chảy","dư thừa"],"answer_index":0,"explanation":"흠뻑 = ướt đẫm"},{"question":"Từ 「힉스」 có nghĩa là gì?","options":["hic","nhiều mây","chảy","dư thừa"],"answer_index":0,"explanation":"힉스 = hic"},{"question":"Từ 「힘든데」 có nghĩa là gì?","options":["Thật khó","nhiều mây","chảy","dư thừa"],"answer_index":0,"explanation":"힘든데 = Thật khó"},{"question":"Từ 「akb」 có nghĩa là gì?","options":["akb","nhiều mây","chảy","dư thừa"],"answer_index":0,"explanation":"akb = akb"},{"question":"Từ 「chapter」 có nghĩa là gì?","options":["chương","nhiều mây","chảy","dư thừa"],"answer_index":0,"explanation":"chapter = chương"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nhiều mây","options":["흐려","흐른","흑자","흠뻑"],"answer_index":0,"explanation":"흐려 = nhiều mây"},{"question":"Chọn từ đúng cho nghĩa: chảy","options":["흐른","흐려","흑자","흠뻑"],"answer_index":0,"explanation":"흐른 = chảy"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}}