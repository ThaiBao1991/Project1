uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"으악を 使います。","line_vi":"Tôi dùng 으악.","focus_words":["으악"]},{"speaker":"B","line_target":"음주운전 は 何ですか。","line_vi":"음주운전 là cái gì?","focus_words":["음주운전"]},{"speaker":"A","line_target":"음직です。","line_vi":"Đó là 음직.","focus_words":["음직"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「으악」 có nghĩa là gì?","options":["Ờ","lái xe say rượu","âm nhạc","Bên này"],"answer_index":0,"explanation":"으악 = Ờ"},{"question":"Từ 「음주운전」 có nghĩa là gì?","options":["lái xe say rượu","Ờ","âm nhạc","Bên này"],"answer_index":0,"explanation":"음주운전 = lái xe say rượu"},{"question":"Từ 「음직」 có nghĩa là gì?","options":["âm nhạc","Ờ","lái xe say rượu","Bên này"],"answer_index":0,"explanation":"음직 = âm nhạc"},{"question":"Từ 「이면」 có nghĩa là gì?","options":["Bên này","Ờ","lái xe say rượu","âm nhạc"],"answer_index":0,"explanation":"이면 = Bên này"},{"question":"Từ 「이삭」 có nghĩa là gì?","options":["Isaac","Ờ","lái xe say rượu","âm nhạc"],"answer_index":0,"explanation":"이삭 = Isaac"},{"question":"Từ 「이웃집」 có nghĩa là gì?","options":["bên cạnh","Ờ","lái xe say rượu","âm nhạc"],"answer_index":0,"explanation":"이웃집 = bên cạnh"},{"question":"Từ 「일기장」 có nghĩa là gì?","options":["nhật ký","Ờ","lái xe say rượu","âm nhạc"],"answer_index":0,"explanation":"일기장 = nhật ký"},{"question":"Từ 「일선」 có nghĩa là gì?","options":["tiền tuyến","Ờ","lái xe say rượu","âm nhạc"],"answer_index":0,"explanation":"일선 = tiền tuyến"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Ờ","options":["으악","음주운전","음직","이면"],"answer_index":0,"explanation":"으악 = Ờ"},{"question":"Chọn từ đúng cho nghĩa: lái xe say rượu","options":["음주운전","으악","음직","이면"],"answer_index":0,"explanation":"음주운전 = lái xe say rượu"}],"common":[],"gr