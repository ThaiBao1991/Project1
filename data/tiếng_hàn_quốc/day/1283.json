 — Ngày 1283","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"생김새を 使います。","line_vi":"Tôi dùng 생김새.","focus_words":["생김새"]},{"speaker":"B","line_target":"서운 は 何ですか。","line_vi":"서운 là cái gì?","focus_words":["서운"]},{"speaker":"A","line_target":"소송법です。","line_vi":"Đó là 소송법.","focus_words":["소송법"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「생김새」 có nghĩa là gì?","options":["Ngoại hình","buồn","luật tố tụng","bình chữa cháy"],"answer_index":0,"explanation":"생김새 = Ngoại hình"},{"question":"Từ 「서운」 có nghĩa là gì?","options":["buồn","Ngoại hình","luật tố tụng","bình chữa cháy"],"answer_index":0,"explanation":"서운 = buồn"},{"question":"Từ 「소송법」 có nghĩa là gì?","options":["luật tố tụng","Ngoại hình","buồn","bình chữa cháy"],"answer_index":0,"explanation":"소송법 = luật tố tụng"},{"question":"Từ 「소화기」 có nghĩa là gì?","options":["bình chữa cháy","Ngoại hình","buồn","luật tố tụng"],"answer_index":0,"explanation":"소화기 = bình chữa cháy"},{"question":"Từ 「손수」 có nghĩa là gì?","options":["làm bằng tay","Ngoại hình","buồn","luật tố tụng"],"answer_index":0,"explanation":"손수 = làm bằng tay"},{"question":"Từ 「쇄골」 có nghĩa là gì?","options":["xương đòn","Ngoại hình","buồn","luật tố tụng"],"answer_index":0,"explanation":"쇄골 = xương đòn"},{"question":"Từ 「수력」 có nghĩa là gì?","options":["năng lượng nước","Ngoại hình","buồn","luật tố tụng"],"answer_index":0,"explanation":"수력 = năng lượng nước"},{"question":"Từ 「수서」 có nghĩa là gì?","options":["Suseo","Ngoại hình","buồn","luật tố tụng"],"answer_index":0,"explanation":"수서 = Suseo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Ngoại hình","options":["생김새","서운","소송법","소화기"],"answer_index":0,"explanation":"생김새 = Ngoại hình"},{"question":"Chọn từ đúng cho nghĩa: buồn