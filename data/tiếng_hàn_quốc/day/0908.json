 Ngày 908","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"퍼시픽を 使います。","line_vi":"Tôi dùng 퍼시픽.","focus_words":["퍼시픽"]},{"speaker":"B","line_target":"페루 は 何ですか。","line_vi":"페루 là cái gì?","focus_words":["페루"]},{"speaker":"A","line_target":"편곡です。","line_vi":"Đó là 편곡.","focus_words":["편곡"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「퍼시픽」 có nghĩa là gì?","options":["Thái Bình Dương","peru","sự sắp xếp","bằng phẳng"],"answer_index":0,"explanation":"퍼시픽 = Thái Bình Dương"},{"question":"Từ 「페루」 có nghĩa là gì?","options":["peru","Thái Bình Dương","sự sắp xếp","bằng phẳng"],"answer_index":0,"explanation":"페루 = peru"},{"question":"Từ 「편곡」 có nghĩa là gì?","options":["sự sắp xếp","Thái Bình Dương","peru","bằng phẳng"],"answer_index":0,"explanation":"편곡 = sự sắp xếp"},{"question":"Từ 「평평」 có nghĩa là gì?","options":["bằng phẳng","Thái Bình Dương","peru","sự sắp xếp"],"answer_index":0,"explanation":"평평 = bằng phẳng"},{"question":"Từ 「푸르」 có nghĩa là gì?","options":["tinh khiết","Thái Bình Dương","peru","sự sắp xếp"],"answer_index":0,"explanation":"푸르 = tinh khiết"},{"question":"Từ 「풀렸」 có nghĩa là gì?","options":["phát hành","Thái Bình Dương","peru","sự sắp xếp"],"answer_index":0,"explanation":"풀렸 = phát hành"},{"question":"Từ 「프린터」 có nghĩa là gì?","options":["máy in","Thái Bình Dương","peru","sự sắp xếp"],"answer_index":0,"explanation":"프린터 = máy in"},{"question":"Từ 「플라자」 có nghĩa là gì?","options":["Quảng trường","Thái Bình Dương","peru","sự sắp xếp"],"answer_index":0,"explanation":"플라자 = Quảng trường"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Thái Bình Dương","options":["퍼시픽","페루","편곡","평평"],"answer_index":0,"explanation":"퍼시픽 = Thái Bình Dương"},{"question":"Chọn từ đúng cho nghĩa: per