ferences":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2366","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"오디세이を 使います。","line_vi":"Tôi dùng 오디세이.","focus_words":["오디세이"]},{"speaker":"B","line_target":"오송 は 何ですか。","line_vi":"오송 là cái gì?","focus_words":["오송"]},{"speaker":"A","line_target":"와선です。","line_vi":"Đó là 와선.","focus_words":["와선"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「오디세이」 có nghĩa là gì?","options":["cuộc phiêu lưu","Osong","Wa-seon","Vương Sĩ"],"answer_index":0,"explanation":"오디세이 = cuộc phiêu lưu"},{"question":"Từ 「오송」 có nghĩa là gì?","options":["Osong","cuộc phiêu lưu","Wa-seon","Vương Sĩ"],"answer_index":0,"explanation":"오송 = Osong"},{"question":"Từ 「와선」 có nghĩa là gì?","options":["Wa-seon","cuộc phiêu lưu","Osong","Vương Sĩ"],"answer_index":0,"explanation":"와선 = Wa-seon"},{"question":"Từ 「왕시」 có nghĩa là gì?","options":["Vương Sĩ","cuộc phiêu lưu","Osong","Wa-seon"],"answer_index":0,"explanation":"왕시 = Vương Sĩ"},{"question":"Từ 「요리법」 có nghĩa là gì?","options":["Công thức nấu ăn","cuộc phiêu lưu","Osong","Wa-seon"],"answer_index":0,"explanation":"요리법 = Công thức nấu ăn"},{"question":"Từ 「울린」 có nghĩa là gì?","options":["reo","cuộc phiêu lưu","Osong","Wa-seon"],"answer_index":0,"explanation":"울린 = reo"},{"question":"Từ 「울릴」 có nghĩa là gì?","options":["Nó sẽ đổ chuông","cuộc phiêu lưu","Osong","Wa-seon"],"answer_index":0,"explanation":"울릴 = Nó sẽ đổ chuông"},{"question":"Từ 「원금」 có nghĩa là gì?","options":["hiệu trưởng","cuộc phiêu lưu","Osong","Wa-seon"],"answer_index":0,"explanation":"원금 = hiệu trưởng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cuộc phiêu lưu","options":["오디세이","오송","와선","왕시"],"answer_index":0,"explanation":"오디세이 = cuộc phiêu lưu"},{"