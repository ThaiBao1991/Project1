ronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 517","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"권고を 使います。","line_vi":"Tôi dùng 권고.","focus_words":["권고"]},{"speaker":"B","line_target":"그렸 は 何ですか。","line_vi":"그렸 là cái gì?","focus_words":["그렸"]},{"speaker":"A","line_target":"난민です。","line_vi":"Đó là 난민.","focus_words":["난민"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1713544e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「권고」 có nghĩa là gì?","options":["khuyến nghị","đã vẽ","người tị nạn","bay đi"],"answer_index":0,"explanation":"권고 = khuyến nghị"},{"question":"Từ 「그렸」 có nghĩa là gì?","options":["đã vẽ","khuyến nghị","người tị nạn","bay đi"],"answer_index":0,"explanation":"그렸 = đã vẽ"},{"question":"Từ 「난민」 có nghĩa là gì?","options":["người tị nạn","khuyến nghị","đã vẽ","bay đi"],"answer_index":0,"explanation":"난민 = người tị nạn"},{"question":"Từ 「날아가」 có nghĩa là gì?","options":["bay đi","khuyến nghị","đã vẽ","người tị nạn"],"answer_index":0,"explanation":"날아가 = bay đi"},{"question":"Từ 「내기」 có nghĩa là gì?","options":["cá cược","khuyến nghị","đã vẽ","người tị nạn"],"answer_index":0,"explanation":"내기 = cá cược"},{"question":"Từ 「내려놓」 có nghĩa là gì?","options":["Đặt nó xuống","khuyến nghị","đã vẽ","người tị nạn"],"answer_index":0,"explanation":"내려놓 = Đặt nó xuống"},{"question":"Từ 「대왕」 có nghĩa là gì?","options":["vị vua vĩ đại","khuyến nghị","đã vẽ","người tị nạn"],"answer_index":0,"explanation":"대왕 = vị vua vĩ đại"},{"question":"Từ 「대접」 có nghĩa là gì?","options":["đối xử","khu