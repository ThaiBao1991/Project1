ずです"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1452","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"포티を 使います。","line_vi":"Tôi dùng 포티.","focus_words":["포티"]},{"speaker":"B","line_target":"풍습 は 何ですか。","line_vi":"풍습 là cái gì?","focus_words":["풍습"]},{"speaker":"A","line_target":"하얼빈です。","line_vi":"Đó là 하얼빈.","focus_words":["하얼빈"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「포티」 có nghĩa là gì?","options":["bốn mươi","hải quan","Cáp Nhĩ Tân","món ăn hàn quốc"],"answer_index":0,"explanation":"포티 = bốn mươi"},{"question":"Từ 「풍습」 có nghĩa là gì?","options":["hải quan","bốn mươi","Cáp Nhĩ Tân","món ăn hàn quốc"],"answer_index":0,"explanation":"풍습 = hải quan"},{"question":"Từ 「하얼빈」 có nghĩa là gì?","options":["Cáp Nhĩ Tân","bốn mươi","hải quan","món ăn hàn quốc"],"answer_index":0,"explanation":"하얼빈 = Cáp Nhĩ Tân"},{"question":"Từ 「한식」 có nghĩa là gì?","options":["món ăn hàn quốc","bốn mươi","hải quan","Cáp Nhĩ Tân"],"answer_index":0,"explanation":"한식 = món ăn hàn quốc"},{"question":"Từ 「해경」 có nghĩa là gì?","options":["bảo vệ bờ biển","bốn mươi","hải quan","Cáp Nhĩ Tân"],"answer_index":0,"explanation":"해경 = bảo vệ bờ biển"},{"question":"Từ 「해법」 có nghĩa là gì?","options":["giải pháp","bốn mươi","hải quan","Cáp Nhĩ Tân"],"answer_index":0,"explanation":"해법 = giải pháp"},{"question":"Từ 「해부학」 có nghĩa là gì?","options":["giải phẫu","bốn mươi","hải quan","Cáp Nhĩ Tân"],"answer_index":0,"explanation":"해부학 = giải phẫu"},{"question":"Từ 「행세」 có nghĩa là gì?","options":["giả vờ","bốn mươi","hải quan","Cáp Nhĩ Tân"],"answer_index":0,"explanation":"행세 = giả vờ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bốn mươi","options":["포티","풍습","하얼빈","한식"],"answer_index":0,"explanati