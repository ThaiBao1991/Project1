entence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 757","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"명분を 使います。","line_vi":"Tôi dùng 명분.","focus_words":["명분"]},{"speaker":"B","line_target":"모기 は 何ですか。","line_vi":"모기 là cái gì?","focus_words":["모기"]},{"speaker":"A","line_target":"모셔です。","line_vi":"Đó là 모셔.","focus_words":["모셔"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「명분」 có nghĩa là gì?","options":["sự biện minh","muỗi","Mang chúng lại với nhau","ngẫu nhiên"],"answer_index":0,"explanation":"명분 = sự biện minh"},{"question":"Từ 「모기」 có nghĩa là gì?","options":["muỗi","sự biện minh","Mang chúng lại với nhau","ngẫu nhiên"],"answer_index":0,"explanation":"모기 = muỗi"},{"question":"Từ 「모셔」 có nghĩa là gì?","options":["Mang chúng lại với nhau","sự biện minh","muỗi","ngẫu nhiên"],"answer_index":0,"explanation":"모셔 = Mang chúng lại với nhau"},{"question":"Từ 「무작위」 có nghĩa là gì?","options":["ngẫu nhiên","sự biện minh","muỗi","Mang chúng lại với nhau"],"answer_index":0,"explanation":"무작위 = ngẫu nhiên"},{"question":"Từ 「미스터리」 có nghĩa là gì?","options":["bí ẩn","sự biện minh","muỗi","Mang chúng lại với nhau"],"answer_index":0,"explanation":"미스터리 = bí ẩn"},{"question":"Từ 「미얀마」 có nghĩa là gì?","options":["Myanmar","sự biện minh","muỗi","Mang chúng lại với nhau"],"answer_index":0,"explanation":"미얀마 = Myanmar"},{"question":"Từ 「받아들였」 có nghĩa là gì?","options":["được chấp nhận","sự biện minh","muỗi","Mang chúng lại với nhau"],"answer_index":0,"explanation":"받아들였 = được chấp nhận"},{"question":"Từ 「발가락」 có nghĩa là gì?","options":["ngón chân","sự biện minh","muỗi","Mang chúng lại với nhau"],"answer_index":0,"explanation":"발가락 = ngón chân"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sự biện minh","options":["명분","모기","모셔","무작위"],"answer_index