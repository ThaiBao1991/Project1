[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1121","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"문화원を 使います。","line_vi":"Tôi dùng 문화원.","focus_words":["문화원"]},{"speaker":"B","line_target":"미오 は 何ですか。","line_vi":"미오 là cái gì?","focus_words":["미오"]},{"speaker":"A","line_target":"민영화です。","line_vi":"Đó là 민영화.","focus_words":["민영화"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「문화원」 có nghĩa là gì?","options":["trung tâm văn hóa","mio","tư nhân hóa","tôi đang bận"],"answer_index":0,"explanation":"문화원 = trung tâm văn hóa"},{"question":"Từ 「미오」 có nghĩa là gì?","options":["mio","trung tâm văn hóa","tư nhân hóa","tôi đang bận"],"answer_index":0,"explanation":"미오 = mio"},{"question":"Từ 「민영화」 có nghĩa là gì?","options":["tư nhân hóa","trung tâm văn hóa","mio","tôi đang bận"],"answer_index":0,"explanation":"민영화 = tư nhân hóa"},{"question":"Từ 「바빴」 có nghĩa là gì?","options":["tôi đang bận","trung tâm văn hóa","mio","tư nhân hóa"],"answer_index":0,"explanation":"바빴 = tôi đang bận"},{"question":"Từ 「박명수」 có nghĩa là gì?","options":["Park Myung Soo","trung tâm văn hóa","mio","tư nhân hóa"],"answer_index":0,"explanation":"박명수 = Park Myung Soo"},{"question":"Từ 「발판」 có nghĩa là gì?","options":["giàn giáo","trung tâm văn hóa","mio","tư nhân hóa"],"answer_index":0,"explanation":"발판 = giàn giáo"},{"question":"Từ 「방언」 có nghĩa là gì?","options":["phương ngữ","trung tâm văn hóa","mio","tư nhân hóa"],"answer_index":0,"explanation":"방언 = phương ngữ"},{"question":"Từ 「변장」 có nghĩa là gì?","options":["cải trang","trung tâm văn hóa","mio","tư nhân hóa"],"answer_index":0,"explanation":"변장 = cải trang"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: trung tâm văn hóa","options":["문화원","미오","민영화","바빴"],"answer_index":0,"explanation":"문화원 = trung tâm văn hóa"},{"question":"Chọn từ đúng cho nghĩ