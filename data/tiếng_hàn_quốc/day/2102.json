_vi":"Tôi dùng 죄목.","focus_words":["죄목"]},{"speaker":"B","line_target":"주간지 は 何ですか。","line_vi":"주간지 là cái gì?","focus_words":["주간지"]},{"speaker":"A","line_target":"주리です。","line_vi":"Đó là 주리.","focus_words":["주리"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「죄목」 có nghĩa là gì?","options":["tội ác","tạp chí hàng tuần","Juri","đưa ra"],"answer_index":0,"explanation":"죄목 = tội ác"},{"question":"Từ 「주간지」 có nghĩa là gì?","options":["tạp chí hàng tuần","tội ác","Juri","đưa ra"],"answer_index":0,"explanation":"주간지 = tạp chí hàng tuần"},{"question":"Từ 「주리」 có nghĩa là gì?","options":["Juri","tội ác","tạp chí hàng tuần","đưa ra"],"answer_index":0,"explanation":"주리 = Juri"},{"question":"Từ 「주신」 có nghĩa là gì?","options":["đưa ra","tội ác","tạp chí hàng tuần","Juri"],"answer_index":0,"explanation":"주신 = đưa ra"},{"question":"Từ 「주종」 có nghĩa là gì?","options":["chủ và đầy tớ","tội ác","tạp chí hàng tuần","Juri"],"answer_index":0,"explanation":"주종 = chủ và đầy tớ"},{"question":"Từ 「주최자」 có nghĩa là gì?","options":["người tổ chức","tội ác","tạp chí hàng tuần","Juri"],"answer_index":0,"explanation":"주최자 = người tổ chức"},{"question":"Từ 「중진」 có nghĩa là gì?","options":["tầng lớp trung lưu","tội ác","tạp chí hàng tuần","Juri"],"answer_index":0,"explanation":"중진 = tầng lớp trung lưu"},{"question":"Từ 「지겨워」 có nghĩa là gì?","options":["tôi chán","tội ác","tạp chí hàng tuần","Juri"],"answer_index":0,"explanation":"지겨워 = tôi chán"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: tội ác","options":["죄목","주간지","주리","주신"],"answer_index":0,"explanation":"죄목 = tội ác"},{"question":"Chọn từ đúng cho nghĩa: tạp chí hàng tuần","options":["주간지","죄목","주리","주신"],"answer_index":0,"explanation":"주간지 = tạp chí hàng tuần"}],"common":[],"grammar":[],"mixed":[]},"source":"offline",