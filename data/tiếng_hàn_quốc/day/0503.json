_target":"","example_vi":"","image_prompt":null,"image_ref":"m_46fa0efe","audio_ref":"m_f1c1aa06","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_da8c92d9"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Quá khứ xa (〜た)","level":"N3","explanation":"Ngữ cảnh quá khứ: 子供の時に、学校に通っていました.","examples":[{"sentence":"子供の頃、学校に通っていました。","meaning_vi":"Thời thơ ấy tôi có đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]},{"title":"So sánh mức độ (〜より)","level":"N2","explanation":"Câu so sánh: 大阪より大阪のほうが大きい.","examples":[{"sentence":"大阪のほうが大きいです。","meaning_vi":"Osaka lớn hơn."},{"sentence":"月曜日より土曜日の方が楽しい。","meaning_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]},{"title":"Phủ định một phần (〜わけではない)","level":"N2","explanation":"〜わけではない = không hẳn là: 嫌いなわけではない.","examples":[{"sentence":"嫌いなわけではありません。","meaning_vi":"Không hẳn là ghét."},{"sentence":"行かないわけではありません。","meaning_vi":"Không phải là không đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]},{"title":"Mức độ lịch sự (kính ngữ/thân mật)","level":"N2","explanation":"Khách hàng ⇒ 伺います/いただきます; bạn bè ⇒ 行きます/食べます.","examples":[{"sentence":"明日 Quarter 伺います。","meaning_vi":"Ngày mai tôi sẽ ghé quý vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 503","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"재직を 使います。","line_vi":"Tôi dùng 재직.","focus_words":["재직"]},{"speaker":"B","line_target":"정교 は 何ですか。","line_vi":"정교 là cái gì?","focus_words":["정교"]},{"speaker":"A","line_target":"정밀です。","line_vi":"Đó là 정밀.","focus_words":["정밀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f1e0eda8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「재직」 có nghĩa là gì?","options":["nhiệm kỳ","tỉ mỉ","độ chính xác","sự sửa chữa"],"answer_index":0,"explanation":"재직 = nhiệm kỳ"},{"question":"Từ 「정교」 có nghĩa là gì?","options":["tỉ mỉ","nhiệm kỳ","độ chính xác","sự sửa chữa"],"answer_index":0,"explanation":"정교 = tỉ mỉ"},{"question":"Từ 「정밀」 có nghĩa là gì?","options":["độ chính xác","nhiệm kỳ","tỉ mỉ","sự sửa chữa"],"answer_index":0,"explanation":"정밀 = độ chính xác"},{"question":"Từ 「정정」 có nghĩa là gì?","options":["sự sửa chữa","nhiệm kỳ","tỉ mỉ","độ chính xác"],"answer_index":0,"explanation":"정정 = sự sửa chữa"},{"question":"Từ 「조류」 có nghĩa là gì?","options":["chim","nhiệm kỳ","tỉ mỉ","độ chính xác"],"answer_index":0,"explanation":"조류 = chim"},{"question":"Từ 「조종사」 có nghĩa là gì?","options":["phi công","nhiệm kỳ","tỉ mỉ","độ chính xác"],"answer_index":0,"explanation":"조종사 = phi công"},{"question":"Từ 「주름」 có nghĩa là gì?","options":["nếp nhăn","nhiệm kỳ","tỉ mỉ","độ chính xác"],"answer_index":0,"explanation":"주름 = nếp nhăn"},{"question":"Từ 「죽일」 có nghĩa là gì?","options":["giết",