":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2498","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"밀렵を 使います。","line_vi":"Tôi dùng 밀렵.","focus_words":["밀렵"]},{"speaker":"B","line_target":"바리스타 は 何ですか。","line_vi":"바리스타 là cái gì?","focus_words":["바리스타"]},{"speaker":"A","line_target":"박대です。","line_vi":"Đó là 박대.","focus_words":["박대"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「밀렵」 có nghĩa là gì?","options":["sự săn trộm","thợ pha cà phê","Park Dae","Park Young Soo"],"answer_index":0,"explanation":"밀렵 = sự săn trộm"},{"question":"Từ 「바리스타」 có nghĩa là gì?","options":["thợ pha cà phê","sự săn trộm","Park Dae","Park Young Soo"],"answer_index":0,"explanation":"바리스타 = thợ pha cà phê"},{"question":"Từ 「박대」 có nghĩa là gì?","options":["Park Dae","sự săn trộm","thợ pha cà phê","Park Young Soo"],"answer_index":0,"explanation":"박대 = Park Dae"},{"question":"Từ 「박영수」 có nghĩa là gì?","options":["Park Young Soo","sự săn trộm","thợ pha cà phê","Park Dae"],"answer_index":0,"explanation":"박영수 = Park Young Soo"},{"question":"Từ 「반가」 có nghĩa là gì?","options":["Rất vui được gặp bạn","sự săn trộm","thợ pha cà phê","Park Dae"],"answer_index":0,"explanation":"반가 = Rất vui được gặp bạn"},{"question":"Từ 「밥통」 có nghĩa là gì?","options":["giỏ bánh mỳ","sự săn trộm","thợ pha cà phê","Park Dae"],"answer_index":0,"explanation":"밥통 = giỏ bánh mỳ"},{"question":"Từ 「배틀로얄」 có nghĩa là gì?","options":["Trận chiến Hoàng gia","sự săn trộm","thợ pha cà phê","Park Dae"],"answer_index":0,"explanation":"배틀로얄 = Trận chiến Hoàng gia"},{"question":"Từ 「백두대간」 có nghĩa là gì?","options":["Baekdu Daegan","sự săn trộm","thợ pha cà phê","Park Dae"],"answer_index":0,"explanation":"백두대간 = Baekdu Daegan"}],"pattern":[{"questio