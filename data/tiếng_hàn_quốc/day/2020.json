 — Ngày 2020","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"난제を 使います。","line_vi":"Tôi dùng 난제.","focus_words":["난제"]},{"speaker":"B","line_target":"남겨둔 は 何ですか。","line_vi":"남겨둔 là cái gì?","focus_words":["남겨둔"]},{"speaker":"A","line_target":"남긴다です。","line_vi":"Đó là 남긴다.","focus_words":["남긴다"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「난제」 có nghĩa là gì?","options":["vấn đề khó khăn","bị bỏ lại phía sau","để nó đi","mặc quần áo chéo"],"answer_index":0,"explanation":"난제 = vấn đề khó khăn"},{"question":"Từ 「남겨둔」 có nghĩa là gì?","options":["bị bỏ lại phía sau","vấn đề khó khăn","để nó đi","mặc quần áo chéo"],"answer_index":0,"explanation":"남겨둔 = bị bỏ lại phía sau"},{"question":"Từ 「남긴다」 có nghĩa là gì?","options":["để nó đi","vấn đề khó khăn","bị bỏ lại phía sau","mặc quần áo chéo"],"answer_index":0,"explanation":"남긴다 = để nó đi"},{"question":"Từ 「남장」 có nghĩa là gì?","options":["mặc quần áo chéo","vấn đề khó khăn","bị bỏ lại phía sau","để nó đi"],"answer_index":0,"explanation":"남장 = mặc quần áo chéo"},{"question":"Từ 「내공」 có nghĩa là gì?","options":["sức mạnh","vấn đề khó khăn","bị bỏ lại phía sau","để nó đi"],"answer_index":0,"explanation":"내공 = sức mạnh"},{"question":"Từ 「내시」 có nghĩa là gì?","options":["thái giám","vấn đề khó khăn","bị bỏ lại phía sau","để nó đi"],"answer_index":0,"explanation":"내시 = thái giám"},{"question":"Từ 「네빌」 có nghĩa là gì?","options":["Neville","vấn đề khó khăn","bị bỏ lại phía sau","để nó đi"],"answer_index":0,"explanation":"네빌 = Neville"},{"question":"Từ 「넥스」 có nghĩa là gì?","options":["tiếp theo","vấn đề khó khăn","bị bỏ lại phía sau","để nó đi"],"answer_index":0,"explanation":"넥스 = tiếp theo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: vấn đề khó k