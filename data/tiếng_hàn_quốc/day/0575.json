ning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 575","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"배후を 使います。","line_vi":"Tôi dùng 배후.","focus_words":["배후"]},{"speaker":"B","line_target":"백악관 は 何ですか。","line_vi":"백악관 là cái gì?","focus_words":["백악관"]},{"speaker":"A","line_target":"벅스です。","line_vi":"Đó là 벅스.","focus_words":["벅스"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_97baf497","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「배후」 có nghĩa là gì?","options":["đằng sau","nhà trắng","đô la","Tôi có thể thấy nó"],"answer_index":0,"explanation":"배후 = đằng sau"},{"question":"Từ 「백악관」 có nghĩa là gì?","options":["nhà trắng","đằng sau","đô la","Tôi có thể thấy nó"],"answer_index":0,"explanation":"백악관 = nhà trắng"},{"question":"Từ 「벅스」 có nghĩa là gì?","options":["đô la","đằng sau","nhà trắng","Tôi có thể thấy nó"],"answer_index":0,"explanation":"벅스 = đô la"},{"question":"Từ 「보여요」 có nghĩa là gì?","options":["Tôi có thể thấy nó","đằng sau","nhà trắng","đô la"],"answer_index":0,"explanation":"보여요 = Tôi có thể thấy nó"},{"question":"Từ 「본명」 có nghĩa là gì?","options":["tên thật","đằng sau","nhà trắng","đô la"],"answer_index":0,"explanation":"본명 = tên thật"},{"question":"Từ 「본체」 có nghĩa là gì?","options":["cơ thể","đằng sau","nhà trắng","đô la"],"answer_index":0,"explanation":"본체 = cơ thể"},{"question":"Từ 「비자」 có nghĩa là gì?","options":["thị thực","đằng sau","nhà trắng","đô la"],"answer_index":0,"explan