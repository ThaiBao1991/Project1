 quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 577","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"실명を 使います。","line_vi":"Tôi dùng 실명.","focus_words":["실명"]},{"speaker":"B","line_target":"악몽 は 何ですか。","line_vi":"악몽 là cái gì?","focus_words":["악몽"]},{"speaker":"A","line_target":"안나です。","line_vi":"Đó là 안나.","focus_words":["안나"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2efc10ea","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「실명」 có nghĩa là gì?","options":["mù lòa","cơn ác mộng","Anna","thông báo"],"answer_index":0,"explanation":"실명 = mù lòa"},{"question":"Từ 「악몽」 có nghĩa là gì?","options":["cơn ác mộng","mù lòa","Anna","thông báo"],"answer_index":0,"explanation":"악몽 = cơn ác mộng"},{"question":"Từ 「안나」 có nghĩa là gì?","options":["Anna","mù lòa","cơn ác mộng","thông báo"],"answer_index":0,"explanation":"안나 = Anna"},{"question":"Từ 「알렸」 có nghĩa là gì?","options":["thông báo","mù lòa","cơn ác mộng","Anna"],"answer_index":0,"explanation":"알렸 = thông báo"},{"question":"Từ 「앵커」 có nghĩa là gì?","options":["mỏ neo","mù lòa","cơn ác mộng","Anna"],"answer_index":0,"explanation":"앵커 = mỏ neo"},{"question":"Từ 「양파」 có nghĩa là gì?","options":["hành tây","mù lòa","cơn ác mộng","Anna"],"answer_index":0,"explanation":"양파 = hành tây"},{"question":"Từ 「어쩜」 có nghĩa là gì?","options":["Làm thế nào","mù lòa","cơn ác mộng","Anna"],"answer_index":0,"explanation":"어쩜 = Làm thế nào"},