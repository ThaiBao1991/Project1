tence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1494","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"쇼트트랙を 使います。","line_vi":"Tôi dùng 쇼트트랙.","focus_words":["쇼트트랙"]},{"speaker":"B","line_target":"수교 は 何ですか。","line_vi":"수교 là cái gì?","focus_words":["수교"]},{"speaker":"A","line_target":"수익금です。","line_vi":"Đó là 수익금.","focus_words":["수익금"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「쇼트트랙」 có nghĩa là gì?","options":["đường ngắn","quan hệ ngoại giao","tiền thu được","nôn nao"],"answer_index":0,"explanation":"쇼트트랙 = đường ngắn"},{"question":"Từ 「수교」 có nghĩa là gì?","options":["quan hệ ngoại giao","đường ngắn","tiền thu được","nôn nao"],"answer_index":0,"explanation":"수교 = quan hệ ngoại giao"},{"question":"Từ 「수익금」 có nghĩa là gì?","options":["tiền thu được","đường ngắn","quan hệ ngoại giao","nôn nao"],"answer_index":0,"explanation":"수익금 = tiền thu được"},{"question":"Từ 「숙취」 có nghĩa là gì?","options":["nôn nao","đường ngắn","quan hệ ngoại giao","tiền thu được"],"answer_index":0,"explanation":"숙취 = nôn nao"},{"question":"Từ 「스카웃」 có nghĩa là gì?","options":["trinh sát","đường ngắn","quan hệ ngoại giao","tiền thu được"],"answer_index":0,"explanation":"스카웃 = trinh sát"},{"question":"Từ 「스키장」 có nghĩa là gì?","options":["khu nghỉ dưỡng trượt tuyết","đường ngắn","quan hệ ngoại giao","tiền thu được"],"answer_index":0,"explanation":"스키장 = khu nghỉ dưỡng trượt tuyết"},{"question":"Từ 「스타일리스트」 có nghĩa là gì?","options":["nhà tạo mẫu","đường ngắn","quan hệ ngoại giao","tiền thu được"],"answer_index":0,"explanation":"스타일리스트 = nhà tạo mẫu"},{"question":"Từ 「시물」 có nghĩa là gì?","options":["mô phỏng","đường ngắn","quan hệ ngoại giao","tiền thu được"],"answer_index":0,"explanation":"시물 = mô phỏng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đườ