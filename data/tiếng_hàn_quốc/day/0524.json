Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 524","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"summerを 使います。","line_vi":"Tôi dùng summer.","focus_words":["summer"]},{"speaker":"B","line_target":"가해자 は 何ですか。","line_vi":"가해자 là cái gì?","focus_words":["가해자"]},{"speaker":"A","line_target":"객관です。","line_vi":"Đó là 객관.","focus_words":["객관"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_df1ef8d8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「summer」 có nghĩa là gì?","options":["mùa hè","thủ phạm","mục tiêu","Bạn sẽ ở đó"],"answer_index":0,"explanation":"summer = mùa hè"},{"question":"Từ 「가해자」 có nghĩa là gì?","options":["thủ phạm","mùa hè","mục tiêu","Bạn sẽ ở đó"],"answer_index":0,"explanation":"가해자 = thủ phạm"},{"question":"Từ 「객관」 có nghĩa là gì?","options":["mục tiêu","mùa hè","thủ phạm","Bạn sẽ ở đó"],"answer_index":0,"explanation":"객관 = mục tiêu"},{"question":"Từ 「계실」 có nghĩa là gì?","options":["Bạn sẽ ở đó","mùa hè","thủ phạm","mục tiêu"],"answer_index":0,"explanation":"계실 = Bạn sẽ ở đó"},{"question":"Từ 「교단」 có nghĩa là gì?","options":["giáo phái","mùa hè","thủ phạm","mục tiêu"],"answer_index":0,"explanation":"교단 = giáo phái"},{"question":"Từ 「교도소」 có nghĩa là gì?","options":["nhà tù","mùa hè","thủ phạm","mục tiêu"],"answer_index":0,"explanation":"교도소 = nhà tù"},{"question":"Từ 「교통사고」 có nghĩa là gì?","options":["tai nạn xe hơi","mùa hè","thủ phạm","mục tiêu"],"