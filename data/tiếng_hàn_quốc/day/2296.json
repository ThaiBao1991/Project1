 → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2296","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"이더넷を 使います。","line_vi":"Tôi dùng 이더넷.","focus_words":["이더넷"]},{"speaker":"B","line_target":"이래야 は 何ですか。","line_vi":"이래야 là cái gì?","focus_words":["이래야"]},{"speaker":"A","line_target":"이목구비です。","line_vi":"Đó là 이목구비.","focus_words":["이목구비"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「이더넷」 có nghĩa là gì?","options":["ethernet","Nó phải như thế này","đặc điểm khuôn mặt","ngà voi"],"answer_index":0,"explanation":"이더넷 = ethernet"},{"question":"Từ 「이래야」 có nghĩa là gì?","options":["Nó phải như thế này","ethernet","đặc điểm khuôn mặt","ngà voi"],"answer_index":0,"explanation":"이래야 = Nó phải như thế này"},{"question":"Từ 「이목구비」 có nghĩa là gì?","options":["đặc điểm khuôn mặt","ethernet","Nó phải như thế này","ngà voi"],"answer_index":0,"explanation":"이목구비 = đặc điểm khuôn mặt"},{"question":"Từ 「이바르」 có nghĩa là gì?","options":["ngà voi","ethernet","Nó phải như thế này","đặc điểm khuôn mặt"],"answer_index":0,"explanation":"이바르 = ngà voi"},{"question":"Từ 「이정미」 có nghĩa là gì?","options":["Lee Jeongmi","ethernet","Nó phải như thế này","đặc điểm khuôn mặt"],"answer_index":0,"explanation":"이정미 = Lee Jeongmi"},{"question":"Từ 「이찬」 có nghĩa là gì?","options":["Chan Lee","ethernet","Nó phải như thế này","đặc điểm khuôn mặt"],"answer_index":0,"explanation":"이찬 = Chan Lee"},{"question":"Từ 「인버터」 có nghĩa là gì?","options":["biến tần","ethernet","Nó phải như thế này","đặc điểm khuôn mặt"],"answer_index":0,"explanation":"인버터 = biến tần"},{"question":"Từ 「인어공주」 có nghĩa là gì?","options":["Nàng tiên cá nhỏ","ethernet","Nó phải như thế này","đặc điểm khuôn mặt"],"answer_index":0,"explanation":"인어공주 = Nàng tiên cá nhỏ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: ethernet","options":["이더넷","이래야","이목구비","이바르"],"answer_index":0,"explanation":"이더넷 = ethernet"},{"question":"Chọn từ đúng cho nghĩa: Nó phải như thế này","options":["이래야","이더넷","이목구비","이바르"],"answer_index":0,"explanation":"이래야 = Nó phải như thế này"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}