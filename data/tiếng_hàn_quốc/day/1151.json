ùng 프랑.","focus_words":["프랑"]},{"speaker":"B","line_target":"프랜시스 は 何ですか。","line_vi":"프랜시스 là cái gì?","focus_words":["프랜시스"]},{"speaker":"A","line_target":"프레디です。","line_vi":"Đó là 프레디.","focus_words":["프레디"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「프랑」 có nghĩa là gì?","options":["đồng franc","Phanxicô","freddy","in"],"answer_index":0,"explanation":"프랑 = đồng franc"},{"question":"Từ 「프랜시스」 có nghĩa là gì?","options":["Phanxicô","đồng franc","freddy","in"],"answer_index":0,"explanation":"프랜시스 = Phanxicô"},{"question":"Từ 「프레디」 có nghĩa là gì?","options":["freddy","đồng franc","Phanxicô","in"],"answer_index":0,"explanation":"프레디 = freddy"},{"question":"Từ 「프린트」 có nghĩa là gì?","options":["in","đồng franc","Phanxicô","freddy"],"answer_index":0,"explanation":"프린트 = in"},{"question":"Từ 「프릴」 có nghĩa là gì?","options":["diềm xếp nếp","đồng franc","Phanxicô","freddy"],"answer_index":0,"explanation":"프릴 = diềm xếp nếp"},{"question":"Từ 「피에르」 có nghĩa là gì?","options":["Pierre","đồng franc","Phanxicô","freddy"],"answer_index":0,"explanation":"피에르 = Pierre"},{"question":"Từ 「하루카」 có nghĩa là gì?","options":["Haruka","đồng franc","Phanxicô","freddy"],"answer_index":0,"explanation":"하루카 = Haruka"},{"question":"Từ 「한국일보」 có nghĩa là gì?","options":["Hankook Ilbo","đồng franc","Phanxicô","freddy"],"answer_index":0,"explanation":"한국일보 = Hankook Ilbo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đồng franc","options":["프랑","프랜시스","프레디","프린트"],"answer_index":0,"explanation":"프랑 = đồng franc"},{"question":"Chọn từ đúng cho nghĩa: Phanxicô","options":["프랜시스","프랑","프레디","프린트"],"answer_index":0,"explanation":"프랜시스 = Phanxicô"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}