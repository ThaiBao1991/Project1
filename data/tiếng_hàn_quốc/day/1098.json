ituation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"끌려가を 使います。","line_vi":"Tôi dùng 끌려가.","focus_words":["끌려가"]},{"speaker":"B","line_target":"내버려 は 何ですか。","line_vi":"내버려 là cái gì?","focus_words":["내버려"]},{"speaker":"A","line_target":"노회찬です。","line_vi":"Đó là 노회찬.","focus_words":["노회찬"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「끌려가」 có nghĩa là gì?","options":["kéo đi","Để nó yên","Noh Hoe-chan","xếp hàng"],"answer_index":0,"explanation":"끌려가 = kéo đi"},{"question":"Từ 「내버려」 có nghĩa là gì?","options":["Để nó yên","kéo đi","Noh Hoe-chan","xếp hàng"],"answer_index":0,"explanation":"내버려 = Để nó yên"},{"question":"Từ 「노회찬」 có nghĩa là gì?","options":["Noh Hoe-chan","kéo đi","Để nó yên","xếp hàng"],"answer_index":0,"explanation":"노회찬 = Noh Hoe-chan"},{"question":"Từ 「늘어놓」 có nghĩa là gì?","options":["xếp hàng","kéo đi","Để nó yên","Noh Hoe-chan"],"answer_index":0,"explanation":"늘어놓 = xếp hàng"},{"question":"Từ 「능선」 có nghĩa là gì?","options":["sườn núi","kéo đi","Để nó yên","Noh Hoe-chan"],"answer_index":0,"explanation":"능선 = sườn núi"},{"question":"Từ 「다룬다」 có nghĩa là gì?","options":["đối phó với","kéo đi","Để nó yên","Noh Hoe-chan"],"answer_index":0,"explanation":"다룬다 = đối phó với"},{"question":"Từ 「다방」 có nghĩa là gì?","options":["quán cà phê","kéo đi","Để nó yên","Noh Hoe-chan"],"answer_index":0,"explanation":"다방 = quán cà phê"},{"question":"Từ 「다섯째」 có nghĩa là gì?","options":["thứ năm","kéo đi","Để nó yên","Noh Hoe-chan"],"answer_index":0,"explanation":"다섯째 = thứ năm"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: kéo đi","options":["끌려가","내버려","노회찬","늘어놓"],"answer_index":0,"explanation":"끌려가 = kéo đi"},{"question":"Chọn từ đúng cho nghĩa: Để nó yên","options":["내버려","끌려가","노회찬","늘어놓"],