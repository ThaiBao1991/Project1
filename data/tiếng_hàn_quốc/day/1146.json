_words":["열애"]},{"speaker":"A","line_target":"영아です。","line_vi":"Đó là 영아.","focus_words":["영아"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「열악」 có nghĩa là gì?","options":["nghèo nàn","người sùng đạo","trẻ sơ sinh","màu vàng"],"answer_index":0,"explanation":"열악 = nghèo nàn"},{"question":"Từ 「열애」 có nghĩa là gì?","options":["người sùng đạo","nghèo nàn","trẻ sơ sinh","màu vàng"],"answer_index":0,"explanation":"열애 = người sùng đạo"},{"question":"Từ 「영아」 có nghĩa là gì?","options":["trẻ sơ sinh","nghèo nàn","người sùng đạo","màu vàng"],"answer_index":0,"explanation":"영아 = trẻ sơ sinh"},{"question":"Từ 「옐로우」 có nghĩa là gì?","options":["màu vàng","nghèo nàn","người sùng đạo","trẻ sơ sinh"],"answer_index":0,"explanation":"옐로우 = màu vàng"},{"question":"Từ 「오딘」 có nghĩa là gì?","options":["odin","nghèo nàn","người sùng đạo","trẻ sơ sinh"],"answer_index":0,"explanation":"오딘 = odin"},{"question":"Từ 「올라간」 có nghĩa là gì?","options":["đi lên","nghèo nàn","người sùng đạo","trẻ sơ sinh"],"answer_index":0,"explanation":"올라간 = đi lên"},{"question":"Từ 「용맹」 có nghĩa là gì?","options":["lòng dũng cảm","nghèo nàn","người sùng đạo","trẻ sơ sinh"],"answer_index":0,"explanation":"용맹 = lòng dũng cảm"},{"question":"Từ 「웅장」 có nghĩa là gì?","options":["sự hùng vĩ","nghèo nàn","người sùng đạo","trẻ sơ sinh"],"answer_index":0,"explanation":"웅장 = sự hùng vĩ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nghèo nàn","options":["열악","열애","영아","옐로우"],"answer_index":0,"explanation":"열악 = nghèo nàn"},{"question":"Chọn từ đúng cho nghĩa: người sùng đạo","options":["열애","열악","영아","옐로우"],"answer_index":0,"explanation":"열애 = người sùng đạo"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}