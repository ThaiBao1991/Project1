ation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1814","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"フレンドリを 使います。","line_vi":"Tôi dùng フレンドリ.","focus_words":["フレンドリ"]},{"speaker":"B","line_target":"フレージング は 何ですか。","line_vi":"フレージング là cái gì?","focus_words":["フレージング"]},{"speaker":"A","line_target":"フレーズです。","line_vi":"Đó là フレーズ.","focus_words":["フレーズ"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bed9d88e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「フレンドリ」 có nghĩa là gì?","options":["thân thiện","cách diễn đạt","cụm từ","hương vị"],"answer_index":0,"explanation":"フレンドリ = thân thiện"},{"question":"Từ 「フレージング」 có nghĩa là gì?","options":["cách diễn đạt","thân thiện","cụm từ","hương vị"],"answer_index":0,"explanation":"フレージング = cách diễn đạt"},{"question":"Từ 「フレーズ」 có nghĩa là gì?","options":["cụm từ","thân thiện","cách diễn đạt","hương vị"],"answer_index":0,"explanation":"フレーズ = cụm từ"},{"question":"Từ 「フレーバ」 có nghĩa là gì?","options":["hương vị","thân thiện","cách diễn đạt","cụm từ"],"answer_index":0,"explanation":"フレーバ = hương vị"},{"question":"Từ 「フレーミング」 có nghĩa là gì?","options":["đóng khung","thân thiện","cách diễn đạt","cụm từ"],"answer_index":0,"explanation":"フレーミング = đóng khung"},{"question":"Từ 「フレーム」 có nghĩa là gì?","options":["ngọn lửa","thân thiện","cách diễn đạt","cụm từ"],"answer_index":0,"explanation":"フレーム = ngọn lửa"},{"question":"Từ 「フレームレス」 có nghĩa là gì?","options":["không có vành (ví dụ: kính) (eng: frameless)","thân thiện","cách diễn đạt","cụm từ"],"answer_index":0,"explanation":"フレームレス = không có vành (ví dụ: kính) (eng: frameless)"},{"question":"Từ 「フレール」 có nghĩa là gì?","options":["yếu đuối","thân thiện","cách diễn đạt","cụm từ"],"answer_index":0,"explanation":"フレール = yếu đuối"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: thân thiện","options":["フレンドリ","フレージング","フレーズ","フレーバ"],"answer_index":0,"explanation":"フレンドリ = thân thiện"},{"question":"Chọn từ đúng cho nghĩa: cách diễn đạt","options":["フレージング","フレンドリ","フレーズ","フレーバ"],"answer_index":0,"explanation":"フレージング = cách diễn đạt"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"フレンドリ":"m_ef28b88a","フレージング":"m_155b7708","フレーズ":"m_97675431","フレーバ":"m_157ce89a","フレーミング":"m_a073e9cd","フレーム":"m_ba1ebf1a","フレームレス":"m_f9b4a82a","フレール":"m_761ec55c","フレーヴァ":"m_6e425e22","フレーヴァー":"m_2166