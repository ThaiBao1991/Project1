 là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"_gen":true},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"_gen":true},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"_gen":true}],"dialogue":[{"situation":"Hai bạn trẻ đang trò chuyện về các nét văn hóa truyền thống của Nhật Bản.","level_tag":"A1","title":"Văn hóa Nhật Bản","cultural_note":"Văn hóa truyền thống Nhật Bản rất đa dạng từ trang phục đến nghệ thuật.","turns":[{"speaker":"A","line_target":"着物を着ますか。","line_vi":"Bạn có mặc kimono không?","focus_words":["着物"],"emotion":"thân thiện","tone":"thân mật"},{"speaker":"B","line_target":"寿司を食べます。","line_vi":"Tôi ăn sushi.","focus_words":["寿司"],"emotion":"vui vẻ","tone":"thân mật"},{"speaker":"A","line_target":"桜を見ます。","line_vi":"Tôi ngắm hoa anh đào.","focus_words":["桜"],"emotion":"hào hứng","tone":"thân mật"},{"speaker":"B","line_target":"茶道をします。","line_vi":"Tôi học trà đạo.","focus_words":["茶道"],"emotion":"thích thú","tone":"thân mật"}],"difficul