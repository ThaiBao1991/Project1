etic_note":"👄 Đọc ですけど là \"ですけど\".","syllables":["ですけど"],"pos":"","example_target":"ですけどを使います。","example_vi":"Dùng từ ですけど.","image_prompt":null,"image_ref":"m_525fa320","audio_ref":"m_ad6513de","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_3a51b15e"},{"word":"ですです","pronunciation":"ですです","ipa":"/ですです/","part_of_speech":"pol","meaning_vi":"đúng rồi","explanation":"ですです (ですです) — that's right","example_sentence":"ですですを使います。","example_meaning_vi":"Dùng từ ですです.","phonetic_note":"👄 Đọc ですです là \"ですです\".","syllables":["ですです"],"pos":"","example_target":"ですですを使います。","example_vi":"Dùng từ ですです.","image_prompt":null,"image_ref":"m_4b6909e5","audio_ref":"m_bdfa1e14","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_1982c3f9"},{"word":"ですので","pronunciation":"ですので","ipa":"/ですので/","part_of_speech":"pol","meaning_vi":"bởi vì","explanation":"ですので (ですので) — because","example_sentence":"ですのでを使います。","example_meaning_vi":"Dùng từ ですので.","phonetic_note":"👄 Đọc ですので là \"ですので\".","syllables":["ですので"],"pos":"","example_target":"ですのでを使います。","example_vi":"Dùng từ ですので.","image_prompt":null,"image_ref":"m_058696a4","audio_ref":"m_8c60d74d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5d19b056"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","