ferences":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Đại từ 私 (watashi)","level":"N5","explanation":"Từ chỉ tự ngôn: 私 / 僕・俺 (nam) / 私たち.","examples":[{"sentence":"私は田中です。","meaning_vi":"Tôi là Tanaka."}],"pronunciation_focus":"私 = watashi.","common_mistakes":"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1949","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ボキボキを 使います。","line_vi":"Tôi dùng ボキボキ.","focus_words":["ボキボキ"]},{"speaker":"B","line_target":"ボキャブラリ は 何ですか。","line_vi":"ボキャブラリ là cái gì?","focus_words":["ボキャブラリ"]},{"speaker":"A","line_target":"ボキリです。","line_vi":"Đó là ボキリ.","focus_words":["ボキリ"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e2b7f614","dif