unciation":"お堅い","ipa":"/お堅い/","part_of_speech":"col","meaning_vi":"nghiêm khắc","explanation":"お堅い (お堅い) — strict","example_sentence":"お堅いを使います。","example_meaning_vi":"Dùng từ お堅い.","phonetic_note":"👄 Đọc お堅い là \"お堅い\".","syllables":["お堅い"],"pos":"","example_target":"お堅いを使います。","example_vi":"Dùng từ お堅い.","image_prompt":null,"image_ref":"m_bca68d6f","audio_ref":"m_ef6a1a67","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b9cef831"},{"word":"お報せ","pronunciation":"お報せ","ipa":"/お報せ/","part_of_speech":"n","meaning_vi":"thông báo","explanation":"お報せ (お報せ) — notice","example_sentence":"お報せを使います。","example_meaning_vi":"Dùng từ お報せ.","phonetic_note":"👄 Đọc お報せ là \"お報せ\".","syllables":["お報せ"],"pos":"","example_target":"お報せを使います。","example_vi":"Dùng từ お報せ.","image_prompt":null,"image_ref":"m_037cc763","audio_ref":"m_2ddd5cdc","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_a18bd554"},{"word":"お墨つき","pronunciation":"お墨つき","ipa":"/お墨つき/","part_of_speech":"n","meaning_vi":"giấy chứng nhận","explanation":"お墨つき (お墨つき) — certificate","example_sentence":"お墨つきを使います。","example_meaning_vi":"Dùng từ お墨つき.","phonetic_note":"👄 Đọc お墨つき là \"お墨つき\".","syllables":["お墨つき"],"pos":"","example_target":"お墨つきを使います。","example_vi":"Dùng từ お墨つき.","image_prompt":null,"image_ref":"m_2603f9a8","audio_ref":"m_d6587419","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_edca825e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2393","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"お国ことばを 使います。","line_vi":"Tôi dùng お国ことば.","focus_words":["お国ことば"]},{"speaker":"B","line_target":"お坊さん は 何ですか。","line_vi":"お坊さん là cái gì?","focus_words":["お坊さん"]},{"speaker":"A","line_target":"お坊ちゃまです。","line_vi