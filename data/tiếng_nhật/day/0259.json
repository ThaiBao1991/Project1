 đọc 'to'.","example_sentence":"友達と映画を見ます。","example_meaning_vi":"Tôi xem phim cùng bạn.","_gen":true}],"common_sentences":[{"sentence":"おねがいします。","meaning_vi":"Xin nhờ anh/chị giúp cho.","situation":"Nhờ vả công việc hoặc khi đưa tiền/đặt món cho bồi bàn."},{"sentence":"お疲れ様でした。","meaning_vi":"Anh/chị đã vất vả rồi.","situation":"Câu chào cửa miệng khi kết thúc công việc hoặc gặp nhau ở văn phòng"},{"sentence":"これをください。","meaning_vi":"Lấy cho tôi cái này.","situation":"Quyết định mua sản phẩm đang chọn."},{"sentence":"はい、そうです。","meaning_vi":"Vâng, đúng như vậy.","situation":"Trả lời xác nhận cho một câu hỏi đúng."},{"sentence":"両親は元気です。","meaning_vi":"Bố mẹ tôi đều khỏe mạnh.","situation":"Trả lời khi ai đó hỏi thăm về bố mẹ mình."}],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"_gen":true},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"_gen":true},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"毎日、日本語を勉強します。","meaning_vi":"Tôi học tiếng Nhật mỗi ngày."},{"sentence":"明日、会社へ行きます。","meaning_vi":"Ngày mai tôi đi công ty."}],"pronunciation_focu