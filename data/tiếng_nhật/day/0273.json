ing_vi":"Ngày mai tôi sẽ đi du lịch.","_gen":true},{"pattern":"Thì tương lai ます (động từ + ます)","meaning_vi":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","structure_note":"Khác với ました ở dạng lịch sự.","example_sentence":"毎日、走ります。","example_meaning_vi":"Tôi chạy mỗi ngày.","_gen":true}],"common_sentences":[{"sentence":"宿題を忘れました。","meaning_vi":"Em quên bài tập về nhà rồi ạ.","situation":"Khi chưa hoàn thành hoặc quên mang bài tập đến lớp."},{"sentence":"寒くなりましたね。","meaning_vi":"Trời trở lạnh rồi nhỉ!","situation":"Nhận xét về sự thay đổi nhiệt độ khi chuyển mùa."},{"sentence":"寿司が好きですか。","meaning_vi":"Bạn có thích sushi không?","situation":"Hỏi sở thích ẩm thực của bạn bè hoặc đối tác."},{"sentence":"海はどちらですか。","meaning_vi":"Hướng ra biển là hướng nào vậy?","situation":"Khi hỏi đường đi ra bãi biển ở thành phố du lịch."},{"sentence":"祭りはいつですか。","meaning_vi":"Lễ hội diễn ra khi nào vậy?","situation":"Hỏi thông tin du lịch tại quầy hướng dẫn."}],"grammar":[{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"_gen":true},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"_gen":true},{"title":"Đại từ 私 (watashi)",