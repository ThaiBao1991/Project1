ronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"_gen":true},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"_gen":true}],"dialogue":[{"situation":"Du khách hỏi đường tại nhà ga Nhật Bản.","level_tag":"A1","title":"Hỏi đường cơ bản","cultural_note":"Người Nhật rất sẵn lòng chỉ đường khi bạn hỏi bằng thái độ lịch sự.","turns":[{"speaker":"A","line_target":"駅はどこですか。","line_vi":"Nhà ga ở đâu vậy?","focus_words":["駅"],"emotion":"tò mò","tone":"lịch sự"},{"speaker":"B","line_target":"ここは駅です。","line_vi":"Ở đây là nhà ga.","focus_words":["ここ","駅"],"emotion":"thân thiện","tone":"nhẹ nhàng"},{"speaker":"A","line_target":"切符はどこですか。","line_vi":"Vé ở đâu vậy?","focus_words":["切符"],"emotion":"bối rối","tone":"lịch sự"},{"speaker":"B","line_target":"あそこは案内所です。","line_vi":"Đằng kia là quầy thông tin.","focus_words":["あそこ","案内所"],"emotion":"thân thiện","tone":"lịch sự"},{"speaker":"A","line_target":"ホテルはどこですか。","line_vi":"Khách sạn ở đâu vậy?","focus_words":["ホテル"],"emotion":"tò mò","tone":"lịch sự"},{"speaker":"B","line_target":"そこはホテルです。","line_vi":"Đó là khách sạn.","focus_words":["そこ","ホテル"],"emotion":"thân thiện","tone":"lịch sự"}],"difficulty":"A1","new_words":["駅","切符","案内所","ホテル"],"grammar_used":"Hỏi vị trí địa điểm với cấu trúc 「N は どこですか」","kind":"micro"}],"quiz":{"vocab":[{"question":"Từ 「んがため」 có nghĩa là gì?","options":["để","tạm biệt nhé","sự mong đợi là...","sẽ (có lẽ)"],"answer_index":0,"ex