_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e66df4d8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ざっくざっく」 có nghĩa là gì?","options":["giòn giòn","(on-mim) đại khái","(on-mim) đại khái","bắn tung tóe"],"answer_index":0,"explanation":"ざっくざっく = giòn giòn"},{"question":"Từ 「ざっくり」 có nghĩa là gì?","options":["(on-mim) đại khái","giòn giòn","bắn tung tóe","giật gân"],"answer_index":0,"explanation":"ざっくり = (on-mim) đại khái"},{"question":"Từ 「ざっと」 có nghĩa là gì?","options":["(on-mim) đại khái","giòn giòn","bắn tung tóe","giật gân"],"answer_index":0,"explanation":"ざっと = (on-mim) đại khái"},{"question":"Từ 「ざぶざぶ」 có nghĩa là gì?","options":["bắn tung tóe","giòn giòn","(on-mim) đại khái","(on-mim) đại khái"],"answer_index":0,"explanation":"ざぶざぶ = bắn tung tóe"},{"question":"Từ 「ざぶり」 có nghĩa là gì?","options":["giật gân","giòn giòn","(on-mim) đại khái","(on-mim) đại khái"],"answer_index":0,"explanation":"ざぶり = giật gân"},{"question":"Từ 「ざぶりざぶり」 có nghĩa là gì?","options":["âm thanh của sự sống, nước chuyển động","giòn giòn","(on-mim) đại khái","(on-mim) đại khái"],"answer_index":0,"explanation":"ざぶりざぶり = âm thanh của sự sống, nước chuyển động"},{"question":"Từ 「ざぶん」 có nghĩa là gì?","options":["giật gân","giòn giòn","(on-mim) đại khái","(on-mim) đại khái"],"answer_index":0,"explanation":"ざぶん = giật gân"},{"question":"Từ 「ざまぁ」 có nghĩa là gì?","options":["phục vụ bạn đúng cách!","giòn giòn","(on-mim) đại khái","(on-mim) đại khái"],"answer_index":0,"explanation":"ざまぁ = phục vụ bạn đúng cách!"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: giòn giòn","options":["ざっくざっく","ざっくり","ざっと","ざぶざぶ"],"answer_index":0,"explanation":"ざっくざっく = giòn giòn"},{"question":"Chọn từ đúng cho nghĩa: (on-mim) đại khái","options":["ざっくり","ざっくざっく","ざっと","ざぶざぶ"],"answer_index":0,"explanation":"ざっくり = (on-mim) đại khái"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"ざっくざっく