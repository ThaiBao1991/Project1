ing_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"_gen":true},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"毎日、日本語を勉強します。","meaning_vi":"Tôi học tiếng Nhật mỗi ngày."},{"sentence":"明日、会社へ行きます。","meaning_vi":"Ngày mai tôi đi công ty."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"_gen":true}],"dialogue":[{"situation":"Hai bạn học sinh đang thảo luận về môn lịch sử ở thư viện trường.","level_tag":"A1","title":"Học lịch sử cơ bản","cultural_note":"- Không có điểm văn hóa đặc biệt","turns":[{"speaker":"A","line_target":"歴史の記録を読む。","line_vi":"Đọc ghi chép lịch sử.","focus_words":[],"emotion":"bình thường","tone":"thân mật"},{"speaker":"B","line_target":"古代の時代ですか。","line_vi":"Thời đại cổ đại phải không?","focus_words":[],"emotion":"tò mò","tone":"thân mật"},{"speaker":"A","line_target":"過去の文化ね。","line_vi":"Văn hóa quá khứ đấy.","focus_words":[],"emotion":"vui vẻ","tone":"thân mật"},{"speaker":"B","line_target":"平和な未来に。","line_vi":"Hướng tới tương lai hòa bình.","focus_words":[],"emotion":"hy vọng","tone":"thân mật"},{"speaker":"A","line_target":"重要な人物の発見。","line_vi":"Sự phát hiện nhân vật quan trọng.","focus_words":[],"emotion":"ngạc nhiên","tone":"thân mật"},{"speaker":"B","line_target":"戦争の時代ゼロへ。","line_vi":"Hướng tới thời đại không chiến tranh.","focus_words":[],"emotion":"quyết tâm","tone":"thân mật"}],"difficulty":"A1","new_words":["歴史","時代","古代","未来","現在","過去","戦争","平和"],"grammar_used":"Trợ từ No và Ni","kind":"micro"}],"quiz":{"vocab":