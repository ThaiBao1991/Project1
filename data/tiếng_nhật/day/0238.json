_speech":"1","meaning_vi":"như (tức là trong vai trò của)","explanation":"として (として) — as (i.e. in the role of)","example_sentence":"としてを使います。","example_meaning_vi":"Dùng từ として.","phonetic_note":"👄 Đọc として là \"として\".","syllables":["として"],"pos":"","example_target":"としてを使います。","example_vi":"Dùng từ として.","image_prompt":null,"image_ref":"m_ccec4c36","audio_ref":"m_19682c0a","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_96e0a278"},{"word":"としては","pronunciation":"としては","ipa":"/としては/","part_of_speech":"for","meaning_vi":"cho","explanation":"としては (としては) — for","example_sentence":"としてはを使います。","example_meaning_vi":"Dùng từ としては.","phonetic_note":"👄 Đọc としては là \"としては\".","syllables":["としては"],"pos":"","example_target":"としてはを使います。","example_vi":"Dùng từ としては.","image_prompt":null,"image_ref":"m_624e637f","audio_ref":"m_ad3c90a0","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_6d9b6753"},{"word":"としても","pronunciation":"としても","ipa":"/としても/","part_of_speech":"1","meaning_vi":"ngay cả khi...","explanation":"としても (としても) — even if ...","example_sentence":"としてもを使います。","example_meaning_vi":"Dùng từ としても.","phonetic_note":"👄 Đọc としても là \"としても\".","syllables":["としても"],"pos":"","example_target":"としてもを使います。","example_vi":"Dùng từ としても.","image_prompt":null,"image_ref":"m_6166ed4a","audio_ref":"m_fc091bfa","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b733da3d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Ghép âm & Từ đơn sinh tồn — Ngày 238","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ところからを 使います。","line_vi":"Tôi dùng ところから.","focus_words":["ところから"]},{"speaker":"B","line_target":"ところを は 何ですか。","line_vi":"ところを là cái gì?","focus_words":["ところを"]},{"speaker":"A","line_target":"とこをです。","line_vi":"Đó là とこを.","focus_words":["とこを"]},{"speaker"