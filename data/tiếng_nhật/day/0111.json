cture_note":"Godan: đổi e hoặc i ở cuối.","example_sentence":"水を飲みます。","example_meaning_vi":"Tôi uống nước.","_gen":true},{"pattern":"Động từ godan (u-ending)","meaning_vi":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","structure_note":"Godan: đổi e hoặc i ở cuối.","example_sentence":"友達を待ちます。","example_meaning_vi":"Tôi đợi bạn.","_gen":true}],"common_sentences":[{"sentence":"お茶をどうぞ。","meaning_vi":"Xin mời dùng trà.","situation":"Mời khách uống trà khi khách đến nhà hoặc công ty."},{"sentence":"これにします。","meaning_vi":"Tôi chọn cái này.","situation":"Khi quyết định mua món đồ đã chọn."},{"sentence":"じゃあ、また。","meaning_vi":"Hẹn gặp lại sau nhé.","situation":"Chào tạm biệt bạn bè thân thiết."},{"sentence":"わかりました。","meaning_vi":"Tôi đã hiểu rồi ạ.","situation":"Khi đã nắm được nội dung giảng dạy hoặc hướng dẫn."},{"sentence":"わかりません。","meaning_vi":"Tôi không hiểu ạ.","situation":"Khi gặp bài tập khó hoặc chưa hiểu câu hỏi."}],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"_gen":true},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"_gen":true},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"_gen":true},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"_gen":true}],"dialogue":[{"situation":"Hai bạn trẻ đang chuẩn bị cho chuyến đi du lịch tại nhà ga.","level_tag":"A1","title":"Chuẩn bị du lịch","cultural_note":"- Người Nhật rất chú trọng việc chuẩn bị kỹ lưỡng và đúng giờ khi đi du lịch.","turns":[{"speaker":"A","line_target":"旅行へ行きます。","line_vi":"Tôi đi du lịch.","focus_words":["旅行"],"emotion":"vui vẻ","tone":"thân mật"},{"speaker":"B","line_target":"切符を買います。","line_vi":"Mua vé.","focus_words":["切符"],"emotion":"bình tĩnh","tone":"thân mật"},{"speaker":"A","line_target":"空港へ急ぎます。","line_vi":"Nhanh ra sân bay.","focus_words":["空港"],"emotion":"gấp gáp","tone":"gấp gáp"},{"speaker":"B","line_target":"荷物を持っています。","line_vi":"Đang mang hành lý.","focus_words":["荷物"],"emotion":"bình tĩnh","tone":"thân mật"},{"speaker":"A","line_target":"地図を見ます。","line_vi":"Xem bản đồ.","focus_words":["地図"],"emotion":"tập trung","tone":"bình thường"},{"speaker":"B","line_target":"ホテルへ行こう。","line_vi":"Đi khách sạn nào.","focus_words":["ホテル"],"emotion":"hào hứng","tone":"vui vẻ"}],"di