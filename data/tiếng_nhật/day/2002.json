_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「マシーン」 có nghĩa là gì?","options":["máy móc","súng máy","nghiêm túc","được thích thú"],"answer_index":0,"explanation":"マシーン = máy móc"},{"question":"Từ 「マシーンガン」 có nghĩa là gì?","options":["súng máy","máy móc","nghiêm túc","được thích thú"],"answer_index":0,"explanation":"マシーンガン = súng máy"},{"question":"Từ 「マジ」 có nghĩa là gì?","options":["nghiêm túc","máy móc","súng máy","được thích thú"],"answer_index":0,"explanation":"マジ = nghiêm túc"},{"question":"Từ 「マジウケる」 có nghĩa là gì?","options":["được thích thú","máy móc","súng máy","nghiêm túc"],"answer_index":0,"explanation":"マジウケる = được thích thú"},{"question":"Từ 「マジギレ」 có nghĩa là gì?","options":["đang thực sự tức giận","máy móc","súng máy","nghiêm túc"],"answer_index":0,"explanation":"マジギレ = đang thực sự tức giận"},{"question":"Từ 「マジコウ」 có nghĩa là gì?","options":["huyền diệu","máy móc","súng máy","nghiêm túc"],"answer_index":0,"explanation":"マジコウ = huyền diệu"},{"question":"Từ 「マジック」 có nghĩa là gì?","options":["ma thuật","máy móc","súng máy","nghiêm túc"],"answer_index":0,"explanation":"マジック = ma thuật"},{"question":"Từ 「マジバナ」 có nghĩa là gì?","options":["nói thật","máy móc","súng máy","nghiêm túc"],"answer_index":0,"explanation":"マジバナ = nói thật"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: máy móc","options":["マシーン","マシーンガン","マジ","マジウケる"],"answer_index":0,"explanation":"マシーン = máy móc"},{"question":"Chọn từ đúng cho nghĩa: súng máy","options":["マシーンガン","マシーン","マジ","マジウケる"],"answer_index":0,"explanation":"マシーンガン = súng máy"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"マシーン":"m_71e704ba","マシーンガン":"m_cc7c7bfc","マジ":"m_34f34646","マジウケる":"m_e28d87d0","マジギレ":"m_c1b42498","マジコウ":"m_b2fd80a8","マジック":"m_630eed94","マジバナ":"m_7cc1ba65","マジボケ":"m_21827119","マジメ":"m_50af0215"},"dialogue_audio":{"0":"m_3b5f86b6"}},"media_map":{"m_39c1103f":"media/tiếng_nhật/d2002/word_00_d0fc25d6.webp","m_56cfea9f":"media/tiếng_nhật/d2