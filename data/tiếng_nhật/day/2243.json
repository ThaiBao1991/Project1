ứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]},{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2243","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"レコードを 使います。","line_vi":"Tôi dùng レコード.","focus_words":["レコード"]},{"speaker":"B","line_target":"レコードキー は 何ですか。","line_vi":"レコードキー là cái gì?","focus_words":["レコードキー"]},{"speaker":"A","line_target":"レゴです。","line_vi":"Đó là レゴ.","focus_words":["レゴ"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_719cb442","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"que