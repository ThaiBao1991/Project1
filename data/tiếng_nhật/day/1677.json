:[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1677","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"パバーヌを 使います。","line_vi":"Tôi dùng パバーヌ.","focus_words":["パバーヌ"]},{"speaker":"B","line_target":"パパ は 何ですか。","line_vi":"パパ là cái gì?","focus_words":["パパ"]},{"speaker":"A","line_target":"パパさんです。","line_vi":"Đó là パパさん.","focus_words":["パパさん"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a05e7184","difficulty":"","new_words":[],"g