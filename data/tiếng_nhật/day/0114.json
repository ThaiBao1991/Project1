ng_vi":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","structure_note":"Tính từ i-adjective đọc bằng 'i'.","example_sentence":"この本は安いです。","example_meaning_vi":"Cuốn sách này rẻ.","_gen":true},{"pattern":"Tính từ na-ending (い)","meaning_vi":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","structure_note":"Tính từ i-adjective đọc bằng 'i'.","example_sentence":"この本は安くないです。","example_meaning_vi":"Cuốn sách này không rẻ.","_gen":true}],"common_sentences":[{"sentence":"契約を結びます。","meaning_vi":"Chúng tôi tiến hành ký kết hợp đồng.","situation":"Giai đoạn chốt thỏa thuận kinh doanh chính thức."},{"sentence":"妹が一人います。","meaning_vi":"Tôi có một người em gái.","situation":"Giới thiệu về thành viên gia đình mình khi giao lưu."},{"sentence":"寺へ行きますか。","meaning_vi":"Bạn có đi chùa không?","situation":"Hỏi bạn đồng hành về kế hoạch tham quan."},{"sentence":"後で連絡します。","meaning_vi":"Tôi sẽ liên lạc lại sau.","situation":"Khi đang bận hoặc hứa hẹn sẽ gọi điện, gửi tin nhắn phản hồi sau."},{"sentence":"桜が咲きました。","meaning_vi":"Hoa anh đào đã nở rồi.","situation":"Trò chuyện về thời tiết và mùa xuân với đồng nghiệp."}],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"_gen":true},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"_gen":true},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"_gen":true},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"_gen":true}],"dialogue":[{"situation":"Hai người bạn đang gọi món tại một quán ăn Nhật Bản.","level_tag":"A1","title":"Gọi món ăn","cultural_note":"Người Nhật thường uống trà xanh kèm với bữa ăn để thanh vị.","turns":[{"speaker":"A","line_target":"寿司を食べます。","line_vi":"Tôi ăn sushi.","focus_words":["寿司"],"emotion":"thân thiện","tone":"thân mật"},{"speaker":"B","line_target":"ラーメンが好きです。","line_vi":"Tôi thích mì ramen.","focus_words":["ラーメン"],"emotion":"thân thiện","tone":"thân mật"},{"speaker":"A","line_target":"お茶を飲みます。","line_vi":"Tôi uống trà.","focus_words":["お茶"],"emotion":"thân thiện","tone":"thân mật"}],"difficulty":"A1","new_words":["寿司","ラーメン","お茶"],"grammar_used":"Trợ từ 'o' ( を ) chỉ tân ngữ trực tiếp","kind":"micro"}],"quiz":{"vocab":[{"question":"Từ 「けれど」 có nghĩa là gì?","options":["nhưng","chuẩn bị bề mặt (để sơn)","(on-mim) tiếng kêu (của ếch)","(o