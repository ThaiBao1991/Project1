ogue":[{"title":"Cao cấp học thuật — Ngày 1858","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"refを 使います。","line_vi":"Tôi dùng ref.","focus_words":["ref"]},{"speaker":"B","line_target":"reformado は 何ですか。","line_vi":"reformado là cái gì?","focus_words":["reformado"]},{"speaker":"A","line_target":"reformistaです。","line_vi":"Đó là reformista.","focus_words":["reformista"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ref」 có nghĩa là gì?","options":["giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách","thư giãn"],"answer_index":0,"explanation":"ref = giới thiệu"},{"question":"Từ 「reformado」 có nghĩa là gì?","options":["đã được cải tạo","giới thiệu","người theo chủ nghĩa cải cách","thư giãn"],"answer_index":0,"explanation":"reformado = đã được cải tạo"},{"question":"Từ 「reformista」 có nghĩa là gì?","options":["người theo chủ nghĩa cải cách","giới thiệu","đã được cải tạo","thư giãn"],"answer_index":0,"explanation":"reformista = người theo chủ nghĩa cải cách"},{"question":"Từ 「relajarse」 có nghĩa là gì?","options":["thư giãn","giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách"],"answer_index":0,"explanation":"relajarse = thư giãn"},{"question":"Từ 「respalda」 có nghĩa là gì?","options":["hỗ trợ","giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách"],"answer_index":0,"explanation":"respalda = hỗ trợ"},{"question":"Từ 「responderá」 có nghĩa là gì?","options":["sẽ đáp lại","giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách"],"answer_index":0,"explanation":"responderá = sẽ đáp lại"},{"question":"Từ 「resucitado」 có nghĩa là gì?","options":["hồi sinh","giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách"],"answer_index":0,"explanation":"resucitado = hồi sinh"},{"question":"Từ 「retaguardia」 có nghĩa là gì?","options":["hậu quân","giới thiệu","đã được cải tạo","người theo chủ nghĩa cải cách"],"answer_index":0,"explanation":"retaguardia = hậu quân"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: giới thiệu","options":["ref","reformado","reformista","relajarse"],"answer_index":0,"explanation":"ref = giới thiệu"},{"question":"Chọn từ đúng cho nghĩa: đã được cải tạo","options":["reformado","ref","reformista","relajarse"],"answer_index":0,"explanation":"reformado = đã được cải tạo"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}