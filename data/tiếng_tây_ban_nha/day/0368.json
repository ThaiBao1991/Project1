ning_audio_ref":"m_60ecb013"},{"word":"quito","pronunciation":"","ipa":"","part_of_speech":"","meaning_vi":"tôi loại bỏ","explanation":"tôi loại bỏ","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_84b2f69f","audio_ref":"m_aec08db5","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b192ffdc"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 368","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"latinoaméricaを 使います。","line_vi":"Tôi dùng latinoamérica.","focus_words":["latinoamérica"]},{"speaker":"B","line_target":"liberales は 何ですか。","line_vi":"liberales là cái gì?","focus_words":["liberales"]},{"speaker":"A","line_target":"llevamosです。","line_vi":"Đó là llevamos.","focus_words":["llevamos"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a4ee56d9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「latinoamérica」 có nghĩa là gì?","options":["Mỹ Latinh","những người theo chủ nghĩa tự do","chúng tôi mang theo","mục tiêu"],"answer_index":0,"explanation":"latinoamérica = Mỹ Latinh"},{"question":"Từ 「liberales」 có nghĩa là gì?","options":["những người theo chủ nghĩa tự do","Mỹ Latinh","chúng tôi mang theo","mục tiêu"],"answer_index":0,"explanation":"liberales = những người theo chủ nghĩa tự do"},{"question":"Từ 「llevamos」 có nghĩa là gì?","options":["chúng tôi mang theo","Mỹ Latinh","những người theo chủ nghĩa tự do","mục tiêu"],"answer_index":0,"explanation":"llevamos = chúng tôi mang theo"},{"question":"Từ 「metas」 có nghĩa là gì?","options":["mục tiêu","Mỹ Latinh","những người theo chủ nghĩa tự do","chúng t