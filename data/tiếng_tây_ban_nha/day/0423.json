ple_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_badfaba1","audio_ref":"m_de7447ec","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5f1b53c3"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 423","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"multaを 使います。","line_vi":"Tôi dùng multa.","focus_words":["multa"]},{"speaker":"B","line_target":"negras は 何ですか。","line_vi":"negras là cái gì?","focus_words":["negras"]},{"speaker":"A","line_target":"niegaです。","line_vi":"Đó là niega.","focus_words":["niega"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a5dbd9d8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「multa」 có nghĩa là gì?","options":["ổn","màu đen","phủ nhận","cao quý"],"answer_index":0,"explanation":"multa = ổn"},{"question":"Từ 「negras」 có nghĩa là gì?","options":["màu đen","ổn","phủ nhận","cao quý"],"answer_index":0,"explanation":"negras = màu đen"},{"question":"Từ 「niega」 có nghĩa là gì?","options":["phủ nhận","ổn","màu đen","cao quý"],"answer_index":0,"explanation":"niega = phủ nhận"},{"question":"Từ 「noble」 có nghĩa là gì?","options":["cao quý","ổn","màu đen","phủ nhận"],"answer_index":0,"explanation":"noble = cao quý"},{"question":"Từ 「nombrado」 có nghĩa là gì?","options":["đặt tên","ổn","màu đen","phủ nhận"],"answer_index":0,"explanation":"nombrado = đặt tên"},{"question":"Từ 「obtenido」 có nghĩa là gì?","options":["thu được","ổn","màu đen","phủ nhận"],"answer_index":0,"explanation":"obtenido = thu được"},{"question":"Từ 「participaron」 có nghĩa là gì?","options":["đã tham gia","ổn","màu đen","phủ nhận"],"answer_index":0,"explanation":"participaron = đã tham gia"},{"question":"Từ 「participó」 có ng