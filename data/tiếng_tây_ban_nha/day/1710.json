planation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1710","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"innovadoraを 使います。","line_vi":"Tôi dùng innovadora.","focus_words":["innovadora"]},{"speaker":"B","line_target":"intentaban は 何ですか。","line_vi":"intentaban là cái gì?","focus_words":["intentaban"]},{"speaker":"A","line_target":"interminablesです。","line_vi":"Đó là interminables.","focus_words":["interminables"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「innovadora」 có nghĩa là gì?","options":["đổi mới","họ đã cố gắng","vô tận","sự say sưa"],"answer_index":0,"explanation":"innovadora = đổi mới"},{"question":"Từ 「intentaban」 có nghĩa là gì?","options":["họ đã cố gắng","đổi mới","vô tận","sự say sưa"],"answer_index":0,"explanation":"intentaban = họ đã cố gắng"},{"question":"Từ 「interminables」 có nghĩa là gì?","options":["vô tận","đổi mới","họ đã cố gắng","sự say sưa"],"answer_index":0,"explanation":"interminables = vô tận"},{"question":"Từ 「intoxicación」 có nghĩa là gì?","options":["sự say sưa","đổi mới","họ đã cố gắng","vô tận"],"answer_index":0,"explanation":"intoxicación = sự say sưa"},{"question":"Từ 「inventos」 có nghĩa là gì?","options":["những phát minh","đổi mới","họ đã cố gắng","vô tận"],"answer_index":0,"explanation":"inventos = những phát minh"},{"question":"Từ 「iquique」 có nghĩa là gì?","options":["chất lỏng","đổi mới","họ đã cố gắng","vô tận"],"answer_index":0,"explanation":"iquique = chất lỏng"},{"question":"Từ 「izquierdista」 có nghĩa là gì?","options":["cánh tả","đổi mới","họ đã cố gắng","vô tận"],"answer_index":0,"explanation":"izquierdista = cánh tả"},{"question":"Từ 「josefa」 có nghĩa là gì?","options":["Joseph","đổi mới","họ đã cố gắng","vô tận"],"answer_index":0,"explanation":"josefa = Joseph"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đổi mới","options":["innovadora","inte