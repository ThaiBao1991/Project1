","part_of_speech":"","meaning_vi":"hàng","explanation":"hàng","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d9ad32f4","audio_ref":"m_a95b63c1","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_de7bb175"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 388","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"darlesを 使います。","line_vi":"Tôi dùng darles.","focus_words":["darles"]},{"speaker":"B","line_target":"deberán は 何ですか。","line_vi":"deberán là cái gì?","focus_words":["deberán"]},{"speaker":"A","line_target":"desaparecerです。","line_vi":"Đó là desaparecer.","focus_words":["desaparecer"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f78c869d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「darles」 có nghĩa là gì?","options":["đưa cho họ","họ phải","biến mất","tải về"],"answer_index":0,"explanation":"darles = đưa cho họ"},{"question":"Từ 「deberán」 có nghĩa là gì?","options":["họ phải","đưa cho họ","biến mất","tải về"],"answer_index":0,"explanation":"deberán = họ phải"},{"question":"Từ 「desaparecer」 có nghĩa là gì?","options":["biến mất","đưa cho họ","họ phải","tải về"],"answer_index":0,"explanation":"desaparecer = biến mất"},{"question":"Từ 「descarga」 có nghĩa là gì?","options":["tải về","đưa cho họ","họ phải","biến mất"],"answer_index":0,"explanation":"descarga = tải về"},{"question":"Từ 「dibujos」 có nghĩa là gì?","options":["bản vẽ","đưa cho họ","họ phải","biến mất"],"answer_index":0,"explanation":"dibujos = bản vẽ"},{"question":"Từ 「empezamos」 có nghĩa là gì?","options":["chúng tôi bắt đầu","đưa cho họ","họ phải","biến mất"],"answer_index":0,"explanation":"empezamos = chúng tôi bắt đầu"},{"question":"Từ 「específicamente」 có nghĩa là gì?","options":["cụ thể","đưa cho họ","họ phải","biến mất"],"answer_index":0,"explanation":"específicamente = cụ thể"},{"question":"Từ 「facilitar」 có nghĩa là gì?","options":["tạo điều kiện thuận lợi","đưa cho họ","họ phải","biến mất"],"answer_index":0,"explanation":"facilitar = tạo điều kiện thuận lợi"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đưa cho họ","options":["darles","deberán","desaparecer","descarga"],"answer_index":0,"explanation":"darles = đưa cho họ"},{"question":"Chọn từ đúng cho nghĩa: họ phải","options":["deberán","darles","desaparecer","descarga"],"answer_index":0,"explanation":"deberán = họ phải"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"darles":"m_59f52e57","deberán":"m_9d5180f9","desaparecer":"m_f5a30a0d","descarga":"m_256267a7","dibujos":"m_0fcfe067","empezamos":"m_a90697f8","específicamente":"m_a88a9428","facilitar":"m_6bc0e1e0","famosos":"m_3b6be1b2","fila":"m_a95b63c1"},"dialogue_audio":{"0":"m_f78c869d"}},"media_map":{"m_f78be2fb":"media/tiếng_tây_ban_nha/d0388/word_00_b30f76be.webp","m_67a42134":"media/tiếng_tây_ban_nha/d0388/word_01_6e3bd173.webp","m_37797af6":"media/tiếng_tây_ban_nha/d0388/word_02_fd84040d.webp","m_dc7702a9":"media/tiếng_tây_ban_nha/d0388/word_03_920f8d26.webp","m_14612c9d":"media/tiếng_tây_ban_nha/d0388/word_04_f2b8e00e.webp","m_27fdcb9d":"media/tiếng_tây_ban_nha/d0388/word_05_c2b3ed29.webp","m_e91ca21e":"media/tiếng_tây_ban_nha/d0388/word_06_b9569f59.webp","m_b1f66888":"media/tiếng_tây_ban_nha/d0388/word_07_9651f637.webp","m_84421afd":"media/tiếng_tây_ban_nha/d0388/word_08_5ff6f98d.webp","m_d9ad32f4":"media/tiếng_tây_ban_nha/d0388/word_09_ffcc1d91.webp","m_59f52e57":"media/tiếng_tây_ban_nha/d0388/audio_vocab_00_9374a063.mp3","m_80a25a9b":"media/tiếng_tây_ban_nha/d0388/audio_vocab_00_vi_188b66c6.mp3","m_9d5180f9":"media/tiếng_tây_ban_nha/d0388/au