ì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 468","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"paraísoを 使います。","line_vi":"Tôi dùng paraíso.","focus_words":["paraíso"]},{"speaker":"B","line_target":"pasen は 何ですか。","line_vi":"pasen là cái gì?","focus_words":["pasen"]},{"speaker":"A","line_target":"pendientesです。","line_vi":"Đó là pendientes.","focus_words":["pendientes"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5642106a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「paraíso」 có nghĩa là gì?","options":["thiên đường","vượt qua","bông tai","bán đảo"],"answer_index":0,"explanation":"paraíso = thiên đường"},{"question":"Từ 「pasen」 có nghĩa là gì?","options":["vượt qua","thiên đường","bông tai","bán đảo"],"answer_index":0,"explanation":"pasen = vượt qua"},{"question":"Từ 「pendientes」 có nghĩa là gì?","options":["bông tai","thiên đường","vượt qua","bán đảo"],"answer_index":0,"explanation":"pendientes = bông tai"},{"question":"Từ 「península」 có nghĩa là gì?","options":["bán đảo","thiên đường","vượt qua","bông tai"],"answer_index":0,"explanation":"península = bán đảo"},{"question":"Từ 「poderosa」 có nghĩa là gì?","options":["mạnh mẽ","thiên đường","vượt qua","bông tai"],"answer_index":0,"explanation":"poderosa = mạnh mẽ"},{"question":"Từ 「posteriores」 có nghĩa là gì?","options":["sau này","thiên đường","vượt qua","bông tai"],"answer