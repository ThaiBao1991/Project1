":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp á