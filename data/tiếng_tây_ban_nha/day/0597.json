は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 597","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"telefónicaを 使います。","line_vi":"Tôi dùng telefónica.","focus_words":["telefónica"]},{"speaker":"B","line_target":"testamento は 何ですか。","line_vi":"testamento là cái gì?","focus_words":["testamento"]},{"speaker":"A","line_target":"toleranciaです。","line_vi":"Đó là tolerancia.","focus_words":["tolerancia"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_28322c4b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「telefónica」 có nghĩa là gì?","options":["điện thoại","sẽ","khoan dung","bò đực"],"answer_index":0,"explanation":"telefónica = điện thoại"},{"question":"Từ 「testamento」 có nghĩa là gì?","options":["sẽ","điện thoại","khoan dung","bò đực"],"answer_index":0,"explanation":"testamento = sẽ"},{"question":"Từ 「tolerancia」 có nghĩa là gì?","options":["khoan dung","điện thoại","sẽ","bò đực"],"answer_index":0,"explanation":"tolerancia = khoan dung"},{"question":"Từ 「toros」 có nghĩa là gì?","options":["bò đực","điện thoại","sẽ","khoan dung"],"answer_index":0,"explanation":"toros = bò đực"},{"question":"Từ 「traducido」 có nghĩa là gì?","options":["đã dịch","điện thoại","sẽ","khoan dung"],"answer_index":0,"explanation":"traducido = đã dịch"},{"question":"Từ 「transparente」 có nghĩa là gì?","options":["trong suốt","điện thoại","sẽ","khoan dung"],"answer_index":0,"explanation":"transparente = trong suốt"},{"que