n."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 409","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ácidoを 使います。","line_vi":"Tôi dùng ácido.","focus_words":["ácido"]},{"speaker":"B","line_target":"ademas は 何ですか。","line_vi":"ademas là cái gì?","focus_words":["ademas"]},{"speaker":"A","line_target":"afectadosです。","line_vi":"Đó là afectados.","focus_words":["afectados"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_20d4cb31","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ácido」 có nghĩa là gì?","options":["axit","cũng","bị ảnh hưởng","căn hộ"],"answer_index":0,"explanation":"ácido = axit"},{"question":"Từ 「ademas」 có nghĩa là gì?","options":["cũng","axit","bị ảnh hưởng","căn hộ"],"answer_index":0,"explanation":"ademas = cũng"},{"question":"Từ 「afectados」 có nghĩa là gì?","options":["bị ảnh hưởng","axit","cũng","căn hộ"],"answer_index":0,"explanation":"afectados = bị ảnh hưởng"},{"question":"Từ 「apartamento」 có nghĩa là gì?","options":["căn hộ","axit","cũng","bị ảnh hưởng"],"answer_index":0,"explanation":"apartamento = căn hộ"},{"question":"Từ 「barato」 có nghĩa là gì?","options":["giá rẻ","axit","cũng","bị ảnh hưởng"],"answer_index":0,"explanation":"barato = giá rẻ"},{"question":"Từ 「biblia」 có nghĩa là gì?","options":["kinh thánh","axit","cũng","bị ảnh hưởng"],"answer_index":0,"explanation":"biblia = kinh thánh"},{"question":"Từ 「bombas」 có nghĩa là gì?","options":["bom","axit","cũng","bị ảnh hưởng"],"answer_index":0,"explanation":"bombas = bom"},{"question":"Từ 「buscas」 có nghĩa là gì?","options":["bạn tìm kiếm","a