:"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 383","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"poemaを 使います。","line_vi":"Tôi dùng poema.","focus_words":["poema"]},{"speaker":"B","line_target":"pri は 何ですか。","line_vi":"pri là cái gì?","focus_words":["pri"]},{"speaker":"A","line_target":"promesaです。","line_vi":"Đó là promesa.","focus_words":["promesa"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a84d47ad","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「poema」 có nghĩa là gì?","options":["bài thơ","ưu tiên","lời hứa","cuộc biểu tình"],"answer_index":0,"explanation":"poema = bài thơ"},{"question":"Từ 「pri」 có nghĩa là gì?","options":["ưu tiên","bài thơ","lời hứa","cuộc biểu tình"],"answer_index":0,"explanation":"pri = ưu tiên"},{"question":"Từ 「promesa」 có nghĩa là gì?","options":["lời hứa","bài thơ","ưu tiên","cuộc biểu tình"],"answer_index":0,"explanation":"promesa = lời hứa"},{"question":"Từ 「protestas」 có nghĩa là gì?","options":["cuộc biểu tình","bài thơ","ưu tiên","lời hứa"],"answer_index":0,"explanation":"protestas = cuộc biểu tình"},{"question":"Từ 「pudieran」 có nghĩa là gì?","options":["có thể","bài thơ","ưu tiên","lời hứa"],"answer_index":0,"explanation":"pudieran = có thể"},{"question":"Từ 「queja」 có nghĩa là gì?","options":["phàn nàn","bài thơ","ưu tiên","lời hứa"],"answer_index":0,"explanation":"queja = phàn nàn"},{"question":"Từ 「quinta」 có nghĩa là gì?","option