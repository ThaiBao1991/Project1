〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 475","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"emocionalを 使います。","line_vi":"Tôi dùng emocional.","focus_words":["emocional"]},{"speaker":"B","line_target":"encanto は 何ですか。","line_vi":"encanto là cái gì?","focus_words":["encanto"]},{"speaker":"A","line_target":"entranです。","line_vi":"Đó là entran.","focus_words":["entran"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e2150588","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「emocional」 có nghĩa là gì?","options":["cảm động","quyến rũ","họ bước vào","tôi nghe nói"],"answer_index":0,"explanation":"emocional = cảm động"},{"question":"Từ 「encanto」 có nghĩa là gì?","options":["quyến rũ","cảm động","họ bước vào","tôi nghe nói"],"answer_index":0,"explanation":"encanto = quyến rũ"},{"question":"Từ 「entran」 có nghĩa là gì?","options":["họ bước vào","cảm động","quyến rũ","tôi nghe nói"],"answer_index":0,"explanation":"entran = họ bước vào"},{"question":"Từ 「escuché」 có nghĩa là gì?","options":["tôi nghe nói","cảm động","quyến rũ","họ bước vào"],"answer_index":0,"explanation":"escuché = tôi nghe nói"},{"question":"Từ 「escudo」 có nghĩa là gì?","options":["cái khiên","cảm động","quyến rũ","họ bước vào"],"answer_index":0,"explanation":"escudo = cái khiên"},{"question":"Từ 「estancia」 có ng