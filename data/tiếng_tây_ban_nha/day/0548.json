ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_9a55d3c6","audio_ref":"m_b0eaf098","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f1f6308e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 548","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"juiciosを 使います。","line_vi":"Tôi dùng juicios.","focus_words":["juicios"]},{"speaker":"B","line_target":"lavado は 何ですか。","line_vi":"lavado là cái gì?","focus_words":["lavado"]},{"speaker":"A","line_target":"lesiónです。","line_vi":"Đó là lesión.","focus_words":["lesión"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_db2bcfe8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「juicios」 có nghĩa là gì?","options":["thử nghiệm","rửa","chấn thương","văn học"],"answer_index":0,"explanation":"juicios = thử nghiệm"},{"question":"Từ 「lavado」 có nghĩa là gì?","options":["rửa","thử nghiệm","chấn thương","văn học"],"answer_index":0,"explanation":"lavado = rửa"},{"question":"Từ 「lesión」 có nghĩa là gì?","options":["chấn thương","thử nghiệm","rửa","văn học"],"answer_index":0,"explanation":"lesión = chấn thương"},{"question":"Từ 「literaria」 có nghĩa là gì?","options":["văn học","thử nghiệm","rửa","chấn thương"],"answer_index":0,"explanation":"literaria = văn học"},{"question":"Từ 「lleguen」 có nghĩa là gì?","options":["đến","thử nghiệm","rửa","chấn thương"],"answer_index":0,"explanation":"lleguen = đến"},{"question":"Từ 「mami」 có nghĩa là gì?","options":["mẹ ơi","thử nghiệm","rửa","chấn thương"],"answer_ind