せんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 522","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"acosoを 使います。","line_vi":"Tôi dùng acoso.","focus_words":["acoso"]},{"speaker":"B","line_target":"alrededores は 何ですか。","line_vi":"alrededores là cái gì?","focus_words":["alrededores"]},{"speaker":"A","line_target":"alturasです。","line_vi":"Đó là alturas.","focus_words":["alturas"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f7fc490f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「acoso」 có nghĩa là gì?","options":["quấy rối","môi trường xung quanh","độ cao","thiên thần"],"answer_index":0,"explanation":"acoso = quấy rối"},{"question":"Từ 「alrededores」 có nghĩa là gì?","options":["môi trường xung quanh","quấy rối","độ cao","thiên thần"],"answer_index":0,"explanation":"alrededores = môi trường xung quanh"},{"question":"Từ 「alturas」 có nghĩa là gì?","options":["độ cao","quấy rối","môi trường xung quanh","thiên thần"],"answer_index":0,"explanation":"alturas = độ cao"},{"question":"Từ 「angel」 có nghĩa là gì?","options":["thiên thần","quấy rối","môi trường xung quanh","độ cao"],"answer_index":0,"explanation":"angel = thiên thần"},{"question":"Từ 「aportar」 có nghĩa là gì?","options":["đóng góp","quấy rối","môi trường xung quanh","độ cao"],"answer_index":0,"explanation