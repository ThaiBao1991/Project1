)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 479","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"musicalesを 使います。","line_vi":"Tôi dùng musicales.","focus_words":["musicales"]},{"speaker":"B","line_target":"negociación は 何ですか。","line_vi":"negociación là cái gì?","focus_words":["negociación"]},{"speaker":"A","line_target":"oficioです。","line_vi":"Đó là oficio.","focus_words":["oficio"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f3277142","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「musicales」 có nghĩa là gì?","options":["nhạc kịch","đàm phán","nghề nghiệp","dừng lại"],"answer_index":0,"explanation":"musicales = nhạc kịch"},{"question":"Từ 「negociación」 có nghĩa là gì?","options":["đàm phán","nhạc kịch","nghề nghiệp","dừng lại"],"answer_index":0,"explanation":"negociación = đàm phán"},{"question":"Từ 「oficio」 có nghĩa là gì?","options":["nghề nghiệp","nhạc kịch","đàm phán","dừng lại"],"answer_index":0,"explanation":"oficio = nghề nghiệp"},{"question":"Từ 「parado」 có nghĩa là gì?","options":["dừng lại","nhạc kịch","đàm phán","nghề nghiệp"],"answer_index":0,"explanation":"parado = dừng lại"},{"question":"Từ 「pierden」 có nghĩa là gì?","options":["thua","nhạc kịch","đàm phán","nghề nghiệp"],"answer_index":0,"explanation":"pierden = thua"},{"question":"Từ 「pre