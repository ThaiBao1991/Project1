ế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 472","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"asaltoを 使います。","line_vi":"Tôi dùng asalto.","focus_words":["asalto"]},{"speaker":"B","line_target":"berlín は 何ですか。","line_vi":"berlín là cái gì?","focus_words":["berlín"]},{"speaker":"A","line_target":"botónです。","line_vi":"Đó là botón.","focus_words":["botón"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5dce2b85","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「asalto」 có nghĩa là gì?","options":["tấn công","Béc-lin","nút","cơ bản"],"answer_index":0,"explanation":"asalto = tấn công"},{"question":"Từ 「berlín」 có nghĩa là gì?","options":["Béc-lin","tấn công","nút","cơ bản"],"answer_index":0,"explanation":"berlín = Béc-lin"},{"question":"Từ 「botón」 có nghĩa là gì?","options":["nút","tấn công","Béc-lin","cơ bản"],"answer_index":0,"explanation":"botón = nút"},{"question":"Từ 「básicas」 có nghĩa là gì?","options":["cơ bản","tấn công","Béc-lin","nút"],"answer_index":0,"explanation":"básicas = cơ bản"},{"question":"Từ 「cercanos」 có nghĩa là gì?","options":["gần đó","tấn công","Béc-lin","nút"],"answer_index":0,"explanation":"cercanos = gần đó"},{"question":"Từ 「colegas」 có nghĩa là gì?","options":["đồng nghiệp","tấn công","Béc-lin","nút"],"answer_index":0,"explanation":"colegas = đồng nghiệp"},{"question":"Từ 「colombiana」 có nghĩa