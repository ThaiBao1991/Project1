 vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 567","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"determinaciónを 使います。","line_vi":"Tôi dùng determinación.","focus_words":["determinación"]},{"speaker":"B","line_target":"donald は 何ですか。","line_vi":"donald là cái gì?","focus_words":["donald"]},{"speaker":"A","line_target":"duermeです。","line_vi":"Đó là duerme.","focus_words":["duerme"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dd3f98a3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「determinación」 có nghĩa là gì?","options":["quyết tâm","Donald","ngủ","emilio"],"answer_index":0,"explanation":"determinación = quyết tâm"},{"question":"Từ 「donald」 có nghĩa là gì?","options":["Donald","quyết tâm","ngủ","emilio"],"answer_index":0,"explanation":"donald = Donald"},{"question":"Từ 「duerme」 có nghĩa là gì?","options":["ngủ","quyết tâm","Donald","emilio"],"answer_index":0,"explanation":"duerme = ngủ"},{"question":"Từ 「emilio」 có nghĩa là gì?","options":["emilio","quyết tâm","Donald","ngủ"],"answer_index":0,"explanation":"emilio = emilio"},{"question":"Từ 「enfrentamiento」 có nghĩa là gì?","options":["sự đối đầu","quyết tâm","Donald","ngủ"],"answer_index":0,"explanation":"enfrentamiento = sự đối đầu"},{"question":"Từ 「engañar」 có nghĩa là gì?","options":["gian lận","quyết tâm","Donald","ngủ"],"answer_index":0,"explanation":"engañar = gian lận"},{"question":"T