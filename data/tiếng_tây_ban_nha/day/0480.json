ve)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 480","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"sagradoを 使います。","line_vi":"Tôi dùng sagrado.","focus_words":["sagrado"]},{"speaker":"B","line_target":"salgan は 何ですか。","line_vi":"salgan là cái gì?","focus_words":["salgan"]},{"speaker":"A","line_target":"salimosです。","line_vi":"Đó là salimos.","focus_words":["salimos"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ce93c01d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「sagrado」 có nghĩa là gì?","options":["thiêng liêng","đi ra","chúng tôi đi chơi","hoang dã"],"answer_index":0,"explanation":"sagrado = thiêng liêng"},{"question":"Từ 「salgan」 có nghĩa là gì?","options":["đi ra","thiêng liêng","chúng tôi đi chơi","hoang dã"],"answer_index":0,"explanation":"salgan = đi ra"},{"question":"Từ 「salimos」 có nghĩa là gì?","options":["chúng tôi đi chơi","thiêng liêng","đi ra","hoang dã"],"answer_index":0,"explanation":"salimos = chúng tôi đi chơi"},{"question":"Từ 「salvaje」 có nghĩa là gì?","options":["hoang dã","thiêng liêng","đi ra","chúng tôi đi chơi"],"answer_index":0,"explanation":"salvaje = hoang dã"},{"question":"Từ 「sanciones」 có nghĩa là gì?","options":["biện pháp trừng phạt","thiêng liêng","đi ra","chúng tôi đi chơi"],"answer_index":0,"explanation":"sanciones