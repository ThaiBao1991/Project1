です"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 352","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"hermanasを 使います。","line_vi":"Tôi dùng hermanas.","focus_words":["hermanas"]},{"speaker":"B","line_target":"identificar は 何ですか。","line_vi":"identificar là cái gì?","focus_words":["identificar"]},{"speaker":"A","line_target":"incluirです。","line_vi":"Đó là incluir.","focus_words":["incluir"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_19f7003d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「hermanas」 có nghĩa là gì?","options":["chị em","xác định","bao gồm","người đọc"],"answer_index":0,"explanation":"hermanas = chị em"},{"question":"Từ 「identificar」 có nghĩa là gì?","options":["xác định","chị em","bao gồm","người đọc"],"answer_index":0,"explanation":"identificar = xác định"},{"question":"Từ 「incluir」 có nghĩa là gì?","options":["bao gồm","chị em","xác định","người đọc"],"answer_index":0,"explanation":"incluir = bao gồm"},{"question":"Từ 「lector」 có nghĩa là gì?","options":["người đọc","chị em","xác định","bao gồm"],"answer_index":0,"explanation":"lector = người đọc"},{"question":"Từ 「logro」 có nghĩa là gì?","options":["thành tích","chị em","xác định","bao gồm"],"answer_index":0,"explanati