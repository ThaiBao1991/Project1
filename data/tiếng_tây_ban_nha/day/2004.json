ene」 có nghĩa là gì?","options":["đặt hàng","bạn nhận được","sự xuất hiện","chậu"],"answer_index":0,"explanation":"ordene = đặt hàng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bạn nhận được","options":["obtienes","ocurrencia","ollas","oposicion"],"answer_index":0,"explanation":"obtienes = bạn nhận được"},{"question":"Chọn từ đúng cho nghĩa: sự xuất hiện","options":["ocurrencia","obtienes","ollas","oposicion"],"answer_index":0,"explanation":"ocurrencia = sự xuất hiện"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}