ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 364","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"aprovecharを 使います。","line_vi":"Tôi dùng aprovechar.","focus_words":["aprovechar"]},{"speaker":"B","line_target":"basa は 何ですか。","line_vi":"basa là cái gì?","focus_words":["basa"]},{"speaker":"A","line_target":"belloです。","line_vi":"Đó là bello.","focus_words":["bello"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dd65b134","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「aprovechar」 có nghĩa là gì?","options":["tận dụng lợi thế","căn cứ","đẹp","hoan hô"],"answer_index":0,"explanation":"aprovechar = tận dụng lợi thế"},{"question":"Từ 「basa」 có nghĩa là gì?","options":["căn cứ","tận dụng lợi thế","đẹp","hoan hô"],"answer_index":0,"explanation":"basa = căn cứ"},{"question":"Từ 「bello」 có nghĩa là gì?","options":["đẹp","tận dụng lợi thế","căn cứ","hoan hô"],"answer_index":0,"explanation":"bello = đẹp"},{"question":"Từ 「bravo」 có nghĩa là gì?","options":["hoan hô","tận dụng lợi thế","căn cứ","đẹp"],"answer_index":0,"explanation":"bravo = hoan hô"},{"question":"Từ 「cabezas」 có nghĩa là gì?","options":["cái đầu","tận dụng lợi thế","căn cứ","đẹp"],"answer_index":0,"explanation":"cabezas = cái đầu"},{"question":"Từ 「catalán」 có nghĩa là gì?","options":["tiếng Catalan","tận dụng lợi thế","