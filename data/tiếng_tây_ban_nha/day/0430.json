m bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 430","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"frankを 使います。","line_vi":"Tôi dùng frank.","focus_words":["frank"]},{"speaker":"B","line_target":"ganadores は 何ですか。","line_vi":"ganadores là cái gì?","focus_words":["ganadores"]},{"speaker":"A","line_target":"gerenteです。","line_vi":"Đó là gerente.","focus_words":["gerente"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_561d2e42","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「frank」 có nghĩa là gì?","options":["thẳng thắn","người chiến thắng","người quản lý","vết thương"],"answer_index":0,"explanation":"frank = thẳng thắn"},{"question":"Từ 「ganadores」 có nghĩa là gì?","options":["người chiến thắng","thẳng thắn","người quản lý","vết thương"],"answer_index":0,"explanation":"ganadores = người chiến thắng"},{"question":"Từ 「gerente」 có nghĩa là gì?","options":["người quản lý","thẳng thắn","người chiến thắng","vết thương"],"answer_index":0,"explanation":"gerente = người quản lý"},{"question":"Từ 「herida」 có nghĩa là gì?","options":["vết thương","thẳng thắn","người chiến thắng","người quản lý"],"answer_index":0,"explanation":"herida = vết thương"},{"question":"Từ 「impedir」 có nghĩa là gì?","options":["ngăn chặn","thẳng thắn","người chiến thắng","người quản lý"],"answer_index":0,"explanation":"impedir = ngăn chặn"},{"question":"Từ 「importe」 có n