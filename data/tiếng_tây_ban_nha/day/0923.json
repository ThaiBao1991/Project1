íamos","existan","extendió","favorece"],"answer_index":0,"explanation":"estaríamos = chúng tôi sẽ như vậy"},{"question":"Chọn từ đúng cho nghĩa: tồn tại","options":["existan","estaríamos","extendió","favorece"],"answer_index":0,"explanation":"existan = tồn tại"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}