c + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 413","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ignoranciaを 使います。","line_vi":"Tôi dùng ignorancia.","focus_words":["ignorancia"]},{"speaker":"B","line_target":"incidente は 何ですか。","line_vi":"incidente là cái gì?","focus_words":["incidente"]},{"speaker":"A","line_target":"independientementeです。","line_vi":"Đó là independientemente.","focus_words":["independientemente"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_64608fd5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ignorancia」 có nghĩa là gì?","options":["sự thiếu hiểu biết","sự cố","bất kể","thông báo"],"answer_index":0,"explanation":"ignorancia = sự thiếu hiểu biết"},{"question":"Từ 「incidente」 có nghĩa là gì?","options":["sự cố","sự thiếu hiểu biết","bất kể","thông báo"],"answer_index":0,"explanation":"incidente = sự cố"},{"question":"Từ 「independientemente」 có nghĩa là gì?","options":["bất kể","sự thiếu hiểu biết","sự cố","thông báo"],"answer_index":0,"explanation":"independientemente = bất kể"},{"question":"Từ 「informado」 có nghĩa là gì?","options":["thông báo","sự thiếu hiểu biết","sự cố","bất kể"],"answer_index":0,"explanation":"informado = thông báo"},{"question":"Từ 「inscripción」 có nghĩa là gì?","options":["đăng ký","sự thiếu hiểu biết","sự cố","bất kể"],"answer_index":0,"explanation":"inscripción = đăng ký"},{"questio