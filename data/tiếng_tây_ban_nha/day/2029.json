izan"]},{"speaker":"B","line_target":"generosos は 何ですか。","line_vi":"generosos là cái gì?","focus_words":["generosos"]},{"speaker":"A","line_target":"gtaです。","line_vi":"Đó là gta.","focus_words":["gta"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「garantizan」 có nghĩa là gì?","options":["đảm bảo","hào phóng","gta","đẹp trai"],"answer_index":0,"explanation":"garantizan = đảm bảo"},{"question":"Từ 「generosos」 có nghĩa là gì?","options":["hào phóng","đảm bảo","gta","đẹp trai"],"answer_index":0,"explanation":"generosos = hào phóng"},{"question":"Từ 「gta」 có nghĩa là gì?","options":["gta","đảm bảo","hào phóng","đẹp trai"],"answer_index":0,"explanation":"gta = gta"},{"question":"Từ 「guapos」 có nghĩa là gì?","options":["đẹp trai","đảm bảo","hào phóng","gta"],"answer_index":0,"explanation":"guapos = đẹp trai"},{"question":"Từ 「guardada」 có nghĩa là gì?","options":["đã lưu","đảm bảo","hào phóng","gta"],"answer_index":0,"explanation":"guardada = đã lưu"},{"question":"Từ 「hacés」 có nghĩa là gì?","options":["bạn làm","đảm bảo","hào phóng","gta"],"answer_index":0,"explanation":"hacés = bạn làm"},{"question":"Từ 「hambrientos」 có nghĩa là gì?","options":["đói bụng","đảm bảo","hào phóng","gta"],"answer_index":0,"explanation":"hambrientos = đói bụng"},{"question":"Từ 「hardcore」 có nghĩa là gì?","options":["khó tính","đảm bảo","hào phóng","gta"],"answer_index":0,"explanation":"hardcore = khó tính"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đảm bảo","options":["garantizan","generosos","gta","guapos"],"answer_index":0,"explanation":"garantizan = đảm bảo"},{"question":"Chọn từ đúng cho nghĩa: hào phóng","options":["generosos","garantizan","gta","guapos"],"answer_index":0,"explanation":"generosos = hào phóng"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","