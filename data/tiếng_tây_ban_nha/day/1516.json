_words":["rompecabezas"]},{"speaker":"B","line_target":"rubros は 何ですか。","line_vi":"rubros là cái gì?","focus_words":["rubros"]},{"speaker":"A","line_target":"ríenです。","line_vi":"Đó là ríen.","focus_words":["ríen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「rompecabezas」 có nghĩa là gì?","options":["câu đố","đồ vật","họ cười","hướng ngoại"],"answer_index":0,"explanation":"rompecabezas = câu đố"},{"question":"Từ 「rubros」 có nghĩa là gì?","options":["đồ vật","câu đố","họ cười","hướng ngoại"],"answer_index":0,"explanation":"rubros = đồ vật"},{"question":"Từ 「ríen」 có nghĩa là gì?","options":["họ cười","câu đố","đồ vật","hướng ngoại"],"answer_index":0,"explanation":"ríen = họ cười"},{"question":"Từ 「saliente」 có nghĩa là gì?","options":["hướng ngoại","câu đố","đồ vật","họ cười"],"answer_index":0,"explanation":"saliente = hướng ngoại"},{"question":"Từ 「salirse」 có nghĩa là gì?","options":["ra ngoài","câu đố","đồ vật","họ cười"],"answer_index":0,"explanation":"salirse = ra ngoài"},{"question":"Từ 「saliva」 có nghĩa là gì?","options":["nước bọt","câu đố","đồ vật","họ cười"],"answer_index":0,"explanation":"saliva = nước bọt"},{"question":"Từ 「sancionar」 có nghĩa là gì?","options":["sự trừng phạt","câu đố","đồ vật","họ cười"],"answer_index":0,"explanation":"sancionar = sự trừng phạt"},{"question":"Từ 「sandy」 có nghĩa là gì?","options":["cát","câu đố","đồ vật","họ cười"],"answer_index":0,"explanation":"sandy = cát"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: câu đố","options":["rompecabezas","rubros","ríen","saliente"],"answer_index":0,"explanation":"rompecabezas = câu đố"},{"question":"Chọn từ đúng cho nghĩa: đồ vật","options":["rubros","rompecabezas","ríen","saliente"],"answer_index":0,"explanation":"rubros = đồ vật"}],"common":[],"grammar":[],"mixed":[]