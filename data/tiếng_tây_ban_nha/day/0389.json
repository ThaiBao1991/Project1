 để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 389","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"firmarを 使います。","line_vi":"Tôi dùng firmar.","focus_words":["firmar"]},{"speaker":"B","line_target":"fumar は 何ですか。","line_vi":"fumar là cái gì?","focus_words":["fumar"]},{"speaker":"A","line_target":"futbolです。","line_vi":"Đó là futbol.","focus_words":["futbol"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_63802bf7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「firmar」 có nghĩa là gì?","options":["ký tên","khói","bóng đá","la hét"],"answer_index":0,"explanation":"firmar = ký tên"},{"question":"Từ 「fumar」 có nghĩa là gì?","options":["khói","ký tên","bóng đá","la hét"],"answer_index":0,"explanation":"fumar = khói"},{"question":"Từ 「futbol」 có nghĩa là gì?","options":["bóng đá","ký tên","khói","la hét"],"answer_index":0,"explanation":"futbol = bóng đá"},{"question":"Từ 「gritos」 có nghĩa là gì?","options":["la hét","ký tên","khói","bóng đá"],"answer_index":0,"explanation":"gritos = la hét"},{"question":"Từ 「hayas」 có nghĩa là gì?","options":["cây sồi","ký tên","khói","bóng đá"],"answer_index":0,"explanation":"hayas = cây sồi"},{"question":"Từ 「henry」 có nghĩa là gì?","options":["Henry","ký tên","khói","bóng đá"],"answer_index":0,"explanation":"henry = Henry"},{"question":"Từ 「herido」 có nghĩa là gì?","options":["bị thương","ký tên","khói