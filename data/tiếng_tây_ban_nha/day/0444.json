odan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 444","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"aceptadoを 使います。","line_vi":"Tôi dùng aceptado.","focus_words":["aceptado"]},{"speaker":"B","line_target":"actúa は 何ですか。","line_vi":"actúa là cái gì?","focus_words":["actúa"]},{"speaker":"A","line_target":"adicionalesです。","line_vi":"Đó là adicionales.","focus_words":["adicionales"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7c879cb0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「aceptado」 có nghĩa là gì?","options":["được chấp nhận","hành động","bổ sung","tôi đánh giá cao"],"answer_index":0,"explanation":"aceptado = được chấp nhận"},{"question":"Từ 「actúa」 có nghĩa là gì?","options":["hành động","được chấp nhận","bổ sung","tôi đánh giá cao"],"answer_index":0,"explanation":"actúa = hành động"},{"question":"Từ 「adicionales」 có nghĩa là gì?","options":["bổ sung","được chấp nhận","hành động","tôi đánh giá cao"],"answer_index":0,"explanation":"adicionales = bổ sung"},{"question":"Từ 「agradezco」 có nghĩa là gì?","options":["tôi đánh giá cao","được chấp nhận","hành động","bổ sung"],"answer_index":0,"explanation":"agradezco = tôi đánh giá cao"},{"question":"Từ 「agregó」 có nghĩa là gì?","options":["đã thêm","được chấp nhận","hành động","bổ sung"],"answer_index":0,"explanation":"agregó = đã thêm"},{"question":"Từ 「ampliamente」 có nghĩa là gì?","options":["rộng rã