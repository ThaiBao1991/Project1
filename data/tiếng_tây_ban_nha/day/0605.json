ionó"]},{"speaker":"B","line_target":"nube は 何ですか。","line_vi":"nube là cái gì?","focus_words":["nube"]},{"speaker":"A","line_target":"opositoresです。","line_vi":"Đó là opositores.","focus_words":["opositores"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「mencionó」 có nghĩa là gì?","options":["đã đề cập","đám mây","đối thủ","bờ biển"],"answer_index":0,"explanation":"mencionó = đã đề cập"},{"question":"Từ 「nube」 có nghĩa là gì?","options":["đám mây","đã đề cập","đối thủ","bờ biển"],"answer_index":0,"explanation":"nube = đám mây"},{"question":"Từ 「opositores」 có nghĩa là gì?","options":["đối thủ","đã đề cập","đám mây","bờ biển"],"answer_index":0,"explanation":"opositores = đối thủ"},{"question":"Từ 「orilla」 có nghĩa là gì?","options":["bờ biển","đã đề cập","đám mây","đối thủ"],"answer_index":0,"explanation":"orilla = bờ biển"},{"question":"Từ 「oxígeno」 có nghĩa là gì?","options":["ôxy","đã đề cập","đám mây","đối thủ"],"answer_index":0,"explanation":"oxígeno = ôxy"},{"question":"Từ 「paco」 có nghĩa là gì?","options":["paco","đã đề cập","đám mây","đối thủ"],"answer_index":0,"explanation":"paco = paco"},{"question":"Từ 「paquetes」 có nghĩa là gì?","options":["gói","đã đề cập","đám mây","đối thủ"],"answer_index":0,"explanation":"paquetes = gói"},{"question":"Từ 「participando」 có nghĩa là gì?","options":["tham gia","đã đề cập","đám mây","đối thủ"],"answer_index":0,"explanation":"participando = tham gia"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: đã đề cập","options":["mencionó","nube","opositores","orilla"],"answer_index":0,"explanation":"mencionó = đã đề cập"},{"question":"Chọn từ đúng cho nghĩa: đám mây","options":["nube","mencionó","opositores","orilla"],"answer_index":0,"explanation":"nube = đám mây"}],"common":[],"grammar":[],"mixed":[]},"source":"offl