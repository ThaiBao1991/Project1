rên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 422","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"informarを 使います。","line_vi":"Tôi dùng informar.","focus_words":["informar"]},{"speaker":"B","line_target":"instancia は 何ですか。","line_vi":"instancia là cái gì?","focus_words":["instancia"]},{"speaker":"A","line_target":"izquierdoです。","line_vi":"Đó là izquierdo.","focus_words":["izquierdo"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0e66cf0a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「informar」 có nghĩa là gì?","options":["thông báo","ví dụ","trái","jaime"],"answer_index":0,"explanation":"informar = thông báo"},{"question":"Từ 「instancia」 có nghĩa là gì?","options":["ví dụ","thông báo","trái","jaime"],"answer_index":0,"explanation":"instancia = ví dụ"},{"question":"Từ 「izquierdo」 có nghĩa là gì?","options":["trái","thông báo","ví dụ","jaime"],"answer_index":0,"explanation":"izquierdo = trái"},{"question":"Từ 「jaime」 có nghĩa là gì?","options":["jaime","thông báo","ví dụ","trái"],"answer_index":0,"explanation":"jaime = jaime"},{"question":"Từ 「joda」 có nghĩa là gì?","options":["chết tiệt","thông báo","ví dụ","trái"],"answer_index":0,"explanation":"joda = chết tiệt"},{"question":"Từ 「lentamente」 có nghĩa là gì?","options":["từ từ","thông báo","ví dụ","trái"],"answer_index":0,"explanation":"lentamente = từ từ"},{"question":"Từ 「limitado」 có nghĩa là gì?","options":["hạn chế","thông báo","ví dụ","trái"],"answer_index":0,"explanation":"limitado = hạn chế"},{"question":"Từ 「llave」 c