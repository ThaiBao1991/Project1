amples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 390","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"inflaciónを 使います。","line_vi":"Tôi dùng inflación.","focus_words":["inflación"]},{"speaker":"B","line_target":"integrantes は 何ですか。","line_vi":"integrantes là cái gì?","focus_words":["integrantes"]},{"speaker":"A","line_target":"kimです。","line_vi":"Đó là kim.","focus_words":["kim"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_aeece918","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「inflación」 có nghĩa là gì?","options":["lạm phát","thành viên","Kim","giữ"],"answer_index":0,"explanation":"inflación = lạm phát"},{"question":"Từ 「integrantes」 có nghĩa là gì?","options":["thành viên","lạm phát","Kim","giữ"],"answer_index":0,"explanation":"integrantes = thành viên"},{"question":"Từ 「kim」 có nghĩa là gì?","options":["Kim","lạm phát","thành viên","giữ"],"answer_index":0,"explanation":"kim = Kim"},{"question":"Từ 「mantienen」 có nghĩa là gì?","options":["giữ","lạm phát","thành viên","Kim"],"answer_index":0,"explanation":"mantienen = giữ"},{"question":"Từ 「mató」 có nghĩa là gì?","options":["bị giết","lạm phát","thành viên","Kim"],"answer_index":0,"explanation":"mató = bị giết"},{"question":"Từ 「misterio」 có nghĩa là gì?","options":["bí ẩn","lạm phát","thành viên","Kim"],"answer_index":0,"explanation":"misterio = bí ẩn"},{"question":"Từ 「nariz」 có nghĩa là gì?","options":["m