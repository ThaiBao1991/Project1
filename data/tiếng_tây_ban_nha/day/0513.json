a":"","part_of_speech":"","meaning_vi":"cân bằng","explanation":"cân bằng","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a10c36a9","audio_ref":"m_3c36d946","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_cef492c6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mức độ lịch sự (kính ngữ/thân mật)","level":"N2","explanation":"Khách hàng ⇒ 伺います/いただきます; bạn bè ⇒ 行きます/食べます.","examples":[{"sentence":"明日 Quarter 伺います。","meaning_vi":"Ngày mai tôi sẽ ghé quý vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]},{"title":"Cấu trúc 〜ばかり","level":"N2","explanation":"〜ばかり = cứ toàn làm: 毎日ゲームばかり.","examples":[{"sentence":"毎日ゲームばかりです。","meaning_vi":"Ngày nào cũng chỉ chơi game."},{"sentence":"何も食べないばかりの生活。","meaning_vi":"Cuộc sống chỉ biết không ăn gì."}],"pronunciation_focus":"〜ばかり = cứ toàn làm.","common_mistakes":"Đừng dùng ばかり với số lượng lớn (⇒ たくさん).","mini_quiz":[{"question":"毎日ゲーム___。","options":["ばかり","だけ","しか"],"answer_index":0,"explanation":"Đáp án: ばかり"}],"references":[]},{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so s