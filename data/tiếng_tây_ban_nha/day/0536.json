ません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 536","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"especialistaを 使います。","line_vi":"Tôi dùng especialista.","focus_words":["especialista"]},{"speaker":"B","line_target":"específica は 何ですか。","line_vi":"específica là cái gì?","focus_words":["específica"]},{"speaker":"A","line_target":"esperasです。","line_vi":"Đó là esperas.","focus_words":["esperas"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5b115bc8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「especialista」 có nghĩa là gì?","options":["chuyên gia","cụ thể","bạn đợi đã","thành lập"],"answer_index":0,"explanation":"especialista = chuyên gia"},{"question":"Từ 「específica」 có nghĩa là gì?","options":["cụ thể","chuyên gia","bạn đợi đã","thành lập"],"answer_index":0,"explanation":"específica = cụ thể"},{"question":"Từ 「esperas」 có nghĩa là gì?","options":["bạn đợi đã","chuyên gia","cụ thể","thành lập"],"answer_index":0,"explanation":"esperas = bạn đợi đã"},{"question":"Từ 「estableció」 có nghĩa là gì?","options":["thành lập","chuyên gia","cụ thể","bạn đợi đã"],"answer_index":0,"explanation":"estableció = thành lập"},{"question":"Từ 「eterno」 có