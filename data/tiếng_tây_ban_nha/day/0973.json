":"N5","turns":[{"speaker":"A","line_target":"codoを 使います。","line_vi":"Tôi dùng codo.","focus_words":["codo"]},{"speaker":"B","line_target":"combinado は 何ですか。","line_vi":"combinado là cái gì?","focus_words":["combinado"]},{"speaker":"A","line_target":"compatibleです。","line_vi":"Đó là compatible.","focus_words":["compatible"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「codo」 có nghĩa là gì?","options":["khuỷu tay","kết hợp","tương thích","đồng bào"],"answer_index":0,"explanation":"codo = khuỷu tay"},{"question":"Từ 「combinado」 có nghĩa là gì?","options":["kết hợp","khuỷu tay","tương thích","đồng bào"],"answer_index":0,"explanation":"combinado = kết hợp"},{"question":"Từ 「compatible」 có nghĩa là gì?","options":["tương thích","khuỷu tay","kết hợp","đồng bào"],"answer_index":0,"explanation":"compatible = tương thích"},{"question":"Từ 「compatriotas」 có nghĩa là gì?","options":["đồng bào","khuỷu tay","kết hợp","tương thích"],"answer_index":0,"explanation":"compatriotas = đồng bào"},{"question":"Từ 「complejas」 có nghĩa là gì?","options":["phức tạp","khuỷu tay","kết hợp","tương thích"],"answer_index":0,"explanation":"complejas = phức tạp"},{"question":"Từ 「conveniencia」 có nghĩa là gì?","options":["tiện lợi","khuỷu tay","kết hợp","tương thích"],"answer_index":0,"explanation":"conveniencia = tiện lợi"},{"question":"Từ 「coordinadora」 có nghĩa là gì?","options":["điều phối viên","khuỷu tay","kết hợp","tương thích"],"answer_index":0,"explanation":"coordinadora = điều phối viên"},{"question":"Từ 「cuan」 có nghĩa là gì?","options":["làm thế nào","khuỷu tay","kết hợp","tương thích"],"answer_index":0,"explanation":"cuan = làm thế nào"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: khuỷu tay","options":["codo","combinado","compatible","compatriotas"],"answer_index":0,