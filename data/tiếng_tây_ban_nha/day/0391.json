 ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 391","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"oscuridadを 使います。","line_vi":"Tôi dùng oscuridad.","focus_words":["oscuridad"]},{"speaker":"B","line_target":"paisaje は 何ですか。","line_vi":"paisaje là cái gì?","focus_words":["paisaje"]},{"speaker":"A","line_target":"participaです。","line_vi":"Đó là participa.","focus_words":["participa"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_862bed3b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「oscuridad」 có nghĩa là gì?","options":["bóng tối","phong cảnh","tham gia","chúng tôi nghĩ"],"answer_index":0,"explanation":"oscuridad = bóng tối"},{"question":"Từ 「paisaje」 có nghĩa là gì?","options":["phong cảnh","bóng tối","tham gia","chúng tôi nghĩ"],"answer_index":0,"explanation":"paisaje = phong cảnh"},{"question":"Từ 「participa」 có nghĩa là gì?","options":["tham gia","bóng tối","phong cảnh","chúng tôi nghĩ"],"answer_index":0,"explanation":"participa = tham gia"},{"question":"Từ 「pensamos」 có nghĩa là gì?","options":["chúng tôi nghĩ","bóng tối","phong cảnh","tham gia"],"answer_index":0,"explanation":"pensamos = chúng tôi nghĩ"},{"question":"Từ 「pensó」 có nghĩa là gì?","options":["suy nghĩ","bóng tối","phong cảnh","tham gia"],"answer_index":0,"explanation":"pensó = suy nghĩ"},{"question":"Từ 「poblaciones」 có nghĩa là gì?","option