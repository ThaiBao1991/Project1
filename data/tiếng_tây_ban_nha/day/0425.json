":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 425","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"rayosを 使います。","line_vi":"Tôi dùng rayos.","focus_words":["rayos"]},{"speaker":"B","line_target":"realizadas は 何ですか。","line_vi":"realizadas là cái gì?","focus_words":["realizadas"]},{"speaker":"A","line_target":"restaurantesです。","line_vi":"Đó là restaurantes.","focus_words":["restaurantes"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e6043636","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「rayos」 có nghĩa là gì?","options":["tia","thực hiện","nhà hàng","rodrigo"],"answer_index":0,"explanation":"rayos = tia"},{"question":"Từ 「realizadas」 có nghĩa là gì?","options":["thực hiện","tia","nhà hàng","rodrigo"],"answer_index":0,"explanation":"realizadas = thực hiện"},{"question":"Từ 「restaurantes」 có nghĩa là gì?","options":["nhà hàng","tia","thực hiện","rodrigo"],"answer_index":0,"explanation":"restaurantes = nhà hàng"},{"question":"Từ 「rodrigo」 có nghĩa là gì?","options":["rodrigo","tia","thực hiện","nhà hàng"],"answer_index":0,"explanation":"rodrigo = rodrigo"},{"question":"Từ 「santander」 có nghĩa là gì?","options":["ông già Noel","tia","thực hiện","nhà hàng"],"answer_index":0,"explanation":"santander = ông già Noel"},{"question":"Từ 「semillas」 có nghĩa là gì?","options":["hạt giống","tia","thực hiện","nhà hàng"],"answer_index":0,"explanation":"semillas = hạt giống"},{"