n, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 464","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"confirmarを 使います。","line_vi":"Tôi dùng confirmar.","focus_words":["confirmar"]},{"speaker":"B","line_target":"contaminación は 何ですか。","line_vi":"contaminación là cái gì?","focus_words":["contaminación"]},{"speaker":"A","line_target":"copiasです。","line_vi":"Đó là copias.","focus_words":["copias"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e0aef587","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「confirmar」 có nghĩa là gì?","options":["xác nhận","sự ô nhiễm","bản sao","hoàn thành"],"answer_index":0,"explanation":"confirmar = xác nhận"},{"question":"Từ 「contaminación」 có nghĩa là gì?","options":["sự ô nhiễm","xác nhận","bản sao","hoàn thành"],"answer_index":0,"explanation":"contaminación = sự ô nhiễm"},{"question":"Từ 「copias」 có nghĩa là gì?","options":["bản sao","xác nhận","sự ô nhiễm","hoàn thành"],"answer_index":0,"explanation":"copias = bản sao"},{"question":"Từ 「cumplido」 có nghĩa là gì?","options":["hoàn thành","xác nhận","sự ô nhiễm","bản sao"],"answer_index":0,"explanation":"cumplido = hoàn thành"},{"question":"Từ 「descansar」 có nghĩa là gì?","options":["nghỉ ngơi","xác nhận","sự ô nhiễm","bản sao"],"answer_index":0,"explanation":"descansar = nghỉ ngơi"},{"question":"Từ 「descargar」 có nghĩa là gì?","options":["tải về","xác nhận","sự ô nhiễm","bản sao"],"answer_index":0,"explanation":