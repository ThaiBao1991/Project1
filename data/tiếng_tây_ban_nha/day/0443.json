óm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 443","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"terminanを 使います。","line_vi":"Tôi dùng terminan.","focus_words":["terminan"]},{"speaker":"B","line_target":"trayectoria は 何ですか。","line_vi":"trayectoria là cái gì?","focus_words":["trayectoria"]},{"speaker":"A","line_target":"tumbaです。","line_vi":"Đó là tumba.","focus_words":["tumba"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4df2fe65","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「terminan」 có nghĩa là gì?","options":["họ hoàn thành","quỹ đạo","phần mộ","công dụng"],"answer_index":0,"explanation":"terminan = họ hoàn thành"},{"question":"Từ 「trayectoria」 có nghĩa là gì?","options":["quỹ đạo","họ hoàn thành","phần mộ","công dụng"],"answer_index":0,"explanation":"trayectoria = quỹ đạo"},{"question":"Từ 「tumba」 có nghĩa là gì?","options":["phần mộ","họ hoàn thành","quỹ đạo","công dụng"],"answer_index":0,"explanation":"tumba = phần mộ"},{"question":"Từ 「usos」 có nghĩa là gì?","options":["công dụng","họ hoàn thành","quỹ đạo","phần mộ"],"answer_index":0,"explanation":"usos = công dụng"},{"question":"Từ 「utilización」 có nghĩa là gì?","options":["sự tận dụng","họ hoàn thành","quỹ đạo","phần mộ"],"answer_index":0,"explanation":"utilización = sự tận dụng"},{"question":"Từ 「vencer」 có nghĩa là gì?","options":["đánh bại","họ hoàn thành","quỹ đạo","phần mộ"],"answe