uation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"rotondaを 使います。","line_vi":"Tôi dùng rotonda.","focus_words":["rotonda"]},{"speaker":"B","line_target":"router は 何ですか。","line_vi":"router là cái gì?","focus_words":["router"]},{"speaker":"A","line_target":"salvaronです。","line_vi":"Đó là salvaron.","focus_words":["salvaron"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「rotonda」 có nghĩa là gì?","options":["bùng binh","bộ định tuyến","đã lưu","đau thần kinh tọa"],"answer_index":0,"explanation":"rotonda = bùng binh"},{"question":"Từ 「router」 có nghĩa là gì?","options":["bộ định tuyến","bùng binh","đã lưu","đau thần kinh tọa"],"answer_index":0,"explanation":"router = bộ định tuyến"},{"question":"Từ 「salvaron」 có nghĩa là gì?","options":["đã lưu","bùng binh","bộ định tuyến","đau thần kinh tọa"],"answer_index":0,"explanation":"salvaron = đã lưu"},{"question":"Từ 「scioli」 có nghĩa là gì?","options":["đau thần kinh tọa","bùng binh","bộ định tuyến","đã lưu"],"answer_index":0,"explanation":"scioli = đau thần kinh tọa"},{"question":"Từ 「security」 có nghĩa là gì?","options":["an ninh","bùng binh","bộ định tuyến","đã lưu"],"answer_index":0,"explanation":"security = an ninh"},{"question":"Từ 「seguirlo」 có nghĩa là gì?","options":["theo anh ấy","bùng binh","bộ định tuyến","đã lưu"],"answer_index":0,"explanation":"seguirlo = theo anh ấy"},{"question":"Từ 「sentirnos」 có nghĩa là gì?","options":["cảm thấy","bùng binh","bộ định tuyến","đã lưu"],"answer_index":0,"explanation":"sentirnos = cảm thấy"},{"question":"Từ 「separatistas」 có nghĩa là gì?","options":["những người ly khai","bùng binh","bộ định tuyến","đã lưu"],"answer_index":0,"explanation":"separatistas = những người ly khai"}],"pattern":[{"question":"Chọn từ đún