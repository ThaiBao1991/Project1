ue":[{"title":"Như người bản xứ — Ngày 2230","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"ilegítimoを 使います。","line_vi":"Tôi dùng ilegítimo.","focus_words":["ilegítimo"]},{"speaker":"B","line_target":"iluminada は 何ですか。","line_vi":"iluminada là cái gì?","focus_words":["iluminada"]},{"speaker":"A","line_target":"imitaです。","line_vi":"Đó là imita.","focus_words":["imita"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ilegítimo」 có nghĩa là gì?","options":["bất hợp pháp","chiếu sáng","bắt chước","ngầm"],"answer_index":0,"explanation":"ilegítimo = bất hợp pháp"},{"question":"Từ 「iluminada」 có nghĩa là gì?","options":["chiếu sáng","bất hợp pháp","bắt chước","ngầm"],"answer_index":0,"explanation":"iluminada = chiếu sáng"},{"question":"Từ 「imita」 có nghĩa là gì?","options":["bắt chước","bất hợp pháp","chiếu sáng","ngầm"],"answer_index":0,"explanation":"imita = bắt chước"},{"question":"Từ 「implícito」 có nghĩa là gì?","options":["ngầm","bất hợp pháp","chiếu sáng","bắt chước"],"answer_index":0,"explanation":"implícito = ngầm"},{"question":"Từ 「impresion」 có nghĩa là gì?","options":["ấn tượng","bất hợp pháp","chiếu sáng","bắt chước"],"answer_index":0,"explanation":"impresion = ấn tượng"},{"question":"Từ 「improvisado」 có nghĩa là gì?","options":["ngẫu hứng","bất hợp pháp","chiếu sáng","bắt chước"],"answer_index":0,"explanation":"improvisado = ngẫu hứng"},{"question":"Từ 「inaugurada」 có nghĩa là gì?","options":["khánh thành","bất hợp pháp","chiếu sáng","bắt chước"],"answer_index":0,"explanation":"inaugurada = khánh thành"},{"question":"Từ 「indicadas」 có nghĩa là gì?","options":["chỉ định","bất hợp pháp","chiếu sáng","bắt chước"],"answer_index":0,"explanation":"indicadas = chỉ định"}],"pattern":[{"question"