":"N5","turns":[{"speaker":"A","line_target":"fugitivoを 使います。","line_vi":"Tôi dùng fugitivo.","focus_words":["fugitivo"]},{"speaker":"B","line_target":"galo は 何ですか。","line_vi":"galo là cái gì?","focus_words":["galo"]},{"speaker":"A","line_target":"generenです。","line_vi":"Đó là generen.","focus_words":["generen"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fugitivo」 có nghĩa là gì?","options":["kẻ chạy trốn","Gaul","tạo ra","diệt chủng"],"answer_index":0,"explanation":"fugitivo = kẻ chạy trốn"},{"question":"Từ 「galo」 có nghĩa là gì?","options":["Gaul","kẻ chạy trốn","tạo ra","diệt chủng"],"answer_index":0,"explanation":"galo = Gaul"},{"question":"Từ 「generen」 có nghĩa là gì?","options":["tạo ra","kẻ chạy trốn","Gaul","diệt chủng"],"answer_index":0,"explanation":"generen = tạo ra"},{"question":"Từ 「genocida」 có nghĩa là gì?","options":["diệt chủng","kẻ chạy trốn","Gaul","tạo ra"],"answer_index":0,"explanation":"genocida = diệt chủng"},{"question":"Từ 「gestora」 có nghĩa là gì?","options":["người quản lý","kẻ chạy trốn","Gaul","tạo ra"],"answer_index":0,"explanation":"gestora = người quản lý"},{"question":"Từ 「gire」 có nghĩa là gì?","options":["rẽ","kẻ chạy trốn","Gaul","tạo ra"],"answer_index":0,"explanation":"gire = rẽ"},{"question":"Từ 「goethe」 có nghĩa là gì?","options":["goethe","kẻ chạy trốn","Gaul","tạo ra"],"answer_index":0,"explanation":"goethe = goethe"},{"question":"Từ 「granizo」 có nghĩa là gì?","options":["mưa đá","kẻ chạy trốn","Gaul","tạo ra"],"answer_index":0,"explanation":"granizo = mưa đá"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: kẻ chạy trốn","options":["fugitivo","galo","generen","genocida"],"answer_index":0,"explanation":"fugitivo = kẻ chạy trốn"},{"question":"Chọn từ đúng cho nghĩa: Gaul","options":["galo","fugitivo","generen"