t","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6ee226db","audio_ref":"m_c4384ebb","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e9ae52c8"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 435","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"asesinosを 使います。","line_vi":"Tôi dùng asesinos.","focus_words":["asesinos"]},{"speaker":"B","line_target":"bob は 何ですか。","line_vi":"bob là cái gì?","focus_words":["bob"]},{"speaker":"A","line_target":"bolsasです。","line_vi":"Đó là bolsas.","focus_words":["bolsas"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1985a05f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「asesinos」 có nghĩa là gì?","options":["sát thủ","Bob","túi xách","xe tải"],"answer_index":0,"explanation":"asesinos = sát thủ"},{"question":"Từ 「bob」 có nghĩa là gì?","options":["Bob","sát thủ","túi xách","xe tải"],"answer_index":0,"explanation":"bob = Bob"},{"question":"Từ 「bolsas」 có nghĩa là gì?","options":["túi xách","sát thủ","Bob","xe tải"],"answer_index":0,"explanation":"bolsas = túi xách"},{"question":"Từ 「camión」 có nghĩa là gì?","options":["xe tải","sát thủ","Bob","túi xách"],"answer_index":0,"explanation":"camión = xe tải"},{"question":"Từ 「canta」 có nghĩa là gì?","options":["hát","sát thủ","Bob","túi xách"],"answer_index":0,"explanation":"canta = hát"},{"question":"Từ 「certificado」 có nghĩa là gì?","options":["giấy chứng nhận","sát thủ","Bob","túi xách"],"answer_index":0,"explanation":"certificado = giấy chứng nhận"},{"question":"Từ 「citas」 có nghĩa là gì?","options"