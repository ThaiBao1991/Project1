]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2203","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"perritosを 使います。","line_vi":"Tôi dùng perritos.","focus_words":["perritos"]},{"speaker":"B","line_target":"peugeot は 何ですか。","line_vi":"peugeot là cái gì?","focus_words":["peugeot"]},{"speaker":"A","line_target":"pidioです。","line_vi":"Đó là pidio.","focus_words":["pidio"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「perritos」 có nghĩa là gì?","options":["chó con","peugeot","hỏi","bàn chải"],"answer_index":0,"explanation":"perritos = chó con"},{"question":"Từ 「peugeot」 có nghĩa là gì?","options":["peugeot","chó con","hỏi","bàn chải"],"answer_index":0,"explanation":"peugeot = peugeot"},{"question":"Từ 「pidio」 có nghĩa là gì?","options":["hỏi","chó con","peugeot","bàn chải"],"answer_index":0,"explanation":"pidio = hỏi"},{"question":"Từ 「pincel」 có nghĩa là gì?","options":["bàn chải","chó con","peugeot","hỏi"],"answer_index":0,"explanation":"pincel = bàn chải"},{"question":"Từ 「pingüinos」 có nghĩa là gì?","options":["chim cánh cụt","chó con","peugeot","hỏi"],"answer_index":0,"explanation":"pingüinos = chim cánh cụt"},{"question":"Từ 「planeada」 có nghĩa là gì?","options":["kế hoạch","chó con","peugeot","hỏi"],"answer_index":0,"explanation":"planeada = kế hoạch"},{"question":"Từ 「plegaria」 có nghĩa là gì?","options":["cầu nguyện","chó con","peugeot","hỏi"],"answer_index":0,"explanation":"plegaria = cầu nguyện"},{"question":"Từ 「politics」 có nghĩa là gì?","options":["chính trị","chó con","peugeot","hỏi"],"answer_index":0,"explanation":"politics = chính trị"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: chó con","options":["perritos","peugeot","pidio","pincel"],"answer_index":0,"explanation":"per