unciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 453","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"trateを 使います。","line_vi":"Tôi dùng trate.","focus_words":["trate"]},{"speaker":"B","line_target":"turquía は 何ですか。","line_vi":"turquía là cái gì?","focus_words":["turquía"]},{"speaker":"A","line_target":"ubicadaです。","line_vi":"Đó là ubicada.","focus_words":["ubicada"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fcab6359","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「trate」 có nghĩa là gì?","options":["thử","gà tây","nằm","hãy xem nào"],"answer_index":0,"explanation":"trate = thử"},{"question":"Từ 「turquía」 có nghĩa là gì?","options":["gà tây","thử","nằm","hãy xem nào"],"answer_index":0,"explanation":"turquía = gà tây"},{"question":"Từ 「ubicada」 có nghĩa là gì?","options":["nằm","thử","gà tây","hãy xem nào"],"answer_index":0,"explanation":"ubicada = nằm"},{"question":"Từ 「veamos」 có nghĩa là gì?","options":["hãy xem nào","thử","gà tây","nằm"],"answer_index":0,"explanation":"veamos = hãy xem nào"},{"question":"Từ 「vega」 có nghĩa là gì?","options":["Vega","thử","gà tây","nằm"],"answer_index":0,"explanation":"vega = Vega"},{"question":"Từ 「venden」 có nghĩa là gì?","options":["họ bán","thử","gà tây","nằm"],"answer_index":0,"explanation":"venden = họ bán"},{"question":"Từ 「videojuegos」 có nghĩa là gì?","options":["trò chơi điện tử","thử","gà tây","nằm"],"answer_index":0,"explanation":"videojuegos = trò chơi điện tử"},{"question":"Từ 「vidrio」 có nghĩa là gì?","options":["kính","thử","gà tây","nằm"],"answer_inde