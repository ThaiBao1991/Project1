, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 598","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"acercarseを 使います。","line_vi":"Tôi dùng acercarse.","focus_words":["acercarse"]},{"speaker":"B","line_target":"actuando は 何ですか。","line_vi":"actuando là cái gì?","focus_words":["actuando"]},{"speaker":"A","line_target":"andreaです。","line_vi":"Đó là andrea.","focus_words":["andrea"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_682a7075","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「acercarse」 có nghĩa là gì?","options":["đến gần hơn","diễn xuất","Andrea","trang bị vũ khí"],"answer_index":0,"explanation":"acercarse = đến gần hơn"},{"question":"Từ 「actuando」 có nghĩa là gì?","options":["diễn xuất","đến gần hơn","Andrea","trang bị vũ khí"],"answer_index":0,"explanation":"actuando = diễn xuất"},{"question":"Từ 「andrea」 có nghĩa là gì?","options":["Andrea","đến gần hơn","diễn xuất","trang bị vũ khí"],"answer_index":0,"explanation":"andrea = Andrea"},{"question":"Từ 「armando」 có nghĩa là gì?","options":["trang bị vũ khí","đến gần hơn","diễn xuất","Andrea"],"answer_index":0,"explanation":"armando = trang bị vũ khí"},{"question":"Từ 「arroyo」 có nghĩa là gì?","options":["dòng suối","đến gần hơn","diễn xuất","Andrea"],"answer_index":0,"explanation":"arroyo = dòng suối"},{"question":"Từ 「aseguro」 có nghĩa là gì?","options":["Tôi đảm bảo","đến gần hơn","diễn xuất"