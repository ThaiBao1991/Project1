す。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 431","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"lanzarを 使います。","line_vi":"Tôi dùng lanzar.","focus_words":["lanzar"]},{"speaker":"B","line_target":"legislativo は 何ですか。","line_vi":"legislativo là cái gì?","focus_words":["legislativo"]},{"speaker":"A","line_target":"listosです。","line_vi":"Đó là listos.","focus_words":["listos"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e86f950f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「lanzar」 có nghĩa là gì?","options":["ném","lập pháp","sẵn sàng","chết tiệt"],"answer_index":0,"explanation":"lanzar = ném"},{"question":"Từ 「legislativo」 có nghĩa là gì?","options":["lập pháp","ném","sẵn sàng","chết tiệt"],"answer_index":0,"explanation":"legislativo = lập pháp"},{"question":"Từ 「listos」 có nghĩa là gì?","options":["sẵn sàng","ném","lập pháp","chết tiệt"],"answer_index":0,"explanation":"listos = sẵn sàng"},{"question":"Từ 「maldita」 có nghĩa là gì?","options":["chết tiệt","ném","lập pháp","sẵn sàng"],"answer_index":0,"explanation":"maldita = chết tiệt"},{"question":"Từ 「mancha」 có nghĩa là gì?","options":["vết ố","ném","lập pháp","sẵn sàng"],"answer_index":0,"explanation":"mancha = vết ố"},{"question":"Từ 「mauricio」 có nghĩa là gì?","options":["Mô-ri-xơ","ném","lập pháp","sẵn sàng"],"answer_index":0,"explanation":"mauricio = Mô-ri-xơ"},{"question":"Từ 「obliga」 có nghĩa là gì?","options":["bắ