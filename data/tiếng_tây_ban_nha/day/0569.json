습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 569","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"inclusiveを 使います。","line_vi":"Tôi dùng inclusive.","focus_words":["inclusive"]},{"speaker":"B","line_target":"indicado は 何ですか。","line_vi":"indicado là cái gì?","focus_words":["indicado"]},{"speaker":"A","line_target":"iniciadoです。","line_vi":"Đó là iniciado.","focus_words":["iniciado"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2e18d159","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「inclusive」 có nghĩa là gì?","options":["thậm chí","chỉ định","bắt đầu","diễn giải"],"answer_index":0,"explanation":"inclusive = thậm chí"},{"question":"Từ 「indicado」 có nghĩa là gì?","options":["chỉ định","thậm chí","bắt đầu","diễn giải"],"answer_index":0,"explanation":"indicado = chỉ định"},{"question":"Từ 「iniciado」 có nghĩa là gì?","options":["bắt đầu","thậm chí","chỉ định","diễn giải"],"answer_index":0,"explanation":"iniciado = bắt đầu"},{"question":"Từ 「interpretar」 có nghĩa là gì?","options":["diễn giải","thậm chí","chỉ định","bắt đầu"],"answer_index":0,"explanation":"interpretar = diễn giải"},{"question":"Từ 「iría」 có nghĩa là gì?","options":["sẽ đi","thậm chí","chỉ định","bắt đầu"],"answer_index":0,"explanation":"iría = sẽ đi"},{"question":"Từ 「iva」 có nghĩa là gì?","options":["thùng","thậm chí","chỉ định","bắt đầu"],"answer_index":0,"explanation":"iva = thùng"},{"que