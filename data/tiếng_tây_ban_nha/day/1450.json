iz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1450","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"cronistaを 使います。","line_vi":"Tôi dùng cronista.","focus_words":["cronista"]},{"speaker":"B","line_target":"cuarteles は 何ですか。","line_vi":"cuarteles là cái gì?","focus_words":["cuarteles"]},{"speaker":"A","line_target":"cuartetoです。","line_vi":"Đó là cuarteto.","focus_words":["cuarteto"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「cronista」 có nghĩa là gì?","options":["người viết biên niên sử","doanh trại","bộ tứ","đổ lỗi"],"answer_index":0,"explanation":"cronista = người viết biên niên sử"},{"question":"Từ 「cuarteles」 có nghĩa là gì?","options":["doanh trại","người viết biên niên sử","bộ tứ","đổ lỗi"],"answer_index":0,"explanation":"cuarteles = doanh trại"},{"question":"Từ 「cuarteto」 có nghĩa là gì?","options":["bộ tứ","người viết biên niên sử","doanh trại","đổ lỗi"],"answer_index":0,"explanation":"cuarteto = bộ tứ"},{"question":"Từ 「culpas」 có nghĩa là gì?","options":["đổ lỗi","người viết biên niên sử","doanh trại","bộ tứ"],"answer_index":0,"explanation":"culpas = đổ lỗi"},{"question":"Từ 「cumplieron」 có nghĩa là gì?","options":["họ đã hoàn thành","người viết biên niên sử","doanh trại","bộ tứ"],"answer_index":0,"explanation":"cumplieron = họ đã hoàn thành"},{"question":"Từ 「damasco」 có nghĩa là gì?","options":["damacus","người viết biên niên sử","doanh trại","bộ tứ"],"answer_index":0,"explanation":"damasco = damacus"},{"question":"Từ 「danzas」 có nghĩa là gì?","options":["điệu nhảy","người viết biên niên sử","doanh trại","bộ tứ"],"answer_index":0,"explanation":"da