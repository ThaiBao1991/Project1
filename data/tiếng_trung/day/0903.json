à không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 903","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"vanを 使います。","line_vi":"Tôi dùng van.","focus_words":["van"]},{"speaker":"B","line_target":"一届 は 何ですか。","line_vi":"一届 là cái gì?","focus_words":["一届"]},{"speaker":"A","line_target":"三日です。","line_vi":"Đó là 三日.","focus_words":["三日"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ca4cd997","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「van」 có nghĩa là gì?","options":["xe tải","Một học kỳ","ba ngày","không thiếu"],"answer_index":0,"explanation":"van = xe tải"},{"question":"Từ 「一届」 có nghĩa là gì?","options":["Một học kỳ","xe tải","ba ngày","không thiếu"],"answer_index":0,"explanation":"一届 = Một học kỳ"},{"question":"Từ 「三日」 có nghĩa là gì?","options":["ba ngày","xe tải","Một học kỳ","không thiếu"],"answer_index":0,"explanation":"三日 = ba ngày"},{"question":"Từ 「不乏」 có nghĩa là gì?","options":["không thiếu","xe tải","Một học kỳ","ba ngày"],"answer_index":0,"explanation":"不乏 = không thiếu"},{"question":"Từ 「专案」 có nghĩa là gì?","options":["dự án","xe tải","Một học kỳ","ba ngày"],"answer_index":0,"explanation":"专案 = dự án"},{"question":"Từ 「中场」 có nghĩa là gì?","options":["tiền vệ","xe tải","Một học kỳ","ba ngày"],"answer_index":0,"explanation":"中场 = ti