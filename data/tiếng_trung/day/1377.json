ông đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1377","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"外销を 使います。","line_vi":"Tôi dùng 外销.","focus_words":["外销"]},{"speaker":"B","line_target":"大举 は 何ですか。","line_vi":"大举 là cái gì?","focus_words":["大举"]},{"speaker":"A","line_target":"大学毕业です。","line_vi":"Đó là 大学毕业.","focus_words":["大学毕业"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5a69933e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「外销」 có nghĩa là gì?","options":["Doanh thu xuất khẩu","bước đi lớn","tốt nghiệp đại học","Đại Pháp"],"answer_index":0,"explanation":"外销 = Doanh thu xuất khẩu"},{"question":"Từ 「大举」 có nghĩa là gì?","options":["bước đi lớn","Doanh thu xuất khẩu","tốt nghiệp đại học","Đại Pháp"],"answer_index":0,"explanation":"大举 = bước đi lớn"},{"question":"Từ 「大学毕业」 có nghĩa là gì?","options":["tốt nghiệp đại học","Doanh thu xuất khẩu","bước đi lớn","Đại Pháp"],"answer_index":0,"explanation":"大学毕业 = tốt nghiệp đại học"},{"question":"Từ 「大法」 có nghĩa là gì?","options":["Đại Pháp","Doanh thu xuất khẩu","bước đi lớn","tốt nghiệp đại học"],"answer_index":0,"explanation":"大法 = Đại Pháp"},{"question":"Từ 「大都会」 có nghĩa là gì?","options":["đô thị","Doanh thu xuất khẩu","bước đi lớn","tốt nghiệp đại học"],"answer_index":0,"explanation":"大都会 = đô thị"},{"question":"Từ 「失职」 có nghĩa là gì?","options":["sự lơ là nghĩa vụ","Doanh thu xuất khẩu","bước đi lớn","tốt nghiệp đại học"],"answer_index":0,"explanation":"失职 = sự lơ là nghĩa vụ"},{"questio