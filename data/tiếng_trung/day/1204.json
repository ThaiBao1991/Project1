ら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1204","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"新政府を 使います。","line_vi":"Tôi dùng 新政府.","focus_words":["新政府"]},{"speaker":"B","line_target":"新款 は 何ですか。","line_vi":"新款 là cái gì?","focus_words":["新款"]},{"speaker":"A","line_target":"无畏です。","line_vi":"Đó là 无畏.","focus_words":["无畏"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8b6aeb4b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「新政府」 có nghĩa là gì?","options":["chính phủ mới","Phong cách mới","không sợ hãi","bữa tối"],"answer_index":0,"explanation":"新政府 = chính phủ mới"},{"question":"Từ 「新款」 có nghĩa là gì?","options":["Phong cách mới","chính phủ mới","không sợ hãi","bữa tối"],"answer_index":0,"explanation":"新款 = Phong cách mới"},{"question":"Từ 「无畏」 có nghĩa là gì?","options":["không sợ hãi","chính phủ mới","Phong cách mới","bữa tối"],"answer_index":0,"explanation":"无畏 = không sợ hãi"},{"question":"Từ 「晚宴」 có nghĩa là gì?","options":["bữa tối","chính phủ mới","Phong cách mới","không sợ hãi"],"answer_index":0,"explanation":"晚宴 = bữa tối"},{"question":"Từ 「末年」 có nghĩa là gì?","options":["những năm qua","chính phủ mới","Phong cách mới","không sợ hãi"],"answer_index":0,"explanation":"末年 = những năm qua"},{"question":"Từ 「本部」 có nghĩa là gì?","options":["Trụ sở chính","chính phủ mới","Phong cách mới","không sợ hãi"],"answer_index":0,"explanation":"本部 = Trụ sở ch