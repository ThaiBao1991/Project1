","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_582305a5","audio_ref":"m_06eeec15","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ea9c5ed8"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1727","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"波斯湾を 使います。","line_vi":"Tôi dùng 波斯湾.","focus_words":["波斯湾"]},{"speaker":"B","line_target":"洲际 は 何ですか。","line_vi":"洲际 là cái gì?","focus_words":["洲际"]},{"speaker":"A","line_target":"流浪汉です。","line_vi":"Đó là 流浪汉.","focus_words":["流浪汉"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ed5a2499","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「波斯湾」 có nghĩa là gì?","options":["vịnh Ba Tư","Liên lục địa","người đàn ông vô gia cư","tiêu tan"],"answer_index":0,"explanation":"波斯湾 = vịnh Ba Tư"},{"question":"Từ 「洲际」 có nghĩa là gì?","options":["Liên lục địa","vịnh Ba Tư","người đàn ông vô gia cư","tiêu tan"],"answer_index":0,"explanation":"洲际 = Liên lục địa"},{"question":"Từ 「流浪汉」 có nghĩa là gì?","options":["người đàn ông vô gia cư","vịnh Ba Tư","Liên lục địa","tiêu tan"],"answer_index":0,"explanation":"流浪汉 = người đàn ông vô gia cư"},{"question":"Từ 「消散」 có nghĩa là gì?","options":["tiêu tan","vịnh Ba Tư","Liên lục địa","người đàn ông vô gia cư"],"answer_index":0,"explanation":"消散 = tiêu tan"},{"question":"Từ 「消磨」 có nghĩa là gì?","options":["giết","vịnh Ba Tư","Liên lục địa","người đàn ông vô gia cư"],"answer_index":0,"explanation":"消磨 = giết"},{"question":"Từ 「消遣」 có nghĩa là gì?","options":["giải trí","vịnh Ba Tư","Liên lục địa","người đàn ông vô gia cư"],"answ