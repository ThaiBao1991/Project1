ừ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 561","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"自私を 使います。","line_vi":"Tôi dùng 自私.","focus_words":["自私"]},{"speaker":"B","line_target":"艰苦 は 何ですか。","line_vi":"艰苦 là cái gì?","focus_words":["艰苦"]},{"speaker":"A","line_target":"苏格兰です。","line_vi":"Đó là 苏格兰.","focus_words":["苏格兰"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2299fe19","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「自私」 có nghĩa là gì?","options":["ích kỷ","Cứng","Scotland","đôi chân"],"answer_index":0,"explanation":"自私 = ích kỷ"},{"question":"Từ 「艰苦」 có nghĩa là gì?","options":["Cứng","ích kỷ","Scotland","đôi chân"],"answer_index":0,"explanation":"艰苦 = Cứng"},{"question":"Từ 「苏格兰」 có nghĩa là gì?","options":["Scotland","ích kỷ","Cứng","đôi chân"],"answer_index":0,"explanation":"苏格兰 = Scotland"},{"question":"Từ 「英尺」 có nghĩa là gì?","options":["đôi chân","ích kỷ","Cứng","Scotland"],"answer_index":0,"explanation":"英尺 = đôi chân"},{"question":"Từ 「获利」 có nghĩa là gì?","options":["lợi nhuận","ích kỷ","Cứng","Scotland"],"answer_index":0,"explanation":"获利 = lợi nhuận"},{"question":"Từ 「葡萄」 có nghĩa là gì?","options":["nho","ích kỷ","Cứng","Scotland"],"answer_index":0,"explanation":"葡萄 = nho"},{"question":"Từ 「薪水」 có nghĩa là gì?","options":["tiền lương","ích kỷ","Cứng","Scotland"],"answer_index":0,"explanation":"薪水 = tiền lương"},{"question":"Từ 「见识」 có nghĩa là gì?","options":["Kiến thức","ích kỷ","Cứng","Scotland"],"answer_index":0,"explanation":"见识 = Kiến thức"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: ích kỷ","options":["自私","艰苦","苏格兰","英尺"],"answer_index":0,"explanation":"自私 = ích kỷ"},{