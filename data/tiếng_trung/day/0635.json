"example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_0fdb142f","audio_ref":"m_53c90b25","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_98a3078b"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 635","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"拳头を 使います。","line_vi":"Tôi dùng 拳头.","focus_words":["拳头"]},{"speaker":"B","line_target":"接口 は 何ですか。","line_vi":"接口 là cái gì?","focus_words":["接口"]},{"speaker":"A","line_target":"推理です。","line_vi":"Đó là 推理.","focus_words":["推理"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0296cbae","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「拳头」 có nghĩa là gì?","options":["nắm tay","giao diện","lý luận","xem"],"answer_index":0,"explanation":"拳头 = nắm tay"},{"question":"Từ 「接口」 có nghĩa là gì?","options":["giao diện","nắm tay","lý luận","xem"],"answer_index":0,"explanation":"接口 = giao diện"},{"question":"Từ 「推理」 có nghĩa là gì?","options":["lý luận","nắm tay","giao diện","xem"],"answer_index":0,"explanation":"推理 = lý luận"},{"question":"Từ 「收看」 có nghĩa là gì?","options":["xem","nắm tay","giao diện","lý luận"],"answer_index":0,"explanation":"收看 = xem"},{"question":"Từ 「改制」 có nghĩa là gì?","options":["tái cơ cấu","nắm tay","giao diện","lý luận"],"answer_index":0,"explanation":"改制 = tái cơ cấu"},{"question":"Từ 「放入」 có nghĩa là gì?","options":["đưa vào","nắm tay","giao diện","lý luận"],"answer_index":0,"explanation":"放入 = đưa vào"},{"question":"Từ 「放置」 có nghĩa là gì?","options":["địa điểm","nắm tay","giao diện","lý luận"],"answer_index":0,"explanation":"放置 = địa điểm"},{"question":"Từ 「数码」 có nghĩa là gì?","options":["kỹ thuật số","nắm tay","giao diện","lý luận"],"answer_index":0,"explanation":"数码 = kỹ thuật số"}],"pattern":[{"question":"Chọ