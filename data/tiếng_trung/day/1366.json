_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a9a0ebd7","audio_ref":"m_4609d60d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5de620cd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1366","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"送礼を 使います。","line_vi":"Tôi dùng 送礼.","focus_words":["送礼"]},{"speaker":"B","line_target":"逗留 は 何ですか。","line_vi":"逗留 là cái gì?","focus_words":["逗留"]},{"speaker":"A","line_target":"郊外です。","line_vi":"Đó là 郊外.","focus_words":["郊外"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_31fb90fc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「送礼」 có nghĩa là gì?","options":["tặng quà","ở lại","vùng ngoại ô","nước tương"],"answer_index":0,"explanation":"送礼 = tặng quà"},{"question":"Từ 「逗留」 có nghĩa là gì?","options":["ở lại","tặng quà","vùng ngoại ô","nước tương"],"answer_index":0,"explanation":"逗留 = ở lại"},{"question":"Từ 「郊外」 có nghĩa là gì?","options":["vùng ngoại ô","tặng quà","ở lại","nước tương"],"answer_index":0,"explanation":"郊外 = vùng ngoại ô"},{"question":"Từ 「酱油」 có nghĩa là gì?","options":["nước tương","tặng quà","ở lại","vùng ngoại ô"],"answer_index":0,"explanation":"酱油 = nước tương"},{"question":"Từ 「金华」 có nghĩa là gì?","options":["Kim Hoa","tặng quà","ở lại","vùng ngoại ô"],"answer_index":0,"explanation":"金华 = Kim Hoa"},{"question":"Từ 「金融市场」 có nghĩa là gì?","options":["thị trường tài chính","tặng quà","ở lại","vùng ngoại ô"],"answer_index":0,"explanation":"金融市场 = thị trường tài chính"},{"question":"Từ 「银河系」 có nghĩa là gì?","options":["dải ngân hà","tặng quà","ở lại","vùng ngoại ô"],"answer_index":0,"explanation":"银河系 = dải ngân hà"},