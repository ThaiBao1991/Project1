chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1631","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"公馆を 使います。","line_vi":"Tôi dùng 公馆.","focus_words":["公馆"]},{"speaker":"B","line_target":"共通 は 何ですか。","line_vi":"共通 là cái gì?","focus_words":["共通"]},{"speaker":"A","line_target":"再生能源です。","line_vi":"Đó là 再生能源.","focus_words":["再生能源"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e9c04d70","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「公馆」 có nghĩa là gì?","options":["biệt thự","chung","năng lượng tái tạo","viết"],"answer_index":0,"explanation":"公馆 = biệt thự"},{"question":"Từ 「共通」 có nghĩa là gì?","options":["chung","biệt thự","năng lượng tái tạo","viết"],"answer_index":0,"explanation":"共通 = chung"},{"question":"Từ 「再生能源」 có nghĩa là gì?","options":["năng lượng tái tạo","biệt thự","chung","viết"],"answer_index":0,"explanation":"再生能源 = năng lượng tái tạo"},{"question":"Từ 「写入」 có nghĩa là gì?","options":["viết","biệt thự","chung","năng lượng tái tạo"],"answer_index":0,"explanation":"写入 = viết"},{"question":"Từ 「军机」 có nghĩa là gì?","options":["máy bay quân sự","biệt thự","chung","năng lượng tái tạo"],"answer_index":0,"explanation":"军机 = máy bay quân sự"},{"question":"Từ 「冲洗」 có nghĩa là gì?","options":["Rửa sạch","biệt thự","chung","năng lượng tái tạ