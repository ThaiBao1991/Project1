ciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1700","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"爬行を 使います。","line_vi":"Tôi dùng 爬行.","focus_words":["爬行"]},{"speaker":"B","line_target":"牢狱 は 何ですか。","line_vi":"牢狱 là cái gì?","focus_words":["牢狱"]},{"speaker":"A","line_target":"牲口です。","line_vi":"Đó là 牲口.","focus_words":["牲口"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cff7b004","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「爬行」 có nghĩa là gì?","options":["thu thập thông tin","nhà tù","vật nuôi","tình hình hiện tại"],"answer_index":0,"explanation":"爬行 = thu thập thông tin"},{"question":"Từ 「牢狱」 có nghĩa là gì?","options":["nhà tù","thu thập thông tin","vật nuôi","tình hình hiện tại"],"answer_index":0,"explanation":"牢狱 = nhà tù"},{"question":"Từ 「牲口」 có nghĩa là gì?","options":["vật nuôi","thu thập thông tin","nhà tù","tình hình hiện tại"],"answer_index":0,"explanation":"牲口 = vật nuôi"},{"question":"Từ 「现况」 có nghĩa là gì?","options":["tình hình hiện tại","thu thập thông tin","nhà tù","vật nuôi"],"answer_index":0,"explanation":"现况 = tình hình hiện tại"},{"question":"Từ 「班次」 có nghĩa là gì?","options":["sự thay đổi","thu thập thông tin","nhà tù","vật nuôi"],"answer_index":0,"explanation":"班次 = sự thay đổi"},{"question":"Từ 「甘愿」 có nghĩa là gì?","options":["sẵn sàng","thu thập thông tin","nhà tù","vật nuôi"],"answer_index":0,"explanation":"甘愿 = sẵn sàng"},{"question":"Từ 「用钱」 có nghĩa là gì?","options":["sử dụng tiền","thu thập thông tin","nhà tù","vật nuôi"],"answer_index":0,"explanation":"用钱 = sử dụng tiền"},{"question":