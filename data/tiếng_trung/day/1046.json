_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1046","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"舞会を 使います。","line_vi":"Tôi dùng 舞会.","focus_words":["舞会"]},{"speaker":"B","line_target":"苦恼 は 何ですか。","line_vi":"苦恼 là cái gì?","focus_words":["苦恼"]},{"speaker":"A","line_target":"英军です。","line_vi":"Đó là 英军.","focus_words":["英军"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_04126923","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「舞会」 có nghĩa là gì?","options":["bữa tiệc khiêu vũ","đau khổ","quân đội Anh","ăn mặc"],"answer_index":0,"explanation":"舞会 = bữa tiệc khiêu vũ"},{"question":"Từ 「苦恼」 có nghĩa là gì?","options":["đau khổ","bữa tiệc khiêu vũ","quân đội Anh","ăn mặc"],"answer_index":0,"explanation":"苦恼 = đau khổ"},{"question":"Từ 「英军」 có nghĩa là gì?","options":["quân đội Anh","bữa tiệc khiêu vũ","đau khổ","ăn mặc"],"answer_index":0,"explanation":"英军 = quân đội Anh"},{"question":"Từ 「装扮」 có nghĩa là gì?","options":["ăn mặc","bữa tiệc khiêu vũ","đau khổ","quân đội Anh"],"answer_index":0,"explanation":"装扮 = ăn mặc"},{"question":"Từ 「装甲车」 có nghĩa là gì?","options":["xe bọc thép","bữa tiệc khiêu vũ","đau khổ","quân đội Anh"],"answer_index":0,"explanation":"装甲车 = xe bọc thép"},{"question":"Từ 「西岸」 có nghĩa là gì?","options":["bờ tây","bữa tiệc khiêu vũ","đau khổ","quân đội Anh"],"answer_index":0,"explanation":"西岸 = bờ tây"},{"question":"Từ 「西方人」 có nghĩa là gì?","options":["người phương Tây","bữa tiệc khiêu vũ","đau khổ","quân đội Anh"],"answer_index":0,"explanatio