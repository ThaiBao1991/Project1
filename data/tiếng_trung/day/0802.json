aning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 802","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"回想を 使います。","line_vi":"Tôi dùng 回想.","focus_words":["回想"]},{"speaker":"B","line_target":"夏日 は 何ですか。","line_vi":"夏日 là cái gì?","focus_words":["夏日"]},{"speaker":"A","line_target":"多方です。","line_vi":"Đó là 多方.","focus_words":["多方"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_267b2480","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「回想」 có nghĩa là gì?","options":["nhớ lại","mùa hè","Nhiều bữa tiệc","đáng kể"],"answer_index":0,"explanation":"回想 = nhớ lại"},{"question":"Từ 「夏日」 có nghĩa là gì?","options":["mùa hè","nhớ lại","Nhiều bữa tiệc","đáng kể"],"answer_index":0,"explanation":"夏日 = mùa hè"},{"question":"Từ 「多方」 có nghĩa là gì?","options":["Nhiều bữa tiệc","nhớ lại","mùa hè","đáng kể"],"answer_index":0,"explanation":"多方 = Nhiều bữa tiệc"},{"question":"Từ 「大幅度」 có nghĩa là gì?","options":["đáng kể","nhớ lại","mùa hè","Nhiều bữa tiệc"],"answer_index":0,"explanation":"大幅度 = đáng kể"},{"question":"Từ 「夸大」 có nghĩa là gì?","options":["phóng đại","nhớ lại","mùa hè","Nhiều bữa tiệc"],"answer_index":0,"explanation":"夸大 = phóng đại"},{"question":"Từ 「奴隶制」 có nghĩa là gì?","options":["chế độ nô lệ","nhớ lại","mùa hè","Nhiều bữa tiệc"],"answer_index":0,"explanation":"奴隶制 = chế độ nô lệ"},{"question":"Từ 「官司」 có nghĩa là gì?","options":["vụ kiện","nhớ lại","mùa hè","Nhiều bữa tiệc"],"answer_index":0,"explanation":"官