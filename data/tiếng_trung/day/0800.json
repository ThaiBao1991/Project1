3b","audio_ref":"m_f94c3cc5","meaning_audio_ref":"m_759e7a10","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 800","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"使者を 使います。","line_vi":"Tôi dùng 使者.","focus_words":["使者"]},{"speaker":"B","line_target":"供水 は 何ですか。","line_vi":"供水 là cái gì?","focus_words":["供水"]},{"speaker":"A","line_target":"偏偏です。","line_vi":"Đó là 偏偏.","focus_words":["偏偏"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3221d08b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「使者」 có nghĩa là gì?","options":["sứ giả","cung cấp nước","Tuy nhiên","Nhận nó"],"answer_index":0,"explanation":"使者 = sứ giả"},{"question":"Từ 「供水」 có nghĩa là gì?","options":["cung cấp nước","sứ giả","Tuy nhiên","Nhận nó"],"answer_index":0,"explanation":"供水 = cung cấp nước"},{"question":"Từ 「偏偏」 có nghĩa là gì?","options":["Tuy nhiên","sứ giả","cung cấp nước","Nhận nó"],"answer_index":0,"explanation":"偏偏 = Tuy nhiên"},{"question":"Từ 「入手」 có nghĩa là gì?","options":["Nhận nó","sứ giả","cung cấp nước","Tuy nhiên"],"answer_index":0,"explanation":"入手 = Nhận nó"},{"question":"Từ 「关押」 có nghĩa là gì?","options":["bỏ tù","sứ giả","cung cấp nước","Tuy nhiên"],"answer_index":0,"explanation":"关押 = bỏ tù"},{"question":"Từ 「准许」 có nghĩa là gì?","options":["cho phép","sứ giả","cung cấp nước","Tuy nhiên"],"answer_index":0,"explanation":"准许 = cho phép"},{"question":"Từ 「击落」 có nghĩa là gì?","options":["bắn hạ","sứ giả","cung cấp nước","Tuy nhiên"],"answer_index":0,"explanation":"击落 = bắn hạ"},{"question":"Từ 「到场」 có nghĩa là gì?","options":["Có mặt","sứ giả","cung cấp nước","Tuy nhiên"],"answer_index":0,"explanation":"到场 = Có mặt"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sứ giả","options":["使者","供水","偏偏","入手"],"answer_index":0,"explanation":"使者 = sứ giả"},{"question":"Chọn từ đúng cho nghĩa: cung cấp nước","options":["供水","使者","偏偏","入手"],"answer_index":0,"explanation":"供水 = cung cấp nước"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"使者":"m_b3c1eeb1","供水":"m_c7b662d6","入手":"m_8d6707b4","关押":"m_db84d5eb","准许":"m_d2d3c006","击落":"m_e7b00eb2","到场":"m_48384492"},"dialogue_audio":{"0":"m_3221d08b"}},"media_map":{"m_8c24f10a":"media/tiếng_trung/d0800/word_00_f5b1f1b0.webp","m_140d0186":"media/tiếng_trung/d0800/word_01_15d1b483.webp","m_7fbfaef3":"media/tiếng_trung/d0800/word_03_af71aa87.webp","m_32bb3a80":"media/tiếng_trung/d0800/word_04_62401f8d.webp","m_7799ae50":"media/tiếng_trung/d0800/word_05_ad540c24.webp","m_8c7898f4":"media/tiếng_trung/d0800/word_06_eca93185.webp","m_84e56229":"media/tiếng_trung/d0800/word_07_24246688.webp","m_b3c1eeb1":"media/tiếng_trung/d0800/audio_vocab_00_5e17e624.mp3","m_c5a2ed75":"media/tiếng_trung/d0800/audio_vocab_00_vi_5e17e624.mp3","m_c7b662d6":"media/tiếng_trung/d0800/audio_vocab_01_872f1023.mp3","m_3642f21b":"media/tiếng_trung/d0800/audio_vocab_01_vi_54717f23.mp3","m_8d6707b4":"media/tiếng_trung/d0800/audio_vocab_03_c948b99d.mp3","m_7bc30001":"media/tiếng_trung/d0800/audio_vocab_03_vi_c948b99d.mp3","m_db84d5eb":"media/tiếng_trung/d0800/audio_vocab_04_ff6e1d5c.mp3","m_f5941b88":"media/tiếng_trung/d0800/audio_vocab_04_vi_791e5e99.mp3","m_d2d3c006":"media/tiếng_trung/d0800/audio_vocab_05_63db201a.mp3","m_b106343f":"media/tiếng_trung/d0800/audio_vocab_05_vi_77bf1368.mp3","m_e7b00eb2":"media/tiếng_trung/d0800/audio_vocab_06_044b58b5.mp3","m_f9d0ba2b":"media/tiếng_trung/d0800/audio_vocab_06_vi_51b4a08a.mp3","m_48384492":"media/tiếng_trung/d0800/audio_vocab_07_024e7af1.mp3","m_eec211cd":"media/tiếng_trung/d0800/audio_vocab_07_vi_024e7af1.mp3","m_3221d08b":"