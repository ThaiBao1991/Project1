unciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2431","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"奥斯汀を 使います。","line_vi":"Tôi dùng 奥斯汀.","focus_words":["奥斯汀"]},{"speaker":"B","line_target":"女尸 は 何ですか。","line_vi":"女尸 là cái gì?","focus_words":["女尸"]},{"speaker":"A","line_target":"如火如荼です。","line_vi":"Đó là 如火如荼.","focus_words":["如火如荼"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_99ceb2bc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「奥斯汀」 có nghĩa là gì?","options":["Austin","xác phụ nữ","trong sự thay đổi hoàn toàn","Williams"],"answer_index":0,"explanation":"奥斯汀 = Austin"},{"question":"Từ 「女尸」 có nghĩa là gì?","options":["xác phụ nữ","Austin","trong sự thay đổi hoàn toàn","Williams"],"answer_index":0,"explanation":"女尸 = xác phụ nữ"},{"question":"Từ 「如火如荼」 có nghĩa là gì?","options":["trong sự thay đổi hoàn toàn","Austin","xác phụ nữ","Williams"],"answer_index":0,"explanation":"如火如荼 = trong sự thay đổi hoàn toàn"},{"question":"Từ 「威廉斯」 có nghĩa là gì?","options":["Williams","Austin","xác phụ nữ","trong sự thay đổi hoàn toàn"],"answer_index":0,"explanation":"威廉斯 = Williams"},{"question":"Từ 「字迹」 có nghĩa là gì?","options":["chữ viết tay","Austin","xác phụ nữ","trong sự thay đổi hoàn toàn"],"answer_index":0,"explanation":"字迹 = chữ viết tay"},{"question":"Từ 「守候」 có nghĩa là gì?","options":["chờ đợi","Austin","xác phụ nữ","trong sự thay đổi hoàn toàn"],"answer_index":0,"explanation":"守候 = chờ đợi"},{"question":"Từ 「守恒」 có nghĩa là gì?","options":["bảo tồn","Austin","xác phụ nữ","