":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_07adabfe","audio_ref":"m_1e29499f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_305f97b0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 992","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"电网を 使います。","line_vi":"Tôi dùng 电网.","focus_words":["电网"]},{"speaker":"B","line_target":"登入 は 何ですか。","line_vi":"登入 là cái gì?","focus_words":["登入"]},{"speaker":"A","line_target":"真假です。","line_vi":"Đó là 真假.","focus_words":["真假"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f772b717","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「电网」 có nghĩa là gì?","options":["lưới điện","Đăng nhập","đúng hay sai","bốc cháy"],"answer_index":0,"explanation":"电网 = lưới điện"},{"question":"Từ 「登入」 có nghĩa là gì?","options":["Đăng nhập","lưới điện","đúng hay sai","bốc cháy"],"answer_index":0,"explanation":"登入 = Đăng nhập"},{"question":"Từ 「真假」 có nghĩa là gì?","options":["đúng hay sai","lưới điện","Đăng nhập","bốc cháy"],"answer_index":0,"explanation":"真假 = đúng hay sai"},{"question":"Từ 「着火」 có nghĩa là gì?","options":["bốc cháy","lưới điện","Đăng nhập","đúng hay sai"],"answer_index":0,"explanation":"着火 = bốc cháy"},{"question":"Từ 「知觉」 có nghĩa là gì?","options":["nhận thức","lưới điện","Đăng nhập","đúng hay sai"],"answer_index":0,"explanation":"知觉 = nhận thức"},{"question":"Từ 「福田」 có nghĩa là gì?","options":["phúc điền","lưới điện","Đăng nhập","đúng hay sai"],"answer_index":0,"explanation":"福田 = phúc điền"},{"question":"Từ 「科学研究」 có nghĩa là gì?","options":["nghi