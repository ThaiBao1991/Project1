ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"image_ref":"m_ec1b1f4a","audio_ref":"m_7850001b","meaning_audio_ref":"m_e764a854","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 846","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"多处を 使います。","line_vi":"Tôi dùng 多处.","focus_words":["多处"]},{"speaker":"B","line_target":"大肆 は 何ですか。","line_vi":"大肆 là cái gì?","focus_words":["大肆"]},{"speaker":"A","line_target":"天涯です。","line_vi":"Đó là 天涯.","focus_words":["天涯"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e779c2a5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「多处」 có nghĩa là gì?","options":["Nhiều nơi","bừa bãi","Thiên Nhai","ấn tượng tốt"],"answer_index":0,"explanation":"多处 = Nhiều nơi"},{"question":"Từ 「大肆」 có nghĩa là gì?","options":["bừa bãi","Nhiều nơi","Thiên Nhai","ấn tượng tốt"],"answer_index":0,"explanation":"大肆 = bừa bãi"},{"question":"Từ 「天涯」 có nghĩa là gì?","options":["Thiên Nhai","Nhiều nơi","bừa bãi","ấn tượng tốt"],"answer_index":0,"explanation":"天涯 = Thiên Nhai"},{"question":"Từ 「好感」 có nghĩa là gì?","options":["ấn tượng tốt","Nhiều nơi","bừa bãi","Thiên Nhai"],"answer_index":0,"explanation":"好感 = ấn tượng tốt"},{"question":"Từ 「嫌疑」 có nghĩa là gì?","options":["nghi ngờ","Nhiều nơi","bừa bãi","Thiên Nhai"],"answer_index":0,"explanation":"嫌疑 = nghi ngờ"},{"question":"Từ 「宣传部」 có nghĩa là gì?","options":["Ban Tuyên giáo","Nhiều nơi","bừa bãi","Thiên Nhai"],"answer_index":0,"explanation":"宣传部 = Ban Tuyên giáo"},{"ques