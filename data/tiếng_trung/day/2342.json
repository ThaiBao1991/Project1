_vi":"Ngày mai tôi sẽ ghé quý vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2342","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"空投を 使います。","line_vi":"Tôi dùng 空投.","focus_words":["空投"]},{"speaker":"B","line_target":"笔直 は 何ですか。","line_vi":"笔直 là cái gì?","focus_words":["笔直"]},{"speaker":"A","line_target":"笔触です。","line_vi":"Đó là 笔触.","focus_words":["笔触"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b4e0d16e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「空投」 có nghĩa là gì?","options":["airdrop","thẳng","nét cọ","thứ năm"],"answer_index":0,"explanation":"空投 = airdrop"},{"question":"Từ 「笔直」 có nghĩa là gì?","options":["thẳng","airdrop","nét cọ","thứ năm"],"answer_index":0,"explanation":"笔直 = thẳng"},{"question":"Từ 「笔触」 có nghĩa là gì?","options":["nét cọ","airdrop","thẳng","thứ năm"],"answer_index":0,"explanation":"笔触 = nét cọ"},{"question":"Từ 「第五个」 có nghĩa là gì?","options":["thứ năm","airdrop","thẳng","nét cọ"],"answer_index":0,"explanation":"第五个 = thứ năm"},{"question":"Từ 「第十五」 có nghĩa là gì?","options":["thứ mười lăm","airdrop","thẳng","nét cọ"],"answer_index":0,"explanation":"第十五 = thứ mười lăm"},{"question":"Từ 「算不算」 có nghĩa là gì?","options":["Nó có được tính không?","airdrop","thẳng","nét cọ"],"answer_index":0,"explanation":"算不算 = Nó có được tính không?"},{"question":"Từ 「纺织业」 có nghĩa là gì?","options":["Ngành dệt may","airdrop","thẳng","nét cọ"],"answer_index":0,"explanation":"纺织业 