:"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b786f1a5","audio_ref":"m_bf05e309","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_45da25eb"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1101","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"支持率を 使います。","line_vi":"Tôi dùng 支持率.","focus_words":["支持率"]},{"speaker":"B","line_target":"改版 は 何ですか。","line_vi":"改版 là cái gì?","focus_words":["改版"]},{"speaker":"A","line_target":"政治学です。","line_vi":"Đó là 政治学.","focus_words":["政治学"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f865856e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「支持率」 có nghĩa là gì?","options":["tỷ lệ hỗ trợ","Sửa đổi","khoa học chính trị","Bộ Chính trị"],"answer_index":0,"explanation":"支持率 = tỷ lệ hỗ trợ"},{"question":"Từ 「改版」 có nghĩa là gì?","options":["Sửa đổi","tỷ lệ hỗ trợ","khoa học chính trị","Bộ Chính trị"],"answer_index":0,"explanation":"改版 = Sửa đổi"},{"question":"Từ 「政治学」 có nghĩa là gì?","options":["khoa học chính trị","tỷ lệ hỗ trợ","Sửa đổi","Bộ Chính trị"],"answer_index":0,"explanation":"政治学 = khoa học chính trị"},{"question":"Từ 「政治局」 có nghĩa là gì?","options":["Bộ Chính trị","tỷ lệ hỗ trợ","Sửa đổi","khoa học chính trị"],"answer_index":0,"explanation":"政治局 = Bộ Chính trị"},{"question":"Từ 「整改」 có nghĩa là gì?","options":["Chỉnh sửa","tỷ lệ hỗ trợ","Sửa đổi","khoa học chính trị"],"answer_index":0,"explanation":"整改 = Chỉnh sửa"},{"question":"Từ 「斯汀」 có nghĩa là gì?","options":["chích","tỷ lệ hỗ trợ","Sửa đổi","khoa học chính trị"],"answer_index":0,"explanation":"斯汀 = chích"},{"question":"Từ 「新颖」 có