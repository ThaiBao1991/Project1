nciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2471","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"查克を 使います。","line_vi":"Tôi dùng 查克.","focus_words":["查克"]},{"speaker":"B","line_target":"查清 は 何ですか。","line_vi":"查清 là cái gì?","focus_words":["查清"]},{"speaker":"A","line_target":"树丛です。","line_vi":"Đó là 树丛.","focus_words":["树丛"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b7359b81","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「查克」 có nghĩa là gì?","options":["Chuck","Tìm hiểu","khu rừng","hạt dẻ"],"answer_index":0,"explanation":"查克 = Chuck"},{"question":"Từ 「查清」 có nghĩa là gì?","options":["Tìm hiểu","Chuck","khu rừng","hạt dẻ"],"answer_index":0,"explanation":"查清 = Tìm hiểu"},{"question":"Từ 「树丛」 có nghĩa là gì?","options":["khu rừng","Chuck","Tìm hiểu","hạt dẻ"],"answer_index":0,"explanation":"树丛 = khu rừng"},{"question":"Từ 「栗子」 có nghĩa là gì?","options":["hạt dẻ","Chuck","Tìm hiểu","khu rừng"],"answer_index":0,"explanation":"栗子 = hạt dẻ"},{"question":"Từ 「校门」 có nghĩa là gì?","options":["cổng trường","Chuck","Tìm hiểu","khu rừng"],"answer_index":0,"explanation":"校门 = cổng trường"},{"question":"Từ 「样样」 có nghĩa là gì?","options":["Mọi thứ","Chuck","Tìm hiểu","khu rừng"],"answer_index":0,"explanation":"样样 = Mọi thứ"},{"question":"Từ 「栽赃」 có nghĩa là gì?","options":["khung","Chuck","Tìm hiểu","khu rừng"],"answer_index":0,"explanation":"栽赃 = khung"},{"question":"Từ 「次之」 có nghĩa là gì?","options":["Tiếp theo","Chuck","Tìm hiểu","khu rừng"],"answer_index":0,"explanation":"次之 = Tiếp theo"}],"pattern":[{"question":"Chọn t