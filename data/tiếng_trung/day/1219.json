くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1219","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"外星を 使います。","line_vi":"Tôi dùng 外星.","focus_words":["外星"]},{"speaker":"B","line_target":"多长 は 何ですか。","line_vi":"多长 là cái gì?","focus_words":["多长"]},{"speaker":"A","line_target":"大面积です。","line_vi":"Đó là 大面积.","focus_words":["大面积"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e4f3e069","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「外星」 có nghĩa là gì?","options":["người ngoài hành tinh","bao lâu","diện tích lớn","mỏ neo nữ"],"answer_index":0,"explanation":"外星 = người ngoài hành tinh"},{"question":"Từ 「多长」 có nghĩa là gì?","options":["bao lâu","người ngoài hành tinh","diện tích lớn","mỏ neo nữ"],"answer_index":0,"explanation":"多长 = bao lâu"},{"question":"Từ 「大面积」 có nghĩa là gì?","options":["diện tích lớn","người ngoài hành tinh","bao lâu","mỏ neo nữ"],"answer_index":0,"explanation":"大面积 = diện tích lớn"},{"question":"Từ 「女主播」 có nghĩa là gì?","options":["mỏ neo nữ","người ngoài hành tinh","bao lâu","diện tích lớn"],"answer_index":0,"explanation":"女主播 = mỏ neo nữ"},{"question":"Từ 「如期」 có nghĩa là gì?","options":["Theo lịch trình","người ngoài hành tinh","bao lâu","diện tích lớn"],"answer_index":0,"explanation":"如期 = Theo lịch trình"},{"question":"Từ 「孕育」 có nghĩa là gì?","options":["sinh con","người ngoài hành tinh","bao lâu","diện tích lớn"],"answer_