 từ đúng cho nghĩa: doping","options":["掺杂","提纲","撤除","操练"],"answer_index":0,"explanation":"掺杂 = doping"},{"question":"Chọn từ đúng cho nghĩa: phác thảo","options":["提纲","掺杂","撤除","操练"],"answer_index":0,"explanation":"提纲 = phác thảo"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"掺杂":"m_9176307f","撤除":"m_c25cc58d","操练":"m_4870c81e","整肃":"m_89a468a5","斟酌":"m_9e105aa1","旅游区":"m_1fce4d78","无一例外":"m_eecde10f","无可奈何":"m_ff04ec93","无水":"m_b7317ffa"},"dialogue_audio":{"0":"m_ef5939e1"}},"media_map":{"m_40f7c6d0":"media/tiếng_trung/d2436/word_00_68067b9d.webp","m_bbecdd30":"media/tiếng_trung/d2436/word_02_41026e1d.webp","m_cc509b42":"media/tiếng_trung/d2436/word_03_df1bb488.webp","m_18c2e512":"media/tiếng_trung/d2436/word_04_a43520af.webp","m_f013c1ac":"media/tiếng_trung/d2436/word_05_c382ddf5.webp","m_09e8dec7":"media/tiếng_trung/d2436/word_06_708e20c4.webp","m_d34e9a56":"media/tiếng_trung/d2436/word_07_4e433719.webp","m_3fb78d0d":"media/tiếng_trung/d2436/word_08_eecd7612.webp","m_22401abf":"media/tiếng_trung/d2436/word_09_67a87ff7.webp","m_9176307f":"media/tiếng_trung/d2436/audio_vocab_00_2dbec1ee.mp3","m_e06084be":"media/tiếng_trung/d2436/audio_vocab_00_vi_e9e6d609.mp3","m_c25cc58d":"media/tiếng_trung/d2436/audio_vocab_02_d538a265.mp3","m_cff85478":"media/tiếng_trung/d2436/audio_vocab_02_vi_306dc262.mp3","m_4870c81e":"media/tiếng_trung/d2436/audio_vocab_03_7e0d7bbe.mp3","m_17420f92":"media/tiếng_trung/d2436/audio_vocab_03_vi_aa310bc6.mp3","m_89a468a5":"media/tiếng_trung/d2436/audio_vocab_04_0fa0a4d9.mp3","m_792c575e":"media/tiếng_trung/d2436/audio_vocab_04_vi_42c404fd.mp3","m_9e105aa1":"media/tiếng_trung/d2436/audio_vocab_05_17a2c4dd.mp3","m_2224d9aa":"media/tiếng_trung/d2436/audio_vocab_05_vi_17a2c4dd.mp3","m_1fce4d78":"media/tiếng_trung/d2436/audio_vocab_06_401e28e9.mp3","m_8e8f9658":"media/tiếng_trung/d2436/audio_vocab_06_vi_401e28e9.mp3","m_eecde10f":"media/tiếng_trung/d2436/audio_vocab_07_73687cf3.mp3","m_6fc2f23c":"media/tiếng_tr