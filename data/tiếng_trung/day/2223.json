an đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2223","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"后于を 使います。","line_vi":"Tôi dùng 后于.","focus_words":["后于"]},{"speaker":"B","line_target":"品行 は 何ですか。","line_vi":"品行 là cái gì?","focus_words":["品行"]},{"speaker":"A","line_target":"哈迪です。","line_vi":"Đó là 哈迪.","focus_words":["哈迪"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_614bce7d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「后于」 có nghĩa là gì?","options":["Sau","nhân vật","Hardy","Hamas"],"answer_index":0,"explanation":"后于 = Sau"},{"question":"Từ 「品行」 có nghĩa là gì?","options":["nhân vật","Sau","Hardy","Hamas"],"answer_index":0,"explanation":"品行 = nhân vật"},{"question":"Từ 「哈迪」 có nghĩa là gì?","options":["Hardy","Sau","nhân vật","Hamas"],"answer_index":0,"explanation":"哈迪 = Hardy"},{"question":"Từ 「哈马斯」 có nghĩa là gì?","options":["Hamas","Sau","nhân vật","Hardy"],"answer_index":0,"explanation":"哈马斯 = Hamas"},{"question":"Từ 「哪里找」 có nghĩa là gì?","options":["tìm ở đâu","Sau","nhân vật","Hardy"],"answer_index":0,"explanation":"哪里找 = tìm ở đâu"},{"question":"Từ 「哭喊」 có nghĩa là gì?","options":["khóc","Sau","nhân vật","Hardy"],"answer_index":0,"explanation":"哭喊 = khóc"},{"question":"Từ 「哲理」 có nghĩa là gì?","options":["triết học","Sau","nhân vật","Hardy"],"answer_index":0,"explanation":"哲理 = triết học"},{"question":"Từ 「喝完」 có nghĩa là gì?","options":["Uống xong","Sau","nhân vật","Hardy"],"answer_index":0,"explanation":"喝完 = Uống xong"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Sau","options":