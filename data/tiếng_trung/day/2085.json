nce":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6bd38f47","audio_ref":"m_013ad7b3","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_3330dcad"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2085","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"战功を 使います。","line_vi":"Tôi dùng 战功.","focus_words":["战功"]},{"speaker":"B","line_target":"手感 は 何ですか。","line_vi":"手感 là cái gì?","focus_words":["手感"]},{"speaker":"A","line_target":"抵抗力です。","line_vi":"Đó là 抵抗力.","focus_words":["抵抗力"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_27cebea4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「战功」 có nghĩa là gì?","options":["chiến tranh khai thác","cảm nhận","Kháng cự","Lãi và lỗ"],"answer_index":0,"explanation":"战功 = chiến tranh khai thác"},{"question":"Từ 「手感」 có nghĩa là gì?","options":["cảm nhận","chiến tranh khai thác","Kháng cự","Lãi và lỗ"],"answer_index":0,"explanation":"手感 = cảm nhận"},{"question":"Từ 「抵抗力」 có nghĩa là gì?","options":["Kháng cự","chiến tranh khai thác","cảm nhận","Lãi và lỗ"],"answer_index":0,"explanation":"抵抗力 = Kháng cự"},{"question":"Từ 「损益」 có nghĩa là gì?","options":["Lãi và lỗ","chiến tranh khai thác","cảm nhận","Kháng cự"],"answer_index":0,"explanation":"损益 = Lãi và lỗ"},{"question":"Từ 「提督」 có nghĩa là gì?","options":["đô đốc","chiến tranh khai thác","cảm nhận","Kháng cự"],"answer_index":0,"explanation":"提督 = đô đốc"},{"question":"Từ 「摘录」 có nghĩa là gì?","options":["đoạn trích","chiến tranh khai thác","cảm nhận","Kháng cự"],"answer_index":0,"explanation":"摘录 = đoạn trích"},{"question":"Từ 「改选」 có nghĩa là gì?","o