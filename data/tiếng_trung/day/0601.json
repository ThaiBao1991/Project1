e_ref":"m_226197ef","audio_ref":"m_cceea4e4","meaning_audio_ref":"m_4dd3b044","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 601","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"探测を 使います。","line_vi":"Tôi dùng 探测.","focus_words":["探测"]},{"speaker":"B","line_target":"推送 は 何ですか。","line_vi":"推送 là cái gì?","focus_words":["推送"]},{"speaker":"A","line_target":"搜寻です。","line_vi":"Đó là 搜寻.","focus_words":["搜寻"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fbebc8c3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「探测」 có nghĩa là gì?","options":["phát hiện","Đẩy","Tìm kiếm","buông ra"],"answer_index":0,"explanation":"探测 = phát hiện"},{"question":"Từ 「推送」 có nghĩa là gì?","options":["Đẩy","phát hiện","Tìm kiếm","buông ra"],"answer_index":0,"explanation":"推送 = Đẩy"},{"question":"Từ 「搜寻」 có nghĩa là gì?","options":["Tìm kiếm","phát hiện","Đẩy","buông ra"],"answer_index":0,"explanation":"搜寻 = Tìm kiếm"},{"question":"Từ 「放过」 có nghĩa là gì?","options":["buông ra","phát hiện","Đẩy","Tìm kiếm"],"answer_index":0,"explanation":"放过 = buông ra"},{"question":"Từ 「散发」 có nghĩa là gì?","options":["phân phối","phát hiện","Đẩy","Tìm kiếm"],"answer_index":0,"explanation":"散发 = phân phối"},{"question":"Từ 「整整」 có nghĩa là gì?","options":["toàn bộ","phát hiện","Đẩy","Tìm kiếm"],"answer_index":0,"explanation":"整整 = toàn bộ"},{"question":"Từ 「新一代」 có nghĩa là gì?","options":["thế hệ mới","phát hiện","Đẩy","Tìm kiếm"],"answer_index":0,"explanation":"新一代 = thế hệ mới"},{"question":"Từ 「新任」 có nghĩa là gì?","options":["cuộc hẹn mới","phát hiện","Đẩy","Tìm kiếm"],"answer_index":0,"explanation":"新任 = cuộc hẹn mới"}],"pattern":[{"question":"Chọn từ đ