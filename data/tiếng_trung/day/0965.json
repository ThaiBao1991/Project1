_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 965","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"领主を 使います。","line_vi":"Tôi dùng 领主.","focus_words":["领主"]},{"speaker":"B","line_target":"黑洞 は 何ですか。","line_vi":"黑洞 là cái gì?","focus_words":["黑洞"]},{"speaker":"A","line_target":"callです。","line_vi":"Đó là call.","focus_words":["call"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5c1aa475","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「领主」 có nghĩa là gì?","options":["chúa tể","lỗ đen","gọi","chết"],"answer_index":0,"explanation":"领主 = chúa tể"},{"question":"Từ 「黑洞」 có nghĩa là gì?","options":["lỗ đen","chúa tể","gọi","chết"],"answer_index":0,"explanation":"黑洞 = lỗ đen"},{"question":"Từ 「call」 có nghĩa là gì?","options":["gọi","chúa tể","lỗ đen","chết"],"answer_index":0,"explanation":"call = gọi"},{"question":"Từ 「die」 có nghĩa là gì?","options":["chết","chúa tể","lỗ đen","gọi"],"answer_index":0,"explanation":"die = chết"},{"question":"Từ 「iii」 có nghĩa là gì?","options":["iii","chúa tể","lỗ đen","gọi"],"answer_index":0,"explanation":"iii = iii"},{"question":"Từ 「men」 có nghĩa là gì?","options":["đàn ông","chúa tể","lỗ đen","gọi"],"answer_index":0,"explanation":"men = đàn ông"},{"question":"Từ 「office」 có nghĩa là gì?","options":["văn phòng","chúa tể","lỗ đen","gọi"],"answer_index":0,"explanation":"office = văn phòng"},{"question":"Từ 「radio」 có nghĩa là gì?","options":["đài phát thanh","chúa tể","lỗ đen","gọi"],"answer_index":0,"explanation":"radio = đài phát