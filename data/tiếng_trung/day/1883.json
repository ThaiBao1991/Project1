"example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_9ea0775d","audio_ref":"m_35d5c3a6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_fdb71810"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Đại từ 私 (watashi)","level":"N5","explanation":"Từ chỉ tự ngôn: 私 / 僕・俺 (nam) / 私たち.","examples":[{"sentence":"私は田中です。","meaning_vi":"Tôi là Tanaka."}],"pronunciation_focus":"私 = watashi.","common_mistakes":"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1883","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"主公を 使います。","line_vi":"Tôi dùng 主公.","focus_words":["主公"]},{"speaker":"B","line_target":"主委 は 何ですか。","line_vi":"主委 là cái gì?","focus_words":["主委"]},{"speaker":"A","line_target":"之作です。","line_vi":"Đó là 之作.","focus_words":["之作"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4e96873b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「主公」 có nghĩa là gì?","options":["chúa tể","chủ tịch","làm việc","cái chết"],"answer_index":0,"explanation":"主公 = chúa tể"},{"question":"Từ 「主委」 có nghĩa là gì?","options":["chủ tịch","chúa tể","làm việc","cái chết"],"answer_index":0,"explanation":"主委 = chủ tịch"},{"question":"Từ 「之作」 có nghĩa là gì?","options":["làm việc","chúa tể","chủ tịch","cái chết"],"answer_index":0,"explanation":"之作 = làm việc"},{"question":"Từ 「之死」 có nghĩa là gì?","options":["cái chết","chúa tể","chủ tịch","làm việc"],"answer_index":0,"explanation":"之死 = cái chết"},{"question":"Từ 「习惯于」 có nghĩa là gì?","options":["quen với","chúa tể","chủ tịch","làm việc"],"answer_index":0,"explanation":"习惯于 = quen với"},{"question":"Từ 「乱说」 có nghĩa là gì?","options":["Nói chuyện vớ vẩn","chúa tể","chủ tịch","làm việc"],"answer_index":0,"explanation":"乱说 = Nói chuyện vớ vẩn"},{"question":"Từ 「二二八」 có nghĩa là gì?","options":["Hai hai mươi tám","chúa tể","chủ tịch","làm việc"],"answer_index":0,"explanation":"二二八 = Hai hai mươi tám"},{"question":"Từ 「互惠」 có nghĩa là gì?","options":["sự có đi có lại","chúa tể","chủ tịch","làm việc"],"answer_inde