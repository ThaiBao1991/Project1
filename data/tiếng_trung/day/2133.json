ợc gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2133","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"货真价实を 使います。","line_vi":"Tôi dùng 货真价实.","focus_words":["货真价实"]},{"speaker":"B","line_target":"货色 は 何ですか。","line_vi":"货色 là cái gì?","focus_words":["货色"]},{"speaker":"A","line_target":"贱民です。","line_vi":"Đó là 贱民.","focus_words":["贱民"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d7b68c15","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「货真价实」 có nghĩa là gì?","options":["chính hãng","Hàng hóa","không thể chạm tới","bám vào"],"answer_index":0,"explanation":"货真价实 = chính hãng"},{"question":"Từ 「货色」 có nghĩa là gì?","options":["Hàng hóa","chính hãng","không thể chạm tới","bám vào"],"answer_index":0,"explanation":"货色 = Hàng hóa"},{"question":"Từ 「贱民」 có nghĩa là gì?","options":["không thể chạm tới","chính hãng","Hàng hóa","bám vào"],"answer_index":0,"explanation":"贱民 = không thể chạm tới"},{"question":"Từ 「贴着」 có nghĩa là gì?","options":["bám vào","chính hãng","Hàng hóa","không thể chạm tới"],"answer_index":0,"explanation":"贴着 = bám vào"},{"question":"Từ 「赎回」 có nghĩa là gì?","options":["chuộc lại","chính hãng","Hàng hóa","không thể chạm tới"],"answer_index":0,"explanation":"赎回 = chuộc lại"},{"question":"Từ 「赶赴」 có nghĩa là gì?","options":["vội vàng đến","chính hãng","Hàng hóa","không thể chạm tới"],"answer_index":0,