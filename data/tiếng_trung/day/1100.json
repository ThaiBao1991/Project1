 câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1100","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"打赢を 使います。","line_vi":"Tôi dùng 打赢.","focus_words":["打赢"]},{"speaker":"B","line_target":"执行官 は 何ですか。","line_vi":"执行官 là cái gì?","focus_words":["执行官"]},{"speaker":"A","line_target":"抑郁です。","line_vi":"Đó là 抑郁.","focus_words":["抑郁"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_46811e17","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「打赢」 có nghĩa là gì?","options":["thắng","nhân viên điều hành","trầm cảm","ném"],"answer_index":0,"explanation":"打赢 = thắng"},{"question":"Từ 「执行官」 có nghĩa là gì?","options":["nhân viên điều hành","thắng","trầm cảm","ném"],"answer_index":0,"explanation":"执行官 = nhân viên điều hành"},{"question":"Từ 「抑郁」 có nghĩa là gì?","options":["trầm cảm","thắng","nhân viên điều hành","ném"],"answer_index":0,"explanation":"抑郁 = trầm cảm"},{"question":"Từ 「投掷」 có nghĩa là gì?","options":["ném","thắng","nhân viên điều hành","trầm cảm"],"answer_index":0,"explanation":"投掷 = ném"},{"question":"Từ 「抚摸」 có nghĩa là gì?","options":["vuốt ve","thắng","nhân viên điều hành","trầm cảm"],"answer_index":0,"explanation":"抚摸 = vuốt ve"},{"question":"Từ 「抢夺」 có nghĩa là gì?","options":["chộp lấy","thắng","nhân viên điều hành","trầm cảm"],"answer_index":0,"explanation":"抢夺 = chộp lấy"},{"question":"Từ 「拖拉机」 có nghĩa là gì?","options":["m