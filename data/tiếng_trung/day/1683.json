ơng lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1683","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"useを 使います。","line_vi":"Tôi dùng use.","focus_words":["use"]},{"speaker":"B","line_target":"used は 何ですか。","line_vi":"used là cái gì?","focus_words":["used"]},{"speaker":"A","line_target":"veです。","line_vi":"Đó là ve.","focus_words":["ve"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1ed8ec3f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「use」 có nghĩa là gì?","options":["sử dụng","đã sử dụng","đã","ước gì"],"answer_index":0,"explanation":"use = sử dụng"},{"question":"Từ 「used」 có nghĩa là gì?","options":["đã sử dụng","sử dụng","đã","ước gì"],"answer_index":0,"explanation":"used = đã sử dụng"},{"question":"Từ 「ve」 có nghĩa là gì?","options":["đã","sử dụng","đã sử dụng","ước gì"],"answer_index":0,"explanation":"ve = đã"},{"question":"Từ 「wish」 có nghĩa là gì?","options":["ước gì","sử dụng","đã sử dụng","đã"],"answer_index":0,"explanation":"wish = ước gì"},{"question":"Từ 「一列」 có nghĩa là gì?","options":["một cột","sử dụng","đã sử dụng","đã"],"answer_index":0,"explanation":"一列 = một cột"},{"question":"Từ 「一局」 có nghĩa là gì?","options":["một trò chơi","sử dụng","đã sử dụng","đã"],"answer_index":0,"explanation":"一局 = một trò chơi"},{"question":"Từ 「一经」 có nghĩa là gì?","options":["một lần","sử dụng","đã sử dụng","đã"],"answer_index":0,"explanation":"一经 = 