yllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b57a211c","audio_ref":"m_90c44b68","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_a59491d1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 637","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"河南省を 使います。","line_vi":"Tôi dùng 河南省.","focus_words":["河南省"]},{"speaker":"B","line_target":"消极 は 何ですか。","line_vi":"消极 là cái gì?","focus_words":["消极"]},{"speaker":"A","line_target":"游击队です。","line_vi":"Đó là 游击队.","focus_words":["游击队"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1cfefea8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「河南省」 có nghĩa là gì?","options":["Tỉnh Hà Nam","tiêu cực","du kích","Tỉnh Hồ Nam"],"answer_index":0,"explanation":"河南省 = Tỉnh Hà Nam"},{"question":"Từ 「消极」 có nghĩa là gì?","options":["tiêu cực","Tỉnh Hà Nam","du kích","Tỉnh Hồ Nam"],"answer_index":0,"explanation":"消极 = tiêu cực"},{"question":"Từ 「游击队」 có nghĩa là gì?","options":["du kích","Tỉnh Hà Nam","tiêu cực","Tỉnh Hồ Nam"],"answer_index":0,"explanation":"游击队 = du kích"},{"question":"Từ 「湖南省」 có nghĩa là gì?","options":["Tỉnh Hồ Nam","Tỉnh Hà Nam","tiêu cực","du kích"],"answer_index":0,"explanation":"湖南省 = Tỉnh Hồ Nam"},{"question":"Từ 「演化」 có nghĩa là gì?","options":["sự tiến hóa","Tỉnh Hà Nam","tiêu cực","du kích"],"answer_index":0,"explanation":"演化 = sự tiến hóa"},{"question":"Từ 「猎人」 có nghĩa là gì?","options":["thợ săn","Tỉnh Hà Nam","tiêu cực","du kích"],"answer_index":0,"explanation":"猎人 = thợ săn"},{"question":"Từ 「猛烈」 có nghĩa là gì?","options":["bạo lực","Tỉnh Hà Nam","tiêu cực","du kích"],"answer_index":0,"explanation":"猛烈 = bạo lực"},{"question":"Từ 「玛丽亚」 có nghĩa là gì?","options":["Maria","Tỉnh Hà Nam","tiêu cực","du kích"],"answer