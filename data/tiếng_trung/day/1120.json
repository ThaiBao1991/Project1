":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1120","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"怀里を 使います。","line_vi":"Tôi dùng 怀里.","focus_words":["怀里"]},{"speaker":"B","line_target":"怜悯 は 何ですか。","line_vi":"怜悯 là cái gì?","focus_words":["怜悯"]},{"speaker":"A","line_target":"恶行です。","line_vi":"Đó là 恶行.","focus_words":["恶行"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_85f3bf37","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「怀里」 có nghĩa là gì?","options":["cánh tay","lòng thương xót","việc ác","Thú vị"],"answer_index":0,"explanation":"怀里 = cánh tay"},{"question":"Từ 「怜悯」 có nghĩa là gì?","options":["lòng thương xót","cánh tay","việc ác","Thú vị"],"answer_index":0,"explanation":"怜悯 = lòng thương xót"},{"question":"Từ 「恶行」 có nghĩa là gì?","options":["việc ác","cánh tay","lòng thương xót","Thú vị"],"answer_index":0,"explanation":"恶行 = việc ác"},{"question":"Từ 「情趣」 có nghĩa là gì?","options":["Thú vị","cánh tay","lòng thương xót","việc ác"],"answer_index":0,"explanation":"情趣 = Thú vị"},{"question":"Từ 「感性」 có nghĩa là gì?","options":["tình cảm","cánh tay","lòng thương xót","việc ác"],"answer_index":0,"explanation":"感性 = tình cảm"},{"question":"Từ 「戏剧性」 có nghĩa là gì?","options":["kịch tính","cánh tay","lòng thương xót","việc ác"],"answer_index":0,"explanation":"戏剧性 = kịch tính"},{"question":"Từ 「成型」 có nghĩa là gì?","options":["hình thành","cánh tay","lòng thương xót","việc ác"],"answer_index":0,"explanation":"成型 = hình thành"},{