":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2470","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"旧称を 使います。","line_vi":"Tôi dùng 旧称.","focus_words":["旧称"]},{"speaker":"B","line_target":"普里 は 何ですか。","line_vi":"普里 là cái gì?","focus_words":["普里"]},{"speaker":"A","line_target":"本区です。","line_vi":"Đó là 本区.","focus_words":["本区"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_08183789","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「旧称」 có nghĩa là gì?","options":["tên cũ","Puri","Khu vực này","Khử trùng"],"answer_index":0,"explanation":"旧称 = tên cũ"},{"question":"Từ 「普里」 có nghĩa là gì?","options":["Puri","tên cũ","Khu vực này","Khử trùng"],"answer_index":0,"explanation":"普里 = Puri"},{"question":"Từ 「本区」 có nghĩa là gì?","options":["Khu vực này","tên cũ","Puri","Khử trùng"],"answer_index":0,"explanation":"本区 = Khu vực này"},{"question":"Từ 「杀菌」 có nghĩa là gì?","options":["Khử trùng","tên cũ","Puri","Khu vực này"],"answer_index":0,"explanation":"杀菌 = Khử trùng"},{"question":"Từ 「杂文」 có nghĩa là gì?","options":["Tiểu luận","tên cũ","Puri","Khu vực này"],"answer_index":0,"explanation":"杂文 = Tiểu luận"},{"question":"Từ 「李先念」 có nghĩa là gì?","options":["Lý Tiên Niệm","tên cũ","Puri","Khu vực này"],"answer_index":0,"explanation":"李先念 = Lý Tiên Niệm"},{"question":"Từ 「李宇春」 có nghĩa là gì?","options":["Lý Ngọc Xuân","tên cũ","Puri","Khu vực này"],"answer_index":0,"explanation":"李宇春 = Lý Ngọc Xuân"},{"question":"Từ 「村级」 có nghĩa là gì?","options":["cấp làng","tên cũ","Puri","Khu vực này"],"answer_inde