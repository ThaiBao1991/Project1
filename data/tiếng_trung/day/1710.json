netic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a3e924b3","audio_ref":"m_68440595","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_617c5ea7"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1710","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"aliveを 使います。","line_vi":"Tôi dùng alive.","focus_words":["alive"]},{"speaker":"B","line_target":"bc は 何ですか。","line_vi":"bc là cái gì?","focus_words":["bc"]},{"speaker":"A","line_target":"beyondです。","line_vi":"Đó là beyond.","focus_words":["beyond"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7ea82af3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「alive」 có nghĩa là gì?","options":["còn sống","bc","vượt xa","xe hơi"],"answer_index":0,"explanation":"alive = còn sống"},{"question":"Từ 「bc」 có nghĩa là gì?","options":["bc","còn sống","vượt xa","xe hơi"],"answer_index":0,"explanation":"bc = bc"},{"question":"Từ 「beyond」 có nghĩa là gì?","options":["vượt xa","còn sống","bc","xe hơi"],"answer_index":0,"explanation":"beyond = vượt xa"},{"question":"Từ 「car」 có nghĩa là gì?","options":["xe hơi","còn sống","bc","vượt xa"],"answer_index":0,"explanation":"car = xe hơi"},{"question":"Từ 「cbs」 có nghĩa là gì?","options":["cbs","còn sống","bc","vượt xa"],"answer_index":0,"explanation":"cbs = cbs"},{"question":"Từ 「christian」 có nghĩa là gì?","options":["người theo đạo thiên chúa","còn sống","bc","vượt xa"],"answer_index":0,"explanation":"christian = người theo đạo thiên chúa"},{"question":"Từ 「country」 có nghĩa là gì?","options":["đất nước","còn sống","bc","vượt xa"],"answer_index":0,"explanation":"country = đất nước"},{"question":"Từ 「cut」 có nghĩa là gì?","options":["cắt","còn sống","bc","vượt xa"],"answer_index"