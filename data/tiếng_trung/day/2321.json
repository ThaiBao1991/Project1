).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2321","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"丧礼を 使います。","line_vi":"Tôi dùng 丧礼.","focus_words":["丧礼"]},{"speaker":"B","line_target":"丧葬 は 何ですか。","line_vi":"丧葬 là cái gì?","focus_words":["丧葬"]},{"speaker":"A","line_target":"中医药です。","line_vi":"Đó là 中医药.","focus_words":["中医药"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6fe9c1fa","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「丧礼」 có nghĩa là gì?","options":["tang lễ","Y học cổ truyền Trung Quốc","Trung Xương","bản nhạc"],"answer_index":0,"explanation":"丧礼 = tang lễ"},{"question":"Từ 「丧葬」 có nghĩa là gì?","options":["tang lễ","Y học cổ truyền Trung Quốc","Trung Xương","bản nhạc"],"answer_index":0,"explanation":"丧葬 = tang lễ"},{"question":"Từ 「中医药」 có nghĩa là gì?","options":["Y học cổ truyền Trung Quốc","tang lễ","tang lễ","Trung Xương"],"answer_index":0,"explanation":"中医药 = Y học cổ truyền Trung Quốc"},{"question":"Từ 「中常」 có nghĩa là gì?","options":["Trung Xương","tang lễ","tang lễ","Y học cổ truyền Trung Quốc"],"answer_index":0,"explanation":"中常 = Trung Xương"},{"question":"Từ 「乐谱」 có nghĩa là gì?","options":["bản nhạc","tang lễ","tang lễ","Y học cổ truyền Trung Quốc"],"answer_index":0,"explanation":"乐谱 = bản nhạc"},{"question":"Từ 「书记处」 có nghĩa là gì?","options":["Ban thư ký","tang lễ","tang lễ","Y học cổ truyền Trung Quốc"],"answer_index":0,"expl