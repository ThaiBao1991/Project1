iên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 793","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"深层を 使います。","line_vi":"Tôi dùng 深层.","focus_words":["深层"]},{"speaker":"B","line_target":"淹没 は 何ですか。","line_vi":"淹没 là cái gì?","focus_words":["淹没"]},{"speaker":"A","line_target":"烟台です。","line_vi":"Đó là 烟台.","focus_words":["烟台"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8875e27b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「深层」 có nghĩa là gì?","options":["sâu","chết đuối","Yên Đài","cha mẹ"],"answer_index":0,"explanation":"深层 = sâu"},{"question":"Từ 「淹没」 có nghĩa là gì?","options":["chết đuối","sâu","Yên Đài","cha mẹ"],"answer_index":0,"explanation":"淹没 = chết đuối"},{"question":"Từ 「烟台」 có nghĩa là gì?","options":["Yên Đài","sâu","chết đuối","cha mẹ"],"answer_index":0,"explanation":"烟台 = Yên Đài"},{"question":"Từ 「爸妈」 có nghĩa là gì?","options":["cha mẹ","sâu","chết đuối","Yên Đài"],"answer_index":0,"explanation":"爸妈 = cha mẹ"},{"question":"Từ 「物理学家」 có nghĩa là gì?","options":["nhà vật lý","sâu","chết đuối","Yên Đài"],"answer_index":0,"explanation":"物理学家 = nhà vật lý"},{"question":"Từ 「电缆」 có nghĩa là gì?","options":["cáp","sâu","chết đuối","Yên Đài"],"answer_index":0,"explanation":"电缆 = cáp"},{"question":"Từ 「电视机」 có nghĩa là gì?","options":["truyền hình","sâu","chết đuối","Yên Đài"],"answer_index":0,"explanation":"电视机 = truyền hình"},{"question":"Từ 「画作」 có nghĩa là gì?","options":["bức tranh","sâu","chết đuối","Yên Đài"],"answer_index":0,"explanation":"画作 = bức tranh"}],"pattern