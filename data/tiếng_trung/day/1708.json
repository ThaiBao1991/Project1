llables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b5bfdfbb","audio_ref":"m_dd0d404a","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_73a6ab66"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1708","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"问责を 使います。","line_vi":"Tôi dùng 问责.","focus_words":["问责"]},{"speaker":"B","line_target":"防灾 は 何ですか。","line_vi":"防灾 là cái gì?","focus_words":["防灾"]},{"speaker":"A","line_target":"阻塞です。","line_vi":"Đó là 阻塞.","focus_words":["阻塞"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5d67f2c5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「问责」 có nghĩa là gì?","options":["Trách nhiệm","Phòng chống thiên tai","chặn","say sưa"],"answer_index":0,"explanation":"问责 = Trách nhiệm"},{"question":"Từ 「防灾」 có nghĩa là gì?","options":["Phòng chống thiên tai","Trách nhiệm","chặn","say sưa"],"answer_index":0,"explanation":"防灾 = Phòng chống thiên tai"},{"question":"Từ 「阻塞」 có nghĩa là gì?","options":["chặn","Trách nhiệm","Phòng chống thiên tai","say sưa"],"answer_index":0,"explanation":"阻塞 = chặn"},{"question":"Từ 「陶醉」 có nghĩa là gì?","options":["say sưa","Trách nhiệm","Phòng chống thiên tai","chặn"],"answer_index":0,"explanation":"陶醉 = say sưa"},{"question":"Từ 「青年人」 có nghĩa là gì?","options":["giới trẻ","Trách nhiệm","Phòng chống thiên tai","chặn"],"answer_index":0,"explanation":"青年人 = giới trẻ"},{"question":"Từ 「静默」 có nghĩa là gì?","options":["im lặng","Trách nhiệm","Phòng chống thiên tai","chặn"],"answer_index":0,"explanation":"静默 = im lặng"},{"question":"Từ 「鞑靼」 có nghĩa là gì?","options":["Tatar","Trách nhiệm","Phòng chống thiên tai","chặn"],"answer_index":0,"explanation":"鞑靼 = Tatar"},{"question":"Từ 「音乐厅」 có nghĩa là gì?","options":