_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_99b15dff","audio_ref":"m_d8d10f3d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_c9b84643"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1179","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"好点を 使います。","line_vi":"Tôi dùng 好点.","focus_words":["好点"]},{"speaker":"B","line_target":"孟加拉国 は 何ですか。","line_vi":"孟加拉国 là cái gì?","focus_words":["孟加拉国"]},{"speaker":"A","line_target":"官职です。","line_vi":"Đó là 官职.","focus_words":["官职"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9db27ad2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「好点」 có nghĩa là gì?","options":["điểm tốt hơn","Bangladesh","chức vụ chính thức","Giống như"],"answer_index":0,"explanation":"好点 = điểm tốt hơn"},{"question":"Từ 「孟加拉国」 có nghĩa là gì?","options":["Bangladesh","điểm tốt hơn","chức vụ chính thức","Giống như"],"answer_index":0,"explanation":"孟加拉国 = Bangladesh"},{"question":"Từ 「官职」 có nghĩa là gì?","options":["chức vụ chính thức","điểm tốt hơn","Bangladesh","Giống như"],"answer_index":0,"explanation":"官职 = chức vụ chính thức"},{"question":"Từ 「宛如」 có nghĩa là gì?","options":["Giống như","điểm tốt hơn","Bangladesh","chức vụ chính thức"],"answer_index":0,"explanation":"宛如 = Giống như"},{"question":"Từ 「宝座」 có nghĩa là gì?","options":["ngai vàng","điểm tốt hơn","Bangladesh","chức vụ chính thức"],"answer_index":0,"explanation":"宝座 = ngai vàng"},{"question":"Từ 「实惠」 có nghĩa là gì?","options":["Giá cả phải chăng","điểm tốt hơn","Bangladesh","chức vụ chính thức"],"answer_index":0,"explanation":"实惠 = Giá cả phải chăng"},{"que