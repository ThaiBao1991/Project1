ng đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1550","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"六岁を 使います。","line_vi":"Tôi dùng 六岁.","focus_words":["六岁"]},{"speaker":"B","line_target":"六成 は 何ですか。","line_vi":"六成 là cái gì?","focus_words":["六成"]},{"speaker":"A","line_target":"共同努力です。","line_vi":"Đó là 共同努力.","focus_words":["共同努力"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_261dfa7c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「六岁」 có nghĩa là gì?","options":["sáu tuổi","60%","làm việc cùng nhau","bảo trì"],"answer_index":0,"explanation":"六岁 = sáu tuổi"},{"question":"Từ 「六成」 có nghĩa là gì?","options":["60%","sáu tuổi","làm việc cùng nhau","bảo trì"],"answer_index":0,"explanation":"六成 = 60%"},{"question":"Từ 「共同努力」 có nghĩa là gì?","options":["làm việc cùng nhau","sáu tuổi","60%","bảo trì"],"answer_index":0,"explanation":"共同努力 = làm việc cùng nhau"},{"question":"Từ 「养护」 có nghĩa là gì?","options":["bảo trì","sáu tuổi","60%","làm việc cùng nhau"],"answer_index":0,"explanation":"养护 = bảo trì"},{"question":"Từ 「内线」 có nghĩa là gì?","options":["Người trong cuộc","sáu tuổi","60%","làm việc cùng nhau"],"answer_index":0,"explanation":"内线 = Người trong cuộc"},{"question":"Từ 「再者」 có nghĩa là gì?","options":["Hơn nữa","sáu tuổi","60%","làm việc cùng nhau"],"answer_index":0,"explanation":"再者 = Hơn nữa"},{"question":"Từ 「再造」 có nghĩa là gì?","options":["Tái cấu trúc","sáu tuổi","60%","làm việc cùng nhau"],"answer_index":0,"explanation