 gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2050","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"扯淡を 使います。","line_vi":"Tôi dùng 扯淡.","focus_words":["扯淡"]},{"speaker":"B","line_target":"拆毁 は 何ですか。","line_vi":"拆毁 là cái gì?","focus_words":["拆毁"]},{"speaker":"A","line_target":"拉链です。","line_vi":"Đó là 拉链.","focus_words":["拉链"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0fe8cd8a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「扯淡」 có nghĩa là gì?","options":["Vô nghĩa","phá hủy","dây kéo","chết đói"],"answer_index":0,"explanation":"扯淡 = Vô nghĩa"},{"question":"Từ 「拆毁」 có nghĩa là gì?","options":["phá hủy","Vô nghĩa","dây kéo","chết đói"],"answer_index":0,"explanation":"拆毁 = phá hủy"},{"question":"Từ 「拉链」 có nghĩa là gì?","options":["dây kéo","Vô nghĩa","phá hủy","chết đói"],"answer_index":0,"explanation":"拉链 = dây kéo"},{"question":"Từ 「挨饿」 có nghĩa là gì?","options":["chết đói","Vô nghĩa","phá hủy","dây kéo"],"answer_index":0,"explanation":"挨饿 = chết đói"},{"question":"Từ 「据传」 có nghĩa là gì?","options":["Có tin đồn","Vô nghĩa","phá hủy","dây kéo"],"answer_index":0,"explanation":"据传 = Có tin đồn"},{"question":"Từ 「推销员」 có nghĩa là gì?","options":["người bán hàng","Vô nghĩa","phá hủy","dây kéo"],"answer_index":0,"explanation":"推销员 = người bán hàng"},{"question":"Từ 「援交」 có nghĩa là gì?","options":["hẹn hò đền bù","Vô nghĩa","phá 