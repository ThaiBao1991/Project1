ộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1752","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"手语を 使います。","line_vi":"Tôi dùng 手语.","focus_words":["手语"]},{"speaker":"B","line_target":"托运 は 何ですか。","line_vi":"托运 là cái gì?","focus_words":["托运"]},{"speaker":"A","line_target":"抓狂です。","line_vi":"Đó là 抓狂.","focus_words":["抓狂"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_786bf9d2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「手语」 có nghĩa là gì?","options":["ngôn ngữ ký hiệu","lô hàng","Điên","Đưa vào sử dụng"],"answer_index":0,"explanation":"手语 = ngôn ngữ ký hiệu"},{"question":"Từ 「托运」 có nghĩa là gì?","options":["lô hàng","ngôn ngữ ký hiệu","Điên","Đưa vào sử dụng"],"answer_index":0,"explanation":"托运 = lô hàng"},{"question":"Từ 「抓狂」 có nghĩa là gì?","options":["Điên","ngôn ngữ ký hiệu","lô hàng","Đưa vào sử dụng"],"answer_index":0,"explanation":"抓狂 = Điên"},{"question":"Từ 「投入使用」 có nghĩa là gì?","options":["Đưa vào sử dụng","ngôn ngữ ký hiệu","lô hàng","Điên"],"answer_index":0,"explanation":"投入使用 = Đưa vào sử dụng"},{"question":"Từ 「抛出」 có nghĩa là gì?","options":["Ném","ngôn ngữ ký hiệu","lô hàng","Điên"],"answer_index":0,"explanation":"抛出 = Ném"},{"question":"Từ 「拘留所」 có nghĩa là gì?","options":["trung tâm giam giữ","ngôn ngữ ký hiệu","lô hàng","Điên"],"answer_index":0,"explanation":"拘留所 = trung tâm giam giữ"},{"question":"Từ 「拜登」 có nghĩa là gì?","options":["Biden","ngôn ngữ ký hiệu","lô hàng","Điên"],"answer_index":0,"explanation":"拜登 = Biden"},{"question":"Từ 「捣毁」 có nghĩa là