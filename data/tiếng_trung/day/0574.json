校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 574","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"共计を 使います。","line_vi":"Tôi dùng 共计.","focus_words":["共计"]},{"speaker":"B","line_target":"典范 は 何ですか。","line_vi":"典范 là cái gì?","focus_words":["典范"]},{"speaker":"A","line_target":"内政です。","line_vi":"Đó là 内政.","focus_words":["内政"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_08e299d9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「共计」 có nghĩa là gì?","options":["tổng cộng","người mẫu","công việc nội bộ","Xuất hiện lại"],"answer_index":0,"explanation":"共计 = tổng cộng"},{"question":"Từ 「典范」 có nghĩa là gì?","options":["người mẫu","tổng cộng","công việc nội bộ","Xuất hiện lại"],"answer_index":0,"explanation":"典范 = người mẫu"},{"question":"Từ 「内政」 có nghĩa là gì?","options":["công việc nội bộ","tổng cộng","người mẫu","Xuất hiện lại"],"answer_index":0,"explanation":"内政 = công việc nội bộ"},{"question":"Từ 「再现」 có nghĩa là gì?","options":["Xuất hiện lại","tổng cộng","người mẫu","công việc nội bộ"],"answer_index":0,"explanation":"再现 = Xuất hiện lại"},{"question":"Từ 「军阀」 có nghĩa là gì?","options":["lãnh chúa","tổng cộng","người mẫu","công việc nội bộ"],"answer_index":0,"explanation":"军阀 = lãnh chúa"},{"question":"Từ 「减肥」 có nghĩa là gì?","options":["giảm cân","tổng cộng","người mẫu","công việc nội bộ"],"answer_index":0,"explanation":"减肥 = giảm cân"},{"question":"Từ 「出路」 có nghĩa là gì?","optio