"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_9c643a44","audio_ref":"m_f845541b","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f70e72c5"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2080","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"地价を 使います。","line_vi":"Tôi dùng 地价.","focus_words":["地价"]},{"speaker":"B","line_target":"地皮 は 何ですか。","line_vi":"地皮 là cái gì?","focus_words":["地皮"]},{"speaker":"A","line_target":"堕入です。","line_vi":"Đó là 堕入.","focus_words":["堕入"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c2bbe2a5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「地价」 có nghĩa là gì?","options":["giá đất","đất đai","rơi vào","Seth"],"answer_index":0,"explanation":"地价 = giá đất"},{"question":"Từ 「地皮」 có nghĩa là gì?","options":["đất đai","giá đất","rơi vào","Seth"],"answer_index":0,"explanation":"地皮 = đất đai"},{"question":"Từ 「堕入」 có nghĩa là gì?","options":["rơi vào","giá đất","đất đai","Seth"],"answer_index":0,"explanation":"堕入 = rơi vào"},{"question":"Từ 「塞斯」 có nghĩa là gì?","options":["Seth","giá đất","đất đai","rơi vào"],"answer_index":0,"explanation":"塞斯 = Seth"},{"question":"Từ 「增压」 có nghĩa là gì?","options":["siêu nạp","giá đất","đất đai","rơi vào"],"answer_index":0,"explanation":"增压 = siêu nạp"},{"question":"Từ 「墨西哥人」 có nghĩa là gì?","options":["người Mexico","giá đất","đất đai","rơi vào"],"answer_index":0,"explanation":"墨西哥人 = người Mexico"},{"question":"Từ 「多座」 có nghĩa là gì?","options":["Nhiều chỗ ngồi","giá đất","đất đai","rơi vào"],"answer_index":0,"explanation":"多座 = Nhiều chỗ ngồi"},{"question":"Từ 「大蒜」 có nghĩa là gì?","options":["tỏi","giá đất","đất đai","rơi vào"],"answer_index":0,"explanation":"大蒜 = tỏi"}],"pattern":[{"question":"Chọn từ đúng c