onetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_2888d81b","audio_ref":"m_65e2b1b5","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_71c8ae1b"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2304","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"朝拜を 使います。","line_vi":"Tôi dùng 朝拜.","focus_words":["朝拜"]},{"speaker":"B","line_target":"朝政 は 何ですか。","line_vi":"朝政 là cái gì?","focus_words":["朝政"]},{"speaker":"A","line_target":"期末です。","line_vi":"Đó là 期末.","focus_words":["期末"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ea24e161","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「朝拜」 có nghĩa là gì?","options":["tôn thờ","Chính phủ","Kết thúc nhiệm kỳ","Kỳ vọng"],"answer_index":0,"explanation":"朝拜 = tôn thờ"},{"question":"Từ 「朝政」 có nghĩa là gì?","options":["Chính phủ","tôn thờ","Kết thúc nhiệm kỳ","Kỳ vọng"],"answer_index":0,"explanation":"朝政 = Chính phủ"},{"question":"Từ 「期末」 có nghĩa là gì?","options":["Kết thúc nhiệm kỳ","tôn thờ","Chính phủ","Kỳ vọng"],"answer_index":0,"explanation":"期末 = Kết thúc nhiệm kỳ"},{"question":"Từ 「期许」 có nghĩa là gì?","options":["Kỳ vọng","tôn thờ","Chính phủ","Kết thúc nhiệm kỳ"],"answer_index":0,"explanation":"期许 = Kỳ vọng"},{"question":"Từ 「木乃伊」 có nghĩa là gì?","options":["mẹ ơi","tôn thờ","Chính phủ","Kết thúc nhiệm kỳ"],"answer_index":0,"explanation":"木乃伊 = mẹ ơi"},{"question":"Từ 「杀敌」 có nghĩa là gì?","options":["Giết kẻ thù","tôn thờ","Chính phủ","Kết thúc nhiệm kỳ"],"answer_index":0,"explanation":"杀敌 = Giết kẻ thù"},{"question":"Từ 「权重」 có nghĩa là gì?","options":["trọng lượng","tôn thờ","Chính phủ","Kết thúc nhiệm kỳ"],"answer_index":0,"explanation":"权重 = trọng lượng"},{"question":"Từ 「李自成