す。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1029","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"贩毒を 使います。","line_vi":"Tôi dùng 贩毒.","focus_words":["贩毒"]},{"speaker":"B","line_target":"贵宾 は 何ですか。","line_vi":"贵宾 là cái gì?","focus_words":["贵宾"]},{"speaker":"A","line_target":"越狱です。","line_vi":"Đó là 越狱.","focus_words":["越狱"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dc344458","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「贩毒」 có nghĩa là gì?","options":["buôn bán ma túy","VIP","Bẻ khóa","chà đạp"],"answer_index":0,"explanation":"贩毒 = buôn bán ma túy"},{"question":"Từ 「贵宾」 có nghĩa là gì?","options":["VIP","buôn bán ma túy","Bẻ khóa","chà đạp"],"answer_index":0,"explanation":"贵宾 = VIP"},{"question":"Từ 「越狱」 có nghĩa là gì?","options":["Bẻ khóa","buôn bán ma túy","VIP","chà đạp"],"answer_index":0,"explanation":"越狱 = Bẻ khóa"},{"question":"Từ 「践踏」 có nghĩa là gì?","options":["chà đạp","buôn bán ma túy","VIP","Bẻ khóa"],"answer_index":0,"explanation":"践踏 = chà đạp"},{"question":"Từ 「车身」 có nghĩa là gì?","options":["Thân hình","buôn bán ma túy","VIP","Bẻ khóa"],"answer_index":0,"explanation":"车身 = Thân hình"},{"question":"Từ 「过头」 có nghĩa là gì?","options":["quá mức","buôn bán ma túy","VIP","Bẻ khóa"],"answer_index":0,"explanation":"过头 = quá mức"},{"question":"Từ 「近乎」 có nghĩa là gì?","options":["gần như","buôn bán ma túy","VIP","Bẻ khóa"],"answer_index":0,"explanatio