lables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4637e386","audio_ref":"m_eaaef1c6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d1be18f0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 970","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"头疼を 使います。","line_vi":"Tôi dùng 头疼.","focus_words":["头疼"]},{"speaker":"B","line_target":"套装 は 何ですか。","line_vi":"套装 là cái gì?","focus_words":["套装"]},{"speaker":"A","line_target":"好象です。","line_vi":"Đó là 好象.","focus_words":["好象"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_55b406ab","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「头疼」 có nghĩa là gì?","options":["đau đầu","bộ đồ","như thể","cháu gái"],"answer_index":0,"explanation":"头疼 = đau đầu"},{"question":"Từ 「套装」 có nghĩa là gì?","options":["bộ đồ","đau đầu","như thể","cháu gái"],"answer_index":0,"explanation":"套装 = bộ đồ"},{"question":"Từ 「好象」 có nghĩa là gì?","options":["như thể","đau đầu","bộ đồ","cháu gái"],"answer_index":0,"explanation":"好象 = như thể"},{"question":"Từ 「孙女」 có nghĩa là gì?","options":["cháu gái","đau đầu","bộ đồ","như thể"],"answer_index":0,"explanation":"孙女 = cháu gái"},{"question":"Từ 「学家」 có nghĩa là gì?","options":["nhà khoa học","đau đầu","bộ đồ","như thể"],"answer_index":0,"explanation":"学家 = nhà khoa học"},{"question":"Từ 「孩童」 có nghĩa là gì?","options":["bọn trẻ","đau đầu","bộ đồ","như thể"],"answer_index":0,"explanation":"孩童 = bọn trẻ"},{"question":"Từ 「完蛋」 có nghĩa là gì?","options":["Đã hoàn thành","đau đầu","bộ đồ","như thể"],"answer_index":0,"explanation":"完蛋 = Đã hoàn thành"},{"question":"Từ 「实习生」 có nghĩa là gì?","options":["thực tập sinh","đau đầu","bộ đồ","như thể"],"answer_index":0,"explanation":"实习生 = thực tập sinh"}],"pattern