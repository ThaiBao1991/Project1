ôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1937","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"绝密を 使います。","line_vi":"Tôi dùng 绝密.","focus_words":["绝密"]},{"speaker":"B","line_target":"绵羊 は 何ですか。","line_vi":"绵羊 là cái gì?","focus_words":["绵羊"]},{"speaker":"A","line_target":"罗列です。","line_vi":"Đó là 罗列.","focus_words":["罗列"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_17579c53","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「绝密」 có nghĩa là gì?","options":["bí mật hàng đầu","cừu","Danh sách","Không lực Hoa Kỳ"],"answer_index":0,"explanation":"绝密 = bí mật hàng đầu"},{"question":"Từ 「绵羊」 có nghĩa là gì?","options":["cừu","bí mật hàng đầu","Danh sách","Không lực Hoa Kỳ"],"answer_index":0,"explanation":"绵羊 = cừu"},{"question":"Từ 「罗列」 có nghĩa là gì?","options":["Danh sách","bí mật hàng đầu","cừu","Không lực Hoa Kỳ"],"answer_index":0,"explanation":"罗列 = Danh sách"},{"question":"Từ 「美国空军」 có nghĩa là gì?","options":["Không lực Hoa Kỳ","bí mật hàng đầu","cừu","Danh sách"],"answer_index":0,"explanation":"美国空军 = Không lực Hoa Kỳ"},{"question":"Từ 「羟基」 có nghĩa là gì?","options":["Hydroxyl","bí mật hàng đầu","cừu","Danh sách"],"answer_index":0,"explanation":"羟基 = Hydroxyl"},{"question":"Từ 「翻阅」 có nghĩa là gì?","options":["lướt qua","bí mật hàng đầu","cừu","Danh sách"],"answer_index":0,"explanation":"翻阅 = lướt qua"},{"question":"Từ 「而论」 có nghĩa là gì?","options":["Về mặt","bí mật hàng đầu","cừu","Danh sách"],"answer_i