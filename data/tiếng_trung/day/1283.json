:"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1283","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"前夫を 使います。","line_vi":"Tôi dùng 前夫.","focus_words":["前夫"]},{"speaker":"B","line_target":"前妻 は 何ですか。","line_vi":"前妻 là cái gì?","focus_words":["前妻"]},{"speaker":"A","line_target":"剧组です。","line_vi":"Đó là 剧组.","focus_words":["剧组"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_892d8e88","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「前夫」 có nghĩa là gì?","options":["chồng cũ","vợ cũ","phi hành đoàn","phía bắc"],"answer_index":0,"explanation":"前夫 = chồng cũ"},{"question":"Từ 「前妻」 có nghĩa là gì?","options":["vợ cũ","chồng cũ","phi hành đoàn","phía bắc"],"answer_index":0,"explanation":"前妻 = vợ cũ"},{"question":"Từ 「剧组」 có nghĩa là gì?","options":["phi hành đoàn","chồng cũ","vợ cũ","phía bắc"],"answer_index":0,"explanation":"剧组 = phi hành đoàn"},{"question":"Từ 「北面」 có nghĩa là gì?","options":["phía bắc","chồng cũ","vợ cũ","phi hành đoàn"],"answer_index":0,"explanation":"北面 = phía bắc"},{"question":"Từ 「十七年」 có nghĩa là gì?","options":["mười bảy năm","chồng cũ","vợ cũ","phi hành đoàn"],"answer_index":0,"explanation":"十七年 = mười bảy năm"},{"question":"Từ 「十八岁」 có nghĩa là gì?","options":["mười tám tuổi","chồng cũ","vợ cũ","phi hành đoàn"],"answer_index":0,"explanation":"十八岁 = mười tám tuổi"},{"question":"Từ 「升空」 có nghĩa là gì?",