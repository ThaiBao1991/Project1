":"người bào chữa","explanation":"người bào chữa","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_dbede4d5","audio_ref":"m_199228c0","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_dea0e846"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]},{"title":"Dạng nối 〜て","level":"N3","explanation":"Dạng te nối hai động từ: 書いて + 読む; cũng dùng cho lý do nhẹ (寒くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]},{"title":"Từ chỉ người (の)","level":"N3","explanation":"の + danh từ: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2143","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"优越性を 使います。","line_vi":"Tôi dùng 优越性.","focus_words":["优越性"]},{"speaker":"B","line_target":"会员国 は 何ですか。","line_vi":"会员国 là cái gì?","focus_words":["会员国"]},{"speaker":"A","line_target":"伤残です。","line_vi":"Đó là 伤残.","focus_words":["伤残"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e1f903aa","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「优越性」 có nghĩa là gì?","options":["tính ưu việt","các quốc gia thành viên","bị vô hiệu hóa","phù dâu"],"answer_index":0,"explanation":"优越性 = tính ưu việt"},{"question":"Từ 「会员国」 có nghĩa là gì?","options":["các quốc gia thành viên","tính ưu việt","bị vô hiệu hóa","phù dâu"],"answer_index":0,"explanation":"会员国 = các quốc gia thành viên"},{"question":"Từ 「伤残」 có nghĩa là gì?","options":["bị vô hiệu hóa","tính ưu việt","các quốc gia thành viên","phù dâu"],"answer_index":0,"explanation":"伤残 = bị vô hiệu hóa"},{"question":"Từ 「伴娘」 có nghĩa là gì?","options":["phù dâu","tính ưu việt","các quốc gia thành viên","bị vô hiệu hóa"],"answer_index":0,"explanation":"伴娘 = phù dâu"},{"question":"Từ 「何来」 có nghĩa là gì?","options":["Nó đến từ đâu?","tính ưu việt","các quốc gia thành viên","bị vô hiệu hóa"],"answer_index":0,"explanation":"何来 = Nó đến từ đâu?"},{"question":"Từ 「侵华」 có nghĩa là gì?","options":["Cuộc xâm lược của Trun