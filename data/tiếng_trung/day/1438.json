ọc sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1438","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"管子を 使います。","line_vi":"Tôi dùng 管子.","focus_words":["管子"]},{"speaker":"B","line_target":"精神文明 は 何ですか。","line_vi":"精神文明 là cái gì?","focus_words":["精神文明"]},{"speaker":"A","line_target":"精髓です。","line_vi":"Đó là 精髓.","focus_words":["精髓"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6d780d2f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「管子」 có nghĩa là gì?","options":["ống","nền văn minh tâm linh","Tinh chất","yêu sách"],"answer_index":0,"explanation":"管子 = ống"},{"question":"Từ 「精神文明」 có nghĩa là gì?","options":["nền văn minh tâm linh","ống","Tinh chất","yêu sách"],"answer_index":0,"explanation":"精神文明 = nền văn minh tâm linh"},{"question":"Từ 「精髓」 có nghĩa là gì?","options":["Tinh chất","ống","nền văn minh tâm linh","yêu sách"],"answer_index":0,"explanation":"精髓 = Tinh chất"},{"question":"Từ 「索赔」 có nghĩa là gì?","options":["yêu sách","ống","nền văn minh tâm linh","Tinh chất"],"answer_index":0,"explanation":"索赔 = yêu sách"},{"question":"Từ 「纠结」 có nghĩa là gì?","options":["Rối","ống","nền văn minh tâm linh","Tinh chất"],"answer_index":0,"explanation":"纠结 = Rối"},{"question":"Từ 「红十字会」 có nghĩa là gì?","options":["chữ thập đỏ","ống","nền văn minh tâm linh","Tinh chất"],"answer_index":0,"explanation":"红十字会 = chữ thập đỏ"},{"question":"Từ 「纽带」 có nghĩa là gì?","options":["trái phiếu","ống","nền văn minh tâm linh","Tinh chất"],"answer_index":0,"explanation":"纽带 = trá