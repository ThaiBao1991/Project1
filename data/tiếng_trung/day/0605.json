[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1213910e","audio_ref":"m_8a357f56","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ee58c238"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 605","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"裁定を 使います。","line_vi":"Tôi dùng 裁定.","focus_words":["裁定"]},{"speaker":"B","line_target":"解决问题 は 何ですか。","line_vi":"解决问题 là cái gì?","focus_words":["解决问题"]},{"speaker":"A","line_target":"议论です。","line_vi":"Đó là 议论.","focus_words":["议论"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e0a75e35","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「裁定」 có nghĩa là gì?","options":["cầm quyền","giải quyết vấn đề","thảo luận","lời nói"],"answer_index":0,"explanation":"裁定 = cầm quyền"},{"question":"Từ 「解决问题」 có nghĩa là gì?","options":["giải quyết vấn đề","cầm quyền","thảo luận","lời nói"],"answer_index":0,"explanation":"解决问题 = giải quyết vấn đề"},{"question":"Từ 「议论」 có nghĩa là gì?","options":["thảo luận","cầm quyền","giải quyết vấn đề","lời nói"],"answer_index":0,"explanation":"议论 = thảo luận"},{"question":"Từ 「词语」 có nghĩa là gì?","options":["lời nói","cầm quyền","giải quyết vấn đề","thảo luận"],"answer_index":0,"explanation":"词语 = lời nói"},{"question":"Từ 「财物」 có nghĩa là gì?","options":["tài sản","cầm quyền","giải quyết vấn đề","thảo luận"],"answer_index":0,"explanation":"财物 = tài sản"},{"question":"Từ 「贪婪」 có nghĩa là gì?","options":["tham lam","cầm quyền","giải quyết vấn đề","thảo luận"],"answer_index":0,"explanation":"贪婪 = tham lam"},{"question":"Từ 「身后」 có nghĩa là gì?","options":["đằng sau","cầm quyền","giải quyết vấn đề","thảo luận"],"answer_index":0,"explanation":"身后 = đằng sau"},{"question":"Từ 「造就」 có nghĩa là gì?","options":["chỉnh s