m."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1376","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吏部を 使います。","line_vi":"Tôi dùng 吏部.","focus_words":["吏部"]},{"speaker":"B","line_target":"吸纳 は 何ですか。","line_vi":"吸纳 là cái gì?","focus_words":["吸纳"]},{"speaker":"A","line_target":"告发です。","line_vi":"Đó là 告发.","focus_words":["告发"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_df597423","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吏部」 có nghĩa là gì?","options":["Bộ công vụ","hấp thụ","thông báo","chu đáo"],"answer_index":0,"explanation":"吏部 = Bộ công vụ"},{"question":"Từ 「吸纳」 có nghĩa là gì?","options":["hấp thụ","Bộ công vụ","thông báo","chu đáo"],"answer_index":0,"explanation":"吸纳 = hấp thụ"},{"question":"Từ 「告发」 có nghĩa là gì?","options":["thông báo","Bộ công vụ","hấp thụ","chu đáo"],"answer_index":0,"explanation":"告发 = thông báo"},{"question":"Từ 「周到」 có nghĩa là gì?","options":["chu đáo","Bộ công vụ","hấp thụ","thông báo"],"answer_index":0,"explanation":"周到 = chu đáo"},{"question":"Từ 「和谈」 có nghĩa là gì?","options":["đàm phán hòa bình","Bộ công vụ","hấp thụ","thông báo"],"answer_index":0,"explanation":"和谈 = đàm phán hòa bình"},{"question":"Từ 「嘴边」 có nghĩa là gì?","options":["quanh miệng","Bộ công vụ","hấp thụ","thông báo"],"answer_index":0,"explanation":"嘴边 = quanh miệng"},{"question":"Từ 「四岁」 có nghĩa là gì?","options":["bốn tuổi","Bộ công vụ","hấp thụ","thông báo"],"answer_index":0,"explanation":"四岁 = bốn tuổi"},{"question":"Từ 「圆圆」 có nghĩa là gì?","options":["nhân dân tệ","Bộ cô