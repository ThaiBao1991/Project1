 sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1606","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吞并を 使います。","line_vi":"Tôi dùng 吞并.","focus_words":["吞并"]},{"speaker":"B","line_target":"和睦 は 何ですか。","line_vi":"和睦 là cái gì?","focus_words":["和睦"]},{"speaker":"A","line_target":"回击です。","line_vi":"Đó là 回击.","focus_words":["回击"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e6adf85c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吞并」 có nghĩa là gì?","options":["phụ lục","sự hòa hợp","đánh trả","Lại quả"],"answer_index":0,"explanation":"吞并 = phụ lục"},{"question":"Từ 「和睦」 có nghĩa là gì?","options":["sự hòa hợp","phụ lục","đánh trả","Lại quả"],"answer_index":0,"explanation":"和睦 = sự hòa hợp"},{"question":"Từ 「回击」 có nghĩa là gì?","options":["đánh trả","phụ lục","sự hòa hợp","Lại quả"],"answer_index":0,"explanation":"回击 = đánh trả"},{"question":"Từ 「回扣」 có nghĩa là gì?","options":["Lại quả","phụ lục","sự hòa hợp","đánh trả"],"answer_index":0,"explanation":"回扣 = Lại quả"},{"question":"Từ 「地去」 có nghĩa là gì?","options":["đi","phụ lục","sự hòa hợp","đánh trả"],"answer_index":0,"explanation":"地去 = đi"},{"question":"Từ 「坍塌」 có nghĩa là gì?","options":["sụp đổ","phụ lục","sự hòa hợp","đánh trả"],"answer_index":0,"explanation":"坍塌 = sụp đổ"},{"question":"Từ 「墓葬」 có nghĩa là gì?","options":["ngôi mộ","phụ lục","sự hòa hợp","đánh trả"],"answer_index":0,"explanation":"墓葬 = ngôi mộ"},{"question":"Từ 「增补」 có nghĩa là gì?","options":["bổ sung","phụ lục","sự hòa hợp","đánh tr