ables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_ebb72ee3","audio_ref":"m_f2e777b4","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_84bde69f"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2130","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"罪案を 使います。","line_vi":"Tôi dùng 罪案.","focus_words":["罪案"]},{"speaker":"B","line_target":"美剧 は 何ですか。","line_vi":"美剧 là cái gì?","focus_words":["美剧"]},{"speaker":"A","line_target":"美国联邦です。","line_vi":"Đó là 美国联邦.","focus_words":["美国联邦"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_877f06a4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「罪案」 có nghĩa là gì?","options":["tội ác","kịch Mỹ","liên bang mỹ","Mỹ và Nhật Bản"],"answer_index":0,"explanation":"罪案 = tội ác"},{"question":"Từ 「美剧」 có nghĩa là gì?","options":["kịch Mỹ","tội ác","liên bang mỹ","Mỹ và Nhật Bản"],"answer_index":0,"explanation":"美剧 = kịch Mỹ"},{"question":"Từ 「美国联邦」 có nghĩa là gì?","options":["liên bang mỹ","tội ác","kịch Mỹ","Mỹ và Nhật Bản"],"answer_index":0,"explanation":"美国联邦 = liên bang mỹ"},{"question":"Từ 「美日」 có nghĩa là gì?","options":["Mỹ và Nhật Bản","tội ác","kịch Mỹ","liên bang mỹ"],"answer_index":0,"explanation":"美日 = Mỹ và Nhật Bản"},{"question":"Từ 「胜算」 có nghĩa là gì?","options":["Tỷ lệ thắng","tội ác","kịch Mỹ","liên bang mỹ"],"answer_index":0,"explanation":"胜算 = Tỷ lệ thắng"},{"question":"Từ 「舟山」 có nghĩa là gì?","options":["Châu Sơn","tội ác","kịch Mỹ","liên bang mỹ"],"answer_index":0,"explanation":"舟山 = Châu Sơn"},{"question":"Từ 「舰船」 có nghĩa là gì?","options":["tàu