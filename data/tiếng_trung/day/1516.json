ation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1516","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"记忆力を 使います。","line_vi":"Tôi dùng 记忆力.","focus_words":["记忆力"]},{"speaker":"B","line_target":"识字率 は 何ですか。","line_vi":"识字率 là cái gì?","focus_words":["识字率"]},{"speaker":"A","line_target":"诊疗です。","line_vi":"Đó là 诊疗.","focus_words":["诊疗"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b7052f0b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「记忆力」 có nghĩa là gì?","options":["trí nhớ","tỷ lệ biết chữ","Chẩn đoán và điều trị","sinh nhật"],"answer_index":0,"explanation":"记忆力 = trí nhớ"},{"question":"Từ 「识字率」 có nghĩa là gì?","options":["tỷ lệ biết chữ","trí nhớ","Chẩn đoán và điều trị","sinh nhật"],"answer_index":0,"explanation":"识字率 = tỷ lệ biết chữ"},{"question":"Từ 「诊疗」 có nghĩa là gì?","options":["Chẩn đoán và điều trị","trí nhớ","tỷ lệ biết chữ","sinh nhật"],"answer_index":0,"explanation":"诊疗 = Chẩn đoán và điều trị"},{"question":"Từ 「诞辰」 có nghĩa là gì?","options":["sinh nhật","trí nhớ","tỷ lệ biết chữ","Chẩn đoán và điều trị"],"answer_index":0,"explanation":"诞辰 = sinh nhật"},{"question":"Từ 「该案」 có nghĩa là gì?","options":["Vụ án","trí nhớ","tỷ lệ biết chữ","Chẩn đoán và điều trị"],"answer_index":0,"explanation":"该案 = Vụ án"},{"question":"Từ 「误区」 có nghĩa là gì?","options":["Hiểu lầm","trí nhớ","tỷ lệ biết chữ","Chẩn đoán và điều trị"],"answer_index":0,"explanation":"误区 = Hiểu lầm"},{"question":"Từ 「说些」 có nghĩa là gì?","options":["nói điều gì đó","trí nhớ","tỷ lệ biết chữ","Chẩn đoán và điều trị"],"answer_index":0,"explanation