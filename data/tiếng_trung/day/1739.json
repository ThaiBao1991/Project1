ạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1739","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"neverを 使います。","line_vi":"Tôi dùng never.","focus_words":["never"]},{"speaker":"B","line_target":"ru は 何ですか。","line_vi":"ru là cái gì?","focus_words":["ru"]},{"speaker":"A","line_target":"tmです。","line_vi":"Đó là tm.","focus_words":["tm"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9f11406f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「never」 có nghĩa là gì?","options":["không bao giờ","ru","tm","một chương"],"answer_index":0,"explanation":"never = không bao giờ"},{"question":"Từ 「ru」 có nghĩa là gì?","options":["ru","không bao giờ","tm","một chương"],"answer_index":0,"explanation":"ru = ru"},{"question":"Từ 「tm」 có nghĩa là gì?","options":["tm","không bao giờ","ru","một chương"],"answer_index":0,"explanation":"tm = tm"},{"question":"Từ 「一章」 có nghĩa là gì?","options":["một chương","không bao giờ","ru","tm"],"answer_index":0,"explanation":"一章 = một chương"},{"question":"Từ 「一般而言」 có nghĩa là gì?","options":["Nói chung","không bao giờ","ru","tm"],"answer_index":0,"explanation":"一般而言 = Nói chung"},{"question":"Từ 「七岁」 có nghĩa là gì?","options":["bảy tuổi","không bao giờ","ru","tm"],"answer_index":0,"explanation":"七岁 = bảy tuổi"},{"question":"Từ 「万余」 có nghĩa là gì?","options":["Hơn mười nghìn","không bao giờ","ru","tm"],"answer_index":0,"explanation":"万余 = Hơn mười nghìn"},{"question":"Từ 「万英镑」 có nghĩa là gì?","options":["triệu bảng","không bao giờ","ru","tm"],"answer_index":0,"explanation":"万英镑 = t