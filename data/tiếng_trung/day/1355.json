"example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e7ae2b58","audio_ref":"m_95d10024","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_60b7669d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1355","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"夺权を 使います。","line_vi":"Tôi dùng 夺权.","focus_words":["夺权"]},{"speaker":"B","line_target":"女方 は 何ですか。","line_vi":"女方 là cái gì?","focus_words":["女方"]},{"speaker":"A","line_target":"委任です。","line_vi":"Đó là 委任.","focus_words":["委任"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9300e74a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「夺权」 có nghĩa là gì?","options":["nắm quyền lực","người phụ nữ","bổ nhiệm","hệ thống học thuật"],"answer_index":0,"explanation":"夺权 = nắm quyền lực"},{"question":"Từ 「女方」 có nghĩa là gì?","options":["người phụ nữ","nắm quyền lực","bổ nhiệm","hệ thống học thuật"],"answer_index":0,"explanation":"女方 = người phụ nữ"},{"question":"Từ 「委任」 có nghĩa là gì?","options":["bổ nhiệm","nắm quyền lực","người phụ nữ","hệ thống học thuật"],"answer_index":0,"explanation":"委任 = bổ nhiệm"},{"question":"Từ 「学制」 có nghĩa là gì?","options":["hệ thống học thuật","nắm quyền lực","người phụ nữ","bổ nhiệm"],"answer_index":0,"explanation":"学制 = hệ thống học thuật"},{"question":"Từ 「安保」 có nghĩa là gì?","options":["an ninh","nắm quyền lực","người phụ nữ","bổ nhiệm"],"answer_index":0,"explanation":"安保 = an ninh"},{"question":"Từ 「宝物」 có nghĩa là gì?","options":["kho báu","nắm quyền lực","người phụ nữ","bổ nhiệm"],"answer_index":0,"explanation":"宝物 = kho báu"},