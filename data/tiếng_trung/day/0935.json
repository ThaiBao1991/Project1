_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 935","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"入围を 使います。","line_vi":"Tôi dùng 入围.","focus_words":["入围"]},{"speaker":"B","line_target":"八路军 は 何ですか。","line_vi":"八路军 là cái gì?","focus_words":["八路军"]},{"speaker":"A","line_target":"内有です。","line_vi":"Đó là 内有.","focus_words":["内有"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c6d4c0b1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「入围」 có nghĩa là gì?","options":["Danh sách rút gọn","Quân đội đường thứ tám","Chứa","nông dân"],"answer_index":0,"explanation":"入围 = Danh sách rút gọn"},{"question":"Từ 「八路军」 có nghĩa là gì?","options":["Quân đội đường thứ tám","Danh sách rút gọn","Chứa","nông dân"],"answer_index":0,"explanation":"八路军 = Quân đội đường thứ tám"},{"question":"Từ 「内有」 có nghĩa là gì?","options":["Chứa","Danh sách rút gọn","Quân đội đường thứ tám","nông dân"],"answer_index":0,"explanation":"内有 = Chứa"},{"question":"Từ 「农户」 có nghĩa là gì?","options":["nông dân","Danh sách rút gọn","Quân đội đường thứ tám","Chứa"],"answer_index":0,"explanation":"农户 = nông dân"},{"question":"Từ 「出错」 có nghĩa là gì?","options":["Lỗi","Danh sách rút gọn","Quân đội đường thứ tám","Chứa"],"answer_index":0,"explanation":"出错 = Lỗi"},{"question":"Từ 「分流」 có nghĩa là gì?","options":["chuyển hướng","Danh sách rút gọn","Quân đội đường thứ tám","Chứa"],"answer_index":0,"explanation":"分流 = chuyển hướng"},{"question":"Từ 「副局长」 có nghĩa là gì?","options":["