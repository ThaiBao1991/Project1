i dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 738","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"阻力を 使います。","line_vi":"Tôi dùng 阻力.","focus_words":["阻力"]},{"speaker":"B","line_target":"阿尔 は 何ですか。","line_vi":"阿尔 là cái gì?","focus_words":["阿尔"]},{"speaker":"A","line_target":"限额です。","line_vi":"Đó là 限额.","focus_words":["限额"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ff2a9034","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「阻力」 có nghĩa là gì?","options":["sức đề kháng","Al","giới hạn","gốm sứ"],"answer_index":0,"explanation":"阻力 = sức đề kháng"},{"question":"Từ 「阿尔」 có nghĩa là gì?","options":["Al","sức đề kháng","giới hạn","gốm sứ"],"answer_index":0,"explanation":"阿尔 = Al"},{"question":"Từ 「限额」 có nghĩa là gì?","options":["giới hạn","sức đề kháng","Al","gốm sứ"],"answer_index":0,"explanation":"限额 = giới hạn"},{"question":"Từ 「陶瓷」 có nghĩa là gì?","options":["gốm sứ","sức đề kháng","Al","giới hạn"],"answer_index":0,"explanation":"陶瓷 = gốm sứ"},{"question":"Từ 「顶尖」 có nghĩa là gì?","options":["hàng đầu","sức đề kháng","Al","giới hạn"],"answer_index":0,"explanation":"顶尖 = hàng đầu"},{"question":"Từ 「马德里」 có nghĩa là gì?","options":["Madrid","sức đề kháng","Al","giới hạn"],"answer_index":0,"explanation":"马德里 = Madrid"},{"question":"Từ 「高雄」 có nghĩa là gì?","options":["Cao Hùng","sức đề kháng","Al","giới hạn"],"answer_index":0,"explanation":"高雄 = Cao Hùng"},{"question":"Từ 「魔术」 có nghĩa là gì?","options":["ma thuật","sức đề kháng","Al","giới hạn"],"answer_index":0,"explanation":"魔术 = ma thu