 đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1210","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"踢球を 使います。","line_vi":"Tôi dùng 踢球.","focus_words":["踢球"]},{"speaker":"B","line_target":"达尔文 は 何ですか。","line_vi":"达尔文 là cái gì?","focus_words":["达尔文"]},{"speaker":"A","line_target":"迎合です。","line_vi":"Đó là 迎合.","focus_words":["迎合"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9077b9de","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「踢球」 có nghĩa là gì?","options":["đá một quả bóng","Darwin","phục vụ cho","ăn uống"],"answer_index":0,"explanation":"踢球 = đá một quả bóng"},{"question":"Từ 「达尔文」 có nghĩa là gì?","options":["Darwin","đá một quả bóng","phục vụ cho","ăn uống"],"answer_index":0,"explanation":"达尔文 = Darwin"},{"question":"Từ 「迎合」 có nghĩa là gì?","options":["phục vụ cho","đá một quả bóng","Darwin","ăn uống"],"answer_index":0,"explanation":"迎合 = phục vụ cho"},{"question":"Từ 「进食」 có nghĩa là gì?","options":["ăn uống","đá một quả bóng","Darwin","phục vụ cho"],"answer_index":0,"explanation":"进食 = ăn uống"},{"question":"Từ 「追赶」 có nghĩa là gì?","options":["bắt kịp","đá một quả bóng","Darwin","phục vụ cho"],"answer_index":0,"explanation":"追赶 = bắt kịp"},{"question":"Từ 「追问」 có nghĩa là gì?","options":["Hỏi","đá một quả bóng","Darwin","phục vụ cho"],"answer_index":0,"explanation":"追问 = Hỏi"},{"question":"Từ 「送入」