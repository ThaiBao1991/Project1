":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 630","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"两项を 使います。","line_vi":"Tôi dùng 两项.","focus_words":["两项"]},{"speaker":"B","line_target":"为例 は 何ですか。","line_vi":"为例 là cái gì?","focus_words":["为例"]},{"speaker":"A","line_target":"乡下です。","line_vi":"Đó là 乡下.","focus_words":["乡下"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_024b0b9e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「两项」 có nghĩa là gì?","options":["Hai mục","Ví dụ","nông thôn","hỗ trợ lẫn nhau"],"answer_index":0,"explanation":"两项 = Hai mục"},{"question":"Từ 「为例」 có nghĩa là gì?","options":["Ví dụ","Hai mục","nông thôn","hỗ trợ lẫn nhau"],"answer_index":0,"explanation":"为例 = Ví dụ"},{"question":"Từ 「乡下」 có nghĩa là gì?","options":["nông thôn","Hai mục","Ví dụ","hỗ trợ lẫn nhau"],"answer_index":0,"explanation":"乡下 = nông thôn"},{"question":"Từ 「互助」 có nghĩa là gì?","options":["hỗ trợ lẫn nhau","Hai mục","Ví dụ","nông thôn"],"answer_index":0,"explanation":"互助 = hỗ trợ lẫn nhau"},{"question":"Từ 「产权」 có nghĩa là gì?","options":["quyền tài sản","Hai mục","Ví dụ","nông thôn"],"answer_index":0,"explanation":"产权 = quyền tài sản"},{"question":"Từ 「位居」 có nghĩa là gì?","options":["vị trí","Hai mục","Ví dụ","nông thôn"],"answer_index":0,"explanation":"位居 = vị trí"},{"question":"Từ 「作法」 có nghĩa là gì?","options":["luyện tập","Hai mục","Ví dụ","nông thôn"],"answer_index":0,"explanation":"作法 = luyện tập"},{"question":"Từ 「做饭」 có nghĩa là gì?","options":["nấu ăn","Hai mục","Ví dụ","nông thôn"],