nces":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1270","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"狭小を 使います。","line_vi":"Tôi dùng 狭小.","focus_words":["狭小"]},{"speaker":"B","line_target":"王家 は 何ですか。","line_vi":"王家 là cái gì?","focus_words":["王家"]},{"speaker":"A","line_target":"甜心です。","line_vi":"Đó là 甜心.","focus_words":["甜心"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2815bc27","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「狭小」 có nghĩa là gì?","options":["nhỏ bé","họ Vương","người yêu","phương tiện sản xuất"],"answer_index":0,"explanation":"狭小 = nhỏ bé"},{"question":"Từ 「王家」 có nghĩa là gì?","options":["họ Vương","nhỏ bé","người yêu","phương tiện sản xuất"],"answer_index":0,"explanation":"王家 = họ Vương"},{"question":"Từ 「甜心」 có nghĩa là gì?","options":["người yêu","nhỏ bé","họ Vương","phương tiện sản xuất"],"answer_index":0,"explanation":"甜心 = người yêu"},{"question":"Từ 「生产资料」 có nghĩa là gì?","options":["phương tiện sản xuất","nhỏ bé","họ Vương","người yêu"],"answer_index":0,"explanation":"生产资料 = phương tiện sản xuất"},{"question":"Từ 「监护」 có nghĩa là gì?","options":["quyền giám hộ","nhỏ bé","họ Vương","người yêu"],"answer_index":0,"explanation":"监护 = quyền giám hộ"},{"question":"Từ 「盛典