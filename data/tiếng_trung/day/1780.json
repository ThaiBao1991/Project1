i."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1780","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"打捞を 使います。","line_vi":"Tôi dùng 打捞.","focus_words":["打捞"]},{"speaker":"B","line_target":"扶助 は 何ですか。","line_vi":"扶助 là cái gì?","focus_words":["扶助"]},{"speaker":"A","line_target":"抓起です。","line_vi":"Đó là 抓起.","focus_words":["抓起"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fee0cb1c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「打捞」 có nghĩa là gì?","options":["Cứu hộ","hỗ trợ","chộp lấy","Cướp"],"answer_index":0,"explanation":"打捞 = Cứu hộ"},{"question":"Từ 「扶助」 có nghĩa là gì?","options":["hỗ trợ","Cứu hộ","chộp lấy","Cướp"],"answer_index":0,"explanation":"扶助 = hỗ trợ"},{"question":"Từ 「抓起」 có nghĩa là gì?","options":["chộp lấy","Cứu hộ","hỗ trợ","Cướp"],"answer_index":0,"explanation":"抓起 = chộp lấy"},{"question":"Từ 「挟持」 có nghĩa là gì?","options":["Cướp","Cứu hộ","hỗ trợ","chộp lấy"],"answer_index":0,"explanation":"挟持 = Cướp"},{"question":"Từ 「掌上」 có nghĩa là gì?","options":["Cọ","Cứu hộ","hỗ trợ","chộp lấy"],"answer_index":0,"explanation":"掌上 = Cọ"},{"question":"Từ 「提要」 có nghĩa là gì?","options":["thức ăn","Cứu hộ","hỗ trợ","chộp lấy"],"answer_index":0,"explanation":"提要 = thức ăn"},{"question":"Từ 「撕开」 có nghĩa là gì?","options":["xé nát","Cứu hộ","hỗ trợ","chộp lấy"],"answer_index":0,"explanation":"撕开 = xé nát"},{"question":"Từ 「撤换」 có nghĩa là gì?","options":["Thay thế","Cứu hộ","hỗ trợ","chộp lấy"],"answer_index":0,"explanation":"撤换 = Thay thế"}],"pattern":[{"question":"Chọn 