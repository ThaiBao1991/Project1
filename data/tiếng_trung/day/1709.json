c_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_71144906","audio_ref":"m_fc2836c4","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_48a3ef6e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1709","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"飙升を 使います。","line_vi":"Tôi dùng 飙升.","focus_words":["飙升"]},{"speaker":"B","line_target":"飞鸟 は 何ですか。","line_vi":"飞鸟 là cái gì?","focus_words":["飞鸟"]},{"speaker":"A","line_target":"香格里拉です。","line_vi":"Đó là 香格里拉.","focus_words":["香格里拉"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_80e81c86","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「飙升」 có nghĩa là gì?","options":["bay lên","chim bay","Shangri-la","lừa tiền"],"answer_index":0,"explanation":"飙升 = bay lên"},{"question":"Từ 「飞鸟」 có nghĩa là gì?","options":["chim bay","bay lên","Shangri-la","lừa tiền"],"answer_index":0,"explanation":"飞鸟 = chim bay"},{"question":"Từ 「香格里拉」 có nghĩa là gì?","options":["Shangri-la","bay lên","chim bay","lừa tiền"],"answer_index":0,"explanation":"香格里拉 = Shangri-la"},{"question":"Từ 「骗钱」 có nghĩa là gì?","options":["lừa tiền","bay lên","chim bay","Shangri-la"],"answer_index":0,"explanation":"骗钱 = lừa tiền"},{"question":"Từ 「高管」 có nghĩa là gì?","options":["điều hành","bay lên","chim bay","Shangri-la"],"answer_index":0,"explanation":"高管 = điều hành"},{"question":"Từ 「高调」 có nghĩa là gì?","options":["hồ sơ cao","bay lên","chim bay","Shangri-la"],"answer_index":0,"explanation":"高调 = hồ sơ cao"},{"question":"Từ 「鲁莽」 có nghĩa là gì?","options":["liều lĩnh","bay lên","chim bay","Shangri-la"],"answer_index":0,"explanation":"鲁莽 = liều lĩnh"},{"question":"Từ 「黑市」 có nghĩa là gì?","options":["chợ đen","bay lên","chim bay","Shangri-la"],"ans