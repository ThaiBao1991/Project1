_words":["分设"]},{"speaker":"B","line_target":"分销 は 何ですか。","line_vi":"分销 là cái gì?","focus_words":["分销"]},{"speaker":"A","line_target":"初年です。","line_vi":"Đó là 初年.","focus_words":["初年"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「分设」 có nghĩa là gì?","options":["riêng biệt","Phân phối","những năm đầu","Lúc đầu"],"answer_index":0,"explanation":"分设 = riêng biệt"},{"question":"Từ 「分销」 có nghĩa là gì?","options":["Phân phối","riêng biệt","những năm đầu","Lúc đầu"],"answer_index":0,"explanation":"分销 = Phân phối"},{"question":"Từ 「初年」 có nghĩa là gì?","options":["những năm đầu","riêng biệt","Phân phối","Lúc đầu"],"answer_index":0,"explanation":"初年 = những năm đầu"},{"question":"Từ 「初时」 có nghĩa là gì?","options":["Lúc đầu","riêng biệt","Phân phối","những năm đầu"],"answer_index":0,"explanation":"初时 = Lúc đầu"},{"question":"Từ 「劳作」 có nghĩa là gì?","options":["làm việc","riêng biệt","Phân phối","những năm đầu"],"answer_index":0,"explanation":"劳作 = làm việc"},{"question":"Từ 「十一点」 có nghĩa là gì?","options":["mười một giờ","riêng biệt","Phân phối","những năm đầu"],"answer_index":0,"explanation":"十一点 = mười một giờ"},{"question":"Từ 「十分之一」 có nghĩa là gì?","options":["một phần mười","riêng biệt","Phân phối","những năm đầu"],"answer_index":0,"explanation":"十分之一 = một phần mười"},{"question":"Từ 「千亿」 có nghĩa là gì?","options":["Hàng trăm tỷ","riêng biệt","Phân phối","những năm đầu"],"answer_index":0,"explanation":"千亿 = Hàng trăm tỷ"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: riêng biệt","options":["分设","分销","初年","初时"],"answer_index":0,"explanation":"分设 = riêng biệt"},{"question":"Chọn từ đúng cho nghĩa: Phân phối","options":["分销","分设","初年","初时"],"answer_index":0,"explanation":"分销 = Phân phối"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","med