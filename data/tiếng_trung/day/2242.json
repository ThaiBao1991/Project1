ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_71ffadbd","audio_ref":"m_369aee87","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5a996802"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Đại từ 私 (watashi)","level":"N5","explanation":"Từ chỉ tự ngôn: 私 / 僕・俺 (nam) / 私たち.","examples":[{"sentence":"私は田中です。","meaning_vi":"Tôi là Tanaka."}],"pronunciation_focus":"私 = watashi.","common_mistakes":"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2242","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"若想を 使います。","line_vi":"Tôi dùng 若想.","focus_words":["若想"]},{"speaker":"B","line_target":"获颁 は 何ですか。","line_vi":"获颁 là cái gì?","focus_words":["获颁"]},{"speaker":"A","line_target":"菲斯です。","line_vi":"Đó là 菲斯.","focus_words":["菲斯"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7b9703bb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「若想」 có nghĩa là gì?","options":["Nếu bạn muốn","được trao giải","Fez","trái cây và rau quả"],"answer_index":0,"explanation":"若想 = Nếu bạn muốn"},{"question":"Từ 「获颁」 có nghĩa là gì?","options":["được trao giải","Nếu bạn muốn","Fez","trái cây và rau quả"],"answer_index":0,"explanation":"获颁 = được trao giải"},{"question":"Từ 「菲斯」 có nghĩa là gì?","options":["Fez","Nếu bạn muốn","được trao giải","trái cây và rau quả"],"answer_index":0,"explanation":"菲斯 = Fez"},{"question":"Từ 「蔬果」 có nghĩa là gì?","options":["trái cây và rau quả","Nếu bạn muốn","được trao giải","Fez"],"answer_index":0,"explanation":"蔬果 = trái cây và rau quả"},{"question":"Từ 「血流」 có nghĩa là gì?","options":["lưu lượng máu","Nếu bạn muốn","được trao giải","Fez"],"answer_index":0,"explanation":"血流 = lưu lượng máu"},{"question":"Từ 「裁军」 có nghĩa là gì?","options":["giải trừ quân bị","Nếu bạn muốn","được trao giải","Fez"],"answer_index":0,"explanation":"裁军 = giải trừ quân bị"},{"question":"Từ 「西城区」 có nghĩa là gì?","options":["Quận Tây Thành","Nếu bạn muốn","được trao giải","Fez"],"answer_index":0,"explanatio