 việc — Ngày 1240","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吓唬を 使います。","line_vi":"Tôi dùng 吓唬.","focus_words":["吓唬"]},{"speaker":"B","line_target":"唯独 は 何ですか。","line_vi":"唯独 là cái gì?","focus_words":["唯独"]},{"speaker":"A","line_target":"国宝です。","line_vi":"Đó là 国宝.","focus_words":["国宝"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吓唬」 có nghĩa là gì?","options":["sợ hãi","Chỉ","kho báu quốc gia","thùng rác"],"answer_index":0,"explanation":"吓唬 = sợ hãi"},{"question":"Từ 「唯独」 có nghĩa là gì?","options":["Chỉ","sợ hãi","kho báu quốc gia","thùng rác"],"answer_index":0,"explanation":"唯独 = Chỉ"},{"question":"Từ 「国宝」 có nghĩa là gì?","options":["kho báu quốc gia","sợ hãi","Chỉ","thùng rác"],"answer_index":0,"explanation":"国宝 = kho báu quốc gia"},{"question":"Từ 「垃圾桶」 có nghĩa là gì?","options":["thùng rác","sợ hãi","Chỉ","kho báu quốc gia"],"answer_index":0,"explanation":"垃圾桶 = thùng rác"},{"question":"Từ 「塞车」 có nghĩa là gì?","options":["ùn tắc giao thông","sợ hãi","Chỉ","kho báu quốc gia"],"answer_index":0,"explanation":"塞车 = ùn tắc giao thông"},{"question":"Từ 「增速」 có nghĩa là gì?","options":["Tốc độ tăng trưởng","sợ hãi","Chỉ","kho báu quốc gia"],"answer_index":0,"explanation":"增速 = Tốc độ tăng trưởng"},{"question":"Từ 「处方」 có nghĩa là gì?","options":["toa thuốc","sợ hãi","Chỉ","kho báu quốc gia"],"answer_index":0,"explanation":"处方 = toa thuốc"},{"question":"Từ 「外卖」 có nghĩa là gì?","options":["mang đi","sợ hãi","Chỉ","kho báu quốc gia"],"answer_index":0,"explanation":"外卖 = mang đi"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: sợ hãi","options":["吓唬","唯独","国宝","垃圾桶"],"answer_index":0,"explanation":"吓唬 = sợ hãi"},{"question":"Chọn từ đúng cho nghĩa: Chỉ","options":["唯独","吓唬","国宝","垃圾