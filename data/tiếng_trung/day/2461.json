泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2461","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"南朝鲜を 使います。","line_vi":"Tôi dùng 南朝鲜.","focus_words":["南朝鲜"]},{"speaker":"B","line_target":"卫生院 は 何ですか。","line_vi":"卫生院 là cái gì?","focus_words":["卫生院"]},{"speaker":"A","line_target":"厚生です。","line_vi":"Đó là 厚生.","focus_words":["厚生"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fa2e3782","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「南朝鲜」 có nghĩa là gì?","options":["Hàn Quốc","trung tâm y tế","Sức khỏe và phúc lợi","tình trạng ban đầu"],"answer_index":0,"explanation":"南朝鲜 = Hàn Quốc"},{"question":"Từ 「卫生院」 có nghĩa là gì?","options":["trung tâm y tế","Hàn Quốc","Sức khỏe và phúc lợi","tình trạng ban đầu"],"answer_index":0,"explanation":"卫生院 = trung tâm y tế"},{"question":"Từ 「厚生」 có nghĩa là gì?","options":["Sức khỏe và phúc lợi","Hàn Quốc","trung tâm y tế","tình trạng ban đầu"],"answer_index":0,"explanation":"厚生 = Sức khỏe và phúc lợi"},{"question":"Từ 「原状」 có nghĩa là gì?","options":["tình trạng ban đầu","Hàn Quốc","trung tâm y tế","Sức khỏe và phúc lợi"],"answer_index":0,"explanation":"原状 = tình trạng ban đầu"},{"question":"Từ 「反战」 có nghĩa là gì?","options":["phản chiến","Hàn Quốc","trung tâm y tế","Sức khỏe và phúc lợi"],"answer_index":0,"explanation":"反战 = phản chiến"},{"question":"Từ 「发霉」 có nghĩa là gì?","options":["bị mốc","Hàn Quố