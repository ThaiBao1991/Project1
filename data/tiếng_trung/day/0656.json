せん。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 656","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"前去を 使います。","line_vi":"Tôi dùng 前去.","focus_words":["前去"]},{"speaker":"B","line_target":"前锋 は 何ですか。","line_vi":"前锋 là cái gì?","focus_words":["前锋"]},{"speaker":"A","line_target":"力学です。","line_vi":"Đó là 力学.","focus_words":["力学"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c5d16ae2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「前去」 có nghĩa là gì?","options":["Đi","tiền đạo","Cơ học","phép chia"],"answer_index":0,"explanation":"前去 = Đi"},{"question":"Từ 「前锋」 có nghĩa là gì?","options":["tiền đạo","Đi","Cơ học","phép chia"],"answer_index":0,"explanation":"前锋 = tiền đạo"},{"question":"Từ 「力学」 có nghĩa là gì?","options":["Cơ học","Đi","tiền đạo","phép chia"],"answer_index":0,"explanation":"力学 = Cơ học"},{"question":"Từ 「区划」 có nghĩa là gì?","options":["phép chia","Đi","tiền đạo","Cơ học"],"answer_index":0,"explanation":"区划 = phép chia"},{"question":"Từ 「十足」 có nghĩa là gì?","options":["đầy đủ","Đi","tiền đạo","Cơ học"],"answer_index":0,"explanation":"十足 = đầy đủ"},{"question":"Từ 「南极」 có nghĩa là gì?","options":["Nam Cực","Đi","tiền đạo","Cơ học"],"answer_index":0,"explanation":"南极 = Nam Cực"},{"question":"Từ 「卡斯」 có nghĩa là gì?","options":["Cass","Đi","tiền đạo","Cơ học"],"answer_index":0,"explanation":"卡斯 = Cass"},{"question":"Từ 「发财」 có nghĩa là gì?","options":["làm giàu","Đi","tiền đạo","Cơ học"],"answer_index":0,"explanation":"发财 = làm giàu"}],