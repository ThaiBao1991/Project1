"example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_289f52e7","audio_ref":"m_ca4c12a1","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_12e7d5a4"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 790","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"得奖を 使います。","line_vi":"Tôi dùng 得奖.","focus_words":["得奖"]},{"speaker":"B","line_target":"微生物 は 何ですか。","line_vi":"微生物 là cái gì?","focus_words":["微生物"]},{"speaker":"A","line_target":"急需です。","line_vi":"Đó là 急需.","focus_words":["急需"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_599b7286","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「得奖」 có nghĩa là gì?","options":["Chiến thắng","Vi sinh vật","cần gấp","vách đá"],"answer_index":0,"explanation":"得奖 = Chiến thắng"},{"question":"Từ 「微生物」 có nghĩa là gì?","options":["Vi sinh vật","Chiến thắng","cần gấp","vách đá"],"answer_index":0,"explanation":"微生物 = Vi sinh vật"},{"question":"Từ 「急需」 có nghĩa là gì?","options":["cần gấp","Chiến thắng","Vi sinh vật","vách đá"],"answer_index":0,"explanation":"急需 = cần gấp"},{"question":"Từ 「悬崖」 có nghĩa là gì?","options":["vách đá","Chiến thắng","Vi sinh vật","cần gấp"],"answer_index":0,"explanation":"悬崖 = vách đá"},{"question":"Từ 「惨案」 có nghĩa là gì?","options":["Bi kịch","Chiến thắng","Vi sinh vật","cần gấp"],"answer_index":0,"explanation":"惨案 = Bi kịch"},{"question":"Từ 「戒指」 có nghĩa là gì?","options":["chiếc nhẫn","Chiến thắng","Vi sinh vật","cần gấp"],"answer_index":0,"explanation":"戒指 = chiếc nhẫn"},{"question":"Từ 「房租」 có nghĩa là gì?","options":["thuê","Chiến thắng","Vi sinh vật","cần gấp"],"answer_index":0,"explanation":"房租 = thuê"},{"question":"Từ 「打招呼」 có nghĩa là gì?","options":["nói xin chào","Chiến thắng","Vi sinh vật","cần gấp"],"answer_index":0,"expl