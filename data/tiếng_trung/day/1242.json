りです。","meaning_vi":"Ngày nào cũng chỉ chơi game."},{"sentence":"何も食べないばかりの生活。","meaning_vi":"Cuộc sống chỉ biết không ăn gì."}],"pronunciation_focus":"〜ばかり = cứ toàn làm.","common_mistakes":"Đừng dùng ばかり với số lượng lớn (⇒ たくさん).","mini_quiz":[{"question":"毎日ゲーム___。","options":["ばかり","だけ","しか"],"answer_index":0,"explanation":"Đáp án: ばかり"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1242","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"媒体报道を 使います。","line_vi":"Tôi dùng 媒体报道.","focus_words":["媒体报道"]},{"speaker":"B","line_target":"字形 は 何ですか。","line_vi":"字形 là cái gì?","focus_words":["字形"]},{"speaker":"A","line_target":"安倍です。","line_vi":"Đó là 安倍.","focus_words":["安倍"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_210a76df","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「媒体报道」 có nghĩa là gì?","options":["báo cáo phương tiện truyền thông","hình tượng","Abe","hạn ngạch"],"answer_index":0,"explanation":"媒体报道 = báo cáo phương tiện truyền thông"},{"question":"Từ 「字形」 có nghĩa là gì?","options":["hình tượng","báo cáo phương tiện truyền thông","Abe","hạn ngạch"],"answer_index":0,"explanation":"字形 = hình tượng"},{"question":"Từ 「安倍」 có nghĩa là gì?","options":["Abe","báo cáo phương tiện truyền thông","hình tượng","hạn ngạch"],"answer_index":0,"explanation":"安倍 = Abe"},{"question":"Từ 「定额」 có nghĩa là gì?","options":["hạn ngạch","báo cáo phương tiện truyền thông","hình tượng","Abe"],"answer_index":0,"explanation":"定额 = hạn ngạch"},{"question":"Từ 「小伙」 có nghĩa là gì?","options":["chàng trai trẻ","báo cáo phương tiện truyền thông","hình tượng","Abe"],"answer_index":0,"explanation":"小伙 = chàng trai trẻ"},{"question":"Từ 「崇尚」 có nghĩa là gì?","options":["Người biện hộ","báo cáo phương tiện truyền thông","hình tượng","Abe"],"answer