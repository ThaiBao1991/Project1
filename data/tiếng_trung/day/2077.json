ka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2077","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"华美を 使います。","line_vi":"Tôi dùng 华美.","focus_words":["华美"]},{"speaker":"B","line_target":"单亲 は 何ですか。","line_vi":"单亲 là cái gì?","focus_words":["单亲"]},{"speaker":"A","line_target":"卖命です。","line_vi":"Đó là 卖命.","focus_words":["卖命"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f51e43de","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「华美」 có nghĩa là gì?","options":["tuyệt đẹp","cha mẹ đơn thân","làm việc chăm chỉ","Đại học Nam Khai"],"answer_index":0,"explanation":"华美 = tuyệt đẹp"},{"question":"Từ 「单亲」 có nghĩa là gì?","options":["cha mẹ đơn thân","tuyệt đẹp","làm việc chăm chỉ","Đại học Nam Khai"],"answer_index":0,"explanation":"单亲 = cha mẹ đơn thân"},{"question":"Từ 「卖命」 có nghĩa là gì?","options":["làm việc chăm chỉ","tuyệt đẹp","cha mẹ đơn thân","Đại học Nam Khai"],"answer_index":0,"explanation":"卖命 = làm việc chăm chỉ"},{"question":"Từ 「南开大学」 có nghĩa là gì?","options":["Đại học Nam Khai","tuyệt đẹp","cha mẹ đơn thân","làm việc chăm chỉ"],"answer_index":0,"explanation":"南开大学 = Đại học Nam Khai"},{"question":"Từ 「历史博物馆」 có nghĩa là gì?","options":["bảo tàng lịch sử","tuyệt đẹp","cha mẹ đơn thân","làm việc chăm chỉ"],"answer_index":0,"explanation":"历史博物馆 = bảo tàng lịch sử"},{"question":"Từ 「历法」 có nghĩa là gì?","options":["Lịch","tuyệt đẹp","cha mẹ đơn thân","làm việc chăm chỉ"],"answer_index":0,"explanation":"历法 = Lịch"}