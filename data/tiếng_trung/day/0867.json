unciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 867","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"神经病を 使います。","line_vi":"Tôi dùng 神经病.","focus_words":["神经病"]},{"speaker":"B","line_target":"秘诀 は 何ですか。","line_vi":"秘诀 là cái gì?","focus_words":["秘诀"]},{"speaker":"A","line_target":"糊涂です。","line_vi":"Đó là 糊涂.","focus_words":["糊涂"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5270759e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「神经病」 có nghĩa là gì?","options":["bệnh thần kinh","bí mật","bối rối","nhà tưởng niệm"],"answer_index":0,"explanation":"神经病 = bệnh thần kinh"},{"question":"Từ 「秘诀」 có nghĩa là gì?","options":["bí mật","bệnh thần kinh","bối rối","nhà tưởng niệm"],"answer_index":0,"explanation":"秘诀 = bí mật"},{"question":"Từ 「糊涂」 có nghĩa là gì?","options":["bối rối","bệnh thần kinh","bí mật","nhà tưởng niệm"],"answer_index":0,"explanation":"糊涂 = bối rối"},{"question":"Từ 「纪念馆」 có nghĩa là gì?","options":["nhà tưởng niệm","bệnh thần kinh","bí mật","bối rối"],"answer_index":0,"explanation":"纪念馆 = nhà tưởng niệm"},{"question":"Từ 「耽误」 có nghĩa là gì?","options":["sự chậm trễ","bệnh thần kinh","bí mật","bối rối"],"answer_index":0,"explanation":"耽误 = sự chậm trễ"},{"question":"Từ 「肢体」 có nghĩa là gì?","options":["tay chân","bệnh thần kinh","bí mật","bối rối"],"answer_index":0,"explanation":"肢体 = tay chân"},{"question":"Từ 「肥料」 có nghĩa là gì?","options":["Phân bón","bệnh thần kinh","bí mật","bối rối"],"answer_index":0,"explanation":"肥料 = Phân bón"},{"question":"Từ 「肯尼亚」 có nghĩa là gì?","optio