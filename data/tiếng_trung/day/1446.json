evel":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1446","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"万象を 使います。","line_vi":"Tôi dùng 万象.","focus_words":["万象"]},{"speaker":"B","line_target":"不丹 は 何ですか。","line_vi":"不丹 là cái gì?","focus_words":["不丹"]},{"speaker":"A","line_target":"不感兴趣です。","line_vi":"Đó là 不感兴趣.","focus_words":["不感兴趣"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3d3f3ec2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「万象」 có nghĩa là gì?","options":["Viêng Chăn","Bhutan","không quan tâm","Không xứng đáng"],"answer_index":0,"explanation":"万象 = Viêng Chăn"},{"question":"Từ 「不丹」 có nghĩa là gì?","options":["Bhutan","Viêng Chăn","không quan tâm","Không xứng đáng"],"answer_index":0,"explanation":"不丹 = Bhutan"},{"question":"Từ 「不感兴趣」 có nghĩa là gì?","options":["không quan tâm","Viêng Chăn","Bhutan","Không xứng đáng"],"answer_index":0,"explanation":"不感兴趣 = không quan tâm"},{"question":"Từ 「不配」 có nghĩa là gì?","options":["Không xứng đáng","Viêng Chăn","Bhutan","không quan tâm"],"answer_index":0,"explanation":"不配 = Không xứng đáng"},{"question":"Từ 「专业人士」 có nghĩa là gì?","options":["chuyên gia","Viêng Chăn","Bhutan","không quan tâm"],"answer_index":0,"explanation":"专业人士 = chuyên gia"},{"question