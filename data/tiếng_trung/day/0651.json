uân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 651","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"胜出を 使います。","line_vi":"Tôi dùng 胜出.","focus_words":["胜出"]},{"speaker":"B","line_target":"脸书 は 何ですか。","line_vi":"脸书 là cái gì?","focus_words":["脸书"]},{"speaker":"A","line_target":"自有です。","line_vi":"Đó là 自有.","focus_words":["自有"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a7d819d4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「胜出」 có nghĩa là gì?","options":["thắng","Facebook","sở hữu","lây lan"],"answer_index":0,"explanation":"胜出 = thắng"},{"question":"Từ 「脸书」 có nghĩa là gì?","options":["Facebook","thắng","sở hữu","lây lan"],"answer_index":0,"explanation":"脸书 = Facebook"},{"question":"Từ 「自有」 có nghĩa là gì?","options":["sở hữu","thắng","Facebook","lây lan"],"answer_index":0,"explanation":"自有 = sở hữu"},{"question":"Từ 「蔓延」 có nghĩa là gì?","options":["lây lan","thắng","Facebook","sở hữu"],"answer_index":0,"explanation":"蔓延 = lây lan"},{"question":"Từ 「血管」 có nghĩa là gì?","options":["mạch máu","thắng","Facebook","sở hữu"],"answer_index":0,"explanation":"血管 = mạch máu"},{"question":"Từ 「裸体」 có nghĩa là gì?","options":["khỏa thân","thắng","Facebook","sở hữu"],"answer_index":0,"explanation":"裸体 = khỏa thân"},{"question":"Từ 「订阅」 có nghĩa là gì?","options":["Đăng ký","thắng","Facebook","sở hữu"],"answer_index":0,"explanation":"订阅 = Đăng ký"},{"question":"Từ 「让步」 có nghĩa là gì?","options":["nhượng bộ","thắng","Facebook","sở hữu"],"answer_index":0,"explanation":"让步 = như