N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 709","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"无耻を 使います。","line_vi":"Tôi dùng 无耻.","focus_words":["无耻"]},{"speaker":"B","line_target":"无能为力 は 何ですか。","line_vi":"无能为力 là cái gì?","focus_words":["无能为力"]},{"speaker":"A","line_target":"无非です。","line_vi":"Đó là 无非.","focus_words":["无非"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5e036eb6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「无耻」 có nghĩa là gì?","options":["không biết xấu hổ","bất lực","Không có gì hơn","dễ dàng"],"answer_index":0,"explanation":"无耻 = không biết xấu hổ"},{"question":"Từ 「无能为力」 có nghĩa là gì?","options":["bất lực","không biết xấu hổ","Không có gì hơn","dễ dàng"],"answer_index":0,"explanation":"无能为力 = bất lực"},{"question":"Từ 「无非」 có nghĩa là gì?","options":["Không có gì hơn","không biết xấu hổ","bất lực","dễ dàng"],"answer_index":0,"explanation":"无非 = Không có gì hơn"},{"question":"Từ 「易于」 có nghĩa là gì?","options":["dễ dàng","không biết xấu hổ","bất lực","Không có gì hơn"],"answer_index":0,"explanation":"易于 = dễ dàng"},{"question":"Từ 「星期二」 có nghĩa là gì?","options":["thứ ba","không biết xấu hổ","bất lực","Không có gì hơn"],"answer_index":0,"explanation":"星期二 = thứ ba"},{"question":"Từ 「暑