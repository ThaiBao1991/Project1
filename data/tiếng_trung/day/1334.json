s":[{"speaker":"A","line_target":"愈演愈烈を 使います。","line_vi":"Tôi dùng 愈演愈烈.","focus_words":["愈演愈烈"]},{"speaker":"B","line_target":"意境 は 何ですか。","line_vi":"意境 là cái gì?","focus_words":["意境"]},{"speaker":"A","line_target":"成像です。","line_vi":"Đó là 成像.","focus_words":["成像"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「愈演愈烈」 có nghĩa là gì?","options":["trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh","hình thành"],"answer_index":0,"explanation":"愈演愈烈 = trở nên tồi tệ hơn"},{"question":"Từ 「意境」 có nghĩa là gì?","options":["quan niệm nghệ thuật","trở nên tồi tệ hơn","hình ảnh","hình thành"],"answer_index":0,"explanation":"意境 = quan niệm nghệ thuật"},{"question":"Từ 「成像」 có nghĩa là gì?","options":["hình ảnh","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình thành"],"answer_index":0,"explanation":"成像 = hình ảnh"},{"question":"Từ 「成形」 có nghĩa là gì?","options":["hình thành","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh"],"answer_index":0,"explanation":"成形 = hình thành"},{"question":"Từ 「批次」 có nghĩa là gì?","options":["lô","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh"],"answer_index":0,"explanation":"批次 = lô"},{"question":"Từ 「抬高」 có nghĩa là gì?","options":["nâng cao","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh"],"answer_index":0,"explanation":"抬高 = nâng cao"},{"question":"Từ 「拉夫」 có nghĩa là gì?","options":["xổ số","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh"],"answer_index":0,"explanation":"拉夫 = xổ số"},{"question":"Từ 「拍拍」 có nghĩa là gì?","options":["vỗ về","trở nên tồi tệ hơn","quan niệm nghệ thuật","hình ảnh"],"answer_index":0,"explanation":"拍拍 = vỗ về"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: trở nên tồi tệ hơn","options":["愈演愈烈","意境","成像","成形"],"answer_index":0,"explanation":"愈演愈烈 = trở nên tồi tệ hơn"}