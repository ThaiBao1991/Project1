y mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2474","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"爱滋病を 使います。","line_vi":"Tôi dùng 爱滋病.","focus_words":["爱滋病"]},{"speaker":"B","line_target":"爱神 は 何ですか。","line_vi":"爱神 là cái gì?","focus_words":["爱神"]},{"speaker":"A","line_target":"爵士乐です。","line_vi":"Đó là 爵士乐.","focus_words":["爵士乐"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bbcb9303","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「爱滋病」 có nghĩa là gì?","options":["bệnh AIDS","thần tình yêu","nhạc jazz","bố"],"answer_index":0,"explanation":"爱滋病 = bệnh AIDS"},{"question":"Từ 「爱神」 có nghĩa là gì?","options":["thần tình yêu","bệnh AIDS","nhạc jazz","bố"],"answer_index":0,"explanation":"爱神 = thần tình yêu"},{"question":"Từ 「爵士乐」 có nghĩa là gì?","options":["nhạc jazz","bệnh AIDS","thần tình yêu","bố"],"answer_index":0,"explanation":"爵士乐 = nhạc jazz"},{"question":"Từ 「父王」 có nghĩa là gì?","options":["bố","bệnh AIDS","thần tình yêu","nhạc jazz"],"answer_index":0,"explanation":"父王 = bố"},{"question":"Từ 「爷们」 có nghĩa là gì?","options":["người đàn ông","bệnh AIDS","thần tình yêu","nhạc jazz"],"answer_index":0,"explanation":"爷们 = người đàn ông"},{"question":"Từ 「特勤」 có nghĩa là gì?","options":["dịch vụ bí mật","bệnh AIDS","thần tình yêu","nhạc jazz"],"answer_index":0,"explanation":"特勤 = dịch vụ bí mật"},{"question":"Từ 「玛莉」 có nghĩa là gì?","options":["Mary","bệnh AIDS","thần tình yêu","nhạc jazz"],"answer_index":0,"explanation":"玛莉 = Mary"},{"question":"Từ 「理睬」 có nghĩa là gì?","options":["Chấp nhận","bệnh A