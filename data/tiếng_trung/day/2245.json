び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2245","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"送命を 使います。","line_vi":"Tôi dùng 送命.","focus_words":["送命"]},{"speaker":"B","line_target":"遗存 は 何ですか。","line_vi":"遗存 là cái gì?","focus_words":["遗存"]},{"speaker":"A","line_target":"酒杯です。","line_vi":"Đó là 酒杯.","focus_words":["酒杯"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_78a17a63","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「送命」 có nghĩa là gì?","options":["chết","còn lại","ly rượu","sự đau nhức"],"answer_index":0,"explanation":"送命 = chết"},{"question":"Từ 「遗存」 có nghĩa là gì?","options":["còn lại","chết","ly rượu","sự đau nhức"],"answer_index":0,"explanation":"遗存 = còn lại"},{"question":"Từ 「酒杯」 có nghĩa là gì?","options":["ly rượu","chết","còn lại","sự đau nhức"],"answer_index":0,"explanation":"酒杯 = ly rượu"},{"question":"Từ 「酸痛」 có nghĩa là gì?","options":["sự đau nhức","chết","còn lại","ly rượu"],"answer_index":0,"explanation":"酸痛 = sự đau nhức"},{"question":"Từ 「重构」 có nghĩa là gì?","options":["Tái cấu trúc","chết","còn lại","ly rượu"],"answer_index":0,"explanation":"重构 = Tái cấu trúc"},{"question":"Từ 「量子力学」 có nghĩa là gì?","options":["cơ học lượng tử","chết","còn lại","ly rượu"],"answer_index":0,"explanation":"量子力学 = cơ học lượng tử"},{"question":"Từ 「金价」 có nghĩa là gì?","options":["giá vàng","chết","còn lại","ly rượu"],"answer_index":0,"explanation":"金价 = giá vàng"},{"question":"Từ 「金钱豹」 có nghĩa là gì?","options":["báo","chết","còn lại","ly rượu"],"answer_index":0,"explanation":"金钱豹 = báo"}],"pattern":[{"question":"Chọn từ đúng