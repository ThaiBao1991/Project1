":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_8340117b","audio_ref":"m_20de5646","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_10f631df"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 823","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"荒唐を 使います。","line_vi":"Tôi dùng 荒唐.","focus_words":["荒唐"]},{"speaker":"B","line_target":"荣幸 は 何ですか。","line_vi":"荣幸 là cái gì?","focus_words":["荣幸"]},{"speaker":"A","line_target":"行销です。","line_vi":"Đó là 行销.","focus_words":["行销"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_915360fc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「荒唐」 có nghĩa là gì?","options":["lố bịch","được vinh danh","Tiếp thị","Thức tỉnh"],"answer_index":0,"explanation":"荒唐 = lố bịch"},{"question":"Từ 「荣幸」 có nghĩa là gì?","options":["được vinh danh","lố bịch","Tiếp thị","Thức tỉnh"],"answer_index":0,"explanation":"荣幸 = được vinh danh"},{"question":"Từ 「行销」 có nghĩa là gì?","options":["Tiếp thị","lố bịch","được vinh danh","Thức tỉnh"],"answer_index":0,"explanation":"行销 = Tiếp thị"},{"question":"Từ 「觉悟」 có nghĩa là gì?","options":["Thức tỉnh","lố bịch","được vinh danh","Tiếp thị"],"answer_index":0,"explanation":"觉悟 = Thức tỉnh"},{"question":"Từ 「解救」 có nghĩa là gì?","options":["giải cứu","lố bịch","được vinh danh","Tiếp thị"],"answer_index":0,"explanation":"解救 = giải cứu"},{"question":"Từ 「请来」 có nghĩa là gì?","options":["làm ơn đến","lố bịch","được vinh danh","Tiếp thị"],"answer_index":0,"explanation":"请来 = làm ơn đến"},{"question":"Từ 「课本」 có nghĩa là gì?","options":["sách giáo khoa","lố bịch","được vinh danh","Tiếp thị"],"answer_index":0,"explanation":"课本 = sách giáo khoa"},{"question":"Từ 「负荷」 có nghĩa là gì?","options":["Tải","lố bịch","được vinh danh","Tiếp thị"]