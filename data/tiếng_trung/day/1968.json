ence":"月曜日より土曜日の方が楽しい。","meaning_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1968","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"自定义を 使います。","line_vi":"Tôi dùng 自定义.","focus_words":["自定义"]},{"speaker":"B","line_target":"舒缓 は 何ですか。","line_vi":"舒缓 là cái gì?","focus_words":["舒缓"]},{"speaker":"A","line_target":"艾迪です。","line_vi":"Đó là 艾迪.","focus_words":["艾迪"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_33e0a335","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「自定义」 có nghĩa là gì?","options":["Tùy chỉnh","êm dịu","Eddie","Mậu Danh"],"answer_index":0,"explanation":"自定义 = Tùy chỉnh"},{"question":"Từ 「舒缓」 có nghĩa là gì?","options":["êm dịu","Tùy chỉnh","Eddie","Mậu Danh"],"answer_index":0,"explanation":"舒缓 = êm dịu"},{"question":"Từ 「艾迪」 có nghĩa là gì?","options":["Eddie","Tùy chỉnh","êm dịu","Mậu Danh"],"answer_index":0,"explanation":"艾迪 = Eddie"},{"question":"Từ 「茂名」 có nghĩa là gì?","options":["Mậu Danh","Tùy chỉnh","êm dịu","Eddie"],"answer_index":0,"explanation":"茂名 = Mậu Danh"},{"question":"Từ 「荷马」 có nghĩa là gì?","options":["Homer","Tùy chỉnh","êm dịu","Eddie"],"answer_index":0,"explanation":"荷马 = Homer"},{"question":"Từ 「蒸气」 có nghĩa là gì?","options":["hơi nước","Tùy chỉnh","êm dịu","Eddie"],"answer_index":0,"explanation":"蒸气 = hơi nước"},{"question":"Từ 「血糖」 có nghĩa là gì?","options":["lượng đường trong máu","Tùy chỉnh","êm dịu","Eddie"],"answer_index":0,"explanation":"血糖 = lượng đường trong máu"},{"question":"Từ 「表演者」 có nghĩa là gì?","options":["người