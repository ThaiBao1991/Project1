i sẽ ghé quý vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1421","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"下注を 使います。","line_vi":"Tôi dùng 下注.","focus_words":["下注"]},{"speaker":"B","line_target":"不正 は 何ですか。","line_vi":"不正 là cái gì?","focus_words":["不正"]},{"speaker":"A","line_target":"世事です。","line_vi":"Đó là 世事.","focus_words":["世事"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_32e9c4f6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「下注」 có nghĩa là gì?","options":["Đặt cược","không đúng cách","chuyện thế gian","Người trong ngành"],"answer_index":0,"explanation":"下注 = Đặt cược"},{"question":"Từ 「不正」 có nghĩa là gì?","options":["không đúng cách","Đặt cược","chuyện thế gian","Người trong ngành"],"answer_index":0,"explanation":"不正 = không đúng cách"},{"question":"Từ 「世事」 có nghĩa là gì?","options":["chuyện thế gian","Đặt cược","không đúng cách","Người trong ngành"],"answer_index":0,"explanation":"世事 = chuyện thế gian"},{"question":"Từ 「业内人士」 có nghĩa là gì?","options":["Người trong ngành","Đặt cược","không đúng cách","chuyện thế gian"],"answer_index":0,"explanation":"业内人士 = Người trong ngành"},{"question":"Từ 「东面」 có nghĩa là gì?","options":["Đông","Đặt cược","không đúng cách","chuyện thế gian"],"answer_index":0,"explanation":"东面 = Đông"},{"question":"Từ 「两党」 có nghĩa là gì?","options":["hai bên","Đặt cược","không đúng cách","chuyện thế gian"],"answer_index":0,"explanation":"两党 = hai bên"},{"