:"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4af15cda","audio_ref":"m_2e1edee2","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f5dea7a0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 449","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"富裕を 使います。","line_vi":"Tôi dùng 富裕.","focus_words":["富裕"]},{"speaker":"B","line_target":"尺度 は 何ですか。","line_vi":"尺度 là cái gì?","focus_words":["尺度"]},{"speaker":"A","line_target":"巧克力です。","line_vi":"Đó là 巧克力.","focus_words":["巧克力"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_51bd8cbc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「富裕」 có nghĩa là gì?","options":["giàu có","quy mô","sô cô la","Anh chàng đẹp trai"],"answer_index":0,"explanation":"富裕 = giàu có"},{"question":"Từ 「尺度」 có nghĩa là gì?","options":["quy mô","giàu có","sô cô la","Anh chàng đẹp trai"],"answer_index":0,"explanation":"尺度 = quy mô"},{"question":"Từ 「巧克力」 có nghĩa là gì?","options":["sô cô la","giàu có","quy mô","Anh chàng đẹp trai"],"answer_index":0,"explanation":"巧克力 = sô cô la"},{"question":"Từ 「帅哥」 có nghĩa là gì?","options":["Anh chàng đẹp trai","giàu có","quy mô","sô cô la"],"answer_index":0,"explanation":"帅哥 = Anh chàng đẹp trai"},{"question":"Từ 「幽默」 có nghĩa là gì?","options":["hài hước","giàu có","quy mô","sô cô la"],"answer_index":0,"explanation":"幽默 = hài hước"},{"question":"Từ 「广阔」 có nghĩa là gì?","options":["rộng lớn","giàu có","quy mô","sô cô la"],"answer_index":0,"explanation":"广阔 = rộng lớn"},{"question":"Từ 「底下」 có nghĩa là gì?","options":["đáy","giàu có","quy mô","sô cô la"],"answer_index":0,"explanation":"底下 = đáy"},{"question":"Từ 「成交」 có nghĩa là gì?","options":["thỏa thuận","giàu có","quy mô","sô cô la"],"answer_index":0,"explanat