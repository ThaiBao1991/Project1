."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 829","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"剪辑を 使います。","line_vi":"Tôi dùng 剪辑.","focus_words":["剪辑"]},{"speaker":"B","line_target":"力求 は 何ですか。","line_vi":"力求 là cái gì?","focus_words":["力求"]},{"speaker":"A","line_target":"华南です。","line_vi":"Đó là 华南.","focus_words":["华南"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e956903d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「剪辑」 có nghĩa là gì?","options":["cái kẹp","phấn đấu để","Nam Trung Quốc","mại dâm"],"answer_index":0,"explanation":"剪辑 = cái kẹp"},{"question":"Từ 「力求」 có nghĩa là gì?","options":["phấn đấu để","cái kẹp","Nam Trung Quốc","mại dâm"],"answer_index":0,"explanation":"力求 = phấn đấu để"},{"question":"Từ 「华南」 có nghĩa là gì?","options":["Nam Trung Quốc","cái kẹp","phấn đấu để","mại dâm"],"answer_index":0,"explanation":"华南 = Nam Trung Quốc"},{"question":"Từ 「卖淫」 có nghĩa là gì?","options":["mại dâm","cái kẹp","phấn đấu để","Nam Trung Quốc"],"answer_index":0,"explanation":"卖淫 = mại dâm"},{"question":"Từ 「印度人」 có nghĩa là gì?","options":["người Ấn Độ","cái kẹp","phấn đấu để","Nam Trung Quốc"],"answer_index":0,"explanation":"印度人 = người Ấn Độ"},{"question":"Từ 「厂房」 có nghĩa là gì?","options":["Xây dựng nhà xưởng","cái kẹp","phấn đấu để","Nam Trung Quốc"],"answer_index":0,"explanation":"厂房 = Xây dựng nhà xưởng"},{"question":"Từ 「发病」 có nghĩa là gì?","options":["khởi đầu","cái kẹp","phấn đấu để","Nam Trung Quốc"],"answer_index":0,"explanation":"发病 = khởi đầu"},{"question":"Từ 「叙