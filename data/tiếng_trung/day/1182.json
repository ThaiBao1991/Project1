netic_note":"","syllables":[],"image_ref":"m_451c50f7","audio_ref":"m_3e9b0a79","meaning_audio_ref":"m_22582ad6","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1182","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"推移を 使います。","line_vi":"Tôi dùng 推移.","focus_words":["推移"]},{"speaker":"B","line_target":"收复 は 何ですか。","line_vi":"收复 là cái gì?","focus_words":["收复"]},{"speaker":"A","line_target":"攻克です。","line_vi":"Đó là 攻克.","focus_words":["攻克"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e543332d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「推移」 có nghĩa là gì?","options":["di chuyển","lấy lại","chinh phục","chính trị"],"answer_index":0,"explanation":"推移 = di chuyển"},{"question":"Từ 「收复」 có nghĩa là gì?","options":["lấy lại","di chuyển","chinh phục","chính trị"],"answer_index":0,"explanation":"收复 = lấy lại"},{"question":"Từ 「攻克」 có nghĩa là gì?","options":["chinh phục","di chuyển","lấy lại","chính trị"],"answer_index":0,"explanation":"攻克 = chinh phục"},{"question":"Từ 「政界」 có nghĩa là gì?","options":["chính trị","di chuyển","lấy lại","chinh phục"],"answer_index":0,"explanation":"政界 = chính trị"},{"question":"Từ 「救命」 có nghĩa là gì?","options":["Trợ giúp","di chuyển","lấy lại","chinh phục"],"answer_index":0,"explanation":"救命 = Trợ giúp"},{"question":"Từ 「教书」 có nghĩa là gì?","options":["dạy","di chuyển","lấy lại","chinh phục"],"answer_index":0,"explanation":"教书 = dạy"},{"question":"Từ 「敬畏」 có nghĩa là gì?","options":["kinh ngạc","di chuyển","lấy lại","chinh phục"],"answer_index":0,"explanation":"敬畏 = kinh ngạc"},{"question":"Từ 「整数」 có nghĩa là gì?","options":["số nguyên