。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1222","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"拉克を 使います。","line_vi":"Tôi dùng 拉克.","focus_words":["拉克"]},{"speaker":"B","line_target":"推算 は 何ですか。","line_vi":"推算 là cái gì?","focus_words":["推算"]},{"speaker":"A","line_target":"搜狗です。","line_vi":"Đó là 搜狗.","focus_words":["搜狗"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1ce2ffc0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「拉克」 có nghĩa là gì?","options":["Lạc","ngoại suy","Sogou","đánh đu"],"answer_index":0,"explanation":"拉克 = Lạc"},{"question":"Từ 「推算」 có nghĩa là gì?","options":["ngoại suy","Lạc","Sogou","đánh đu"],"answer_index":0,"explanation":"推算 = ngoại suy"},{"question":"Từ 「搜狗」 có nghĩa là gì?","options":["Sogou","Lạc","ngoại suy","đánh đu"],"answer_index":0,"explanation":"搜狗 = Sogou"},{"question":"Từ 「摇摆」 có nghĩa là gì?","options":["đánh đu","Lạc","ngoại suy","Sogou"],"answer_index":0,"explanation":"摇摆 = đánh đu"},{"question":"Từ 「效用」 có nghĩa là gì?","options":["tiện ích","Lạc","ngoại suy","Sogou"],"answer_index":0,"explanation":"效用 = tiện ích"},{"question":"Từ 「斯巴达」 có nghĩa là gì?","options":["Sparta","Lạc","ngoại suy","Sogou"],"answer_index":0,"explanation":"斯巴达 = Sparta"},{"question":"Từ 「新郎」 có nghĩa là gì?","options":["chú rể","Lạc","ngoại suy","Sogou"],"answer_index":0,"explanation":"新郎 = chú rể"},{"question":"Từ 「无关紧要」 có nghĩa là gì?","options":["không quan trọng","Lạc","ngoại suy","Sogou"],"answer_index":0,"explanation":"无关紧