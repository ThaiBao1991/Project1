],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_3ca7327f","audio_ref":"m_a5465117","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ee75cbe0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1901","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"水道を 使います。","line_vi":"Tôi dùng 水道.","focus_words":["水道"]},{"speaker":"B","line_target":"汉文 は 何ですか。","line_vi":"汉文 là cái gì?","focus_words":["汉文"]},{"speaker":"A","line_target":"泄密です。","line_vi":"Đó là 泄密.","focus_words":["泄密"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_af5285f5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「水道」 có nghĩa là gì?","options":["đường thuỷ","Tiếng Trung","Rò rỉ","Luật học"],"answer_index":0,"explanation":"水道 = đường thuỷ"},{"question":"Từ 「汉文」 có nghĩa là gì?","options":["Tiếng Trung","đường thuỷ","Rò rỉ","Luật học"],"answer_index":0,"explanation":"汉文 = Tiếng Trung"},{"question":"Từ 「泄密」 có nghĩa là gì?","options":["Rò rỉ","đường thuỷ","Tiếng Trung","Luật học"],"answer_index":0,"explanation":"泄密 = Rò rỉ"},{"question":"Từ 「法理」 có nghĩa là gì?","options":["Luật học","đường thuỷ","Tiếng Trung","Rò rỉ"],"answer_index":0,"explanation":"法理 = Luật học"},{"question":"Từ 「洗涤」 có nghĩa là gì?","options":["rửa","đường thuỷ","Tiếng Trung","Rò rỉ"],"answer_index":0,"explanation":"洗涤 = rửa"},{"question":"Từ 「海贼」 có nghĩa là gì?","options":["cướp biển","đường thuỷ","Tiếng Trung","Rò rỉ"],"answer_index":0,"explanation":"海贼 = cướp biển"},{"question":"Từ 「消退」 có nghĩa là gì?","options":["lắng xuống","đường thuỷ","Tiếng Trung","Rò rỉ"],"answer_index":0,"explanation":"消退 = lắng xuống"},{"question":"Từ 「淫妻」 có nghĩa là gì?","options":["v