_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_cc68c634","audio_ref":"m_50da7bd6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e9477952"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 984","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"动静を 使います。","line_vi":"Tôi dùng 动静.","focus_words":["动静"]},{"speaker":"B","line_target":"北宋 は 何ですか。","line_vi":"北宋 là cái gì?","focus_words":["北宋"]},{"speaker":"A","line_target":"北非です。","line_vi":"Đó là 北非.","focus_words":["北非"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_360e3b09","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「动静」 có nghĩa là gì?","options":["phong trào","Triều đại Bắc Tống","Bắc Phi","hơn mười năm"],"answer_index":0,"explanation":"动静 = phong trào"},{"question":"Từ 「北宋」 có nghĩa là gì?","options":["Triều đại Bắc Tống","phong trào","Bắc Phi","hơn mười năm"],"answer_index":0,"explanation":"北宋 = Triều đại Bắc Tống"},{"question":"Từ 「北非」 có nghĩa là gì?","options":["Bắc Phi","phong trào","Triều đại Bắc Tống","hơn mười năm"],"answer_index":0,"explanation":"北非 = Bắc Phi"},{"question":"Từ 「十几年」 có nghĩa là gì?","options":["hơn mười năm","phong trào","Triều đại Bắc Tống","Bắc Phi"],"answer_index":0,"explanation":"十几年 = hơn mười năm"},{"question":"Từ 「千人」 có nghĩa là gì?","options":["Hàng ngàn người","phong trào","Triều đại Bắc Tống","Bắc Phi"],"answer_index":0,"explanation":"千人 = Hàng ngàn người"},{"question":"Từ 「南通」 có nghĩa là gì?","options":["Nam Thông","phong trào","Triều đại Bắc Tống","Bắc Phi"],"answer_index":0,"explanation":"南通 = Nam Thông"},{"question":"Từ 「双人」 có nghĩa là gì?","options":["Đôi","phong trào