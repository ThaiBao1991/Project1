:[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1673","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"立功を 使います。","line_vi":"Tôi dùng 立功.","focus_words":["立功"]},{"speaker":"B","line_target":"第九届 は 何ですか。","line_vi":"第九届 là cái gì?","focus_words":["第九届"]},{"speaker":"A","line_target":"紫外线です。","line_vi":"Đó là 紫外线.","focus_words":["紫外线"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「立功」 có nghĩa là gì?","options":["Hãy làm công đức phục vụ","ngày 9","tia UV","Ký tự truyền thống Trung Quốc"],"answer_index":0,"explanation":"立功 = Hãy làm công đức phục vụ"},{"question":"Từ 「第九届」 có nghĩa là gì?","options":["ngày 9","Hãy làm công đức phục vụ","tia UV","Ký tự truyền thống Trung Quốc"],"answer_index":0,"explanation":"第九届 = ngày 9"},{"question":"Từ 「紫外线」 có nghĩa là gì?","options":["tia UV","Hãy làm công đức phục vụ","ngày 9","Ký tự truyền thống Trung Quốc"],"answer_index":0,"explanation":"紫外线 = tia UV"},{"question":"Từ 「繁体字」 có nghĩa là gì?","options":["Ký tự truyền thống Trung Quốc","Hãy làm công đức phục vụ","ngày 9","tia UV"],"answer_index":0,"explanation":"繁体字 = Ký tự truyền thống Trung Quốc"},{"question":"Từ 「红外线」 có nghĩa là gì?","options":["Hồng ngoại","Hãy làm công đức phục vụ","ngày 9","tia UV"],"answer_index":0,"explanation":"红外线 = Hồng ngoại"},{"question":"Từ 「结冰」 có nghĩa là gì?","options":["đóng băng","Hãy làm công đức phục vụ","ngày 9","tia UV"],"answer_index":0,"explanation":"结冰 = đóng băng"},{"question":"Từ 「结果显示」 có nghĩa là gì?","options":["Kết quả cho thấy","Hãy làm công đức phục vụ","ngày 9","tia UV"],"answer_index":0,"explanation":"结果显示 = Kết quả cho thấy"},{"question":"Từ 「绝缘」 có nghĩa là gì?","options":["cách nhiệt","Hãy làm công đức p