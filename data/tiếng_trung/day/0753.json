e":"","syllables":[],"image_ref":"m_ae4355db","audio_ref":"m_851e76b9","meaning_audio_ref":"m_e1e933f3","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 753","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"路透社を 使います。","line_vi":"Tôi dùng 路透社.","focus_words":["路透社"]},{"speaker":"B","line_target":"转而 は 何ですか。","line_vi":"转而 là cái gì?","focus_words":["转而"]},{"speaker":"A","line_target":"轻微です。","line_vi":"Đó là 轻微.","focus_words":["轻微"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7e6d6839","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「路透社」 có nghĩa là gì?","options":["Reuters","quay lại","nhẹ","tiến về phía trước"],"answer_index":0,"explanation":"路透社 = Reuters"},{"question":"Từ 「转而」 có nghĩa là gì?","options":["quay lại","Reuters","nhẹ","tiến về phía trước"],"answer_index":0,"explanation":"转而 = quay lại"},{"question":"Từ 「轻微」 có nghĩa là gì?","options":["nhẹ","Reuters","quay lại","tiến về phía trước"],"answer_index":0,"explanation":"轻微 = nhẹ"},{"question":"Từ 「迈进」 có nghĩa là gì?","options":["tiến về phía trước","Reuters","quay lại","nhẹ"],"answer_index":0,"explanation":"迈进 = tiến về phía trước"},{"question":"Từ 「退役」 có nghĩa là gì?","options":["Đã nghỉ hưu","Reuters","quay lại","nhẹ"],"answer_index":0,"explanation":"退役 = Đã nghỉ hưu"},{"question":"Từ 「道教」 có nghĩa là gì?","options":["Đạo giáo","Reuters","quay lại","nhẹ"],"answer_index":0,"explanation":"道教 = Đạo giáo"},{"question":"Từ 「阻挠」 có nghĩa là gì?","options":["cản trở","Reuters","quay lại","nhẹ"],"answer_index":0,"explanation":"阻挠 = cản trở"},{"question":"Từ 「难免」 có