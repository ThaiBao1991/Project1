lanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1272","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"第一夫人を 使います。","line_vi":"Tôi dùng 第一夫人.","focus_words":["第一夫人"]},{"speaker":"B","line_target":"简报 は 何ですか。","line_vi":"简报 là cái gì?","focus_words":["简报"]},{"speaker":"A","line_target":"索取です。","line_vi":"Đó là 索取.","focus_words":["索取"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_484f455f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「第一夫人」 có nghĩa là gì?","options":["đệ nhất phu nhân","Tóm tắt","yêu cầu","đèn đỏ"],"answer_index":0,"explanation":"第一夫人 = đệ nhất phu nhân"},{"question":"Từ 「简报」 có nghĩa là gì?","options":["Tóm tắt","đệ nhất phu nhân","yêu cầu","đèn đỏ"],"answer_index":0,"explanation":"简报 = Tóm tắt"},{"question":"Từ 「索取」 có nghĩa là gì?","options":["yêu cầu","đệ nhất phu nhân","Tóm tắt","đèn đỏ"],"answer_index":0,"explanation":"索取 = yêu cầu"},{"question":"Từ 「红灯」 có nghĩa là gì?","options":["đèn đỏ","đệ nhất phu nhân","Tóm tắt","yêu cầu"],"answer_index":0,"explanation":"红灯 = đèn đỏ"},{"question":"Từ 「经销商」 có nghĩa là gì?","options":["đại lý","đệ nhất phu nhân","Tóm tắt","yêu cầu"],"answer_index":0,"explanation":"经销商 = đại lý"},{"question":"Từ 「维特」 có nghĩa là gì?","options":["Werther","đệ nhất phu nhân","Tóm tắt","yêu cầu"],"answer_index":0,"explanation":"