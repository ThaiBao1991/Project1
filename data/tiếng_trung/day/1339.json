nce":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c9d745a9","audio_ref":"m_f0c7bfe1","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_61db218e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1339","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"牵制を 使います。","line_vi":"Tôi dùng 牵制.","focus_words":["牵制"]},{"speaker":"B","line_target":"玩乐 は 何ですか。","line_vi":"玩乐 là cái gì?","focus_words":["玩乐"]},{"speaker":"A","line_target":"瑕疵です。","line_vi":"Đó là 瑕疵.","focus_words":["瑕疵"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8d9e25ad","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「牵制」 có nghĩa là gì?","options":["chứa đựng","chúc vui vẻ","Khiếm khuyết","sinh con"],"answer_index":0,"explanation":"牵制 = chứa đựng"},{"question":"Từ 「玩乐」 có nghĩa là gì?","options":["chúc vui vẻ","chứa đựng","Khiếm khuyết","sinh con"],"answer_index":0,"explanation":"玩乐 = chúc vui vẻ"},{"question":"Từ 「瑕疵」 có nghĩa là gì?","options":["Khiếm khuyết","chứa đựng","chúc vui vẻ","sinh con"],"answer_index":0,"explanation":"瑕疵 = Khiếm khuyết"},{"question":"Từ 「生子」 có nghĩa là gì?","options":["sinh con","chứa đựng","chúc vui vẻ","Khiếm khuyết"],"answer_index":0,"explanation":"生子 = sinh con"},{"question":"Từ 「生活费」 có nghĩa là gì?","options":["chi phí sinh hoạt","chứa đựng","chúc vui vẻ","Khiếm khuyết"],"answer_index":0,"explanation":"生活费 = chi phí sinh hoạt"},{"question":"Từ 「用意」 có nghĩa là gì?","options":["Ý định","chứa đựng","chúc vui vẻ","Khiếm khuyết"],"answer_index":0,"explanation":"用意 = Ý định"},{"question":"Từ 「电动机」 có nghĩa là gì?","options":["động cơ điện","chứa đựng","chúc vui vẻ","Khiếm khuyết"],"answer_index":0,"explanation":"电动机 = độn