s":[],"image_ref":"m_125d0984","audio_ref":"m_72b31ccd","meaning_audio_ref":"m_a8a1892b","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1170","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"落户を 使います。","line_vi":"Tôi dùng 落户.","focus_words":["落户"]},{"speaker":"B","line_target":"蒸发 は 何ですか。","line_vi":"蒸发 là cái gì?","focus_words":["蒸发"]},{"speaker":"A","line_target":"行政区域です。","line_vi":"Đó là 行政区域.","focus_words":["行政区域"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_864de91f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「落户」 có nghĩa là gì?","options":["Định cư","bay hơi","Khu hành chính","hối lộ"],"answer_index":0,"explanation":"落户 = Định cư"},{"question":"Từ 「蒸发」 có nghĩa là gì?","options":["bay hơi","Định cư","Khu hành chính","hối lộ"],"answer_index":0,"explanation":"蒸发 = bay hơi"},{"question":"Từ 「行政区域」 có nghĩa là gì?","options":["Khu hành chính","Định cư","bay hơi","hối lộ"],"answer_index":0,"explanation":"行政区域 = Khu hành chính"},{"question":"Từ 「行贿」 có nghĩa là gì?","options":["hối lộ","Định cư","bay hơi","Khu hành chính"],"answer_index":0,"explanation":"行贿 = hối lộ"},{"question":"Từ 「裂缝」 có nghĩa là gì?","options":["vết nứt","Định cư","bay hơi","Khu hành chính"],"answer_index":0,"explanation":"裂缝 = vết nứt"},{"question":"Từ 「装配」 có nghĩa là gì?","options":["hội","Định cư","bay hơi","Khu hành chính"],"answer_index":0,"explanation":"装配 = hội"},{"question":"Từ 「要害」 có nghĩa là gì?","options":["quan trọng","Định cư","bay hơi","Khu hành chính"],"answer_index":0,"explanation":"要害 = quan trọ