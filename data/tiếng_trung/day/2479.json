:"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_deaef559","audio_ref":"m_52412c77","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_76cc2711"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2479","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"老翁を 使います。","line_vi":"Tôi dùng 老翁.","focus_words":["老翁"]},{"speaker":"B","line_target":"老话 は 何ですか。","line_vi":"老话 là cái gì?","focus_words":["老话"]},{"speaker":"A","line_target":"老道です。","line_vi":"Đó là 老道.","focus_words":["老道"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c8489c2a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「老翁」 có nghĩa là gì?","options":["ông già","câu nói cũ","Đạo giáo","giám khảo"],"answer_index":0,"explanation":"老翁 = ông già"},{"question":"Từ 「老话」 có nghĩa là gì?","options":["câu nói cũ","ông già","Đạo giáo","giám khảo"],"answer_index":0,"explanation":"老话 = câu nói cũ"},{"question":"Từ 「老道」 có nghĩa là gì?","options":["Đạo giáo","ông già","câu nói cũ","giám khảo"],"answer_index":0,"explanation":"老道 = Đạo giáo"},{"question":"Từ 「考官」 có nghĩa là gì?","options":["giám khảo","ông già","câu nói cũ","Đạo giáo"],"answer_index":0,"explanation":"考官 = giám khảo"},{"question":"Từ 「联会」 có nghĩa là gì?","options":["liên đoàn","ông già","câu nói cũ","Đạo giáo"],"answer_index":0,"explanation":"联会 = liên đoàn"},{"question":"Từ 「胆识」 có nghĩa là gì?","options":["lòng can đảm","ông già","câu nói cũ","Đạo giáo"],"answer_index":0,"explanation":"胆识 = lòng can đảm"},{"question":"Từ 「腕表」 có nghĩa là gì?","options":["xem","ông già","câu nói cũ","Đạo giáo"],"answer_index":0,"explanation":"腕表 = xem"},{"question":"Từ 「腹痛」 có nghĩa là gì?","options":["đau bụng","ông già","câu nói cũ","Đạo giáo"],"answer_index":0,"explanation":"腹痛 = đau bụng"}],"patt