hi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 545","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"叛乱を 使います。","line_vi":"Tôi dùng 叛乱.","focus_words":["叛乱"]},{"speaker":"B","line_target":"可谓 は 何ですか。","line_vi":"可谓 là cái gì?","focus_words":["可谓"]},{"speaker":"A","line_target":"哪怕です。","line_vi":"Đó là 哪怕.","focus_words":["哪怕"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_12e3b8a9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「叛乱」 có nghĩa là gì?","options":["nổi loạn","Có thể nói","Thậm chí","Chỉ"],"answer_index":0,"explanation":"叛乱 = nổi loạn"},{"question":"Từ 「可谓」 có nghĩa là gì?","options":["Có thể nói","nổi loạn","Thậm chí","Chỉ"],"answer_index":0,"explanation":"可谓 = Có thể nói"},{"question":"Từ 「哪怕」 có nghĩa là gì?","options":["Thậm chí","nổi loạn","Có thể nói","Chỉ"],"answer_index":0,"explanation":"哪怕 = Thậm chí"},{"question":"Từ 「唯有」 có nghĩa là gì?","options":["Chỉ","nổi loạn","Có thể nói","Thậm chí"],"answer_index":0,"explanation":"唯有 = Chỉ"},{"question":"Từ 「商量」 có nghĩa là gì?","options":["thảo luận","nổi loạn","Có thể nói","Thậm chí"],"answer_index":0,"explanation":"商量 = thảo luận"},{"question":"Từ 「国防部」 có nghĩa là gì?","options":["Bộ Quốc phòng","nổi loạn","Có thể nói","Thậm chí"],"answer_index":0,"explanation":"国防部 = Bộ Quốc phòng"},{"question":"Từ 「处女」 có nghĩa là gì?","options":["trinh nữ","nổi loạn","Có thể nói","Thậm chí"],"answer_index