xamples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2046","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"天一を 使います。","line_vi":"Tôi dùng 天一.","focus_words":["天一"]},{"speaker":"B","line_target":"天安 は 何ですか。","line_vi":"天安 là cái gì?","focus_words":["天安"]},{"speaker":"A","line_target":"太极拳です。","line_vi":"Đó là 太极拳.","focus_words":["太极拳"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fb884ca4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「天一」 có nghĩa là gì?","options":["Thiên Nhất","Cheonan","Thái cực quyền","Mất giọng nói của bạn"],"answer_index":0,"explanation":"天一 = Thiên Nhất"},{"question":"Từ 「天安」 có nghĩa là gì?","options":["Cheonan","Thiên Nhất","Thái cực quyền","Mất giọng nói của bạn"],"answer_index":0,"explanation":"天安 = Cheonan"},{"question":"Từ 「太极拳」 có nghĩa là gì?","options":["Thái cực quyền","Thiên Nhất","Cheonan","Mất giọng nói của bạn"],"answer_index":0,"explanation":"太极拳 = Thái cực quyền"},{"question":"Từ 「失声」 có nghĩa là gì?","options":["Mất giọng nói của bạn","Thiên Nhất","Cheonan","Thái cực quyền"],"answer_index":0,"explanation":"失声 = Mất giọng nói của bạn"},{"question":"Từ 「契合」 có nghĩa là gì?","options":["phù hợp","Thiên Nhất","Cheonan","Thái cực quyền"],"answer_index":0,"explanation":"契合 = phù hợp"},{"question":"Từ 「套件」 có nghĩa là gì?","options":["bộ đồ","Thiên Nhất","Cheonan","Thái cực quyền"],"answer_index":0,"explanation":"套件 = bộ đồ"},