_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_bde84eb2","audio_ref":"m_9602e75c","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_9bbb6540"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1556","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"小将を 使います。","line_vi":"Tôi dùng 小将.","focus_words":["小将"]},{"speaker":"B","line_target":"屋内 は 何ですか。","line_vi":"屋内 là cái gì?","focus_words":["屋内"]},{"speaker":"A","line_target":"山体です。","line_vi":"Đó là 山体.","focus_words":["山体"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bbccf02b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「小将」 có nghĩa là gì?","options":["tướng trẻ","trong nhà","núi","nhóm làm việc"],"answer_index":0,"explanation":"小将 = tướng trẻ"},{"question":"Từ 「屋内」 có nghĩa là gì?","options":["trong nhà","tướng trẻ","núi","nhóm làm việc"],"answer_index":0,"explanation":"屋内 = trong nhà"},{"question":"Từ 「山体」 có nghĩa là gì?","options":["núi","tướng trẻ","trong nhà","nhóm làm việc"],"answer_index":0,"explanation":"山体 = núi"},{"question":"Từ 「工作组」 có nghĩa là gì?","options":["nhóm làm việc","tướng trẻ","trong nhà","núi"],"answer_index":0,"explanation":"工作组 = nhóm làm việc"},{"question":"Từ 「巴尔干」 có nghĩa là gì?","options":["vùng Balkan","tướng trẻ","trong nhà","núi"],"answer_index":0,"explanation":"巴尔干 = vùng Balkan"},{"question":"Từ 「市政厅」 có nghĩa là gì?","options":["tòa thị chính","tướng trẻ","trong nhà","núi"],"answer_index":0,"explanation":"市政厅 = tòa thị chính"},{"question":"Từ 「布丁」 có nghĩa là gì?","options":["bánh pudding","tướng trẻ","trong nhà","núi"],"answer_index":0,"explanation":"布丁 = bánh pudding"},{"question":"Từ 「希尔顿」 có nghĩa là gì?","options":["Hilton