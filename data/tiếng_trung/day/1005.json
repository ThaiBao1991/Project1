ần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1005","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"据点を 使います。","line_vi":"Tôi dùng 据点.","focus_words":["据点"]},{"speaker":"B","line_target":"支流 は 何ですか。","line_vi":"支流 là cái gì?","focus_words":["支流"]},{"speaker":"A","line_target":"教主です。","line_vi":"Đó là 教主.","focus_words":["教主"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_15355007","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「据点」 có nghĩa là gì?","options":["thành trì","phụ lưu","lãnh đạo","Gọn gàng"],"answer_index":0,"explanation":"据点 = thành trì"},{"question":"Từ 「支流」 có nghĩa là gì?","options":["phụ lưu","thành trì","lãnh đạo","Gọn gàng"],"answer_index":0,"explanation":"支流 = phụ lưu"},{"question":"Từ 「教主」 có nghĩa là gì?","options":["lãnh đạo","thành trì","phụ lưu","Gọn gàng"],"answer_index":0,"explanation":"教主 = lãnh đạo"},{"question":"Từ 「整齐」 có nghĩa là gì?","options":["Gọn gàng","thành trì","phụ lưu","lãnh đạo"],"answer_index":0,"explanation":"整齐 = Gọn gàng"},{"question":"Từ 「新手」 có nghĩa là gì?","options":["người mới","thành trì","phụ lưu","lãnh đạo"],"answer_index":0,"explanation":"新手 = người mới"},{"question":"Từ 「时说」 có nghĩa là gì?","options":["Shi nói","thành trì","phụ lưu","lãnh đạo"],"answer_index":0,"explanation":"时说 = Shi nói"},{"question":"Từ 「明珠」 có nghĩa là gì?","options":["ngọc trai","thành trì","phụ lưu","lãnh đạo"],"answer_index":0,"explanation":"明珠 = ngọc trai"},{"question":"Từ 「晶体」 có nghĩa là gì?","options":["pha lê","thành trì","phụ lưu","lãnh đạo"],"answer_index":0,"explanation":"晶体 = pha l