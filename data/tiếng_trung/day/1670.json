h sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1670","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"海牙を 使います。","line_vi":"Tôi dùng 海牙.","focus_words":["海牙"]},{"speaker":"B","line_target":"海龟 は 何ですか。","line_vi":"海龟 là cái gì?","focus_words":["海龟"]},{"speaker":"A","line_target":"液态です。","line_vi":"Đó là 液态.","focus_words":["液态"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0b6e0db1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「海牙」 có nghĩa là gì?","options":["The Hague","rùa biển","chất lỏng","nghiên cứu thêm"],"answer_index":0,"explanation":"海牙 = The Hague"},{"question":"Từ 「海龟」 có nghĩa là gì?","options":["rùa biển","The Hague","chất lỏng","nghiên cứu thêm"],"answer_index":0,"explanation":"海龟 = rùa biển"},{"question":"Từ 「液态」 có nghĩa là gì?","options":["chất lỏng","The Hague","rùa biển","nghiên cứu thêm"],"answer_index":0,"explanation":"液态 = chất lỏng"},{"question":"Từ 「深造」 có nghĩa là gì?","options":["nghiên cứu thêm","The Hague","rùa biển","chất lỏng"],"answer_index":0,"explanation":"深造 = nghiên cứu thêm"},{"question":"Từ 「清扫」 có nghĩa là gì?","options":["sạch sẽ","The Hague","rùa biển","chất lỏng"],"answer_index":0,"explanation":"清扫 = sạch sẽ"},{"question":"Từ 「漫漫」 có nghĩa là gì?","options":["dài","The Hague","rùa biển","chất lỏng"],"answer_index":0,"explanation":"漫漫 = dài"},{"question":"Từ 「潮州」 có nghĩa là gì?","options":["Triều Châu","The Hague","rùa biển","chất lỏng"],"answer_index":0,"explanation":"潮州 = Triều Châu"},{"question":"Từ 