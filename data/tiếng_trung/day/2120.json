a anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2120","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"教育家を 使います。","line_vi":"Tôi dùng 教育家.","focus_words":["教育家"]},{"speaker":"B","line_target":"整套 は 何ですか。","line_vi":"整套 là cái gì?","focus_words":["整套"]},{"speaker":"A","line_target":"断交です。","line_vi":"Đó là 断交.","focus_words":["断交"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3860ed89","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「教育家」 có nghĩa là gì?","options":["nhà giáo dục","bộ hoàn chỉnh","cắt đứt quan hệ ngoại giao","Thành phố Đài Bắc mới"],"answer_index":0,"explanation":"教育家 = nhà giáo dục"},{"question":"Từ 「整套」 có nghĩa là gì?","options":["bộ hoàn chỉnh","nhà giáo dục","cắt đứt quan hệ ngoại giao","Thành phố Đài Bắc mới"],"answer_index":0,"explanation":"整套 = bộ hoàn chỉnh"},{"question":"Từ 「断交」 có nghĩa là gì?","options":["cắt đứt quan hệ ngoại giao","nhà giáo dục","bộ hoàn chỉnh","Thành phố Đài Bắc mới"],"answer_index":0,"explanation":"断交 = cắt đứt quan hệ ngoại giao"},{"question":"Từ 「新北市」 có nghĩa là gì?","options":["Thành phố Đài Bắc mới","nhà giáo dục","bộ hoàn chỉnh","cắt đứt quan hệ ngoại giao"],"answer_index":0,"explanation":"新北市 = Thành phố Đài Bắc mới"},{"question":"Từ 「新开」 có nghĩa là gì?","options":["Mới mở","nhà giáo dục","bộ hoàn chỉnh","cắt đứt quan hệ ngoại giao"],"answer_index":0,"explanation":"新开 = Mới mở"},{"question":"Từ 「新桥」 có nghĩa là gì?","options":["cây cầu