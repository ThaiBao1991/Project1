"},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1221","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"心血を 使います。","line_vi":"Tôi dùng 心血.","focus_words":["心血"]},{"speaker":"B","line_target":"快到 は 何ですか。","line_vi":"快到 là cái gì?","focus_words":["快到"]},{"speaker":"A","line_target":"惊艳です。","line_vi":"Đó là 惊艳.","focus_words":["惊艳"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_77c533df","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「心血」 có nghĩa là gì?","options":["nỗ lực chăm chỉ","Sắp có","tuyệt đẹp","giác quan"],"answer_index":0,"explanation":"心血 = nỗ lực chăm chỉ"},{"question":"Từ 「快到」 có nghĩa là gì?","options":["Sắp có","nỗ lực chăm chỉ","tuyệt đẹp","giác quan"],"answer_index":0,"explanation":"快到 = Sắp có"},{"question":"Từ 「惊艳」 có nghĩa là gì?","options":["tuyệt đẹp","nỗ lực chăm chỉ","Sắp có","giác quan"],"answer_index":0,"explanation":"惊艳 = tuyệt đẹp"},{"question":"Từ 「感官」 có nghĩa là gì?","options":["giác quan","nỗ lực chăm chỉ","Sắp có","tuyệt đẹp"],"answer_index":0,"explanation":"感官 = giác quan"},{"question":"Từ 「懦弱」 có nghĩa là gì?","options":["hèn nhát","nỗ lực chăm chỉ","Sắp có","tuyệt đẹp"],"answer_index":0,"explanation":"懦弱 = hèn nhát"},{"question":"Từ 「房贷」 có nghĩa là gì?","options":["thế chấp","nỗ lực chăm chỉ","Sắp có","tuyệt đẹp"],"answer_index":0,"explanation":"房贷 = thế chấp"},{"question":"Từ 「承接」 có nghĩa là gì?","options":["đảm nhận","nỗ lực chăm chỉ","Sắp có","tuyệt đẹp"],"answer_index":0,"explanation":"承接 =