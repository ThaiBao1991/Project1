xample_vi":"","image_prompt":null,"image_ref":"m_c8be2193","audio_ref":"m_d740cc4e","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d11a1420"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 450","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"无奈を 使います。","line_vi":"Tôi dùng 无奈.","focus_words":["无奈"]},{"speaker":"B","line_target":"无意 は 何ですか。","line_vi":"无意 là cái gì?","focus_words":["无意"]},{"speaker":"A","line_target":"星期六です。","line_vi":"Đó là 星期六.","focus_words":["星期六"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_29ec1aca","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「无奈」 có nghĩa là gì?","options":["bất lực","Vô ý","thứ bảy","nhanh nhất"],"answer_index":0,"explanation":"无奈 = bất lực"},{"question":"Từ 「无意」 có nghĩa là gì?","options":["Vô ý","bất lực","thứ bảy","nhanh nhất"],"answer_index":0,"explanation":"无意 = Vô ý"},{"question":"Từ 「星期六」 có nghĩa là gì?","options":["thứ bảy","bất lực","Vô ý","nhanh nhất"],"answer_index":0,"explanation":"星期六 = thứ bảy"},{"question":"Từ 「最快」 có nghĩa là gì?","options":["nhanh nhất","bất lực","Vô ý","thứ bảy"],"answer_index":0,"explanation":"最快 = nhanh nhất"},{"question":"Từ 「有利于」 có nghĩa là gì?","options":["có lợi cho","bất lực","Vô ý","thứ bảy"],"answer_index":0,"explanation":"有利于 = có lợi cho"},{"question":"Từ 「服饰」 có nghĩa là gì?","options":["quần áo","bất lực","Vô ý","thứ bảy"],"answer_index":0,"explanation":"服饰 = quần áo"},{"question":"Từ 「机密」 có nghĩa là gì?","options":["bí mật","bất lực","Vô ý","thứ bảy"],"answer_index":0,"explanation":"机密 = bí mật"},{"question":"Từ 「来临」 có nghĩa là gì?","options":["đang đến","bất lực","Vô ý","thứ bảy"],"answer_index":0,"explanation":"来临 = đang đến"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bất lực","opti