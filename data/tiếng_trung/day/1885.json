le_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_66617388","audio_ref":"m_5098ca8d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_65c2334c"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1885","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"偷窥を 使います。","line_vi":"Tôi dùng 偷窥.","focus_words":["偷窥"]},{"speaker":"B","line_target":"光碟 は 何ですか。","line_vi":"光碟 là cái gì?","focus_words":["光碟"]},{"speaker":"A","line_target":"免疫力です。","line_vi":"Đó là 免疫力.","focus_words":["免疫力"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b590020e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「偷窥」 có nghĩa là gì?","options":["nhìn trộm","đĩa","miễn dịch","Đảng, chính quyền và quân đội"],"answer_index":0,"explanation":"偷窥 = nhìn trộm"},{"question":"Từ 「光碟」 có nghĩa là gì?","options":["đĩa","nhìn trộm","miễn dịch","Đảng, chính quyền và quân đội"],"answer_index":0,"explanation":"光碟 = đĩa"},{"question":"Từ 「免疫力」 có nghĩa là gì?","options":["miễn dịch","nhìn trộm","đĩa","Đảng, chính quyền và quân đội"],"answer_index":0,"explanation":"免疫力 = miễn dịch"},{"question":"Từ 「党政军」 có nghĩa là gì?","options":["Đảng, chính quyền và quân đội","nhìn trộm","đĩa","miễn dịch"],"answer_index":0,"explanation":"党政军 = Đảng, chính quyền và quân đội"},{"question":"Từ 「全资」 có nghĩa là gì?","options":["Sở hữu hoàn toàn","nhìn trộm","đĩa","miễn dịch"],"answer_index":0,"explanation":"全资 = Sở hữu hoàn toàn"},{"question":"Từ 「八字」 có nghĩa là gì?","options":["bazi","nhìn trộm","đĩa","miễn dịch"],"answer_index":0,"explanation":"八字 = bazi"},{"question":"Từ 「公债」 có nghĩa là gì?","options":["nợ công","nhìn trộm","đĩa","miễn dịch"],"answer_index":0,"explanation":"公债 = nợ công"},{"question":"Từ 「公厕」 có nghĩa là gì?","options":["nhà vệ sinh công cộng","nhìn trộm","đĩa","miễn dịch"],"answer_index":0,"explanation":"公厕 = nhà vệ sinh công cộng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: nhìn trộm","options":["偷窥","光碟","免疫力","党政军"],"answer_index":0,"explanation":"偷窥 = nhìn trộm"},{"question":"Chọn từ đúng cho nghĩa: đĩa","options":["光碟","偷窥","免疫力","党政军"],"answer_index":0,"explanation":"光碟 = đĩa"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"偷窥":"m_d27090ee","光碟":"m_54d3c905","党政军":"m_dffb9bf5","全资":"m_ad84ea2f","八字":"m_c66b7aa6","公债":"m_feb5fac2","公厕":"m_987b0637","六合彩":"m_84f7cd14","兰斯":"m_5098ca8d"},"dialogue_audio":{"0":"m_b590020e"}},"media_map":{"m_e139dc66":"media/tiếng_trung/d1885/word_00_6c003804.webp","m_df719d85":"media/tiếng_trung/d1885/word_01_57b103fe.webp","m_62e5e5de":"media/tiếng_trung/d1885/word_03_aaf91bc6.webp","m_dfd8fcd6":"media/tiếng_trung/d1885/word_04_a197e5d3.webp","m_b9b5b717":"media/tiếng_trung/d1885/word_05_d5c66f5d.webp","m_1aa947dd":"media/tiếng_trung/d1885/word_06_f2a8a347.webp","m_09a357b3":"media/tiếng_trung/d1885/word_07_b2b9d57d.webp","m_663dedb0":"media/tiếng_trung/d1885/word_08_9054bde7.webp","m_66617388":"media/tiếng_trung/d1885/word_09_ab8624ac.webp","m_d27090ee":"media/tiếng_trung/d1885/audio_vocab_00_e4933987.mp3","m_8e0fdcdf":"media/tiếng_trung/d1885/audio_vocab_00_vi_68573316.mp3","m_54d3c905":"media/tiếng_trung/d1885/audio_vocab_01_b658a1ea.mp3","m_9ab168a6":"media/tiếng_trung/d1885/audio_vocab_01_vi_b658a1ea.mp3","m_dffb9bf5":"media/tiếng_trung/d1885/audio_vocab_03_b3d90a5c.mp3","m_e957b9b7":"media/tiếng_trung/d1885/audio_vocab_03_vi_cbff6309.mp3","m_ad84ea2f":"media/tiếng_trung/d1885/audio_vocab_04_46f12a72.mp3","m_bf5a48d6":"media/tiếng_trung/d1885/audio_vocab_04_vi_46f12a72.mp3","m_c66b7aa6":"media/tiếng_trung/d1885/audio_vocab_05_9740abfe.mp3","m_d3407adb":"media/tiếng_trun