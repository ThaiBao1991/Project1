N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1085","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"英特尔を 使います。","line_vi":"Tôi dùng 英特尔.","focus_words":["英特尔"]},{"speaker":"B","line_target":"萝莉 は 何ですか。","line_vi":"萝莉 là cái gì?","focus_words":["萝莉"]},{"speaker":"A","line_target":"著称です。","line_vi":"Đó là 著称.","focus_words":["著称"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e5acb128","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「英特尔」 có nghĩa là gì?","options":["Intel","loli","nổi tiếng","cố tình"],"answer_index":0,"explanation":"英特尔 = Intel"},{"question":"Từ 「萝莉」 có nghĩa là gì?","options":["loli","Intel","nổi tiếng","cố tình"],"answer_index":0,"explanation":"萝莉 = loli"},{"question":"Từ 「著称」 có nghĩa là gì?","options":["nổi tiếng","Intel","loli","cố tình"],"answer_index":0,"explanation":"著称 = nổi tiếng"},{"question":"Từ 「蓄意」 có nghĩa là gì?","options":["cố tình","Intel","loli","nổi tiếng"],"answer_index":0,"explanation":"蓄意 = cố tình"},{"question":"Từ 「襄阳」 có nghĩa là gì?","options":["Tương Dương","Intel","loli","nổi tiếng"],"answer_index":0,"explanation":"襄阳 = Tương Dương"},{"question":"Từ 「西湖」 có nghĩa là gì?","options":["hồ tây","Intel","loli","nổi tiếng"],"answer_index":0,"explanation":"西湖 = hồ tây"},{"question":"Từ 「观望」 có nghĩa là gì?","options":["chờ x