:"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_54a4f0a2","audio_ref":"m_8eeaee42","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_4b788246"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1632","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"利器を 使います。","line_vi":"Tôi dùng 利器.","focus_words":["利器"]},{"speaker":"B","line_target":"前男友 は 何ですか。","line_vi":"前男友 là cái gì?","focus_words":["前男友"]},{"speaker":"A","line_target":"副省长です。","line_vi":"Đó là 副省长.","focus_words":["副省长"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2dc252f3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「利器」 có nghĩa là gì?","options":["vũ khí sắc bén","bạn trai cũ","phó thống đốc","tăng lãi suất"],"answer_index":0,"explanation":"利器 = vũ khí sắc bén"},{"question":"Từ 「前男友」 có nghĩa là gì?","options":["bạn trai cũ","vũ khí sắc bén","phó thống đốc","tăng lãi suất"],"answer_index":0,"explanation":"前男友 = bạn trai cũ"},{"question":"Từ 「副省长」 có nghĩa là gì?","options":["phó thống đốc","vũ khí sắc bén","bạn trai cũ","tăng lãi suất"],"answer_index":0,"explanation":"副省长 = phó thống đốc"},{"question":"Từ 「加息」 có nghĩa là gì?","options":["tăng lãi suất","vũ khí sắc bén","bạn trai cũ","phó thống đốc"],"answer_index":0,"explanation":"加息 = tăng lãi suất"},{"question":"Từ 「包子」 có nghĩa là gì?","options":["bánh hấp","vũ khí sắc bén","bạn trai cũ","phó thống đốc"],"answer_index":0,"explanation":"包子