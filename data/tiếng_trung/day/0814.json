ence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 814","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"先知を 使います。","line_vi":"Tôi dùng 先知.","focus_words":["先知"]},{"speaker":"B","line_target":"入住 は 何ですか。","line_vi":"入住 là cái gì?","focus_words":["入住"]},{"speaker":"A","line_target":"养生です。","line_vi":"Đó là 养生.","focus_words":["养生"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2f4bafad","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「先知」 có nghĩa là gì?","options":["nhà tiên tri","Đăng ký","chăm sóc sức khỏe","sáp nhập"],"answer_index":0,"explanation":"先知 = nhà tiên tri"},{"question":"Từ 「入住」 có nghĩa là gì?","options":["Đăng ký","nhà tiên tri","chăm sóc sức khỏe","sáp nhập"],"answer_index":0,"explanation":"入住 = Đăng ký"},{"question":"Từ 「养生」 có nghĩa là gì?","options":["chăm sóc sức khỏe","nhà tiên tri","Đăng ký","sáp nhập"],"answer_index":0,"explanation":"养生 = chăm sóc sức khỏe"},{"question":"Từ 「兼并」 có nghĩa là gì?","options":["sáp nhập","nhà tiên tri","Đăng ký","chăm sóc sức khỏe"],"answer_index":0,"explanation":"兼并 = sáp nhập"},{"question":"Từ 「兼顾」 có nghĩa là gì?","options":["tính đến","nhà tiên tri","Đăng ký","chăm sóc sức khỏe"],"answer_index":0,"explanation":"兼顾 = tính đến"},{"question":"Từ 「冷却」 có nghĩa là gì?","options":["làm mát","nhà tiên tri","Đăng ký","chăm sóc sức khỏe"],"answer_index":0,"explanation":"冷却 = làm mát"},{"question":"Từ 「分级」 có nghĩa là gì?","options":["Chấm điểm","nhà tiên tri","Đăng ký","chăm sóc sức khỏe"],"answer_index":0,"expla