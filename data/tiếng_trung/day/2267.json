ic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_5126d87a","audio_ref":"m_fd81fe84","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_68bd55cd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2267","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"有大を 使います。","line_vi":"Tôi dùng 有大.","focus_words":["有大"]},{"speaker":"B","line_target":"有损 は 何ですか。","line_vi":"有损 là cái gì?","focus_words":["有损"]},{"speaker":"A","line_target":"未婚夫です。","line_vi":"Đó là 未婚夫.","focus_words":["未婚夫"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_37c2c8a7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「有大」 có nghĩa là gì?","options":["Có một cái lớn","mất mát","hôn phu","nhiệm vụ"],"answer_index":0,"explanation":"有大 = Có một cái lớn"},{"question":"Từ 「有损」 có nghĩa là gì?","options":["mất mát","Có một cái lớn","hôn phu","nhiệm vụ"],"answer_index":0,"explanation":"有损 = mất mát"},{"question":"Từ 「未婚夫」 có nghĩa là gì?","options":["hôn phu","Có một cái lớn","mất mát","nhiệm vụ"],"answer_index":0,"explanation":"未婚夫 = hôn phu"},{"question":"Từ 「本分」 có nghĩa là gì?","options":["nhiệm vụ","Có một cái lớn","mất mát","hôn phu"],"answer_index":0,"explanation":"本分 = nhiệm vụ"},{"question":"Từ 「本应」 có nghĩa là gì?","options":["nên có","Có một cái lớn","mất mát","hôn phu"],"answer_index":0,"explanation":"本应 = nên có"},{"question":"Từ 「本篇」 có nghĩa là gì?","options":["bài viết này","Có một cái lớn","mất mát","hôn phu"],"answer_index":0,"explanation":"本篇 = bài viết này"},{"question":"Từ 「杂乱」 có nghĩa là gì?","options":["lộn xộn","Có một cái lớn","mất mát","hôn phu"],"answer_index":0,"explanation":"杂乱 = lộn xộn"},{"question":"Từ 「极光」 có