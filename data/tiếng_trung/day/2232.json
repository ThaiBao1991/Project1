":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2232","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"旅居を 使います。","line_vi":"Tôi dùng 旅居.","focus_words":["旅居"]},{"speaker":"B","line_target":"无忧无虑 は 何ですか。","line_vi":"无忧无虑 là cái gì?","focus_words":["无忧无虑"]},{"speaker":"A","line_target":"无限期です。","line_vi":"Đó là 无限期.","focus_words":["无限期"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_42764b77","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「旅居」 có nghĩa là gì?","options":["tạm trú","vô tư","vô thời hạn","sử dụng hàng ngày"],"answer_index":0,"explanation":"旅居 = tạm trú"},{"question":"Từ 「无忧无虑」 có nghĩa là gì?","options":["vô tư","tạm trú","vô thời hạn","sử dụng hàng ngày"],"answer_index":0,"explanation":"无忧无虑 = vô tư"},{"question":"Từ 「无限期」 có nghĩa là gì?","options":["vô thời hạn","tạm trú","vô tư","sử dụng hàng ngày"],"answer_index":0,"explanation":"无限期 = vô thời hạn"},{"question":"Từ 「日用」 có nghĩa là gì?","options":["sử dụng hàng ngày","tạm trú","vô tư","vô thời hạn"],"answer_index":0,"explanation":"日用 = sử dụng hàng ngày"},{"question":"Từ 「旧有」 có nghĩa là gì?","options":["cũ","tạm trú","vô tư","vô thời hạn"],"answer_index":0,"explanation":"旧有 = cũ"},{"question":"Từ 「早泄」 có nghĩa là gì?","options":["xuất tinh sớm","tạm trú","vô tư","vô thời hạn"],"answer_index":0,"explanation":"早泄 = xuất tinh sớm"},{"question":"Từ 「时效」 có nghĩa là gì?","options":["tính kịp thời","tạ