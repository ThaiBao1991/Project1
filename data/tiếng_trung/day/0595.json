ừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 595","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"问道を 使います。","line_vi":"Tôi dùng 问道.","focus_words":["问道"]},{"speaker":"B","line_target":"限度 は 何ですか。","line_vi":"限度 là cái gì?","focus_words":["限度"]},{"speaker":"A","line_target":"陛下です。","line_vi":"Đó là 陛下.","focus_words":["陛下"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a7da4661","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「问道」 có nghĩa là gì?","options":["hỏi","giới hạn","thưa bệ hạ","Tiếp theo là"],"answer_index":0,"explanation":"问道 = hỏi"},{"question":"Từ 「限度」 có nghĩa là gì?","options":["giới hạn","hỏi","thưa bệ hạ","Tiếp theo là"],"answer_index":0,"explanation":"限度 = giới hạn"},{"question":"Từ 「陛下」 có nghĩa là gì?","options":["thưa bệ hạ","hỏi","giới hạn","Tiếp theo là"],"answer_index":0,"explanation":"陛下 = thưa bệ hạ"},{"question":"Từ 「随之」 có nghĩa là gì?","options":["Tiếp theo là","hỏi","giới hạn","thưa bệ hạ"],"answer_index":0,"explanation":"随之 = Tiếp theo là"},{"question":"Từ 「集团军」 có nghĩa là gì?","options":["Tập đoàn quân","hỏi","giới hạn","thưa bệ hạ"],"answer_index":0,"explanation":"集团军 = Tập đoàn quân"},{"question":"Từ 「雇佣」 có nghĩa là gì?","options":["Thuê","hỏi","giới hạn","thưa bệ hạ"],"answer_index":0,"explanation":"雇佣 = Thuê"},{"question":"Từ 「音乐家」 có nghĩa là gì?","options":["nhạc sĩ","hỏi","giới hạn","thưa bệ hạ"],"answer_index":0,"explanation":"音乐家 = nhạc sĩ"},{"question":"Từ 「马克思主义」 có nghĩa là gì?","options":["chủ nghĩa Mác","hỏi","giới hạn","thưa bệ hạ"],"answer_index":0,"explanation":"马克思主义 = chủ nghĩa Mác"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: hỏi"