i."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1414","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"美联社を 使います。","line_vi":"Tôi dùng 美联社.","focus_words":["美联社"]},{"speaker":"B","line_target":"翻新 は 何ですか。","line_vi":"翻新 là cái gì?","focus_words":["翻新"]},{"speaker":"A","line_target":"老太です。","line_vi":"Đó là 老太.","focus_words":["老太"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ace3ad1a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「美联社」 có nghĩa là gì?","options":["Báo chí liên quan","cải tạo","bà già","xà phòng"],"answer_index":0,"explanation":"美联社 = Báo chí liên quan"},{"question":"Từ 「翻新」 có nghĩa là gì?","options":["cải tạo","Báo chí liên quan","bà già","xà phòng"],"answer_index":0,"explanation":"翻新 = cải tạo"},{"question":"Từ 「老太」 có nghĩa là gì?","options":["bà già","Báo chí liên quan","cải tạo","xà phòng"],"answer_index":0,"explanation":"老太 = bà già"},{"question":"Từ 「肥皂」 có nghĩa là gì?","options":["xà phòng","Báo chí liên quan","cải tạo","bà già"],"answer_index":0,"explanation":"肥皂 = xà phòng"},{"question":"Từ 「脑子里」 có nghĩa là gì?","options":["trong tâm trí","Báo chí liên quan","cải tạo","bà già"],"answer_index":0,"explanation":"脑子里 = trong tâm trí"},{"question":"Từ 「脱光」 có nghĩa là gì?","options":["cởi trần","Báo chí liên quan","cải tạo","bà già"],"answer_index":0,"explanation":"脱光 = cởi trần"},{"question":"Từ 「自由化」 có nghĩa là gì?","options":["sự tự do hóa","Báo chí liên quan","cải tạo","bà già"],"answer_index":0,"explanation":"自由化 = sự tự do hóa"},{"question":"Từ 「艾玛」 có nghĩa là