unciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 953","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"动工を 使います。","line_vi":"Tôi dùng 动工.","focus_words":["动工"]},{"speaker":"B","line_target":"十字 は 何ですか。","line_vi":"十字 là cái gì?","focus_words":["十字"]},{"speaker":"A","line_target":"印第安人です。","line_vi":"Đó là 印第安人.","focus_words":["印第安人"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_77112d4e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「动工」 có nghĩa là gì?","options":["Bắt đầu xây dựng","chéo","người Ấn Độ","Bản gốc"],"answer_index":0,"explanation":"动工 = Bắt đầu xây dựng"},{"question":"Từ 「十字」 có nghĩa là gì?","options":["chéo","Bắt đầu xây dựng","người Ấn Độ","Bản gốc"],"answer_index":0,"explanation":"十字 = chéo"},{"question":"Từ 「印第安人」 có nghĩa là gì?","options":["người Ấn Độ","Bắt đầu xây dựng","chéo","Bản gốc"],"answer_index":0,"explanation":"印第安人 = người Ấn Độ"},{"question":"Từ 「原版」 có nghĩa là gì?","options":["Bản gốc","Bắt đầu xây dựng","chéo","người Ấn Độ"],"answer_index":0,"explanation":"原版 = Bản gốc"},{"question":"Từ 「去掉」 có nghĩa là gì?","options":["loại bỏ","Bắt đầu xây dựng","chéo","người Ấn Độ"],"answer_index":0,"explanation":"去掉 = loại bỏ"},{"question":"Từ 「发抖」 có nghĩa là gì?","options":["run rẩy","Bắt đầu xây dựng","chéo","người Ấn Độ"],"answer_index":0,"explanation":"发抖 = run rẩy"},{"question":"Từ 「可比」 có nghĩa là gì?","options":["Có thể so sánh","Bắt đầu xây dựng","chéo","người Ấn Độ"],"answer_index":0,"explanation":"可比 = Có thể so sánh"},{"question":"Từ 「各有」 