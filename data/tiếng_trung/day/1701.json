les":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_ac56a504","audio_ref":"m_ff64f4d7","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e2aa2d8b"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1701","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"皇太后を 使います。","line_vi":"Tôi dùng 皇太后.","focus_words":["皇太后"]},{"speaker":"B","line_target":"皮质 は 何ですか。","line_vi":"皮质 là cái gì?","focus_words":["皮质"]},{"speaker":"A","line_target":"盛宴です。","line_vi":"Đó là 盛宴.","focus_words":["盛宴"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7c3a1fa1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「皇太后」 có nghĩa là gì?","options":["thái hậu","vỏ não","bữa tiệc","nở rộ"],"answer_index":0,"explanation":"皇太后 = thái hậu"},{"question":"Từ 「皮质」 có nghĩa là gì?","options":["vỏ não","thái hậu","bữa tiệc","nở rộ"],"answer_index":0,"explanation":"皮质 = vỏ não"},{"question":"Từ 「盛宴」 có nghĩa là gì?","options":["bữa tiệc","thái hậu","vỏ não","nở rộ"],"answer_index":0,"explanation":"盛宴 = bữa tiệc"},{"question":"Từ 「盛开」 có nghĩa là gì?","options":["nở rộ","thái hậu","vỏ não","bữa tiệc"],"answer_index":0,"explanation":"盛开 = nở rộ"},{"question":"Từ 「睾丸」 có nghĩa là gì?","options":["tinh hoàn","thái hậu","vỏ não","bữa tiệc"],"answer_index":0,"explanation":"睾丸 = tinh hoàn"},{"question":"Từ 「石墨」 có nghĩa là gì?","options":["than chì","thái hậu","vỏ não","bữa tiệc"],"answer_index":0,"explanation":"石墨 = than chì"},{"question":"Từ 「石榴」 có nghĩa là gì?","options":["quả lựu","thái hậu","vỏ não","bữa tiệc"],"answer_index":0,"explanation":"石榴 = quả lựu"},{"question":"Từ 「矿物质」 có nghĩa là gì?","options":["Khoáng sản","thái hậu","vỏ não","bữa tiệc"],"answer_