":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_9bfdcd2a","audio_ref":"m_eb5d9cee","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_0bbf5f00"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2107","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"供职を 使います。","line_vi":"Tôi dùng 供职.","focus_words":["供职"]},{"speaker":"B","line_target":"侥幸 は 何ですか。","line_vi":"侥幸 là cái gì?","focus_words":["侥幸"]},{"speaker":"A","line_target":"侯赛因です。","line_vi":"Đó là 侯赛因.","focus_words":["侯赛因"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5db28f13","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「供职」 có nghĩa là gì?","options":["Phục vụ","sự may mắn","Hussein","chủ nghĩa bảo thủ"],"answer_index":0,"explanation":"供职 = Phục vụ"},{"question":"Từ 「侥幸」 có nghĩa là gì?","options":["sự may mắn","Phục vụ","Hussein","chủ nghĩa bảo thủ"],"answer_index":0,"explanation":"侥幸 = sự may mắn"},{"question":"Từ 「侯赛因」 có nghĩa là gì?","options":["Hussein","Phục vụ","sự may mắn","chủ nghĩa bảo thủ"],"answer_index":0,"explanation":"侯赛因 = Hussein"},{"question":"Từ 「保守主义」 có nghĩa là gì?","options":["chủ nghĩa bảo thủ","Phục vụ","sự may mắn","Hussein"],"answer_index":0,"explanation":"保守主义 = chủ nghĩa bảo thủ"},{"question":"Từ 「修车」 có nghĩa là gì?","options":["sửa xe","Phục vụ","sự may mắn","Hussein"],"answer_index":0,"explanation":"修车 = sửa xe"},{"question":"Từ 「修长」 có nghĩa là gì?","options":["Mảnh khảnh","Phục vụ","sự may mắn","Hussein"],"answer_index":0,"explanation":"修长 = Mảnh khảnh"},{"question":"Từ 「假货」 có nghĩa là gì?","options":["giả mạo","Phục vụ","sự may mắn","Hussein"],"answer_index":0,"explanation":"假货 = giả mạo"},{"question":"Từ 「偷懒」 có nghĩa là gì?","options":["lười biếng