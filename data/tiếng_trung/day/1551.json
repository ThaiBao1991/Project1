ng đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1551","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"几千万を 使います。","line_vi":"Tôi dùng 几千万.","focus_words":["几千万"]},{"speaker":"B","line_target":"几只 は 何ですか。","line_vi":"几只 là cái gì?","focus_words":["几只"]},{"speaker":"A","line_target":"凡人です。","line_vi":"Đó là 凡人.","focus_words":["凡人"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_022ec1de","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「几千万」 có nghĩa là gì?","options":["hàng chục triệu","một số","sinh tử","khốc liệt"],"answer_index":0,"explanation":"几千万 = hàng chục triệu"},{"question":"Từ 「几只」 có nghĩa là gì?","options":["một số","hàng chục triệu","sinh tử","khốc liệt"],"answer_index":0,"explanation":"几只 = một số"},{"question":"Từ 「凡人」 có nghĩa là gì?","options":["sinh tử","hàng chục triệu","một số","khốc liệt"],"answer_index":0,"explanation":"凡人 = sinh tử"},{"question":"Từ 「凶狠」 có nghĩa là gì?","options":["khốc liệt","hàng chục triệu","một số","sinh tử"],"answer_index":0,"explanation":"凶狠 = khốc liệt"},{"question":"Từ 「出个」 có nghĩa là gì?","options":["Nghĩ ra điều gì đó","hàng chục triệu","một số","sinh tử"],"answer_index":0,"explanation":"出个 = Nghĩ ra điều gì đó"},{"question":"Từ 「刘德华」 có nghĩa là gì?","options":["Lưu Đức Hoa","hàng chục triệu","một số","sinh tử"],"answer_index":0,"explanation":"刘德华 = Lưu Đức Hoa"},{"question":"Từ 「刘翔」 có nghĩa là gì?","options":["Lưu Tương","hàng chục triệu","một số","sinh tử"],"answer_index":0,"exp