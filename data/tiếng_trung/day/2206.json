 trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2206","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"货源を 使います。","line_vi":"Tôi dùng 货源.","focus_words":["货源"]},{"speaker":"B","line_target":"购票 は 何ですか。","line_vi":"购票 là cái gì?","focus_words":["购票"]},{"speaker":"A","line_target":"费劲です。","line_vi":"Đó là 费劲.","focus_words":["费劲"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「货源」 có nghĩa là gì?","options":["cung cấp","Mua vé","vất vả","tay cờ bạc"],"answer_index":0,"explanation":"货源 = cung cấp"},{"question":"Từ 「购票」 có nghĩa là gì?","options":["Mua vé","cung cấp","vất vả","tay cờ bạc"],"answer_index":0,"explanation":"购票 = Mua vé"},{"question":"Từ 「费劲」 có nghĩa là gì?","options":["vất vả","cung cấp","Mua vé","tay cờ bạc"],"answer_index":0,"explanation":"费劲 = vất vả"},{"question":"Từ 「赌徒」 có nghĩa là gì?","options":["tay cờ bạc","cung cấp","Mua vé","vất vả"],"answer_index":0,"explanation":"赌徒 = tay cờ bạc"},{"question":"Từ 「赏赐」 có nghĩa là gì?","options":["phần thưởng","cung cấp","Mua vé","vất vả"],"answer_index":0,"explanation":"赏赐 = phần thưởng"},{"question":"Từ 「走遍」 có nghĩa là gì?","options":["đi du lịch khắp nơi","cung cấp","Mua vé","vất vả"],"answer_index":0,"explanation":"走遍 = đi du lịch khắp nơi"},{"question":"Từ 「起动」 có nghĩa là gì?","options":["bắt đầu","cung cấp","Mua vé","vất vả"],"answer_index":0,"explanation":"起动 = bắt đầu"},{"question":"Từ 「越来越少」 có nghĩa là gì?","options":["ngày càng ít hơn","cung cấp","Mua vé","vất vả"],"answer_index":0,"explanation":"越来越少 = ngày càng ít hơn"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cung cấp","options":["货源","购票","费劲","赌徒"],"answer_index":0,"explanation":"货源 = cung cấp"},{"question":"Chọn từ đúng cho nghĩa: Mua vé","options":["购票","货源","费劲","赌徒"],"answer_index":0