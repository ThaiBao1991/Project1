unciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 497","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"上海市を 使います。","line_vi":"Tôi dùng 上海市.","focus_words":["上海市"]},{"speaker":"B","line_target":"不曾 は 何ですか。","line_vi":"不曾 là cái gì?","focus_words":["不曾"]},{"speaker":"A","line_target":"不远です。","line_vi":"Đó là 不远.","focus_words":["不远"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f5738330","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「上海市」 có nghĩa là gì?","options":["Thượng Hải","không bao giờ","Không xa","thế hệ"],"answer_index":0,"explanation":"上海市 = Thượng Hải"},{"question":"Từ 「不曾」 có nghĩa là gì?","options":["không bao giờ","Thượng Hải","Không xa","thế hệ"],"answer_index":0,"explanation":"不曾 = không bao giờ"},{"question":"Từ 「不远」 có nghĩa là gì?","options":["Không xa","Thượng Hải","không bao giờ","thế hệ"],"answer_index":0,"explanation":"不远 = Không xa"},{"question":"Từ 「世代」 có nghĩa là gì?","options":["thế hệ","Thượng Hải","không bao giờ","Không xa"],"answer_index":0,"explanation":"世代 = thế hệ"},{"question":"Từ 「举措」 có nghĩa là gì?","options":["biện pháp","Thượng Hải","không bao giờ","Không xa"],"answer_index":0,"explanation":"举措 = biện pháp"},{"question":"Từ 「五十」 có nghĩa là gì?","options":["năm mươi","Thượng Hải","không bao giờ","Không xa"],"answer_index":0,"explanation":"五十 = năm mươi"},{"question":"Từ 「人能」 có nghĩa là gì?","options":["Mọi người có thể","Thượng Hải","không bao giờ","Không xa"],"answer_index":0,"explanation":"人能 = Mọi người có thể"},{"question":"Từ 「便于」 có nghĩa là gì?","options"