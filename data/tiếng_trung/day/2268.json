ません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2268","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"模块化を 使います。","line_vi":"Tôi dùng 模块化.","focus_words":["模块化"]},{"speaker":"B","line_target":"橡树 は 何ですか。","line_vi":"橡树 là cái gì?","focus_words":["橡树"]},{"speaker":"A","line_target":"此间です。","line_vi":"Đó là 此间.","focus_words":["此间"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_447be176","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「模块化」 có nghĩa là gì?","options":["Mô-đun","cây sồi","ở đây","Võ Đang"],"answer_index":0,"explanation":"模块化 = Mô-đun"},{"question":"Từ 「橡树」 có nghĩa là gì?","options":["cây sồi","Mô-đun","ở đây","Võ Đang"],"answer_index":0,"explanation":"橡树 = cây sồi"},{"question":"Từ 「此间」 có nghĩa là gì?","options":["ở đây","Mô-đun","cây sồi","Võ Đang"],"answer_index":0,"explanation":"此间 = ở đây"},{"question":"Từ 「武当」 có nghĩa là gì?","options":["Võ Đang","Mô-đun","cây sồi","ở đây"],"answer_index":0,"explanation":"武当 = Võ Đang"},{"question":"Từ 「殊不知」 có nghĩa là gì?","options":["Như mọi người đều biết","Mô-đun","cây sồi","ở đây"],"answer_index":0,"explanation":"殊不知 = Như mọi người đều biết"},{"question":"Từ 「母系」 có nghĩa là gì?","options":["dòng mẹ","Mô-đun","cây sồi","ở đây"],"answer_index":0,"explanation":"母系 = dòng mẹ"},{"question":"Từ 「水龙头」 có nghĩa là gì?","options":["vòi nước","Mô-đun","cây sồi","ở đây"],"answer_index":0,"explanation":"水龙头 = vòi nước"},{"question":"Từ 「永康」 có nghĩa là gì?","options":["Vĩnh Khang","Mô-đun","cây sồi"