ote":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_689f15a6","audio_ref":"m_4b386727","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e53b9468"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 917","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"乳头を 使います。","line_vi":"Tôi dùng 乳头.","focus_words":["乳头"]},{"speaker":"B","line_target":"五位 は 何ですか。","line_vi":"五位 là cái gì?","focus_words":["五位"]},{"speaker":"A","line_target":"人头です。","line_vi":"Đó là 人头.","focus_words":["人头"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ce7f05a0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「乳头」 có nghĩa là gì?","options":["núm vú","năm","cái đầu","chiều nay"],"answer_index":0,"explanation":"乳头 = núm vú"},{"question":"Từ 「五位」 có nghĩa là gì?","options":["năm","núm vú","cái đầu","chiều nay"],"answer_index":0,"explanation":"五位 = năm"},{"question":"Từ 「人头」 có nghĩa là gì?","options":["cái đầu","núm vú","năm","chiều nay"],"answer_index":0,"explanation":"人头 = cái đầu"},{"question":"Từ 「今天下午」 có nghĩa là gì?","options":["chiều nay","núm vú","năm","cái đầu"],"answer_index":0,"explanation":"今天下午 = chiều nay"},{"question":"Từ 「付钱」 có nghĩa là gì?","options":["trả tiền","núm vú","năm","cái đầu"],"answer_index":0,"explanation":"付钱 = trả tiền"},{"question":"Từ 「代表作」 có nghĩa là gì?","options":["Tác phẩm tiêu biểu","núm vú","năm","cái đầu"],"answer_index":0,"explanation":"代表作 = Tác phẩm tiêu biểu"},{"question":"Từ 「代言人」 có nghĩa là gì?","options":["người phát ngôn","núm vú","năm","cái đầu"],"answer_index":0,"explanation":"代言人 = người phát ngôn"},{"question":"Từ 「以示」 có nghĩa là 