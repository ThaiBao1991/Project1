","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2017","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"慌乱を 使います。","line_vi":"Tôi dùng 慌乱.","focus_words":["慌乱"]},{"speaker":"B","line_target":"戒毒 は 何ですか。","line_vi":"戒毒 là cái gì?","focus_words":["戒毒"]},{"speaker":"A","line_target":"战备です。","line_vi":"Đó là 战备.","focus_words":["战备"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1432de9d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「慌乱」 có nghĩa là gì?","options":["hoảng loạn","giải độc","sẵn sàng chiến đấu","RV"],"answer_index":0,"explanation":"慌乱 = hoảng loạn"},{"question":"Từ 「戒毒」 có nghĩa là gì?","options":["giải độc","hoảng loạn","sẵn sàng chiến đấu","RV"],"answer_index":0,"explanation":"戒毒 = giải độc"},{"question":"Từ 「战备」 có nghĩa là gì?","options":["sẵn sàng chiến đấu","hoảng loạn","giải độc","RV"],"answer_index":0,"explanation":"战备 = sẵn sàng chiến đấu"},{"question":"Từ 「房车」 có nghĩa là gì?","options":["RV","hoảng loạn","giải độc","sẵn sàng chiến đấu"],"answer_index":0,"explanation":"房车 = RV"},{"question":"Từ 「所著」 có nghĩa là gì?","options":["Được viết bởi","hoảng loạn","giải độc","sẵn sàng chiến đấu"],"answer_index":0,"explanation":"所著 = Được viết bởi"},{"question":"Từ 「打斗」 có nghĩa là gì?","options":["chiến đấu","hoảng loạn","giải độc","sẵn sàng chiến đấu"],"answer_index":0,"explanation":