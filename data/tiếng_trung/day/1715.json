。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1715","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"保暖を 使います。","line_vi":"Tôi dùng 保暖.","focus_words":["保暖"]},{"speaker":"B","line_target":"修好 は 何ですか。","line_vi":"修好 là cái gì?","focus_words":["修好"]},{"speaker":"A","line_target":"修宪です。","line_vi":"Đó là 修宪.","focus_words":["修宪"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_68e8605a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「保暖」 có nghĩa là gì?","options":["giữ ấm","đã sửa","sửa đổi hiến pháp","quyết định"],"answer_index":0,"explanation":"保暖 = giữ ấm"},{"question":"Từ 「修好」 có nghĩa là gì?","options":["đã sửa","giữ ấm","sửa đổi hiến pháp","quyết định"],"answer_index":0,"explanation":"修好 = đã sửa"},{"question":"Từ 「修宪」 có nghĩa là gì?","options":["sửa đổi hiến pháp","giữ ấm","đã sửa","quyết định"],"answer_index":0,"explanation":"修宪 = sửa đổi hiến pháp"},{"question":"Từ 「做主」 có nghĩa là gì?","options":["quyết định","giữ ấm","đã sửa","sửa đổi hiến pháp"],"answer_index":0,"explanation":"做主 = quyết định"},{"question":"Từ 「做得好」 có nghĩa là gì?","options":["làm tốt lắm","giữ ấm","đã sửa","sửa đổi hiến pháp"],"answer_index":0,"explanation":"做得好 = làm tốt lắm"},{"question":"Từ 「光华」 có nghĩa là gì?","options":["Quảng Hoa","giữ ấm","đã sửa","sửa đổi hiến pháp"],"answer_index":0,"explanation":"光华 = Quảng Hoa"},{"question":"Từ 「光棍」 có nghĩa là gì?","options":["cử nhân","giữ ấm","đã sửa","sửa đổi hiến pháp"],"answer_index":0,"explanation":"光棍 = cử nhân"},{"ques