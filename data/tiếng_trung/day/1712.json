tion":"không rõ ràng","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_7c3eaa23","audio_ref":"m_02facbc9","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_63dd0233"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1712","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"victorを 使います。","line_vi":"Tôi dùng victor.","focus_words":["victor"]},{"speaker":"B","line_target":"yy は 何ですか。","line_vi":"yy là cái gì?","focus_words":["yy"]},{"speaker":"A","line_target":"一尊です。","line_vi":"Đó là 一尊.","focus_words":["一尊"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_60dac083","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「victor」 có nghĩa là gì?","options":["người chiến thắng","ừ","Một bức tượng","một người hâm mộ"],"answer_index":0,"explanation":"victor = người chiến thắng"},{"question":"Từ 「yy」 có nghĩa là gì?","options":["ừ","người chiến thắng","Một bức tượng","một người hâm mộ"],"answer_index":0,"explanation":"yy = ừ"},{"question":"Từ 「一尊」 có nghĩa là gì?","options":["Một bức tượng","người chiến thắng","ừ","một người hâm mộ"],"answer_index":0,"explanation":"一尊 = Một bức tượng"},{"question":"Từ 「一扇」 có nghĩa là gì?","options":["một người hâm mộ","người chiến thắng","ừ","Một bức tượng"],"answer_index":0,"explanation":"一扇 = một người hâm mộ"},{"question":"Từ 「一时期」 có nghĩa là gì?","options":["một khoảng thời gian","người chiến thắng","ừ","Một bức tượng"],"answer_index":0,"explanation":"一时期 = một khoảng thời gian"},{"question":"Từ 「七星」 có nghĩa là gì?","options":["bảy ngôi sao","người chiến thắng","ừ","Một bức tượng"],"answer_index":0,"explanation":"七星 = bảy ngôi sao"},{"question":"Từ 「万亿」 có nghĩa là gì?","option