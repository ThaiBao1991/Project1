:"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_402d6fb7","audio_ref":"m_f68ee104","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_9bbabeff"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2098","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"辅佐を 使います。","line_vi":"Tôi dùng 辅佐.","focus_words":["辅佐"]},{"speaker":"B","line_target":"输球 は 何ですか。","line_vi":"输球 là cái gì?","focus_words":["输球"]},{"speaker":"A","line_target":"辩护人です。","line_vi":"Đó là 辩护人.","focus_words":["辩护人"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_01db85a7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「辅佐」 có nghĩa là gì?","options":["Hỗ trợ","thua","hậu vệ","bị gạt ra ngoài lề xã hội"],"answer_index":0,"explanation":"辅佐 = Hỗ trợ"},{"question":"Từ 「输球」 có nghĩa là gì?","options":["thua","Hỗ trợ","hậu vệ","bị gạt ra ngoài lề xã hội"],"answer_index":0,"explanation":"输球 = thua"},{"question":"Từ 「辩护人」 có nghĩa là gì?","options":["hậu vệ","Hỗ trợ","thua","bị gạt ra ngoài lề xã hội"],"answer_index":0,"explanation":"辩护人 = hậu vệ"},{"question":"Từ 「边缘化」 có nghĩa là gì?","options":["bị gạt ra ngoài lề xã hội","Hỗ trợ","thua","hậu vệ"],"answer_index":0,"explanation":"边缘化 = bị gạt ra ngoài lề xã hội"},{"question":"Từ 「过问」 có nghĩa là gì?","options":["hỏi","Hỗ trợ","thua","hậu vệ"],"answer_index":0,"explanation":"过问 = hỏi"},{"question":"Từ 「这些年来」 có nghĩa là gì?","options":["qua nhiều năm","Hỗ trợ","thua","hậu vệ"],"answer_index":0,"explanation":"这些年来 = qua nhiều năm"},{"question":"Từ 「迫降」 có nghĩa là gì?","options":["buộc phải hạ cánh","Hỗ trợ","thua","hậu vệ"],"answer_index":0,"explanation":"迫降 = buộc phải hạ cán