ing_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 551","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"语法を 使います。","line_vi":"Tôi dùng 语法.","focus_words":["语法"]},{"speaker":"B","line_target":"车厢 は 何ですか。","line_vi":"车厢 là cái gì?","focus_words":["车厢"]},{"speaker":"A","line_target":"轿车です。","line_vi":"Đó là 轿车.","focus_words":["轿车"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_faf1cbf1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「语法」 có nghĩa là gì?","options":["ngữ pháp","vận chuyển","xe hơi","đóng quân"],"answer_index":0,"explanation":"语法 = ngữ pháp"},{"question":"Từ 「车厢」 có nghĩa là gì?","options":["vận chuyển","ngữ pháp","xe hơi","đóng quân"],"answer_index":0,"explanation":"车厢 = vận chuyển"},{"question":"Từ 「轿车」 có nghĩa là gì?","options":["xe hơi","ngữ pháp","vận chuyển","đóng quân"],"answer_index":0,"explanation":"轿车 = xe hơi"},{"question":"Từ 「进驻」 có nghĩa là gì?","options":["đóng quân","ngữ pháp","vận chuyển","xe hơi"],"answer_index":0,"explanation":"进驻 = đóng quân"},{"question":"Từ 「通行」 có nghĩa là gì?","options":["vượt qua","ngữ pháp","vận chuyển","xe hơi"],"answer_index":0,"explanation":"通行 = vượt qua"},{"question":"Từ 「邮政」 có nghĩa là gì?","options":["dịch vụ bưu chính","ngữ pháp","vận chuyển","xe hơi"],"answer_index":0,"explanation":"邮政 = dịch vụ bưu chính"},{"question":"Từ 「重返」 có nghĩa là gì?","options":["trở lại","ngữ pháp","vận chuyển","xe hơi"],"answer_index":0,"explanation":"重返 = trở lại"},{"question":"Từ 「锦标赛」 có nghĩ