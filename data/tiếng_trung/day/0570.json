_note":"","syllables":[],"image_ref":"m_d3a7ff82","audio_ref":"m_818c9a01","meaning_audio_ref":"m_fefee56d","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 570","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"破解を 使います。","line_vi":"Tôi dùng 破解.","focus_words":["破解"]},{"speaker":"B","line_target":"笨蛋 は 何ですか。","line_vi":"笨蛋 là cái gì?","focus_words":["笨蛋"]},{"speaker":"A","line_target":"第七です。","line_vi":"Đó là 第七.","focus_words":["第七"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_35aedf1e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「破解」 có nghĩa là gì?","options":["vết nứt","đồ ngốc","thứ bảy","Cẩn thận"],"answer_index":0,"explanation":"破解 = vết nứt"},{"question":"Từ 「笨蛋」 có nghĩa là gì?","options":["đồ ngốc","vết nứt","thứ bảy","Cẩn thận"],"answer_index":0,"explanation":"笨蛋 = đồ ngốc"},{"question":"Từ 「第七」 có nghĩa là gì?","options":["thứ bảy","vết nứt","đồ ngốc","Cẩn thận"],"answer_index":0,"explanation":"第七 = thứ bảy"},{"question":"Từ 「精心」 có nghĩa là gì?","options":["Cẩn thận","vết nứt","đồ ngốc","thứ bảy"],"answer_index":0,"explanation":"精心 = Cẩn thận"},{"question":"Từ 「要点」 có nghĩa là gì?","options":["Điểm chính","vết nứt","đồ ngốc","thứ bảy"],"answer_index":0,"explanation":"要点 = Điểm chính"},{"question":"Từ 「货车」 có nghĩa là gì?","options":["xe tải","vết nứt","đồ ngốc","thứ bảy"],"answer_index":0,"explanation":"货车 = xe tải"},{"question":"Từ 「身心」 có nghĩa là gì?","options":["cơ thể và tâm trí","vết nứt","đồ ngốc","thứ bảy"],"answer_index":0,"explanation":"身心 = cơ thể và tâm trí"},{"question":"Từ 「运动会」 có nghĩa là gì