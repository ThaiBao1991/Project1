[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2263","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"成就感を 使います。","line_vi":"Tôi dùng 成就感.","focus_words":["成就感"]},{"speaker":"B","line_target":"我过 は 何ですか。","line_vi":"我过 là cái gì?","focus_words":["我过"]},{"speaker":"A","line_target":"才智です。","line_vi":"Đó là 才智.","focus_words":["才智"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「成就感」 có nghĩa là gì?","options":["cảm giác thành tựu","tôi đã vượt qua","trí thông minh","Điểm"],"answer_index":0,"explanation":"成就感 = cảm giác thành tựu"},{"question":"Từ 「我过」 có nghĩa là gì?","options":["tôi đã vượt qua","cảm giác thành tựu","trí thông minh","Điểm"],"answer_index":0,"explanation":"我过 = tôi đã vượt qua"},{"question":"Từ 「才智」 có nghĩa là gì?","options":["trí thông minh","cảm giác thành tựu","tôi đã vượt qua","Điểm"],"answer_index":0,"explanation":"才智 = trí thông minh"},{"question":"Từ 「打分」 có nghĩa là gì?","options":["Điểm","cảm giác thành tựu","tôi đã vượt qua","trí thông minh"],"answer_index":0,"explanation":"打分 = Điểm"},{"question":"Từ 「托斯」 có nghĩa là gì?","options":["quăng","cảm giác thành tựu","tôi đã vượt qua","trí thông minh"],"answer_index":0,"explanation":"托斯 = quăng"},{"question":"Từ 「执笔」 có nghĩa là gì?","options":["viết","cảm giác thành tựu","tôi đã vượt qua","trí thông minh"],"answer_index":0,"explanation":"执笔 = viết"},{"question":"Từ 「抗美援朝」 có nghĩa là gì?","options":["Chống lại sự xâm lược của Mỹ và viện trợ Hàn Quốc","cảm giác thành tựu","tôi đã vượt qua","trí thông minh"],"answer_index":0,"explanation":"抗美援朝 = Chống lại sự xâm lược của Mỹ và viện trợ Hàn Quốc"},{"question":"Từ 「抚慰」 có nghĩa là gì?","options":["xoa dịu","cảm giác thành tựu","tôi đã vượt qua","trí thông minh"],"answer_index":0,"explanation":"抚慰 = xoa dịu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cảm giác thành tựu","options":["成就感","我过","才智","打分"],"answer_index":0,"explanation":"成就感 = cảm giác