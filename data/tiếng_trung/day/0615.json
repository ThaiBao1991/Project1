bles":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e6219109","audio_ref":"m_a6dc4383","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_858e48b1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 615","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"粤语を 使います。","line_vi":"Tôi dùng 粤语.","focus_words":["粤语"]},{"speaker":"B","line_target":"索尼 は 何ですか。","line_vi":"索尼 là cái gì?","focus_words":["索尼"]},{"speaker":"A","line_target":"红包です。","line_vi":"Đó là 红包.","focus_words":["红包"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4269ea5e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「粤语」 có nghĩa là gì?","options":["tiếng Quảng Đông","sony","phong bì màu đỏ","cờ đỏ"],"answer_index":0,"explanation":"粤语 = tiếng Quảng Đông"},{"question":"Từ 「索尼」 có nghĩa là gì?","options":["sony","tiếng Quảng Đông","phong bì màu đỏ","cờ đỏ"],"answer_index":0,"explanation":"索尼 = sony"},{"question":"Từ 「红包」 có nghĩa là gì?","options":["phong bì màu đỏ","tiếng Quảng Đông","sony","cờ đỏ"],"answer_index":0,"explanation":"红包 = phong bì màu đỏ"},{"question":"Từ 「红旗」 có nghĩa là gì?","options":["cờ đỏ","tiếng Quảng Đông","sony","phong bì màu đỏ"],"answer_index":0,"explanation":"红旗 = cờ đỏ"},{"question":"Từ 「维基」 có nghĩa là gì?","options":["wiki","tiếng Quảng Đông","sony","phong bì màu đỏ"],"answer_index":0,"explanation":"维基 = wiki"},{"question":"Từ 「维生素」 có nghĩa là gì?","options":["vitamin","tiếng Quảng Đông","sony","phong bì màu đỏ"],"answer_index":0,"explanation":"维生素 = vitamin"},{"question":"Từ 「罗伯特」 có nghĩa là gì?","options":["Robert","tiếng Quảng Đông","sony","phong bì màu đỏ"],"answer_index":0,"explanation":"罗伯特 = Rober