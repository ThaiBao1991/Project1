 i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 961","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"登山を 使います。","line_vi":"Tôi dùng 登山.","focus_words":["登山"]},{"speaker":"B","line_target":"盛世 は 何ですか。","line_vi":"盛世 là cái gì?","focus_words":["盛世"]},{"speaker":"A","line_target":"相符です。","line_vi":"Đó là 相符.","focus_words":["相符"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5218c077","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「登山」 có nghĩa là gì?","options":["leo núi","tuổi thịnh vượng","nhất quán","thôi thúc"],"answer_index":0,"explanation":"登山 = leo núi"},{"question":"Từ 「盛世」 có nghĩa là gì?","options":["tuổi thịnh vượng","leo núi","nhất quán","thôi thúc"],"answer_index":0,"explanation":"盛世 = tuổi thịnh vượng"},{"question":"Từ 「相符」 có nghĩa là gì?","options":["nhất quán","leo núi","tuổi thịnh vượng","thôi thúc"],"answer_index":0,"explanation":"相符 = nhất quán"},{"question":"Từ 「督促」 có nghĩa là gì?","options":["thôi thúc","leo núi","tuổi thịnh vượng","nhất quán"],"answer_index":0,"explanation":"督促 = thôi thúc"},{"question":"Từ 「神器」 có nghĩa là gì?","options":["Cổ vật","leo núi","tuổi thịnh vượng","nhất quán"],"answer_index":0,"explanation":"神器 = Cổ vật"},{"question":"Từ 「福岛」 có nghĩa là gì?","options":["Fukushima","leo núi","tuổi thịnh vượng","nhất quán"],"answer_index":0,"explanation":"福岛 = Fukushima"},{"question":"Từ 「第二轮」 có nghĩa là gì?","options":["vòng thứ hai","leo núi","tuổi thịnh vượng","nhất quán"],"answer_index":0,"explanation":"第二轮 = vòng thứ hai"},{"question":"Từ 「索马里」 có nghĩa là gì?","options":["Somali","leo núi","tuổi thịnh vượng","nhất q