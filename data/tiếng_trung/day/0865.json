."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 865","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"浪费时间を 使います。","line_vi":"Tôi dùng 浪费时间.","focus_words":["浪费时间"]},{"speaker":"B","line_target":"消毒 は 何ですか。","line_vi":"消毒 là cái gì?","focus_words":["消毒"]},{"speaker":"A","line_target":"淡水です。","line_vi":"Đó là 淡水.","focus_words":["淡水"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_852d3365","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「浪费时间」 có nghĩa là gì?","options":["lãng phí thời gian","Khử trùng","nước ngọt","đèn lồng"],"answer_index":0,"explanation":"浪费时间 = lãng phí thời gian"},{"question":"Từ 「消毒」 có nghĩa là gì?","options":["Khử trùng","lãng phí thời gian","nước ngọt","đèn lồng"],"answer_index":0,"explanation":"消毒 = Khử trùng"},{"question":"Từ 「淡水」 có nghĩa là gì?","options":["nước ngọt","lãng phí thời gian","Khử trùng","đèn lồng"],"answer_index":0,"explanation":"淡水 = nước ngọt"},{"question":"Từ 「灯笼」 có nghĩa là gì?","options":["đèn lồng","lãng phí thời gian","Khử trùng","nước ngọt"],"answer_index":0,"explanation":"灯笼 = đèn lồng"},{"question":"Từ 「照样」 có nghĩa là gì?","options":["Vẫn như cũ","lãng phí thời gian","Khử trùng","nước ngọt"],"answer_index":0,"explanation":"照样 = Vẫn như cũ"},{"question":"Từ 「片面」 có nghĩa là gì?","options":["Một mặt","lãng phí thời gian","Khử trùng","nước ngọt"],"answer_index":0,"explanation":"片面 = Một mặt"},{"question":"Từ 「牲畜」 có nghĩa là gì?","options":["vật nuôi","lãng phí thời gian","Khử trùng","nước ngọt"],"answer_index":0,"explanation":"牲畜 = vật n