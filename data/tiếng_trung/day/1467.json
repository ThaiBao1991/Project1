5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1467","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"里克を 使います。","line_vi":"Tôi dùng 里克.","focus_words":["里克"]},{"speaker":"B","line_target":"金正恩 は 何ですか。","line_vi":"金正恩 là cái gì?","focus_words":["金正恩"]},{"speaker":"A","line_target":"金融服务です。","line_vi":"Đó là 金融服务.","focus_words":["金融服务"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7fbc4531","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「里克」 có nghĩa là gì?","options":["Rick","Kim Jong Un","dịch vụ tài chính","bình tĩnh"],"answer_index":0,"explanation":"里克 = Rick"},{"question":"Từ 「金正恩」 có nghĩa là gì?","options":["Kim Jong Un","Rick","dịch vụ tài chính","bình tĩnh"],"answer_index":0,"explanation":"金正恩 = Kim Jong Un"},{"question":"Từ 「金融服务」 có nghĩa là gì?","options":["dịch vụ tài chính","Rick","Kim Jong Un","bình tĩnh"],"answer_index":0,"explanation":"金融服务 = dịch vụ tài chính"},{"question":"Từ 「镇定」 có nghĩa là gì?","options":["bình tĩnh","Rick","Kim Jong Un","dịch vụ tài chính"],"answer_index":0,"explanation":"镇定 = bình tĩnh"},{"question":"Từ 「长处」 có nghĩa là gì?","options":["Điểm mạnh","Rick","Kim Jong Un","dịch vụ tài chính"],"answer_index":0,"explanation":"长处 = Điểm mạnh"},{"question":"Từ 「阿门」 có nghĩa là gì?","options":["Amen","Rick","Kim Jong Un","dịch vụ tài chính"],"answer_index":0,"explanation":"