ôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1148","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"证监会を 使います。","line_vi":"Tôi dùng 证监会.","focus_words":["证监会"]},{"speaker":"B","line_target":"赛前 は 何ですか。","line_vi":"赛前 là cái gì?","focus_words":["赛前"]},{"speaker":"A","line_target":"赛后です。","line_vi":"Đó là 赛后.","focus_words":["赛后"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b3b6d90e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「证监会」 có nghĩa là gì?","options":["Ủy ban điều tiết chứng khoán","Trước trận đấu","Sau trận đấu","biến đi"],"answer_index":0,"explanation":"证监会 = Ủy ban điều tiết chứng khoán"},{"question":"Từ 「赛前」 có nghĩa là gì?","options":["Trước trận đấu","Ủy ban điều tiết chứng khoán","Sau trận đấu","biến đi"],"answer_index":0,"explanation":"赛前 = Trước trận đấu"},{"question":"Từ 「赛后」 có nghĩa là gì?","options":["Sau trận đấu","Ủy ban điều tiết chứng khoán","Trước trận đấu","biến đi"],"answer_index":0,"explanation":"赛后 = Sau trận đấu"},{"question":"Từ 「走开」 có nghĩa là gì?","options":["biến đi","Ủy ban điều tiết chứng khoán","Trước trận đấu","Sau trận đấu"],"answer_index":0,"explanation":"走开 = biến đi"},{"question":"Từ 「走来」 có nghĩa là gì?","options":["Hãy đến đây","Ủy ban điều tiết chứng khoán","Trước trận đấu","Sau trận đấu"],"answer_index":0,"explanation":"走来 = Hãy đến đây"},{"question":"Từ 「超大」 có nghĩa là gì?","options":["Cực lớn","Ủy ban điều tiết chứng khoán","Trước trận đấu","Sau trận đấu"],"answer_index":0,"explanation":"超大 = Cực lớn"},{"question":"Từ 「趴在」 có nghĩa là gì?","optio