ì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 658","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"央行を 使います。","line_vi":"Tôi dùng 央行.","focus_words":["央行"]},{"speaker":"B","line_target":"失效 は 何ですか。","line_vi":"失效 là cái gì?","focus_words":["失效"]},{"speaker":"A","line_target":"委内瑞拉です。","line_vi":"Đó là 委内瑞拉.","focus_words":["委内瑞拉"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d68bd9a3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「央行」 có nghĩa là gì?","options":["ngân hàng trung ương","không hợp lệ","Venezuela","Sẽ"],"answer_index":0,"explanation":"央行 = ngân hàng trung ương"},{"question":"Từ 「失效」 có nghĩa là gì?","options":["không hợp lệ","ngân hàng trung ương","Venezuela","Sẽ"],"answer_index":0,"explanation":"失效 = không hợp lệ"},{"question":"Từ 「委内瑞拉」 có nghĩa là gì?","options":["Venezuela","ngân hàng trung ương","không hợp lệ","Sẽ"],"answer_index":0,"explanation":"委内瑞拉 = Venezuela"},{"question":"Từ 「威尔」 có nghĩa là gì?","options":["Sẽ","ngân hàng trung ương","không hợp lệ","Venezuela"],"answer_index":0,"explanation":"威尔 = Sẽ"},{"question":"Từ 「宝石」 có nghĩa là gì?","options":["đá quý","ngân hàng trung ương","không hợp lệ","Venezuela"],"answer_index":0,"explanation":"宝石 = đá quý"},{"question":"Từ 「实事求是」 có nghĩa là gì?","options":["Tìm kiếm sự thật từ sự thật","ngân hàng trung ương","không hợp lệ","Venezuel