_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 611","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"屋里を 使います。","line_vi":"Tôi dùng 屋里.","focus_words":["屋里"]},{"speaker":"B","line_target":"崭新 は 何ですか。","line_vi":"崭新 là cái gì?","focus_words":["崭新"]},{"speaker":"A","line_target":"幼儿です。","line_vi":"Đó là 幼儿.","focus_words":["幼儿"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2c48e9d2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「屋里」 có nghĩa là gì?","options":["trong nhà","hoàn toàn mới","trẻ mới biết đi","chì"],"answer_index":0,"explanation":"屋里 = trong nhà"},{"question":"Từ 「崭新」 có nghĩa là gì?","options":["hoàn toàn mới","trong nhà","trẻ mới biết đi","chì"],"answer_index":0,"explanation":"崭新 = hoàn toàn mới"},{"question":"Từ 「幼儿」 có nghĩa là gì?","options":["trẻ mới biết đi","trong nhà","hoàn toàn mới","chì"],"answer_index":0,"explanation":"幼儿 = trẻ mới biết đi"},{"question":"Từ 「引领」 có nghĩa là gì?","options":["chì","trong nhà","hoàn toàn mới","trẻ mới biết đi"],"answer_index":0,"explanation":"引领 = chì"},{"question":"Từ 「忠实」 có nghĩa là gì?","options":["trung thành","trong nhà","hoàn toàn mới","trẻ mới biết đi"],"answer_index":0,"explanation":"忠实 = trung thành"},{"question":"Từ 「念头」 có nghĩa là gì?","options":["suy nghĩ","trong nhà","hoàn toàn mới","trẻ mới biết đi"],"answer_index":0,"explanation":"念头 = suy nghĩ"},{"question":"Từ 「恐龙」 có nghĩa là gì?","options":["khủng long","trong nhà","hoàn toàn mới","trẻ mới biết đi"],"answer_index":0,"explanation":"恐龙 = kh