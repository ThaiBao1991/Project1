y báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2489","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"idolを 使います。","line_vi":"Tôi dùng idol.","focus_words":["idol"]},{"speaker":"B","line_target":"imf は 何ですか。","line_vi":"imf là cái gì?","focus_words":["imf"]},{"speaker":"A","line_target":"jenniferです。","line_vi":"Đó là jennifer.","focus_words":["jennifer"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e2ce5fd5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「idol」 có nghĩa là gì?","options":["thần tượng","imf","jennifer","cuộc sống"],"answer_index":0,"explanation":"idol = thần tượng"},{"question":"Từ 「imf」 có nghĩa là gì?","options":["imf","thần tượng","jennifer","cuộc sống"],"answer_index":0,"explanation":"imf = imf"},{"question":"Từ 「jennifer」 có nghĩa là gì?","options":["jennifer","thần tượng","imf","cuộc sống"],"answer_index":0,"explanation":"jennifer = jennifer"},{"question":"Từ 「lives」 có nghĩa là gì?","options":["cuộc sống","thần tượng","imf","jennifer"],"answer_index":0,"explanation":"lives = cuộc sống"},{"question":"Từ 「maya」 có nghĩa là gì?","options":["maya","thần tượng","imf","jennifer"],"answer_index":0,"explanation":"maya = maya"},{"question":"Từ 「nothing」 có nghĩa là gì?","options":["không có gì","thần tượng","imf","jennifer"],"answer_index":0,"explanation":"nothing = không có gì"},{"question":"Từ 「personal」 có nghĩa là gì?","options":["cá nhân","thần tượng","imf","jennifer"],"answer_index":0,"ex