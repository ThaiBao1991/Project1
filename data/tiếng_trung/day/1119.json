 ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1119","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"居家を 使います。","line_vi":"Tôi dùng 居家.","focus_words":["居家"]},{"speaker":"B","line_target":"岳父 は 何ですか。","line_vi":"岳父 là cái gì?","focus_words":["岳父"]},{"speaker":"A","line_target":"差劲です。","line_vi":"Đó là 差劲.","focus_words":["差劲"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_66c5c4f2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「居家」 có nghĩa là gì?","options":["nhà","bố chồng","Nghèo","tòa thị chính"],"answer_index":0,"explanation":"居家 = nhà"},{"question":"Từ 「岳父」 có nghĩa là gì?","options":["bố chồng","nhà","Nghèo","tòa thị chính"],"answer_index":0,"explanation":"岳父 = bố chồng"},{"question":"Từ 「差劲」 có nghĩa là gì?","options":["Nghèo","nhà","bố chồng","tòa thị chính"],"answer_index":0,"explanation":"差劲 = Nghèo"},{"question":"Từ 「市府」 có nghĩa là gì?","options":["tòa thị chính","nhà","bố chồng","Nghèo"],"answer_index":0,"explanation":"市府 = tòa thị chính"},{"question":"Từ 「开封」 có nghĩa là gì?","options":["khai phong","nhà","bố chồng","Nghèo"],"answer_index":0,"explanation":"开封 = khai phong"},{"question":"Từ 「开放式」 có nghĩa là gì?","options":["mở","nhà","bố chồng","Nghèo"],"answer_index":0,"explanation":"开放式 = mở"},{"question":"Từ 「强壮」 có nghĩa là gì?","options":["mạnh mẽ","nhà","bố chồng","Nghèo"],"answer_index":0,"explanation":"强壮 = mạnh mẽ"},{"question":"Từ 「强权」 có nghĩa là gì?","options":["quyền lực","nhà","bố chồng","Nghèo"],"answer_index":0,"explanation":"强权 = quyền lực"}],"patter