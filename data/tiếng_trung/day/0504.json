":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 504","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"阵营を 使います。","line_vi":"Tôi dùng 阵营.","focus_words":["阵营"]},{"speaker":"B","line_target":"陌生人 は 何ですか。","line_vi":"陌生人 là cái gì?","focus_words":["陌生人"]},{"speaker":"A","line_target":"震撼です。","line_vi":"Đó là 震撼.","focus_words":["震撼"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_da37543b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「阵营」 có nghĩa là gì?","options":["trại","người lạ","bị sốc","buổi hòa nhạc"],"answer_index":0,"explanation":"阵营 = trại"},{"question":"Từ 「陌生人」 có nghĩa là gì?","options":["người lạ","trại","bị sốc","buổi hòa nhạc"],"answer_index":0,"explanation":"陌生人 = người lạ"},{"question":"Từ 「震撼」 có nghĩa là gì?","options":["bị sốc","trại","người lạ","buổi hòa nhạc"],"answer_index":0,"explanation":"震撼 = bị sốc"},{"question":"Từ 「音乐会」 có nghĩa là gì?","options":["buổi hòa nhạc","trại","người lạ","bị sốc"],"answer_index":0,"explanation":"音乐会 = buổi hòa nhạc"},{"question":"Từ 「领导者」 có nghĩa là gì?","options":["lãnh đạo","trại","người lạ","bị sốc"],"answer_index":0,"explanation":"领导者 = lãnh đạo"},{"question":"Từ 「餐馆」 có nghĩa là gì?","options":["nhà hàng","trại","người lạ","bị sốc"],"answer_index":0,"explanation":"餐馆 = nhà hàng"},{"question":"Từ 「don」 có nghĩa là gì?","options":["không","trại","người lạ","bị sốc"],"answer_index":0,"explanation":"don = không"},{"question":"Từ 「press」 có nghĩa là gì?","options":["nhấn","trại","người lạ","bị 