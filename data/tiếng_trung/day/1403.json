ù thủy","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1934e0ef","audio_ref":"m_fc971ee3","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_c548d984"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]},{"title":"Dạng nối 〜て","level":"N3","explanation":"Dạng te nối hai động từ: 書いて + 読む; cũng dùng cho lý do nhẹ (寒くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1403","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"寄生を 使います。","line_vi":"Tôi dùng 寄生.","focus_words":["寄生"]},{"speaker":"B","line_target":"富翁 は 何ですか。","line_vi":"富翁 là cái gì?","focus_words":["富翁"]},{"speaker":"A","line_target":"寡头です。","line_vi":"Đó là 寡头.","focus_words":["寡头"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_036f1724","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「寄生」 có nghĩa là gì?","options":["Ký sinh trùng","người đàn ông giàu có","đầu sỏ chính trị","quy mô nhỏ"],"answer_index":0,"explanation":"寄生 = Ký sinh trùng"},{"question":"Từ 「富翁」 có nghĩa là gì?","options":["người đàn ông giàu có","Ký sinh trùng","đầu sỏ chính trị","quy mô nhỏ"],"answer_index":0,"explanation":"富翁 = người đàn ông giàu có"},{"question":"Từ 「寡头」 có nghĩa là gì?","options":["đầu sỏ chính trị","Ký sinh trùng","người đàn ông giàu có","quy mô nhỏ"],"answer_index":0,"explanation":"寡头 = đầu sỏ chính trị"},{"question":"Từ 「小规模」 có nghĩa là gì?","options":["quy mô nhỏ","Ký sinh trùng","người đàn ông giàu có","đầu sỏ chính trị"],"answer_index":0,"explanation":"小规模 = quy mô nhỏ"},{"question":"Từ 「少校」 có nghĩa là gì?","options":["Thiếu tá","Ký sinh trùng","người đàn ông giàu có","đầu sỏ chính trị"],"answer_index":0,"explanation":"少校 = Thiếu tá"},{"question":"Từ 「少许」 có nghĩa là gì?","options":["Một c