g."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2211","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"baseを 使います。","line_vi":"Tôi dùng base.","focus_words":["base"]},{"speaker":"B","line_target":"bernard は 何ですか。","line_vi":"bernard là cái gì?","focus_words":["bernard"]},{"speaker":"A","line_target":"birdです。","line_vi":"Đó là bird.","focus_words":["bird"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d86352a1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「base」 có nghĩa là gì?","options":["căn cứ","Bernard","chim","bmw"],"answer_index":0,"explanation":"base = căn cứ"},{"question":"Từ 「bernard」 có nghĩa là gì?","options":["Bernard","căn cứ","chim","bmw"],"answer_index":0,"explanation":"bernard = Bernard"},{"question":"Từ 「bird」 có nghĩa là gì?","options":["chim","căn cứ","Bernard","bmw"],"answer_index":0,"explanation":"bird = chim"},{"question":"Từ 「bmw」 có nghĩa là gì?","options":["bmw","căn cứ","Bernard","chim"],"answer_index":0,"explanation":"bmw = bmw"},{"question":"Từ 「carlos」 có nghĩa là gì?","options":["Carlos","căn cứ","Bernard","chim"],"answer_index":0,"explanation":"carlos = Carlos"},{"question":"Từ 「carter」 có nghĩa là gì?","options":["người vận chuyển","căn cứ","Bernard","chim"],"answer_index":0,"explanation":"carter = người vận chuyển"},{"question":"Từ 「church」 có nghĩa là gì?","options":["nhà thờ","căn cứ","Bernard","chim"],"answer_index":0,"explanation":"church = nhà thờ"},{"question":"Từ 「daddy」 có nghĩa là gì?","options":["bố","căn