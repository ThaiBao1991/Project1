_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1006","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"本体を 使います。","line_vi":"Tôi dùng 本体.","focus_words":["本体"]},{"speaker":"B","line_target":"本片 は 何ですか。","line_vi":"本片 là cái gì?","focus_words":["本片"]},{"speaker":"A","line_target":"来个です。","line_vi":"Đó là 来个.","focus_words":["来个"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4ce5cc37","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「本体」 có nghĩa là gì?","options":["Bản thể học","Bộ phim này","Thôi nào","khách"],"answer_index":0,"explanation":"本体 = Bản thể học"},{"question":"Từ 「本片」 có nghĩa là gì?","options":["Bộ phim này","Bản thể học","Thôi nào","khách"],"answer_index":0,"explanation":"本片 = Bộ phim này"},{"question":"Từ 「来个」 có nghĩa là gì?","options":["Thôi nào","Bản thể học","Bộ phim này","khách"],"answer_index":0,"explanation":"来个 = Thôi nào"},{"question":"Từ 「来宾」 có nghĩa là gì?","options":["khách","Bản thể học","Bộ phim này","Thôi nào"],"answer_index":0,"explanation":"来宾 = khách"},{"question":"Từ 「核武」 có nghĩa là gì?","options":["Vũ khí hạt nhân","Bản thể học","Bộ phim này","Thôi nào"],"answer_index":0,"explanation":"核武 = Vũ khí hạt nhân"},{"question":"Từ 「核电站」 có nghĩa là gì?","options":["nhà máy điện hạt nhân","Bản thể học","Bộ phim này","Thôi nào"],"answer_index":0,"explanation":"核电站 = nhà máy điện hạt nhân"},{"question":"Từ 「格鲁吉亚」 có nghĩa là gì?","options":["bang Georgia","Bản thể học","Bộ phim này","Thôi nào"],"answer_index":0,"explanation":"格鲁吉亚 = bang Georgia"}