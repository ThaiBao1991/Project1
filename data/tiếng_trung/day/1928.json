":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1928","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"很帅を 使います。","line_vi":"Tôi dùng 很帅.","focus_words":["很帅"]},{"speaker":"B","line_target":"得益于 は 何ですか。","line_vi":"得益于 là cái gì?","focus_words":["得益于"]},{"speaker":"A","line_target":"快播です。","line_vi":"Đó là 快播.","focus_words":["快播"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7a22f854","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「很帅」 có nghĩa là gì?","options":["Rất đẹp trai","Hưởng lợi từ","Phát sóng nhanh","khẩn cấp"],"answer_index":0,"explanation":"很帅 = Rất đẹp trai"},{"question":"Từ 「得益于」 có nghĩa là gì?","options":["Hưởng lợi từ","Rất đẹp trai","Phát sóng nhanh","khẩn cấp"],"answer_index":0,"explanation":"得益于 = Hưởng lợi từ"},{"question":"Từ 「快播」 có nghĩa là gì?","options":["Phát sóng nhanh","Rất đẹp trai","Hưởng lợi từ","khẩn cấp"],"answer_index":0,"explanation":"快播 = Phát sóng nhanh"},{"question":"Từ 「急诊」 có nghĩa là gì?","options":["khẩn cấp","Rất đẹp trai","Hưởng lợi từ","Phát sóng nhanh"],"answer_index":0,"explanation":"急诊 = khẩn cấp"},{"question":"Từ 「总线」 có nghĩa là gì?","options":["xe buýt","Rất đẹp trai","Hưởng lợi từ","Phát sóng nhanh"],"answer_index":0,"explanation":"总线 = xe buýt"},{"question":"Từ 「恼怒」 có nghĩa là gì?","options":["tức giận","Rất đẹp trai","Hưởng lợi từ","Phát sóng nhanh"],"answer_index":0,"explanation":"恼怒 = tức giận"},{"question":"Từ 「悄悄地」 có nghĩa là gì?","options":["lặng lẽ","Rất đẹp trai","Hưởng lợi từ","Phát sóng nhanh"],"answer_index":0,"explanation":"悄悄地 = lặng lẽ"},{"questio