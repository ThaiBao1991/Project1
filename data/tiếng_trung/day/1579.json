planation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1579","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"受骗を 使います。","line_vi":"Tôi dùng 受骗.","focus_words":["受骗"]},{"speaker":"B","line_target":"古建筑 は 何ですか。","line_vi":"古建筑 là cái gì?","focus_words":["古建筑"]},{"speaker":"A","line_target":"各市です。","line_vi":"Đó là 各市.","focus_words":["各市"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3bdccc08","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「受骗」 có nghĩa là gì?","options":["bị lừa dối","tòa nhà cổ","thành phố","Kyrgyzstan"],"answer_index":0,"explanation":"受骗 = bị lừa dối"},{"question":"Từ 「古建筑」 có nghĩa là gì?","options":["tòa nhà cổ","bị lừa dối","thành phố","Kyrgyzstan"],"answer_index":0,"explanation":"古建筑 = tòa nhà cổ"},{"question":"Từ 「各市」 có nghĩa là gì?","options":["thành phố","bị lừa dối","tòa nhà cổ","Kyrgyzstan"],"answer_index":0,"explanation":"各市 = thành phố"},{"question":"Từ 「吉尔吉斯斯坦」 có nghĩa là gì?","options":["Kyrgyzstan","bị lừa dối","tòa nhà cổ","thành phố"],"answer_index":0,"explanation":"吉尔吉斯斯坦 = Kyrgyzstan"},{"question":"Từ 「名列前茅」 có nghĩa là gì?","options":["trong số những điều tốt nhất","bị lừa dối","tòa nhà cổ","thành phố"],"answer_index":0,"explanation":"名列前茅 = trong số những điều tốt nhất"},{"question":"Từ 「听证」 có nghĩa là gì?","options":["thính giác","bị lừa dối","tòa nhà cổ","thàn