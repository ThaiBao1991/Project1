aning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 754","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"额度を 使います。","line_vi":"Tôi dùng 额度.","focus_words":["额度"]},{"speaker":"B","line_target":"食堂 は 何ですか。","line_vi":"食堂 là cái gì?","focus_words":["食堂"]},{"speaker":"A","line_target":"验收です。","line_vi":"Đó là 验收.","focus_words":["验收"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c6773e90","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「额度」 có nghĩa là gì?","options":["hạn ngạch","căng tin","Chấp nhận","xã hội đen"],"answer_index":0,"explanation":"额度 = hạn ngạch"},{"question":"Từ 「食堂」 có nghĩa là gì?","options":["căng tin","hạn ngạch","Chấp nhận","xã hội đen"],"answer_index":0,"explanation":"食堂 = căng tin"},{"question":"Từ 「验收」 có nghĩa là gì?","options":["Chấp nhận","hạn ngạch","căng tin","xã hội đen"],"answer_index":0,"explanation":"验收 = Chấp nhận"},{"question":"Từ 「黑帮」 có nghĩa là gì?","options":["xã hội đen","hạn ngạch","căng tin","Chấp nhận"],"answer_index":0,"explanation":"黑帮 = xã hội đen"},{"question":"Từ 「asia」 có nghĩa là gì?","options":["Châu Á","hạn ngạch","căng tin","Chấp nhận"],"answer_index":0,"explanation":"asia = Châu Á"},{"question":"Từ 「cm」 có nghĩa là gì?","options":["cmt","hạn ngạch","căng tin","Chấp nhận"],"answer_index":0,"explanation":"cm = cmt"},{"question":"Từ 「fbi」 có nghĩa là gì?","options":["FBI","hạn ngạch","căng tin","Chấp nhận"],"answer_index":0,"explanation":"fbi = FBI"},{"question":"Từ 「happy」 có nghĩa là gì?","options":["hạnh phúc","hạn ngạ