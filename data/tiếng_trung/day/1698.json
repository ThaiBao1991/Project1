 e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1698","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"显眼を 使います。","line_vi":"Tôi dùng 显眼.","focus_words":["显眼"]},{"speaker":"B","line_target":"晨报 は 何ですか。","line_vi":"晨报 là cái gì?","focus_words":["晨报"]},{"speaker":"A","line_target":"有形です。","line_vi":"Đó là 有形.","focus_words":["有形"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bdef8f00","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「显眼」 có nghĩa là gì?","options":["dễ thấy","báo buổi sáng","Hữu hình","ngựa thành Troy"],"answer_index":0,"explanation":"显眼 = dễ thấy"},{"question":"Từ 「晨报」 có nghĩa là gì?","options":["báo buổi sáng","dễ thấy","Hữu hình","ngựa thành Troy"],"answer_index":0,"explanation":"晨报 = báo buổi sáng"},{"question":"Từ 「有形」 có nghĩa là gì?","options":["Hữu hình","dễ thấy","báo buổi sáng","ngựa thành Troy"],"answer_index":0,"explanation":"有形 = Hữu hình"},{"question":"Từ 「木马」 có nghĩa là gì?","options":["ngựa thành Troy","dễ thấy","báo buổi sáng","Hữu hình"],"answer_index":0,"explanation":"木马 = ngựa thành Troy"},{"question":"Từ 「柜子」 có nghĩa là gì?","options":["tủ","dễ thấy","báo buổi sáng","Hữu hình"],"answer_index":0,"explanation":"柜子 = tủ"},{"question":"Từ 「校名」 có nghĩa là gì?","options":["Tên trường","dễ thấy","báo buổi sáng","Hữu hình"],"answer_index":0,"explanation":"校名 = Tên trường"},{"question":"Từ 「梁启超」 có nghĩa là gì?","options":["Lương Khải Siêu","dễ thấy","báo buổi sáng","Hữu hình"],"answer_index":0,"explanation":"梁启超 = Lương Khải Siêu"},{"question":"Từ 「检修」 có nghĩa là gì?","options":["Đại tu","dễ thấy","báo buổi sáng","Hữu hì