 việc — Ngày 916","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"stopを 使います。","line_vi":"Tôi dùng stop.","focus_words":["stop"]},{"speaker":"B","line_target":"taiwan は 何ですか。","line_vi":"taiwan là cái gì?","focus_words":["taiwan"]},{"speaker":"A","line_target":"zhです。","line_vi":"Đó là zh.","focus_words":["zh"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「stop」 có nghĩa là gì?","options":["dừng lại","Đài Loan","zh","một quốc gia"],"answer_index":0,"explanation":"stop = dừng lại"},{"question":"Từ 「taiwan」 có nghĩa là gì?","options":["Đài Loan","dừng lại","zh","một quốc gia"],"answer_index":0,"explanation":"taiwan = Đài Loan"},{"question":"Từ 「zh」 có nghĩa là gì?","options":["zh","dừng lại","Đài Loan","một quốc gia"],"answer_index":0,"explanation":"zh = zh"},{"question":"Từ 「一国」 có nghĩa là gì?","options":["một quốc gia","dừng lại","Đài Loan","zh"],"answer_index":0,"explanation":"一国 = một quốc gia"},{"question":"Từ 「一波」 có nghĩa là gì?","options":["một làn sóng","dừng lại","Đài Loan","zh"],"answer_index":0,"explanation":"一波 = một làn sóng"},{"question":"Từ 「一脚」 có nghĩa là gì?","options":["cú đá","dừng lại","Đài Loan","zh"],"answer_index":0,"explanation":"一脚 = cú đá"},{"question":"Từ 「一说」 có nghĩa là gì?","options":["Một điều cần nói","dừng lại","Đài Loan","zh"],"answer_index":0,"explanation":"一说 = Một điều cần nói"},{"question":"Từ 「不久前」 có nghĩa là gì?","options":["cách đây không lâu","dừng lại","Đài Loan","zh"],"answer_index":0,"explanation":"不久前 = cách đây không lâu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: dừng lại","options":["stop","taiwan","zh","一国"],"answer_index":0,"explanation":"stop = dừng lại"},{"question":"Chọn từ đúng cho nghĩa: Đài Loan","options":["taiwan","stop","zh",