iệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 728","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"发扬を 使います。","line_vi":"Tôi dùng 发扬.","focus_words":["发扬"]},{"speaker":"B","line_target":"发现自己 は 何ですか。","line_vi":"发现自己 là cái gì?","focus_words":["发现自己"]},{"speaker":"A","line_target":"取决です。","line_vi":"Đó là 取决.","focus_words":["取决"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9f795440","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「发扬」 có nghĩa là gì?","options":["tiến về phía trước","tìm thấy chính mình","Phụ thuộc","Lấy từ"],"answer_index":0,"explanation":"发扬 = tiến về phía trước"},{"question":"Từ 「发现自己」 có nghĩa là gì?","options":["tìm thấy chính mình","tiến về phía trước","Phụ thuộc","Lấy từ"],"answer_index":0,"explanation":"发现自己 = tìm thấy chính mình"},{"question":"Từ 「取决」 có nghĩa là gì?","options":["Phụ thuộc","tiến về phía trước","tìm thấy chính mình","Lấy từ"],"answer_index":0,"explanation":"取决 = Phụ thuộc"},{"question":"Từ 「取自」 có nghĩa là gì?","options":["Lấy từ","tiến về phía trước","tìm thấy chính mình","Phụ thuộc"],"answer_index":0,"explanation":"取自 = Lấy từ"},{"question":"Từ 「口头」 có nghĩa là gì?","options":["Bằng miệng","tiến về phía trước","tìm thấy chính mình","Phụ thuộc"],"answer_index":0,"explanation":"口头 = Bằng miệng"},{"question":"Từ 「台词」 có nghĩa là gì?","options":["dòng","tiến về phía