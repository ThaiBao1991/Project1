ì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 475","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"扶贫を 使います。","line_vi":"Tôi dùng 扶贫.","focus_words":["扶贫"]},{"speaker":"B","line_target":"排行榜 は 何ですか。","line_vi":"排行榜 là cái gì?","focus_words":["排行榜"]},{"speaker":"A","line_target":"政客です。","line_vi":"Đó là 政客.","focus_words":["政客"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f97bd786","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「扶贫」 có nghĩa là gì?","options":["Xóa đói giảm nghèo","Danh sách xếp hạng","chính trị gia","Cách mạng văn hóa"],"answer_index":0,"explanation":"扶贫 = Xóa đói giảm nghèo"},{"question":"Từ 「排行榜」 có nghĩa là gì?","options":["Danh sách xếp hạng","Xóa đói giảm nghèo","chính trị gia","Cách mạng văn hóa"],"answer_index":0,"explanation":"排行榜 = Danh sách xếp hạng"},{"question":"Từ 「政客」 có nghĩa là gì?","options":["chính trị gia","Xóa đói giảm nghèo","Danh sách xếp hạng","Cách mạng văn hóa"],"answer_index":0,"explanation":"政客 = chính trị gia"},{"question":"Từ 「文革」 có nghĩa là gì?","options":["Cách mạng văn hóa","Xóa đói giảm nghèo","Danh sách xếp hạng","chính trị gia"],"answer_index":0,"explanation":"文革 = Cách mạng văn hóa"},{"question":"Từ 「早餐」 có nghĩa là gì?","options":["bữa ăn sáng","Xóa đói giảm nghèo","Danh sách xếp hạng","chính trị gia"],"answer_index":0,"explanation":"早餐 = bữa ăn sáng"},