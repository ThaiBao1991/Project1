"example_vi":"","image_prompt":null,"image_ref":"m_c1da6d4f","audio_ref":"m_74481281","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_0b8d66bf"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2276","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"该会を 使います。","line_vi":"Tôi dùng 该会.","focus_words":["该会"]},{"speaker":"B","line_target":"该名 は 何ですか。","line_vi":"该名 là cái gì?","focus_words":["该名"]},{"speaker":"A","line_target":"说说话です。","line_vi":"Đó là 说说话.","focus_words":["说说话"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b7f059ad","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「该会」 có nghĩa là gì?","options":["hiệp hội","cái tên","nói chuyện","câu đố"],"answer_index":0,"explanation":"该会 = hiệp hội"},{"question":"Từ 「该名」 có nghĩa là gì?","options":["cái tên","hiệp hội","nói chuyện","câu đố"],"answer_index":0,"explanation":"该名 = cái tên"},{"question":"Từ 「说说话」 có nghĩa là gì?","options":["nói chuyện","hiệp hội","cái tên","câu đố"],"answer_index":0,"explanation":"说说话 = nói chuyện"},{"question":"Từ 「谜语」 có nghĩa là gì?","options":["câu đố","hiệp hội","cái tên","nói chuyện"],"answer_index":0,"explanation":"谜语 = câu đố"},{"question":"Từ 「豆类」 có nghĩa là gì?","options":["đậu","hiệp hội","cái tên","nói chuyện"],"answer_index":0,"explanation":"豆类 = đậu"},{"question":"Từ 「贝斯」 có nghĩa là gì?","options":["âm trầm","hiệp hội","cái tên","nói chuyện"],"answer_index":0,"explanation":"贝斯 = âm trầm"},{"question":"Từ 「赞颂」 có nghĩa là gì?","options":["khen ngợi","hiệp hội","cái tên","nói chuyện"],"answer_index":0,"explanation":"赞颂 = khen ngợi"},{"question":"Từ 「赤脚」 có nghĩa là gì?","options":["chân trần","hi