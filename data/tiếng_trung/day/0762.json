e_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_10ea05fe","audio_ref":"m_a8aac781","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_a9dfc808"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 762","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"插图を 使います。","line_vi":"Tôi dùng 插图.","focus_words":["插图"]},{"speaker":"B","line_target":"擅自 は 何ですか。","line_vi":"擅自 là cái gì?","focus_words":["擅自"]},{"speaker":"A","line_target":"收听です。","line_vi":"Đó là 收听.","focus_words":["收听"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fc001535","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「插图」 có nghĩa là gì?","options":["hình minh họa","Không có sự cho phép","lắng nghe","kỳ nghỉ"],"answer_index":0,"explanation":"插图 = hình minh họa"},{"question":"Từ 「擅自」 có nghĩa là gì?","options":["Không có sự cho phép","hình minh họa","lắng nghe","kỳ nghỉ"],"answer_index":0,"explanation":"擅自 = Không có sự cho phép"},{"question":"Từ 「收听」 có nghĩa là gì?","options":["lắng nghe","hình minh họa","Không có sự cho phép","kỳ nghỉ"],"answer_index":0,"explanation":"收听 = lắng nghe"},{"question":"Từ 「放假」 có nghĩa là gì?","options":["kỳ nghỉ","hình minh họa","Không có sự cho phép","lắng nghe"],"answer_index":0,"explanation":"放假 = kỳ nghỉ"},{"question":"Từ 「数次」 có nghĩa là gì?","options":["nhiều lần","hình minh họa","Không có sự cho phép","lắng nghe"],"answer_index":0,"explanation":"数次 = nhiều lần"},{"question":"Từ 「施压」 có nghĩa là gì?","options":["gây áp lực","hình minh họa","Không có sự cho phép","lắng nghe"],"answer_index"