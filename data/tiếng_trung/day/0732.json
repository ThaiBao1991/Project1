ứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 732","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"扰乱を 使います。","line_vi":"Tôi dùng 扰乱.","focus_words":["扰乱"]},{"speaker":"B","line_target":"投产 は 何ですか。","line_vi":"投产 là cái gì?","focus_words":["投产"]},{"speaker":"A","line_target":"提早です。","line_vi":"Đó là 提早.","focus_words":["提早"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cb1702fb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「扰乱」 có nghĩa là gì?","options":["làm phiền","Đưa vào sản xuất","sớm","xây dựng"],"answer_index":0,"explanation":"扰乱 = làm phiền"},{"question":"Từ 「投产」 có nghĩa là gì?","options":["Đưa vào sản xuất","làm phiền","sớm","xây dựng"],"answer_index":0,"explanation":"投产 = Đưa vào sản xuất"},{"question":"Từ 「提早」 có nghĩa là gì?","options":["sớm","làm phiền","Đưa vào sản xuất","xây dựng"],"answer_index":0,"explanation":"提早 = sớm"},{"question":"Từ 「搭建」 có nghĩa là gì?","options":["xây dựng","làm phiền","Đưa vào sản xuất","sớm"],"answer_index":0,"explanation":"搭建 = xây dựng"},{"question":"Từ 「搭档」 có nghĩa là gì?","options":["Đối tác","làm phiền","Đưa vào sản xuất","sớm"],"answer_index":0,"explanation":"搭档 = Đối tác"},{"question":"Từ 「斯坦」 có nghĩa là gì?","options":["Stan","làm phiền","Đưa vào sản xuất","sớm"],"answer_index":0,"explanation":"斯坦 = Stan"},{"question":"Từ 「新高」 có nghĩa là gì?","options":["mức cao mới","làm phiền","Đưa vào sản xuất","sớm"],"an