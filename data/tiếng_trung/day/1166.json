":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e6099c5e","audio_ref":"m_3cb294e1","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_805514b5"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1166","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"水灾を 使います。","line_vi":"Tôi dùng 水灾.","focus_words":["水灾"]},{"speaker":"B","line_target":"水管 は 何ですか。","line_vi":"水管 là cái gì?","focus_words":["水管"]},{"speaker":"A","line_target":"污染物です。","line_vi":"Đó là 污染物.","focus_words":["污染物"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_17773b8d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「水灾」 có nghĩa là gì?","options":["lũ lụt","ống nước","chất ô nhiễm","nước ngọt"],"answer_index":0,"explanation":"水灾 = lũ lụt"},{"question":"Từ 「水管」 có nghĩa là gì?","options":["ống nước","lũ lụt","chất ô nhiễm","nước ngọt"],"answer_index":0,"explanation":"水管 = ống nước"},{"question":"Từ 「污染物」 có nghĩa là gì?","options":["chất ô nhiễm","lũ lụt","ống nước","nước ngọt"],"answer_index":0,"explanation":"污染物 = chất ô nhiễm"},{"question":"Từ 「汽水」 có nghĩa là gì?","options":["nước ngọt","lũ lụt","ống nước","chất ô nhiễm"],"answer_index":0,"explanation":"汽水 = nước ngọt"},{"question":"Từ 「法学院」 có nghĩa là gì?","options":["trường luật","lũ lụt","ống nước","chất ô nhiễm"],"answer_index":0,"explanation":"法学院 = trường luật"},{"question":"Từ 「波多黎各」 có nghĩa là gì?","options":["Puerto Rico","lũ lụt","ống nước","chất ô nhiễm"],"answer_index":0,"explanation":"波多黎各 = Puerto Rico"},{"question":"Từ 「波长」 có nghĩa là gì?","options":["Bước sóng","lũ lụt","ống nước","chất ô nhiễm"],"answer_index":0,"explanation":"波长 = Bước sóng