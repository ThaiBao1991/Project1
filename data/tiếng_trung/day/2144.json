n."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2144","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"债务人を 使います。","line_vi":"Tôi dùng 债务人.","focus_words":["债务人"]},{"speaker":"B","line_target":"倾城 は 何ですか。","line_vi":"倾城 là cái gì?","focus_words":["倾城"]},{"speaker":"A","line_target":"健美です。","line_vi":"Đó là 健美.","focus_words":["健美"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_656e150a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「债务人」 có nghĩa là gì?","options":["con nợ","quyến rũ","thể hình","bẩm sinh"],"answer_index":0,"explanation":"债务人 = con nợ"},{"question":"Từ 「倾城」 có nghĩa là gì?","options":["quyến rũ","con nợ","thể hình","bẩm sinh"],"answer_index":0,"explanation":"倾城 = quyến rũ"},{"question":"Từ 「健美」 có nghĩa là gì?","options":["thể hình","con nợ","quyến rũ","bẩm sinh"],"answer_index":0,"explanation":"健美 = thể hình"},{"question":"Từ 「先天性」 có nghĩa là gì?","options":["bẩm sinh","con nợ","quyến rũ","thể hình"],"answer_index":0,"explanation":"先天性 = bẩm sinh"},{"question":"Từ 「全明星」 có nghĩa là gì?","options":["tất cả các ngôi sao","con nợ","quyến rũ","thể hình"],"answer_index":0,"explanation":"全明星 = tất cả các ngôi sao"},{"question":"Từ 「公演」 có nghĩa là gì?","options":["Hiệu suất","con nợ","quyến rũ","thể hình"],"answer_index":0,"explanation":"公演 = Hiệu suất"},{"question":"Từ 「公费」 có nghĩa là gì?","options":["Chi tiêu công","con nợ","quyến rũ","thể hình"],"answer_index":0,"explanation":"公费 = Chi tiêu công"},{"question":"T