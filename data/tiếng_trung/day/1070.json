ence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1070","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"乘车を 使います。","line_vi":"Tôi dùng 乘车.","focus_words":["乘车"]},{"speaker":"B","line_target":"书院 は 何ですか。","line_vi":"书院 là cái gì?","focus_words":["书院"]},{"speaker":"A","line_target":"人要です。","line_vi":"Đó là 人要.","focus_words":["人要"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d802f3b9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「乘车」 có nghĩa là gì?","options":["Đi một chuyến","Học viện","Mọi người muốn","Cả hai người họ"],"answer_index":0,"explanation":"乘车 = Đi một chuyến"},{"question":"Từ 「书院」 có nghĩa là gì?","options":["Học viện","Đi một chuyến","Mọi người muốn","Cả hai người họ"],"answer_index":0,"explanation":"书院 = Học viện"},{"question":"Từ 「人要」 có nghĩa là gì?","options":["Mọi người muốn","Đi một chuyến","Học viện","Cả hai người họ"],"answer_index":0,"explanation":"人要 = Mọi người muốn"},{"question":"Từ 「他俩」 có nghĩa là gì?","options":["Cả hai người họ","Đi một chuyến","Học viện","Mọi người muốn"],"answer_index":0,"explanation":"他俩 = Cả hai người họ"},{"question":"Từ 「任免」 có nghĩa là gì?","options":["Bổ nhiệm và bãi nhiệm","Đi một chuyến","Học viện","Mọi người muốn"],"answer_index":0,"explanation":"任免 = Bổ nhiệm và bãi nhiệm"},{"question":"Từ 「修道院」 có nghĩa là gì?","options":["tu viện","Đi một chuyến","Học viện","Mọi người muốn"],"answer_index":0,"explanation":"修道院 = tu viện"},{"question":"Từ 「偷窃」 có ng