phans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 492","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"怀念を 使います。","line_vi":"Tôi dùng 怀念.","focus_words":["怀念"]},{"speaker":"B","line_target":"我来 は 何ですか。","line_vi":"我来 là cái gì?","focus_words":["我来"]},{"speaker":"A","line_target":"抓紧です。","line_vi":"Đó là 抓紧.","focus_words":["抓紧"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b7a4e239","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「怀念」 có nghĩa là gì?","options":["nhớ","tôi sẽ đến","Nhanh lên","phần thưởng"],"answer_index":0,"explanation":"怀念 = nhớ"},{"question":"Từ 「我来」 có nghĩa là gì?","options":["tôi sẽ đến","nhớ","Nhanh lên","phần thưởng"],"answer_index":0,"explanation":"我来 = tôi sẽ đến"},{"question":"Từ 「抓紧」 có nghĩa là gì?","options":["Nhanh lên","nhớ","tôi sẽ đến","phần thưởng"],"answer_index":0,"explanation":"抓紧 = Nhanh lên"},{"question":"Từ 「报酬」 có nghĩa là gì?","options":["phần thưởng","nhớ","tôi sẽ đến","Nhanh lên"],"answer_index":0,"explanation":"报酬 = phần thưởng"},{"question":"Từ 「捍卫」 có nghĩa là gì?","options":["bảo vệ","nhớ","tôi sẽ đến","Nhanh lên"],"answer_index":0,"explanation":"捍卫 = bảo vệ"},{"question":"Từ 「捐赠」 có nghĩa là gì?","options":["Đóng góp","nhớ","tôi sẽ đến","Nhanh lên"],"answer_index":0,"explanation":"捐赠 = Đóng góp"},{"question":"Từ 「掀起」 có nghĩa là gì?","options":["khởi hành","nhớ","tôi sẽ đến","Nhanh lên"],"answer_index":0,"explanation":"掀起 = khởi hành"},{"question":"Từ 「放开」 có nghĩa là gì?","options":["buô