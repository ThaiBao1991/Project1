ence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_dc74f709","audio_ref":"m_9d5a2676","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ea0096bb"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 976","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"第一条を 使います。","line_vi":"Tôi dùng 第一条.","focus_words":["第一条"]},{"speaker":"B","line_target":"组件 は 何ですか。","line_vi":"组件 là cái gì?","focus_words":["组件"]},{"speaker":"A","line_target":"绩效です。","line_vi":"Đó là 绩效.","focus_words":["绩效"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_58e7003c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「第一条」 có nghĩa là gì?","options":["Điều 1","thành phần","hiệu suất","toàn diện"],"answer_index":0,"explanation":"第一条 = Điều 1"},{"question":"Từ 「组件」 có nghĩa là gì?","options":["thành phần","Điều 1","hiệu suất","toàn diện"],"answer_index":0,"explanation":"组件 = thành phần"},{"question":"Từ 「绩效」 có nghĩa là gì?","options":["hiệu suất","Điều 1","thành phần","toàn diện"],"answer_index":0,"explanation":"绩效 = hiệu suất"},{"question":"Từ 「综合性」 có nghĩa là gì?","options":["toàn diện","Điều 1","thành phần","hiệu suất"],"answer_index":0,"explanation":"综合性 = toàn diện"},{"question":"Từ 「绿地」 có nghĩa là gì?","options":["Không gian xanh","Điều 1","thành phần","hiệu suất"],"answer_index":0,"explanation":"绿地 = Không gian xanh"},{"question":"Từ 「编排」 có nghĩa là gì?","options":["Sắp xếp","Điều 1","thành phần","hiệu suất"],"answer_index":0,"explanation":"编排 = Sắp xếp"},{"question":"Từ 「罹患」 có nghĩa là gì?","options":["đau khổ vì","Điều 1","thành phần","hiệu suất"],"answer_index":0,"explanation":"罹患 = đau khổ vì"},{"question":"Từ 「联通」 có nghĩa là gì?","optio