ùng 序言.","focus_words":["序言"]},{"speaker":"B","line_target":"店长 は 何ですか。","line_vi":"店长 là cái gì?","focus_words":["店长"]},{"speaker":"A","line_target":"开价です。","line_vi":"Đó là 开价.","focus_words":["开价"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「序言」 có nghĩa là gì?","options":["Lời nói đầu","quản lý cửa hàng","ưu đãi","Hình dáng giống nhau"],"answer_index":0,"explanation":"序言 = Lời nói đầu"},{"question":"Từ 「店长」 có nghĩa là gì?","options":["quản lý cửa hàng","Lời nói đầu","ưu đãi","Hình dáng giống nhau"],"answer_index":0,"explanation":"店长 = quản lý cửa hàng"},{"question":"Từ 「开价」 có nghĩa là gì?","options":["ưu đãi","Lời nói đầu","quản lý cửa hàng","Hình dáng giống nhau"],"answer_index":0,"explanation":"开价 = ưu đãi"},{"question":"Từ 「形似」 có nghĩa là gì?","options":["Hình dáng giống nhau","Lời nói đầu","quản lý cửa hàng","ưu đãi"],"answer_index":0,"explanation":"形似 = Hình dáng giống nhau"},{"question":"Từ 「徒手」 có nghĩa là gì?","options":["tay trần","Lời nói đầu","quản lý cửa hàng","ưu đãi"],"answer_index":0,"explanation":"徒手 = tay trần"},{"question":"Từ 「微粒」 có nghĩa là gì?","options":["hạt","Lời nói đầu","quản lý cửa hàng","ưu đãi"],"answer_index":0,"explanation":"微粒 = hạt"},{"question":"Từ 「心仪」 có nghĩa là gì?","options":["yêu thích","Lời nói đầu","quản lý cửa hàng","ưu đãi"],"answer_index":0,"explanation":"心仪 = yêu thích"},{"question":"Từ 「心力」 có nghĩa là gì?","options":["nỗ lực tinh thần","Lời nói đầu","quản lý cửa hàng","ưu đãi"],"answer_index":0,"explanation":"心力 = nỗ lực tinh thần"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Lời nói đầu","options":["序言","店长","开价","形似"],"answer_index":0,"explanation":"序言 = Lời nói đầu"},{"question":"Chọn từ đúng cho nghĩa: quản lý cửa hàng","options":["店长","序言","开价","形似"],"answer_index":0,"explanation":"店长 =