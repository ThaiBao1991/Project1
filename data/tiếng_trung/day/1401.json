す。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1401","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"地缘を 使います。","line_vi":"Tôi dùng 地缘.","focus_words":["地缘"]},{"speaker":"B","line_target":"塞浦路斯 は 何ですか。","line_vi":"塞浦路斯 là cái gì?","focus_words":["塞浦路斯"]},{"speaker":"A","line_target":"增值税です。","line_vi":"Đó là 增值税.","focus_words":["增值税"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_12418362","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「地缘」 có nghĩa là gì?","options":["địa lý","Síp","thuế giá trị gia tăng","ngoại giao"],"answer_index":0,"explanation":"地缘 = địa lý"},{"question":"Từ 「塞浦路斯」 có nghĩa là gì?","options":["Síp","địa lý","thuế giá trị gia tăng","ngoại giao"],"answer_index":0,"explanation":"塞浦路斯 = Síp"},{"question":"Từ 「增值税」 có nghĩa là gì?","options":["thuế giá trị gia tăng","địa lý","Síp","ngoại giao"],"answer_index":0,"explanation":"增值税 = thuế giá trị gia tăng"},{"question":"Từ 「外事」 có nghĩa là gì?","options":["ngoại giao","địa lý","Síp","thuế giá trị gia tăng"],"answer_index":0,"explanation":"外事 = ngoại giao"},{"question":"Từ 「外遇」 có nghĩa là gì?","options":["chuyện tình","địa lý","Síp","thuế giá trị gia tăng"],"answer_index":0,"explanation":"外遇 = chuyện tình"},{"question":"Từ 「大成」 có nghĩa là gì?","options":["Đại Thành","địa lý","Síp","thuế giá trị gia tăng"],"answer_index":0,"explanation":"大成 = Đại Thành"},{"question":"Từ 「大有」 có nghĩa là gì?","options":["Đại Du","địa lý","Síp","