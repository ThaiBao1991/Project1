ence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 706","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"后方を 使います。","line_vi":"Tôi dùng 后方.","focus_words":["后方"]},{"speaker":"B","line_target":"后裔 は 何ですか。","line_vi":"后裔 là cái gì?","focus_words":["后裔"]},{"speaker":"A","line_target":"喉咙です。","line_vi":"Đó là 喉咙.","focus_words":["喉咙"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f31e4160","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「后方」 có nghĩa là gì?","options":["phía sau","Con cháu","cổ họng","quốc gia"],"answer_index":0,"explanation":"后方 = phía sau"},{"question":"Từ 「后裔」 có nghĩa là gì?","options":["Con cháu","phía sau","cổ họng","quốc gia"],"answer_index":0,"explanation":"后裔 = Con cháu"},{"question":"Từ 「喉咙」 có nghĩa là gì?","options":["cổ họng","phía sau","Con cháu","quốc gia"],"answer_index":0,"explanation":"喉咙 = cổ họng"},{"question":"Từ 「国立」 có nghĩa là gì?","options":["quốc gia","phía sau","Con cháu","cổ họng"],"answer_index":0,"explanation":"国立 = quốc gia"},{"question":"Từ 「壁画」 có nghĩa là gì?","options":["bức tranh tường","phía sau","Con cháu","cổ họng"],"answer_index":0,"explanation":"壁画 = bức tranh tường"},{"question":"Từ 「大米」 có nghĩa là gì?","options":["gạo","phía sau","Con cháu","cổ họng"],"answer_index":0,"explanation":"大米 = gạo"},{"question":"Từ 「大部份」 có nghĩa là gì?","options":["hầu hết","phía sau","Con cháu","cổ họng"],"answer_index":0,"explanation":"大部份 = hầu hết"},{"question":"