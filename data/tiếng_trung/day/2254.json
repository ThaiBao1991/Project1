ùng 几步.","focus_words":["几步"]},{"speaker":"B","line_target":"凯恩斯 は 何ですか。","line_vi":"凯恩斯 là cái gì?","focus_words":["凯恩斯"]},{"speaker":"A","line_target":"分社です。","line_vi":"Đó là 分社.","focus_words":["分社"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「几步」 có nghĩa là gì?","options":["vài bước","cairns","chi nhánh","nơi hành quyết"],"answer_index":0,"explanation":"几步 = vài bước"},{"question":"Từ 「凯恩斯」 có nghĩa là gì?","options":["cairns","vài bước","chi nhánh","nơi hành quyết"],"answer_index":0,"explanation":"凯恩斯 = cairns"},{"question":"Từ 「分社」 có nghĩa là gì?","options":["chi nhánh","vài bước","cairns","nơi hành quyết"],"answer_index":0,"explanation":"分社 = chi nhánh"},{"question":"Từ 「刑场」 có nghĩa là gì?","options":["nơi hành quyết","vài bước","cairns","chi nhánh"],"answer_index":0,"explanation":"刑场 = nơi hành quyết"},{"question":"Từ 「划船」 có nghĩa là gì?","options":["chèo thuyền","vài bước","cairns","chi nhánh"],"answer_index":0,"explanation":"划船 = chèo thuyền"},{"question":"Từ 「前排」 có nghĩa là gì?","options":["hàng ghế đầu","vài bước","cairns","chi nhánh"],"answer_index":0,"explanation":"前排 = hàng ghế đầu"},{"question":"Từ 「前言」 có nghĩa là gì?","options":["Lời nói đầu","vài bước","cairns","chi nhánh"],"answer_index":0,"explanation":"前言 = Lời nói đầu"},{"question":"Từ 「前额」 có nghĩa là gì?","options":["trán","vài bước","cairns","chi nhánh"],"answer_index":0,"explanation":"前额 = trán"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: vài bước","options":["几步","凯恩斯","分社","刑场"],"answer_index":0,"explanation":"几步 = vài bước"},{"question":"Chọn từ đúng cho nghĩa: cairns","options":["凯恩斯","几步","分社","刑场"],"answer_index":0,"explanation":"凯恩斯 = cairns"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map