h":"","meaning_vi":"Hoang tàn","explanation":"Hoang tàn","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a929fe80","audio_ref":"m_af07d2ba","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_83e7a1dd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2180","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"全体会议を 使います。","line_vi":"Tôi dùng 全体会议.","focus_words":["全体会议"]},{"speaker":"B","line_target":"公共交通 は 何ですか。","line_vi":"公共交通 là cái gì?","focus_words":["公共交通"]},{"speaker":"A","line_target":"六次です。","line_vi":"Đó là 六次.","focus_words":["六次"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1564acd7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「全体会议」 có nghĩa là gì?","options":["cuộc họp toàn thể","phương tiện giao thông công cộng","sáu lần","sáu loại"],"answer_index":0,"explanation":"全体会议 = cuộc họp toàn thể"},{"question":"Từ 「公共交通」 có nghĩa là gì?","options":["phương tiện giao thông công cộng","cuộc họp toàn thể","sáu lần","sáu loại"],"answer_index":0,"explanation":"公共交通 = phương tiện giao thông công cộng"},{"question":"Từ 「六次」 có nghĩa là gì?","options":["sáu lần","cuộc họp toàn thể","phương tiện giao thông công cộng","sáu loại"],"answer_index":0,"explanation":"六次 = sáu lần"},{"question":"Từ 「六种」 có nghĩa là gì?","options":["sáu loại","cuộc họp toàn thể","phương tiện giao thông công cộng","sáu lần"],"answer_index":0,"explanation":"六种 = sáu loại"},{"question":"Từ 「关系人」 có nghĩa là gì?","options":["Người có liên quan","cuộc họp toàn thể","phương tiện giao thông công