hắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1822","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"陆战队を 使います。","line_vi":"Tôi dùng 陆战队.","focus_words":["陆战队"]},{"speaker":"B","line_target":"院里 は 何ですか。","line_vi":"院里 là cái gì?","focus_words":["院里"]},{"speaker":"A","line_target":"隐匿です。","line_vi":"Đó là 隐匿.","focus_words":["隐匿"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e0fc17c0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「陆战队」 có nghĩa là gì?","options":["Thủy quân lục chiến","sân","Ẩn","Tỉnh Thanh Hải"],"answer_index":0,"explanation":"陆战队 = Thủy quân lục chiến"},{"question":"Từ 「院里」 có nghĩa là gì?","options":["sân","Thủy quân lục chiến","Ẩn","Tỉnh Thanh Hải"],"answer_index":0,"explanation":"院里 = sân"},{"question":"Từ 「隐匿」 có nghĩa là gì?","options":["Ẩn","Thủy quân lục chiến","sân","Tỉnh Thanh Hải"],"answer_index":0,"explanation":"隐匿 = Ẩn"},{"question":"Từ 「青海省」 có nghĩa là gì?","options":["Tỉnh Thanh Hải","Thủy quân lục chiến","sân","Ẩn"],"answer_index":0,"explanation":"青海省 = Tỉnh Thanh Hải"},{"question":"Từ 「韧性」 có nghĩa là gì?","options":["khả năng phục hồi","Thủy quân lục chiến","sân","Ẩn"],"answer_index":0,"explanation":"韧性 = khả năng phục hồi"},{"question":"Từ 「音像」 có nghĩa là gì?","options":["nghe nhìn","Thủy quân lục chiế