ÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1285","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大发を 使います。","line_vi":"Tôi dùng 大发.","focus_words":["大发"]},{"speaker":"B","line_target":"天花板 は 何ですか。","line_vi":"天花板 là cái gì?","focus_words":["天花板"]},{"speaker":"A","line_target":"失利です。","line_vi":"Đó là 失利.","focus_words":["失利"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5a91aa8c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大发」 có nghĩa là gì?","options":["Đại Pháp","trần nhà","thất bại","chóng mặt"],"answer_index":0,"explanation":"大发 = Đại Pháp"},{"question":"Từ 「天花板」 có nghĩa là gì?","options":["trần nhà","Đại Pháp","thất bại","chóng mặt"],"answer_index":0,"explanation":"天花板 = trần nhà"},{"question":"Từ 「失利」 có nghĩa là gì?","options":["thất bại","Đại Pháp","trần nhà","chóng mặt"],"answer_index":0,"explanation":"失利 = thất bại"},{"question":"Từ 「头晕」 có nghĩa là gì?","options":["chóng mặt","Đại Pháp","trần nhà","thất bại"],"answer_index":0,"explanation":"头晕 = chóng mặt"},{"question":"Từ 「奖得主」 có nghĩa là gì?","options":["Người đoạt giải","Đại Pháp","trần nhà","thất bại"],"answer_index":0,"explanation":"奖得主 = Người đoạt giải"},{"question":"Từ 「她家」 có nghĩa là gì?","options":["nhà cô ấy","Đại Pháp","trần nhà","thất bại"],"answer_index":0,"explanation":"她家 = nhà cô ấy"},{"question":"Từ 「威望」 có nghĩa là gì?","options":["uy tín","Đại Pháp","trần nhà","thất bại"],"a