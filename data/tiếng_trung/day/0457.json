_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 457","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"学说を 使います。","line_vi":"Tôi dùng 学说.","focus_words":["学说"]},{"speaker":"B","line_target":"学费 は 何ですか。","line_vi":"学费 là cái gì?","focus_words":["学费"]},{"speaker":"A","line_target":"安慰です。","line_vi":"Đó là 安慰.","focus_words":["安慰"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_47a7c1ce","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「学说」 có nghĩa là gì?","options":["học thuyết","Học phí","sự thoải mái","công suất"],"answer_index":0,"explanation":"学说 = học thuyết"},{"question":"Từ 「学费」 có nghĩa là gì?","options":["Học phí","học thuyết","sự thoải mái","công suất"],"answer_index":0,"explanation":"学费 = Học phí"},{"question":"Từ 「安慰」 có nghĩa là gì?","options":["sự thoải mái","học thuyết","Học phí","công suất"],"answer_index":0,"explanation":"安慰 = sự thoải mái"},{"question":"Từ 「容量」 có nghĩa là gì?","options":["công suất","học thuyết","Học phí","sự thoải mái"],"answer_index":0,"explanation":"容量 = công suất"},{"question":"Từ 「山脉」 có nghĩa là gì?","options":["núi","học thuyết","Học phí","sự thoải mái"],"answer_index":0,"explanation":"山脉 = núi"},{"question":"Từ 「应急」 có nghĩa là gì?","options":["trường hợp khẩn cấp","học thuyết","Học phí","sự thoải mái"],"answer_index":0,"explanation":"应急 = trường hợp khẩn cấp"},{"question":"Từ 「忽然」 có nghĩa là gì?","options":["đột nhiên","học thuyết","Học phí","sự thoải mái"],"answer_index":0,"explanation":"忽然 = đột nhiên"},{"question":"Từ 「怎么回事」 có nghĩa là gì?","options":