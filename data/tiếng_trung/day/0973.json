e":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_445a150f","audio_ref":"m_1268ad21","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_557f8863"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 973","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"新生儿を 使います。","line_vi":"Tôi dùng 新生儿.","focus_words":["新生儿"]},{"speaker":"B","line_target":"旺盛 は 何ですか。","line_vi":"旺盛 là cái gì?","focus_words":["旺盛"]},{"speaker":"A","line_target":"曙光です。","line_vi":"Đó là 曙光.","focus_words":["曙光"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1a053352","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「新生儿」 có nghĩa là gì?","options":["trẻ sơ sinh","hồ hởi","bình minh","phổ biến nhất"],"answer_index":0,"explanation":"新生儿 = trẻ sơ sinh"},{"question":"Từ 「旺盛」 có nghĩa là gì?","options":["hồ hởi","trẻ sơ sinh","bình minh","phổ biến nhất"],"answer_index":0,"explanation":"旺盛 = hồ hởi"},{"question":"Từ 「曙光」 có nghĩa là gì?","options":["bình minh","trẻ sơ sinh","hồ hởi","phổ biến nhất"],"answer_index":0,"explanation":"曙光 = bình minh"},{"question":"Từ 「最受」 có nghĩa là gì?","options":["phổ biến nhất","trẻ sơ sinh","hồ hởi","bình minh"],"answer_index":0,"explanation":"最受 = phổ biến nhất"},{"question":"Từ 「未有」 có nghĩa là gì?","options":["Chưa","trẻ sơ sinh","hồ hởi","bình minh"],"answer_index":0,"explanation":"未有 = Chưa"},{"question":"Từ 「本领」 có nghĩa là gì?","options":["kỹ năng","trẻ sơ sinh","hồ hởi","bình minh"],"answer_index":0,"explanation":"本领 = kỹ năng"},{"question":"Từ 「柜台」 có nghĩa là gì?","options":["quầy tính tiền","trẻ sơ sinh","hồ hởi","bình minh"],"answer_index":0,"explanation":"柜台 = quầy tính tiền"},{"question":"Từ 「柠檬」 có nghĩa là gì?","options":["chanh","trẻ sơ sinh","hồ hởi