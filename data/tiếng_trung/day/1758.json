","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_558cd5cf","audio_ref":"m_bf52a939","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_8e0e6029"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1758","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"王权を 使います。","line_vi":"Tôi dùng 王权.","focus_words":["王权"]},{"speaker":"B","line_target":"珍妮 は 何ですか。","line_vi":"珍妮 là cái gì?","focus_words":["珍妮"]},{"speaker":"A","line_target":"琥珀です。","line_vi":"Đó là 琥珀.","focus_words":["琥珀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ce07e648","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「王权」 có nghĩa là gì?","options":["quyền lực hoàng gia","Jenny","hổ phách","Sử dụng ô tô"],"answer_index":0,"explanation":"王权 = quyền lực hoàng gia"},{"question":"Từ 「珍妮」 có nghĩa là gì?","options":["Jenny","quyền lực hoàng gia","hổ phách","Sử dụng ô tô"],"answer_index":0,"explanation":"珍妮 = Jenny"},{"question":"Từ 「琥珀」 có nghĩa là gì?","options":["hổ phách","quyền lực hoàng gia","Jenny","Sử dụng ô tô"],"answer_index":0,"explanation":"琥珀 = hổ phách"},{"question":"Từ 「用车」 có nghĩa là gì?","options":["Sử dụng ô tô","quyền lực hoàng gia","Jenny","hổ phách"],"answer_index":0,"explanation":"用车 = Sử dụng ô tô"},{"question":"Từ 「画风」 có nghĩa là gì?","options":["phong cách vẽ tranh","quyền lực hoàng gia","Jenny","hổ phách"],"answer_index":0,"explanation":"画风 = phong cách vẽ tranh"},{"question":"Từ 「番禺」 có nghĩa là gì?","options":["Phiên Ngung","quyền lực hoàng gia","Jenny","hổ phách"],"answer_index":0,"exp