lables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d3af5c51","audio_ref":"m_5222070c","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_cc753296"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2442","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"瑞恩を 使います。","line_vi":"Tôi dùng 瑞恩.","focus_words":["瑞恩"]},{"speaker":"B","line_target":"甄别 は 何ですか。","line_vi":"甄别 là cái gì?","focus_words":["甄别"]},{"speaker":"A","line_target":"甚为です。","line_vi":"Đó là 甚为.","focus_words":["甚为"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a9c43a0b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「瑞恩」 có nghĩa là gì?","options":["Ryan","Sàng lọc","Rất","diễn viên"],"answer_index":0,"explanation":"瑞恩 = Ryan"},{"question":"Từ 「甄别」 có nghĩa là gì?","options":["Sàng lọc","Ryan","Rất","diễn viên"],"answer_index":0,"explanation":"甄别 = Sàng lọc"},{"question":"Từ 「甚为」 có nghĩa là gì?","options":["Rất","Ryan","Sàng lọc","diễn viên"],"answer_index":0,"explanation":"甚为 = Rất"},{"question":"Từ 「男演员」 có nghĩa là gì?","options":["diễn viên","Ryan","Sàng lọc","Rất"],"answer_index":0,"explanation":"男演员 = diễn viên"},{"question":"Từ 「疯狗」 có nghĩa là gì?","options":["chó điên","Ryan","Sàng lọc","Rất"],"answer_index":0,"explanation":"疯狗 = chó điên"},{"question":"Từ 「白沙」 có nghĩa là gì?","options":["cát trắng","Ryan","Sàng lọc","Rất"],"answer_index":0,"explanation":"白沙 = cát trắng"},{"question":"Từ 「百岁」 có nghĩa là gì?","options":["100 tuổi","Ryan","Sàng lọc","Rất"],"answer_index":0,"explanation":"百岁 = 100 tuổi"},{"question":"Từ 「皮埃尔」 có nghĩa là gì?","options":["Pierre","Ryan","Sàng lọc","Rất"],"answer_index":0,"explanation":"皮埃尔 = Pierre"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Ryan","options":["瑞