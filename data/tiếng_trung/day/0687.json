i (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 687","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"榜样を 使います。","line_vi":"Tôi dùng 榜样.","focus_words":["榜样"]},{"speaker":"B","line_target":"残疾人 は 何ですか。","line_vi":"残疾人 là cái gì?","focus_words":["残疾人"]},{"speaker":"A","line_target":"水源です。","line_vi":"Đó là 水源.","focus_words":["水源"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6810bdd7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「榜样」 có nghĩa là gì?","options":["hình mẫu","Đã tắt","nguồn nước","bong bóng"],"answer_index":0,"explanation":"榜样 = hình mẫu"},{"question":"Từ 「残疾人」 có nghĩa là gì?","options":["Đã tắt","hình mẫu","nguồn nước","bong bóng"],"answer_index":0,"explanation":"残疾人 = Đã tắt"},{"question":"Từ 「水源」 có nghĩa là gì?","options":["nguồn nước","hình mẫu","Đã tắt","bong bóng"],"answer_index":0,"explanation":"水源 = nguồn nước"},{"question":"Từ 「泡沫」 có nghĩa là gì?","options":["bong bóng","hình mẫu","Đã tắt","nguồn nước"],"answer_index":0,"explanation":"泡沫 = bong bóng"},{"question":"Từ 「泰勒」 có nghĩa là gì?","options":["Taylor","hình mẫu","Đã tắt","nguồn nước"],"answer_index":0,"explanation":"泰勒 = Taylor"},{"question":"Từ 「流亡」 có nghĩa là gì?","options":["lưu đày","hình mẫu","Đã tắt","nguồn nước"],"answer_index":0,"explanation":"流亡 = lưu đày"},{"question":"Từ 「源头」 có nghĩa là gì?","options":["nguồn","hình mẫu","Đã tắt","nguồn nước"],"answer_index":0,"explanation":"源头 = nguồn"},{"question":"Từ 「激起」 có nghĩa là gì?","options":["khơi dậy","hình mẫu","Đã tắt","nguồ