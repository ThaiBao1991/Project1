:"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a7472fe1","audio_ref":"m_b89cd5a0","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d43f8871"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1521","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"singaporeを 使います。","line_vi":"Tôi dùng singapore.","focus_words":["singapore"]},{"speaker":"B","line_target":"site は 何ですか。","line_vi":"site là cái gì?","focus_words":["site"]},{"speaker":"A","line_target":"textです。","line_vi":"Đó là text.","focus_words":["text"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_96d34884","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「singapore」 có nghĩa là gì?","options":["singapore","trang web","văn bản","var"],"answer_index":0,"explanation":"singapore = singapore"},{"question":"Từ 「site」 có nghĩa là gì?","options":["trang web","singapore","văn bản","var"],"answer_index":0,"explanation":"site = trang web"},{"question":"Từ 「text」 có nghĩa là gì?","options":["văn bản","singapore","trang web","var"],"answer_index":0,"explanation":"text = văn bản"},{"question":"Từ 「var」 có nghĩa là gì?","options":["var","singapore","trang web","văn bản"],"answer_index":0,"explanation":"var = var"},{"question":"Từ 「yu」 có nghĩa là gì?","options":["bạn","singapore","trang web","văn bản"],"answer_index":0,"explanation":"yu = bạn"},{"question":"Từ 「一二」 có nghĩa là gì?","options":["Một hoặc hai","singapore","trang web","văn bản"],"answer_index":0,"explanation":"一二 = Một hoặc hai"},{"question":"Từ 「一齐」 có nghĩa là gì?","options":["cùng với nhau","singapore","trang web","văn bản"],"answer_index":0,"explanation":"一齐 = cùng với nhau"},{"question":"Từ 「三部」 có nghĩa là gì?","options":["ba phần"