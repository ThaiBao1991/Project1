ch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 568","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"无视を 使います。","line_vi":"Tôi dùng 无视.","focus_words":["无视"]},{"speaker":"B","line_target":"晚餐 は 何ですか。","line_vi":"晚餐 là cái gì?","focus_words":["晚餐"]},{"speaker":"A","line_target":"最新消息です。","line_vi":"Đó là 最新消息.","focus_words":["最新消息"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_367d7700","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「无视」 có nghĩa là gì?","options":["bỏ qua","bữa tối","tin tức mới nhất","chưa đủ tuổi"],"answer_index":0,"explanation":"无视 = bỏ qua"},{"question":"Từ 「晚餐」 có nghĩa là gì?","options":["bữa tối","bỏ qua","tin tức mới nhất","chưa đủ tuổi"],"answer_index":0,"explanation":"晚餐 = bữa tối"},{"question":"Từ 「最新消息」 có nghĩa là gì?","options":["tin tức mới nhất","bỏ qua","bữa tối","chưa đủ tuổi"],"answer_index":0,"explanation":"最新消息 = tin tức mới nhất"},{"question":"Từ 「未成年」 có nghĩa là gì?","options":["chưa đủ tuổi","bỏ qua","bữa tối","tin tức mới nhất"],"answer_index":0,"explanation":"未成年 = chưa đủ tuổi"},{"question":"Từ 「本性」 có nghĩa là gì?","options":["thiên nhiên","bỏ qua","bữa tối","tin tức mới nhất"],"answer_index":0,"explanation":"本性 = thiên nhiên"},{"question":"Từ 「本月」 có nghĩa là gì?","options":["tháng này","bỏ qua","bữa tối","tin tức mới nhất"],"answer_index":0,"explanation":"本月 = tháng này"},{"question":"Từ 「机票」 có nghĩa là gì?","options":["vé máy bay","bỏ qua","bữa tối","tin tức mới nhất"],"answer_index":0,"explanati