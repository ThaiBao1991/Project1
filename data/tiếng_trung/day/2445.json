":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_23d182dc","audio_ref":"m_6e9e7924","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_4ffb6ba1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2445","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"编辑器を 使います。","line_vi":"Tôi dùng 编辑器.","focus_words":["编辑器"]},{"speaker":"B","line_target":"网志 は 何ですか。","line_vi":"网志 là cái gì?","focus_words":["网志"]},{"speaker":"A","line_target":"网络空间です。","line_vi":"Đó là 网络空间.","focus_words":["网络空间"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_09dc6754","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「编辑器」 có nghĩa là gì?","options":["Biên tập viên","Blog","không gian mạng","Cúp"],"answer_index":0,"explanation":"编辑器 = Biên tập viên"},{"question":"Từ 「网志」 có nghĩa là gì?","options":["Blog","Biên tập viên","không gian mạng","Cúp"],"answer_index":0,"explanation":"网志 = Blog"},{"question":"Từ 「网络空间」 có nghĩa là gì?","options":["không gian mạng","Biên tập viên","Blog","Cúp"],"answer_index":0,"explanation":"网络空间 = không gian mạng"},{"question":"Từ 「罩杯」 có nghĩa là gì?","options":["Cúp","Biên tập viên","Blog","không gian mạng"],"answer_index":0,"explanation":"罩杯 = Cúp"},{"question":"Từ 「翻脸」 có nghĩa là gì?","options":["Rơi ra ngoài","Biên tập viên","Blog","không gian mạng"],"answer_index":0,"explanation":"翻脸 = Rơi ra ngoài"},{"question":"Từ 「老爷子」 có nghĩa là gì?","options":["ông già","Biên tập viên","Blog","không gian mạng"],"answer_index":0,"explanation":"老爷子 = ông già"},{"question":"Từ 「脱衣舞」 có nghĩa là gì?","options":["thoát y","Biên tập viên","Blog","không gian mạng"],"answer_index":0,"explanation":"脱衣舞 = thoát y"},{"question":"Từ 「腿部」 có nghĩa là gì?","options":["chân","Biên tập viên","Blog","kh