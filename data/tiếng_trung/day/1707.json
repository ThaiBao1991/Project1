ronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1707","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"迟早会を 使います。","line_vi":"Tôi dùng 迟早会.","focus_words":["迟早会"]},{"speaker":"B","line_target":"选派 は 何ですか。","line_vi":"选派 là cái gì?","focus_words":["选派"]},{"speaker":"A","line_target":"递减です。","line_vi":"Đó là 递减.","focus_words":["递减"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_161db418","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「迟早会」 có nghĩa là gì?","options":["sớm hay muộn","chọn","Giảm dần","Điều hướng"],"answer_index":0,"explanation":"迟早会 = sớm hay muộn"},{"question":"Từ 「选派」 có nghĩa là gì?","options":["chọn","sớm hay muộn","Giảm dần","Điều hướng"],"answer_index":0,"explanation":"选派 = chọn"},{"question":"Từ 「递减」 có nghĩa là gì?","options":["Giảm dần","sớm hay muộn","chọn","Điều hướng"],"answer_index":0,"explanation":"递减 = Giảm dần"},{"question":"Từ 「通航」 có nghĩa là gì?","options":["Điều hướng","sớm hay muộn","chọn","Giảm dần"],"answer_index":0,"explanation":"通航 = Điều hướng"},{"question":"Từ 「遮掩」 có nghĩa là gì?","options":["che đậy","sớm hay muộn","chọn","Giảm dần"],"answer_index":0,"explanation":"遮掩 = che đậy"},{"question":"Từ 「重振」 có nghĩa là gì?","options":["Hồi sinh","sớm hay muộn","chọn","Giảm dần"],"answer_index":0,"explanation":"重振 = Hồi sinh"},{"question":"Từ 「野人」 có nghĩa là gì?","options":["dã man","sớm hay muộn","chọn","Giảm dần"],"answer_index":0,"explanation":"野人 = dã man"},{"question":"Từ 「鉴赏」 có nghĩa là gì?","options":["đánh giá cao","sớm hay muộn","chọn","Giảm dần"],"answer_index":0,"exp