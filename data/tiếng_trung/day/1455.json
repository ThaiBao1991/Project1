:"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1455","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"战略性を 使います。","line_vi":"Tôi dùng 战略性.","focus_words":["战略性"]},{"speaker":"B","line_target":"手头 は 何ですか。","line_vi":"手头 là cái gì?","focus_words":["手头"]},{"speaker":"A","line_target":"招数です。","line_vi":"Đó là 招数.","focus_words":["招数"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fecbd9d6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「战略性」 có nghĩa là gì?","options":["chiến lược","trong tay","thủ thuật","diễn tập"],"answer_index":0,"explanation":"战略性 = chiến lược"},{"question":"Từ 「手头」 có nghĩa là gì?","options":["trong tay","chiến lược","thủ thuật","diễn tập"],"answer_index":0,"explanation":"手头 = trong tay"},{"question":"Từ 「招数」 có nghĩa là gì?","options":["thủ thuật","chiến lược","trong tay","diễn tập"],"answer_index":0,"explanation":"招数 = thủ thuật"},{"question":"Từ 「排练」 có nghĩa là gì?","options":["diễn tập","chiến lược","trong tay","thủ thuật"],"answer_index":0,"explanation":"排练 = diễn tập"},{"question":"Từ 「摄氏度」 có nghĩa là gì?","options":["độ C","chiến lược","trong tay","thủ thuật"],"answer_index":0,"explanation":"摄氏度 = độ C"},{"question":"Từ 「收下」 có nghĩa là gì?","options":["chấp nhận","chiến lược","trong t