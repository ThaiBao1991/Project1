ch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 933","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"三层を 使います。","line_vi":"Tôi dùng 三层.","focus_words":["三层"]},{"speaker":"B","line_target":"下个 は 何ですか。","line_vi":"下个 là cái gì?","focus_words":["下个"]},{"speaker":"A","line_target":"下单です。","line_vi":"Đó là 下单.","focus_words":["下单"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1d8154f8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「三层」 có nghĩa là gì?","options":["tầng ba","Tiếp theo","Đặt hàng","đường dây chuyên dụng"],"answer_index":0,"explanation":"三层 = tầng ba"},{"question":"Từ 「下个」 có nghĩa là gì?","options":["Tiếp theo","tầng ba","Đặt hàng","đường dây chuyên dụng"],"answer_index":0,"explanation":"下个 = Tiếp theo"},{"question":"Từ 「下单」 có nghĩa là gì?","options":["Đặt hàng","tầng ba","Tiếp theo","đường dây chuyên dụng"],"answer_index":0,"explanation":"下单 = Đặt hàng"},{"question":"Từ 「专线」 có nghĩa là gì?","options":["đường dây chuyên dụng","tầng ba","Tiếp theo","Đặt hàng"],"answer_index":0,"explanation":"专线 = đường dây chuyên dụng"},{"question":"Từ 「世界观」 có nghĩa là gì?","options":["thế giới quan","tầng ba","Tiếp theo","Đặt hàng"],"answer_index":0,"explanation":"世界观 = thế giới quan"},{"question":"Từ 「中叶」 có nghĩa là gì?","options":["lá giữa","tầng ba","Tiếp theo","Đặt hàng"],"answer_index":0,"explanation":"中叶 = lá giữa"},{"question":"Từ 「丰厚」 có nghĩa là gì?","options":["Hào phóng","tầng ba","Tiếp theo","Đặt hàng"],"answer_index":0,"explanation