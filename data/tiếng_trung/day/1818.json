xample_meaning_vi":"","phonetic_note":"","syllables":[],"image_ref":"m_6a78becd","audio_ref":"m_390f0285","meaning_audio_ref":"m_be48496e","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1818","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"荧光を 使います。","line_vi":"Tôi dùng 荧光.","focus_words":["荧光"]},{"speaker":"B","line_target":"葡萄牙人 は 何ですか。","line_vi":"葡萄牙人 là cái gì?","focus_words":["葡萄牙人"]},{"speaker":"A","line_target":"藏品です。","line_vi":"Đó là 藏品.","focus_words":["藏品"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7141c616","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「荧光」 có nghĩa là gì?","options":["huỳnh quang","người Bồ Đào Nha","Bộ sưu tập","áo sơ mi"],"answer_index":0,"explanation":"荧光 = huỳnh quang"},{"question":"Từ 「葡萄牙人」 có nghĩa là gì?","options":["người Bồ Đào Nha","huỳnh quang","Bộ sưu tập","áo sơ mi"],"answer_index":0,"explanation":"葡萄牙人 = người Bồ Đào Nha"},{"question":"Từ 「藏品」 có nghĩa là gì?","options":["Bộ sưu tập","huỳnh quang","người Bồ Đào Nha","áo sơ mi"],"answer_index":0,"explanation":"藏品 = Bộ sưu tập"},{"question":"Từ 「衬衣」 có nghĩa là gì?","options":["áo sơ mi","huỳnh quang","người Bồ Đào Nha","Bộ sưu tập"],"answer_index":0,"explanation":"衬衣 = áo sơ mi"},{"question":"Từ 「被叫」 có nghĩa là gì?","options":["được gọi là","huỳnh quang","người Bồ Đào Nha","Bộ sưu tập"],"answer_index":0,"explanation":"被叫 = được gọi là"},{"question":"Từ 「西区」 có nghĩa là