ples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1584","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"总称を 使います。","line_vi":"Tôi dùng 总称.","focus_words":["总称"]},{"speaker":"B","line_target":"惠普 は 何ですか。","line_vi":"惠普 là cái gì?","focus_words":["惠普"]},{"speaker":"A","line_target":"想想看です。","line_vi":"Đó là 想想看.","focus_words":["想想看"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bfd8076c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「总称」 có nghĩa là gì?","options":["Thuật ngữ chung","HP","nghĩ về nó","thuế thu nhập"],"answer_index":0,"explanation":"总称 = Thuật ngữ chung"},{"question":"Từ 「惠普」 có nghĩa là gì?","options":["HP","Thuật ngữ chung","nghĩ về nó","thuế thu nhập"],"answer_index":0,"explanation":"惠普 = HP"},{"question":"Từ 「想想看」 có nghĩa là gì?","options":["nghĩ về nó","Thuật ngữ chung","HP","thuế thu nhập"],"answer_index":0,"explanation":"想想看 = nghĩ về nó"},{"question":"Từ 「所得税」 có nghĩa là gì?","options":["thuế thu nhập","Thuật ngữ chung","HP","nghĩ về nó"],"answer_index":0,"explanation":"所得税 = thuế thu nhập"},{"question":"Từ 「投奔」 có nghĩa là gì?","options":["khiếm khuyết","Thuật ngữ chung","HP","nghĩ về nó"],"answer_index":0,"explanation":"投奔 = khiếm khuyết"},{"question":"Từ 「报章」 có nghĩa là gì?","options":["tờ báo","Thuật ngữ chung","HP","nghĩ về nó"],"answer_index":0,"explanation":"报章 = tờ báo"},{"question":"Từ 「拉特」 có nghĩa là gì?","