1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 536","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"强力を 使います。","line_vi":"Tôi dùng 强力.","focus_words":["强力"]},{"speaker":"B","line_target":"当场 は 何ですか。","line_vi":"当场 là cái gì?","focus_words":["当场"]},{"speaker":"A","line_target":"心想です。","line_vi":"Đó là 心想.","focus_words":["心想"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_36eff078","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「强力」 có nghĩa là gì?","options":["mạnh mẽ","ngay tại chỗ","suy nghĩ","Cuối cùng"],"answer_index":0,"explanation":"强力 = mạnh mẽ"},{"question":"Từ 「当场」 có nghĩa là gì?","options":["ngay tại chỗ","mạnh mẽ","suy nghĩ","Cuối cùng"],"answer_index":0,"explanation":"当场 = ngay tại chỗ"},{"question":"Từ 「心想」 có nghĩa là gì?","options":["suy nghĩ","mạnh mẽ","ngay tại chỗ","Cuối cùng"],"answer_index":0,"explanation":"心想 = suy nghĩ"},{"question":"Từ 「总算」 có nghĩa là gì?","options":["Cuối cùng","mạnh mẽ","ngay tại chỗ","suy nghĩ"],"answer_index":0,"explanation":"总算 = Cuối cùng"},{"question":"Từ 「戏曲」 có nghĩa là gì?","options":["Opera","mạnh mẽ","ngay tại chỗ","suy nghĩ"],"answer_index":0,"explanation":"戏曲 = Opera"},{"question":"Từ 「打扮」 có nghĩa là gì?","options":["ăn mặc","mạnh mẽ","ngay tại chỗ","suy nghĩ"],"answer_index":0,"explanation":"打扮 = ăn mặc"},{"que