ó thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1892","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"安倍晋三を 使います。","line_vi":"Tôi dùng 安倍晋三.","focus_words":["安倍晋三"]},{"speaker":"B","line_target":"宣传片 は 何ですか。","line_vi":"宣传片 là cái gì?","focus_words":["宣传片"]},{"speaker":"A","line_target":"宴请です。","line_vi":"Đó là 宴请.","focus_words":["宴请"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8b0a85e8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「安倍晋三」 có nghĩa là gì?","options":["Shinzo Abe","Video quảng cáo","bữa tiệc","sống ở nhà"],"answer_index":0,"explanation":"安倍晋三 = Shinzo Abe"},{"question":"Từ 「宣传片」 có nghĩa là gì?","options":["Video quảng cáo","Shinzo Abe","bữa tiệc","sống ở nhà"],"answer_index":0,"explanation":"宣传片 = Video quảng cáo"},{"question":"Từ 「宴请」 có nghĩa là gì?","options":["bữa tiệc","Shinzo Abe","Video quảng cáo","sống ở nhà"],"answer_index":0,"explanation":"宴请 = bữa tiệc"},{"question":"Từ 「家住」 có nghĩa là gì?","options":["sống ở nhà","Shinzo Abe","Video quảng cáo","bữa tiệc"],"answer_index":0,"explanation":"家住 = sống ở nhà"},{"question":"Từ 「家庭主妇」 có nghĩa là gì?","options":["bà nội trợ","Shinzo Abe","Video quảng cáo","bữa tiệc"],"answer_index":0,"explanation":"家庭主妇 = bà nội trợ"},{"question":"Từ 「宽频」 có nghĩa là gì?","options":["Băng thông rộng","Shinzo Abe","Video quảng cáo","bữa tiệc"],"answer_index":0,"explanation":"宽频 = Băng thông rộng"},{"question":"Từ 「寓所」 có nghĩa là gì?","options":["căn hộ","Shinzo Abe","Video quảng cáo","bữa tiệc"],"answer_index":0,"explanation":"寓所 = căn 