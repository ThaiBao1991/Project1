i câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2203","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"胆怯を 使います。","line_vi":"Tôi dùng 胆怯.","focus_words":["胆怯"]},{"speaker":"B","line_target":"脑中 は 何ですか。","line_vi":"脑中 là cái gì?","focus_words":["脑中"]},{"speaker":"A","line_target":"腐化です。","line_vi":"Đó là 腐化.","focus_words":["腐化"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bd855b17","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「胆怯」 có nghĩa là gì?","options":["Nhút nhát","trong tâm trí","tham nhũng","tự chế"],"answer_index":0,"explanation":"胆怯 = Nhút nhát"},{"question":"Từ 「脑中」 có nghĩa là gì?","options":["trong tâm trí","Nhút nhát","tham nhũng","tự chế"],"answer_index":0,"explanation":"脑中 = trong tâm trí"},{"question":"Từ 「腐化」 có nghĩa là gì?","options":["tham nhũng","Nhút nhát","trong tâm trí","tự chế"],"answer_index":0,"explanation":"腐化 = tham nhũng"},{"question":"Từ 「自创」 có nghĩa là gì?","options":["tự chế","Nhút nhát","trong tâm trí","tham nhũng"],"answer_index":0,"explanation":"自创 = tự chế"},{"question":"Từ 「自治权」 có nghĩa là gì?","options":["quyền tự chủ","Nhút nhát","trong tâm trí","tham nhũng"],"answer_index":0,"explanation":"自治权 = quyền tự chủ"},{"question":"Từ 「致意」 có nghĩa là gì?","options":["Chào","Nhút nhát","trong tâm trí","tham nhũng"],"answer_index":0,"explanation":"致意 = Chào"},{"question":"Từ 「花坛」 có nghĩa là gì?","o