_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_71c9ce1f","audio_ref":"m_aa071fb2","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_381ff0e6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1400","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"名号を 使います。","line_vi":"Tôi dùng 名号.","focus_words":["名号"]},{"speaker":"B","line_target":"名家 は 何ですか。","line_vi":"名家 là cái gì?","focus_words":["名家"]},{"speaker":"A","line_target":"名流です。","line_vi":"Đó là 名流.","focus_words":["名流"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cd1ba6d3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「名号」 có nghĩa là gì?","options":["tên","người nổi tiếng","Người nổi tiếng","đằng sau"],"answer_index":0,"explanation":"名号 = tên"},{"question":"Từ 「名家」 có nghĩa là gì?","options":["người nổi tiếng","tên","Người nổi tiếng","đằng sau"],"answer_index":0,"explanation":"名家 = người nổi tiếng"},{"question":"Từ 「名流」 có nghĩa là gì?","options":["Người nổi tiếng","tên","người nổi tiếng","đằng sau"],"answer_index":0,"explanation":"名流 = Người nổi tiếng"},{"question":"Từ 「后边」 có nghĩa là gì?","options":["đằng sau","tên","người nổi tiếng","Người nổi tiếng"],"answer_index":0,"explanation":"后边 = đằng sau"},{"question":"Từ 「听觉」 có nghĩa là gì?","options":["thính giác","tên","người nổi tiếng","Người nổi tiếng"],"answer_index":0,"explanation":"听觉 = thính giác"},{"question":"Từ 「喀麦隆」 có nghĩa là gì?","options":["Ca-mơ-run","tên","người nổi tiếng","Người nổi tiếng"],"answer_index":0,"explanation":"喀麦隆 = Ca-mơ-run