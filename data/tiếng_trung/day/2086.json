_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_2e7ab766","audio_ref":"m_e82b493b","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f59c204a"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2086","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"斯洛文尼亚を 使います。","line_vi":"Tôi dùng 斯洛文尼亚.","focus_words":["斯洛文尼亚"]},{"speaker":"B","line_target":"新奥尔良 は 何ですか。","line_vi":"新奥尔良 là cái gì?","focus_words":["新奥尔良"]},{"speaker":"A","line_target":"施暴です。","line_vi":"Đó là 施暴.","focus_words":["施暴"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3c1ff6d4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「斯洛文尼亚」 có nghĩa là gì?","options":["Slovenia","New Orleans","bạo lực","sườn xám"],"answer_index":0,"explanation":"斯洛文尼亚 = Slovenia"},{"question":"Từ 「新奥尔良」 có nghĩa là gì?","options":["New Orleans","Slovenia","bạo lực","sườn xám"],"answer_index":0,"explanation":"新奥尔良 = New Orleans"},{"question":"Từ 「施暴」 có nghĩa là gì?","options":["bạo lực","Slovenia","New Orleans","sườn xám"],"answer_index":0,"explanation":"施暴 = bạo lực"},{"question":"Từ 「旗袍」 có nghĩa là gì?","options":["sườn xám","Slovenia","New Orleans","bạo lực"],"answer_index":0,"explanation":"旗袍 = sườn xám"},{"question":"Từ 「无惧」 có nghĩa là gì?","options":["không sợ hãi","Slovenia","New Orleans","bạo lực"],"answer_index":0,"explanation":"无惧 = không sợ hãi"},{"question":"Từ 「日用品」 có nghĩa là gì?","options":["Nhu yếu phẩm hàng ngày","Slovenia","New Orleans","bạo lực"],"answer_index":0,"explanation":"日用品 = Nhu yếu phẩm hàng ngày"},{"question":"Từ 「时数」 có nghĩa là gì?","options":["giờ","Slovenia","New Orleans","bạo lực