ôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2483","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"轩然大波を 使います。","line_vi":"Tôi dùng 轩然大波.","focus_words":["轩然大波"]},{"speaker":"B","line_target":"轮式 は 何ですか。","line_vi":"轮式 là cái gì?","focus_words":["轮式"]},{"speaker":"A","line_target":"运输业です。","line_vi":"Đó là 运输业.","focus_words":["运输业"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b55dfba2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「轩然大波」 có nghĩa là gì?","options":["náo động","có bánh xe","ngành vận tải","Khối lượng vận chuyển"],"answer_index":0,"explanation":"轩然大波 = náo động"},{"question":"Từ 「轮式」 có nghĩa là gì?","options":["có bánh xe","náo động","ngành vận tải","Khối lượng vận chuyển"],"answer_index":0,"explanation":"轮式 = có bánh xe"},{"question":"Từ 「运输业」 có nghĩa là gì?","options":["ngành vận tải","náo động","có bánh xe","Khối lượng vận chuyển"],"answer_index":0,"explanation":"运输业 = ngành vận tải"},{"question":"Từ 「运量」 có nghĩa là gì?","options":["Khối lượng vận chuyển","náo động","có bánh xe","ngành vận tải"],"answer_index":0,"explanation":"运量 = Khối lượng vận chuyển"},{"question":"Từ 「这道」 có nghĩa là gì?","options":["Lối này","náo động","có bánh xe","ngành vận tải"],"answer_index":0,"explanation":"这道 = Lối này"},{"question":"Từ 「进退」 có nghĩa là gì?","options":["Tiến và rút lui","náo động","có bánh xe","ngành vận tải"],"answer_index":0,"explanation":"进退 = Tiến và rút lui"},{"question":"Từ 「违法犯罪」 có nghĩa là gì?","options":["Tội phạm