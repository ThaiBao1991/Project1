ample_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f346ebfa","audio_ref":"m_8290d819","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ddb96113"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2272","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"空谈を 使います。","line_vi":"Tôi dùng 空谈.","focus_words":["空谈"]},{"speaker":"B","line_target":"突起 は 何ですか。","line_vi":"突起 là cái gì?","focus_words":["突起"]},{"speaker":"A","line_target":"算盘です。","line_vi":"Đó là 算盘.","focus_words":["算盘"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_54741d68","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「空谈」 có nghĩa là gì?","options":["Nói chuyện trống rỗng","sự lồi lên","bàn tính","Màu hồng và dịu dàng"],"answer_index":0,"explanation":"空谈 = Nói chuyện trống rỗng"},{"question":"Từ 「突起」 có nghĩa là gì?","options":["sự lồi lên","Nói chuyện trống rỗng","bàn tính","Màu hồng và dịu dàng"],"answer_index":0,"explanation":"突起 = sự lồi lên"},{"question":"Từ 「算盘」 có nghĩa là gì?","options":["bàn tính","Nói chuyện trống rỗng","sự lồi lên","Màu hồng và dịu dàng"],"answer_index":0,"explanation":"算盘 = bàn tính"},{"question":"Từ 「粉嫩」 có nghĩa là gì?","options":["Màu hồng và dịu dàng","Nói chuyện trống rỗng","sự lồi lên","bàn tính"],"answer_index":0,"explanation":"粉嫩 = Màu hồng và dịu dàng"},{"question":"Từ 「精炼」 có nghĩa là gì?","options":["tinh chỉnh","Nói chuyện trống rỗng","sự lồi lên","bàn tính"],"answer_index":0,"explanation":"精炼 = tinh chỉnh"},{"question":"Từ 「精良」 có nghĩa là gì?","options":["Tuyệt vời","Nói chuyện trống rỗng","sự lồi lên","bàn tính"],"answer_index":0,"explanation":