i đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 482","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"季度を 使います。","line_vi":"Tôi dùng 季度.","focus_words":["季度"]},{"speaker":"B","line_target":"官僚 は 何ですか。","line_vi":"官僚 là cái gì?","focus_words":["官僚"]},{"speaker":"A","line_target":"宾馆です。","line_vi":"Đó là 宾馆.","focus_words":["宾馆"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_445dbf86","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「季度」 có nghĩa là gì?","options":["một phần tư","sự quan liêu","khách sạn","bộ trưởng"],"answer_index":0,"explanation":"季度 = một phần tư"},{"question":"Từ 「官僚」 có nghĩa là gì?","options":["sự quan liêu","một phần tư","khách sạn","bộ trưởng"],"answer_index":0,"explanation":"官僚 = sự quan liêu"},{"question":"Từ 「宾馆」 có nghĩa là gì?","options":["khách sạn","một phần tư","sự quan liêu","bộ trưởng"],"answer_index":0,"explanation":"宾馆 = khách sạn"},{"question":"Từ 「尚书」 có nghĩa là gì?","options":["bộ trưởng","một phần tư","sự quan liêu","khách sạn"],"answer_index":0,"explanation":"尚书 = bộ trưởng"},{"question":"Từ 「弹药」 có nghĩa là gì?","options":["đạn dược","một phần tư","sự quan liêu","khách sạn"],"answer_index":0,"explanation":"弹药 = đạn dược"},{"question":"Từ 「当做」 có nghĩa là gì?","options":["như","một phần tư","sự quan liêu","khách sạn"],"answer_index":0,"explanation":"当做 = như"},{"question":"Từ 「录取」 có nghĩa là gì?","options":["Nhập học","một phần tư","sự quan liêu","khách sạn"],"answer_index":0,"explanation":"录取