":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 777","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"攻占を 使います。","line_vi":"Tôi dùng 攻占.","focus_words":["攻占"]},{"speaker":"B","line_target":"散步 は 何ですか。","line_vi":"散步 là cái gì?","focus_words":["散步"]},{"speaker":"A","line_target":"文化部です。","line_vi":"Đó là 文化部.","focus_words":["文化部"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_94c3fd91","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「攻占」 có nghĩa là gì?","options":["bắt giữ","đi dạo","Bộ văn hóa","vô danh"],"answer_index":0,"explanation":"攻占 = bắt giữ"},{"question":"Từ 「散步」 có nghĩa là gì?","options":["đi dạo","bắt giữ","Bộ văn hóa","vô danh"],"answer_index":0,"explanation":"散步 = đi dạo"},{"question":"Từ 「文化部」 có nghĩa là gì?","options":["Bộ văn hóa","bắt giữ","đi dạo","vô danh"],"answer_index":0,"explanation":"文化部 = Bộ văn hóa"},{"question":"Từ 「无名」 có nghĩa là gì?","options":["vô danh","bắt giữ","đi dạo","Bộ văn hóa"],"answer_index":0,"explanation":"无名 = vô danh"},{"question":"Từ 「日本政府」 có nghĩa là gì?","options":["chính phủ Nhật Bản","bắt giữ","đi dạo","Bộ văn hóa"],"answer_index":0,"explanation":"日本政府 = chính phủ Nhật Bản"},{"question":"Từ 「有期徒刑」 có nghĩa là gì?","options":["bỏ tù","bắt giữ","đi dạo","Bộ văn hóa"],"answer_index":0,"explanation":"有期徒刑 = bỏ tù"},{"question":"Từ 「服务员」 có nghĩa là gì?","options":["bồi bàn","bắt giữ","đi dạo","Bộ văn hóa"],"answer_index":0,"explanation":"服务员 = bồi bàn"},{"question":"Từ 「本案」 có nghĩa là gì?","options":["Trường hợp này","bắt giữ","đi dạo","Bộ văn hóa"],"answer_index":0,"explanation":"本案 = Trường hợp này"}],"pattern":[{"question":"Chọn từ đúng