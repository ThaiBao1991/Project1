tence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_7af26008","audio_ref":"m_bee23854","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5007be61"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1895","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"开赛を 使います。","line_vi":"Tôi dùng 开赛.","focus_words":["开赛"]},{"speaker":"B","line_target":"心存 は 何ですか。","line_vi":"心存 là cái gì?","focus_words":["心存"]},{"speaker":"A","line_target":"必有です。","line_vi":"Đó là 必有.","focus_words":["必有"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4576d5ce","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「开赛」 có nghĩa là gì?","options":["Bắt đầu","Hãy ghi nhớ","Phải có","lo lắng"],"answer_index":0,"explanation":"开赛 = Bắt đầu"},{"question":"Từ 「心存」 có nghĩa là gì?","options":["Hãy ghi nhớ","Bắt đầu","Phải có","lo lắng"],"answer_index":0,"explanation":"心存 = Hãy ghi nhớ"},{"question":"Từ 「必有」 có nghĩa là gì?","options":["Phải có","Bắt đầu","Hãy ghi nhớ","lo lắng"],"answer_index":0,"explanation":"必有 = Phải có"},{"question":"Từ 「忧心」 có nghĩa là gì?","options":["lo lắng","Bắt đầu","Hãy ghi nhớ","Phải có"],"answer_index":0,"explanation":"忧心 = lo lắng"},{"question":"Từ 「快去」 có nghĩa là gì?","options":["Đi nhanh lên","Bắt đầu","Hãy ghi nhớ","Phải có"],"answer_index":0,"explanation":"快去 = Đi nhanh lên"},{"question":"Từ 「总指挥」 có nghĩa là gì?","options":["tổng tư lệnh","Bắt đầu","Hãy ghi nhớ","Phải có"],"answer_index":0,"explanation":"总指挥 = tổng tư lệnh"},{"question":"Từ 「恪守」 có nghĩa là gì?","options":["tuân theo","Bắt đầu","Hãy ghi nhớ","Phải có"],"answer_index":0,"explanation":"恪守 = tuân theo"},{"question":"Từ 「恶果」 có nghĩa là gì?","options":["Hậu quả