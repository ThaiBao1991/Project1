h."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 552","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"陷阱を 使います。","line_vi":"Tôi dùng 陷阱.","focus_words":["陷阱"]},{"speaker":"B","line_target":"雅典 は 何ですか。","line_vi":"雅典 là cái gì?","focus_words":["雅典"]},{"speaker":"A","line_target":"面具です。","line_vi":"Đó là 面具.","focus_words":["面具"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2b0f3b11","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「陷阱」 có nghĩa là gì?","options":["Bẫy","Athens","mặt nạ","kỵ binh"],"answer_index":0,"explanation":"陷阱 = Bẫy"},{"question":"Từ 「雅典」 có nghĩa là gì?","options":["Athens","Bẫy","mặt nạ","kỵ binh"],"answer_index":0,"explanation":"雅典 = Athens"},{"question":"Từ 「面具」 có nghĩa là gì?","options":["mặt nạ","Bẫy","Athens","kỵ binh"],"answer_index":0,"explanation":"面具 = mặt nạ"},{"question":"Từ 「骑兵」 có nghĩa là gì?","options":["kỵ binh","Bẫy","Athens","mặt nạ"],"answer_index":0,"explanation":"骑兵 = kỵ binh"},{"question":"Từ 「高涨」 có nghĩa là gì?","options":["bay lên","Bẫy","Athens","mặt nạ"],"answer_index":0,"explanation":"高涨 = bay lên"},{"question":"Từ 「android」 có nghĩa là gì?","options":["android","Bẫy","Athens","mặt nạ"],"answer_index":0,"explanation":"android = android"},{"question":"Từ 「house」 có nghĩa là gì?","options":["nhà ở","Bẫy","Athens","mặt nạ"],"answer_index":0,"explanation":"house = nhà ở"},{"question":"Từ 「mac」 có nghĩa là gì?","options":["mac","Bẫy","Athens","mặt nạ"],"answer_index":0,"explanation":"mac = mac"}],"pattern":[{"qu