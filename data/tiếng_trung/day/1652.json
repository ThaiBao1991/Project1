ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1652","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"baを 使います。","line_vi":"Tôi dùng ba.","focus_words":["ba"]},{"speaker":"B","line_target":"beautiful は 何ですか。","line_vi":"beautiful là cái gì?","focus_words":["beautiful"]},{"speaker":"A","line_target":"danceです。","line_vi":"Đó là dance.","focus_words":["dance"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d39aa231","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「ba」 có nghĩa là gì?","options":["ba","đẹp","khiêu vũ","vượt trội"],"answer_index":0,"explanation":"ba = ba"},{"question":"Từ 「beautiful」 có nghĩa là gì?","options":["đẹp","ba","khiêu vũ","vượt trội"],"answer_index":0,"explanation":"beautiful = đẹp"},{"question":"Từ 「dance」 có nghĩa là gì?","options":["khiêu vũ","ba","đẹp","vượt trội"],"answer_index":0,"explanation":"dance = khiêu vũ"},{"question":"Từ 「excel」 có nghĩa là gì?","options":["vượt trội","ba","đẹp","khiêu vũ"],"answer_index":0,"explanation":"excel = vượt trội"},{"question":"Từ 「france」 có nghĩa là gì?","options":["Pháp","ba","đẹp","khiêu vũ"],"answer_index":0,"explanation":"france = Pháp"},{"question":"Từ 「future」 có nghĩa là gì?","options":["tương lai","ba","đẹp","khiêu vũ"],"answer_index":0,"explanation":"future = tương lai"},{"question":"Từ 「h7n9」 có nghĩa là gì?","options":["h7n9","ba","đẹp","khiêu vũ"],"answer_index":0,"explanati