":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1097","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"多方面を 使います。","line_vi":"Tôi dùng 多方面.","focus_words":["多方面"]},{"speaker":"B","line_target":"多条 は 何ですか。","line_vi":"多条 là cái gì?","focus_words":["多条"]},{"speaker":"A","line_target":"大唐です。","line_vi":"Đó là 大唐.","focus_words":["大唐"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3312fcf7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「多方面」 có nghĩa là gì?","options":["Nhiều khía cạnh","Nhiều","Đại Đường","đầu to"],"answer_index":0,"explanation":"多方面 = Nhiều khía cạnh"},{"question":"Từ 「多条」 có nghĩa là gì?","options":["Nhiều","Nhiều khía cạnh","Đại Đường","đầu to"],"answer_index":0,"explanation":"多条 = Nhiều"},{"question":"Từ 「大唐」 có nghĩa là gì?","options":["Đại Đường","Nhiều khía cạnh","Nhiều","đầu to"],"answer_index":0,"explanation":"大唐 = Đại Đường"},{"question":"Từ 「大头」 có nghĩa là gì?","options":["đầu to","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"大头 = đầu to"},{"question":"Từ 「天性」 có nghĩa là gì?","options":["thiên nhiên","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"天性 = thiên nhiên"},{"question":"Từ 「好奇心」 có nghĩa là gì?","options":["sự tò mò","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"好奇心 = sự tò mò"},{"question":"Từ 