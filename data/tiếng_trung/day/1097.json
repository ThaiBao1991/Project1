vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1097","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"多方面を 使います。","line_vi":"Tôi dùng 多方面.","focus_words":["多方面"]},{"speaker":"B","line_target":"多条 は 何ですか。","line_vi":"多条 là cái gì?","focus_words":["多条"]},{"speaker":"A","line_target":"大唐です。","line_vi":"Đó là 大唐.","focus_words":["大唐"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「多方面」 có nghĩa là gì?","options":["Nhiều khía cạnh","Nhiều","Đại Đường","đầu to"],"answer_index":0,"explanation":"多方面 = Nhiều khía cạnh"},{"question":"Từ 「多条」 có nghĩa là gì?","options":["Nhiều","Nhiều khía cạnh","Đại Đường","đầu to"],"answer_index":0,"explanation":"多条 = Nhiều"},{"question":"Từ 「大唐」 có nghĩa là gì?","options":["Đại Đường","Nhiều khía cạnh","Nhiều","đầu to"],"answer_index":0,"explanation":"大唐 = Đại Đường"},{"question":"Từ 「大头」 có nghĩa là gì?","options":["đầu to","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"大头 = đầu to"},{"question":"Từ 「天性」 có nghĩa là gì?","options":["thiên nhiên","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"天性 = thiên nhiên"},{"question":"Từ 「好奇心」 có nghĩa là gì?","options":["sự tò mò","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"好奇心 = sự tò mò"},{"question":"Từ 「如实」 có nghĩa là gì?","options":["thực sự","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"如实 = thực sự"},{"question":"Từ 「委屈」 có nghĩa là gì?","options":["bị đối xử sai trái","Nhiều khía cạnh","Nhiều","Đại Đường"],"answer_index":0,"explanation":"委屈 = bị đối xử sai trái"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Nhiều khía cạnh","options":["多方面","多条","大唐","大头"],"answer_index":0,"explanation":"多方面 = Nhiều khía cạnh"},{"question":"Chọn từ đúng cho nghĩa: Nhiều","op