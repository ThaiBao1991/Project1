n là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1086","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"译文を 使います。","line_vi":"Tôi dùng 译文.","focus_words":["译文"]},{"speaker":"B","line_target":"译自 は 何ですか。","line_vi":"译自 là cái gì?","focus_words":["译自"]},{"speaker":"A","line_target":"诺言です。","line_vi":"Đó là 诺言.","focus_words":["诺言"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6da5836a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「译文」 có nghĩa là gì?","options":["dịch thuật","Được dịch từ","lời hứa","hòa giải"],"answer_index":0,"explanation":"译文 = dịch thuật"},{"question":"Từ 「译自」 có nghĩa là gì?","options":["Được dịch từ","dịch thuật","lời hứa","hòa giải"],"answer_index":0,"explanation":"译自 = Được dịch từ"},{"question":"Từ 「诺言」 có nghĩa là gì?","options":["lời hứa","dịch thuật","Được dịch từ","hòa giải"],"answer_index":0,"explanation":"诺言 = lời hứa"},{"question":"Từ 「调和」 có nghĩa là gì?","options":["hòa giải","dịch thuật","Được dịch từ","lời hứa"],"answer_index":0,"explanation":"调和 = hòa giải"},{"question":"Từ 「谷物」 có nghĩa là gì?","options":["ngũ cốc","dịch thuật","Được dịch từ","lời hứa"],"answer_index":0,"explanation":"谷物 = ngũ cốc"},{"question":"Từ 「赤道」 có nghĩa là gì?","options":["Xích đạo","dịch thuật","Được dịch từ","lời hứa"],"answer_