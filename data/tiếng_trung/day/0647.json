onunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 647","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"打出を 使います。","line_vi":"Tôi dùng 打出.","focus_words":["打出"]},{"speaker":"B","line_target":"打扰 は 何ですか。","line_vi":"打扰 là cái gì?","focus_words":["打扰"]},{"speaker":"A","line_target":"扶持です。","line_vi":"Đó là 扶持.","focus_words":["扶持"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6016717e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「打出」 có nghĩa là gì?","options":["loại","làm phiền","hỗ trợ","lần lượt"],"answer_index":0,"explanation":"打出 = loại"},{"question":"Từ 「打扰」 có nghĩa là gì?","options":["làm phiền","loại","hỗ trợ","lần lượt"],"answer_index":0,"explanation":"打扰 = làm phiền"},{"question":"Từ 「扶持」 có nghĩa là gì?","options":["hỗ trợ","loại","làm phiền","lần lượt"],"answer_index":0,"explanation":"扶持 = hỗ trợ"},{"question":"Từ 「接连」 có nghĩa là gì?","options":["lần lượt","loại","làm phiền","hỗ trợ"],"answer_index":0,"explanation":"接连 = lần lượt"},{"question":"Từ 「撒谎」 có nghĩa là gì?","options":["nói dối","loại","làm phiền","hỗ trợ"],"answer_index":0,"explanation":"撒谎 = nói dối"},{"question":"Từ 「操作系统」 có nghĩa là gì?","options":["hệ điều hành","loại","làm phiền","hỗ trợ"],"answer_index":0,"explanation":"操作系统 = hệ điều hành"},{"question":"Từ 「效能」 có nghĩa là gì?","options":["hiệu quả","loại","làm phiền","hỗ trợ"],"answer_index":0,"explanation":"效能 = hiệu quả"},{"question":"Từ 「旅行社」 có nghĩa là gì?","options":["đại lý du lịch","loại","làm phiền","hỗ trợ"],"answer_index":0,"explanation":"旅行社 = đại lý du