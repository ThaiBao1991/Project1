."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 598","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"功率を 使います。","line_vi":"Tôi dùng 功率.","focus_words":["功率"]},{"speaker":"B","line_target":"动乱 は 何ですか。","line_vi":"动乱 là cái gì?","focus_words":["动乱"]},{"speaker":"A","line_target":"动用です。","line_vi":"Đó là 动用.","focus_words":["动用"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_13d37c39","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「功率」 có nghĩa là gì?","options":["quyền lực","tình trạng bất ổn","sử dụng","tháng mười một"],"answer_index":0,"explanation":"功率 = quyền lực"},{"question":"Từ 「动乱」 có nghĩa là gì?","options":["tình trạng bất ổn","quyền lực","sử dụng","tháng mười một"],"answer_index":0,"explanation":"动乱 = tình trạng bất ổn"},{"question":"Từ 「动用」 có nghĩa là gì?","options":["sử dụng","quyền lực","tình trạng bất ổn","tháng mười một"],"answer_index":0,"explanation":"动用 = sử dụng"},{"question":"Từ 「十一月」 có nghĩa là gì?","options":["tháng mười một","quyền lực","tình trạng bất ổn","sử dụng"],"answer_index":0,"explanation":"十一月 = tháng mười một"},{"question":"Từ 「华夏」 có nghĩa là gì?","options":["Trung Quốc","quyền lực","tình trạng bất ổn","sử dụng"],"answer_index":0,"explanation":"华夏 = Trung Quốc"},{"question":"Từ 「卡片」 có nghĩa là gì?","options":["thẻ","quyền lực","tình trạng bất ổn","sử dụng"],"answer_index":0,"explanation":"卡片 = thẻ"},{"question":"Từ 「发展中国家」 có nghĩa là gì?","options":["các nước đang phát triển","quyền lực","