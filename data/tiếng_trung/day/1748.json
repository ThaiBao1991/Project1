":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1748","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"孟子を 使います。","line_vi":"Tôi dùng 孟子.","focus_words":["孟子"]},{"speaker":"B","line_target":"守护者 は 何ですか。","line_vi":"守护者 là cái gì?","focus_words":["守护者"]},{"speaker":"A","line_target":"安东です。","line_vi":"Đó là 安东.","focus_words":["安东"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b8b0d2db","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「孟子」 có nghĩa là gì?","options":["Mạnh Tử","người giám hộ","Anton","dây an toàn"],"answer_index":0,"explanation":"孟子 = Mạnh Tử"},{"question":"Từ 「守护者」 có nghĩa là gì?","options":["người giám hộ","Mạnh Tử","Anton","dây an toàn"],"answer_index":0,"explanation":"守护者 = người giám hộ"},{"question":"Từ 「安东」 có nghĩa là gì?","options":["Anton","Mạnh Tử","người giám hộ","dây an toàn"],"answer_index":0,"explanation":"安东 = Anton"},{"question":"Từ 「安全带」 có nghĩa là gì?","options":["dây an toàn","Mạnh Tử","người giám hộ","Anton"],"answer_index":0,"explanation":"安全带 = dây an toàn"},{"question":"Từ 「宗族」 có nghĩa là gì?","options":["thị tộc","Mạnh Tử","người giám hộ","Anton"],"answer_index":0,"explanation":"宗族 = thị tộc"},{"question":"Từ 「官邸」 có nghĩa là gì?","options":["nơi ở chính thức","Mạnh Tử","người giám hộ","Anton"],"answer_index":0,"explanation":"官邸 = nơi ở chính thức"},{"question":"Từ 「宝鸡」 có nghĩa là gì?","options":["Bảo Kí","Mạnh Tử","người giám hộ","Anton"],"answer_index":0,"explanation":"宝鸡 = Bảo Kí"},{"question":"Từ 「实权」 có nghĩa là gì?","options":["quyền lực thực sự",