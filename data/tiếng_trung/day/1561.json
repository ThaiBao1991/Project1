i không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1561","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"杂草を 使います。","line_vi":"Tôi dùng 杂草.","focus_words":["杂草"]},{"speaker":"B","line_target":"标志性 は 何ですか。","line_vi":"标志性 là cái gì?","focus_words":["标志性"]},{"speaker":"A","line_target":"正月です。","line_vi":"Đó là 正月.","focus_words":["正月"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4bcbf767","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「杂草」 có nghĩa là gì?","options":["cỏ dại","mang tính biểu tượng","tháng đầu tiên","lực lượng vũ trang"],"answer_index":0,"explanation":"杂草 = cỏ dại"},{"question":"Từ 「标志性」 có nghĩa là gì?","options":["mang tính biểu tượng","cỏ dại","tháng đầu tiên","lực lượng vũ trang"],"answer_index":0,"explanation":"标志性 = mang tính biểu tượng"},{"question":"Từ 「正月」 có nghĩa là gì?","options":["tháng đầu tiên","cỏ dại","mang tính biểu tượng","lực lượng vũ trang"],"answer_index":0,"explanation":"正月 = tháng đầu tiên"},{"question":"Từ 「武装部队」 có nghĩa là gì?","options":["lực lượng vũ trang","cỏ dại","mang tính biểu tượng","tháng đầu tiên"],"answer_index":0,"explanation":"武装部队 = lực lượng vũ trang"},{"question":"Từ 「民选」 có nghĩa là gì?","options":["Được bầu chọn phổ biến","cỏ dại","mang tính biểu tượng","tháng đầu tiên"],"answer_index":0,"explanation":"民选 = Được bầu chọn phổ biến"},{"question":"Từ 「水路」 có nghĩa là gì?","options":["đường thuỷ","cỏ dại","mang tính biểu tượng","tháng đầu tiên"],"answer_index":0,"explanation":"水路 = đường thuỷ"