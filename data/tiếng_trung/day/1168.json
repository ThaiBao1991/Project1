iờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1168","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"租用を 使います。","line_vi":"Tôi dùng 租用.","focus_words":["租用"]},{"speaker":"B","line_target":"移送 は 何ですか。","line_vi":"移送 là cái gì?","focus_words":["移送"]},{"speaker":"A","line_target":"第一家です。","line_vi":"Đó là 第一家.","focus_words":["第一家"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2761fad9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「租用」 có nghĩa là gì?","options":["thuê","chuyển nhượng","cái đầu tiên","năm thứ hai"],"answer_index":0,"explanation":"租用 = thuê"},{"question":"Từ 「移送」 có nghĩa là gì?","options":["chuyển nhượng","thuê","cái đầu tiên","năm thứ hai"],"answer_index":0,"explanation":"移送 = chuyển nhượng"},{"question":"Từ 「第一家」 có nghĩa là gì?","options":["cái đầu tiên","thuê","chuyển nhượng","năm thứ hai"],"answer_index":0,"explanation":"第一家 = cái đầu tiên"},{"question":"Từ 「第二年」 có nghĩa là gì?","options":["năm thứ hai","thuê","chuyển nhượng","cái đầu tiên"],"answer_index":0,"explanation":"第二年 = năm thứ hai"},{"question":"Từ 「筹集」 có nghĩa là gì?","options":["nâng cao","thuê","chuyển nhượng","cái đầu tiên"],"answer_index":0,"explanation":"筹集 = nâng cao"},{"question":"Từ 「简体」 có nghĩa là gì?","options":["Đơn giản hóa","thuê","chuyển nhượng","cái đầu tiên"],"answer_index":0,"explanation":"简体 = Đơn giản hóa"},{"question":"Từ 「粉色」 có nghĩa là gì?","options":["màu hồng","thuê","chuyển nhượng","cái đầu tiên"]