5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1834","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大旗を 使います。","line_vi":"Tôi dùng 大旗.","focus_words":["大旗"]},{"speaker":"B","line_target":"大洋洲 は 何ですか。","line_vi":"大洋洲 là cái gì?","focus_words":["大洋洲"]},{"speaker":"A","line_target":"大猩猩です。","line_vi":"Đó là 大猩猩.","focus_words":["大猩猩"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2f4f8aaa","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大旗」 có nghĩa là gì?","options":["biểu ngữ","Châu Đại Dương","khỉ đột","Giảm lớn"],"answer_index":0,"explanation":"大旗 = biểu ngữ"},{"question":"Từ 「大洋洲」 có nghĩa là gì?","options":["Châu Đại Dương","biểu ngữ","khỉ đột","Giảm lớn"],"answer_index":0,"explanation":"大洋洲 = Châu Đại Dương"},{"question":"Từ 「大猩猩」 có nghĩa là gì?","options":["khỉ đột","biểu ngữ","Châu Đại Dương","Giảm lớn"],"answer_index":0,"explanation":"大猩猩 = khỉ đột"},{"question":"Từ 「大跌」 có nghĩa là gì?","options":["Giảm lớn","biểu ngữ","Châu Đại Dương","khỉ đột"],"answer_index":0,"explanation":"大跌 = Giảm lớn"},{"question":"Từ 「夭折」 có nghĩa là gì?","options":["chết trẻ","biểu ngữ","Châu Đại Dương","khỉ đột"],"answer_index":0,"explanation":"夭折 = chết trẻ"},{"question":"Từ 「头条新闻」 có nghĩa là gì?","options":["tiêu đề","biểu ngữ","Châu Đại Dương","khỉ đột"],"answer_index":0,"explanation":"头条新闻 = tiêu đề"},{"question":"