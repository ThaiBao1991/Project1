s":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_3cc65509","audio_ref":"m_aae512aa","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e3e06833"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1337","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"梯子を 使います。","line_vi":"Tôi dùng 梯子.","focus_words":["梯子"]},{"speaker":"B","line_target":"检疫 は 何ですか。","line_vi":"检疫 là cái gì?","focus_words":["检疫"]},{"speaker":"A","line_target":"每场です。","line_vi":"Đó là 每场.","focus_words":["每场"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c5d2233b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「梯子」 có nghĩa là gì?","options":["thang","cách ly","mọi trò chơi","Mỗi lần"],"answer_index":0,"explanation":"梯子 = thang"},{"question":"Từ 「检疫」 có nghĩa là gì?","options":["cách ly","thang","mọi trò chơi","Mỗi lần"],"answer_index":0,"explanation":"检疫 = cách ly"},{"question":"Từ 「每场」 có nghĩa là gì?","options":["mọi trò chơi","thang","cách ly","Mỗi lần"],"answer_index":0,"explanation":"每场 = mọi trò chơi"},{"question":"Từ 「每逢」 có nghĩa là gì?","options":["Mỗi lần","thang","cách ly","mọi trò chơi"],"answer_index":0,"explanation":"每逢 = Mỗi lần"},{"question":"Từ 「毒蛇」 có nghĩa là gì?","options":["rắn độc","thang","cách ly","mọi trò chơi"],"answer_index":0,"explanation":"毒蛇 = rắn độc"},{"question":"Từ 「气旋」 có nghĩa là gì?","options":["lốc xoáy","thang","cách ly","mọi trò chơi"],"answer_index":0,"explanation":"气旋 = lốc xoáy"},{"question":"Từ 「流利」 có nghĩa là gì?","options":["thông thạo","thang","cách ly","mọi trò chơi"],"answer_index":0,"explanation":"流利 = thông thạo"},{"question":"Từ 「流言」 có nghĩa là gì?","options":["tin đồn","thang","cách ly","mọi trò chơi"],"answer_index":0,"explanation":"流言 = tin đồn"}],