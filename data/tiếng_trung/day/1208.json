":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_2af27678","audio_ref":"m_0af7c5e1","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_54bfbb69"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1208","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"美貌を 使います。","line_vi":"Tôi dùng 美貌.","focus_words":["美貌"]},{"speaker":"B","line_target":"老妇 は 何ですか。","line_vi":"老妇 là cái gì?","focus_words":["老妇"]},{"speaker":"A","line_target":"联机です。","line_vi":"Đó là 联机.","focus_words":["联机"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_651e77a9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「美貌」 có nghĩa là gì?","options":["sắc đẹp","bà già","trực tuyến","giải quyết"],"answer_index":0,"explanation":"美貌 = sắc đẹp"},{"question":"Từ 「老妇」 có nghĩa là gì?","options":["bà già","sắc đẹp","trực tuyến","giải quyết"],"answer_index":0,"explanation":"老妇 = bà già"},{"question":"Từ 「联机」 có nghĩa là gì?","options":["trực tuyến","sắc đẹp","bà già","giải quyết"],"answer_index":0,"explanation":"联机 = trực tuyến"},{"question":"Từ 「聚落」 có nghĩa là gì?","options":["giải quyết","sắc đẹp","bà già","trực tuyến"],"answer_index":0,"explanation":"聚落 = giải quyết"},{"question":"Từ 「肆虐」 có nghĩa là gì?","options":["tàn phá","sắc đẹp","bà già","trực tuyến"],"answer_index":0,"explanation":"肆虐 = tàn phá"},{"question":"Từ 「肩上」 có nghĩa là gì?","options":["trên vai","sắc đẹp","bà già","trực tuyến"],"answer_index":0,"explanation":"肩上 = trên vai"},{"question":"Từ 「舞弊」 có nghĩa là gì?","options":["Lừa đảo","sắc đẹp","bà già","trực tuyến"],"answer_index":0,"explanation":"舞弊 = Lừa đảo"},{"question":"Từ 「芜