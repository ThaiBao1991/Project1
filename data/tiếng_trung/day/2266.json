_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2266","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"旅游者を 使います。","line_vi":"Tôi dùng 旅游者.","focus_words":["旅游者"]},{"speaker":"B","line_target":"旗舰店 は 何ですか。","line_vi":"旗舰店 là cái gì?","focus_words":["旗舰店"]},{"speaker":"A","line_target":"无时无刻です。","line_vi":"Đó là 无时无刻.","focus_words":["无时无刻"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3197eef3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「旅游者」 có nghĩa là gì?","options":["khách du lịch","cửa hàng hàng đầu","mọi lúc","Nhật Bản và Israel"],"answer_index":0,"explanation":"旅游者 = khách du lịch"},{"question":"Từ 「旗舰店」 có nghĩa là gì?","options":["cửa hàng hàng đầu","khách du lịch","mọi lúc","Nhật Bản và Israel"],"answer_index":0,"explanation":"旗舰店 = cửa hàng hàng đầu"},{"question":"Từ 「无时无刻」 có nghĩa là gì?","options":["mọi lúc","khách du lịch","cửa hàng hàng đầu","Nhật Bản và Israel"],"answer_index":0,"explanation":"无时无刻 = mọi lúc"},{"question":"Từ 「日以」 có nghĩa là gì?","options":["Nhật Bản và Israel","khách du lịch","cửa hàng hàng đầu","mọi lúc"],"answer_index":0,"explanation":"日以 = Nhật Bản và Israel"},{"question":"Từ 「旧事」 có nghĩa là gì?","options":["đồ cũ","khách du lịch","cửa hàng hàng đầu","mọi lúc"],"answer_index":0,"explanation":"旧事 = đồ cũ"},{"question":"Từ 「晃动」 có nghĩa là gì?","options":["lắc","khách du lịch","cửa hàng hàng đầu","mọi lúc"],"answer_index":0,"explanation":"晃动 = lắc