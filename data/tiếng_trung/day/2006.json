":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2006","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"专业性を 使います。","line_vi":"Tôi dùng 专业性.","focus_words":["专业性"]},{"speaker":"B","line_target":"两国关系 は 何ですか。","line_vi":"两国关系 là cái gì?","focus_words":["两国关系"]},{"speaker":"A","line_target":"两本です。","line_vi":"Đó là 两本.","focus_words":["两本"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_3b5420ee","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「专业性」 có nghĩa là gì?","options":["Tính chuyên nghiệp","quan hệ giữa hai nước","hai cuốn sách","CIA"],"answer_index":0,"explanation":"专业性 = Tính chuyên nghiệp"},{"question":"Từ 「两国关系」 có nghĩa là gì?","options":["quan hệ giữa hai nước","Tính chuyên nghiệp","hai cuốn sách","CIA"],"answer_index":0,"explanation":"两国关系 = quan hệ giữa hai nước"},{"question":"Từ 「两本」 có nghĩa là gì?","options":["hai cuốn sách","Tính chuyên nghiệp","quan hệ giữa hai nước","CIA"],"answer_index":0,"explanation":"两本 = hai cuốn sách"},{"question":"Từ 「中情局」 có nghĩa là gì?","options":["CIA","Tính chuyên nghiệp","quan hệ giữa hai nước","hai cuốn sách"],"answer_index":0,"explanation":"中情局 = CIA"},{"question":"Từ 「中来」 có nghĩa là gì?","options":["Trung Lai","Tính chuyên nghiệp","quan hệ giữa hai nướ