_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 887","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"为准を 使います。","line_vi":"Tôi dùng 为准.","focus_words":["为准"]},{"speaker":"B","line_target":"交配 は 何ですか。","line_vi":"交配 là cái gì?","focus_words":["交配"]},{"speaker":"A","line_target":"仅次于です。","line_vi":"Đó là 仅次于.","focus_words":["仅次于"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_85594f7a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「为准」 có nghĩa là gì?","options":["tùy thuộc vào","Giao phối","chỉ đứng sau","đại lý"],"answer_index":0,"explanation":"为准 = tùy thuộc vào"},{"question":"Từ 「交配」 có nghĩa là gì?","options":["Giao phối","tùy thuộc vào","chỉ đứng sau","đại lý"],"answer_index":0,"explanation":"交配 = Giao phối"},{"question":"Từ 「仅次于」 có nghĩa là gì?","options":["chỉ đứng sau","tùy thuộc vào","Giao phối","đại lý"],"answer_index":0,"explanation":"仅次于 = chỉ đứng sau"},{"question":"Từ 「代理人」 có nghĩa là gì?","options":["đại lý","tùy thuộc vào","Giao phối","chỉ đứng sau"],"answer_index":0,"explanation":"代理人 = đại lý"},{"question":"Từ 「保定」 có nghĩa là gì?","options":["Bảo Định","tùy thuộc vào","Giao phối","chỉ đứng sau"],"answer_index":0,"explanation":"保定 = Bảo Định"},{"question":"Từ 「借钱」 có nghĩa là gì?","options":["vay tiền","tùy thuộc vào","Giao phối","chỉ đứng sau"],"answer_index":0,"explanation":"借钱 = vay tiền"},{"question":"Từ 「傀儡」 có nghĩa là gì?","options":["con rối","tùy thuộc vào","Giao phối","chỉ đứng sau"],"answer_index":0,"explanation":"傀儡 = con rối"},{"question":"Từ 「免得」 có nghĩa là gì?"