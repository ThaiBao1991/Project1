。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1531","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"悖论を 使います。","line_vi":"Tôi dùng 悖论.","focus_words":["悖论"]},{"speaker":"B","line_target":"患上 は 何ですか。","line_vi":"患上 là cái gì?","focus_words":["患上"]},{"speaker":"A","line_target":"想一想です。","line_vi":"Đó là 想一想.","focus_words":["想一想"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d98253a8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「悖论」 có nghĩa là gì?","options":["nghịch lý","chịu đựng","nghĩ về nó","Vô minh"],"answer_index":0,"explanation":"悖论 = nghịch lý"},{"question":"Từ 「患上」 có nghĩa là gì?","options":["chịu đựng","nghịch lý","nghĩ về nó","Vô minh"],"answer_index":0,"explanation":"患上 = chịu đựng"},{"question":"Từ 「想一想」 có nghĩa là gì?","options":["nghĩ về nó","nghịch lý","chịu đựng","Vô minh"],"answer_index":0,"explanation":"想一想 = nghĩ về nó"},{"question":"Từ 「愚昧」 có nghĩa là gì?","options":["Vô minh","nghịch lý","chịu đựng","nghĩ về nó"],"answer_index":0,"explanation":"愚昧 = Vô minh"},{"question":"Từ 「成龙」 có nghĩa là gì?","options":["Thành Long","nghịch lý","chịu đựng","nghĩ về nó"],"answer_index":0,"explanation":"成龙 = Thành Long"},{"question":"Từ 「战地」 có nghĩa là gì?","options":["chiến trường","nghịch lý","chịu đựng","nghĩ về nó"],"answer_index":0,"explanation":"战地 = chiến trường"},{"question":"Từ 「所有制」 có nghĩa là gì?","options":["quyền sở hữu","nghịch lý","chịu đựng","nghĩ về nó"],"answer_index":0,"explanation":"所有制 = quyền sở hữu"},{"questi