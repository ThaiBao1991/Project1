ứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1782","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"显赫を 使います。","line_vi":"Tôi dùng 显赫.","focus_words":["显赫"]},{"speaker":"B","line_target":"最重 は 何ですか。","line_vi":"最重 là cái gì?","focus_words":["最重"]},{"speaker":"A","line_target":"最高点です。","line_vi":"Đó là 最高点.","focus_words":["最高点"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c26a3abd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「显赫」 có nghĩa là gì?","options":["Nổi bật","nặng nhất","điểm cao nhất","nghề mộc"],"answer_index":0,"explanation":"显赫 = Nổi bật"},{"question":"Từ 「最重」 có nghĩa là gì?","options":["nặng nhất","Nổi bật","điểm cao nhất","nghề mộc"],"answer_index":0,"explanation":"最重 = nặng nhất"},{"question":"Từ 「最高点」 có nghĩa là gì?","options":["điểm cao nhất","Nổi bật","nặng nhất","nghề mộc"],"answer_index":0,"explanation":"最高点 = điểm cao nhất"},{"question":"Từ 「木工」 có nghĩa là gì?","options":["nghề mộc","Nổi bật","nặng nhất","điểm cao nhất"],"answer_index":0,"explanation":"木工 = nghề mộc"},{"question":"Từ 「李鸿章」 có nghĩa là gì?","options":["Lý Hồng Chương","Nổi bật","nặng nhất","điểm cao nhất"],"answer_index":0,"explanation":"李鸿章 = Lý Hồng Chương"},{"question":"Từ 「果子」 có nghĩa là gì?","options":["trái cây","Nổi bật","nặng nhất","điểm cao nhất"],"answer_index":0,"explanation":"果子 = trái cây"},{"question":"Từ 「枷锁」 có nghĩa là gì?","options":["xiềng xích","Nổi bật","nặng nhất","điểm cao nhất"],"answer_index":0,"explanation":"枷锁 = xiềng xích"},{"question":"Từ 「棋盘」 có nghĩa là gì?","opt