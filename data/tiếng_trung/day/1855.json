ời lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1855","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"中小学生を 使います。","line_vi":"Tôi dùng 中小学生.","focus_words":["中小学生"]},{"speaker":"B","line_target":"为数不多 は 何ですか。","line_vi":"为数不多 là cái gì?","focus_words":["为数不多"]},{"speaker":"A","line_target":"乌拉です。","line_vi":"Đó là 乌拉.","focus_words":["乌拉"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f263b1f5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「中小学生」 có nghĩa là gì?","options":["học sinh tiểu học và trung học","rất ít","Ulla","Chín mươi phần trăm"],"answer_index":0,"explanation":"中小学生 = học sinh tiểu học và trung học"},{"question":"Từ 「为数不多」 có nghĩa là gì?","options":["rất ít","học sinh tiểu học và trung học","Ulla","Chín mươi phần trăm"],"answer_index":0,"explanation":"为数不多 = rất ít"},{"question":"Từ 「乌拉」 có nghĩa là gì?","options":["Ulla","học sinh tiểu học và trung học","rất ít","Chín mươi phần trăm"],"answer_index":0,"explanation":"乌拉 = Ulla"},{"question":"Từ 「九成」 có nghĩa là gì?","options":["Chín mươi phần trăm","học sinh tiểu học và trung học","rất ít","Ulla"],"answer_index":0,"explanation":"九成 = Chín mươi phần trăm"},{"question":"Từ 「二十多年」 có nghĩa là gì?","options":["hơn hai mươi năm","học sinh tiểu học và trung học","rất ít","Ulla"],"answer_index":0,"explanation":"二十多年 = hơn hai mươ