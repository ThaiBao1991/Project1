"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_0f8c6c78","audio_ref":"m_1778ba99","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_21935e91"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1582","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"寻觅を 使います。","line_vi":"Tôi dùng 寻觅.","focus_words":["寻觅"]},{"speaker":"B","line_target":"小伙伴 は 何ですか。","line_vi":"小伙伴 là cái gì?","focus_words":["小伙伴"]},{"speaker":"A","line_target":"尼罗河です。","line_vi":"Đó là 尼罗河.","focus_words":["尼罗河"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_020dac3f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「寻觅」 có nghĩa là gì?","options":["đang tìm kiếm","Bạn bè","sông nile","hết hạn"],"answer_index":0,"explanation":"寻觅 = đang tìm kiếm"},{"question":"Từ 「小伙伴」 có nghĩa là gì?","options":["Bạn bè","đang tìm kiếm","sông nile","hết hạn"],"answer_index":0,"explanation":"小伙伴 = Bạn bè"},{"question":"Từ 「尼罗河」 có nghĩa là gì?","options":["sông nile","đang tìm kiếm","Bạn bè","hết hạn"],"answer_index":0,"explanation":"尼罗河 = sông nile"},{"question":"Từ 「届满」 có nghĩa là gì?","options":["hết hạn","đang tìm kiếm","Bạn bè","sông nile"],"answer_index":0,"explanation":"届满 = hết hạn"},{"question":"Từ 「属地」 có nghĩa là gì?","options":["Lãnh thổ","đang tìm kiếm","Bạn bè","sông nile"],"answer_index":0,"explanation":"属地 = Lãnh thổ"},{"question":"Từ 「巴比」 có nghĩa là gì?","options":["Bobby","đang tìm kiếm","Bạn bè","sông nile"],"answer_index":0,"explanation":"巴比 = Bobby"},{"question":"Từ 「布莱恩」 có nghĩa là gì?","options":["Brian","đang tìm kiếm","