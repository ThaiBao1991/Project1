す。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1002","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"后天を 使います。","line_vi":"Tôi dùng 后天.","focus_words":["后天"]},{"speaker":"B","line_target":"告终 は 何ですか。","line_vi":"告终 là cái gì?","focus_words":["告终"]},{"speaker":"A","line_target":"告诫です。","line_vi":"Đó là 告诫.","focus_words":["告诫"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1c94cd71","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「后天」 có nghĩa là gì?","options":["ngày mốt","kết thúc","cảnh báo","bốn ngày"],"answer_index":0,"explanation":"后天 = ngày mốt"},{"question":"Từ 「告终」 có nghĩa là gì?","options":["kết thúc","ngày mốt","cảnh báo","bốn ngày"],"answer_index":0,"explanation":"告终 = kết thúc"},{"question":"Từ 「告诫」 có nghĩa là gì?","options":["cảnh báo","ngày mốt","kết thúc","bốn ngày"],"answer_index":0,"explanation":"告诫 = cảnh báo"},{"question":"Từ 「四天」 có nghĩa là gì?","options":["bốn ngày","ngày mốt","kết thúc","cảnh báo"],"answer_index":0,"explanation":"四天 = bốn ngày"},{"question":"Từ 「围剿」 có nghĩa là gì?","options":["bao vây và đàn áp","ngày mốt","kết thúc","cảnh báo"],"answer_index":0,"explanation":"围剿 = bao vây và đàn áp"},{"question":"Từ 「国道」 có nghĩa là gì?","options":["quốc lộ","ngày mốt","kết thúc","cảnh báo"],"answer_index":0,"explanation":"国道 = quốc lộ"},{"question":"Từ 「地道」 có nghĩa là gì?","options":["đích thực","ngày mốt","kết thúc","cảnh báo"],"answer_index":0,"explanation":"地道 = đích thực"},{"question":"Từ 「大业」 có nghĩa là gì?","options":["nguyên nhân lớn","ngày