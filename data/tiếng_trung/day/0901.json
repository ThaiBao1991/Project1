hắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 901","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"遇难を 使います。","line_vi":"Tôi dùng 遇难.","focus_words":["遇难"]},{"speaker":"B","line_target":"酋长 は 何ですか。","line_vi":"酋长 là cái gì?","focus_words":["酋长"]},{"speaker":"A","line_target":"配方です。","line_vi":"Đó là 配方.","focus_words":["配方"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1e2d3f8a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「遇难」 có nghĩa là gì?","options":["gặp nạn","người đứng đầu","Công thức","tiền giấy"],"answer_index":0,"explanation":"遇难 = gặp nạn"},{"question":"Từ 「酋长」 có nghĩa là gì?","options":["người đứng đầu","gặp nạn","Công thức","tiền giấy"],"answer_index":0,"explanation":"酋长 = người đứng đầu"},{"question":"Từ 「配方」 có nghĩa là gì?","options":["Công thức","gặp nạn","người đứng đầu","tiền giấy"],"answer_index":0,"explanation":"配方 = Công thức"},{"question":"Từ 「钞票」 có nghĩa là gì?","options":["tiền giấy","gặp nạn","người đứng đầu","Công thức"],"answer_index":0,"explanation":"钞票 = tiền giấy"},{"question":"Từ 「铸造」 có nghĩa là gì?","options":["vật đúc","gặp nạn","người đứng đầu","Công thức"],"answer_index":0,"explanation":"铸造 = vật đúc"},{"question":"Từ 「间隔」 có nghĩa là gì?","options":["khoảng thời gian","gặp nạn","người đứng 