entence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d54c31fc","audio_ref":"m_a303835d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_2a9cafac"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1574","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"与会者を 使います。","line_vi":"Tôi dùng 与会者.","focus_words":["与会者"]},{"speaker":"B","line_target":"世界末日 は 何ですか。","line_vi":"世界末日 là cái gì?","focus_words":["世界末日"]},{"speaker":"A","line_target":"世界遗产です。","line_vi":"Đó là 世界遗产.","focus_words":["世界遗产"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4d5c5769","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「与会者」 có nghĩa là gì?","options":["Người tham dự","ngày tận thế","di sản thế giới","Đông Pha"],"answer_index":0,"explanation":"与会者 = Người tham dự"},{"question":"Từ 「世界末日」 có nghĩa là gì?","options":["ngày tận thế","Người tham dự","di sản thế giới","Đông Pha"],"answer_index":0,"explanation":"世界末日 = ngày tận thế"},{"question":"Từ 「世界遗产」 có nghĩa là gì?","options":["di sản thế giới","Người tham dự","ngày tận thế","Đông Pha"],"answer_index":0,"explanation":"世界遗产 = di sản thế giới"},{"question":"Từ 「东坡」 có nghĩa là gì?","options":["Đông Pha","Người tham dự","ngày tận thế","di sản thế giới"],"answer_index":0,"explanation":"东坡 = Đông Pha"},{"question":"Từ 「两届」 có nghĩa là gì?","options":["Hai thuật ngữ","Người tham dự","ngày tận thế","di sản thế giới"],"answer_index":0,"explanation":"两届 = Hai thuật ngữ"},{"question":"Từ 「两百」 có nghĩa là gì?","options":["hai trăm","Người tham dự","ngày tận thế","di sả