ce":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_cfb7a0f1","audio_ref":"m_a404ec71","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_68422c58"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2227","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"定金を 使います。","line_vi":"Tôi dùng 定金.","focus_words":["定金"]},{"speaker":"B","line_target":"宵禁 は 何ですか。","line_vi":"宵禁 là cái gì?","focus_words":["宵禁"]},{"speaker":"A","line_target":"宿主です。","line_vi":"Đó là 宿主.","focus_words":["宿主"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_af728cc3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「定金」 có nghĩa là gì?","options":["đặt cọc","giờ giới nghiêm","chủ nhà","đồi núi"],"answer_index":0,"explanation":"定金 = đặt cọc"},{"question":"Từ 「宵禁」 có nghĩa là gì?","options":["giờ giới nghiêm","đặt cọc","chủ nhà","đồi núi"],"answer_index":0,"explanation":"宵禁 = giờ giới nghiêm"},{"question":"Từ 「宿主」 có nghĩa là gì?","options":["chủ nhà","đặt cọc","giờ giới nghiêm","đồi núi"],"answer_index":0,"explanation":"宿主 = chủ nhà"},{"question":"Từ 「小山」 có nghĩa là gì?","options":["đồi núi","đặt cọc","giờ giới nghiêm","chủ nhà"],"answer_index":0,"explanation":"小山 = đồi núi"},{"question":"Từ 「尖峰」 có nghĩa là gì?","options":["gai nhọn","đặt cọc","giờ giới nghiêm","chủ nhà"],"answer_index":0,"explanation":"尖峰 = gai nhọn"},{"question":"Từ 「居中」 có nghĩa là gì?","options":["trung tâm","đặt cọc","giờ giới nghiêm","chủ nhà"],"answer_index":0,"explanation":"居中 = trung tâm"},{"question":"Từ 「展览馆」 có nghĩa là gì?","options":["phòng triển lãm","đặt cọc","giờ giới nghiêm","c