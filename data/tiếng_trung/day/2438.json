lables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a1f2b011","audio_ref":"m_877a02cc","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_b6f77a36"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2438","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"查实を 使います。","line_vi":"Tôi dùng 查实.","focus_words":["查实"]},{"speaker":"B","line_target":"柯林斯 は 何ですか。","line_vi":"柯林斯 là cái gì?","focus_words":["柯林斯"]},{"speaker":"A","line_target":"植株です。","line_vi":"Đó là 植株.","focus_words":["植株"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ff61f4b7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「查实」 có nghĩa là gì?","options":["Xác minh","Collins","thực vật","cầm máu"],"answer_index":0,"explanation":"查实 = Xác minh"},{"question":"Từ 「柯林斯」 có nghĩa là gì?","options":["Collins","Xác minh","thực vật","cầm máu"],"answer_index":0,"explanation":"柯林斯 = Collins"},{"question":"Từ 「植株」 có nghĩa là gì?","options":["thực vật","Xác minh","Collins","cầm máu"],"answer_index":0,"explanation":"植株 = thực vật"},{"question":"Từ 「止血」 có nghĩa là gì?","options":["cầm máu","Xác minh","Collins","thực vật"],"answer_index":0,"explanation":"止血 = cầm máu"},{"question":"Từ 「民粹主义」 có nghĩa là gì?","options":["chủ nghĩa dân túy","Xác minh","Collins","thực vật"],"answer_index":0,"explanation":"民粹主义 = chủ nghĩa dân túy"},{"question":"Từ 「水产品」 có nghĩa là gì?","options":["Thủy sản","Xác minh","Collins","thực vật"],"answer_index":0,"explanation":"水产品 = Thủy sản"},{"question":"Từ 「水彩」 có nghĩa là gì?","options":["màu nước","Xác minh","Collins","thực vật"],"answer_index":0,"explanation":"水彩 = màu nước"},{"question":"Từ 「水银」 có nghĩa là gì?","options":["thủy ngân