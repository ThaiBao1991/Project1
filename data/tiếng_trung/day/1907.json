n mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1907","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"自责を 使います。","line_vi":"Tôi dùng 自责.","focus_words":["自责"]},{"speaker":"B","line_target":"良多 は 何ですか。","line_vi":"良多 là cái gì?","focus_words":["良多"]},{"speaker":"A","line_target":"节俭です。","line_vi":"Đó là 节俭.","focus_words":["节俭"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_701e1b01","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「自责」 có nghĩa là gì?","options":["tự trách mình","rất nhiều","Tính tiết kiệm","ngựa bùn cỏ"],"answer_index":0,"explanation":"自责 = tự trách mình"},{"question":"Từ 「良多」 có nghĩa là gì?","options":["rất nhiều","tự trách mình","Tính tiết kiệm","ngựa bùn cỏ"],"answer_index":0,"explanation":"良多 = rất nhiều"},{"question":"Từ 「节俭」 có nghĩa là gì?","options":["Tính tiết kiệm","tự trách mình","rất nhiều","ngựa bùn cỏ"],"answer_index":0,"explanation":"节俭 = Tính tiết kiệm"},{"question":"Từ 「草泥马」 có nghĩa là gì?","options":["ngựa bùn cỏ","tự trách mình","rất nhiều","Tính tiết kiệm"],"answer_index":0,"explanation":"草泥马 = ngựa bùn cỏ"},{"question":"Từ 「获益」 có nghĩa là gì?","options":["lợi ích","tự trách mình","rất nhiều","Tính tiết kiệm"],"answer_index":0,"explanation":"获益 = lợi ích"},{"question":"Từ 「落空」 có nghĩa là gì?","options":["thất bại","tự trách mình","rất nhiều","Tính tiết kiệm"],"answer_index":0,"explanation":"落空 = thất bại"},{"question":