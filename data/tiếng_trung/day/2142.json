す。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2142","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"之女を 使います。","line_vi":"Tôi dùng 之女.","focus_words":["之女"]},{"speaker":"B","line_target":"之妻 は 何ですか。","line_vi":"之妻 là cái gì?","focus_words":["之妻"]},{"speaker":"A","line_target":"之罪です。","line_vi":"Đó là 之罪.","focus_words":["之罪"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d504261d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「之女」 có nghĩa là gì?","options":["con gái","vợ","tội lỗi","bản giao hưởng"],"answer_index":0,"explanation":"之女 = con gái"},{"question":"Từ 「之妻」 có nghĩa là gì?","options":["vợ","con gái","tội lỗi","bản giao hưởng"],"answer_index":0,"explanation":"之妻 = vợ"},{"question":"Từ 「之罪」 có nghĩa là gì?","options":["tội lỗi","con gái","vợ","bản giao hưởng"],"answer_index":0,"explanation":"之罪 = tội lỗi"},{"question":"Từ 「交响曲」 có nghĩa là gì?","options":["bản giao hưởng","con gái","vợ","tội lỗi"],"answer_index":0,"explanation":"交响曲 = bản giao hưởng"},{"question":"Từ 「人则」 có nghĩa là gì?","options":["Quy tắc của mọi người","con gái","vợ","tội lỗi"],"answer_index":0,"explanation":"人则 = Quy tắc của mọi người"},{"question":"Từ 「人民代表」 có nghĩa là gì?","options":["đại diện nhân dân","con gái","vợ","tội lỗi"],"answer_index":0,"explanation":"人民代表 = đại diện nhân dân"},{"question":"Từ 「亿万富翁」 có nghĩa là gì?","options":["tỷ phú","con gái","vợ","tội lỗi"],"answer_index":0,"explanation":"亿万富翁 = tỷ