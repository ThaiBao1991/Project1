m godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1732","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"联合国大会を 使います。","line_vi":"Tôi dùng 联合国大会.","focus_words":["联合国大会"]},{"speaker":"B","line_target":"育成 は 何ですか。","line_vi":"育成 là cái gì?","focus_words":["育成"]},{"speaker":"A","line_target":"脱口秀です。","line_vi":"Đó là 脱口秀.","focus_words":["脱口秀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_341212ec","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「联合国大会」 có nghĩa là gì?","options":["Đại hội đồng Liên hợp quốc","nuôi dưỡng","chương trình trò chuyện","người tự do"],"answer_index":0,"explanation":"联合国大会 = Đại hội đồng Liên hợp quốc"},{"question":"Từ 「育成」 có nghĩa là gì?","options":["nuôi dưỡng","Đại hội đồng Liên hợp quốc","chương trình trò chuyện","người tự do"],"answer_index":0,"explanation":"育成 = nuôi dưỡng"},{"question":"Từ 「脱口秀」 có nghĩa là gì?","options":["chương trình trò chuyện","Đại hội đồng Liên hợp quốc","nuôi dưỡng","người tự do"],"answer_index":0,"explanation":"脱口秀 = chương trình trò chuyện"},{"question":"Từ 「自由人」 có nghĩa là gì?","options":["người tự do","Đại hội đồng Liên hợp quốc","nuôi dưỡng","chương trình trò chuyện"],"answer_index":0,"explanation":"自由人 = người tự do"},{"question":"Từ 「自言自语」 có nghĩa là gì?","options":["Nói chuyện với chính mình","Đại hội đồng Liên hợp quốc","nuôi dưỡng","chương trình trò chuyện"],"answer_index":0,"explanatio