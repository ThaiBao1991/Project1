ng việc — Ngày 1281","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"丰盛を 使います。","line_vi":"Tôi dùng 丰盛.","focus_words":["丰盛"]},{"speaker":"B","line_target":"举人 は 何ですか。","line_vi":"举人 là cái gì?","focus_words":["举人"]},{"speaker":"A","line_target":"云端です。","line_vi":"Đó là 云端.","focus_words":["云端"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「丰盛」 có nghĩa là gì?","options":["giàu có","Juren","đám mây","năm mươi nghìn"],"answer_index":0,"explanation":"丰盛 = giàu có"},{"question":"Từ 「举人」 có nghĩa là gì?","options":["Juren","giàu có","đám mây","năm mươi nghìn"],"answer_index":0,"explanation":"举人 = Juren"},{"question":"Từ 「云端」 có nghĩa là gì?","options":["đám mây","giàu có","Juren","năm mươi nghìn"],"answer_index":0,"explanation":"云端 = đám mây"},{"question":"Từ 「五万」 có nghĩa là gì?","options":["năm mươi nghìn","giàu có","Juren","đám mây"],"answer_index":0,"explanation":"五万 = năm mươi nghìn"},{"question":"Từ 「五角大楼」 có nghĩa là gì?","options":["Lầu Năm Góc","giàu có","Juren","đám mây"],"answer_index":0,"explanation":"五角大楼 = Lầu Năm Góc"},{"question":"Từ 「人寿」 có nghĩa là gì?","options":["cuộc sống","giàu có","Juren","đám mây"],"answer_index":0,"explanation":"人寿 = cuộc sống"},{"question":"Từ 「仁川」 có nghĩa là gì?","options":["incheon","giàu có","Juren","đám mây"],"answer_index":0,"explanation":"仁川 = incheon"},{"question":"Từ 「从头」 có nghĩa là gì?","options":["từ đầu","giàu có","Juren","đám mây"],"answer_index":0,"explanation":"从头 = từ đầu"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: giàu có","options":["丰盛","举人","云端","五万"],"answer_index":0,"explanation":"丰盛 = giàu có"},{"question":"Chọn từ đúng cho nghĩa: Juren","options":["举人","丰盛","云端","五万"],"answer_index":0,"explanation":"举人 = Juren"}],"common":