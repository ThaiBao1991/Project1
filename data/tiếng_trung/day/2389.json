ng việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2389","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"之友を 使います。","line_vi":"Tôi dùng 之友.","focus_words":["之友"]},{"speaker":"B","line_target":"乘务员 は 何ですか。","line_vi":"乘务员 là cái gì?","focus_words":["乘务员"]},{"speaker":"A","line_target":"九百です。","line_vi":"Đó là 九百.","focus_words":["九百"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「之友」 có nghĩa là gì?","options":["bạn bè","tiếp viên hàng không","chín trăm","thói quen"],"answer_index":0,"explanation":"之友 = bạn bè"},{"question":"Từ 「乘务员」 có nghĩa là gì?","options":["tiếp viên hàng không","bạn bè","chín trăm","thói quen"],"answer_index":0,"explanation":"乘务员 = tiếp viên hàng không"},{"question":"Từ 「九百」 có nghĩa là gì?","options":["chín trăm","bạn bè","tiếp viên hàng không","thói quen"],"answer_index":0,"explanation":"九百 = chín trăm"},{"question":"Từ 「习惯性」 có nghĩa là gì?","options":["thói quen","bạn bè","tiếp viên hàng không","chín trăm"],"answer_index":0,"explanation":"习惯性 = thói quen"},{"question":"Từ 「书桌」 có nghĩa là gì?","options":["bàn","bạn bè","tiếp viên hàng không","chín trăm"],"answer_index":0,"explanation":"书桌 = bàn"},{"question":"Từ 「事业部」 có nghĩa là gì?","options":["Đơn vị kinh doanh","bạn bè","tiếp viên hàng không","chín trăm"],"answer_index":0,"explanation":"事业部 = Đơn vị kinh doanh"},{"question":"Từ 「二氧化硫」 có nghĩa là gì?","options":["lưu huỳnh đioxit","bạn bè","tiếp viên hàng không","chín trăm"],"answer_index":0,"explanation":"二氧化硫 = lưu huỳnh đioxit"},{"question":"Từ 「云彩」 có nghĩa là gì?","options":["đám mây","bạn bè","tiếp viên hàng không","chín trăm"],"answer_index":0,"explanation":"云彩 = đám mây"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bạn bè","options":["之友","乘务员","九百","习惯性"],"answer_index":0,"explanation":