e_ref":"m_f52ba1e6","audio_ref":"m_a0b82871","meaning_audio_ref":"m_be021011","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 817","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"容器を 使います。","line_vi":"Tôi dùng 容器.","focus_words":["容器"]},{"speaker":"B","line_target":"宽度 は 何ですか。","line_vi":"宽度 là cái gì?","focus_words":["宽度"]},{"speaker":"A","line_target":"小队です。","line_vi":"Đó là 小队.","focus_words":["小队"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_dc177786","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「容器」 có nghĩa là gì?","options":["thùng chứa","Chiều rộng","đội hình","Vẫn có"],"answer_index":0,"explanation":"容器 = thùng chứa"},{"question":"Từ 「宽度」 có nghĩa là gì?","options":["Chiều rộng","thùng chứa","đội hình","Vẫn có"],"answer_index":0,"explanation":"宽度 = Chiều rộng"},{"question":"Từ 「小队」 có nghĩa là gì?","options":["đội hình","thùng chứa","Chiều rộng","Vẫn có"],"answer_index":0,"explanation":"小队 = đội hình"},{"question":"Từ 「尚有」 có nghĩa là gì?","options":["Vẫn có","thùng chứa","Chiều rộng","đội hình"],"answer_index":0,"explanation":"尚有 = Vẫn có"},{"question":"Từ 「山谷」 có nghĩa là gì?","options":["thung lũng","thùng chứa","Chiều rộng","đội hình"],"answer_index":0,"explanation":"山谷 = thung lũng"},{"question":"Từ 「巨星」 có nghĩa là gì?","options":["siêu sao","thùng chứa","Chiều rộng","đội hình"],"answer_index":0,"explanation":"巨星 = siêu sao"},{"question":"Từ 「开庭」 có nghĩa là gì?","options":["phiên tòa","thùng chứa","Chiều rộng","đội hình"],"answer_index":0,"explanation":"开庭 = phiên tòa"},{"question":"Từ 「开火」 có nghĩa là gì?","options":["nổ súng","thùng chứa","Chiều rộng","đội hình"],"answer_index":