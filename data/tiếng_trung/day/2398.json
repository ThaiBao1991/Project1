on_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2398","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大宝を 使います。","line_vi":"Tôi dùng 大宝.","focus_words":["大宝"]},{"speaker":"B","line_target":"大寿 は 何ですか。","line_vi":"大寿 là cái gì?","focus_words":["大寿"]},{"speaker":"A","line_target":"大洞です。","line_vi":"Đó là 大洞.","focus_words":["大洞"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_006c0dbe","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大宝」 có nghĩa là gì?","options":["Đại bảo","sinh nhật","lỗ lớn","phần cuối cùng"],"answer_index":0,"explanation":"大宝 = Đại bảo"},{"question":"Từ 「大寿」 có nghĩa là gì?","options":["sinh nhật","Đại bảo","lỗ lớn","phần cuối cùng"],"answer_index":0,"explanation":"大寿 = sinh nhật"},{"question":"Từ 「大洞」 có nghĩa là gì?","options":["lỗ lớn","Đại bảo","sinh nhật","phần cuối cùng"],"answer_index":0,"explanation":"大洞 = lỗ lớn"},{"question":"Từ 「大结局」 có nghĩa là gì?","options":["phần cuối cùng","Đại bảo","sinh nhật","lỗ lớn"],"answer_index":0,"explanation":"大结局 = phần cuối cùng"},{"question":"Từ 「太保」 có nghĩa là gì?","options":["Thái Bảo","Đại bảo","sinh nhật","lỗ lớn"],"answer_index":0,"explanation":"太保 = Thái Bảo"},{"question":"Từ 「夹杂」 có nghĩa là gì?","options":["hỗn hợp","Đại bảo","sinh nhật","lỗ lớn"],"answer_index":0,"explanation":"夹杂 = hỗn hợp"},{"question":"Từ 「奥特曼」 có nghĩa là gì?","options":["siêu nhân","Đại bảo","sinh nhật","lỗ lớn"],"answer_index":0,"explanation":"奥特曼 = siêu nhân"},{"question":"Từ 「好学」 có nghĩa là gì?","options":["hiếu học","Đại bảo","sinh nhật","lỗ lớn"],"answer_index":0,"explanation":"好学 = hiếu học"}],"pattern":[{"question":