 được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2136","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"陕北を 使います。","line_vi":"Tôi dùng 陕北.","focus_words":["陕北"]},{"speaker":"B","line_target":"难民营 は 何ですか。","line_vi":"难民营 là cái gì?","focus_words":["难民营"]},{"speaker":"A","line_target":"韧带です。","line_vi":"Đó là 韧带.","focus_words":["韧带"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2c00074f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「陕北」 có nghĩa là gì?","options":["Bắc Thiểm Tây","trại tị nạn","dây chằng","chính phủ hàn quốc"],"answer_index":0,"explanation":"陕北 = Bắc Thiểm Tây"},{"question":"Từ 「难民营」 có nghĩa là gì?","options":["trại tị nạn","Bắc Thiểm Tây","dây chằng","chính phủ hàn quốc"],"answer_index":0,"explanation":"难民营 = trại tị nạn"},{"question":"Từ 「韧带」 có nghĩa là gì?","options":["dây chằng","Bắc Thiểm Tây","trại tị nạn","chính phủ hàn quốc"],"answer_index":0,"explanation":"韧带 = dây chằng"},{"question":"Từ 「韩国政府」 có nghĩa là gì?","options":["chính phủ hàn quốc","Bắc Thiểm Tây","trại tị nạn","dây chằng"],"answer_index":0,"explanation":"韩国政府 = chính phủ hàn quốc"},{"question":"Từ 「音色」 có nghĩa là gì?","options":["âm sắc","Bắc Thiểm Tây","trại tị nạn","dây chằng"],"answer_index":0,"explanation":"音色 = âm sắc"},{"question":"Từ 「预算案」 có nghĩa là gì?","options":["Ngân sách","Bắc Thiểm Tây","trại tị nạn","dây chằng"],"answe