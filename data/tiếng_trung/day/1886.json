ch này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1886","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"内河を 使います。","line_vi":"Tôi dùng 内河.","focus_words":["内河"]},{"speaker":"B","line_target":"军情 は 何ですか。","line_vi":"军情 là cái gì?","focus_words":["军情"]},{"speaker":"A","line_target":"决不会です。","line_vi":"Đó là 决不会.","focus_words":["决不会"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_30ce0a8c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「内河」 có nghĩa là gì?","options":["sông nội địa","tình báo quân sự","không bao giờ","chết cóng"],"answer_index":0,"explanation":"内河 = sông nội địa"},{"question":"Từ 「军情」 có nghĩa là gì?","options":["tình báo quân sự","sông nội địa","không bao giờ","chết cóng"],"answer_index":0,"explanation":"军情 = tình báo quân sự"},{"question":"Từ 「决不会」 có nghĩa là gì?","options":["không bao giờ","sông nội địa","tình báo quân sự","chết cóng"],"answer_index":0,"explanation":"决不会 = không bao giờ"},{"question":"Từ 「冻死」 có nghĩa là gì?","options":["chết cóng","sông nội địa","tình báo quân sự","không bao giờ"],"answer_index":0,"explanation":"冻死 = chết cóng"},{"question":"Từ 「凑合」 có nghĩa là gì?","options":["làm gì","sông nội địa","tình báo quân sự","không bao giờ"],"answer_index":0,"explanation":"凑合 = làm gì"},{"question":"Từ 「出人意料」 có nghĩa là gì?","options":["Bất ngờ","sông nội địa","tình báo quân sự","không bao giờ"],"answer_index":0,"explanation":"出人意料 = Bất ngờ"},{"question":"Từ 「出外」 có nghĩa là gì?","opt