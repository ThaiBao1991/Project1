行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2178","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"中意を 使います。","line_vi":"Tôi dùng 中意.","focus_words":["中意"]},{"speaker":"B","line_target":"为官 は 何ですか。","line_vi":"为官 là cái gì?","focus_words":["为官"]},{"speaker":"A","line_target":"主办方です。","line_vi":"Đó là 主办方.","focus_words":["主办方"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_271177a2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「中意」 có nghĩa là gì?","options":["hài lòng","với tư cách là một quan chức","Nhà tài trợ","Đưa ra bằng chứng"],"answer_index":0,"explanation":"中意 = hài lòng"},{"question":"Từ 「为官」 có nghĩa là gì?","options":["với tư cách là một quan chức","hài lòng","Nhà tài trợ","Đưa ra bằng chứng"],"answer_index":0,"explanation":"为官 = với tư cách là một quan chức"},{"question":"Từ 「主办方」 có nghĩa là gì?","options":["Nhà tài trợ","hài lòng","với tư cách là một quan chức","Đưa ra bằng chứng"],"answer_index":0,"explanation":"主办方 = Nhà tài trợ"},{"question":"Từ 「举证」 có nghĩa là gì?","options":["Đưa ra bằng chứng","hài lòng","với tư cách là một quan chức","Nhà tài trợ"],"answer_index":0,"explanation":"举证 = Đưa ra bằng chứng"},{"question":"Từ 「乐手」 có nghĩa là gì?","options":["nhạc sĩ","hài lòng","với tư cách là một quan chức","Nhà tài trợ"],"answer_index":0,"explanation":"乐手 = nhạc sĩ"}