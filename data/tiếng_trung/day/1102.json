ị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1102","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"机床を 使います。","line_vi":"Tôi dùng 机床.","focus_words":["机床"]},{"speaker":"B","line_target":"权势 は 何ですか。","line_vi":"权势 là cái gì?","focus_words":["权势"]},{"speaker":"A","line_target":"极具です。","line_vi":"Đó là 极具.","focus_words":["极具"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cddf4619","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「机床」 có nghĩa là gì?","options":["Máy công cụ","quyền lực","Cực kỳ","quản lý trường học"],"answer_index":0,"explanation":"机床 = Máy công cụ"},{"question":"Từ 「权势」 có nghĩa là gì?","options":["quyền lực","Máy công cụ","Cực kỳ","quản lý trường học"],"answer_index":0,"explanation":"权势 = quyền lực"},{"question":"Từ 「极具」 có nghĩa là gì?","options":["Cực kỳ","Máy công cụ","quyền lực","quản lý trường học"],"answer_index":0,"explanation":"极具 = Cực kỳ"},{"question":"Từ 「校方」 có nghĩa là gì?","options":["quản lý trường học","Máy công cụ","quyền lực","Cực kỳ"],"answer_index":0,"explanation":"校方 = quản lý trường học"},{"question":"Từ 「梦境」 có nghĩa là gì?","options":["giấc mơ","Máy công cụ","quyền lực","Cực kỳ"],"answer_index":0,"explanation":"梦境 = giấc mơ"},{"question":"Từ 「棕色」 có nghĩa là gì?","options":["nâu","Máy công cụ","quyền lực","Cực kỳ"],"answer_index":0,"explanation":"棕色 = nâu"},{"question":"Từ 「棘手」 có nghĩa là gì?","options":["khó khăn","Máy công cụ","quyền l