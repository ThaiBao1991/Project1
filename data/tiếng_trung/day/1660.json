ng."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1660","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吊销を 使います。","line_vi":"Tôi dùng 吊销.","focus_words":["吊销"]},{"speaker":"B","line_target":"同桌 は 何ですか。","line_vi":"同桌 là cái gì?","focus_words":["同桌"]},{"speaker":"A","line_target":"名古屋です。","line_vi":"Đó là 名古屋.","focus_words":["名古屋"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_44f54ade","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吊销」 có nghĩa là gì?","options":["Thu hồi","bạn cùng bàn","Nagoya","sức mạnh bền bỉ"],"answer_index":0,"explanation":"吊销 = Thu hồi"},{"question":"Từ 「同桌」 có nghĩa là gì?","options":["bạn cùng bàn","Thu hồi","Nagoya","sức mạnh bền bỉ"],"answer_index":0,"explanation":"同桌 = bạn cùng bàn"},{"question":"Từ 「名古屋」 có nghĩa là gì?","options":["Nagoya","Thu hồi","bạn cùng bàn","sức mạnh bền bỉ"],"answer_index":0,"explanation":"名古屋 = Nagoya"},{"question":"Từ 「后劲」 có nghĩa là gì?","options":["sức mạnh bền bỉ","Thu hồi","bạn cùng bàn","Nagoya"],"answer_index":0,"explanation":"后劲 = sức mạnh bền bỉ"},{"question":"Từ 「吸血」 có nghĩa là gì?","options":["Ma cà rồng","Thu hồi","bạn cùng bàn","Nagoya"],"answer_index":0,"explanation":"吸血 = Ma cà rồng"},{"question":"Từ 「味儿」 có nghĩa là gì?","options":["Hương vị","Thu hồi","bạn cùng bàn","Nagoya"],"answer_index":0,"explanation":"味儿 = Hương vị"},{"question":"Từ 「商业化」 có nghĩa là gì?","options":["thương mại hóa","Thu hồi","bạn cùng bàn","Nagoya"],"answer_index":0,"explanation":"商业化 = thương mại