ables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f8bf46e8","audio_ref":"m_61427069","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_31a98fc1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1902","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"照常を 使います。","line_vi":"Tôi dùng 照常.","focus_words":["照常"]},{"speaker":"B","line_target":"熄灯 は 何ですか。","line_vi":"熄灯 là cái gì?","focus_words":["熄灯"]},{"speaker":"A","line_target":"爪哇です。","line_vi":"Đó là 爪哇.","focus_words":["爪哇"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8dc042d5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「照常」 có nghĩa là gì?","options":["như thường lệ","đèn tắt","Java","khu vực"],"answer_index":0,"explanation":"照常 = như thường lệ"},{"question":"Từ 「熄灯」 có nghĩa là gì?","options":["đèn tắt","như thường lệ","Java","khu vực"],"answer_index":0,"explanation":"熄灯 = đèn tắt"},{"question":"Từ 「爪哇」 có nghĩa là gì?","options":["Java","như thường lệ","đèn tắt","khu vực"],"answer_index":0,"explanation":"爪哇 = Java"},{"question":"Từ 「片区」 có nghĩa là gì?","options":["khu vực","như thường lệ","đèn tắt","Java"],"answer_index":0,"explanation":"片区 = khu vực"},{"question":"Từ 「狗屎」 có nghĩa là gì?","options":["chết tiệt","như thường lệ","đèn tắt","Java"],"answer_index":0,"explanation":"狗屎 = chết tiệt"},{"question":"Từ 「独居」 có nghĩa là gì?","options":["Sống một mình","như thường lệ","đèn tắt","Java"],"answer_index":0,"explanation":"独居 = Sống một mình"},{"question":"Từ 「猛然」 có nghĩa là gì?","options":["đột nhiên","như thường lệ","đèn tắt","Java"],"answer_index":0,"explanation":"猛然 = đột nhiên"},{"question":"Từ 「猥琐」 có nghĩa là gì?","options