i."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1391","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"酿成を 使います。","line_vi":"Tôi dùng 酿成.","focus_words":["酿成"]},{"speaker":"B","line_target":"里约热内卢 は 何ですか。","line_vi":"里约热内卢 là cái gì?","focus_words":["里约热内卢"]},{"speaker":"A","line_target":"银子です。","line_vi":"Đó là 银子.","focus_words":["银子"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_300b9ff6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「酿成」 có nghĩa là gì?","options":["trở thành","Rio de Janeiro","bạc","màn hình"],"answer_index":0,"explanation":"酿成 = trở thành"},{"question":"Từ 「里约热内卢」 có nghĩa là gì?","options":["Rio de Janeiro","trở thành","bạc","màn hình"],"answer_index":0,"explanation":"里约热内卢 = Rio de Janeiro"},{"question":"Từ 「银子」 có nghĩa là gì?","options":["bạc","trở thành","Rio de Janeiro","màn hình"],"answer_index":0,"explanation":"银子 = bạc"},{"question":"Từ 「银幕」 có nghĩa là gì?","options":["màn hình","trở thành","Rio de Janeiro","bạc"],"answer_index":0,"explanation":"银幕 = màn hình"},{"question":"Từ 「霸王」 có nghĩa là gì?","options":["chúa tể","trở thành","Rio de Janeiro","bạc"],"answer_index":0,"explanation":"霸王 = chúa tể"},{"question":"Từ 「韦伯」 có nghĩa là gì?","options":["Weber","trở thành","Rio de Janeiro","bạc"],"answer_index":0,"explanation":"韦伯 = Weber"},{"question":"Từ 「音节」 có nghĩa là gì?","options":["âm tiết","trở thành","Rio de Janeiro","bạc"],"answer_index":0,"explanation":"音节 = âm tiết"},{"questio