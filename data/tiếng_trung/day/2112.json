ence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2112","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"喷气を 使います。","line_vi":"Tôi dùng 喷气.","focus_words":["喷气"]},{"speaker":"B","line_target":"回味 は 何ですか。","line_vi":"回味 là cái gì?","focus_words":["回味"]},{"speaker":"A","line_target":"国史です。","line_vi":"Đó là 国史.","focus_words":["国史"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c2deccba","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「喷气」 có nghĩa là gì?","options":["Máy bay phản lực","dư vị","lịch sử dân tộc","cải cách ruộng đất"],"answer_index":0,"explanation":"喷气 = Máy bay phản lực"},{"question":"Từ 「回味」 có nghĩa là gì?","options":["dư vị","Máy bay phản lực","lịch sử dân tộc","cải cách ruộng đất"],"answer_index":0,"explanation":"回味 = dư vị"},{"question":"Từ 「国史」 có nghĩa là gì?","options":["lịch sử dân tộc","Máy bay phản lực","dư vị","cải cách ruộng đất"],"answer_index":0,"explanation":"国史 = lịch sử dân tộc"},{"question":"Từ 「土地改革」 có nghĩa là gì?","options":["cải cách ruộng đất","Máy bay phản lực","dư vị","lịch sử dân tộc"],"answer_index":0,"explanation":"土地改革 = cải cách ruộng đất"},{"question":"Từ 「地级市」 có nghĩa là gì?","options":["thành phố cấp tỉnh","Máy bay phản lực","dư vị","lịch sử dân tộc"],"answer_index":0,"explanation":"地级市 = thành phố cấp tỉnh"},{"question":"Từ 「地里」 có nghĩa là gì?","options":["lĩnh vực","Máy bay phản lực","dư vị","lịch sử dân tộc"],"answer_index":0,"explanation":"地里 = lĩnh vực"},{"question":"Từ 「壮士」 có nghĩa là gì?","optio