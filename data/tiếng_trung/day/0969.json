ning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 969","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"合伙人を 使います。","line_vi":"Tôi dùng 合伙人.","focus_words":["合伙人"]},{"speaker":"B","line_target":"向下 は 何ですか。","line_vi":"向下 là cái gì?","focus_words":["向下"]},{"speaker":"A","line_target":"吸取です。","line_vi":"Đó là 吸取.","focus_words":["吸取"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b1c36341","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「合伙人」 có nghĩa là gì?","options":["Đối tác","xuống","hấp thụ","Harry"],"answer_index":0,"explanation":"合伙人 = Đối tác"},{"question":"Từ 「向下」 có nghĩa là gì?","options":["xuống","Đối tác","hấp thụ","Harry"],"answer_index":0,"explanation":"向下 = xuống"},{"question":"Từ 「吸取」 có nghĩa là gì?","options":["hấp thụ","Đối tác","xuống","Harry"],"answer_index":0,"explanation":"吸取 = hấp thụ"},{"question":"Từ 「哈里」 có nghĩa là gì?","options":["Harry","Đối tác","xuống","hấp thụ"],"answer_index":0,"explanation":"哈里 = Harry"},{"question":"Từ 「商用」 có nghĩa là gì?","options":["thương mại","Đối tác","xuống","hấp thụ"],"answer_index":0,"explanation":"商用 = thương mại"},{"question":"Từ 「喇嘛」 có nghĩa là gì?","options":["Lạt ma","Đối tác","xuống","hấp thụ"],"answer_index":0,"explanation":"喇嘛 = Lạt ma"},{"question":"Từ 「四人帮」 có nghĩa là gì?","options":["Nhóm Bốn Người","Đối tác","xuống","hấp thụ"],"answer_index":0,"explanation":"四人帮 = Nhóm Bốn Người"},{"question":"Từ 「国会议员」 có nghĩa là gì?","options":["thành viên quốc hội","Đối tác","xuống","hấp thụ"],"answer_index":0,"explanat