e_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d8c234a2","audio_ref":"m_39e53161","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_42ef81af"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]},{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2311","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"脱口而出を 使います。","line_vi":"Tôi dùng 脱口而出.","focus_words":["脱口而出"]},{"speaker":"B","line_target":"腔调 は 何ですか。","line_vi":"腔调 là cái gì?","focus_words":["腔调"]},{"speaker":"A","line_target":"腾出です。","line_vi":"Đó là 腾出.","focus_words":["腾出"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1985b1b9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「脱口而出」 có nghĩa là gì?","options":["thốt lên","giai điệu","giải phóng","sử dụng cá nhân"],"answer_index":0,"explanation":"脱口而出 = thốt lên"},{"question":"Từ 「腔调」 có nghĩa là gì?","options":["giai điệu","thốt lên","giải phóng","sử dụng cá nhân"],"answer_index":0,"explanation":"腔调 = giai điệu"},{"question":"Từ 「腾出」 có nghĩa là gì?","options":["giải phóng","thốt lên","giai điệu","sử dụng cá nhân"],"answer_index":0,"explanation":"腾出 = giải phóng"},{"question":"Từ 「自用」 có nghĩa là gì?","options":["sử dụng cá nhân","thốt lên","giai điệu","giải phóng"],"answer_index":0,"explanation":"自用 = sử dụng cá nhân"},{"question":"Từ 「臭味」 có nghĩa là gì?","options":["hôi thối","thốt lên","giai điệu","giải phóng"],"answer_index":0,"explanation":"臭味 = hôi thối"},{"question":"Từ 「致以」 có nghĩa là gì?","options":["Trân trọng","thốt lên","giai điệu","giải phóng"],"answer_index":0,"explanation":"致以 = Trân trọng"},{"question":"Từ 「舞台剧」 có nghĩa là gì