us":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1691","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"善后を 使います。","line_vi":"Tôi dùng 善后.","focus_words":["善后"]},{"speaker":"B","line_target":"嗅觉 は 何ですか。","line_vi":"嗅觉 là cái gì?","focus_words":["嗅觉"]},{"speaker":"A","line_target":"嘴角です。","line_vi":"Đó là 嘴角.","focus_words":["嘴角"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_091c338a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「善后」 có nghĩa là gì?","options":["hậu quả","khứu giác","khóe miệng","vì nghi ngờ"],"answer_index":0,"explanation":"善后 = hậu quả"},{"question":"Từ 「嗅觉」 có nghĩa là gì?","options":["khứu giác","hậu quả","khóe miệng","vì nghi ngờ"],"answer_index":0,"explanation":"嗅觉 = khứu giác"},{"question":"Từ 「嘴角」 có nghĩa là gì?","options":["khóe miệng","hậu quả","khứu giác","vì nghi ngờ"],"answer_index":0,"explanation":"嘴角 = khóe miệng"},{"question":"Từ 「因涉嫌」 có nghĩa là gì?","options":["vì nghi ngờ","hậu quả","khứu giác","khóe miệng"],"answer_index":0,"explanation":"因涉嫌 = vì nghi ngờ"},{"question":"Từ 「国家统计局」 có nghĩa là gì?","options":["Cục Thống kê Quốc gia","hậu quả","khứu giác","khóe miệng"],"answer_index":0,"explanation":"国家统计局 = Cục Thống kê Quốc gia"},{"question":"Từ 「土豪」 có nghĩa là gì?","options":["Người đàn ông giàu có","hậu quả","khứu giác","khóe miệng"],"answer_index":0,"explanation":"土豪 = Người đàn ông giàu có"},{"question":"Từ 「圣火」 có nghĩa là gì?","options":["lửa thánh","hậu quả","khứu giác","khóe miệng"],"answer_index":0,"explanation":"圣火 = lửa thánh"},{"question"