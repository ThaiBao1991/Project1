, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1328","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"低收入を 使います。","line_vi":"Tôi dùng 低收入.","focus_words":["低收入"]},{"speaker":"B","line_target":"体温 は 何ですか。","line_vi":"体温 là cái gì?","focus_words":["体温"]},{"speaker":"A","line_target":"倾倒です。","line_vi":"Đó là 倾倒.","focus_words":["倾倒"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_40998acf","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「低收入」 có nghĩa là gì?","options":["thu nhập thấp","nhiệt độ cơ thể","đổ","chất xúc tác"],"answer_index":0,"explanation":"低收入 = thu nhập thấp"},{"question":"Từ 「体温」 có nghĩa là gì?","options":["nhiệt độ cơ thể","thu nhập thấp","đổ","chất xúc tác"],"answer_index":0,"explanation":"体温 = nhiệt độ cơ thể"},{"question":"Từ 「倾倒」 có nghĩa là gì?","options":["đổ","thu nhập thấp","nhiệt độ cơ thể","chất xúc tác"],"answer_index":0,"explanation":"倾倒 = đổ"},{"question":"Từ 「催化剂」 có nghĩa là gì?","options":["chất xúc tác","thu nhập thấp","nhiệt độ cơ thể","đổ"],"answer_index":0,"explanation":"催化剂 = chất xúc tác"},{"question":"Từ 「光临」 có nghĩa là gì?","options":["chuyến thăm","thu nhập thấp","nhiệt độ cơ thể","đổ"],"answer_index":0,"explanation":"光临 = chuyến thăm"},{"question":"Từ 「克隆」 có nghĩa là gì?","options":["nhân bản","thu nhập thấp","nhiệt độ cơ thể","đổ"],"answer_index":0,"explanation":"克隆 = nhân bản"},{"question":"Từ 「入伍」 có nghĩa là gì?","options":["Nhập ngũ","thu nhập thấp","nhiệt độ cơ thể","đổ"],"answer_index":0,"explanation":"入伍 = Nhập ngũ"},{"question":"Từ 「公使」 có nghĩa là gì?","options":["Bộ trưởng","t