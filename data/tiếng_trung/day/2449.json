_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_8999d673","audio_ref":"m_3a2ae146","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_db1a7915"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2449","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"轻轨を 使います。","line_vi":"Tôi dùng 轻轨.","focus_words":["轻轨"]},{"speaker":"B","line_target":"进阶 は 何ですか。","line_vi":"进阶 là cái gì?","focus_words":["进阶"]},{"speaker":"A","line_target":"送交です。","line_vi":"Đó là 送交.","focus_words":["送交"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5dab8f8b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「轻轨」 có nghĩa là gì?","options":["đường sắt nhẹ","Nâng cao","giao hàng","Lựa chọn"],"answer_index":0,"explanation":"轻轨 = đường sắt nhẹ"},{"question":"Từ 「进阶」 có nghĩa là gì?","options":["Nâng cao","đường sắt nhẹ","giao hàng","Lựa chọn"],"answer_index":0,"explanation":"进阶 = Nâng cao"},{"question":"Từ 「送交」 có nghĩa là gì?","options":["giao hàng","đường sắt nhẹ","Nâng cao","Lựa chọn"],"answer_index":0,"explanation":"送交 = giao hàng"},{"question":"Từ 「选情」 có nghĩa là gì?","options":["Lựa chọn","đường sắt nhẹ","Nâng cao","giao hàng"],"answer_index":0,"explanation":"选情 = Lựa chọn"},{"question":"Từ 「逮到」 có nghĩa là gì?","options":["bắt được","đường sắt nhẹ","Nâng cao","giao hàng"],"answer_index":0,"explanation":"逮到 = bắt được"},{"question":"Từ 「那名」 có nghĩa là gì?","options":["tên đó","đường sắt nhẹ","Nâng cao","giao hàng"],"answer_index":0,"explanation":"那名 = tên đó"},{"question":"Từ 「重装」 có nghĩa là gì?","options":["Cài đặt lại","đường sắt nhẹ","Nâng cao","giao hàng"],"answer_index":0,"explanation":"重装 = Cài đặt lại"},{"question":"T