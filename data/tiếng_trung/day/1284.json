llables":[],"image_ref":"m_0632d74d","audio_ref":"m_39ae1f5e","meaning_audio_ref":"m_87ff0e13","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]},{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1284","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"同心を 使います。","line_vi":"Tôi dùng 同心.","focus_words":["同心"]},{"speaker":"B","line_target":"向导 は 何ですか。","line_vi":"向导 là cái gì?","focus_words":["向导"]},{"speaker":"A","line_target":"呈现出です。","line_vi":"Đó là 呈现出.","focus_words":["呈现出"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ef6eafaf","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「同心」 có nghĩa là gì?","options":["đồng tâm","thuật sĩ","hiển thị","nhân vật"],"answer_index":0,"explanation":"同心 = đồng tâm"},{"question":"Từ 「向导」 có nghĩa là gì?","options":["thuật sĩ","đồng tâm","hiển thị","nhân vật"],"answer_index":0,"explanation":"向导 = thuật sĩ"},{"question":"Từ 「呈现出」 có nghĩa là gì?","options":["hiển thị","đồng tâm","thuật sĩ","nhân vật"],"answer_index":0,"explanation":"呈现出 = hiển thị"},{"question":"Từ 「品格」 có nghĩa là gì?","options":["nhân vật","đồng tâm","thuật sĩ","hiển thị"],"answer_index":0,"explanation":"品格 = nhân vật"},{"question":"Từ 「器件」 có nghĩa là gì?","options":["thiết bị","đồng tâm","thuật sĩ","hiển thị"],"answer_index":0,"explanation":"器件 = thiết bị"},{"question":"Từ 「在手」 có nghĩa là gì?","options":["trong tay","đồng tâm","thuật sĩ","hiển thị"],"answer_index":0,"explanation":"在手 = trong tay"},{"question":"Từ 「地段」 có nghĩa là gì?","options":["vị trí","đồng tâm","thuật sĩ","