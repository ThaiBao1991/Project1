y báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 465","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"宏观を 使います。","line_vi":"Tôi dùng 宏观.","focus_words":["宏观"]},{"speaker":"B","line_target":"客运 は 何ですか。","line_vi":"客运 là cái gì?","focus_words":["客运"]},{"speaker":"A","line_target":"寻常です。","line_vi":"Đó là 寻常.","focus_words":["寻常"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8eaa78ea","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「宏观」 có nghĩa là gì?","options":["Vĩ mô","Vận tải hành khách","chung","nhỏ bé"],"answer_index":0,"explanation":"宏观 = Vĩ mô"},{"question":"Từ 「客运」 có nghĩa là gì?","options":["Vận tải hành khách","Vĩ mô","chung","nhỏ bé"],"answer_index":0,"explanation":"客运 = Vận tải hành khách"},{"question":"Từ 「寻常」 có nghĩa là gì?","options":["chung","Vĩ mô","Vận tải hành khách","nhỏ bé"],"answer_index":0,"explanation":"寻常 = chung"},{"question":"Từ 「小小的」 có nghĩa là gì?","options":["nhỏ bé","Vĩ mô","Vận tải hành khách","chung"],"answer_index":0,"explanation":"小小的 = nhỏ bé"},{"question":"Từ 「就此」 có nghĩa là gì?","options":["Thế thôi","Vĩ mô","Vận tải hành khách","chung"],"answer_index":0,"explanation":"就此 = Thế thôi"},{"question":"Từ 「布置」 có nghĩa là gì?","options":["bố cục","Vĩ mô","Vận tải hành khách","chung"],"answer_index":0,"explanation":"布置 = bố cục"},{"question":"Từ 「师父」 có nghĩa là gì?","options":["bậc thầy","Vĩ mô","Vận tải hành khách","chung"],"answer_index":0,"explanation":"师父 = bậc thầy"},{"q