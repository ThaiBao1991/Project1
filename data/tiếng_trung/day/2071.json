":"Tôi dùng 上船.","focus_words":["上船"]},{"speaker":"B","line_target":"不道德 は 何ですか。","line_vi":"不道德 là cái gì?","focus_words":["不道德"]},{"speaker":"A","line_target":"专柜です。","line_vi":"Đó là 专柜.","focus_words":["专柜"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「上船」 có nghĩa là gì?","options":["Lên tàu","vô đạo đức","quầy tính tiền","Đông Đông"],"answer_index":0,"explanation":"上船 = Lên tàu"},{"question":"Từ 「不道德」 có nghĩa là gì?","options":["vô đạo đức","Lên tàu","quầy tính tiền","Đông Đông"],"answer_index":0,"explanation":"不道德 = vô đạo đức"},{"question":"Từ 「专柜」 có nghĩa là gì?","options":["quầy tính tiền","Lên tàu","vô đạo đức","Đông Đông"],"answer_index":0,"explanation":"专柜 = quầy tính tiền"},{"question":"Từ 「东东」 có nghĩa là gì?","options":["Đông Đông","Lên tàu","vô đạo đức","quầy tính tiền"],"answer_index":0,"explanation":"东东 = Đông Đông"},{"question":"Từ 「东征」 có nghĩa là gì?","options":["Viễn Đông","Lên tàu","vô đạo đức","quầy tính tiền"],"answer_index":0,"explanation":"东征 = Viễn Đông"},{"question":"Từ 「东芝」 có nghĩa là gì?","options":["Toshiba","Lên tàu","vô đạo đức","quầy tính tiền"],"answer_index":0,"explanation":"东芝 = Toshiba"},{"question":"Từ 「中国籍」 có nghĩa là gì?","options":["quốc tịch Trung Quốc","Lên tàu","vô đạo đức","quầy tính tiền"],"answer_index":0,"explanation":"中国籍 = quốc tịch Trung Quốc"},{"question":"Từ 「中肯」 có nghĩa là gì?","options":["thích hợp","Lên tàu","vô đạo đức","quầy tính tiền"],"answer_index":0,"explanation":"中肯 = thích hợp"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Lên tàu","options":["上船","不道德","专柜","东东"],"answer_index":0,"explanation":"上船 = Lên tàu"},{"question":"Chọn từ đúng cho nghĩa: vô đạo đức","options":["不道德","上船","专柜","东东"],"answer_index":0,"explanation":"不道德 = vô đạo đức"}],"common":[],"grammar":[],"mixed":[]}