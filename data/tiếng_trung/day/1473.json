ệc cùng nhau","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d672a81b","audio_ref":"m_74357e82","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_9e3ee456"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]},{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1473","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"仿效を 使います。","line_vi":"Tôi dùng 仿效.","focus_words":["仿效"]},{"speaker":"B","line_target":"佛教徒 は 何ですか。","line_vi":"佛教徒 là cái gì?","focus_words":["佛教徒"]},{"speaker":"A","line_target":"便利店です。","line_vi":"Đó là 便利店.","focus_words":["便利店"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0687f67e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「仿效」 có nghĩa là gì?","options":["bắt chước","Phật giáo","cửa hàng tiện lợi","giả thuyết"],"answer_index":0,"explanation":"仿效 = bắt chước"},{"question":"Từ 「佛教徒」 có nghĩa là gì?","options":["Phật giáo","bắt chước","cửa hàng tiện lợi","giả thuyết"],"answer_index":0,"explanation":"佛教徒 = Phật giáo"},{"question":"Từ 「便利店」 có nghĩa là gì?","options":["cửa hàng tiện lợi","bắt chước","Phật giáo","giả thuyết"],"answer_index":0,"explanation":"便利店 = cửa hàng tiện lợi"},{"question":"Từ 「假说」 có nghĩa là gì?","options":["giả thuyết","bắt chước","Phật giáo","cửa hàng tiện lợi"],"answer_index":0,"explanation":"假说 = giả thuyết"},{"question":"Từ 「停播」 có nghĩa là gì?","options":["Dừng phát sóng","bắt chước","Phật giáo","cửa hàng tiện lợi"],"answer_index":0,"explanation":"停播 = Dừng phát sóng"},{"question":"Từ 「全校」 có nghĩa là gì?","options":["toàn trường","bắt chước","Phật giáo","cửa hàng tiện lợi"],"answer_index":0,"explanation":"全校 = toàn trường"},{"questi