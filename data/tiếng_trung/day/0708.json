ote":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_eea6f295","audio_ref":"m_1b6f556b","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_44df320d"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 708","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"战事を 使います。","line_vi":"Tôi dùng 战事.","focus_words":["战事"]},{"speaker":"B","line_target":"战斗力 は 何ですか。","line_vi":"战斗力 là cái gì?","focus_words":["战斗力"]},{"speaker":"A","line_target":"抽象です。","line_vi":"Đó là 抽象.","focus_words":["抽象"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_72251892","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「战事」 có nghĩa là gì?","options":["chiến tranh","hiệu quả chiến đấu","trừu tượng","giải trí"],"answer_index":0,"explanation":"战事 = chiến tranh"},{"question":"Từ 「战斗力」 có nghĩa là gì?","options":["hiệu quả chiến đấu","chiến tranh","trừu tượng","giải trí"],"answer_index":0,"explanation":"战斗力 = hiệu quả chiến đấu"},{"question":"Từ 「抽象」 có nghĩa là gì?","options":["trừu tượng","chiến tranh","hiệu quả chiến đấu","giải trí"],"answer_index":0,"explanation":"抽象 = trừu tượng"},{"question":"Từ 「招待」 có nghĩa là gì?","options":["giải trí","chiến tranh","hiệu quả chiến đấu","trừu tượng"],"answer_index":0,"explanation":"招待 = giải trí"},{"question":"Từ 「挑衅」 có nghĩa là gì?","options":["sự khiêu khích","chiến tranh","hiệu quả chiến đấu","trừu tượng"],"answer_index":0,"explanation":"挑衅 = sự khiêu khích"},{"question":"Từ 「接吻」 có nghĩa là gì?","options":["hôn","chiến tranh","hiệu quả chiến đấu","trừu tượng"],"answer_index":0,"explanation":"接吻 = hôn"},{"question":"Từ 「敌对