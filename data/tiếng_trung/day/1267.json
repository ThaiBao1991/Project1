:"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1267","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"控制器を 使います。","line_vi":"Tôi dùng 控制器.","focus_words":["控制器"]},{"speaker":"B","line_target":"搞清楚 は 何ですか。","line_vi":"搞清楚 là cái gì?","focus_words":["搞清楚"]},{"speaker":"A","line_target":"摆放です。","line_vi":"Đó là 摆放.","focus_words":["摆放"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4fc797d2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「控制器」 có nghĩa là gì?","options":["bộ điều khiển","tìm ra nó","địa điểm","kết thúc"],"answer_index":0,"explanation":"控制器 = bộ điều khiển"},{"question":"Từ 「搞清楚」 có nghĩa là gì?","options":["tìm ra nó","bộ điều khiển","địa điểm","kết thúc"],"answer_index":0,"explanation":"搞清楚 = tìm ra nó"},{"question":"Từ 「摆放」 có nghĩa là gì?","options":["địa điểm","bộ điều khiển","tìm ra nó","kết thúc"],"answer_index":0,"explanation":"摆放 = địa điểm"},{"question":"Từ 「收场」 có nghĩa là gì?","options":["kết thúc","bộ điều khiển","tìm ra nó","địa điểm"],"answer_index":0,"explanation":"收场 = kết thúc"},{"question":"Từ 「散播」 có nghĩa là gì?","options":["lây lan","bộ điều khiển","tìm ra nó","địa điểm"],"answer_index":0,"explanation":"散播 = lây lan"},{"question":"Từ 「旅行者」 có nghĩa là gì?","options":["du khách","bộ điều khiển","tìm ra nó","địa điểm"],"answer_ind