ation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大革命を 使います。","line_vi":"Tôi dùng 大革命.","focus_words":["大革命"]},{"speaker":"B","line_target":"天国 は 何ですか。","line_vi":"天国 là cái gì?","focus_words":["天国"]},{"speaker":"A","line_target":"失眠です。","line_vi":"Đó là 失眠.","focus_words":["失眠"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大革命」 có nghĩa là gì?","options":["cuộc cách mạng vĩ đại","thiên đường","mất ngủ","giếng"],"answer_index":0,"explanation":"大革命 = cuộc cách mạng vĩ đại"},{"question":"Từ 「天国」 có nghĩa là gì?","options":["thiên đường","cuộc cách mạng vĩ đại","mất ngủ","giếng"],"answer_index":0,"explanation":"天国 = thiên đường"},{"question":"Từ 「失眠」 có nghĩa là gì?","options":["mất ngủ","cuộc cách mạng vĩ đại","thiên đường","giếng"],"answer_index":0,"explanation":"失眠 = mất ngủ"},{"question":"Từ 「威尔斯」 có nghĩa là gì?","options":["giếng","cuộc cách mạng vĩ đại","thiên đường","mất ngủ"],"answer_index":0,"explanation":"威尔斯 = giếng"},{"question":"Từ 「字符」 có nghĩa là gì?","options":["nhân vật","cuộc cách mạng vĩ đại","thiên đường","mất ngủ"],"answer_index":0,"explanation":"字符 = nhân vật"},{"question":"Từ 「安全感」 có nghĩa là gì?","options":["cảm giác an toàn","cuộc cách mạng vĩ đại","thiên đường","mất ngủ"],"answer_index":0,"explanation":"安全感 = cảm giác an toàn"},{"question":"Từ 「实事」 có nghĩa là gì?","options":["Sự thật","cuộc cách mạng vĩ đại","thiên đường","mất ngủ"],"answer_index":0,"explanation":"实事 = Sự thật"},{"question":"Từ 「宣读」 có nghĩa là gì?","options":["Đọc to","cuộc cách mạng vĩ đại","thiên đường","mất ngủ"],"answer_index":0,"explanation":"宣读 = Đọc to"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: cuộc cách mạng vĩ đại","options":["大革命","天国","失眠","威尔斯"],"answer_index":0,"explanation":"大革命 = cu