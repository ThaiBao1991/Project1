":"N5","turns":[{"speaker":"A","line_target":"上报を 使います。","line_vi":"Tôi dùng 上报.","focus_words":["上报"]},{"speaker":"B","line_target":"上方 は 何ですか。","line_vi":"上方 là cái gì?","focus_words":["上方"]},{"speaker":"A","line_target":"不合理です。","line_vi":"Đó là 不合理.","focus_words":["不合理"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「上报」 có nghĩa là gì?","options":["Báo cáo","ở trên","Không hợp lý","Không được dung thứ"],"answer_index":0,"explanation":"上报 = Báo cáo"},{"question":"Từ 「上方」 có nghĩa là gì?","options":["ở trên","Báo cáo","Không hợp lý","Không được dung thứ"],"answer_index":0,"explanation":"上方 = ở trên"},{"question":"Từ 「不合理」 có nghĩa là gì?","options":["Không hợp lý","Báo cáo","ở trên","Không được dung thứ"],"answer_index":0,"explanation":"不合理 = Không hợp lý"},{"question":"Từ 「不容」 có nghĩa là gì?","options":["Không được dung thứ","Báo cáo","ở trên","Không hợp lý"],"answer_index":0,"explanation":"不容 = Không được dung thứ"},{"question":"Từ 「中央电视台」 có nghĩa là gì?","options":["camera quan sát","Báo cáo","ở trên","Không hợp lý"],"answer_index":0,"explanation":"中央电视台 = camera quan sát"},{"question":"Từ 「之意」 có nghĩa là gì?","options":["ý nghĩa","Báo cáo","ở trên","Không hợp lý"],"answer_index":0,"explanation":"之意 = ý nghĩa"},{"question":"Từ 「乐意」 có nghĩa là gì?","options":["sẵn sàng","Báo cáo","ở trên","Không hợp lý"],"answer_index":0,"explanation":"乐意 = sẵn sàng"},{"question":"Từ 「亦可」 có nghĩa là gì?","options":["Cũng có thể","Báo cáo","ở trên","Không hợp lý"],"answer_index":0,"explanation":"亦可 = Cũng có thể"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Báo cáo","options":["上报","上方","不合理","不容"],"answer_index":0,"explanation":"上报 = Báo cáo"},{"question":"Chọn từ đúng cho nghĩa: ở trên","options":["上方","上报","不合理","不容"],"answer_index":0,"explanation":"上方 