ứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2386","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"joinを 使います。","line_vi":"Tôi dùng join.","focus_words":["join"]},{"speaker":"B","line_target":"main は 何ですか。","line_vi":"main là cái gì?","focus_words":["main"]},{"speaker":"A","line_target":"mateです。","line_vi":"Đó là mate.","focus_words":["mate"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0ad8e333","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「join」 có nghĩa là gì?","options":["tham gia","chính","bạn đời","ml"],"answer_index":0,"explanation":"join = tham gia"},{"question":"Từ 「main」 có nghĩa là gì?","options":["chính","tham gia","bạn đời","ml"],"answer_index":0,"explanation":"main = chính"},{"question":"Từ 「mate」 có nghĩa là gì?","options":["bạn đời","tham gia","chính","ml"],"answer_index":0,"explanation":"mate = bạn đời"},{"question":"Từ 「ml」 có nghĩa là gì?","options":["ml","tham gia","chính","bạn đời"],"answer_index":0,"explanation":"ml = ml"},{"question":"Từ 「msn」 có nghĩa là gì?","options":["msn","tham gia","chính","bạn đời"],"answer_index":0,"explanation":"msn = msn"},{"question":"Từ 「much」 có nghĩa là gì?","options":["nhiều","tham gia","chính","bạn đời"],"answer_index":0,"explanation":"much = nhiều"},{"question":"Từ 「nacional」 có nghĩa là gì?","options":["quốc gia","tham gia","chính","bạn đời"],"answer_index":0,"explanation":"nacional = quốc gia"},{"questi