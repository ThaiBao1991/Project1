ogue":[{"title":"Cao cấp học thuật — Ngày 2019","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"文汇报を 使います。","line_vi":"Tôi dùng 文汇报.","focus_words":["文汇报"]},{"speaker":"B","line_target":"新制 は 何ですか。","line_vi":"新制 là cái gì?","focus_words":["新制"]},{"speaker":"A","line_target":"新约です。","line_vi":"Đó là 新约.","focus_words":["新约"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「文汇报」 có nghĩa là gì?","options":["Văn Vi Bộ","Mới làm","Tân Ước","tương đương với"],"answer_index":0,"explanation":"文汇报 = Văn Vi Bộ"},{"question":"Từ 「新制」 có nghĩa là gì?","options":["Mới làm","Văn Vi Bộ","Tân Ước","tương đương với"],"answer_index":0,"explanation":"新制 = Mới làm"},{"question":"Từ 「新约」 có nghĩa là gì?","options":["Tân Ước","Văn Vi Bộ","Mới làm","tương đương với"],"answer_index":0,"explanation":"新约 = Tân Ước"},{"question":"Từ 「无异于」 có nghĩa là gì?","options":["tương đương với","Văn Vi Bộ","Mới làm","Tân Ước"],"answer_index":0,"explanation":"无异于 = tương đương với"},{"question":"Từ 「日复一日」 có nghĩa là gì?","options":["ngày này qua ngày khác","Văn Vi Bộ","Mới làm","Tân Ước"],"answer_index":0,"explanation":"日复一日 = ngày này qua ngày khác"},{"question":"Từ 「晨曦」 có nghĩa là gì?","options":["ánh bình minh","Văn Vi Bộ","Mới làm","Tân Ước"],"answer_index":0,"explanation":"晨曦 = ánh bình minh"},{"question":"Từ 「曾于」 có nghĩa là gì?","options":["một lần vào","Văn Vi Bộ","Mới làm","Tân Ước"],"answer_index":0,"explanation":"曾于 = một lần vào"},{"question":"Từ 「有件事」 có nghĩa là gì?","options":["cái gì đó","Văn Vi Bộ","Mới làm","Tân Ước"],"answer_index":0,"explanation":"有件事 = cái gì đó"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Văn Vi Bộ","options":["文汇报","新制","新约","无异于"],"answer_index":0,"explanation":"文汇报 = Văn Vi Bộ"},{"q