 vị."},{"sentence":"明日 Quarter 行きます。","meaning_vi":"Ngày mai tôi sẽ đi (với bạn bè)."}],"pronunciation_focus":"Đối tượng quyết định mức kính ngữ.","common_mistakes":"Đừng dùng 伺います với bạn bè (quá kính).","mini_quiz":[{"question":"Khách hàng: 明日___。","options":["伺います","行きます","食べます"],"answer_index":0,"explanation":"Đáp án: 伺います"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1605","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"化验を 使います。","line_vi":"Tôi dùng 化验.","focus_words":["化验"]},{"speaker":"B","line_target":"北岸 は 何ですか。","line_vi":"北岸 là cái gì?","focus_words":["北岸"]},{"speaker":"A","line_target":"单项です。","line_vi":"Đó là 单项.","focus_words":["单项"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_246a3e88","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「化验」 có nghĩa là gì?","options":["Kiểm tra","bờ bắc","Mục duy nhất","Nghiên cứu sinh sau tiến sĩ"],"answer_index":0,"explanation":"化验 = Kiểm tra"},{"question":"Từ 「北岸」 có nghĩa là gì?","options":["bờ bắc","Kiểm tra","Mục duy nhất","Nghiên cứu sinh sau tiến sĩ"],"answer_index":0,"explanation":"北岸 = bờ bắc"},{"question":"Từ 「单项」 có nghĩa là gì?","options":["Mục duy nhất","Kiểm tra","bờ bắc","Nghiên cứu sinh sau tiến sĩ"],"answer_index":0,"explanation":"单项 = Mục duy nhất"},{"question":"Từ 「博士后」 có nghĩa là gì?","options":["Nghiên cứu sinh sau tiến sĩ","Kiểm tra","bờ bắc","Mục duy nhất"],"answer_index":0,"explanation":"博士后 = Nghiên cứu sinh sau tiến sĩ"},{"question":"Từ 「卫报」 có nghĩa là gì?","options":["Người bảo vệ","Kiểm tra","bờ bắc","Mục duy nhất"],"answer_index":0,"explanation":"卫报 = Người bảo vệ"},{"question":"Từ 「原则上」 có nghĩa là gì?","options":["Về nguyên tắc","Kiểm tra","bờ bắc","Mục duy nhất"],"answer_index":0,"explanation":"原则上 = Về nguyên tắc"},{"question":"Từ 「双打」 c