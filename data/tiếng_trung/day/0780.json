 ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 780","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"胎儿を 使います。","line_vi":"Tôi dùng 胎儿.","focus_words":["胎儿"]},{"speaker":"B","line_target":"脚下 は 何ですか。","line_vi":"脚下 là cái gì?","focus_words":["脚下"]},{"speaker":"A","line_target":"膝盖です。","line_vi":"Đó là 膝盖.","focus_words":["膝盖"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_77dae2da","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「胎儿」 có nghĩa là gì?","options":["bào thai","dưới chân","đầu gối","tự chế"],"answer_index":0,"explanation":"胎儿 = bào thai"},{"question":"Từ 「脚下」 có nghĩa là gì?","options":["dưới chân","bào thai","đầu gối","tự chế"],"answer_index":0,"explanation":"脚下 = dưới chân"},{"question":"Từ 「膝盖」 có nghĩa là gì?","options":["đầu gối","bào thai","dưới chân","tự chế"],"answer_index":0,"explanation":"膝盖 = đầu gối"},{"question":"Từ 「自制」 có nghĩa là gì?","options":["tự chế","bào thai","dưới chân","đầu gối"],"answer_index":0,"explanation":"自制 = tự chế"},{"question":"Từ 「警戒」 có nghĩa là gì?","options":["báo động","bào thai","dưới chân","đầu gối"],"answer_index":0,"explanation":"警戒 = báo động"},{"question":"Từ 「计量」 có nghĩa là gì?","options":["Đo lường","bào thai","dưới chân","đầu gối"],"answer_index":0,"explanation":"计量 = Đo lường"},{"question":"Từ 「讨伐」 có nghĩa là gì?","options":["cuộc thập tự chinh","bào thai","dưới chân","đầu gối"],"answer_index":0,"explanation":"讨伐 = cuộc thập tự chinh"},{"question":"Từ 「评论家」 có nghĩa là gì?","options":["nhà phê bình","bào thai","dưới chân","đầu gối"],"answer_index":0,"explanation":"评论家 = nhà phê bình"}],"pattern":[{"qu