_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_ad1dfc23","audio_ref":"m_9395602f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5b0dac6f"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1528","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"增援を 使います。","line_vi":"Tôi dùng 增援.","focus_words":["增援"]},{"speaker":"B","line_target":"士官 は 何ですか。","line_vi":"士官 là cái gì?","focus_words":["士官"]},{"speaker":"A","line_target":"外侧です。","line_vi":"Đó là 外侧.","focus_words":["外侧"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ef8f2f61","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「增援」 có nghĩa là gì?","options":["quân tiếp viện","trung sĩ","bên ngoài","bức tường bên ngoài"],"answer_index":0,"explanation":"增援 = quân tiếp viện"},{"question":"Từ 「士官」 có nghĩa là gì?","options":["trung sĩ","quân tiếp viện","bên ngoài","bức tường bên ngoài"],"answer_index":0,"explanation":"士官 = trung sĩ"},{"question":"Từ 「外侧」 có nghĩa là gì?","options":["bên ngoài","quân tiếp viện","trung sĩ","bức tường bên ngoài"],"answer_index":0,"explanation":"外侧 = bên ngoài"},{"question":"Từ 「外墙」 có nghĩa là gì?","options":["bức tường bên ngoài","quân tiếp viện","trung sĩ","bên ngoài"],"answer_index":0,"explanation":"外墙 = bức tường bên ngoài"},{"question":"Từ 「多斯」 có nghĩa là gì?","options":["Doss","quân tiếp viện","trung sĩ","bên ngoài"],"answer_index":0,"explanation":"多斯 = Doss"},{"question":"Từ 「大马」 có nghĩa là gì?","options":["Malaysia","quân tiếp viện","trung sĩ","bên ngoài"],"answer_index":0,"explanation":"大马 = Malaysia"},{"question":"Từ 「奇观」 có nghĩa là gì?","options":["cảnh tượng","quân tiếp viện","trung sĩ","bên ngoài"],"answer_index":0,"explanation":"奇观 = cảnh tượng