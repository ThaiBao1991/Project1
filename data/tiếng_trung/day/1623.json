onunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1623","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"针灸を 使います。","line_vi":"Tôi dùng 针灸.","focus_words":["针灸"]},{"speaker":"B","line_target":"铁轨 は 何ですか。","line_vi":"铁轨 là cái gì?","focus_words":["铁轨"]},{"speaker":"A","line_target":"铜像です。","line_vi":"Đó là 铜像.","focus_words":["铜像"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c7d4fd2e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「针灸」 có nghĩa là gì?","options":["Châm cứu","đường ray xe lửa","tượng đồng","nhớ"],"answer_index":0,"explanation":"针灸 = Châm cứu"},{"question":"Từ 「铁轨」 có nghĩa là gì?","options":["đường ray xe lửa","Châm cứu","tượng đồng","nhớ"],"answer_index":0,"explanation":"铁轨 = đường ray xe lửa"},{"question":"Từ 「铜像」 có nghĩa là gì?","options":["tượng đồng","Châm cứu","đường ray xe lửa","nhớ"],"answer_index":0,"explanation":"铜像 = tượng đồng"},{"question":"Từ 「铭记」 có nghĩa là gì?","options":["nhớ","Châm cứu","đường ray xe lửa","tượng đồng"],"answer_index":0,"explanation":"铭记 = nhớ"},{"question":"Từ 「锦州」 có nghĩa là gì?","options":["Cẩm Châu","Châm cứu","đường ray xe lửa","tượng đồng"],"answer_index":0,"explanation":"锦州 = Cẩm Châu"},{"question":"Từ 「闺蜜」 có nghĩa là gì?","options":["bạn thân","Châm cứu","đường ray xe lửa","tượng đồng"],"answer_index":0,"explanation":"闺蜜 = bạn thân"},{"question":"Từ 「随笔」 có nghĩa là gì?","options":["tiểu luận","Châm cứu","đường ray xe lửa","tượng đồng"],"answer_index":0,"explanation":"随笔 = tiểu luận"},{"question":"Từ 「集市」 có nghĩa là gì?","option