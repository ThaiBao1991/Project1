m."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1373","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"元气を 使います。","line_vi":"Tôi dùng 元气.","focus_words":["元气"]},{"speaker":"B","line_target":"光环 は 何ですか。","line_vi":"光环 là cái gì?","focus_words":["光环"]},{"speaker":"A","line_target":"党章です。","line_vi":"Đó là 党章.","focus_words":["党章"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_affc637b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「元气」 có nghĩa là gì?","options":["sức sống","hào quang","Điều lệ Đảng","Đầu tư vào cổ phiếu"],"answer_index":0,"explanation":"元气 = sức sống"},{"question":"Từ 「光环」 có nghĩa là gì?","options":["hào quang","sức sống","Điều lệ Đảng","Đầu tư vào cổ phiếu"],"answer_index":0,"explanation":"光环 = hào quang"},{"question":"Từ 「党章」 có nghĩa là gì?","options":["Điều lệ Đảng","sức sống","hào quang","Đầu tư vào cổ phiếu"],"answer_index":0,"explanation":"党章 = Điều lệ Đảng"},{"question":"Từ 「入股」 có nghĩa là gì?","options":["Đầu tư vào cổ phiếu","sức sống","hào quang","Điều lệ Đảng"],"answer_index":0,"explanation":"入股 = Đầu tư vào cổ phiếu"},{"question":"Từ 「全球性」 có nghĩa là gì?","options":["toàn cầu","sức sống","hào quang","Điều lệ Đảng"],"answer_index":0,"explanation":"全球性 = toàn cầu"},{"question":"Từ 「公共场所」 có nghĩa là gì?","options":["nơi công cộng","sức sống","hào quang","Điều lệ Đảng"],"answer_index":0,"explanation":"公共场所 = nơi công cộng"},{"question":"Từ 「兰花」 có nghĩa là gì?","options":["phong lan","sức sống","hào quang","Điều lệ Đảng"],"answer_index":0,"explanation":"兰花 = pho