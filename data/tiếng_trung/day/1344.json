ation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1344","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"进化论を 使います。","line_vi":"Tôi dùng 进化论.","focus_words":["进化论"]},{"speaker":"B","line_target":"违宪 は 何ですか。","line_vi":"违宪 là cái gì?","focus_words":["违宪"]},{"speaker":"A","line_target":"逃生です。","line_vi":"Đó là 逃生.","focus_words":["逃生"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0293ccbd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「进化论」 có nghĩa là gì?","options":["Sự tiến hóa","Vi hiến","trốn thoát","lợi ích"],"answer_index":0,"explanation":"进化论 = Sự tiến hóa"},{"question":"Từ 「违宪」 có nghĩa là gì?","options":["Vi hiến","Sự tiến hóa","trốn thoát","lợi ích"],"answer_index":0,"explanation":"违宪 = Vi hiến"},{"question":"Từ 「逃生」 có nghĩa là gì?","options":["trốn thoát","Sự tiến hóa","Vi hiến","lợi ích"],"answer_index":0,"explanation":"逃生 = trốn thoát"},{"question":"Từ 「造福」 có nghĩa là gì?","options":["lợi ích","Sự tiến hóa","Vi hiến","trốn thoát"],"answer_index":0,"explanation":"造福 = lợi ích"},{"question":"Từ 「逼真」 có nghĩa là gì?","options":["sống động như thật","Sự tiến hóa","Vi hiến","trốn thoát"],"answer_index":0,"explanation":"逼真 = sống động như thật"},{"question":"Từ 「逾期」 có nghĩa là gì?","options":["Quá hạn","Sự tiến hóa","Vi hiến","trốn thoát"],"answer_index":0,"explanation":"逾期 = Quá hạn"},{"question":"Từ 「道义」 có nghĩa là gì?","options":["đạo đức","Sự tiến hóa","Vi hiến","trốn thoát"],"answer_index":0,"explanation":"道义 = đạo đức"},{"question":"Từ 「遥感」 có nghĩa là gì?","options":["viễn thám","Sự tiến 