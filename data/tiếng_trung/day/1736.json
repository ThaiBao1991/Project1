c_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_11e651e7","audio_ref":"m_bc28e3c6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ccbfd0b0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1736","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"重金を 使います。","line_vi":"Tôi dùng 重金.","focus_words":["重金"]},{"speaker":"B","line_target":"野马 は 何ですか。","line_vi":"野马 là cái gì?","focus_words":["野马"]},{"speaker":"A","line_target":"错综复杂です。","line_vi":"Đó là 错综复杂.","focus_words":["错综复杂"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_20a55d21","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「重金」 có nghĩa là gì?","options":["Tiền nặng","Mustang","phức tạp","canh gác"],"answer_index":0,"explanation":"重金 = Tiền nặng"},{"question":"Từ 「野马」 có nghĩa là gì?","options":["Mustang","Tiền nặng","phức tạp","canh gác"],"answer_index":0,"explanation":"野马 = Mustang"},{"question":"Từ 「错综复杂」 có nghĩa là gì?","options":["phức tạp","Tiền nặng","Mustang","canh gác"],"answer_index":0,"explanation":"错综复杂 = phức tạp"},{"question":"Từ 「镇守」 có nghĩa là gì?","options":["canh gác","Tiền nặng","Mustang","phức tạp"],"answer_index":0,"explanation":"镇守 = canh gác"},{"question":"Từ 「镇静」 có nghĩa là gì?","options":["bình tĩnh","Tiền nặng","Mustang","phức tạp"],"answer_index":0,"explanation":"镇静 = bình tĩnh"},{"question":"Từ 「闯关」 có nghĩa là gì?","options":["vượt qua","Tiền nặng","Mustang","phức tạp"],"answer_index":0,"explanation":"闯关 = vượt qua"},{"question":"Từ 「除夕」 có nghĩa là gì?","options":["Đêm giao thừa","Tiền nặng","Mustang","phức tạp"],"answer_index":0,"explanation":"除夕 = Đêm giao thừa"},{"question":"Từ 「隋唐」 có nghĩa là gì?","options":["Nhà Tù