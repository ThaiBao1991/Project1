],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_5efb8951","audio_ref":"m_3a6e79c5","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_41fdd20c"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1896","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"戴高乐を 使います。","line_vi":"Tôi dùng 戴高乐.","focus_words":["戴高乐"]},{"speaker":"B","line_target":"扇子 は 何ですか。","line_vi":"扇子 là cái gì?","focus_words":["扇子"]},{"speaker":"A","line_target":"手镯です。","line_vi":"Đó là 手镯.","focus_words":["手镯"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0516b917","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「戴高乐」 có nghĩa là gì?","options":["de Gaulle","quạt","vòng tay","Tài năng"],"answer_index":0,"explanation":"戴高乐 = de Gaulle"},{"question":"Từ 「扇子」 có nghĩa là gì?","options":["quạt","de Gaulle","vòng tay","Tài năng"],"answer_index":0,"explanation":"扇子 = quạt"},{"question":"Từ 「手镯」 có nghĩa là gì?","options":["vòng tay","de Gaulle","quạt","Tài năng"],"answer_index":0,"explanation":"手镯 = vòng tay"},{"question":"Từ 「才干」 có nghĩa là gì?","options":["Tài năng","de Gaulle","quạt","vòng tay"],"answer_index":0,"explanation":"才干 = Tài năng"},{"question":"Từ 「托尼」 có nghĩa là gì?","options":["Tony","de Gaulle","quạt","vòng tay"],"answer_index":0,"explanation":"托尼 = Tony"},{"question":"Từ 「执勤」 có nghĩa là gì?","options":["đang làm nhiệm vụ","de Gaulle","quạt","vòng tay"],"answer_index":0,"explanation":"执勤 = đang làm nhiệm vụ"},{"question":"Từ 「投靠」 có nghĩa là gì?","options":["trú ẩn","de Gaulle","quạt","vòng tay"],"answer_index":0,"explanation":"投靠 = trú ẩn"},{"question":"Từ 「拉登」 có nghĩa là gì?","options":["bin Laden","de Gaulle","quạt","vòng tay"],"answer_index":0,"explanation":"拉登 = bin Laden"}],"pattern":[{"ques