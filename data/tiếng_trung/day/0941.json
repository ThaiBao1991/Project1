.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 941","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"推断を 使います。","line_vi":"Tôi dùng 推断.","focus_words":["推断"]},{"speaker":"B","line_target":"插手 は 何ですか。","line_vi":"插手 là cái gì?","focus_words":["插手"]},{"speaker":"A","line_target":"搬运です。","line_vi":"Đó là 搬运.","focus_words":["搬运"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a29e8e00","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「推断」 có nghĩa là gì?","options":["suy luận","can thiệp","mang theo","Thay đổi"],"answer_index":0,"explanation":"推断 = suy luận"},{"question":"Từ 「插手」 có nghĩa là gì?","options":["can thiệp","suy luận","mang theo","Thay đổi"],"answer_index":0,"explanation":"插手 = can thiệp"},{"question":"Từ 「搬运」 có nghĩa là gì?","options":["mang theo","suy luận","can thiệp","Thay đổi"],"answer_index":0,"explanation":"搬运 = mang theo"},{"question":"Từ 「改动」 có nghĩa là gì?","options":["Thay đổi","suy luận","can thiệp","mang theo"],"answer_index":0,"explanation":"改动 = Thay đổi"},{"question":"Từ 「政治犯」 có nghĩa là gì?","options":["tù nhân chính trị","suy luận","can thiệp","mang theo"],"answer_index":0,"explanation":"政治犯 = tù nhân chính trị"},{"question":"Từ 「故宫」 có nghĩa là gì?","options":["Tử Cấm Thành","suy luận","can thiệp","mang theo"],"answer_index":0,"explanation":"故宫 = Tử Cấm Thành"},{"question":"Từ 「救国」 có nghĩa là gì?","options":["Cứu đất nước"