ronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2154","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"托盘を 使います。","line_vi":"Tôi dùng 托盘.","focus_words":["托盘"]},{"speaker":"B","line_target":"扶养 は 何ですか。","line_vi":"扶养 là cái gì?","focus_words":["扶养"]},{"speaker":"A","line_target":"护肤です。","line_vi":"Đó là 护肤.","focus_words":["护肤"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e3aa64b1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「托盘」 có nghĩa là gì?","options":["pallet","hỗ trợ","Chăm sóc da","mang lại gần hơn"],"answer_index":0,"explanation":"托盘 = pallet"},{"question":"Từ 「扶养」 có nghĩa là gì?","options":["hỗ trợ","pallet","Chăm sóc da","mang lại gần hơn"],"answer_index":0,"explanation":"扶养 = hỗ trợ"},{"question":"Từ 「护肤」 có nghĩa là gì?","options":["Chăm sóc da","pallet","hỗ trợ","mang lại gần hơn"],"answer_index":0,"explanation":"护肤 = Chăm sóc da"},{"question":"Từ 「拉近」 có nghĩa là gì?","options":["mang lại gần hơn","pallet","hỗ trợ","Chăm sóc da"],"answer_index":0,"explanation":"拉近 = mang lại gần hơn"},{"question":"Từ 「拍卖会」 có nghĩa là gì?","options":["đấu giá","pallet","hỗ trợ","Chăm sóc da"],"answer_index":0,"explanation":"拍卖会 = đấu giá"},{"question":"Từ 「拍打」 có nghĩa là gì?","options":["cái tát","pallet","hỗ trợ","Chăm sóc da"],"answer_index":0,"explanation":"拍打 = cái tát"},{"question":"Từ 「拥有者」 có nghĩa là gì?","options":["chủ sở hữu","pallet","hỗ trợ","Chăm sóc da"],"answer_index":0,"explanation":"拥有者 = chủ sở hữu"},{"question":"Từ 「拿给」 có nghĩa là gì?","options":["đưa nó cho","pallet","hỗ