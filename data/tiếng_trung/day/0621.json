:[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 621","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"句子を 使います。","line_vi":"Tôi dùng 句子.","focus_words":["句子"]},{"speaker":"B","line_target":"国情 は 何ですか。","line_vi":"国情 là cái gì?","focus_words":["国情"]},{"speaker":"A","line_target":"地形です。","line_vi":"Đó là 地形.","focus_words":["地形"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_50ed8ddb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「句子」 có nghĩa là gì?","options":["câu","điều kiện quốc gia","địa hình","bức tường thành"],"answer_index":0,"explanation":"句子 = câu"},{"question":"Từ 「国情」 có nghĩa là gì?","options":["điều kiện quốc gia","câu","địa hình","bức tường thành"],"answer_index":0,"explanation":"国情 = điều kiện quốc gia"},{"question":"Từ 「地形」 có nghĩa là gì?","options":["địa hình","câu","điều kiện quốc gia","bức tường thành"],"answer_index":0,"explanation":"地形 = địa hình"},{"question":"Từ 「城墙」 có nghĩa là gì?","options":["bức tường thành","câu","điều kiện quốc gia","địa hình"],"answer_index":0,"explanation":"城墙 = bức tường thành"},{"question":"Từ 「复合」 có nghĩa là gì?","options":["hợp chất","câu","điều kiện quốc gia","địa hình"],"answer_index":0,"explanation":"复合 = hợp chất"},{"question":"Từ 「大自然」 có nghĩa là gì?","options":["thiên nhiên","câu","điều kiện quốc gia","địa hình"],"answer_index":0,"explanation":"大自然 = thiên nhiên"},{"question":"Từ 「太过」 có nghĩa là gì?","options