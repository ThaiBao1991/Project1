ence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 632","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"史料を 使います。","line_vi":"Tôi dùng 史料.","focus_words":["史料"]},{"speaker":"B","line_target":"号线 は 何ですか。","line_vi":"号线 là cái gì?","focus_words":["号线"]},{"speaker":"A","line_target":"各大です。","line_vi":"Đó là 各大.","focus_words":["各大"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e3854d1a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「史料」 có nghĩa là gì?","options":["dữ liệu lịch sử","dòng","chính","Hợp Phì"],"answer_index":0,"explanation":"史料 = dữ liệu lịch sử"},{"question":"Từ 「号线」 có nghĩa là gì?","options":["dòng","dữ liệu lịch sử","chính","Hợp Phì"],"answer_index":0,"explanation":"号线 = dòng"},{"question":"Từ 「各大」 có nghĩa là gì?","options":["chính","dữ liệu lịch sử","dòng","Hợp Phì"],"answer_index":0,"explanation":"各大 = chính"},{"question":"Từ 「合肥」 có nghĩa là gì?","options":["Hợp Phì","dữ liệu lịch sử","dòng","chính"],"answer_index":0,"explanation":"合肥 = Hợp Phì"},{"question":"Từ 「后勤」 có nghĩa là gì?","options":["hậu cần","dữ liệu lịch sử","dòng","chính"],"answer_index":0,"explanation":"后勤 = hậu cần"},{"question":"Từ 「否决」 có nghĩa là gì?","options":["phủ quyết","dữ liệu lịch sử","dòng","chính"],"answer_index":0,"explanation":"否决 = phủ quyết"},{"question":"Từ 「哥们」 có nghĩa là gì?","options":["anh bạn","dữ liệu lịch sử","dòng","chính"],"answer_index":0,"explanation":"哥们 = anh bạn"},{"question":"Từ 「噪音」 có nghĩa là gì?","options":["tiếng ồn","dữ liệu lịch sử"