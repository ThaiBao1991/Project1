ing_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1312","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"报表を 使います。","line_vi":"Tôi dùng 报表.","focus_words":["报表"]},{"speaker":"B","line_target":"抽奖 は 何ですか。","line_vi":"抽奖 là cái gì?","focus_words":["抽奖"]},{"speaker":"A","line_target":"招致です。","line_vi":"Đó là 招致.","focus_words":["招致"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5c051d95","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「报表」 có nghĩa là gì?","options":["Báo cáo","Xổ số","gánh chịu","xúi giục"],"answer_index":0,"explanation":"报表 = Báo cáo"},{"question":"Từ 「抽奖」 có nghĩa là gì?","options":["Xổ số","Báo cáo","gánh chịu","xúi giục"],"answer_index":0,"explanation":"抽奖 = Xổ số"},{"question":"Từ 「招致」 có nghĩa là gì?","options":["gánh chịu","Báo cáo","Xổ số","xúi giục"],"answer_index":0,"explanation":"招致 = gánh chịu"},{"question":"Từ 「指使」 có nghĩa là gì?","options":["xúi giục","Báo cáo","Xổ số","gánh chịu"],"answer_index":0,"explanation":"指使 = xúi giục"},{"question":"Từ 「控制系统」 có nghĩa là gì?","options":["hệ thống điều khiển","Báo cáo","Xổ số","gánh chịu"],"answer_index":0,"explanation":"控制系统 = hệ thống điều khiển"},{"question":"Từ 「推开」 có nghĩa là gì?","options":["đẩy đi","Báo cáo","Xổ số","gánh chịu"],"answer_index":0,"explanation":"推开 = đẩy đi"},{"question":"Từ 「搅拌」 có nghĩa là gì?","options":["Khuấy","Báo cáo","Xổ số","gánh chịu"],"answer_index":0,"explanation":"搅拌 = Khuấy"},{"question":"Từ 「