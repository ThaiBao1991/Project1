, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2293","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吞下を 使います。","line_vi":"Tôi dùng 吞下.","focus_words":["吞下"]},{"speaker":"B","line_target":"含泪 は 何ですか。","line_vi":"含泪 là cái gì?","focus_words":["含泪"]},{"speaker":"A","line_target":"听命です。","line_vi":"Đó là 听命.","focus_words":["听命"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_059b5a55","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吞下」 có nghĩa là gì?","options":["nuốt","đầy nước mắt","tuân theo mệnh lệnh","toàn diện"],"answer_index":0,"explanation":"吞下 = nuốt"},{"question":"Từ 「含泪」 có nghĩa là gì?","options":["đầy nước mắt","nuốt","tuân theo mệnh lệnh","toàn diện"],"answer_index":0,"explanation":"含泪 = đầy nước mắt"},{"question":"Từ 「听命」 có nghĩa là gì?","options":["tuân theo mệnh lệnh","nuốt","đầy nước mắt","toàn diện"],"answer_index":0,"explanation":"听命 = tuân theo mệnh lệnh"},{"question":"Từ 「周全」 có nghĩa là gì?","options":["toàn diện","nuốt","đầy nước mắt","tuân theo mệnh lệnh"],"answer_index":0,"explanation":"周全 = toàn diện"},{"question":"Từ 「命中注定」 có nghĩa là gì?","options":["định mệnh","nuốt","đầy nước mắt","tuân theo mệnh lệnh"],"answer_index":0,"explanation":"命中注定 = định mệnh"},{"question":"Từ 「咀嚼」 có nghĩa là gì?","options":["nhai","nuốt","đầy nước mắt","tuân theo mệnh lệnh"],"answer_index":0,"explanation":"咀嚼 = nhai"},{"question":"Từ 「哪去」 có nghĩa là gì?","options":["Đi đâu","nuốt","đầy nước mắt","tuân theo mệnh lệnh"],"answer_index":0,"explanation":"哪去 = Đi đâu"},{"question":"Từ 「哪能」 có nghĩa là gì?","options":["Làm sao c