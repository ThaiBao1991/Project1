anation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1833","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"国民革命军を 使います。","line_vi":"Tôi dùng 国民革命军.","focus_words":["国民革命军"]},{"speaker":"B","line_target":"图解 は 何ですか。","line_vi":"图解 là cái gì?","focus_words":["图解"]},{"speaker":"A","line_target":"在生活中です。","line_vi":"Đó là 在生活中.","focus_words":["在生活中"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_70b6a7d5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「国民革命军」 có nghĩa là gì?","options":["Quân đội Cách mạng Quốc gia","Minh họa","trong cuộc sống","ngoài sân"],"answer_index":0,"explanation":"国民革命军 = Quân đội Cách mạng Quốc gia"},{"question":"Từ 「图解」 có nghĩa là gì?","options":["Minh họa","Quân đội Cách mạng Quốc gia","trong cuộc sống","ngoài sân"],"answer_index":0,"explanation":"图解 = Minh họa"},{"question":"Từ 「在生活中」 có nghĩa là gì?","options":["trong cuộc sống","Quân đội Cách mạng Quốc gia","Minh họa","ngoài sân"],"answer_index":0,"explanation":"在生活中 = trong cuộc sống"},{"question":"Từ 「场外」 có nghĩa là gì?","options":["ngoài sân","Quân đội Cách mạng Quốc gia","Minh họa","trong cuộc sống"],"answer_index":0,"explanation":"场外 = ngoài sân"},{"question":"Từ 「城池」 có nghĩa là gì?","options":["thành phố","Quân đội Cách mạng Quốc gia","Minh họa","trong cuộc sống"],"answer_index":0,"explanation":"城池 = thành phố"},{"question":"Từ 「基德」 c