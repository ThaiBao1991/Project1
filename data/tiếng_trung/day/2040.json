)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2040","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"僵化を 使います。","line_vi":"Tôi dùng 僵化.","focus_words":["僵化"]},{"speaker":"B","line_target":"克西 は 何ですか。","line_vi":"克西 là cái gì?","focus_words":["克西"]},{"speaker":"A","line_target":"党性です。","line_vi":"Đó là 党性.","focus_words":["党性"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5fa2ff2c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「僵化」 có nghĩa là gì?","options":["cứng nhắc","Kersey","Tinh thần tiệc tùng","Bí thư Đảng ủy"],"answer_index":0,"explanation":"僵化 = cứng nhắc"},{"question":"Từ 「克西」 có nghĩa là gì?","options":["Kersey","cứng nhắc","Tinh thần tiệc tùng","Bí thư Đảng ủy"],"answer_index":0,"explanation":"克西 = Kersey"},{"question":"Từ 「党性」 có nghĩa là gì?","options":["Tinh thần tiệc tùng","cứng nhắc","Kersey","Bí thư Đảng ủy"],"answer_index":0,"explanation":"党性 = Tinh thần tiệc tùng"},{"question":"Từ 「党组书记」 có nghĩa là gì?","options":["Bí thư Đảng ủy","cứng nhắc","Kersey","Tinh thần tiệc tùng"],"answer_index":0,"explanation":"党组书记 = Bí thư Đảng ủy"},{"question":"Từ 「全队」 có nghĩa là gì?","options":["toàn đội","cứng nhắc","Kersey","Tinh thần tiệc tùng"],"answer_index":0,"explanation":"全队 = toàn đội"},{"question":"Từ 「养子」 có nghĩa là gì?","options":["con nuôi","cứng nhắc","Kersey","Tinh thần tiệc tùng"],"answer_index":0,"explanation":"养子 = con nuôi"},{"question":"Từ 「兼有」 có nghĩa là gì?","options":["cả hai","cứng nhắc","Kersey","Tinh thần tiệc tùng"]