ence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 707","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"完结を 使います。","line_vi":"Tôi dùng 完结.","focus_words":["完结"]},{"speaker":"B","line_target":"少妇 は 何ですか。","line_vi":"少妇 là cái gì?","focus_words":["少妇"]},{"speaker":"A","line_target":"峰会です。","line_vi":"Đó là 峰会.","focus_words":["峰会"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_73e1ed16","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「完结」 có nghĩa là gì?","options":["Đã hoàn thành","người phụ nữ trẻ","đỉnh cao","Càn Long"],"answer_index":0,"explanation":"完结 = Đã hoàn thành"},{"question":"Từ 「少妇」 có nghĩa là gì?","options":["người phụ nữ trẻ","Đã hoàn thành","đỉnh cao","Càn Long"],"answer_index":0,"explanation":"少妇 = người phụ nữ trẻ"},{"question":"Từ 「峰会」 có nghĩa là gì?","options":["đỉnh cao","Đã hoàn thành","người phụ nữ trẻ","Càn Long"],"answer_index":0,"explanation":"峰会 = đỉnh cao"},{"question":"Từ 「干隆」 có nghĩa là gì?","options":["Càn Long","Đã hoàn thành","người phụ nữ trẻ","đỉnh cao"],"answer_index":0,"explanation":"干隆 = Càn Long"},{"question":"Từ 「开端」 có nghĩa là gì?","options":["Bắt đầu","Đã hoàn thành","người phụ nữ trẻ","đỉnh cao"],"answer_index":0,"explanation":"开端 = Bắt đầu"},{"question":"Từ 「弘扬」 có nghĩa là gì?","options":["tiến về phía trước","Đã hoàn thành","người phụ nữ trẻ","đỉnh cao"],"answer_index":0,"explanation":"弘扬 = t