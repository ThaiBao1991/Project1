ung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2485","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"野鸡を 使います。","line_vi":"Tôi dùng 野鸡.","focus_words":["野鸡"]},{"speaker":"B","line_target":"量级 は 何ですか。","line_vi":"量级 là cái gì?","focus_words":["量级"]},{"speaker":"A","line_target":"金龙です。","line_vi":"Đó là 金龙.","focus_words":["金龙"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0ad540ec","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「野鸡」 có nghĩa là gì?","options":["gà lôi","độ lớn","rồng vàng","chuông"],"answer_index":0,"explanation":"野鸡 = gà lôi"},{"question":"Từ 「量级」 có nghĩa là gì?","options":["độ lớn","gà lôi","rồng vàng","chuông"],"answer_index":0,"explanation":"量级 = độ lớn"},{"question":"Từ 「金龙」 có nghĩa là gì?","options":["rồng vàng","gà lôi","độ lớn","chuông"],"answer_index":0,"explanation":"金龙 = rồng vàng"},{"question":"Từ 「铃铛」 có nghĩa là gì?","options":["chuông","gà lôi","độ lớn","rồng vàng"],"answer_index":0,"explanation":"铃铛 = chuông"},{"question":"Từ 「长女」 có nghĩa là gì?","options":["con gái lớn","gà lôi","độ lớn","rồng vàng"],"answer_index":0,"explanation":"长女 = con gái lớn"},{"question":"Từ 「长线」 có nghĩa là gì?","options":["lâu dài","gà lôi","độ lớn","rồng vàng"],"answer_index":0,"explanation":"长线 = lâu dài"},{"question":"Từ 「长足」 có nghĩa là gì?","options":["lâu dài","gà lôi","độ lớn","rồng vàng"],"answer_index":0,"explanation":"长足 = lâu dài"},{"question":"Từ 「门面」 có nghĩa là gì?","options":["mặt tiền","gà lôi","độ lớn","rồng vàng"],"answer_index":0,"explanation":"门面 = mặt tiền"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: gà lô