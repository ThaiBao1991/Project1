u trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2305","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"桥面を 使います。","line_vi":"Tôi dùng 桥面.","focus_words":["桥面"]},{"speaker":"B","line_target":"检察机关 は 何ですか。","line_vi":"检察机关 là cái gì?","focus_words":["检察机关"]},{"speaker":"A","line_target":"检查站です。","line_vi":"Đó là 检查站.","focus_words":["检查站"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b5079043","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「桥面」 có nghĩa là gì?","options":["mặt cầu","Viện kiểm sát","trạm kiểm soát","điểm mù"],"answer_index":0,"explanation":"桥面 = mặt cầu"},{"question":"Từ 「检察机关」 có nghĩa là gì?","options":["Viện kiểm sát","mặt cầu","trạm kiểm soát","điểm mù"],"answer_index":0,"explanation":"检察机关 = Viện kiểm sát"},{"question":"Từ 「检查站」 có nghĩa là gì?","options":["trạm kiểm soát","mặt cầu","Viện kiểm sát","điểm mù"],"answer_index":0,"explanation":"检查站 = trạm kiểm soát"},{"question":"Từ 「死角」 có nghĩa là gì?","options":["điểm mù","mặt cầu","Viện kiểm sát","trạm kiểm soát"],"answer_index":0,"explanation":"死角 = điểm mù"},{"question":"Từ 「残奥会」 có nghĩa là gì?","options":["người bị liệt","mặt cầu","Viện kiểm sát","trạm kiểm soát"],"answer_index":0,"explanation":"残奥会 = người bị liệt"},{"question":"Từ 「毁损」 có nghĩa là gì?","options":["hư hỏng","mặt cầu","Viện kiểm sát","trạm kiểm soát"],"answer_index":0,"explanation":"毁损 = hư hỏng"},{"question":"Từ 「每件」 có nghĩa là gì?","options":["mỗi mảnh"