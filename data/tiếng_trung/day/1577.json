netic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4b489723","audio_ref":"m_205be1bd","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_dbd929e1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (khi... thì)","level":"N4","explanation":"Vế thức + と + vế thứ hai: 春になると、桜が咲きます.","examples":[{"sentence":"春になると、桜が咲きます。","meaning_vi":"Khi xuân đến, hoa anh đào nở."},{"sentence":"学生になると、进步します。","meaning_vi":"Khi trở thành sinh viên, người ta tiến bộ."}],"pronunciation_focus":"Dùng với tương lai/hiện tại chung.","common_mistakes":"Không dùng と sau câu mệnh lệnh quá khứ.","mini_quiz":[{"question":"春に___、桜が咲きます。","options":["なると","なれば","なら"],"answer_index":0,"explanation":"Đáp án: なると"}],"references":[]},{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1577","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"像样を 使います。","line_vi":"Tôi dùng 像样.","focus_words":["像样"]},{"speaker":"B","line_target":"免受 は 何ですか。","line_vi":"免受 là cái gì?","focus_words":["免受"]},{"speaker":"A","line_target":"八百です。","line_vi":"Đó là 八百.","focus_words":["八百"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_431daa12","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「像样」 có nghĩa là gì?","options":["Có thể trình bày","thoát khỏi","tám trăm","Tắt máy"],"answer_index":0,"explanation":"像样 = Có thể trình bày"},{"question":"Từ 「免受」 có nghĩa là gì?","options":["thoát khỏi","Có thể trình bày","tám trăm","Tắt máy"],"answer_index":0,"explanation":"免受 = thoát khỏi"},{"question":"Từ 「八百」 có nghĩa là gì?","options":["tám trăm","Có thể trình bày","thoát khỏi","Tắt máy"],"answer_index":0,"explanation":"八百 = tám trăm"},{"question":"Từ 「关机」 có nghĩa là gì?","options":["Tắt máy","Có thể trình bày","thoát khỏi","tám trăm"],"answer_index":0,"explanation":"关机 = Tắt máy"},{"question":"Từ 「内务」 có nghĩa là gì?","options":["dọn phòng","Có thể trình bày","thoát khỏi","tám trăm"],"answer_index":0,"explanation":"内务 = dọn phòng"},{"question":"Từ 「农庄」 có nghĩa là gì?","options":["trang trại","Có thể trình bày","thoát khỏi","tám trăm"],"answer_index":0,"explanation":"农庄 = trang trại"},{"question":"Từ