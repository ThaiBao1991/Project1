es":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4a41bde2","audio_ref":"m_51e3a5fd","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_1ec91088"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Đại từ 私 (watashi)","level":"N5","explanation":"Từ chỉ tự ngôn: 私 / 僕・俺 (nam) / 私たち.","examples":[{"sentence":"私は田中です。","meaning_vi":"Tôi là Tanaka."}],"pronunciation_focus":"私 = watashi.","common_mistakes":"Không dùng 私 khi nói về người thứ ba.","mini_quiz":[{"question":"___は学生です。","options":["私","これ","誰"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Số đếm từ 1-10","level":"N5","explanation":"Số 1-10 có từ riêng: ichi, ni, san, yon, go, roku, nana, hachi, kyuu, juu.","examples":[{"sentence":"三rogensます。→ 三人います。","meaning_vi":"Có ba người."},{"sentence":"四時に起きます。","meaning_vi":"Tôi dậy lúc 4 giờ."}],"pronunciation_focus":"Số đọc thành âm Hán: 一 ichi, 二 ni, 三 san…","common_mistakes":"Số 4 đọc là 'yon' (không 'shi'); số 7 'nana' (không 'shichi').","mini_quiz":[{"question":"___ 時に起きます。","options":["四","五","六"],"answer_index":0,"explanation":"Đáp án: 四"}],"references":[]},{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 779","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"着急を 使います。","line_vi":"Tôi dùng 着急.","focus_words":["着急"]},{"speaker":"B","line_target":"瞩目 は 何ですか。","line_vi":"瞩目 là cái gì?","focus_words":["瞩目"]},{"speaker":"A","line_target":"研讨です。","line_vi":"Đó là 研讨.","focus_words":["研讨"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e78ab9a0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「着急」 có nghĩa là gì?","options":["lo lắng","chú ý","thảo luận","khu vực hạn chế"],"answer_index":0,"explanation":"着急 = lo lắng"},{"question":"Từ 「瞩目」 có nghĩa là gì?","options":["chú ý","lo lắng","thảo luận","khu vực hạn chế"],"answer_index":0,"explanation":"瞩目 = chú ý"},{"question":"Từ 「研讨」 có nghĩa là gì?","options":["thảo luận","lo lắng","chú ý","khu vực hạn chế"],"answer_index":0,"explanation":"研讨 = thảo luận"},{"question":"Từ 「禁区」 có nghĩa là gì?","options":["khu vực hạn chế","lo lắng","chú ý","thảo luận"],"answer_index":0,"explanation":"禁区 = khu vực hạn chế"},{"question":"Từ 「种族歧视」 có nghĩa là gì?","options":["phân biệt chủng tộc","lo lắng","chú ý","thảo luận"],"answer_index":0,"explanation":"种族歧视 = phân biệt chủng tộc"},{"question":"Từ 「稳固」 có nghĩa là gì?","options":["ổn định","lo lắng","chú ý","thảo luận"],"answer_index":0,"explanation":"稳固 = ổn định"},{"question":"Từ 「精美」 có nghĩa là gì?","options":["tinh tế","lo lắng","chú ý","thảo luận"],"answer_index":0,"explanation":"精美 = tinh tế"},{"question":"Từ 「绝大部分」 có nghĩa là gì?","options":["Hầu hết","lo lắng","chú ý","thảo luận"],"answer_index":0,"explanation":"绝大部分 = Hầu hết"}],"pattern":[{"question