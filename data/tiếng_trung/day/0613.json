"},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 613","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"普通话を 使います。","line_vi":"Tôi dùng 普通话.","focus_words":["普通话"]},{"speaker":"B","line_target":"本事 は 何ですか。","line_vi":"本事 là cái gì?","focus_words":["本事"]},{"speaker":"A","line_target":"术语です。","line_vi":"Đó là 术语.","focus_words":["术语"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0a7c0c57","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「普通话」 có nghĩa là gì?","options":["tiếng quan thoại","khả năng","Thuật ngữ","bài viết"],"answer_index":0,"explanation":"普通话 = tiếng quan thoại"},{"question":"Từ 「本事」 có nghĩa là gì?","options":["khả năng","tiếng quan thoại","Thuật ngữ","bài viết"],"answer_index":0,"explanation":"本事 = khả năng"},{"question":"Từ 「术语」 có nghĩa là gì?","options":["Thuật ngữ","tiếng quan thoại","khả năng","bài viết"],"answer_index":0,"explanation":"术语 = Thuật ngữ"},{"question":"Từ 「条文」 có nghĩa là gì?","options":["bài viết","tiếng quan thoại","khả năng","Thuật ngữ"],"answer_index":0,"explanation":"条文 = bài viết"},{"question":"Từ 「标准化」 có nghĩa là gì?","options":["Tiêu chuẩn hóa","tiếng quan thoại","khả năng","Thuật ngữ"],"answer_index":0,"explanation":"标准化 = Tiêu chuẩn hóa"},{"question":"Từ 「校对」 có nghĩa là gì?","options":["Hiệu đính","tiếng quan thoại","khả năng","Thuật ngữ"],"answer_index":0,"explanation":"校对 = Hiệu đính"},{"question":"Từ 「楼上」 có nghĩa là gì?","options":["trên lầu","tiếng quan thoại","khả năn