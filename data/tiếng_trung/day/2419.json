ntence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b004d263","audio_ref":"m_ab59208f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_365a121c"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2419","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"颜值を 使います。","line_vi":"Tôi dùng 颜值.","focus_words":["颜值"]},{"speaker":"B","line_target":"驶向 は 何ですか。","line_vi":"驶向 là cái gì?","focus_words":["驶向"]},{"speaker":"A","line_target":"验尸です。","line_vi":"Đó là 验尸.","focus_words":["验尸"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6aadbc6a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「颜值」 có nghĩa là gì?","options":["Ngoại hình","hướng tới","khám nghiệm tử thi","người quebec"],"answer_index":0,"explanation":"颜值 = Ngoại hình"},{"question":"Từ 「驶向」 có nghĩa là gì?","options":["hướng tới","Ngoại hình","khám nghiệm tử thi","người quebec"],"answer_index":0,"explanation":"驶向 = hướng tới"},{"question":"Từ 「验尸」 có nghĩa là gì?","options":["khám nghiệm tử thi","Ngoại hình","hướng tới","người quebec"],"answer_index":0,"explanation":"验尸 = khám nghiệm tử thi"},{"question":"Từ 「魁北克」 có nghĩa là gì?","options":["người quebec","Ngoại hình","hướng tới","khám nghiệm tử thi"],"answer_index":0,"explanation":"魁北克 = người quebec"},{"question":"Từ 「鸦片战争」 có nghĩa là gì?","options":["chiến tranh thuốc phiện","Ngoại hình","hướng tới","khám nghiệm tử thi"],"answer_index":0,"explanation":"鸦片战争 = chiến tranh thuốc phiện"},{"question":"Từ 「麦迪逊」 có nghĩa là gì?","options":["Madison","Ngoại hình","hướng