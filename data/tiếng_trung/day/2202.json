u trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2202","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"结业を 使います。","line_vi":"Tôi dùng 结业.","focus_words":["结业"]},{"speaker":"B","line_target":"结石 は 何ですか。","line_vi":"结石 là cái gì?","focus_words":["结石"]},{"speaker":"A","line_target":"绥靖です。","line_vi":"Đó là 绥靖.","focus_words":["绥靖"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_82af5be8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「结业」 có nghĩa là gì?","options":["Tốt nghiệp","đá","sự xoa dịu","Tổng quan"],"answer_index":0,"explanation":"结业 = Tốt nghiệp"},{"question":"Từ 「结石」 có nghĩa là gì?","options":["đá","Tốt nghiệp","sự xoa dịu","Tổng quan"],"answer_index":0,"explanation":"结石 = đá"},{"question":"Từ 「绥靖」 có nghĩa là gì?","options":["sự xoa dịu","Tốt nghiệp","đá","Tổng quan"],"answer_index":0,"explanation":"绥靖 = sự xoa dịu"},{"question":"Từ 「综观」 có nghĩa là gì?","options":["Tổng quan","Tốt nghiệp","đá","sự xoa dịu"],"answer_index":0,"explanation":"综观 = Tổng quan"},{"question":"Từ 「而出」 có nghĩa là gì?","options":["ra ngoài","Tốt nghiệp","đá","sự xoa dịu"],"answer_index":0,"explanation":"而出 = ra ngoài"},{"question":"Từ 「耐性」 có nghĩa là gì?","options":["kiên nhẫn","Tốt nghiệp","đá","sự xoa dịu"],"answer_index":0,"explanation":"耐性 = kiên nhẫn"},{"question":"Từ 「联办」 có nghĩa là gì?","options":["Phối hợp tổ chức","Tốt nghiệp","đá","sự xoa dịu"]