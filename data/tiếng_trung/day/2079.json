_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d45bb378","audio_ref":"m_9469f5e8","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e496ed53"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2079","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"味觉を 使います。","line_vi":"Tôi dùng 味觉.","focus_words":["味觉"]},{"speaker":"B","line_target":"品类 は 何ですか。","line_vi":"品类 là cái gì?","focus_words":["品类"]},{"speaker":"A","line_target":"哑巴です。","line_vi":"Đó là 哑巴.","focus_words":["哑巴"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fb006dc5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「味觉」 có nghĩa là gì?","options":["Hương vị","Danh mục","câm","nước bọt"],"answer_index":0,"explanation":"味觉 = Hương vị"},{"question":"Từ 「品类」 có nghĩa là gì?","options":["Danh mục","Hương vị","câm","nước bọt"],"answer_index":0,"explanation":"品类 = Danh mục"},{"question":"Từ 「哑巴」 có nghĩa là gì?","options":["câm","Hương vị","Danh mục","nước bọt"],"answer_index":0,"explanation":"哑巴 = câm"},{"question":"Từ 「唾液」 có nghĩa là gì?","options":["nước bọt","Hương vị","Danh mục","câm"],"answer_index":0,"explanation":"唾液 = nước bọt"},{"question":"Từ 「商定」 có nghĩa là gì?","options":["đã đồng ý","Hương vị","Danh mục","câm"],"answer_index":0,"explanation":"商定 = đã đồng ý"},{"question":"Từ 「商船」 có nghĩa là gì?","options":["tàu buôn","Hương vị","Danh mục","câm"],"answer_index":0,"explanation":"商船 = tàu buôn"},{"question":"Từ 「喂食」 có nghĩa là gì?","options":["cho ăn","Hương vị","Danh mục","câm"],"answer_index":0,"explanation":"喂食 = cho ăn"},{"question":"Từ 「喝咖啡」 có nghĩa là gì?","options":["uống cà phê","Hương vị","Danh mục","câm"],"answer_index":0,"explanation":"喝咖啡 = uống cà phê"}],"p