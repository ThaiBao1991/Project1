"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4f8b2fad","audio_ref":"m_2b5e64de","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_26183878"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1527","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"售出を 使います。","line_vi":"Tôi dùng 售出.","focus_words":["售出"]},{"speaker":"B","line_target":"喧嚣 は 何ですか。","line_vi":"喧嚣 là cái gì?","focus_words":["喧嚣"]},{"speaker":"A","line_target":"嗜好です。","line_vi":"Đó là 嗜好.","focus_words":["嗜好"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e528f343","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「售出」 có nghĩa là gì?","options":["đã bán","hối hả và nhộn nhịp","Sở thích","Kiêu ngạo"],"answer_index":0,"explanation":"售出 = đã bán"},{"question":"Từ 「喧嚣」 có nghĩa là gì?","options":["hối hả và nhộn nhịp","đã bán","Sở thích","Kiêu ngạo"],"answer_index":0,"explanation":"喧嚣 = hối hả và nhộn nhịp"},{"question":"Từ 「嗜好」 có nghĩa là gì?","options":["Sở thích","đã bán","hối hả và nhộn nhịp","Kiêu ngạo"],"answer_index":0,"explanation":"嗜好 = Sở thích"},{"question":"Từ 「嚣张」 có nghĩa là gì?","options":["Kiêu ngạo","đã bán","hối hả và nhộn nhịp","Sở thích"],"answer_index":0,"explanation":"嚣张 = Kiêu ngạo"},{"question":"Từ 「囊括」 có nghĩa là gì?","options":["bao gồm","đã bán","hối hả và nhộn nhịp","Sở thích"],"answer_index":0,"explanation":"囊括 = bao gồm"},{"question":"Từ 「团结起来」 có nghĩa là gì?","options":["đoàn kết","đã bán","hối hả và nhộn nhịp","Sở thích"],"answer_index":0,"explanation":"团结起来 = đoàn kết"},{"question":"Từ 「图谋」 có nghĩa là gì?","options":["âm mưu","đã bán","hối hả và nhộn nhịp","Sở thích"],"answer_index":0,"explanation":"图谋 = âm mưu"},{"question":"Từ 「坏处」 có nghĩa là gì?","options":["Như