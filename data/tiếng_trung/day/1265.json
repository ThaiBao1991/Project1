 brie","nhân viên","Phục hồi chức năng"],"answer_index":0,"explanation":"强制性 = bắt buộc"},{"question":"Từ 「征税」 có nghĩa là gì?","options":["thuế","rượu brie","nhân viên","Phục hồi chức năng"],"answer_index":0,"explanation":"征税 = thuế"},{"question":"Từ 「微不足道」 có nghĩa là gì?","options":["không đáng kể","rượu brie","nhân viên","Phục hồi chức năng"],"answer_index":0,"explanation":"微不足道 = không đáng kể"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: rượu brie","options":["布里","幕僚","平反","平庸"],"answer_index":0,"explanation":"布里 = rượu brie"},{"question":"Chọn từ đúng cho nghĩa: nhân viên","options":["幕僚","布里","平反","平庸"],"answer_index":0,"explanation":"幕僚 = nhân viên"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"布里":"m_fc2d94cc","幕僚":"m_1b4a5b04","平反":"m_df6702d4","平庸":"m_6c544a5f","开局":"m_bd3032b0","强制性":"m_6a95d9c7","征税":"m_0e4a1550","微不足道":"m_1aac6795","德斯":"m_eb8cb28f","怒气":"m_63de23c5"},"dialogue_audio":{"0":"m_5b22775e"}},"media_map":{"m_ecceb6d1":"media/tiếng_trung/d1265/word_00_2422e8a8.webp","m_ef889b78":"media/tiếng_trung/d1265/word_01_7d84ed16.webp","m_d1a3d973":"media/tiếng_trung/d1265/word_02_2fd1bfb7.webp","m_aad46bad":"media/tiếng_trung/d1265/word_03_230084dd.webp","m_753f67f5":"media/tiếng_trung/d1265/word_04_ee4e35e9.webp","m_d462d04d":"media/tiếng_trung/d1265/word_05_3c9ee72a.webp","m_6386e30f":"media/tiếng_trung/d1265/word_06_073e8481.webp","m_0c210db6":"media/tiếng_trung/d1265/word_07_6add85e9.webp","m_10e092af":"media/tiếng_trung/d1265/word_08_c76f232e.webp","m_4c6cacce":"media/tiếng_trung/d1265/word_09_c0183e80.webp","m_fc2d94cc":"media/tiếng_trung/d1265/audio_vocab_00_183eea02.mp3","m_170ce038":"media/tiếng_trung/d1265/audio_vocab_00_vi_07b64e71.mp3","m_1b4a5b04":"media/tiếng_trung/d1265/audio_vocab_01_ec627dfa.mp3","m_0992262c":"media/tiếng_trung/d1265/audio_vocab_01_vi_49126569.mp3","m_df6702d4":"media/tiếng_trung/d1265/audio_vocab_02_8e5d69e5.mp3","m_fc1ae8fc":"media/tiếng_trung/d1265/audio_vocab_02_vi_020b