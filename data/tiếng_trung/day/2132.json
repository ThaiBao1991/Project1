ục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2132","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"解决办法を 使います。","line_vi":"Tôi dùng 解决办法.","focus_words":["解决办法"]},{"speaker":"B","line_target":"解药 は 何ですか。","line_vi":"解药 là cái gì?","focus_words":["解药"]},{"speaker":"A","line_target":"计划书です。","line_vi":"Đó là 计划书.","focus_words":["计划书"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_55dd6d46","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「解决办法」 có nghĩa là gì?","options":["Giải pháp","thuốc giải độc","kế hoạch","Tranh luận"],"answer_index":0,"explanation":"解决办法 = Giải pháp"},{"question":"Từ 「解药」 có nghĩa là gì?","options":["thuốc giải độc","Giải pháp","kế hoạch","Tranh luận"],"answer_index":0,"explanation":"解药 = thuốc giải độc"},{"question":"Từ 「计划书」 có nghĩa là gì?","options":["kế hoạch","Giải pháp","thuốc giải độc","Tranh luận"],"answer_index":0,"explanation":"计划书 = kế hoạch"},{"question":"Từ 「论辩」 có nghĩa là gì?","options":["Tranh luận","Giải pháp","thuốc giải độc","kế hoạch"],"answer_index":0,"explanation":"论辩 = Tranh luận"},{"question":"Từ 「设计院」 có nghĩa là gì?","options":["viện thiết kế","Giải pháp","thuốc giải độc","kế hoạch"],"answer_index":0,"explanation":"设计院 = viện thiết kế"},{"question":"Từ 「词句」 có nghĩa là gì?","options":["lời nói","Giải pháp","thuốc giải độc","kế hoạch"],"answer_index":0,"explanati