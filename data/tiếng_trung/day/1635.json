rences":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1635","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大石を 使います。","line_vi":"Tôi dùng 大石.","focus_words":["大石"]},{"speaker":"B","line_target":"大院 は 何ですか。","line_vi":"大院 là cái gì?","focus_words":["大院"]},{"speaker":"A","line_target":"大餐です。","line_vi":"Đó là 大餐.","focus_words":["大餐"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_39cf50e6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大石」 có nghĩa là gì?","options":["nước dùng dashi","Sân trong","Bữa tối","thiên tai"],"answer_index":0,"explanation":"大石 = nước dùng dashi"},{"question":"Từ 「大院」 có nghĩa là gì?","options":["Sân trong","nước dùng dashi","Bữa tối","thiên tai"],"answer_index":0,"explanation":"大院 = Sân trong"},{"question":"Từ 「大餐」 có nghĩa là gì?","options":["Bữa tối","nước dùng dashi","Sân trong","thiên tai"],"answer_index":0,"explanation":"大餐 = Bữa tối"},{"question":"Từ 「天灾」 có nghĩa là gì?","options":["thiên tai","nước dùng dashi","Sân trong","Bữa tối"],"answer_index":0,"explanation":"天灾 = thiên tai"},{"question":"Từ 「太晚」 có nghĩa là gì?","options":["quá muộn","nước dùng dashi","Sân trong","Bữa tối"],"answer_index":0,"explanation":"太晚 = quá muộn"},{"question":"Từ 「如愿」 có nghĩa là gì?","options":["Như mong muốn","nước dùng dashi","Sân tro