_words":["拉伸"]},{"speaker":"B","line_target":"拉菲 は 何ですか。","line_vi":"拉菲 là cái gì?","focus_words":["拉菲"]},{"speaker":"A","line_target":"招待所です。","line_vi":"Đó là 招待所.","focus_words":["招待所"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「拉伸」 có nghĩa là gì?","options":["căng ra","Lafite","nhà khách","cản trở"],"answer_index":0,"explanation":"拉伸 = căng ra"},{"question":"Từ 「拉菲」 có nghĩa là gì?","options":["Lafite","căng ra","nhà khách","cản trở"],"answer_index":0,"explanation":"拉菲 = Lafite"},{"question":"Từ 「招待所」 có nghĩa là gì?","options":["nhà khách","căng ra","Lafite","cản trở"],"answer_index":0,"explanation":"招待所 = nhà khách"},{"question":"Từ 「拦阻」 có nghĩa là gì?","options":["cản trở","căng ra","Lafite","nhà khách"],"answer_index":0,"explanation":"拦阻 = cản trở"},{"question":"Từ 「括号」 có nghĩa là gì?","options":["dấu ngoặc đơn","căng ra","Lafite","nhà khách"],"answer_index":0,"explanation":"括号 = dấu ngoặc đơn"},{"question":"Từ 「拮据」 có nghĩa là gì?","options":["Đấu tranh","căng ra","Lafite","nhà khách"],"answer_index":0,"explanation":"拮据 = Đấu tranh"},{"question":"Từ 「挖掘机」 có nghĩa là gì?","options":["máy xúc","căng ra","Lafite","nhà khách"],"answer_index":0,"explanation":"挖掘机 = máy xúc"},{"question":"Từ 「挤进」 có nghĩa là gì?","options":["chen vào","căng ra","Lafite","nhà khách"],"answer_index":0,"explanation":"挤进 = chen vào"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: căng ra","options":["拉伸","拉菲","招待所","拦阻"],"answer_index":0,"explanation":"拉伸 = căng ra"},{"question":"Chọn từ đúng cho nghĩa: Lafite","options":["拉菲","拉伸","招待所","拦阻"],"answer_index":0,"explanation":"拉菲 = Lafite"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_map":{}}