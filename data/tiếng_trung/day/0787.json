yllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_082c6fa9","audio_ref":"m_1d14655c","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_3c656d07"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 787","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"反倒を 使います。","line_vi":"Tôi dùng 反倒.","focus_words":["反倒"]},{"speaker":"B","line_target":"口岸 は 何ですか。","line_vi":"口岸 là cái gì?","focus_words":["口岸"]},{"speaker":"A","line_target":"古迹です。","line_vi":"Đó là 古迹.","focus_words":["古迹"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1f57a276","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「反倒」 có nghĩa là gì?","options":["Ngược lại","Cảng","di tích","Cùng tên"],"answer_index":0,"explanation":"反倒 = Ngược lại"},{"question":"Từ 「口岸」 có nghĩa là gì?","options":["Cảng","Ngược lại","di tích","Cùng tên"],"answer_index":0,"explanation":"口岸 = Cảng"},{"question":"Từ 「古迹」 có nghĩa là gì?","options":["di tích","Ngược lại","Cảng","Cùng tên"],"answer_index":0,"explanation":"古迹 = di tích"},{"question":"Từ 「同名」 có nghĩa là gì?","options":["Cùng tên","Ngược lại","Cảng","di tích"],"answer_index":0,"explanation":"同名 = Cùng tên"},{"question":"Từ 「听话」 có nghĩa là gì?","options":["vâng lời","Ngược lại","Cảng","di tích"],"answer_index":0,"explanation":"听话 = vâng lời"},{"question":"Từ 「咳嗽」 có nghĩa là gì?","options":["ho","Ngược lại","Cảng","di tích"],"answer_index":0,"explanation":"咳嗽 = ho"},{"question":"Từ 「品味」 có nghĩa là gì?","options":["Hương vị","Ngược lại","Cảng","di tích"],"answer_index":0,"explanation":"品味 = Hương vị"},{"question":"Từ 「国民政府」 có nghĩa là gì?","options":["Chính phủ quốc gia","Ngược lại","Cảng","di tích"],"answer_index":0,"explanation":"国民政府 = Chính phủ quốc gia"}],"pattern":[{"ques