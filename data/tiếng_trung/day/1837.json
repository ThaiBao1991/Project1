ừ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1837","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"恩格斯を 使います。","line_vi":"Tôi dùng 恩格斯.","focus_words":["恩格斯"]},{"speaker":"B","line_target":"悟空 は 何ですか。","line_vi":"悟空 là cái gì?","focus_words":["悟空"]},{"speaker":"A","line_target":"成书です。","line_vi":"Đó là 成书.","focus_words":["成书"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ed14deaa","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「恩格斯」 có nghĩa là gì?","options":["Engels","Ngộ Không","cuốn sách viết","tôi nghĩ"],"answer_index":0,"explanation":"恩格斯 = Engels"},{"question":"Từ 「悟空」 có nghĩa là gì?","options":["Ngộ Không","Engels","cuốn sách viết","tôi nghĩ"],"answer_index":0,"explanation":"悟空 = Ngộ Không"},{"question":"Từ 「成书」 có nghĩa là gì?","options":["cuốn sách viết","Engels","Ngộ Không","tôi nghĩ"],"answer_index":0,"explanation":"成书 = cuốn sách viết"},{"question":"Từ 「我觉」 có nghĩa là gì?","options":["tôi nghĩ","Engels","Ngộ Không","cuốn sách viết"],"answer_index":0,"explanation":"我觉 = tôi nghĩ"},{"question":"Từ 「战局」 có nghĩa là gì?","options":["tình hình chiến tranh","Engels","Ngộ Không","cuốn sách viết"],"answer_index":0,"explanation":"战局 = tình hình chiến tranh"},{"question":"Từ 「战果」 có nghĩa là gì?","options":["kết quả","Engels","Ngộ Không","cuốn sách viết"],"answer_index":0,"explanation":"战果 = kết quả"},{"question":"Từ 「拆解」 có nghĩa là gì?","options":["