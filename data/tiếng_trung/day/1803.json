u cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1803","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"埋藏を 使います。","line_vi":"Tôi dùng 埋藏.","focus_words":["埋藏"]},{"speaker":"B","line_target":"基础教育 は 何ですか。","line_vi":"基础教育 là cái gì?","focus_words":["基础教育"]},{"speaker":"A","line_target":"塞内加尔です。","line_vi":"Đó là 塞内加尔.","focus_words":["塞内加尔"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9a07def5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「埋藏」 có nghĩa là gì?","options":["chôn cất","giáo dục cơ bản","Sénégal","nhồi bông"],"answer_index":0,"explanation":"埋藏 = chôn cất"},{"question":"Từ 「基础教育」 có nghĩa là gì?","options":["giáo dục cơ bản","chôn cất","Sénégal","nhồi bông"],"answer_index":0,"explanation":"基础教育 = giáo dục cơ bản"},{"question":"Từ 「塞内加尔」 có nghĩa là gì?","options":["Sénégal","chôn cất","giáo dục cơ bản","nhồi bông"],"answer_index":0,"explanation":"塞内加尔 = Sénégal"},{"question":"Từ 「塞满」 có nghĩa là gì?","options":["nhồi bông","chôn cất","giáo dục cơ bản","Sénégal"],"answer_index":0,"explanation":"塞满 = nhồi bông"},{"question":"Từ 「境遇」 có nghĩa là gì?","options":["tình huống","chôn cất","giáo dục cơ bản","Sénégal"],"answer_index":0,"explanation":"境遇 = tình huống"},{"question":"Từ 「备考」 có nghĩa là gì?","options":["chuẩn bị cho kỳ thi","chôn cất","giáo dục cơ bản","Sénégal"],"answer_index":0,"explanation":"备考 = chuẩn bị cho kỳ thi"},{"question":"Từ 「复旦」 có nghĩa là gì?","options":["Phúc Đán","chôn cất","giáo dục cơ bản",