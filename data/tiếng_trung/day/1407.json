vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1407","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"接班人を 使います。","line_vi":"Tôi dùng 接班人.","focus_words":["接班人"]},{"speaker":"B","line_target":"掩埋 は 何ですか。","line_vi":"掩埋 là cái gì?","focus_words":["掩埋"]},{"speaker":"A","line_target":"握住です。","line_vi":"Đó là 握住.","focus_words":["握住"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0a582694","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「接班人」 có nghĩa là gì?","options":["người kế vị","chôn","giữ","chiến đấu"],"answer_index":0,"explanation":"接班人 = người kế vị"},{"question":"Từ 「掩埋」 có nghĩa là gì?","options":["chôn","người kế vị","giữ","chiến đấu"],"answer_index":0,"explanation":"掩埋 = chôn"},{"question":"Từ 「握住」 có nghĩa là gì?","options":["giữ","người kế vị","chôn","chiến đấu"],"answer_index":0,"explanation":"握住 = giữ"},{"question":"Từ 「搏斗」 có nghĩa là gì?","options":["chiến đấu","người kế vị","chôn","giữ"],"answer_index":0,"explanation":"搏斗 = chiến đấu"},{"question":"Từ 「摄取」 có nghĩa là gì?","options":["nuốt vào","người kế vị","chôn","giữ"],"answer_index":0,"explanation":"摄取 = nuốt vào"},{"question":"Từ 「摇头」 có nghĩa là gì?","options":["lắc đầu","người kế vị","chôn","giữ"],"answer_index":0,"explanation":"摇头 = lắc đầu"},{"question":"Từ 「摸索」 có nghĩa là gì?","options":["mò mẫm","người kế vị","chôn","giữ"],"answer_index":0,"explanation":"摸索 = mò mẫm"},{"question":"Từ 「攻入」 có nghĩa là gì?","options":["xâm chiếm","người kế vị","chôn","giữ"],"answer_index":0,"explanation":"