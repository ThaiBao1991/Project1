aning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1897","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"推导を 使います。","line_vi":"Tôi dùng 推导.","focus_words":["推导"]},{"speaker":"B","line_target":"撼动 は 何ですか。","line_vi":"撼动 là cái gì?","focus_words":["撼动"]},{"speaker":"A","line_target":"收缴です。","line_vi":"Đó là 收缴.","focus_words":["收缴"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e3f18c87","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「推导」 có nghĩa là gì?","options":["Đạo hàm","lắc","tịch thu","người sưu tầm"],"answer_index":0,"explanation":"推导 = Đạo hàm"},{"question":"Từ 「撼动」 có nghĩa là gì?","options":["lắc","Đạo hàm","tịch thu","người sưu tầm"],"answer_index":0,"explanation":"撼动 = lắc"},{"question":"Từ 「收缴」 có nghĩa là gì?","options":["tịch thu","Đạo hàm","lắc","người sưu tầm"],"answer_index":0,"explanation":"收缴 = tịch thu"},{"question":"Từ 「收藏家」 có nghĩa là gì?","options":["người sưu tầm","Đạo hàm","lắc","tịch thu"],"answer_index":0,"explanation":"收藏家 = người sưu tầm"},{"question":"Từ 「敌机」 có nghĩa là gì?","options":["máy bay địch","Đạo hàm","lắc","tịch thu"],"answer_index":0,"explanation":"敌机 = máy bay địch"},{"question":"Từ 「数理」 có nghĩa là gì?","options":["Toán học","Đạo hàm","lắc","tịch thu"],"answer_index":0,"explanation":"数理 = Toán học"},{"question":"Từ 「敲响」 có nghĩa là gì?","options":["chiếc nhẫn","Đạo hàm","lắc","tịch thu"],"answer_index":0,"explanation":"敲响 = chiếc nhẫn"},{"question":"Từ 「斑马」 có nghĩa là gì?","options":["ngựa vằn","Đạo hàm","lắc","tị