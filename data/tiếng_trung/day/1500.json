_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_09effc3c","audio_ref":"m_c4b94a63","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_1517a33f"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1500","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"变数を 使います。","line_vi":"Tôi dùng 变数.","focus_words":["变数"]},{"speaker":"B","line_target":"变法 は 何ですか。","line_vi":"变法 là cái gì?","focus_words":["变法"]},{"speaker":"A","line_target":"变色です。","line_vi":"Đó là 变色.","focus_words":["变色"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_167c130a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「变数」 có nghĩa là gì?","options":["biến","Cải cách","Sự đổi màu","cái khác"],"answer_index":0,"explanation":"变数 = biến"},{"question":"Từ 「变法」 có nghĩa là gì?","options":["Cải cách","biến","Sự đổi màu","cái khác"],"answer_index":0,"explanation":"变法 = Cải cách"},{"question":"Từ 「变色」 có nghĩa là gì?","options":["Sự đổi màu","biến","Cải cách","cái khác"],"answer_index":0,"explanation":"变色 = Sự đổi màu"},{"question":"Từ 「另一名」 có nghĩa là gì?","options":["cái khác","biến","Cải cách","Sự đổi màu"],"answer_index":0,"explanation":"另一名 = cái khác"},{"question":"Từ 「可想而知」 có nghĩa là gì?","options":["Nó có thể hình dung được","biến","Cải cách","Sự đổi màu"],"answer_index":0,"explanation":"可想而知 = Nó có thể hình dung được"},{"question":"Từ 「史前」 có nghĩa là gì?","options":["thời tiền sử","biến","Cải cách","Sự đổi màu"],"answer_index":0,"explanation":"史前 = thời tiền sử"},{"question":"Từ 「合体」 có nghĩa là gì?","options":["phù hợp","biến","Cải cách","Sự đổi màu"],"answer_index":0,"explanation":"合体 = phù hợp"},{"question":"Từ 「吉姆」 có nghĩa là gì?","options":["Jim","biến","Cải cách","Sự đổi màu"],"answer_index":0,"explanation":"吉姆 = Jim"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: biến","options":["变数","变法","变色","另一名"],"answer_index":0,"explanation":"变数 = biến"},{"question":"Chọn từ đúng cho nghĩa: Cải cách","options":["变法","变数","变色","另一名"],"answer_index":0,"explanation":"变法 = Cải cách"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"变数":"m_847504fe","变法":"m_302f28d5","变色":"m_07fb9341","另一名":"m_56c1eee5","可想而知":"m_7b21b5dd","史前":"m_152bdb2d","合体":"m_978017b5","吉姆":"m_a6337abd","同级":"m_18346e62","吓死":"m_c4b94a63"},"dialogue_audio":{"0":"m_167c130a"}},"media_map":{"m_6d7e6a45":"media/tiếng_trung/d1500/word_00_76845e76.webp","m_3a20788c":"media/tiếng_trung/d1500/word_01_8e5cc42a.webp","m_0a392d4f":"media/tiếng_trung/d1500/word_02_e79b0372.webp","m_d8533887":"media/tiếng_trung/d1500/word_03_b15c36e6.webp","m_266a168c":"media/tiếng_trung/d1500/word_04_de5e834a.webp","m_881ba069":"media/tiếng_trung/d1500/word_05_2947e606.webp","m_8d70de9a":"media/tiếng_trung/d1500/word_06_b65e0449.webp","m_216ac46b":"media/tiếng_trung/d1500/word_07_63282205.webp","m_7a10a471":"media/tiếng_trung/d1500/word_08_d91d2c42.webp","m_09effc3c":"media/tiếng_trung/d1500/word_09_f1194cd0.webp","m_847504fe":"media/tiếng_trung/d1500/audio_vocab_00_ab8c1e71.mp3","m_5f2dbb15":"media/tiếng_trung/d1500/audio_vocab_00_vi_6f34e209.mp3","m_302f28d5":"media/tiếng_trung/d1500/audio_vocab_01_e827fa57.mp3","m_16d8e79a":"media/tiếng_trung/d1500/audio_vocab_01_vi_840e0058.mp3","m_07fb9341":"media/tiếng_trung/d1500/audio_vocab_02_bfacc1de.mp3","m_b1dbb373":"media/tiếng_trung/d1500/audio_vocab_02_vi_bfacc1de.mp3","m_56c1eee5":"media/tiếng_trung/d1500/audio_vocab_03_2b53e01e.mp3","m_ae6e003d":"media/tiếng_trung/d1500/audio_vocab_03_vi_2b53e01e.mp3","m_7b21b5dd":"media/tiếng_trung/d1500/audio_vocab_04_c1e366d6.