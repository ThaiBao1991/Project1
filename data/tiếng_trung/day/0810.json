ample_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_97ac10dc","audio_ref":"m_1261a96c","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f7625447"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 810","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"越过を 使います。","line_vi":"Tôi dùng 越过.","focus_words":["越过"]},{"speaker":"B","line_target":"身处 は 何ですか。","line_vi":"身处 là cái gì?","focus_words":["身处"]},{"speaker":"A","line_target":"车型です。","line_vi":"Đó là 车型.","focus_words":["车型"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bb76b482","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「越过」 có nghĩa là gì?","options":["chéo","trong","mẫu xe hơi","phát sóng lại"],"answer_index":0,"explanation":"越过 = chéo"},{"question":"Từ 「身处」 có nghĩa là gì?","options":["trong","chéo","mẫu xe hơi","phát sóng lại"],"answer_index":0,"explanation":"身处 = trong"},{"question":"Từ 「车型」 có nghĩa là gì?","options":["mẫu xe hơi","chéo","trong","phát sóng lại"],"answer_index":0,"explanation":"车型 = mẫu xe hơi"},{"question":"Từ 「转播」 có nghĩa là gì?","options":["phát sóng lại","chéo","trong","mẫu xe hơi"],"answer_index":0,"explanation":"转播 = phát sóng lại"},{"question":"Từ 「辽宁省」 có nghĩa là gì?","options":["Tỉnh Liêu Ninh","chéo","trong","mẫu xe hơi"],"answer_index":0,"explanation":"辽宁省 = Tỉnh Liêu Ninh"},{"question":"Từ 「这样的话」 có nghĩa là gì?","options":["Trong trường hợp này","chéo","trong","mẫu xe hơi"],"answer_index":0,"explanation":"这样的话 = Trong trường hợp này"},{"question":"Từ 「迷惑」 có nghĩa là gì?","options":["bối rối","chéo","trong","mẫu xe hơi"],"answer_index":0,"explanation":"