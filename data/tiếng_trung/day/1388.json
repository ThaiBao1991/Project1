ence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1388","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"花莲を 使います。","line_vi":"Tôi dùng 花莲.","focus_words":["花莲"]},{"speaker":"B","line_target":"苏区 は 何ですか。","line_vi":"苏区 là cái gì?","focus_words":["苏区"]},{"speaker":"A","line_target":"英明です。","line_vi":"Đó là 英明.","focus_words":["英明"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ac9cb0a0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「花莲」 có nghĩa là gì?","options":["Hoa Liên","khu vực Liên Xô","khôn ngoan","tiếng Hà Lan"],"answer_index":0,"explanation":"花莲 = Hoa Liên"},{"question":"Từ 「苏区」 có nghĩa là gì?","options":["khu vực Liên Xô","Hoa Liên","khôn ngoan","tiếng Hà Lan"],"answer_index":0,"explanation":"苏区 = khu vực Liên Xô"},{"question":"Từ 「英明」 có nghĩa là gì?","options":["khôn ngoan","Hoa Liên","khu vực Liên Xô","tiếng Hà Lan"],"answer_index":0,"explanation":"英明 = khôn ngoan"},{"question":"Từ 「荷兰人」 có nghĩa là gì?","options":["tiếng Hà Lan","Hoa Liên","khu vực Liên Xô","khôn ngoan"],"answer_index":0,"explanation":"荷兰人 = tiếng Hà Lan"},{"question":"Từ 「萨尔瓦多」 có nghĩa là gì?","options":["El Salvador","Hoa Liên","khu vực Liên Xô","khôn ngoan"],"answer_index":0,"explanation":"萨尔瓦多 = El Salvador"},{"question":"Từ 「蕴藏」 có nghĩa là gì?","options":["Chứa","Hoa Liên","khu vực Liên Xô","khôn ngoan"],"answer_index":0,"explanation":"蕴藏 = Chứa"},{"question":"Từ 「虚无」 có nghĩa là gì?","options":["hư vô","Hoa Liên","khu vực Liên Xô","khôn 