entence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_75ec7f0a","audio_ref":"m_8687d79e","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_807c8495"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Từ chỉ người (の)","level":"N3","explanation":"の + danh từ: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]},{"title":"Quá khứ xa (〜た)","level":"N3","explanation":"Ngữ cảnh quá khứ: 子供の時に、学校に通っていました.","examples":[{"sentence":"子供の頃、学校に通っていました。","meaning_vi":"Thời thơ ấy tôi có đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]},{"title":"So sánh mức độ (〜より)","level":"N2","explanation":"Câu so sánh: 大阪より大阪のほうが大きい.","examples":[{"sentence":"大阪のほうが大きいです。","meaning_vi":"Osaka lớn hơn."},{"sentence":"月曜日より土曜日の方が楽しい。","meaning_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]},{"title":"Phủ định một phần (〜わけではない)","level":"N2","explanation":"〜わけではない = không hẳn là: 嫌いなわけではない.","examples":[{"sentence":"嫌いなわけではありません。","meaning_vi":"Không hẳn là ghét."},{"sentence":"行かないわけではあ