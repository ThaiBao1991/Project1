eaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 783","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"getを 使います。","line_vi":"Tôi dùng get.","focus_words":["get"]},{"speaker":"B","line_target":"group は 何ですか。","line_vi":"group là cái gì?","focus_words":["group"]},{"speaker":"A","line_target":"javaです。","line_vi":"Đó là java.","focus_words":["java"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b096f4c6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「get」 có nghĩa là gì?","options":["nhận được","nhóm","java","tiếp theo"],"answer_index":0,"explanation":"get = nhận được"},{"question":"Từ 「group」 có nghĩa là gì?","options":["nhóm","nhận được","java","tiếp theo"],"answer_index":0,"explanation":"group = nhóm"},{"question":"Từ 「java」 có nghĩa là gì?","options":["java","nhận được","nhóm","tiếp theo"],"answer_index":0,"explanation":"java = java"},{"question":"Từ 「next」 có nghĩa là gì?","options":["tiếp theo","nhận được","nhóm","java"],"answer_index":0,"explanation":"next = tiếp theo"},{"question":"Từ 「official」 có nghĩa là gì?","options":["chính thức","nhận được","nhóm","java"],"answer_index":0,"explanation":"official = chính thức"},{"question":"Từ 「william」 có nghĩa là gì?","options":["William","nhận được","nhóm","java"],"answer_index":0,"explanation":"william = William"},{"question":"Từ 「young」 có nghĩa là gì?","options":["trẻ","nhận được","nhóm","java"],"answer_index":0,"explanation":"young = trẻ"},{"question":"Từ 「一双」 có nghĩa là gì?","options":["một cặp","nhận đượ