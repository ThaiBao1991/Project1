Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1169","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"维奇を 使います。","line_vi":"Tôi dùng 维奇.","focus_words":["维奇"]},{"speaker":"B","line_target":"编队 は 何ですか。","line_vi":"编队 là cái gì?","focus_words":["编队"]},{"speaker":"A","line_target":"羊毛です。","line_vi":"Đó là 羊毛.","focus_words":["羊毛"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4488b3c4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「维奇」 có nghĩa là gì?","options":["Vicky","sự hình thành","len","sắc đẹp"],"answer_index":0,"explanation":"维奇 = Vicky"},{"question":"Từ 「编队」 có nghĩa là gì?","options":["sự hình thành","Vicky","len","sắc đẹp"],"answer_index":0,"explanation":"编队 = sự hình thành"},{"question":"Từ 「羊毛」 có nghĩa là gì?","options":["len","Vicky","sự hình thành","sắc đẹp"],"answer_index":0,"explanation":"羊毛 = len"},{"question":"Từ 「美感」 có nghĩa là gì?","options":["sắc đẹp","Vicky","sự hình thành","len"],"answer_index":0,"explanation":"美感 = sắc đẹp"},{"question":"Từ 「耗尽」 có nghĩa là gì?","options":["kiệt sức","Vicky","sự hình thành","len"],"answer_index":0,"explanation":"耗尽 = kiệt sức"},{"question":"Từ 「腰带」 có nghĩa là gì?","options":["Thắt lưng","Vicky","sự hình thành","len"],"answer_index":0,"explanation":"腰带 = Thắt lưng"},{"question":"Từ 「航道」 có nghĩa là gì?","options":["đường thuỷ","Vicky","sự hình thành","len"],"answer_index":0,"explanation":"航道 = đường thuỷ"},{"question":"Từ 「舰长」 có nghĩa là gì?","options