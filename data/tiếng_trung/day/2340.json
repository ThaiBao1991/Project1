ải là không đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2340","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"物证を 使います。","line_vi":"Tôi dùng 物证.","focus_words":["物证"]},{"speaker":"B","line_target":"独立战争 は 何ですか。","line_vi":"独立战争 là cái gì?","focus_words":["独立战争"]},{"speaker":"A","line_target":"狱警です。","line_vi":"Đó là 狱警.","focus_words":["狱警"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_af3625bb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「物证」 có nghĩa là gì?","options":["bằng chứng vật lý","chiến tranh giành độc lập","cai ngục","Nghi ngờ"],"answer_index":0,"explanation":"物证 = bằng chứng vật lý"},{"question":"Từ 「独立战争」 có nghĩa là gì?","options":["chiến tranh giành độc lập","bằng chứng vật lý","cai ngục","Nghi ngờ"],"answer_index":0,"explanation":"独立战争 = chiến tranh giành độc lập"},{"question":"Từ 「狱警」 có nghĩa là gì?","options":["cai ngục","bằng chứng vật lý","chiến tranh giành độc lập","Nghi ngờ"],"answer_index":0,"explanation":"狱警 = cai ngục"},{"question":"Từ 「猜疑」 có nghĩa là gì?","options":["Nghi ngờ","bằng chứng vật lý","chiến tranh giành độc lập","cai ngục"],"answer_index":0,"explanation":"猜疑 = Nghi ngờ"},{"question":"Từ 「献血」 có nghĩa là gì?","options":["Hiến máu","bằng chứng vật lý","chiến tranh giành độc lập","cai ngục"],"answer_index":0,"explanation":"献血 = Hiến máu"},{"question":"Từ 「玛拉」 có nghĩa là gì?","options":["Marla","bằng chứng vật lý","chiến tranh giành độc lập","cai ngục"],"answer_index":0,"explanation":"玛拉 = Marla"},{"question":"Từ 「理顺」 có nghĩa là gì?","options