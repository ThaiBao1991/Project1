à giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1124","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"海鲜を 使います。","line_vi":"Tôi dùng 海鲜.","focus_words":["海鲜"]},{"speaker":"B","line_target":"深爱 は 何ですか。","line_vi":"深爱 là cái gì?","focus_words":["深爱"]},{"speaker":"A","line_target":"满分です。","line_vi":"Đó là 满分.","focus_words":["满分"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1ed9aa77","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「海鲜」 có nghĩa là gì?","options":["hải sản","tình yêu sâu sắc","Điểm đầy đủ","Chương Châu"],"answer_index":0,"explanation":"海鲜 = hải sản"},{"question":"Từ 「深爱」 có nghĩa là gì?","options":["tình yêu sâu sắc","hải sản","Điểm đầy đủ","Chương Châu"],"answer_index":0,"explanation":"深爱 = tình yêu sâu sắc"},{"question":"Từ 「满分」 có nghĩa là gì?","options":["Điểm đầy đủ","hải sản","tình yêu sâu sắc","Chương Châu"],"answer_index":0,"explanation":"满分 = Điểm đầy đủ"},{"question":"Từ 「漳州」 có nghĩa là gì?","options":["Chương Châu","hải sản","tình yêu sâu sắc","Điểm đầy đủ"],"answer_index":0,"explanation":"漳州 = Chương Châu"},{"question":"Từ 「炮击」 có nghĩa là gì?","options":["pháo kích","hải sản","tình yêu sâu sắc","Điểm đầy đủ"],"answer_index":0,"explanation":"炮击 = pháo kích"},{"question":"Từ 「爱丽丝」 có nghĩa là gì?","options":["Alice","hải sản","tình yêu sâu sắc","Điểm đầy đủ"],"answer_index":0,"explanation":"爱丽丝 = Alice"},{"question":"Từ 「牢房」 có nghĩa là gì?","options":["tế bào","hải sản","tình yêu sâu sắc","Điể