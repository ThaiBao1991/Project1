onunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2339","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"漠不关心を 使います。","line_vi":"Tôi dùng 漠不关心.","focus_words":["漠不关心"]},{"speaker":"B","line_target":"灰心 は 何ですか。","line_vi":"灰心 là cái gì?","focus_words":["灰心"]},{"speaker":"A","line_target":"烟叶です。","line_vi":"Đó là 烟叶.","focus_words":["烟叶"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_46ac1ccc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「漠不关心」 có nghĩa là gì?","options":["thờ ơ","chán nản","Lá thuốc lá","lò nướng"],"answer_index":0,"explanation":"漠不关心 = thờ ơ"},{"question":"Từ 「灰心」 có nghĩa là gì?","options":["chán nản","thờ ơ","Lá thuốc lá","lò nướng"],"answer_index":0,"explanation":"灰心 = chán nản"},{"question":"Từ 「烟叶」 có nghĩa là gì?","options":["Lá thuốc lá","thờ ơ","chán nản","lò nướng"],"answer_index":0,"explanation":"烟叶 = Lá thuốc lá"},{"question":"Từ 「烤箱」 có nghĩa là gì?","options":["lò nướng","thờ ơ","chán nản","Lá thuốc lá"],"answer_index":0,"explanation":"烤箱 = lò nướng"},{"question":"Từ 「燃煤」 có nghĩa là gì?","options":["đốt than","thờ ơ","chán nản","Lá thuốc lá"],"answer_index":0,"explanation":"燃煤 = đốt than"},{"question":"Từ 「爆炸性」 có nghĩa là gì?","options":["Chất nổ","thờ ơ","chán nản","Lá thuốc lá"],"answer_index":0,"explanation":"爆炸性 = Chất nổ"},{"question":"Từ 「爱恋」 có nghĩa là gì?","options":["tình yêu","thờ ơ","chán nản","Lá thuốc lá"],"answer_index":0,"explanation":"爱恋 = tình yêu"},{"question":"Từ 「牙科」 có nghĩa là gì?","options":["Nha khoa","thờ ơ","chán nản","Lá thuốc lá"],"answer_