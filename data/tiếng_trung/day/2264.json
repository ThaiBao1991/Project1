ence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"image_ref":"m_035f8911","audio_ref":"m_e0ab9b57","meaning_audio_ref":"m_d9d07d6b","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2264","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"挂号を 使います。","line_vi":"Tôi dùng 挂号.","focus_words":["挂号"]},{"speaker":"B","line_target":"振荡 は 何ですか。","line_vi":"振荡 là cái gì?","focus_words":["振荡"]},{"speaker":"A","line_target":"排外です。","line_vi":"Đó là 排外.","focus_words":["排外"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fd8232a4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「挂号」 có nghĩa là gì?","options":["Đăng ký","dao động","bài ngoại","đi ngang qua"],"answer_index":0,"explanation":"挂号 = Đăng ký"},{"question":"Từ 「振荡」 có nghĩa là gì?","options":["dao động","Đăng ký","bài ngoại","đi ngang qua"],"answer_index":0,"explanation":"振荡 = dao động"},{"question":"Từ 「排外」 có nghĩa là gì?","options":["bài ngoại","Đăng ký","dao động","đi ngang qua"],"answer_index":0,"explanation":"排外 = bài ngoại"},{"question":"Từ 「掠过」 có nghĩa là gì?","options":["đi ngang qua","Đăng ký","dao động","bài ngoại"],"answer_index":0,"explanation":"掠过 = đi ngang qua"},{"question":"Từ 「控制中心」 có nghĩa là gì?","options":["trung tâm điều khiển","Đăng ký","dao động","bài ngoại"],"answer_index":0,"explanation":"控制中心 = trung tâm điều khiển"},{"question":"Từ 「措手不及」 có nghĩa là gì?","options":["mất cảnh giác","Đăng ký","dao động","bài ngoại"],"answer_index":0,"explanation":"措手不及 = mất cảnh giác"},{"question":"Từ 「提亚」 có nghĩa là gì?","options":["tia","Đăng ký","dao động","bài ngoại"],"answer_index":0,"explanation":"提亚 = tia"},{"question":"Từ 「插队」 có nghĩa 