],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_e467a4e0","audio_ref":"m_5af8a17a","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_8fbb834e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Thì tương lai ます (động từ + ます)","level":"N5","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1865","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"成群を 使います。","line_vi":"Tôi dùng 成群.","focus_words":["成群"]},{"speaker":"B","line_target":"打气 は 何ですか。","line_vi":"打气 là cái gì?","focus_words":["打气"]},{"speaker":"A","line_target":"扫射です。","line_vi":"Đó là 扫射.","focus_words":["扫射"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2614a185","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「成群」 có nghĩa là gì?","options":["bầy đàn","Vui lên","căng thẳng","nhà thầu"],"answer_index":0,"explanation":"成群 = bầy đàn"},{"question":"Từ 「打气」 có nghĩa là gì?","options":["Vui lên","bầy đàn","căng thẳng","nhà thầu"],"answer_index":0,"explanation":"打气 = Vui lên"},{"question":"Từ 「扫射」 có nghĩa là gì?","options":["căng thẳng","bầy đàn","Vui lên","nhà thầu"],"answer_index":0,"explanation":"扫射 = căng thẳng"},{"question":"Từ 「承包商」 có nghĩa là gì?","options":["nhà thầu","bầy đàn","Vui lên","căng thẳng"],"answer_index":0,"explanation":"承包商 = nhà thầu"},{"question":"Từ 「抗议者」 có nghĩa là gì?","options":["người biểu tình","bầy đàn","Vui lên","căng thẳng"],"answer_index":0,"explanation":"抗议者 = người biểu tình"},{"question":"Từ 「抱抱」 có nghĩa là gì?","options":["Ôm","bầy đàn","Vui lên","căng thẳng"],"answer_index":0,"explanation":"抱抱 = Ôm"},{"question":"Từ 「拆开」 có nghĩa là gì?","options":["Tách rời","bầy đàn","Vui lên","căng thẳng"],"answer_index":0,"explanation":"拆开 = 