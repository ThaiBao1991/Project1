n đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 650","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"知乎を 使います。","line_vi":"Tôi dùng 知乎.","focus_words":["知乎"]},{"speaker":"B","line_target":"知名度 は 何ですか。","line_vi":"知名度 là cái gì?","focus_words":["知名度"]},{"speaker":"A","line_target":"硬币です。","line_vi":"Đó là 硬币.","focus_words":["硬币"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b6e5dd14","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「知乎」 có nghĩa là gì?","options":["Chí Hồ","sự nổi tiếng","đồng xu","nghi thức"],"answer_index":0,"explanation":"知乎 = Chí Hồ"},{"question":"Từ 「知名度」 có nghĩa là gì?","options":["sự nổi tiếng","Chí Hồ","đồng xu","nghi thức"],"answer_index":0,"explanation":"知名度 = sự nổi tiếng"},{"question":"Từ 「硬币」 có nghĩa là gì?","options":["đồng xu","Chí Hồ","sự nổi tiếng","nghi thức"],"answer_index":0,"explanation":"硬币 = đồng xu"},{"question":"Từ 「礼仪」 có nghĩa là gì?","options":["nghi thức","Chí Hồ","sự nổi tiếng","đồng xu"],"answer_index":0,"explanation":"礼仪 = nghi thức"},{"question":"Từ 「祖父」 có nghĩa là gì?","options":["ông nội","Chí Hồ","sự nổi tiếng","đồng xu"],"answer_index":0,"explanation":"祖父 = ông nội"},{"question":"Từ 「祷告」 có nghĩa là gì?","options":["cầu nguyện","Chí Hồ","sự nổi tiếng","đồng xu"],"answer_index":0,"explanation":"祷告 = cầu nguyện"},{"question":"Từ 「租金」 có nghĩa là gì?","options":["thuê","Chí Hồ","sự nổi tiếng","đồng xu"],"answer_index":0,"explanation":"租金 = thuê"},{"question":"Từ 「答复」 có nghĩa là gì?","options":["trả lời","Chí Hồ","sự nổi