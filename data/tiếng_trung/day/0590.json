_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 590","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"掩饰を 使います。","line_vi":"Tôi dùng 掩饰.","focus_words":["掩饰"]},{"speaker":"B","line_target":"揭开 は 何ですか。","line_vi":"揭开 là cái gì?","focus_words":["揭开"]},{"speaker":"A","line_target":"改装です。","line_vi":"Đó là 改装.","focus_words":["改装"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_aed6fc8d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「掩饰」 có nghĩa là gì?","options":["che đậy","khám phá","sửa đổi","quái vật"],"answer_index":0,"explanation":"掩饰 = che đậy"},{"question":"Từ 「揭开」 có nghĩa là gì?","options":["khám phá","che đậy","sửa đổi","quái vật"],"answer_index":0,"explanation":"揭开 = khám phá"},{"question":"Từ 「改装」 có nghĩa là gì?","options":["sửa đổi","che đậy","khám phá","quái vật"],"answer_index":0,"explanation":"改装 = sửa đổi"},{"question":"Từ 「斯特」 có nghĩa là gì?","options":["quái vật","che đậy","khám phá","sửa đổi"],"answer_index":0,"explanation":"斯特 = quái vật"},{"question":"Từ 「昂贵」 có nghĩa là gì?","options":["đắt tiền","che đậy","khám phá","sửa đổi"],"answer_index":0,"explanation":"昂贵 = đắt tiền"},{"question":"Từ 「春季」 có nghĩa là gì?","options":["mùa xuân","che đậy","khám phá","sửa đổi"],"answer_index":0,"explanation":"春季 = mùa xuân"},{"question":"Từ 「有毒」 có nghĩa là gì?","options":["chất độc","che đậy","khám phá","sửa đổi"],"answer_index":0,"explanation":"有毒 = chất độc"},{"question":"Từ 「有种」 có nghĩa là gì?","options":["loại","che đậy","khám phá","sửa đổi"],"answer_index":0,"explanation":"有种 = loại"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: che đậy","opt