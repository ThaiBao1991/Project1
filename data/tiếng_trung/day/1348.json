xample_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1e56303a","audio_ref":"m_51ac71ee","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d00a3dd0"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1348","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"storeを 使います。","line_vi":"Tôi dùng store.","focus_words":["store"]},{"speaker":"B","line_target":"一个多月 は 何ですか。","line_vi":"一个多月 là cái gì?","focus_words":["一个多月"]},{"speaker":"A","line_target":"一串です。","line_vi":"Đó là 一串.","focus_words":["一串"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ac850af6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「store」 có nghĩa là gì?","options":["cửa hàng","hơn một tháng","một bó","một gói"],"answer_index":0,"explanation":"store = cửa hàng"},{"question":"Từ 「一个多月」 có nghĩa là gì?","options":["hơn một tháng","cửa hàng","một bó","một gói"],"answer_index":0,"explanation":"一个多月 = hơn một tháng"},{"question":"Từ 「一串」 có nghĩa là gì?","options":["một bó","cửa hàng","hơn một tháng","một gói"],"answer_index":0,"explanation":"一串 = một bó"},{"question":"Từ 「一包」 có nghĩa là gì?","options":["một gói","cửa hàng","hơn một tháng","một bó"],"answer_index":0,"explanation":"一包 = một gói"},{"question":"Từ 「一滴」 có nghĩa là gì?","options":["một giọt","cửa hàng","hơn một tháng","một bó"],"answer_index":0,"explanation":"一滴 = một giọt"},{"question":"Từ 「一等」 có nghĩa là gì?","options":["Hạng nhất","cửa hàng","hơn một tháng","một bó"],"answer_index":0,"explanation":"一等 = Hạng nhất"},{"question":"Từ 「一职」 có nghĩa là gì?","options":["một vị trí","cửa hàng","hơn một tháng","một bó"],"answer_index":0,"explanation"