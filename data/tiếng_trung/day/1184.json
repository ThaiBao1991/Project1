syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6a19db6f","audio_ref":"m_5cb39f41","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f36dac18"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1184","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"正中を 使います。","line_vi":"Tôi dùng 正中.","focus_words":["正中"]},{"speaker":"B","line_target":"武将 は 何ですか。","line_vi":"武将 là cái gì?","focus_words":["武将"]},{"speaker":"A","line_target":"残骸です。","line_vi":"Đó là 残骸.","focus_words":["残骸"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bdc2c489","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「正中」 có nghĩa là gì?","options":["Ngay giữa","chung","đống đổ nát","mẹ và con gái"],"answer_index":0,"explanation":"正中 = Ngay giữa"},{"question":"Từ 「武将」 có nghĩa là gì?","options":["chung","Ngay giữa","đống đổ nát","mẹ và con gái"],"answer_index":0,"explanation":"武将 = chung"},{"question":"Từ 「残骸」 có nghĩa là gì?","options":["đống đổ nát","Ngay giữa","chung","mẹ và con gái"],"answer_index":0,"explanation":"残骸 = đống đổ nát"},{"question":"Từ 「母女」 có nghĩa là gì?","options":["mẹ và con gái","Ngay giữa","chung","đống đổ nát"],"answer_index":0,"explanation":"母女 = mẹ và con gái"},{"question":"Từ 「毒害」 có nghĩa là gì?","options":["chất độc","Ngay giữa","chung","đống đổ nát"],"answer_index":0,"explanation":"毒害 = chất độc"},{"question":"Từ 「民歌」 có nghĩa là gì?","options":["dân ca","Ngay giữa","chung","đống đổ nát"],"answer_index":0,"explanation":"民歌 = dân ca"},{"question":"Từ 「水力」 có nghĩa là gì?","options":["thủy lực","Ngay giữa","chung","đống đổ nát"],"answer_index":0,"explanation":"水力 = thủy lực"},{"question":"Từ 「汇款」 có nghĩa là gì?","options":["chuyển ti