istakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 776","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"总计を 使います。","line_vi":"Tôi dùng 总计.","focus_words":["总计"]},{"speaker":"B","line_target":"您好 は 何ですか。","line_vi":"您好 là cái gì?","focus_words":["您好"]},{"speaker":"A","line_target":"所用です。","line_vi":"Đó là 所用.","focus_words":["所用"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b8211675","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「总计」 có nghĩa là gì?","options":["tổng cộng","xin chào","đã sử dụng","găng tay"],"answer_index":0,"explanation":"总计 = tổng cộng"},{"question":"Từ 「您好」 có nghĩa là gì?","options":["xin chào","tổng cộng","đã sử dụng","găng tay"],"answer_index":0,"explanation":"您好 = xin chào"},{"question":"Từ 「所用」 có nghĩa là gì?","options":["đã sử dụng","tổng cộng","xin chào","găng tay"],"answer_index":0,"explanation":"所用 = đã sử dụng"},{"question":"Từ 「手套」 có nghĩa là gì?","options":["găng tay","tổng cộng","xin chào","đã sử dụng"],"answer_index":0,"explanation":"手套 = găng tay"},{"question":"Từ 「才华」 có nghĩa là gì?","options":["Tài năng","tổng cộng","xin chào","đã sử dụng"],"answer_index":0,"explanation":"才华 = Tài năng"},{"question":"Từ 「指着」 có nghĩa là gì?","options":["chỉ tay","tổng cộng","xin chào","đã sử dụng"],"answer_index":0,"explanation":"指着 = chỉ tay"},{"question":"Từ 「授课」 có nghĩa là gì?","options":["dạy","tổng cộng","xin chào","đã sử dụng"],"answer_index":0,"explanation":"授课 = dạy"},{"question":"Từ 「探险」 có nghĩa là gì?","options":["cuộc phiêu lưu","tổng cộng","xin chào","đã sử dụng"],"answer_index":0,"explanation":"探险 = cuộc phiêu lưu"}],"pattern":