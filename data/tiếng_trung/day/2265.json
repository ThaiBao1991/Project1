o cáo tin tức","explanation":"Báo cáo tin tức","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_af4378b4","audio_ref":"m_398af995","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_8286ecec"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2265","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"收益率を 使います。","line_vi":"Tôi dùng 收益率.","focus_words":["收益率"]},{"speaker":"B","line_target":"政教 は 何ですか。","line_vi":"政教 là cái gì?","focus_words":["政教"]},{"speaker":"A","line_target":"政治化です。","line_vi":"Đó là 政治化.","focus_words":["政治化"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_da13ae67","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「收益率」 có nghĩa là gì?","options":["Năng suất","chính trị và tôn giáo","chính trị hóa","phim truyện"],"answer_index":0,"explanation":"收益率 = Năng suất"},{"question":"Từ 「政教」 có nghĩa là gì?","options":["chính trị và tôn giáo","Năng suất","chính trị hóa","phim truyện"],"answer_index":0,"explanation":"政教 = chính trị và tôn giáo"},{"question":"Từ 「政治化」 có nghĩa là gì?","options":["chính trị hóa","Năng suất","chính trị và tôn giáo","phim truyện"],"answer_index":0,"explanation":"政治化 = chính trị hóa"},{"question":"Từ 「故事片」 có nghĩa là gì?","options":["phim truyện","Năng suất","chính trị và tôn giáo","chính trị hóa"],"answer_index":0,"explanation":"故事片 = phim truyện"},{"question":"Từ 「救星」 có nghĩa là gì?","options":["vị cứu tinh","Năng suất","chính trị và tôn giáo","chính trị hóa"],"answer_index":0,"explanation":"救星 = vị cứu tinh"},{"question":"Từ 「救起」 có nghĩa là gì?","options":["giải cứu","Năng suất","chính trị và tôn giáo","ch