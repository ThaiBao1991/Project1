、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1762","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"获选を 使います。","line_vi":"Tôi dùng 获选.","focus_words":["获选"]},{"speaker":"B","line_target":"菠菜 は 何ですか。","line_vi":"菠菜 là cái gì?","focus_words":["菠菜"]},{"speaker":"A","line_target":"落叶です。","line_vi":"Đó là 落叶.","focus_words":["落叶"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0dff39ed","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「获选」 có nghĩa là gì?","options":["đã chọn","rau chân vịt","lá rụng","phát triển mạnh"],"answer_index":0,"explanation":"获选 = đã chọn"},{"question":"Từ 「菠菜」 có nghĩa là gì?","options":["rau chân vịt","đã chọn","lá rụng","phát triển mạnh"],"answer_index":0,"explanation":"菠菜 = rau chân vịt"},{"question":"Từ 「落叶」 có nghĩa là gì?","options":["lá rụng","đã chọn","rau chân vịt","phát triển mạnh"],"answer_index":0,"explanation":"落叶 = lá rụng"},{"question":"Từ 「蓬勃发展」 có nghĩa là gì?","options":["phát triển mạnh","đã chọn","rau chân vịt","lá rụng"],"answer_index":0,"explanation":"蓬勃发展 = phát triển mạnh"},{"question":"Từ 「薄荷」 có nghĩa là gì?","options":["cây bạc hà","đã chọn","rau chân vịt","lá rụng"],"answer_index":0,"explanation":"薄荷 = cây bạc hà"},{"question":"Từ 「裁缝」 có nghĩa là gì?","options":["thợ may","đã chọn","rau chân vịt","lá rụng"],"answer_index":0,"explanation":"裁缝 = thợ may"},{"question":"Từ 「西城」 có nghĩa l