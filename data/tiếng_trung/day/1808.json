ài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1808","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"投篮を 使います。","line_vi":"Tôi dùng 投篮.","focus_words":["投篮"]},{"speaker":"B","line_target":"折断 は 何ですか。","line_vi":"折断 là cái gì?","focus_words":["折断"]},{"speaker":"A","line_target":"招式です。","line_vi":"Đó là 招式.","focus_words":["招式"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5b0f14ba","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「投篮」 có nghĩa là gì?","options":["Bắn","phá vỡ","di chuyển","tiếp nhận"],"answer_index":0,"explanation":"投篮 = Bắn"},{"question":"Từ 「折断」 có nghĩa là gì?","options":["phá vỡ","Bắn","di chuyển","tiếp nhận"],"answer_index":0,"explanation":"折断 = phá vỡ"},{"question":"Từ 「招式」 có nghĩa là gì?","options":["di chuyển","Bắn","phá vỡ","tiếp nhận"],"answer_index":0,"explanation":"招式 = di chuyển"},{"question":"Từ 「招待会」 có nghĩa là gì?","options":["tiếp nhận","Bắn","phá vỡ","di chuyển"],"answer_index":0,"explanation":"招待会 = tiếp nhận"},{"question":"Từ 「指教」 có nghĩa là gì?","options":["Đưa ra lời khuyên","Bắn","phá vỡ","di chuyển"],"answer_index":0,"explanation":"指教 = Đưa ra lời khuyên"},{"question":"Từ 「接送」 có nghĩa là gì?","options":["Đón và thả ra","Bắn","phá vỡ","di chuyển"],"answer_index":0,"explanation":"接送 = Đón và thả ra"},{"question":"Từ 「推手」 có nghĩa là gì?","options":["đẩy tay","Bắn","phá vỡ","di chuyển"],"answer_index":0,"explanation":"推手 = đẩy tay"},{"question":"Từ 「搞不懂」 có nghĩa là gì?","options":["không hiểu","Bắn","phá vỡ","di chuyển"],"answer_index":0