 từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1465","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"该地を 使います。","line_vi":"Tôi dùng 该地.","focus_words":["该地"]},{"speaker":"B","line_target":"调皮 は 何ですか。","line_vi":"调皮 là cái gì?","focus_words":["调皮"]},{"speaker":"A","line_target":"谋取です。","line_vi":"Đó là 谋取.","focus_words":["谋取"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9f90e855","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「该地」 có nghĩa là gì?","options":["nơi","nghịch ngợm","tìm kiếm","tượng trưng"],"answer_index":0,"explanation":"该地 = nơi"},{"question":"Từ 「调皮」 có nghĩa là gì?","options":["nghịch ngợm","nơi","tìm kiếm","tượng trưng"],"answer_index":0,"explanation":"调皮 = nghịch ngợm"},{"question":"Từ 「谋取」 có nghĩa là gì?","options":["tìm kiếm","nơi","nghịch ngợm","tượng trưng"],"answer_index":0,"explanation":"谋取 = tìm kiếm"},{"question":"Từ 「象征性」 có nghĩa là gì?","options":["tượng trưng","nơi","nghịch ngợm","tìm kiếm"],"answer_index":0,"explanation":"象征性 = tượng trưng"},{"question":"Từ 「象牙」 có nghĩa là gì?","options":["ngà voi","nơi","nghịch ngợm","tìm kiếm"],"answer_index":0,"explanation":"象牙 = ngà voi"},{"question":"Từ 「豪门」 có nghĩa là gì?","options":["Gia đình giàu có","nơi","nghịch ngợm","tìm kiếm"],"answer_index":0,"explanation":"豪门 = Gia đình giàu có"}