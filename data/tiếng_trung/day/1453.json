n là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1453","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"定下を 使います。","line_vi":"Tôi dùng 定下.","focus_words":["定下"]},{"speaker":"B","line_target":"家畜 は 何ですか。","line_vi":"家畜 là cái gì?","focus_words":["家畜"]},{"speaker":"A","line_target":"富强です。","line_vi":"Đó là 富强.","focus_words":["富强"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ea6538a8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「定下」 có nghĩa là gì?","options":["giải quyết","chăn nuôi","thịnh vượng","phòng ngủ"],"answer_index":0,"explanation":"定下 = giải quyết"},{"question":"Từ 「家畜」 có nghĩa là gì?","options":["chăn nuôi","giải quyết","thịnh vượng","phòng ngủ"],"answer_index":0,"explanation":"家畜 = chăn nuôi"},{"question":"Từ 「富强」 có nghĩa là gì?","options":["thịnh vượng","giải quyết","chăn nuôi","phòng ngủ"],"answer_index":0,"explanation":"富强 = thịnh vượng"},{"question":"Từ 「寝室」 có nghĩa là gì?","options":["phòng ngủ","giải quyết","chăn nuôi","thịnh vượng"],"answer_index":0,"explanation":"寝室 = phòng ngủ"},{"question":"Từ 「小儿」 có nghĩa là gì?","options":["bọn trẻ","giải quyết","chăn nuôi","thịnh vượng"],"answer_index":0,"explanation":"小儿 = bọn trẻ"},{"question":"Từ 「少林」 có nghĩa là gì?","options":["Thiếu Lâm","giải quyết","chăn nuôi","thịnh vượ