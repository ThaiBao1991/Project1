:"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2177","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"不同寻常を 使います。","line_vi":"Tôi dùng 不同寻常.","focus_words":["不同寻常"]},{"speaker":"B","line_target":"不失为 は 何ですか。","line_vi":"不失为 là cái gì?","focus_words":["不失为"]},{"speaker":"A","line_target":"不须です。","line_vi":"Đó là 不须.","focus_words":["不须"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「不同寻常」 có nghĩa là gì?","options":["bất thường","Không tệ","không cần","Chuyên môn hóa"],"answer_index":0,"explanation":"不同寻常 = bất thường"},{"question":"Từ 「不失为」 có nghĩa là gì?","options":["Không tệ","bất thường","không cần","Chuyên môn hóa"],"answer_index":0,"explanation":"不失为 = Không tệ"},{"question":"Từ 「不须」 có nghĩa là gì?","options":["không cần","bất thường","Không tệ","Chuyên môn hóa"],"answer_index":0,"explanation":"不须 = không cần"},{"question":"Từ 「专营」 có nghĩa là gì?","options":["Chuyên môn hóa","bất thường","Không tệ","không cần"],"answer_index":0,"explanation":"专营 = Chuyên môn hóa"},{"question":"Từ 「两代」 có nghĩa là gì?","options":["hai thế hệ","bất thường","Không tệ","không cần"],"answer_index":0,"explanation":"两代 = hai thế hệ"},{"question":"Từ 「中华书局」 có nghĩa là gì?","options":["Công ty sách Trung Hoa","bất thường","Không tệ","không cần"],"answer_index":0,"explanation":"中华书局 = Công ty sách Trung Hoa"},{"question":"Từ 「中华人民共和国国务院」 có nghĩa là gì?","options":["Hội đồng Nhà nước Cộng hòa Nhân dân Trung Hoa","bất thường","Không tệ","không cần"],"answer_index":0,"explanation":"中华人民共和国国务院 = Hội đồng Nhà nước Cộng hòa Nhân dân Trung Hoa"},{"question":