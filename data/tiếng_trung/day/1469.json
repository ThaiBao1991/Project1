ch."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1469","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"fbを 使います。","line_vi":"Tôi dùng fb.","focus_words":["fb"]},{"speaker":"B","line_target":"full は 何ですか。","line_vi":"full là cái gì?","focus_words":["full"]},{"speaker":"A","line_target":"hitです。","line_vi":"Đó là hit.","focus_words":["hit"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7d483bc9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「fb」 có nghĩa là gì?","options":["fb","đầy đủ","đánh","vào"],"answer_index":0,"explanation":"fb = fb"},{"question":"Từ 「full」 có nghĩa là gì?","options":["đầy đủ","fb","đánh","vào"],"answer_index":0,"explanation":"full = đầy đủ"},{"question":"Từ 「hit」 có nghĩa là gì?","options":["đánh","fb","đầy đủ","vào"],"answer_index":0,"explanation":"hit = đánh"},{"question":"Từ 「into」 có nghĩa là gì?","options":["vào","fb","đầy đủ","đánh"],"answer_index":0,"explanation":"into = vào"},{"question":"Từ 「ken」 có nghĩa là gì?","options":["ken","fb","đầy đủ","đánh"],"answer_index":0,"explanation":"ken = ken"},{"question":"Từ 「lab」 có nghĩa là gì?","options":["phòng thí nghiệm","fb","đầy đủ","đánh"],"answer_index":0,"explanation":"lab = phòng thí nghiệm"},{"question":"Từ 「mom」 có nghĩa là gì?","options":["mẹ","fb","đầy đủ","đánh"],"answer_index":0,"explanation":"mom = mẹ"},{"question":"Từ 「nike」 có nghĩa là gì?","options":["Nike","fb","đầy đủ","đánh"],"answer_index":0,"explanation":"nike = Nike"}],"pattern":[{"question":"Chọn từ đúng ch