p Phì","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_48abfc5f","audio_ref":"m_969ceeeb","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_72b075aa"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2292","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"升旗を 使います。","line_vi":"Tôi dùng 升旗.","focus_words":["升旗"]},{"speaker":"B","line_target":"卓著 は 何ですか。","line_vi":"卓著 là cái gì?","focus_words":["卓著"]},{"speaker":"A","line_target":"印地安です。","line_vi":"Đó là 印地安.","focus_words":["印地安"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_132babe1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「升旗」 có nghĩa là gì?","options":["Giương cờ","Nổi bật","người Ấn Độ","quả trứng"],"answer_index":0,"explanation":"升旗 = Giương cờ"},{"question":"Từ 「卓著」 có nghĩa là gì?","options":["Nổi bật","Giương cờ","người Ấn Độ","quả trứng"],"answer_index":0,"explanation":"卓著 = Nổi bật"},{"question":"Từ 「印地安」 có nghĩa là gì?","options":["người Ấn Độ","Giương cờ","Nổi bật","quả trứng"],"answer_index":0,"explanation":"印地安 = người Ấn Độ"},{"question":"Từ 「卵子」 có nghĩa là gì?","options":["quả trứng","Giương cờ","Nổi bật","người Ấn Độ"],"answer_index":0,"explanation":"卵子 = quả trứng"},{"question":"Từ 「厄瓜」 có nghĩa là gì?","options":["Egua","Giương cờ","Nổi bật","người Ấn Độ"],"answer_index":0,"explanation":"厄瓜 = Egua"},{"question":"Từ 「历史学」 có nghĩa là gì?","options":["Lịch sử","Giương cờ","Nổi bật","người Ấn Độ"],"answer_index":0,"explanation":"历史学 = Lịch sử"},{"question":"Từ 「原貌」 có nghĩa là gì?","options":["Ngoại hình ban đầu","Giương cờ","Nổi bật","người Ấn Độ"],"answer_index":0,"explanation":"原貌 = Ngoại hình ban đầu"},