":"Tôi dùng 一派.","focus_words":["一派"]},{"speaker":"B","line_target":"三家 は 何ですか。","line_vi":"三家 là cái gì?","focus_words":["三家"]},{"speaker":"A","line_target":"不知不觉です。","line_vi":"Đó là 不知不觉.","focus_words":["不知不觉"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「一派」 có nghĩa là gì?","options":["Một phe","ba","một cách vô thức","Đông Nam Bộ"],"answer_index":0,"explanation":"一派 = Một phe"},{"question":"Từ 「三家」 có nghĩa là gì?","options":["ba","Một phe","một cách vô thức","Đông Nam Bộ"],"answer_index":0,"explanation":"三家 = ba"},{"question":"Từ 「不知不觉」 có nghĩa là gì?","options":["một cách vô thức","Một phe","ba","Đông Nam Bộ"],"answer_index":0,"explanation":"不知不觉 = một cách vô thức"},{"question":"Từ 「东南部」 có nghĩa là gì?","options":["Đông Nam Bộ","Một phe","ba","một cách vô thức"],"answer_index":0,"explanation":"东南部 = Đông Nam Bộ"},{"question":"Từ 「五百」 có nghĩa là gì?","options":["năm trăm","Một phe","ba","một cách vô thức"],"answer_index":0,"explanation":"五百 = năm trăm"},{"question":"Từ 「亚当」 có nghĩa là gì?","options":["Adam","Một phe","ba","một cách vô thức"],"answer_index":0,"explanation":"亚当 = Adam"},{"question":"Từ 「人有」 có nghĩa là gì?","options":["mọi người có","Một phe","ba","một cách vô thức"],"answer_index":0,"explanation":"人有 = mọi người có"},{"question":"Từ 「传感器」 có nghĩa là gì?","options":["cảm biến","Một phe","ba","một cách vô thức"],"answer_index":0,"explanation":"传感器 = cảm biến"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Một phe","options":["一派","三家","不知不觉","东南部"],"answer_index":0,"explanation":"一派 = Một phe"},{"question":"Chọn từ đúng cho nghĩa: ba","options":["三家","一派","不知不觉","东南部"],"answer_index":0,"explanation":"三家 = ba"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"media_ma