 sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1365","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"许诺を 使います。","line_vi":"Tôi dùng 许诺.","focus_words":["许诺"]},{"speaker":"B","line_target":"访客 は 何ですか。","line_vi":"访客 là cái gì?","focus_words":["访客"]},{"speaker":"A","line_target":"说了算です。","line_vi":"Đó là 说了算.","focus_words":["说了算"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1535e4f3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「许诺」 có nghĩa là gì?","options":["lời hứa","du khách","Có tiếng nói cuối cùng","Đừng"],"answer_index":0,"explanation":"许诺 = lời hứa"},{"question":"Từ 「访客」 có nghĩa là gì?","options":["du khách","lời hứa","Có tiếng nói cuối cùng","Đừng"],"answer_index":0,"explanation":"访客 = du khách"},{"question":"Từ 「说了算」 có nghĩa là gì?","options":["Có tiếng nói cuối cùng","lời hứa","du khách","Đừng"],"answer_index":0,"explanation":"说了算 = Có tiếng nói cuối cùng"},{"question":"Từ 「请勿」 có nghĩa là gì?","options":["Đừng","lời hứa","du khách","Có tiếng nói cuối cùng"],"answer_index":0,"explanation":"请勿 = Đừng"},{"question":"Từ 「贯通」 có nghĩa là gì?","options":["thâm nhập","lời hứa","du khách","Có tiếng nói cuối cùng"],"answer_index":0,"explanation":"贯通 = thâm nhập"},{"question":"Từ 「超强」 có nghĩa là gì?","options":["siêu mạnh","lời hứa","du khách","Có tiếng nói cuối cùng"],"answer_index":0,"explanation":"超强 = siêu mạnh"},{"question":"Từ 「跻身」 có nghĩa là gì?","options":["tăng lên trong số","lời hứa","du khách","Có tiếng nói cuối cùn