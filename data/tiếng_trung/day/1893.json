":"","syllables":[],"image_ref":"m_666f4eaa","audio_ref":"m_0644882b","meaning_audio_ref":"m_b378f5fd","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1893","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"射中を 使います。","line_vi":"Tôi dùng 射中.","focus_words":["射中"]},{"speaker":"B","line_target":"小号 は 何ですか。","line_vi":"小号 là cái gì?","focus_words":["小号"]},{"speaker":"A","line_target":"小店です。","line_vi":"Đó là 小店.","focus_words":["小店"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_4df9dc43","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「射中」 có nghĩa là gì?","options":["bắn","kèn","cửa hàng nhỏ","em trai"],"answer_index":0,"explanation":"射中 = bắn"},{"question":"Từ 「小号」 có nghĩa là gì?","options":["kèn","bắn","cửa hàng nhỏ","em trai"],"answer_index":0,"explanation":"小号 = kèn"},{"question":"Từ 「小店」 có nghĩa là gì?","options":["cửa hàng nhỏ","bắn","kèn","em trai"],"answer_index":0,"explanation":"小店 = cửa hàng nhỏ"},{"question":"Từ 「小弟弟」 có nghĩa là gì?","options":["em trai","bắn","kèn","cửa hàng nhỏ"],"answer_index":0,"explanation":"小弟弟 = em trai"},{"question":"Từ 「小调」 có nghĩa là gì?","options":["phím phụ","bắn","kèn","cửa hàng nhỏ"],"answer_index":0,"explanation":"小调 = phím phụ"},{"question":"Từ 「尼古拉斯」 có nghĩa là gì?","options":["Nicholas","bắn","kèn","cửa hàng nhỏ"],"answer_index":0,"explanation":"尼古拉斯 = Nicholas"},{"question":"Từ 「局域网」 có nghĩa là gì?","options":["mạng LAN","bắn","kèn","cửa hàng nhỏ"],"answer_index":0,"explanation":"局域网 = mạng LAN"},{"question":"Từ 「展现出」 có nghĩa là gì?","options":["hiển thị","bắn","kèn","cửa hàng nhỏ"],"answer_index":0,"explanation":"展现出 = hiển thị"}],"pattern":[{"question":"Chọn từ đú