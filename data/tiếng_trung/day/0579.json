anation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 579","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"正要を 使います。","line_vi":"Tôi dùng 正要.","focus_words":["正要"]},{"speaker":"B","line_target":"步枪 は 何ですか。","line_vi":"步枪 là cái gì?","focus_words":["步枪"]},{"speaker":"A","line_target":"毫无疑问です。","line_vi":"Đó là 毫无疑问.","focus_words":["毫无疑问"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_f360332c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「正要」 có nghĩa là gì?","options":["Sắp tới","súng trường","không còn nghi ngờ gì nữa","tập hợp lại với nhau"],"answer_index":0,"explanation":"正要 = Sắp tới"},{"question":"Từ 「步枪」 có nghĩa là gì?","options":["súng trường","Sắp tới","không còn nghi ngờ gì nữa","tập hợp lại với nhau"],"answer_index":0,"explanation":"步枪 = súng trường"},{"question":"Từ 「毫无疑问」 có nghĩa là gì?","options":["không còn nghi ngờ gì nữa","Sắp tới","súng trường","tập hợp lại với nhau"],"answer_index":0,"explanation":"毫无疑问 = không còn nghi ngờ gì nữa"},{"question":"Từ 「汇集」 có nghĩa là gì?","options":["tập hợp lại với nhau","Sắp tới","súng trường","không còn nghi ngờ gì nữa"],"answer_index":0,"explanation":"汇集 = tập hợp lại với nhau"},{"question":"Từ 「流出」 có nghĩa là gì?","options":["chảy ra","Sắp tới","súng trường","không còn nghi ngờ gì nữa"],"answer_index":0,"explanation":"流出 = chảy ra"},{"question":"Từ 「清代」 có nghĩa l