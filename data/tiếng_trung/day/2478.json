ing_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2478","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"组成员を 使います。","line_vi":"Tôi dùng 组成员.","focus_words":["组成员"]},{"speaker":"B","line_target":"组阁 は 何ですか。","line_vi":"组阁 là cái gì?","focus_words":["组阁"]},{"speaker":"A","line_target":"绊脚石です。","line_vi":"Đó là 绊脚石.","focus_words":["绊脚石"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2c268fdf","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「组成员」 có nghĩa là gì?","options":["thành viên nhóm","Tạo thành một chiếc tủ","trở ngại","định kỳ"],"answer_index":0,"explanation":"组成员 = thành viên nhóm"},{"question":"Từ 「组阁」 có nghĩa là gì?","options":["Tạo thành một chiếc tủ","thành viên nhóm","trở ngại","định kỳ"],"answer_index":0,"explanation":"组阁 = Tạo thành một chiếc tủ"},{"question":"Từ 「绊脚石」 có nghĩa là gì?","options":["trở ngại","thành viên nhóm","Tạo thành một chiếc tủ","định kỳ"],"answer_index":0,"explanation":"绊脚石 = trở ngại"},{"question":"Từ 「经常性」 có nghĩa là gì?","options":["định kỳ","thành viên nhóm","Tạo thành một chiếc tủ","trở ngại"],"answer_index":0,"explanation":"经常性 = định kỳ"},{"question":"Từ 「经济网」 có nghĩa là gì?","options":["Mạng lưới kinh tế","thành viên nhóm","Tạo thành một chiếc tủ","trở ngại"],"answer_index":0,"explanation":"经济网 = Mạng lưới kinh tế"},{"question":"Từ 「绝种」 có nghĩa là gì?","options":["Tuyệt chủng","thành viên nhóm","Tạo thành một chiếc tủ","trở ngại"],"answer_index":0,"explanation":"绝种 = Tuyệt chủng"},{"question":"Từ 「维纳」 có nghĩa là gì?","options":