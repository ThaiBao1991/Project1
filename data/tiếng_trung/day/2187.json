ấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2187","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大写を 使います。","line_vi":"Tôi dùng 大写.","focus_words":["大写"]},{"speaker":"B","line_target":"大展 は 何ですか。","line_vi":"大展 là cái gì?","focus_words":["大展"]},{"speaker":"A","line_target":"大浪です。","line_vi":"Đó là 大浪.","focus_words":["大浪"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_fa6743fb","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大写」 có nghĩa là gì?","options":["chữ hoa","Triển lãm","làn sóng lớn","Món quà lớn"],"answer_index":0,"explanation":"大写 = chữ hoa"},{"question":"Từ 「大展」 có nghĩa là gì?","options":["Triển lãm","chữ hoa","làn sóng lớn","Món quà lớn"],"answer_index":0,"explanation":"大展 = Triển lãm"},{"question":"Từ 「大浪」 có nghĩa là gì?","options":["làn sóng lớn","chữ hoa","Triển lãm","Món quà lớn"],"answer_index":0,"explanation":"大浪 = làn sóng lớn"},{"question":"Từ 「大礼」 có nghĩa là gì?","options":["Món quà lớn","chữ hoa","Triển lãm","làn sóng lớn"],"answer_index":0,"explanation":"大礼 = Món quà lớn"},{"question":"Từ 「大话」 có nghĩa là gì?","options":["Nói chuyện lớn","chữ hoa","Triển lãm","làn sóng lớn"],"answer_index":0,"explanation":"大话 = Nói chuyện lớn"},{"question":"Từ 「太难」 có nghĩa là gì?","options":["quá khó","chữ hoa","Triển lãm","làn sóng lớn"],"answer_index"