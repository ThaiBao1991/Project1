ng)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1637","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"帆船を 使います。","line_vi":"Tôi dùng 帆船.","focus_words":["帆船"]},{"speaker":"B","line_target":"年少 は 何ですか。","line_vi":"年少 là cái gì?","focus_words":["年少"]},{"speaker":"A","line_target":"广告牌です。","line_vi":"Đó là 广告牌.","focus_words":["广告牌"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_96bd18e3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「帆船」 có nghĩa là gì?","options":["thuyền buồm","trẻ","bảng quảng cáo","cà ri"],"answer_index":0,"explanation":"帆船 = thuyền buồm"},{"question":"Từ 「年少」 có nghĩa là gì?","options":["trẻ","thuyền buồm","bảng quảng cáo","cà ri"],"answer_index":0,"explanation":"年少 = trẻ"},{"question":"Từ 「广告牌」 có nghĩa là gì?","options":["bảng quảng cáo","thuyền buồm","trẻ","cà ri"],"answer_index":0,"explanation":"广告牌 = bảng quảng cáo"},{"question":"Từ 「库里」 có nghĩa là gì?","options":["cà ri","thuyền buồm","trẻ","bảng quảng cáo"],"answer_index":0,"explanation":"库里 = cà ri"},{"question":"Từ 「弗雷」 có nghĩa là gì?","options":["Frey","thuyền buồm","trẻ","bảng quảng cáo"],"answer_index":0,"explanation":"弗雷 = Frey"},{"question":"Từ 「张力」 có nghĩa là gì?","options":["Căng thẳng","thuyền buồm","trẻ","bảng quảng cáo"],"answer_index":0,"explanation":"张力 = Că