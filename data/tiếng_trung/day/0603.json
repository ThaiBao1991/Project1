_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c65dad8a","audio_ref":"m_236eb326","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_21d43082"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ ichidan (う-ending)","level":"N5","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書き","書か"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 603","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"混凝土を 使います。","line_vi":"Tôi dùng 混凝土.","focus_words":["混凝土"]},{"speaker":"B","line_target":"火力 は 何ですか。","line_vi":"火力 là cái gì?","focus_words":["火力"]},{"speaker":"A","line_target":"灰色です。","line_vi":"Đó là 灰色.","focus_words":["灰色"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d3a550a1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「混凝土」 có nghĩa là gì?","options":["bê tông","hỏa lực","màu xám","sống động"],"answer_index":0,"explanation":"混凝土 = bê tông"},{"question":"Từ 「火力」 có nghĩa là gì?","options":["hỏa lực","bê tông","màu xám","sống động"],"answer_index":0,"explanation":"火力 = hỏa lực"},{"question":"Từ 「灰色」 có nghĩa là gì?","options":["màu xám","bê tông","hỏa lực","sống động"],"answer_index":0,"explanation":"灰色 = màu xám"},{"question":"Từ 「热闹」 có nghĩa là gì?","options":["sống động","bê tông","hỏa lực","màu xám"],"answer_index":0,"explanation":"热闹 = sống động"},{"question":"Từ 「狂热」 có nghĩa là gì?","options":["sự cuồng tín","bê tông","hỏa lực","màu xám"],"answer_index":0,"explanation":"狂热 = sự cuồng tín"},{"question":"Từ 「猴子」 có nghĩa là gì?","options":["khỉ","bê tông","hỏa lực","màu xám"],"answer_index":0,"explanation":"猴子 = khỉ"},{"question":"Từ 「百分点」 có nghĩa là gì?","options":["điểm phần trăm","bê tông","hỏa lực","màu xám"],"answer_index":0,"explanation":"百分点 = điểm phần trăm"},{"question":"Từ 「省政府」 có nghĩa là gì?","options":["chính quyền cấp tỉnh","bê tông","hỏa lực","màu xám"],"answer_index":0,"expl