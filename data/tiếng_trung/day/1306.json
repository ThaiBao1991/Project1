_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_01b9a651","audio_ref":"m_e62a90b9","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_95a4ae15"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1306","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"四海を 使います。","line_vi":"Tôi dùng 四海.","focus_words":["四海"]},{"speaker":"B","line_target":"四百 は 何ですか。","line_vi":"四百 là cái gì?","focus_words":["四百"]},{"speaker":"A","line_target":"回乡です。","line_vi":"Đó là 回乡.","focus_words":["回乡"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_bc01e348","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「四海」 có nghĩa là gì?","options":["Trên toàn thế giới","bốn trăm","Trở về quê hương","bao vây"],"answer_index":0,"explanation":"四海 = Trên toàn thế giới"},{"question":"Từ 「四百」 có nghĩa là gì?","options":["bốn trăm","Trên toàn thế giới","Trở về quê hương","bao vây"],"answer_index":0,"explanation":"四百 = bốn trăm"},{"question":"Từ 「回乡」 có nghĩa là gì?","options":["Trở về quê hương","Trên toàn thế giới","bốn trăm","bao vây"],"answer_index":0,"explanation":"回乡 = Trở về quê hương"},{"question":"Từ 「围城」 có nghĩa là gì?","options":["bao vây","Trên toàn thế giới","bốn trăm","Trở về quê hương"],"answer_index":0,"explanation":"围城 = bao vây"},{"question":"Từ 「国境」 có nghĩa là gì?","options":["biên giới quốc gia","Trên toàn thế giới","bốn trăm","Trở về quê hương"],"answer_index":0,"explanation":"国境 = biên giới quốc gia"},{"question":"Từ 「坐落」 có nghĩa là gì?","options":["nằm","Trên toàn thế giới","bốn trăm","Trở về quê hương"],"answer_index":0,"explanation":"