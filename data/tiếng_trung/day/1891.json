n."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1891","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"大婶を 使います。","line_vi":"Tôi dùng 大婶.","focus_words":["大婶"]},{"speaker":"B","line_target":"大洲 は 何ですか。","line_vi":"大洲 là cái gì?","focus_words":["大洲"]},{"speaker":"A","line_target":"大病です。","line_vi":"Đó là 大病.","focus_words":["大病"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1230a124","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「大婶」 có nghĩa là gì?","options":["dì","lục địa","bệnh nặng","lúa mạch"],"answer_index":0,"explanation":"大婶 = dì"},{"question":"Từ 「大洲」 có nghĩa là gì?","options":["lục địa","dì","bệnh nặng","lúa mạch"],"answer_index":0,"explanation":"大洲 = lục địa"},{"question":"Từ 「大病」 có nghĩa là gì?","options":["bệnh nặng","dì","lục địa","lúa mạch"],"answer_index":0,"explanation":"大病 = bệnh nặng"},{"question":"Từ 「大麦」 có nghĩa là gì?","options":["lúa mạch","dì","lục địa","bệnh nặng"],"answer_index":0,"explanation":"大麦 = lúa mạch"},{"question":"Từ 「夫斯基」 có nghĩa là gì?","options":["vski","dì","lục địa","bệnh nặng"],"answer_index":0,"explanation":"夫斯基 = vski"},{"question":"Từ 「失忆」 có nghĩa là gì?","options":["chứng mất trí nhớ","dì","lục địa","bệnh nặng"],"answer_index":0,"explanation":"失忆 = chứng mất trí nhớ"},{"question":"Từ 「女团」 có nghĩa là gì?","options":["nhóm nhạc nữ","dì","lục địa","bệnh nặng"],"answer_index":0,"explanation":"女团 = nhóm nhạc nữ"},{"question":"Từ 「如其」 có nghĩa là gì?","options":["Như nó vốn có","dì","lục địa","bệnh nặng"],"answer_index":0,"explanation":"如其 = Như nó vốn có"}],"