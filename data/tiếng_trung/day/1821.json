ng)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1821","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"重症を 使います。","line_vi":"Tôi dùng 重症.","focus_words":["重症"]},{"speaker":"B","line_target":"金融中心 は 何ですか。","line_vi":"金融中心 là cái gì?","focus_words":["金融中心"]},{"speaker":"A","line_target":"钟头です。","line_vi":"Đó là 钟头.","focus_words":["钟头"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_22bc2969","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「重症」 có nghĩa là gì?","options":["nghiêm trọng","trung tâm tài chính","giờ","ngưỡng mộ"],"answer_index":0,"explanation":"重症 = nghiêm trọng"},{"question":"Từ 「金融中心」 có nghĩa là gì?","options":["trung tâm tài chính","nghiêm trọng","giờ","ngưỡng mộ"],"answer_index":0,"explanation":"金融中心 = trung tâm tài chính"},{"question":"Từ 「钟头」 có nghĩa là gì?","options":["giờ","nghiêm trọng","trung tâm tài chính","ngưỡng mộ"],"answer_index":0,"explanation":"钟头 = giờ"},{"question":"Từ 「钦佩」 có nghĩa là gì?","options":["ngưỡng mộ","nghiêm trọng","trung tâm tài chính","giờ"],"answer_index":0,"explanation":"钦佩 = ngưỡng mộ"},{"question":"Từ 「钻进」 có nghĩa là gì?","options":["khoan vào","nghiêm trọng","trung tâm tài chính","giờ"],"answer_index":0,"explanation":"钻进 = khoan vào"},{"question":"Từ 「铁矿」 có nghĩa là gì?","options":["quặng sắt","nghiêm