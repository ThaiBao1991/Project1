ọc sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1805","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"学报を 使います。","line_vi":"Tôi dùng 学报.","focus_words":["学报"]},{"speaker":"B","line_target":"学童 は 何ですか。","line_vi":"学童 là cái gì?","focus_words":["学童"]},{"speaker":"A","line_target":"守护神です。","line_vi":"Đó là 守护神.","focus_words":["守护神"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_834950c9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「学报」 có nghĩa là gì?","options":["tạp chí","học sinh","vị thánh bảo trợ","thanh thản"],"answer_index":0,"explanation":"学报 = tạp chí"},{"question":"Từ 「学童」 có nghĩa là gì?","options":["học sinh","tạp chí","vị thánh bảo trợ","thanh thản"],"answer_index":0,"explanation":"学童 = học sinh"},{"question":"Từ 「守护神」 có nghĩa là gì?","options":["vị thánh bảo trợ","tạp chí","học sinh","thanh thản"],"answer_index":0,"explanation":"守护神 = vị thánh bảo trợ"},{"question":"Từ 「安详」 có nghĩa là gì?","options":["thanh thản","tạp chí","học sinh","vị thánh bảo trợ"],"answer_index":0,"explanation":"安详 = thanh thản"},{"question":"Từ 「宝可梦」 có nghĩa là gì?","options":["Pokémon","tạp chí","học sinh","vị thánh bảo trợ"],"answer_index":0,"explanation":"宝可梦 = Pokémon"},{"question":"Từ 「富国」 có nghĩa là gì?","options":["đất nước giàu có","tạp chí","học sinh","vị thánh bảo trợ"],"answer_index":0,"explanation":"富国 = đất nước giàu có"},{"question":"Từ 「少不了」 có nghĩa là gì?","options":["không thể thiếu","tạp chí","học sinh","vị thánh bảo trợ"],"answer_index":0,"explanation":