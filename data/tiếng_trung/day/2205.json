i xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2205","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"计入を 使います。","line_vi":"Tôi dùng 计入.","focus_words":["计入"]},{"speaker":"B","line_target":"计票 は 何ですか。","line_vi":"计票 là cái gì?","focus_words":["计票"]},{"speaker":"A","line_target":"订定です。","line_vi":"Đó là 订定.","focus_words":["订定"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「计入」 có nghĩa là gì?","options":["được ghi có","Đếm phiếu bầu","quy định","nhớ"],"answer_index":0,"explanation":"计入 = được ghi có"},{"question":"Từ 「计票」 có nghĩa là gì?","options":["Đếm phiếu bầu","được ghi có","quy định","nhớ"],"answer_index":0,"explanation":"计票 = Đếm phiếu bầu"},{"question":"Từ 「订定」 có nghĩa là gì?","options":["quy định","được ghi có","Đếm phiếu bầu","nhớ"],"answer_index":0,"explanation":"订定 = quy định"},{"question":"Từ 「记念」 có nghĩa là gì?","options":["nhớ","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"记念 = nhớ"},{"question":"Từ 「话筒」 có nghĩa là gì?","options":["Micrô","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"话筒 = Micrô"},{"question":"Từ 「该处」 có nghĩa là gì?","options":["nơi","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"该处 = nơi"},{"question":"Từ 「详述」 có nghĩa là gì?","options":["xây dựng","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"详述 = xây dựng"},{"question":"Từ 「诸岛」 có nghĩa là gì?","options":["hòn đảo","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"诸岛 = hòn đảo"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: được ghi có","options":["计入","计票","订定","记念"],"answer_index":0,"explanation":"计入 = được ghi có"},{"question":"Chọn từ đúng cho nghĩa: Đếm phiếu bầu","options":["计票","计入","订定","记念"],"answer_index":0,"explanation":"计票 = Đếm phiếu bầu"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{},"dialogue_audio":{}},"me