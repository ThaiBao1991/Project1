ọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2205","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"计入を 使います。","line_vi":"Tôi dùng 计入.","focus_words":["计入"]},{"speaker":"B","line_target":"计票 は 何ですか。","line_vi":"计票 là cái gì?","focus_words":["计票"]},{"speaker":"A","line_target":"订定です。","line_vi":"Đó là 订定.","focus_words":["订定"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b17ac285","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「计入」 có nghĩa là gì?","options":["được ghi có","Đếm phiếu bầu","quy định","nhớ"],"answer_index":0,"explanation":"计入 = được ghi có"},{"question":"Từ 「计票」 có nghĩa là gì?","options":["Đếm phiếu bầu","được ghi có","quy định","nhớ"],"answer_index":0,"explanation":"计票 = Đếm phiếu bầu"},{"question":"Từ 「订定」 có nghĩa là gì?","options":["quy định","được ghi có","Đếm phiếu bầu","nhớ"],"answer_index":0,"explanation":"订定 = quy định"},{"question":"Từ 「记念」 có nghĩa là gì?","options":["nhớ","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"记念 = nhớ"},{"question":"Từ 「话筒」 có nghĩa là gì?","options":["Micrô","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"话筒 = Micrô"},{"question":"Từ 「该处」 có nghĩa là gì?","options":["nơi","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"该处 = nơi"},{"question":"Từ 「详述」 có nghĩa là gì?","options":["xây dựng","được ghi có","Đếm phiếu bầu","quy định"],"answer_index":0,"explanation":"详述 = xây dựng"},{"question":"Từ 「诸岛」 có nghĩa là gì?","