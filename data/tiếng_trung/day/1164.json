ence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1164","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"无可を 使います。","line_vi":"Tôi dùng 无可.","focus_words":["无可"]},{"speaker":"B","line_target":"无异 は 何ですか。","line_vi":"无异 là cái gì?","focus_words":["无异"]},{"speaker":"A","line_target":"无数次です。","line_vi":"Đó là 无数次.","focus_words":["无数次"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「无可」 có nghĩa là gì?","options":["không có gì","Không khác gì","vô số lần","Có khả năng hơn"],"answer_index":0,"explanation":"无可 = không có gì"},{"question":"Từ 「无异」 có nghĩa là gì?","options":["Không khác gì","không có gì","vô số lần","Có khả năng hơn"],"answer_index":0,"explanation":"无异 = Không khác gì"},{"question":"Từ 「无数次」 có nghĩa là gì?","options":["vô số lần","không có gì","Không khác gì","Có khả năng hơn"],"answer_index":0,"explanation":"无数次 = vô số lần"},{"question":"Từ 「更能」 có nghĩa là gì?","options":["Có khả năng hơn","không có gì","Không khác gì","vô số lần"],"answer_index":0,"explanation":"更能 = Có khả năng hơn"},{"question":"Từ 「曾多次」 có nghĩa là gì?","options":["nhiều lần","không có gì","Không khác gì","vô số lần"],"answer_index":0,"explanation":"曾多次 = nhiều lần"},{"question":"Từ 「最高人民法院」 có nghĩa là gì?","options":["Tòa án nhân dân tối cao","không có gì","Không khác gì","vô số lần"],"answer_index":0,"explanation":"最高人民法院 = Tòa án nhân dân tối cao"},{"question":"Từ 「有心」 có nghĩa là gì?","options":["cố ý","không có gì","Không khác gì","vô số lần"],"answer_index":0,"explanation":"有心 = cố ý"},{"question":"Từ 「有效期」 có nghĩa là gì?","options":["Thời hạn hiệu lực","không có gì","Không khác gì","vô số lần"],"answer_index":0,"explanation":"有效期 = Thời hạn hiệu lực"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: không có gì","options":["无可","无异","无数次","更能"],"answer_index":0,"explanation":"无可 = không có gì"},{"question":"Chọn t