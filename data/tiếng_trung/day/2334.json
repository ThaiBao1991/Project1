_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6cf2fd81","audio_ref":"m_c5de0c55","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_daa75f29"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Dạng nối 〜て","level":"N3","explanation":"Dạng te nối hai động từ: 書いて + 読む; cũng dùng cho lý do nhẹ (寒くて…).","examples":[{"sentence":"手紙を書いて、本を読みます。","meaning_vi":"Tôi viết thư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]},{"title":"Từ chỉ người (の)","level":"N3","explanation":"の + danh từ: 友達の母 = mẹ của bạn.","examples":[{"sentence":"友達の家に行きます。","meaning_vi":"Tôi đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]},{"title":"Quá khứ xa (〜た)","level":"N3","explanation":"Ngữ cảnh quá khứ: 子供の時に、学校に通っていました.","examples":[{"sentence":"子供の頃、学校に通っていました。","meaning_vi":"Thời thơ ấy tôi có đi học tiểu học."},{"sentence":"昔 orphans に行きました。","meaning_vi":"Ngày xưa tôi đã từng đi."}],"pronunciation_focus":"Dạng ます quá khứ = quá khứ xa.","common_mistakes":"Không dùng 〜た trong ngữ cảnh hiện tại.","mini_quiz":[{"question":"子供の頃、学校に___。","options":["通っていました","通ります","通って"],"answer_index":0,"explanation":"Đáp án: 通っていました"}],"references":[]},{"title":"So sánh mức độ (〜より)","level":"N2","explanation":"Câu so sánh: 大阪より大阪のほうが大きい.","examples":[{"sentence":"大阪のほうが大きいです。","meaning_vi":"Osaka lớn hơn."},{"sentence":"月曜日より土曜日の方が楽しい。","meaning_vi":"Thứ Bảy vui hơn thứ Hai."}],"pronunciation_focus":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2334","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"慌张を 使います。","line_vi":"Tôi dùng 慌张.","focus_words":["慌张"]},{"speaker":"B","line_target":"成套 は 何ですか。","line_vi":"成套 là cái gì?","focus_words":["成套"]},{"speaker":"A","line_target":"打拼です。","line_vi":"Đó là 打拼.","focus_words":["打拼"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5a90eac4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「慌张」 có nghĩa là gì?","options":["hoảng loạn","Bộ hoàn chỉnh","làm việc chăm chỉ","giữ"],"answer_index":0,"explanation":"慌张 = hoảng loạn"},{"question":"Từ 「成套」 có nghĩa là gì?","options":["Bộ hoàn chỉnh","hoảng loạn","làm việc chăm chỉ","giữ"],"answer_index":0,"explanation":"成套 = Bộ hoàn chỉnh"},{"question":"Từ 「打拼」 có nghĩa là gì?","options":["làm việc chăm chỉ","hoảng loạn","Bộ hoàn chỉnh","giữ"],"answer_index":0,"explanation":"打拼 = làm việc chăm chỉ"},{"question":"Từ 「抱持」 có nghĩa là gì?","options":["giữ","hoảng loạn","Bộ hoàn chỉnh","làm việc chăm chỉ"],"answer_index":0,"explanation":"抱持 = giữ"},{"question":"Từ 「拍手」 có nghĩa là gì?","options":["vỗ tay","hoảng loạn","Bộ hoàn chỉnh","làm việc chăm chỉ"],"answer_index":0,"explanation":"拍手 = vỗ tay"},{"question":"Từ 「拳击手」 có nghĩa là gì?","options":["võ sĩ quyền anh","hoảng loạn","Bộ hoàn chỉnh","làm việc chăm chỉ"],"answer_index":0,"explanation":"拳击手 = võ sĩ quyền anh"},{"question":"Từ 「挂念」 có nghĩa là gì?","options":["nhớ em","hoảng loạn","Bộ hoàn chỉnh","làm việc chăm chỉ"],"answer_index":0,"explanation":"挂念