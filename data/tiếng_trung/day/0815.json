y nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 815","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"区块を 使います。","line_vi":"Tôi dùng 区块.","focus_words":["区块"]},{"speaker":"B","line_target":"南美洲 は 何ですか。","line_vi":"南美洲 là cái gì?","focus_words":["南美洲"]},{"speaker":"A","line_target":"印发です。","line_vi":"Đó là 印发.","focus_words":["印发"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9566666b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「区块」 có nghĩa là gì?","options":["khối","Nam Mỹ","In và phân phối","nguyên đơn"],"answer_index":0,"explanation":"区块 = khối"},{"question":"Từ 「南美洲」 có nghĩa là gì?","options":["Nam Mỹ","khối","In và phân phối","nguyên đơn"],"answer_index":0,"explanation":"南美洲 = Nam Mỹ"},{"question":"Từ 「印发」 có nghĩa là gì?","options":["In và phân phối","khối","Nam Mỹ","nguyên đơn"],"answer_index":0,"explanation":"印发 = In và phân phối"},{"question":"Từ 「原告」 có nghĩa là gì?","options":["nguyên đơn","khối","Nam Mỹ","In và phân phối"],"answer_index":0,"explanation":"原告 = nguyên đơn"},{"question":"Từ 「发烧」 có nghĩa là gì?","options":["sốt","khối","Nam Mỹ","In và phân phối"],"answer_index":0,"explanation":"发烧 = sốt"},{"question":"Từ 「可耻」 có nghĩa là gì?","options":["đáng xấu hổ","khối","Nam Mỹ","In và phân phối"],"answer_index":0,"explanation":"可耻 = đáng xấu hổ"},{"question":"Từ 「司法部」 có nghĩa là gì?","options":["Bộ Tư pháp","khối","Nam Mỹ","In và phân phối"],"answer_index":0,"explanation":"司法部 = Bộ Tư pháp"},{"question":"Từ 「响起」 có nghĩa là gì?","options":["Nhẫn","khối","Nam Mỹ","In và phân phối"],"ans