le_target":"","example_vi":"","image_prompt":null,"image_ref":"m_c18555e0","audio_ref":"m_988db163","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_a72f2ab6"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 975","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"游艇を 使います。","line_vi":"Tôi dùng 游艇.","focus_words":["游艇"]},{"speaker":"B","line_target":"激素 は 何ですか。","line_vi":"激素 là cái gì?","focus_words":["激素"]},{"speaker":"A","line_target":"火锅です。","line_vi":"Đó là 火锅.","focus_words":["火锅"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_05a2a441","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「游艇」 có nghĩa là gì?","options":["du thuyền","hormone","Lẩu","cường điệu"],"answer_index":0,"explanation":"游艇 = du thuyền"},{"question":"Từ 「激素」 có nghĩa là gì?","options":["hormone","du thuyền","Lẩu","cường điệu"],"answer_index":0,"explanation":"激素 = hormone"},{"question":"Từ 「火锅」 có nghĩa là gì?","options":["Lẩu","du thuyền","hormone","cường điệu"],"answer_index":0,"explanation":"火锅 = Lẩu"},{"question":"Từ 「炒作」 có nghĩa là gì?","options":["cường điệu","du thuyền","hormone","Lẩu"],"answer_index":0,"explanation":"炒作 = cường điệu"},{"question":"Từ 「牌照」 có nghĩa là gì?","options":["biển số xe","du thuyền","hormone","Lẩu"],"answer_index":0,"explanation":"牌照 = biển số xe"},{"question":"Từ 「特级」 có nghĩa là gì?","options":["Lớp đặc biệt","du thuyền","hormone","Lẩu"],"answer_index":0,"explanation":"特级 = Lớp đặc biệt"},{"question":"Từ 「番茄」 có nghĩa là gì?","options":["cà chua","du thuyền","hormone","Lẩu"],"answer_index":0,"explanation":"番茄 = cà chua"},{"question":"Từ 「真话」 có nghĩa là gì?","options":["sự thật","du thuyền","hormone","Lẩu"],"answer_index":0,"explanation":"真话 = sự thật"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa