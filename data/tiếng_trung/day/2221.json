_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_eded716a","audio_ref":"m_eec2a8d6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_09152796"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2221","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"删掉を 使います。","line_vi":"Tôi dùng 删掉.","focus_words":["删掉"]},{"speaker":"B","line_target":"利润率 は 何ですか。","line_vi":"利润率 là cái gì?","focus_words":["利润率"]},{"speaker":"A","line_target":"别用です。","line_vi":"Đó là 别用.","focus_words":["别用"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9bb1b837","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「删掉」 có nghĩa là gì?","options":["xóa","tỷ suất lợi nhuận","Đừng sử dụng nó","bản đồ học"],"answer_index":0,"explanation":"删掉 = xóa"},{"question":"Từ 「利润率」 có nghĩa là gì?","options":["tỷ suất lợi nhuận","xóa","Đừng sử dụng nó","bản đồ học"],"answer_index":0,"explanation":"利润率 = tỷ suất lợi nhuận"},{"question":"Từ 「别用」 có nghĩa là gì?","options":["Đừng sử dụng nó","xóa","tỷ suất lợi nhuận","bản đồ học"],"answer_index":0,"explanation":"别用 = Đừng sử dụng nó"},{"question":"Từ 「制图」 có nghĩa là gì?","options":["bản đồ học","xóa","tỷ suất lợi nhuận","Đừng sử dụng nó"],"answer_index":0,"explanation":"制图 = bản đồ học"},{"question":"Từ 「加蓬」 có nghĩa là gì?","options":["Gabon","xóa","tỷ suất lợi nhuận","Đừng sử dụng nó"],"answer_index":0,"explanation":"加蓬 = Gabon"},{"question":"Từ 「勒令」 có nghĩa là gì?","options":["đặt hàng","xóa","tỷ suất lợi nhuận","Đừng sử dụng nó"],"answer_index":0,"explanation":"勒令 = đặt hàng"},{"question":"Từ 「十二岁」 có nghĩa là gì?","options":["mười hai tuổi","xóa","tỷ suất lợi nhuận","Đừng sử dụng nó"],"answe