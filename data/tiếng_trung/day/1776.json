i đến nhà bạn."},{"sentence":"日本語の先生です。","meaning_vi":"Đây là giáo viên tiếng Nhật."}],"pronunciation_focus":"の là trợ từ sở hữu.","common_mistakes":"Đừng dùng の sau danh từ chỉ người khi quan hệ sở hữu rõ.","mini_quiz":[{"question":"友達___家です。","options":["の","は","を"],"answer_index":0,"explanation":"Đáp án: の"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1776","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"坚韧を 使います。","line_vi":"Tôi dùng 坚韧.","focus_words":["坚韧"]},{"speaker":"B","line_target":"城南 は 何ですか。","line_vi":"城南 là cái gì?","focus_words":["城南"]},{"speaker":"A","line_target":"基座です。","line_vi":"Đó là 基座.","focus_words":["基座"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_20be51d0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「坚韧」 có nghĩa là gì?","options":["sự kiên trì","Phía nam thành phố","căn cứ","tình huống"],"answer_index":0,"explanation":"坚韧 = sự kiên trì"},{"question":"Từ 「城南」 có nghĩa là gì?","options":["Phía nam thành phố","sự kiên trì","căn cứ","tình huống"],"answer_index":0,"explanation":"城南 = Phía nam thành phố"},{"question":"Từ 「基座」 có nghĩa là gì?","options":["căn cứ","sự kiên trì","Phía nam thành phố","tình huống"],"answer_index":0,"explanation":"基座 = căn cứ"},{"question":"Từ 「境况」 có nghĩa là gì?","options":["tình huống","sự kiên trì","Phía nam thành phố","căn cứ"],"answer_index":0,"explanation":"境况 = tình huống"},{"question":"Từ 「增高」 có nghĩa là gì?","options":["tăng chiều cao","sự kiên trì","Phía nam thành phố","căn cứ"],"answer_index":0,"explanation":"增高 = tăng chiều cao"},{"question":"Từ 「外边」 có nghĩa là gì?","options":["bên ngoài","sự kiên trì","Phía nam thành phố","căn cứ"],"answer_index":0,"explanation":"外边 = bên ngoài"},{"question":"Từ 「多米」 có nghĩa là gì?","options":["Nhà Domi","sự kiên t