meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_71182546","audio_ref":"m_8e13a261","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_52553a89"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2295","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"基斯を 使います。","line_vi":"Tôi dùng 基斯.","focus_words":["基斯"]},{"speaker":"B","line_target":"声讨 は 何ですか。","line_vi":"声讨 là cái gì?","focus_words":["声讨"]},{"speaker":"A","line_target":"多层次です。","line_vi":"Đó là 多层次.","focus_words":["多层次"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_973ab333","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「基斯」 có nghĩa là gì?","options":["Keith","tố cáo","đa cấp","phong cách khác nhau"],"answer_index":0,"explanation":"基斯 = Keith"},{"question":"Từ 「声讨」 có nghĩa là gì?","options":["tố cáo","Keith","đa cấp","phong cách khác nhau"],"answer_index":0,"explanation":"声讨 = tố cáo"},{"question":"Từ 「多层次」 có nghĩa là gì?","options":["đa cấp","Keith","tố cáo","phong cách khác nhau"],"answer_index":0,"explanation":"多层次 = đa cấp"},{"question":"Từ 「多款」 có nghĩa là gì?","options":["phong cách khác nhau","Keith","tố cáo","đa cấp"],"answer_index":0,"explanation":"多款 = phong cách khác nhau"},{"question":"Từ 「大提琴」 có nghĩa là gì?","options":["Cello","Keith","tố cáo","đa cấp"],"answer_index":0,"explanation":"大提琴 = Cello"},{"question":"Từ 「天赐」 có nghĩa là gì?","options":["Món quà của Chúa","Keith","tố cáo","đa cấp"],"answer_index":0,"explanation":"天赐 = Món quà của Chúa"},{"question":"Từ 「太平洋战争」 có nghĩa là gì?","options":["chiến tranh Thái Bình Dương","Keith","tố cáo","đa cấp"],"answer_index":0,"explanation":"太平洋战争 = chiến tranh Thái Bình Dương"},{"question":"Từ 「太早」 có nghĩa là gì?","opti