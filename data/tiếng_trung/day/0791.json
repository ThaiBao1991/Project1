aning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_309d35d4","audio_ref":"m_8624d3f3","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d1f3d275"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 791","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"拼音を 使います。","line_vi":"Tôi dùng 拼音.","focus_words":["拼音"]},{"speaker":"B","line_target":"接种 は 何ですか。","line_vi":"接种 là cái gì?","focus_words":["接种"]},{"speaker":"A","line_target":"搭载です。","line_vi":"Đó là 搭载.","focus_words":["搭载"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_84e376f0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「拼音」 có nghĩa là gì?","options":["bính âm","tiêm chủng","mang theo","Ma-rốc"],"answer_index":0,"explanation":"拼音 = bính âm"},{"question":"Từ 「接种」 có nghĩa là gì?","options":["tiêm chủng","bính âm","mang theo","Ma-rốc"],"answer_index":0,"explanation":"接种 = tiêm chủng"},{"question":"Từ 「搭载」 có nghĩa là gì?","options":["mang theo","bính âm","tiêm chủng","Ma-rốc"],"answer_index":0,"explanation":"搭载 = mang theo"},{"question":"Từ 「摩洛哥」 có nghĩa là gì?","options":["Ma-rốc","bính âm","tiêm chủng","mang theo"],"answer_index":0,"explanation":"摩洛哥 = Ma-rốc"},{"question":"Từ 「政委」 có nghĩa là gì?","options":["chính ủy","bính âm","tiêm chủng","mang theo"],"answer_index":0,"explanation":"政委 = chính ủy"},{"question":"Từ 「政府部门」 có nghĩa là gì?","options":["các cơ quan chính phủ","bính âm","tiêm chủng","mang theo"],"answer_index":0,"explanation":"政府部门 = các cơ quan chính phủ"},{"question":"Từ 「教程」 có nghĩa là gì?","options":["Hướng dẫn","bính âm","tiêm chủng","mang theo"],"answer_index":0,"explanation":"教程 = Hướng dẫn"},{"question":"Từ 「文中」 có nghĩa là gì?","options":["trong văn bản"