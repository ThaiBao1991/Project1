mple_target":"","example_vi":"","image_prompt":null,"image_ref":"m_9644bb39","audio_ref":"m_bda31bfd","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d7a030ed"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Thì quá khứ ました (mashita)","level":"N5","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2229","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"录得を 使います。","line_vi":"Tôi dùng 录得.","focus_words":["录得"]},{"speaker":"B","line_target":"彻夜 は 何ですか。","line_vi":"彻夜 là cái gì?","focus_words":["彻夜"]},{"speaker":"A","line_target":"征途です。","line_vi":"Đó là 征途.","focus_words":["征途"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_75aa76f7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「录得」 có nghĩa là gì?","options":["ghi lại","cả đêm","Hành trình","Số lượng dấu vết"],"answer_index":0,"explanation":"录得 = ghi lại"},{"question":"Từ 「彻夜」 có nghĩa là gì?","options":["cả đêm","ghi lại","Hành trình","Số lượng dấu vết"],"answer_index":0,"explanation":"彻夜 = cả đêm"},{"question":"Từ 「征途」 có nghĩa là gì?","options":["Hành trình","ghi lại","cả đêm","Số lượng dấu vết"],"answer_index":0,"explanation":"征途 = Hành trình"},{"question":"Từ 「微量」 có nghĩa là gì?","options":["Số lượng dấu vết","ghi lại","cả đêm","Hành trình"],"answer_index":0,"explanation":"微量 = Số lượng dấu vết"},{"question":"Từ 「志向」 có nghĩa là gì?","options":["tham vọng","ghi lại","cả đêm","Hành trình"],"answer_index":0,"explanation":"志向 = tham vọng"},{"question":"Từ 「性状」 có nghĩa là gì?","options":["đặc điểm","ghi lại","cả đêm","Hành trình"],"answer_index":0,"explanation":"性状 = đặc điểm"},{"question":"Từ 「恩斯」 có nghĩa là gì?","options":["Vâng","ghi lại","cả đêm","Hành trình"],"answer_index":0,"explanation":"恩斯 = Vâng"},{