ion":"tủy sống","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a6fa46c2","audio_ref":"m_38b256e9","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_e40c67cb"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]},{"title":"Trợ từ に (ni) — nơi chốn / đích","level":"N5","explanation":"に chỉ nơi đến hoặc thời điểm; cũng dùng với 友達・家族.","examples":[{"sentence":"学校に行きます。","meaning_vi":"Tôi đi trường."},{"sentence":"六時に起きます。","meaning_vi":"Tôi dậy lúc 6 giờ."}],"pronunciation_focus":"に đọc 'ni'.","common_mistakes":"Ở nơi bạn đang ở (động từ) phải dùng に + verb te iru.","mini_quiz":[{"question":"___ に行きます。","options":["学校","私","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2025","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"红茶を 使います。","line_vi":"Tôi dùng 红茶.","focus_words":["红茶"]},{"speaker":"B","line_target":"纪年 は 何ですか。","line_vi":"纪年 là cái gì?","focus_words":["纪年"]},{"speaker":"A","line_target":"纯情です。","line_vi":"Đó là 纯情.","focus_words":["纯情"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5508ee4b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「红茶」 có nghĩa là gì?","options":["trà đen","Niên đại","tình yêu thuần khiết","Kỳ thi thống nhất"],"answer_index":0,"explanation":"红茶 = trà đen"},{"question":"Từ 「纪年」 có nghĩa là gì?","options":["Niên đại","trà đen","tình yêu thuần khiết","Kỳ thi thống nhất"],"answer_index":0,"explanation":"纪年 = Niên đại"},{"question":"Từ 「纯情」 có nghĩa là gì?","options":["tình yêu thuần khiết","trà đen","Niên đại","Kỳ thi thống nhất"],"answer_index":0,"explanation":"纯情 = tình yêu thuần khiết"},{"question":"Từ 「统考」 có nghĩa là gì?","options":["Kỳ thi thống nhất","trà đen","Niên đại","tình yêu thuần khiết"],"answer_index":0,"explanation":"统考 = Kỳ thi thống nhất"},{"question":"Từ 「罂粟」 có nghĩa là gì?","options":["cây thuốc phiện","trà đen","Niên đại","tình yêu thuần khiết"],"answer_index":0,"explanation":"罂粟 = cây thuốc phiện"},{"question":"Từ 「美国国防部」 có nghĩa là gì?","options":["Bộ Quốc phòng Hoa Kỳ","trà đen","Niên đại","tình yêu thuần khiết"],"answer_index":0,"ex