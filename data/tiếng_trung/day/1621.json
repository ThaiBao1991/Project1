":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1321a473","audio_ref":"m_d1e69b2e","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_0c98304a"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜ばかり","level":"N2","explanation":"〜ばかり = cứ toàn làm: 毎日ゲームばかり.","examples":[{"sentence":"毎日ゲームばかりです。","meaning_vi":"Ngày nào cũng chỉ chơi game."},{"sentence":"何も食べないばかりの生活。","meaning_vi":"Cuộc sống chỉ biết không ăn gì."}],"pronunciation_focus":"〜ばかり = cứ toàn làm.","common_mistakes":"Đừng dùng ばかり với số lượng lớn (⇒ たくさん).","mini_quiz":[{"question":"毎日ゲーム___。","options":["ばかり","だけ","しか"],"answer_index":0,"explanation":"Đáp án: ばかり"}],"references":[]},{"title":"Cấu trúc 〜とおり","level":"N2","explanation":"〜とおり = như, theo như: 先生のとおりです.","examples":[{"sentence":"先生のとおりです。","meaning_vi":"Đúng như thầy nói."},{"sentence":"指示のとおりしてください。","meaning_vi":"Xin làm đúng theo chỉ dẫn."}],"pronunciation_focus":"〜とおり = theo (cách nói).","common_mistakes":"Đừng dùng どおり khi nói về tương lai.","mini_quiz":[{"question":"先生の___にやります。","options":["とおり","ために","ながら"],"answer_index":0,"explanation":"Đáp án: とおり"}],"references":[]},{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"