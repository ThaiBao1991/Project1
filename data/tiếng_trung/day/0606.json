:"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b2138404","audio_ref":"m_365a6b0d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_ba76eab8"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 606","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"陪伴を 使います。","line_vi":"Tôi dùng 陪伴.","focus_words":["陪伴"]},{"speaker":"B","line_target":"雕像 は 何ですか。","line_vi":"雕像 là cái gì?","focus_words":["雕像"]},{"speaker":"A","line_target":"雕塑です。","line_vi":"Đó là 雕塑.","focus_words":["雕塑"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d22990c0","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「陪伴」 có nghĩa là gì?","options":["đi cùng","bức tượng","điêu khắc","Rung"],"answer_index":0,"explanation":"陪伴 = đi cùng"},{"question":"Từ 「雕像」 có nghĩa là gì?","options":["bức tượng","đi cùng","điêu khắc","Rung"],"answer_index":0,"explanation":"雕像 = bức tượng"},{"question":"Từ 「雕塑」 có nghĩa là gì?","options":["điêu khắc","đi cùng","bức tượng","Rung"],"answer_index":0,"explanation":"雕塑 = điêu khắc"},{"question":"Từ 「震动」 có nghĩa là gì?","options":["Rung","đi cùng","bức tượng","điêu khắc"],"answer_index":0,"explanation":"震动 = Rung"},{"question":"Từ 「饥饿」 có nghĩa là gì?","options":["đói bụng","đi cùng","bức tượng","điêu khắc"],"answer_index":0,"explanation":"饥饿 = đói bụng"},{"question":"Từ 「香烟」 có nghĩa là gì?","options":["thuốc lá","đi cùng","bức tượng","điêu khắc"],"answer_index":0,"explanation":"香烟 = thuốc lá"},{"question":"Từ 「international」 có nghĩa là gì?","options":["quốc tế","đi cùng","bức tượng","điêu khắc"],"answer_index":0,"explanation":"international = quốc tế"},{"question":"Từ 「一千」 có nghĩa là gì?","options":["một nghìn","đi cùng","bức tượng","điêu khắc"],"answer_index":0,"explanation":"一千 = một nghìn"}],"p