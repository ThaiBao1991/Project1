iation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1375","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"北伐を 使います。","line_vi":"Tôi dùng 北伐.","focus_words":["北伐"]},{"speaker":"B","line_target":"区委 は 何ですか。","line_vi":"区委 là cái gì?","focus_words":["区委"]},{"speaker":"A","line_target":"十日です。","line_vi":"Đó là 十日.","focus_words":["十日"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_42d3b668","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「北伐」 có nghĩa là gì?","options":["Bắc phạt","Ủy ban huyện","mười ngày","nửa vầng trăng"],"answer_index":0,"explanation":"北伐 = Bắc phạt"},{"question":"Từ 「区委」 có nghĩa là gì?","options":["Ủy ban huyện","Bắc phạt","mười ngày","nửa vầng trăng"],"answer_index":0,"explanation":"区委 = Ủy ban huyện"},{"question":"Từ 「十日」 có nghĩa là gì?","options":["mười ngày","Bắc phạt","Ủy ban huyện","nửa vầng trăng"],"answer_index":0,"explanation":"十日 = mười ngày"},{"question":"Từ 「半月」 có nghĩa là gì?","options":["nửa vầng trăng","Bắc phạt","Ủy ban huyện","mười ngày"],"answer_index":0,"explanation":"半月 = nửa vầng trăng"},{"question":"Từ 「华山」 có nghĩa là gì?","options":["Hoa Sơn","Bắc phạt","Ủy ban huyện","mười ngày"],"answer_index":0,"explanation":"华山 = Hoa Sơn"},{"question":"Từ 「华府」 có nghĩa là gì?","options":["Washington","Bắc phạt","Ủy ban huyện","mười ngày"],"answer_index":0,"explanation":"华府 = Washington"},{"question":"Từ 「卫士」 có nghĩa là gì?","options":["canh gác","Bắc phạt","Ủy ban huyện","mười ngày"],"answer_index":0,"explanation":"卫士 = canh gác"},{"question":"Từ 「各人」 có nghĩa là gì?","options