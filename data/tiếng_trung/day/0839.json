ông đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 839","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"蒸汽を 使います。","line_vi":"Tôi dùng 蒸汽.","focus_words":["蒸汽"]},{"speaker":"B","line_target":"薄弱 は 何ですか。","line_vi":"薄弱 là cái gì?","focus_words":["薄弱"]},{"speaker":"A","line_target":"藉口です。","line_vi":"Đó là 藉口.","focus_words":["藉口"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5c4308c3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「蒸汽」 có nghĩa là gì?","options":["hơi nước","yếu đuối","xin lỗi","sa thải"],"answer_index":0,"explanation":"蒸汽 = hơi nước"},{"question":"Từ 「薄弱」 có nghĩa là gì?","options":["yếu đuối","hơi nước","xin lỗi","sa thải"],"answer_index":0,"explanation":"薄弱 = yếu đuối"},{"question":"Từ 「藉口」 có nghĩa là gì?","options":["xin lỗi","hơi nước","yếu đuối","sa thải"],"answer_index":0,"explanation":"藉口 = xin lỗi"},{"question":"Từ 「裁员」 có nghĩa là gì?","options":["sa thải","hơi nước","yếu đuối","xin lỗi"],"answer_index":0,"explanation":"裁员 = sa thải"},{"question":"Từ 「装有」 có nghĩa là gì?","options":["được trang bị","hơi nước","yếu đuối","xin lỗi"],"answer_index":0,"explanation":"装有 = được trang bị"},{"question":"Từ 「要不然」 có nghĩa là gì?","options":["Nếu không","hơi nước","yếu đuối","xin lỗi"],"answer_index":0,"explanation":"要不然 = Nếu không"},{"question":"Từ 「试试看」 có nghĩa là gì?","options":["thử nó","hơi nước","yếu đuối","xin lỗi"],"answer_index":0,"explanation":"试试看 = thử nó"},{"question":"Từ 「诱人」 có nghĩa l