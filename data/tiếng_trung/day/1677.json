":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Kể về việc vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1677","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"贴切を 使います。","line_vi":"Tôi dùng 贴切.","focus_words":["贴切"]},{"speaker":"B","line_target":"费力 は 何ですか。","line_vi":"费力 là cái gì?","focus_words":["费力"]},{"speaker":"A","line_target":"赞叹です。","line_vi":"Đó là 赞叹.","focus_words":["赞叹"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9e216444","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「贴切」 có nghĩa là gì?","options":["Thích hợp","vất vả","ngưỡng mộ","Đến Hoa Kỳ"],"answer_index":0,"explanation":"贴切 = Thích hợp"},{"question":"Từ 「费力」 có nghĩa là gì?","options":["vất vả","Thích hợp","ngưỡng mộ","Đến Hoa Kỳ"],"answer_index":0,"explanation":"费力 = vất vả"},{"question":"Từ 「赞叹」 có nghĩa là gì?","options":["ngưỡng mộ","Thích hợp","vất vả","Đến Hoa Kỳ"],"answer_index":0,"explanation":"赞叹 = ngưỡng mộ"},{"question":"Từ 「赴美」 có nghĩa là gì?","options":["Đến Hoa Kỳ","Thích hợp","vất vả","ngưỡng mộ"],"answer_index":0,"explanation":"赴美 = Đến Hoa Kỳ"},{"question":"Từ 「起始」 có nghĩa là gì?","options":["bắt đầu","Thích hợp","vất vả","ngưỡng mộ"],"answer_index":0,"explanation":"起始 = bắt đầu"},{"question":"Từ 「超乎」 có nghĩa là gì?","options":["Ngoài ra","Thích hợp","vất vả","ngưỡng mộ"],"answer_index":0,"explanation":"超乎 = Ngoài ra"},{"question":"Từ 「车窗」 có nghĩa là gì?","options":["cửa sổ xe hơi","Thích hợp","vất vả","ngưỡng mộ"],"answer_index":0,"explan