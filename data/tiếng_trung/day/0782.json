ion_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 782","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"野外を 使います。","line_vi":"Tôi dùng 野外.","focus_words":["野外"]},{"speaker":"B","line_target":"金字塔 は 何ですか。","line_vi":"金字塔 là cái gì?","focus_words":["金字塔"]},{"speaker":"A","line_target":"镇上です。","line_vi":"Đó là 镇上.","focus_words":["镇上"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_79a15ed5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「野外」 có nghĩa là gì?","options":["hoang dã","kim tự tháp","thị trấn","sân"],"answer_index":0,"explanation":"野外 = hoang dã"},{"question":"Từ 「金字塔」 có nghĩa là gì?","options":["kim tự tháp","hoang dã","thị trấn","sân"],"answer_index":0,"explanation":"金字塔 = kim tự tháp"},{"question":"Từ 「镇上」 có nghĩa là gì?","options":["thị trấn","hoang dã","kim tự tháp","sân"],"answer_index":0,"explanation":"镇上 = thị trấn"},{"question":"Từ 「院子」 có nghĩa là gì?","options":["sân","hoang dã","kim tự tháp","thị trấn"],"answer_index":0,"explanation":"院子 = sân"},{"question":"Từ 「顾虑」 có nghĩa là gì?","options":["mối quan tâm","hoang dã","kim tự tháp","thị trấn"],"answer_index":0,"explanation":"顾虑 = mối quan tâm"},{"question":"Từ 「颁奖」 có nghĩa là gì?","options":["Giải thưởng","hoang dã","kim tự tháp","thị trấn"],"answer_index":0,"explanation":"颁奖 = Giải thưởng"},{"question":"Từ 「饥荒」 có nghĩa là gì?","options":["nạn đói","hoang dã","kim tự tháp","thị trấn"],"answer_index":0,"explanation":"饥荒 = nạn đói"},{"question":"Từ 「驾车」 có nghĩa là gì?","options":["lái xe","hoang dã","kim tự tháp","thị trấn"],"answer_in