":"〜より = hơn; 〜のほうが = nhấn mạnh.","common_mistakes":"Đừng dùng より với người/thời gian (⇒ より前に).","mini_quiz":[{"question":"大阪は東京___大きい。","options":["より","を","に"],"answer_index":0,"explanation":"Đáp án: より"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1783","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"比照を 使います。","line_vi":"Tôi dùng 比照.","focus_words":["比照"]},{"speaker":"B","line_target":"永福 は 何ですか。","line_vi":"永福 là cái gì?","focus_words":["永福"]},{"speaker":"A","line_target":"江河です。","line_vi":"Đó là 江河.","focus_words":["江河"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ad4ac21e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「比照」 có nghĩa là gì?","options":["so sánh","Yongfu","sông","Sa Hà"],"answer_index":0,"explanation":"比照 = so sánh"},{"question":"Từ 「永福」 có nghĩa là gì?","options":["Yongfu","so sánh","sông","Sa Hà"],"answer_index":0,"explanation":"永福 = Yongfu"},{"question":"Từ 「江河」 có nghĩa là gì?","options":["sông","so sánh","Yongfu","Sa Hà"],"answer_index":0,"explanation":"江河 = sông"},{"question":"Từ 「沙河」 có nghĩa là gì?","options":["Sa Hà","so sánh","Yongfu","sông"],"answer_index":0,"explanation":"沙河 = Sa Hà"},{"question":"Từ 「没人会」 có nghĩa là gì?","options":["sẽ không có ai","so sánh","Yongfu","sông"],"answer_index":0,"explanation":"没人会 = sẽ không có ai"},{"question":"Từ 「法医」 có nghĩa là gì?","options":["pháp y","so sánh","Yongfu","sông"],"answer_index":0,"explanation":"法医 = pháp y"},{"question":"Từ 「波拉」 có nghĩa là gì?","options":["áo choàng","so sánh","Yongfu","sông"],"answer_index":0,"explanation":"波拉 = áo choàng"},{"question":"Từ 「泳装」 có nghĩa là gì?","options":["áo tắm","so sánh","Yongfu","sông"],"answer_index":0,"explanation":"泳装 = áo tắm"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: so sánh","opti