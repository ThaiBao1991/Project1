ất cả các nhóm dân tộc","example_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_868a7c41","audio_ref":"m_beec89e7","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_91ce12e1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1399","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"卫冕を 使います。","line_vi":"Tôi dùng 卫冕.","focus_words":["卫冕"]},{"speaker":"B","line_target":"印证 は 何ですか。","line_vi":"印证 là cái gì?","focus_words":["印证"]},{"speaker":"A","line_target":"压倒です。","line_vi":"Đó là 压倒.","focus_words":["压倒"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_72ec5d8c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「卫冕」 có nghĩa là gì?","options":["Bảo vệ danh hiệu","Xác nhận","áp đảo","Theo lịch trình ban đầu"],"answer_index":0,"explanation":"卫冕 = Bảo vệ danh hiệu"},{"question":"Từ 「印证」 có nghĩa là gì?","options":["Xác nhận","Bảo vệ danh hiệu","áp đảo","Theo lịch trình ban đầu"],"answer_index":0,"explanation":"印证 = Xác nhận"},{"question":"Từ 「压倒」 có nghĩa là gì?","options":["áp đảo","Bảo vệ danh hiệu","Xác nhận","Theo lịch trình ban đầu"],"answer_index":0,"explanation":"压倒 = áp đảo"},{"question":"Từ 「原定」 có nghĩa là gì?","options":["Theo lịch trình ban đầu","Bảo vệ danh hiệu","Xác nhận","áp đảo"],"answer_index":0,"explanation":"原定 = Theo lịch trình ban đầu"},{"question":"Từ 「发疯」 có nghĩa là gì?","options":["phát điên","Bảo vệ danh hiệu","Xác nhận","áp đảo"],"answer_index":0,"explanation":"发疯 = phát điên"},{"question":"Từ 「取而代之」 có nghĩa là gì?","op