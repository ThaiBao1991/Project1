":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1993","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"海洛因を 使います。","line_vi":"Tôi dùng 海洛因.","focus_words":["海洛因"]},{"speaker":"B","line_target":"海淀 は 何ですか。","line_vi":"海淀 là cái gì?","focus_words":["海淀"]},{"speaker":"A","line_target":"淮安です。","line_vi":"Đó là 淮安.","focus_words":["淮安"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6f947566","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「海洛因」 có nghĩa là gì?","options":["heroin","Hải Điến","Hoài An","chứng khoán Hồng Kông"],"answer_index":0,"explanation":"海洛因 = heroin"},{"question":"Từ 「海淀」 có nghĩa là gì?","options":["Hải Điến","heroin","Hoài An","chứng khoán Hồng Kông"],"answer_index":0,"explanation":"海淀 = Hải Điến"},{"question":"Từ 「淮安」 có nghĩa là gì?","options":["Hoài An","heroin","Hải Điến","chứng khoán Hồng Kông"],"answer_index":0,"explanation":"淮安 = Hoài An"},{"question":"Từ 「港股」 có nghĩa là gì?","options":["chứng khoán Hồng Kông","heroin","Hải Điến","Hoài An"],"answer_index":0,"explanation":"港股 = chứng khoán Hồng Kông"},{"question":"Từ 「游戏规则」 có nghĩa là gì?","options":["luật chơi","heroin","Hải Điến","Hoài An"],"answer_index":0,"explanation":"游戏规则 = luật chơi"},{"question":"Từ 「灌木丛」 có nghĩa là gì?","options":["bụi cây","heroin","Hải Điến","Hoài An"],"answer_index":0,"explanation":"灌木丛 = bụi cây"},{"question":"Từ 「火山口」 có nghĩa là gì?","options":["miệng núi lửa",