ce":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_6c9879ce","audio_ref":"m_064fc71f","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_8944b354"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2184","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"参访を 使います。","line_vi":"Tôi dùng 参访.","focus_words":["参访"]},{"speaker":"B","line_target":"口粮 は 何ですか。","line_vi":"口粮 là cái gì?","focus_words":["口粮"]},{"speaker":"A","line_target":"古诗です。","line_vi":"Đó là 古诗.","focus_words":["古诗"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_25a4faef","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「参访」 có nghĩa là gì?","options":["chuyến thăm","khẩu phần ăn","thơ cổ","dừng hẳn"],"answer_index":0,"explanation":"参访 = chuyến thăm"},{"question":"Từ 「口粮」 có nghĩa là gì?","options":["khẩu phần ăn","chuyến thăm","thơ cổ","dừng hẳn"],"answer_index":0,"explanation":"口粮 = khẩu phần ăn"},{"question":"Từ 「古诗」 có nghĩa là gì?","options":["thơ cổ","chuyến thăm","khẩu phần ăn","dừng hẳn"],"answer_index":0,"explanation":"古诗 = thơ cổ"},{"question":"Từ 「句号」 có nghĩa là gì?","options":["dừng hẳn","chuyến thăm","khẩu phần ăn","thơ cổ"],"answer_index":0,"explanation":"句号 = dừng hẳn"},{"question":"Từ 「可好」 có nghĩa là gì?","options":["Tốt","chuyến thăm","khẩu phần ăn","thơ cổ"],"answer_index":0,"explanation":"可好 = Tốt"},{"question":"Từ 「可见一斑」 có nghĩa là gì?","options":["Nó có thể được nhìn thấy","chuy