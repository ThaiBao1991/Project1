ic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_16948652","audio_ref":"m_fd150938","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_436eae1a"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Trợ từ で (de) — nơi thực hiện","level":"N5","explanation":"で chỉ nơi thực hiện hành động hoặc phương tiện.","examples":[{"sentence":"図書館で勉強します。","meaning_vi":"Tôi học ở thư viện."},{"sentence":"電車で行きます。","meaning_vi":"Tôi đi bằng tàu."}],"pronunciation_focus":"で đọc 'de'.","common_mistakes":"Đừng lẫn で (nơi làm) với に (nơi đến).","mini_quiz":[{"question":"___ で食べます。","options":["学校","家","猫"],"answer_index":0,"explanation":"Đáp án: 学校"}],"references":[]},{"title":"Trợ từ と (to) — và / với","level":"N5","explanation":"と nối hai danh từ ('và') hoặc nghĩa 'cùng với'.","examples":[{"sentence":"本とノートがあります。","meaning_vi":"Tôi có sách và vở."},{"sentence":"友達と映画を見ます。","meaning_vi":"Tôi xem phim cùng bạn."}],"pronunciation_focus":"と đọc 'to'.","common_mistakes":"Không dùng と để nối nhiều hơn 2 danh từ (⇒ や).","mini_quiz":[{"question":"友達___ 話します。","options":["と","は","を"],"answer_index":0,"explanation":"Đáp án: と"}],"references":[]},{"title":"Động từ ます (masu) — lịch sự","level":"N5","explanation":"Thêm ます vào động từ gốc để nói lịch sự, dùng với người lớn tuổi.","examples":[{"sentence":"学生です。→ 学生です (lịch sự vẫn dùng です).","meaning_vi":"Đây là dạng lịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Động từ ない (nai) — phủ định","level":"N5","explanation":"ない phủ định với ichidan; godan dùng ません. Trạng thái:〜 없습니다.","examples":[{"sentence":"先生ではありません。","meaning_vi":"Không phải là giáo viên."},{"sentence":"冷蔵庫にありません。","meaning_vi":"Không có trong tủ lạnh."}],"pronunciation_focus":"ない là ichidan, ません là godan.","common_mistakes":"Đừng dùng ない với danh từ (⇒ がありません).","mini_quiz":[{"question":"冷蔵庫に___ 。","options":["あります","ありません","です"],"answer_index":1,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 937","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"吓人を 使います。","line_vi":"Tôi dùng 吓人.","focus_words":["吓人"]},{"speaker":"B","line_target":"哈尔 は 何ですか。","line_vi":"哈尔 là cái gì?","focus_words":["哈尔"]},{"speaker":"A","line_target":"商机です。","line_vi":"Đó là 商机.","focus_words":["商机"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5d5b6fa4","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「吓人」 có nghĩa là gì?","options":["đáng sợ","Hal","cơ hội kinh doanh","Địa điểm"],"answer_index":0,"explanation":"吓人 = đáng sợ"},{"question":"Từ 「哈尔」 có nghĩa là gì?","options":["Hal","đáng sợ","cơ hội kinh doanh","Địa điểm"],"answer_index":0,"explanation":"哈尔 = Hal"},{"question":"Từ 「商机」 có nghĩa là gì?","options":["cơ hội kinh doanh","đáng sợ","Hal","Địa điểm"],"answer_index":0,"explanation":"商机 = cơ hội kinh doanh"},{"question":"Từ 「场馆」 có nghĩa là gì?","options":["Địa điểm","đáng sợ","Hal","cơ hội kinh doanh"],"answer_index":0,"explanation":"场馆 = Địa điểm"},{"question":"Từ 「外貌」 có nghĩa là gì?","options":["Ngoại hình","đáng sợ","Hal","cơ hội kinh doanh"],"answer_index":0,"explanation":"外貌 = Ngoại hình"},{"question":"Từ 「多样化」 có nghĩa là gì?","options":["Đa dạng hóa","đáng sợ","Hal","cơ hội kinh doanh"],"answer_index":0,"explanation":"多样化 = Đa dạng hóa"},{"question":"Từ 「大同」 có nghĩa là gì?","options":["Đại Đồng","đáng sợ","Hal","cơ hội kinh doanh"],"answer_index":0,"explanation":"大同 =