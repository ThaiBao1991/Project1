ư rồi đọc sách."},{"sentence":"寒くて、死にそうです。","meaning_vi":"Tôi lạnh quá, sắp chết."}],"pronunciation_focus":"Ichidan: bỏ ru; Godan: e/i → te.","common_mistakes":"Đừng dùng て thay cho と.","mini_quiz":[{"question":"手紙を___、本を読みます。","options":["書いて","書い","書きます"],"answer_index":0,"explanation":"Đáp án: 書いて"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 484","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"模范を 使います。","line_vi":"Tôi dùng 模范.","focus_words":["模范"]},{"speaker":"B","line_target":"此地 は 何ですか。","line_vi":"此地 là cái gì?","focus_words":["此地"]},{"speaker":"A","line_target":"法学です。","line_vi":"Đó là 法学.","focus_words":["法学"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_33f86a19","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「模范」 có nghĩa là gì?","options":["người mẫu","ở đây","luật học","cam chịu"],"answer_index":0,"explanation":"模范 = người mẫu"},{"question":"Từ 「此地」 có nghĩa là gì?","options":["ở đây","người mẫu","luật học","cam chịu"],"answer_index":0,"explanation":"此地 = ở đây"},{"question":"Từ 「法学」 có nghĩa là gì?","options":["luật học","người mẫu","ở đây","cam chịu"],"answer_index":0,"explanation":"法学 = luật học"},{"question":"Từ 「注定」 có nghĩa là gì?","options":["cam chịu","người mẫu","ở đây","luật học"],"answer_index":0,"explanation":"注定 = cam chịu"},{"question":"Từ 「浏览器」 có nghĩa là gì?","options":["Trình duyệt","người mẫu","ở đây","luật học"],"answer_index":0,"explanation":"浏览器 = Trình duyệt"},{"question":"Từ 「浴室」 có nghĩa là gì?","options":["phòng tắm","người mẫu","ở đây","luật học"],"answer_index":0,"explanation":"浴室 = phòng tắm"},{"question":"Từ 「潜艇」 có nghĩa là gì?","options":["tàu ngầm","người mẫu","ở đây","luật học"],"answer_index":0,"explanation":"潜艇 = tàu ngầm"},{"question":"Từ 「煽动」 có nghĩa là gì?","options"