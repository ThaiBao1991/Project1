arget":"","example_vi":"","image_prompt":null,"image_ref":"m_cef9814d","audio_ref":"m_717678f6","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_7edfc8d1"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 734","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"男士を 使います。","line_vi":"Tôi dùng 男士.","focus_words":["男士"]},{"speaker":"B","line_target":"相爱 は 何ですか。","line_vi":"相爱 là cái gì?","focus_words":["相爱"]},{"speaker":"A","line_target":"相等です。","line_vi":"Đó là 相等.","focus_words":["相等"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b2de7f0c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「男士」 có nghĩa là gì?","options":["đàn ông","yêu","bằng nhau","coi là"],"answer_index":0,"explanation":"男士 = đàn ông"},{"question":"Từ 「相爱」 có nghĩa là gì?","options":["yêu","đàn ông","bằng nhau","coi là"],"answer_index":0,"explanation":"相爱 = yêu"},{"question":"Từ 「相等」 có nghĩa là gì?","options":["bằng nhau","đàn ông","yêu","coi là"],"answer_index":0,"explanation":"相等 = bằng nhau"},{"question":"Từ 「看成」 có nghĩa là gì?","options":["coi là","đàn ông","yêu","bằng nhau"],"answer_index":0,"explanation":"看成 = coi là"},{"question":"Từ 「督察」 có nghĩa là gì?","options":["thanh tra","đàn ông","yêu","bằng nhau"],"answer_index":0,"explanation":"督察 = thanh tra"},{"question":"Từ 「短短」 có nghĩa là gì?","options":["ngắn","đàn ông","yêu","bằng nhau"],"answer_index":0,"explanation":"短短 = ngắn"},{"question":"Từ 「确诊」 có nghĩa là gì?","options":["Đã xác nhận","đàn ông","yêu","bằng nhau"],"answer_index":0,"explanation":"确诊 = Đã xác nhận"},{"question":"Từ 「移交」 có nghĩa là gì?","options":["bàn giao","đàn ông","yêu","bằng nhau"],"answer_index":0,"expla