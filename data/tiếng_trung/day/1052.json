ng đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1052","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"中欧を 使います。","line_vi":"Tôi dùng 中欧.","focus_words":["中欧"]},{"speaker":"B","line_target":"乌鸦 は 何ですか。","line_vi":"乌鸦 là cái gì?","focus_words":["乌鸦"]},{"speaker":"A","line_target":"事业单位です。","line_vi":"Đó là 事业单位.","focus_words":["事业单位"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9b0d34fe","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「中欧」 có nghĩa là gì?","options":["Trung Âu","con quạ","Cơ quan công cộng","cảnh sát giao thông"],"answer_index":0,"explanation":"中欧 = Trung Âu"},{"question":"Từ 「乌鸦」 có nghĩa là gì?","options":["con quạ","Trung Âu","Cơ quan công cộng","cảnh sát giao thông"],"answer_index":0,"explanation":"乌鸦 = con quạ"},{"question":"Từ 「事业单位」 có nghĩa là gì?","options":["Cơ quan công cộng","Trung Âu","con quạ","cảnh sát giao thông"],"answer_index":0,"explanation":"事业单位 = Cơ quan công cộng"},{"question":"Từ 「交警」 có nghĩa là gì?","options":["cảnh sát giao thông","Trung Âu","con quạ","Cơ quan công cộng"],"answer_index":0,"explanation":"交警 = cảnh sát giao thông"},{"question":"Từ 「产出」 có nghĩa là gì?","options":["đầu ra","Trung Âu","con quạ","Cơ quan công cộng"],"answer_index":0,"explanation":"产出 = đầu ra"},{"question":"Từ 「京剧」 có nghĩa là gì?","options":["Kinh kịch","Trung Âu","con quạ","Cơ quan công cộng"],"answer_index":0,"explanation":"京剧 = Kinh kịch"},{"question":"Từ 「传销」 có nghĩa là gì?","options":["MLM","Trung Âu","con quạ","Cơ quan công cộng"],"answer_index":0,"expl