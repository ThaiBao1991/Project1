ation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2406","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"朋克を 使います。","line_vi":"Tôi dùng 朋克.","focus_words":["朋克"]},{"speaker":"B","line_target":"本溪 は 何ですか。","line_vi":"本溪 là cái gì?","focus_words":["本溪"]},{"speaker":"A","line_target":"本级です。","line_vi":"Đó là 本级.","focus_words":["本级"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b172e3b7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「朋克」 có nghĩa là gì?","options":["đồ chơi khăm","Benxi","Cấp độ này","Lý Hiển Long"],"answer_index":0,"explanation":"朋克 = đồ chơi khăm"},{"question":"Từ 「本溪」 có nghĩa là gì?","options":["Benxi","đồ chơi khăm","Cấp độ này","Lý Hiển Long"],"answer_index":0,"explanation":"本溪 = Benxi"},{"question":"Từ 「本级」 có nghĩa là gì?","options":["Cấp độ này","đồ chơi khăm","Benxi","Lý Hiển Long"],"answer_index":0,"explanation":"本级 = Cấp độ này"},{"question":"Từ 「李显龙」 có nghĩa là gì?","options":["Lý Hiển Long","đồ chơi khăm","Benxi","Cấp độ này"],"answer_index":0,"explanation":"李显龙 = Lý Hiển Long"},{"question":"Từ 「杰米」 có nghĩa là gì?","options":["Jamie","đồ chơi khăm","Benxi","Cấp độ này"],"answer_index":0,"explanation":"杰米 = Jamie"},{"question":"Từ 「标致」 có nghĩa là gì?","options":["Peugeot","đồ chơi khăm","Benxi","Cấp độ này"],"answer_index":0,"explanation":"标致 = Peugeot"},{"question":"Từ 「案中」 có nghĩa là gì?","options":["trong trường hợp","đồ chơi khăm","Benxi","Cấp độ này"],"answer_index":0,"explanation":"案中 = trong trường hợp"},{"question":"Từ 「桥段」 có n