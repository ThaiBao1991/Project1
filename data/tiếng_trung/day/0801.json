ence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 801","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"北上を 使います。","line_vi":"Tôi dùng 北上.","focus_words":["北上"]},{"speaker":"B","line_target":"升起 は 何ですか。","line_vi":"升起 là cái gì?","focus_words":["升起"]},{"speaker":"A","line_target":"参战です。","line_vi":"Đó là 参战.","focus_words":["参战"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6f09d3e2","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「北上」 có nghĩa là gì?","options":["Đi về phía bắc","tăng lên","tham chiến","trút giận"],"answer_index":0,"explanation":"北上 = Đi về phía bắc"},{"question":"Từ 「升起」 có nghĩa là gì?","options":["tăng lên","Đi về phía bắc","tham chiến","trút giận"],"answer_index":0,"explanation":"升起 = tăng lên"},{"question":"Từ 「参战」 có nghĩa là gì?","options":["tham chiến","Đi về phía bắc","tăng lên","trút giận"],"answer_index":0,"explanation":"参战 = tham chiến"},{"question":"Từ 「发泄」 có nghĩa là gì?","options":["trút giận","Đi về phía bắc","tăng lên","tham chiến"],"answer_index":0,"explanation":"发泄 = trút giận"},{"question":"Từ 「台阶」 có nghĩa là gì?","options":["bước","Đi về phía bắc","tăng lên","tham chiến"],"answer_index":0,"explanation":"台阶 = bước"},{"question":"Từ 「各处」 có nghĩa là gì?","options":["ở khắp mọi nơi","Đi về phía bắc","tăng lên","tham chiến"],"answer_index":0,"explanation":"各处 = ở khắp mọi nơi"},{"question":"Từ 「后退」 có nghĩa là gì?","options":["Quay lại","Đi về phía bắc"