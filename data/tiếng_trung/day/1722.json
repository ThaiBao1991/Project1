i).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1722","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"强风を 使います。","line_vi":"Tôi dùng 强风.","focus_words":["强风"]},{"speaker":"B","line_target":"彰化 は 何ですか。","line_vi":"彰化 là cái gì?","focus_words":["彰化"]},{"speaker":"A","line_target":"彼岸です。","line_vi":"Đó là 彼岸.","focus_words":["彼岸"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_01ca89ae","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「强风」 có nghĩa là gì?","options":["gió mạnh","Chương Hóa","phía bên kia","tư vấn"],"answer_index":0,"explanation":"强风 = gió mạnh"},{"question":"Từ 「彰化」 có nghĩa là gì?","options":["Chương Hóa","gió mạnh","phía bên kia","tư vấn"],"answer_index":0,"explanation":"彰化 = Chương Hóa"},{"question":"Từ 「彼岸」 có nghĩa là gì?","options":["phía bên kia","gió mạnh","Chương Hóa","tư vấn"],"answer_index":0,"explanation":"彼岸 = phía bên kia"},{"question":"Từ 「征询」 có nghĩa là gì?","options":["tư vấn","gió mạnh","Chương Hóa","phía bên kia"],"answer_index":0,"explanation":"征询 = tư vấn"},{"question":"Từ 「心烦」 có nghĩa là gì?","options":["khó chịu","gió mạnh","Chương Hóa","phía bên kia"],"answer_index":0,"explanation":"心烦 = khó chịu"},{"question":"Từ 「总动员」 có nghĩa là gì?","options":["tổng động viên","gió mạnh","Chương Hóa","phía bên kia"],"answer_index":0,"explanation":"总动员 = tổng động viên"},{"question":"Từ 「恐惧症」 có nghĩa là gì?","options":["sự ám ảnh","gió mạ