llables":[],"image_ref":"m_c0521e5d","audio_ref":"m_79ff979d","meaning_audio_ref":"m_8d69981f","pos":"","example_target":"","example_vi":"","image_prompt":null,"pitch_accent":"","rhymes":[],"etymology":"","sources":[]}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]},{"title":"Mốc thời gian まで / から","level":"N4","explanation":"まで = cho tới (mốc thời gian), から = từ (điểm bắt đầu).","examples":[{"sentence":"五時まで勉強します。","meaning_vi":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]},{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1541","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"豪斯を 使います。","line_vi":"Tôi dùng 豪斯.","focus_words":["豪斯"]},{"speaker":"B","line_target":"质感 は 何ですか。","line_vi":"质感 là cái gì?","focus_words":["质感"]},{"speaker":"A","line_target":"贫乏です。","line_vi":"Đó là 贫乏.","focus_words":["贫乏"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a0ef70f9","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「豪斯」 có nghĩa là gì?","options":["nhà ở","kết cấu","nghèo nàn","Mua nhà"],"answer_index":0,"explanation":"豪斯 = nhà ở"},{"question":"Từ 「质感」 có nghĩa là gì?","options":["kết cấu","nhà ở","nghèo nàn","Mua nhà"],"answer_index":0,"explanation":"质感 = kết cấu"},{"question":"Từ 「贫乏」 có nghĩa là gì?","options":["nghèo nàn","nhà ở","kết cấu","Mua nhà"],"answer_index":0,"explanation":"贫乏 = nghèo nàn"},{"question":"Từ 「购房」 có nghĩa là gì?","options":["Mua nhà","nhà ở","kết cấu","nghèo nàn"],"answer_index":0,"explanation":"购房 = Mua nhà"},{"question":"Từ 「足球场」 có nghĩa là gì?","options":["sân bóng đá","nhà ở","kết cấu","nghèo nàn"],"answer_index":0,"explanation":"足球场 = sân bóng đá"},{"question":"Từ 「跨过」 có nghĩa là gì?","options":["vượt qua","nhà ở","kết cấu","nghèo nàn"],"answer_index":0,"explanation":"跨过 = vượt qua"},{"question":"Từ 「路旁」 có nghĩa là gì?","options":["ven đường","nhà ở","kết cấu","nghèo nàn"],"answer_index":0,"explanation":"路旁 = ven đường"},{"question":"Từ 「路障」 có nghĩa