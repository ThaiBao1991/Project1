etic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_a1dd8052","audio_ref":"m_b18c06ad","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_270bc828"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]},{"title":"Cách nối câu với ので (node)","level":"N4","explanation":"Nối 2 mệnh đề: 'Vì …' — phần trước dạng thân + ので.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"学生ではないので、行きません。","meaning_vi":"Vì không phải sinh viên nên tôi không đi."}],"pronunciation_focus":"ん de → ので.","common_mistakes":"Không dùng ので để nối câu lệnh mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["ので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: ので"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 794","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"着力を 使います。","line_vi":"Tôi dùng 着力.","focus_words":["着力"]},{"speaker":"B","line_target":"石化 は 何ですか。","line_vi":"石化 là cái gì?","focus_words":["石化"]},{"speaker":"A","line_target":"磁场です。","line_vi":"Đó là 磁场.","focus_words":["磁场"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_eb65295a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「着力」 có nghĩa là gì?","options":["Tập trung vào","hóa dầu","từ trường","biên tập"],"answer_index":0,"explanation":"着力 = Tập trung vào"},{"question":"Từ 「石化」 có nghĩa là gì?","options":["hóa dầu","Tập trung vào","từ trường","biên tập"],"answer_index":0,"explanation":"石化 = hóa dầu"},{"question":"Từ 「磁场」 có nghĩa là gì?","options":["từ trường","Tập trung vào","hóa dầu","biên tập"],"answer_index":0,"explanation":"磁场 = từ trường"},{"question":"Từ 「社论」 có nghĩa là gì?","options":["biên tập","Tập trung vào","hóa dầu","từ trường"],"answer_index":0,"explanation":"社论 = biên tập"},{"question":"Từ 「简洁」 có nghĩa là gì?","options":["ngắn gọn","Tập trung vào","hóa dầu","từ trường"],"answer_index":0,"explanation":"简洁 = ngắn gọn"},{"question":"Từ 「紧缩」 có nghĩa là gì?","options":["sự khắc khổ","Tập trung vào","hóa dầu","từ trường"],"answer_index":0,"explanation":"紧缩 = sự khắc khổ"},{"question":"Từ 「维尔」 có nghĩa là gì?","options":["Vail","Tập trung vào","hóa dầu","từ trường"],"answer_index":0,"explanation":"维尔 = Vail"},{"question":"Từ 「自卫队」 có