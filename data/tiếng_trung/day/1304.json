ịch sự."},{"sentence":"食います。→ 食べます。","meaning_vi":"Ăn (lịch sự)."}],"pronunciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1304","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"分店を 使います。","line_vi":"Tôi dùng 分店.","focus_words":["分店"]},{"speaker":"B","line_target":"副校长 は 何ですか。","line_vi":"副校长 là cái gì?","focus_words":["副校长"]},{"speaker":"A","line_target":"加速器です。","line_vi":"Đó là 加速器.","focus_words":["加速器"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_962f8788","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「分店」 có nghĩa là gì?","options":["chi nhánh","phó hiệu trưởng","máy gia tốc","động mạch"],"answer_index":0,"explanation":"分店 = chi nhánh"},{"question":"Từ 「副校长」 có nghĩa là gì?","options":["phó hiệu trưởng","chi nhánh","máy gia tốc","động mạch"],"answer_index":0,"explanation":"副校长 = phó hiệu trưởng"},{"question":"Từ 「加速器」 có nghĩa là gì?","options":["máy gia tốc","chi nhánh","phó hiệu trưởng","động mạch"],"answer_index":0,"explanation":"加速器 = máy gia tốc"},{"question":"Từ 「动脉」 có nghĩa là gì?","options":["động mạch","chi nhánh","phó hiệu trưởng","máy gia tốc"],"answer_index":0,"explanation":"动脉 = động mạch"},{"question":"Từ 「十二年」 có nghĩa là gì?","options":["mười hai năm","chi nhánh","phó hiệu trưởng","máy gia tốc"],"answer_index":0,"explanation":"十二年 = mười hai năm"},{"question":"Từ 「千瓦」 có nghĩa là gì?","options":["kilowatt","chi nhánh","phó hiệu trưởng","máy gia tốc"],"answer_index":0,"explanation":"千瓦 = kilowatt"},{"question":"Từ 「卖家」 có nghĩa là gì?","