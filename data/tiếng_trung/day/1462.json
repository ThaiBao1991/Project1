/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1462","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"绝招を 使います。","line_vi":"Tôi dùng 绝招.","focus_words":["绝招"]},{"speaker":"B","line_target":"绳索 は 何ですか。","line_vi":"绳索 là cái gì?","focus_words":["绳索"]},{"speaker":"A","line_target":"维度です。","line_vi":"Đó là 维度.","focus_words":["维度"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_6e4feaa5","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「绝招」 có nghĩa là gì?","options":["thủ thuật","dây thừng","Kích thước","Tổng quan"],"answer_index":0,"explanation":"绝招 = thủ thuật"},{"question":"Từ 「绳索」 có nghĩa là gì?","options":["dây thừng","thủ thuật","Kích thước","Tổng quan"],"answer_index":0,"explanation":"绳索 = dây thừng"},{"question":"Từ 「维度」 có nghĩa là gì?","options":["Kích thước","thủ thuật","dây thừng","Tổng quan"],"answer_index":0,"explanation":"维度 = Kích thước"},{"question":"Từ 「综述」 có nghĩa là gì?","options":["Tổng quan","thủ thuật","dây thừng","Kích thước"],"answer_index":0,"explanation":"综述 = Tổng quan"},{"question":"Từ 「绽放」 có nghĩa là gì?","options":["nở hoa","thủ thuật","dây thừng","Kích thước"],"answer_index":0,"explanation":"绽放 = nở hoa"},{"question":"Từ 「网购」 có nghĩa là gì?","options":["mua sắm trực tuyến","thủ thuật","dây thừng","Kích thước"],"answer_index":0