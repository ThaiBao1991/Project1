ronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 792","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"斯里兰卡を 使います。","line_vi":"Tôi dùng 斯里兰卡.","focus_words":["斯里兰卡"]},{"speaker":"B","line_target":"旅途 は 何ですか。","line_vi":"旅途 là cái gì?","focus_words":["旅途"]},{"speaker":"A","line_target":"无不です。","line_vi":"Đó là 无不.","focus_words":["无不"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_cef3f03c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「斯里兰卡」 có nghĩa là gì?","options":["Sri Lanka","cuộc hành trình","Tất cả","Triều Dương"],"answer_index":0,"explanation":"斯里兰卡 = Sri Lanka"},{"question":"Từ 「旅途」 có nghĩa là gì?","options":["cuộc hành trình","Sri Lanka","Tất cả","Triều Dương"],"answer_index":0,"explanation":"旅途 = cuộc hành trình"},{"question":"Từ 「无不」 có nghĩa là gì?","options":["Tất cả","Sri Lanka","cuộc hành trình","Triều Dương"],"answer_index":0,"explanation":"无不 = Tất cả"},{"question":"Từ 「朝阳」 có nghĩa là gì?","options":["Triều Dương","Sri Lanka","cuộc hành trình","Tất cả"],"answer_index":0,"explanation":"朝阳 = Triều Dương"},{"question":"Từ 「末期」 có nghĩa là gì?","options":["Cuối kỳ","Sri Lanka","cuộc hành trình","Tất cả"],"answer_index":0,"explanation":"末期 = Cuối kỳ"},{"question":"Từ 「死后」 có nghĩa là gì?","options":["sau khi chết","Sri Lanka","cuộc hành trình","Tất cả"],"answer_index":0,"explanation":"死后 = sau khi chết"},{"question":"Từ 「河谷」 có nghĩa là gì?","options":["thung lũng sông","Sri Lanka","cuộc hành trình","Tất cả"],"answer_index":0,"explanation":"河谷 = thung lũng sông"},{"question":"Từ 「沿线」 có