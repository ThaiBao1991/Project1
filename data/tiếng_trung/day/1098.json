planation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1098","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"孵化を 使います。","line_vi":"Tôi dùng 孵化.","focus_words":["孵化"]},{"speaker":"B","line_target":"安全局 は 何ですか。","line_vi":"安全局 là cái gì?","focus_words":["安全局"]},{"speaker":"A","line_target":"实况です。","line_vi":"Đó là 实况.","focus_words":["实况"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_27526a4e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「孵化」 có nghĩa là gì?","options":["nở","văn phòng an ninh","Trực tiếp","phía bên kia"],"answer_index":0,"explanation":"孵化 = nở"},{"question":"Từ 「安全局」 có nghĩa là gì?","options":["văn phòng an ninh","nở","Trực tiếp","phía bên kia"],"answer_index":0,"explanation":"安全局 = văn phòng an ninh"},{"question":"Từ 「实况」 có nghĩa là gì?","options":["Trực tiếp","nở","văn phòng an ninh","phía bên kia"],"answer_index":0,"explanation":"实况 = Trực tiếp"},{"question":"Từ 「对岸」 có nghĩa là gì?","options":["phía bên kia","nở","văn phòng an ninh","Trực tiếp"],"answer_index":0,"explanation":"对岸 = phía bên kia"},{"question":"Từ 「对白」 có nghĩa là gì?","options":["đối thoại","nở","văn phòng an ninh","Trực tiếp"],"answer_index":0,"explanation":"对白 = đối thoại"},{"question":"Từ 「小国」 có nghĩa là gì?","options":["đất nước nhỏ","nở","văn phòng an ninh","Trực tiếp"],"answer_index":0,"explanation":"小国 = đất nước nhỏ"},{