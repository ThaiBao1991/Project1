ả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 731","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"尽情を 使います。","line_vi":"Tôi dùng 尽情.","focus_words":["尽情"]},{"speaker":"B","line_target":"居于 は 何ですか。","line_vi":"居于 là cái gì?","focus_words":["居于"]},{"speaker":"A","line_target":"已婚です。","line_vi":"Đó là 已婚.","focus_words":["已婚"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_ac89f134","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「尽情」 có nghĩa là gì?","options":["thưởng thức","ở trong","kết hôn","Đã xong rồi"],"answer_index":0,"explanation":"尽情 = thưởng thức"},{"question":"Từ 「居于」 có nghĩa là gì?","options":["ở trong","thưởng thức","kết hôn","Đã xong rồi"],"answer_index":0,"explanation":"居于 = ở trong"},{"question":"Từ 「已婚」 có nghĩa là gì?","options":["kết hôn","thưởng thức","ở trong","Đã xong rồi"],"answer_index":0,"explanation":"已婚 = kết hôn"},{"question":"Từ 「已成」 có nghĩa là gì?","options":["Đã xong rồi","thưởng thức","ở trong","kết hôn"],"answer_index":0,"explanation":"已成 = Đã xong rồi"},{"question":"Từ 「开发者」 có nghĩa là gì?","options":["Nhà phát triển","thưởng thức","ở trong","kết hôn"],"answer_index":0,"explanation":"开发者 = Nhà phát triển"},{"question":"Từ 「弱势」 có nghĩa là gì?","options":["yếu","thưởng thức","ở trong","kết hôn"],"answer_index":0,"explanation":"弱势 = yếu"},{"question":"Từ 「影院」 có nghĩa là gì?","options":["rạp chiếu phim","thưởn