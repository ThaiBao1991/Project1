 phải là không đi."}],"pronunciation_focus":"〜わけではない = không hẳn là.","common_mistakes":"Đừng dùng cho phủ định hoàn toàn (⇒ ない).","mini_quiz":[{"question":"嫌いな___ではありません。","options":["わけではない","ではない","がない"],"answer_index":0,"explanation":"Đáp án: わけではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1419","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"顶点を 使います。","line_vi":"Tôi dùng 顶点.","focus_words":["顶点"]},{"speaker":"B","line_target":"预估 は 何ですか。","line_vi":"预估 là cái gì?","focus_words":["预估"]},{"speaker":"A","line_target":"预知です。","line_vi":"Đó là 预知.","focus_words":["预知"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9da086d3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「顶点」 có nghĩa là gì?","options":["đỉnh","Ước tính","sự biết trước","vùng trời"],"answer_index":0,"explanation":"顶点 = đỉnh"},{"question":"Từ 「预估」 có nghĩa là gì?","options":["Ước tính","đỉnh","sự biết trước","vùng trời"],"answer_index":0,"explanation":"预估 = Ước tính"},{"question":"Từ 「预知」 có nghĩa là gì?","options":["sự biết trước","đỉnh","Ước tính","vùng trời"],"answer_index":0,"explanation":"预知 = sự biết trước"},{"question":"Từ 「领空」 có nghĩa là gì?","options":["vùng trời","đỉnh","Ước tính","sự biết trước"],"answer_index":0,"explanation":"领空 = vùng trời"},{"question":"Từ 「风声」 có nghĩa là gì?","options":["Âm thanh của gió","đỉnh","Ước tính","sự biết trước"],"answer_index":0,"explanation":"风声 = Âm thanh của gió"},{"question":"Từ 「饱和」 có nghĩa là gì?","options":["bão hòa","đỉnh","Ước tính","sự biết trước"],"answer_index":0,"explanation":"饱和 = bão hòa"},{"question":"Từ 「高峰期」 có nghĩa là gì?","options":["thời kỳ cao điểm","đỉnh","Ước tính","sự biết trước"],"answer_index":0,"explanation":"高峰期 = thời kỳ cao điểm"},{"question":"Từ 「鲜艳」 có nghĩa là gì?","