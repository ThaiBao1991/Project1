本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1209","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"蝙蝠侠を 使います。","line_vi":"Tôi dùng 蝙蝠侠.","focus_words":["蝙蝠侠"]},{"speaker":"B","line_target":"见于 は 何ですか。","line_vi":"见于 là cái gì?","focus_words":["见于"]},{"speaker":"A","line_target":"试探です。","line_vi":"Đó là 试探.","focus_words":["试探"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_b06463cd","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「蝙蝠侠」 có nghĩa là gì?","options":["người dơi","nhìn thấy trong","kiểm tra","bộ phim"],"answer_index":0,"explanation":"蝙蝠侠 = người dơi"},{"question":"Từ 「见于」 có nghĩa là gì?","options":["nhìn thấy trong","người dơi","kiểm tra","bộ phim"],"answer_index":0,"explanation":"见于 = nhìn thấy trong"},{"question":"Từ 「试探」 có nghĩa là gì?","options":["kiểm tra","người dơi","nhìn thấy trong","bộ phim"],"answer_index":0,"explanation":"试探 = kiểm tra"},{"question":"Từ 「该片」 có nghĩa là gì?","options":["bộ phim","người dơi","nhìn thấy trong","kiểm tra"],"answer_index":0,"explanation":"该片 = bộ phim"},{"question":"Từ 「诸侯」 có nghĩa là gì?","options":["hoàng tử","người dơi","nhìn thấy trong","kiểm tra"],"answer_index":0,"explanation":"诸侯 = hoàng tử"},{"question":"Từ 「调剂」 có nghĩa là gì?","options":["điều chỉnh","người dơi","nhìn thấy trong","kiểm tra"],"answer_index":0,"explanation":"调剂 = điều chỉnh"},{"question":"Từ 「贩售」 có ng