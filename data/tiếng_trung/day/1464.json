xamples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1464","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"萌芽を 使います。","line_vi":"Tôi dùng 萌芽.","focus_words":["萌芽"]},{"speaker":"B","line_target":"补选 は 何ですか。","line_vi":"补选 là cái gì?","focus_words":["补选"]},{"speaker":"A","line_target":"表弟です。","line_vi":"Đó là 表弟.","focus_words":["表弟"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c1b9a9c1","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「萌芽」 có nghĩa là gì?","options":["nảy mầm","bầu cử phụ","anh họ","Ngoại hình"],"answer_index":0,"explanation":"萌芽 = nảy mầm"},{"question":"Từ 「补选」 có nghĩa là gì?","options":["bầu cử phụ","nảy mầm","anh họ","Ngoại hình"],"answer_index":0,"explanation":"补选 = bầu cử phụ"},{"question":"Từ 「表弟」 có nghĩa là gì?","options":["anh họ","nảy mầm","bầu cử phụ","Ngoại hình"],"answer_index":0,"explanation":"表弟 = anh họ"},{"question":"Từ 「表象」 có nghĩa là gì?","options":["Ngoại hình","nảy mầm","bầu cử phụ","anh họ"],"answer_index":0,"explanation":"表象 = Ngoại hình"},{"question":"Từ 「被窝」 có nghĩa là gì?","options":["chăn bông","nảy mầm","bầu cử phụ","anh họ"],"answer_index":0,"explanation":"被窝 = chăn bông"},{"question":"Từ 「西宁」 có nghĩa là gì?","options":["Tây Ninh","nảy mầm","bầu cử phụ","anh họ"],"answer_index":0,"explanation":"西宁 = Tây Ninh"},{"question":"Từ 「西山」 có nghĩa là gì?","options":["tây sơn","nảy mầm","bầ