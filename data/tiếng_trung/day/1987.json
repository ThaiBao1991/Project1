ence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1987","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"情爱を 使います。","line_vi":"Tôi dùng 情爱.","focus_words":["情爱"]},{"speaker":"B","line_target":"感染者 は 何ですか。","line_vi":"感染者 là cái gì?","focus_words":["感染者"]},{"speaker":"A","line_target":"我累です。","line_vi":"Đó là 我累.","focus_words":["我累"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_7ce3f617","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「情爱」 có nghĩa là gì?","options":["tình yêu","người bị nhiễm bệnh","tôi mệt","cắt cụt chi"],"answer_index":0,"explanation":"情爱 = tình yêu"},{"question":"Từ 「感染者」 có nghĩa là gì?","options":["người bị nhiễm bệnh","tình yêu","tôi mệt","cắt cụt chi"],"answer_index":0,"explanation":"感染者 = người bị nhiễm bệnh"},{"question":"Từ 「我累」 có nghĩa là gì?","options":["tôi mệt","tình yêu","người bị nhiễm bệnh","cắt cụt chi"],"answer_index":0,"explanation":"我累 = tôi mệt"},{"question":"Từ 「截肢」 có nghĩa là gì?","options":["cắt cụt chi","tình yêu","người bị nhiễm bệnh","tôi mệt"],"answer_index":0,"explanation":"截肢 = cắt cụt chi"},{"question":"Từ 「所幸」 có nghĩa là gì?","options":["May mắn thay","tình yêu","người bị nhiễm bệnh","tôi mệt"],"answer_index":0,"explanation":"所幸 = May mắn thay"},{"question":"Từ 「手术室」 có nghĩa là gì?","options":["phòng mổ","tình yêu","người bị nhiễm bệnh","tôi mệt"],"answer_index":0,"explanation":"手术室 = phòng mổ"},{"question":"Từ 「打消」 có nghĩa là gì?","options":["hủy bỏ","tình yêu","người bị nhiễm bệnh","tôi mệt"],