ách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2439","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"沦丧を 使います。","line_vi":"Tôi dùng 沦丧.","focus_words":["沦丧"]},{"speaker":"B","line_target":"河间 は 何ですか。","line_vi":"河间 là cái gì?","focus_words":["河间"]},{"speaker":"A","line_target":"沿河です。","line_vi":"Đó là 沿河.","focus_words":["沿河"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_2da3df0c","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「沦丧」 có nghĩa là gì?","options":["Bị mất","Hejian","dọc theo sông","farah"],"answer_index":0,"explanation":"沦丧 = Bị mất"},{"question":"Từ 「河间」 có nghĩa là gì?","options":["Hejian","Bị mất","dọc theo sông","farah"],"answer_index":0,"explanation":"河间 = Hejian"},{"question":"Từ 「沿河」 có nghĩa là gì?","options":["dọc theo sông","Bị mất","Hejian","farah"],"answer_index":0,"explanation":"沿河 = dọc theo sông"},{"question":"Từ 「法拉」 có nghĩa là gì?","options":["farah","Bị mất","Hejian","dọc theo sông"],"answer_index":0,"explanation":"法拉 = farah"},{"question":"Từ 「波音公司」 có nghĩa là gì?","options":["công ty boeing","Bị mất","Hejian","dọc theo sông"],"answer_index":0,"explanation":"波音公司 = công ty boeing"},{"question":"Từ 「泰德」 có nghĩa là gì?","options":["Ted","Bị mất","Hejian","dọc theo sông"],"answer_index":0,"explanation":"泰德 = Ted"},{"question":"Từ 「泰晤士报」 có nghĩa là gì?","options":["thời đại","Bị mất","Hejian","dọc theo sông"],"answer_index":0,"explanation":"泰晤士报 = thời đại"},{"question":"Từ 「洋溢」 có nghĩa là gì?","options":["tràn","Bị mất","Hejian","dọc theo 