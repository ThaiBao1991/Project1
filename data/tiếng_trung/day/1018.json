a, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1018","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"地名を 使います。","line_vi":"Tôi dùng 地名.","focus_words":["地名"]},{"speaker":"B","line_target":"坏消息 は 何ですか。","line_vi":"坏消息 là cái gì?","focus_words":["坏消息"]},{"speaker":"A","line_target":"城门です。","line_vi":"Đó là 城门.","focus_words":["城门"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_01c601c3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「地名」 có nghĩa là gì?","options":["Tên địa điểm","tin xấu","cổng thành","khóa đào tạo"],"answer_index":0,"explanation":"地名 = Tên địa điểm"},{"question":"Từ 「坏消息」 có nghĩa là gì?","options":["tin xấu","Tên địa điểm","cổng thành","khóa đào tạo"],"answer_index":0,"explanation":"坏消息 = tin xấu"},{"question":"Từ 「城门」 có nghĩa là gì?","options":["cổng thành","Tên địa điểm","tin xấu","khóa đào tạo"],"answer_index":0,"explanation":"城门 = cổng thành"},{"question":"Từ 「培训班」 có nghĩa là gì?","options":["khóa đào tạo","Tên địa điểm","tin xấu","cổng thành"],"answer_index":0,"explanation":"培训班 = khóa đào tạo"},{"question":"Từ 「堵塞」 có nghĩa là gì?","options":["bị tắc","Tên địa điểm","tin xấu","cổng thành"],"answer_index":0,"explanation":"堵塞 = bị tắc"},{"question":"Từ 「境地」 có nghĩa là gì?","options":["tình huống","Tên địa điểm","tin xấu","cổng thành"],"answer_index":0,"explanation":"境地 = tình huống"},{"question":"Từ 「备份」 có nghĩa là gì?","options":["sao lưu","Tên địa điểm","tin xấu","cổng thà