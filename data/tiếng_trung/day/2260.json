ông có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2260","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"宝山を 使います。","line_vi":"Tôi dùng 宝山.","focus_words":["宝山"]},{"speaker":"B","line_target":"密不可分 は 何ですか。","line_vi":"密不可分 là cái gì?","focus_words":["密不可分"]},{"speaker":"A","line_target":"察觉到です。","line_vi":"Đó là 察觉到.","focus_words":["察觉到"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_af9502f8","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「宝山」 có nghĩa là gì?","options":["Bảo Sơn","không thể tách rời","nhận thức được","hướng dẫn"],"answer_index":0,"explanation":"宝山 = Bảo Sơn"},{"question":"Từ 「密不可分」 có nghĩa là gì?","options":["không thể tách rời","Bảo Sơn","nhận thức được","hướng dẫn"],"answer_index":0,"explanation":"密不可分 = không thể tách rời"},{"question":"Từ 「察觉到」 có nghĩa là gì?","options":["nhận thức được","Bảo Sơn","không thể tách rời","hướng dẫn"],"answer_index":0,"explanation":"察觉到 = nhận thức được"},{"question":"Từ 「导引」 có nghĩa là gì?","options":["hướng dẫn","Bảo Sơn","không thể tách rời","nhận thức được"],"answer_index":0,"explanation":"导引 = hướng dẫn"},{"question":"Từ 「导火线」 có nghĩa là gì?","options":["cầu chì","Bảo Sơn","không thể tách rời","nhận thức được"],"answer_index":0,"explanation":"导火线 = cầu chì"},{"question":"Từ 「小字」 có nghĩa là gì?","options":["chữ in nhỏ","Bảo Sơn","không thể tách rời","nhận thức được"],"answer_index":0,"explanation":"小字 = chữ in nhỏ"},{"question":"Từ 「小学校」 có nghĩa là gì?","options":["trường tiểu học","Bảo Sơn","không thể tách rời","nhận thức được"],"a