gày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1185","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"河里を 使います。","line_vi":"Tôi dùng 河里.","focus_words":["河里"]},{"speaker":"B","line_target":"洗衣机 は 何ですか。","line_vi":"洗衣机 là cái gì?","focus_words":["洗衣机"]},{"speaker":"A","line_target":"涌入です。","line_vi":"Đó là 涌入.","focus_words":["涌入"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5c54f75e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「河里」 có nghĩa là gì?","options":["con sông","máy giặt","sự tràn vào","biển sâu"],"answer_index":0,"explanation":"河里 = con sông"},{"question":"Từ 「洗衣机」 có nghĩa là gì?","options":["máy giặt","con sông","sự tràn vào","biển sâu"],"answer_index":0,"explanation":"洗衣机 = máy giặt"},{"question":"Từ 「涌入」 có nghĩa là gì?","options":["sự tràn vào","con sông","máy giặt","biển sâu"],"answer_index":0,"explanation":"涌入 = sự tràn vào"},{"question":"Từ 「深海」 có nghĩa là gì?","options":["biển sâu","con sông","máy giặt","sự tràn vào"],"answer_index":0,"explanation":"深海 = biển sâu"},{"question":"Từ 「满族」 có nghĩa là gì?","options":["Mãn Châu","con sông","máy giặt","sự tràn vào"],"answer_index":0,"explanation":"满族 = Mãn Châu"},{"question":"Từ 「潇洒」 có nghĩa là gì?","options":["sang trọng","con sông","máy giặt","sự tràn vào"],"answer_index":0,"explanation":"潇洒 = sang trọng"},{"question":"Từ 「物件」 có nghĩa là gì?","options":["vật thể","con sông","máy giặt","sự tràn vào"],"answer_index":0,"explanation":"物件 = vật thể"},{"question":"Từ 「现货」 có nghĩa là gì?","options":["tại chỗ","con sông","máy giặt","sự tràn v