"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_b7a15aa8","audio_ref":"m_670123d7","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_f0fa23b8"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1157","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"分红を 使います。","line_vi":"Tôi dùng 分红.","focus_words":["分红"]},{"speaker":"B","line_target":"刺客 は 何ですか。","line_vi":"刺客 là cái gì?","focus_words":["刺客"]},{"speaker":"A","line_target":"剧目です。","line_vi":"Đó là 剧目.","focus_words":["剧目"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_32eaea3e","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「分红」 có nghĩa là gì?","options":["cổ tức","sát thủ","tiết mục","gấp đôi"],"answer_index":0,"explanation":"分红 = cổ tức"},{"question":"Từ 「刺客」 có nghĩa là gì?","options":["sát thủ","cổ tức","tiết mục","gấp đôi"],"answer_index":0,"explanation":"刺客 = sát thủ"},{"question":"Từ 「剧目」 có nghĩa là gì?","options":["tiết mục","cổ tức","sát thủ","gấp đôi"],"answer_index":0,"explanation":"剧目 = tiết mục"},{"question":"Từ 「加倍」 có nghĩa là gì?","options":["gấp đôi","cổ tức","sát thủ","tiết mục"],"answer_index":0,"explanation":"加倍 = gấp đôi"},{"question":"Từ 「劫持」 có nghĩa là gì?","options":["Cướp","cổ tức","sát thủ","tiết mục"],"answer_index":0,"explanation":"劫持 = Cướp"},{"question":"Từ 「勒索」 có nghĩa là gì?","options":["tống tiền","cổ tức","sát thủ","tiết mục"],"answer_index":0,"explanation":"勒索 = tống tiền"},{"question":"Từ 「化名」 có nghĩa là gì?","options":["bút danh","cổ tức","sát thủ","tiết mục"],"answer_index":0,"explanation":"化名 = bút danh"},{"question":"Từ 「口腔」 có nghĩa là gì?","options":["khoang miệng","cổ tức","sát thủ","tiết mục"],"answer_index":0,"explanation":"口腔 = khoang miệng"}],"pattern":[{"question":"Chọn từ đúng ch