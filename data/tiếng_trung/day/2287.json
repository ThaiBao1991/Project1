yllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_8b752ab3","audio_ref":"m_d5b6d7cb","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_5966751e"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ưu tiên đối tượng bằng は / が","level":"N4","explanation":"は nhấn mạnh CHỦ THỂ mới; ga nhấn mạnh CHỦ NGỮ (thông tin mới).","examples":[{"sentence":"象は大きい。","meaning_vi":"Con voi thì to."},{"sentence":"象がいます。","meaning_vi":"Có con voi."}],"pronunciation_focus":"は cho thông tin cũ, が cho thông tin mới.","common_mistakes":"Đừng dùng は khi giới thiệu người mới gặp lần đầu (⇒ が).","mini_quiz":[{"question":"これは私___ です。","options":["は","を","から"],"answer_index":0,"explanation":"Đáp án: は"}],"references":[]},{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2287","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"代表人を 使います。","line_vi":"Tôi dùng 代表人.","focus_words":["代表人"]},{"speaker":"B","line_target":"令人满意 は 何ですか。","line_vi":"令人满意 là cái gì?","focus_words":["令人满意"]},{"speaker":"A","line_target":"企业主です。","line_vi":"Đó là 企业主.","focus_words":["企业主"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c5cb57b6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「代表人」 có nghĩa là gì?","options":["Đại diện","thỏa đáng","chủ doanh nghiệp","nghỉ ngơi"],"answer_index":0,"explanation":"代表人 = Đại diện"},{"question":"Từ 「令人满意」 có nghĩa là gì?","options":["thỏa đáng","Đại diện","chủ doanh nghiệp","nghỉ ngơi"],"answer_index":0,"explanation":"令人满意 = thỏa đáng"},{"question":"Từ 「企业主」 có nghĩa là gì?","options":["chủ doanh nghiệp","Đại diện","thỏa đáng","nghỉ ngơi"],"answer_index":0,"explanation":"企业主 = chủ doanh nghiệp"},{"question":"Từ 「休憩」 có nghĩa là gì?","options":["nghỉ ngơi","Đại diện","thỏa đáng","chủ doanh nghiệp"],"answer_index":0,"explanation":"休憩 = nghỉ ngơi"},{"question":"Từ 「伸进」 có nghĩa là gì?","options":["tiếp cận","Đại diện","thỏa đáng","chủ doanh nghiệp"],"answer_index":0,"explanation":"伸进 = tiếp cận"},{"question":"Từ 「佛塔」 có nghĩa là gì?","options":["chùa","Đại diện","thỏa đáng","chủ doanh nghiệp"],"answer_index":0,"explanation":"佛塔 = chùa"},{"question":"Từ 「佛祖」 có nghĩa là gì?","options":["Phật","Đại diện","thỏa đáng","chủ doanh nghiệp"],"answer_index":0,"explanation":"佛祖 = Phật"},{"question"