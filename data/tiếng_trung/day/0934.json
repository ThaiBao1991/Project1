unciation_focus":"Động từ ichidan thêm ます; godan đổi e/i → imasu.","common_mistakes":"Đừng dùng ます khi nói với bạn bè hoặc khi kể chuyện quá khứ.","mini_quiz":[{"question":"___ ます (lịch sự)","options":["食べ","食べます","食べた"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 934","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"二世を 使います。","line_vi":"Tôi dùng 二世.","focus_words":["二世"]},{"speaker":"B","line_target":"二十四 は 何ですか。","line_vi":"二十四 là cái gì?","focus_words":["二十四"]},{"speaker":"A","line_target":"五名です。","line_vi":"Đó là 五名.","focus_words":["五名"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_571fee76","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「二世」 có nghĩa là gì?","options":["II","hai mươi bốn","năm","vợ"],"answer_index":0,"explanation":"二世 = II"},{"question":"Từ 「二十四」 có nghĩa là gì?","options":["hai mươi bốn","II","năm","vợ"],"answer_index":0,"explanation":"二十四 = hai mươi bốn"},{"question":"Từ 「五名」 có nghĩa là gì?","options":["năm","II","hai mươi bốn","vợ"],"answer_index":0,"explanation":"五名 = năm"},{"question":"Từ 「人妻」 có nghĩa là gì?","options":["vợ","II","hai mươi bốn","năm"],"answer_index":0,"explanation":"人妻 = vợ"},{"question":"Từ 「以防」 có nghĩa là gì?","options":["Chỉ trong trường hợp","II","hai mươi bốn","năm"],"answer_index":0,"explanation":"以防 = Chỉ trong trường hợp"},{"question":"Từ 「伤人」 có nghĩa là gì?","options":["gây tổn thương","II","hai mươi bốn","năm"],"answer_index":0,"explanation":"伤人 = gây tổn thương"},{"question":"Từ 「住户」 có nghĩa là gì?","options":["cư dân","II","hai mươi bốn","năm"],"answer_index":0,"explanation":"住户 = cư dân"},{"question":"Từ 「信息化」 có nghĩa là gì?","options":["tin học hóa","II","hai mươi bốn","năm"],"answer_index":0,"explanation":