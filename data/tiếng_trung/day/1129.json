i hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Khác với ました ở dạng lịch sự.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1129","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"阿布を 使います。","line_vi":"Tôi dùng 阿布.","focus_words":["阿布"]},{"speaker":"B","line_target":"降雨 は 何ですか。","line_vi":"降雨 là cái gì?","focus_words":["降雨"]},{"speaker":"A","line_target":"雷锋です。","line_vi":"Đó là 雷锋.","focus_words":["雷锋"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_eca3cd46","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「阿布」 có nghĩa là gì?","options":["Abu","lượng mưa","Lôi Phong","không chính thức"],"answer_index":0,"explanation":"阿布 = Abu"},{"question":"Từ 「降雨」 có nghĩa là gì?","options":["lượng mưa","Abu","Lôi Phong","không chính thức"],"answer_index":0,"explanation":"降雨 = lượng mưa"},{"question":"Từ 「雷锋」 có nghĩa là gì?","options":["Lôi Phong","Abu","lượng mưa","không chính thức"],"answer_index":0,"explanation":"雷锋 = Lôi Phong"},{"question":"Từ 「非正式」 có nghĩa là gì?","options":["không chính thức","Abu","lượng mưa","Lôi Phong"],"answer_index":0,"explanation":"非正式 = không chính thức"},{"question":"Từ 「顺治」 có nghĩa là gì?","options":["Thuận Trị","Abu","lượng mưa","Lôi Phong"],"answer_index":0,"explanation":"顺治 = Thuận Trị"},{"question":"Từ 「预告片」 có nghĩa là gì?","options":["xe kéo","Abu","lượng mưa","Lôi Phong"],"answer_index":0,"explanation":"预告片 = xe kéo"},{"question":"Từ 「风景区」 có nghĩa là gì?","options":["Khu thắng cảnh","Abu","lượng mưa","Lô