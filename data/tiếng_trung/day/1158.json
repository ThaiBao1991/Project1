netic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f7cfc6d9","audio_ref":"m_b562502c","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_4e6c7f8c"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1158","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"启程を 使います。","line_vi":"Tôi dùng 启程.","focus_words":["启程"]},{"speaker":"B","line_target":"商务部 は 何ですか。","line_vi":"商务部 là cái gì?","focus_words":["商务部"]},{"speaker":"A","line_target":"商学院です。","line_vi":"Đó là 商学院.","focus_words":["商学院"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1af45bc7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「启程」 có nghĩa là gì?","options":["Khởi hành","Bộ Thương mại","trường kinh doanh","phun trào"],"answer_index":0,"explanation":"启程 = Khởi hành"},{"question":"Từ 「商务部」 có nghĩa là gì?","options":["Bộ Thương mại","Khởi hành","trường kinh doanh","phun trào"],"answer_index":0,"explanation":"商务部 = Bộ Thương mại"},{"question":"Từ 「商学院」 có nghĩa là gì?","options":["trường kinh doanh","Khởi hành","Bộ Thương mại","phun trào"],"answer_index":0,"explanation":"商学院 = trường kinh doanh"},{"question":"Từ 「喷发」 có nghĩa là gì?","options":["phun trào","Khởi hành","Bộ Thương mại","trường kinh doanh"],"answer_index":0,"explanation":"喷发 = phun trào"},{"question":"Từ 「嘉兴」 có nghĩa là gì?","options":["Gia Hưng","Khởi hành","Bộ Thương mại","trường kinh doanh"],"answer_index":0,"explanation":"嘉兴 = Gia Hưng"},{"question":"Từ 「嘉年华」 có nghĩa là gì?","options":["lễ hội","Khởi hành","Bộ Thương mại","trường kinh doanh"],"answer_index":0,"explanation":"嘉年华 = lễ hội"},{"question":"Từ 「四肢」 có nghĩa là gì?","options":["tay chân","Khởi hành","Bộ Thương mại","trường kinh doanh"],"answer_index":0,"explanation":