":"Tôi học tới 5 giờ."},{"sentence":"九時から働きます。","meaning_vi":"Tôi làm việc từ 9 giờ."}],"pronunciation_focus":"Hai từ đều đọc 'kara' ở cuối? (から = kara, まで = made).","common_mistakes":"Đừng dùng から với mốc thời gian kết thúc.","mini_quiz":[{"question":"五時___勉強します。","options":["まで","から","に"],"answer_index":0,"explanation":"Đáp án: まで"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1352","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"内向を 使います。","line_vi":"Tôi dùng 内向.","focus_words":["内向"]},{"speaker":"B","line_target":"几条 は 何ですか。","line_vi":"几条 là cái gì?","focus_words":["几条"]},{"speaker":"A","line_target":"凯尔です。","line_vi":"Đó là 凯尔.","focus_words":["凯尔"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_20e2cde6","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「内向」 có nghĩa là gì?","options":["sự hướng nội","một số","Kyle","phân phối"],"answer_index":0,"explanation":"内向 = sự hướng nội"},{"question":"Từ 「几条」 có nghĩa là gì?","options":["một số","sự hướng nội","Kyle","phân phối"],"answer_index":0,"explanation":"几条 = một số"},{"question":"Từ 「凯尔」 có nghĩa là gì?","options":["Kyle","sự hướng nội","một số","phân phối"],"answer_index":0,"explanation":"凯尔 = Kyle"},{"question":"Từ 「分给」 có nghĩa là gì?","options":["phân phối","sự hướng nội","một số","Kyle"],"answer_index":0,"explanation":"分给 = phân phối"},{"question":"Từ 「剑桥大学」 có nghĩa là gì?","options":["Đại học Cambridge","sự hướng nội","một số","Kyle"],"answer_index":0,"explanation":"剑桥大学 = Đại học Cambridge"},{"question":"Từ 「匕首」 có nghĩa là gì?","options":["dao găm","sự hướng nội","một số","Kyle"],"answer_index":0,"explanation":"匕首 = dao găm"},{"question":"Từ 「北海道」 có nghĩa là gì?","options":["Hokkaido","sự hướng nội","một số","Kyle"],"answer_index":0,"explanation":"北海道 = Hok