tence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_1d8a0033","audio_ref":"m_ed45c113","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_4c46d2fd"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1187","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"神灵を 使います。","line_vi":"Tôi dùng 神灵.","focus_words":["神灵"]},{"speaker":"B","line_target":"科幻 は 何ですか。","line_vi":"科幻 là cái gì?","focus_words":["科幻"]},{"speaker":"A","line_target":"突尼斯です。","line_vi":"Đó là 突尼斯.","focus_words":["突尼斯"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_af1b051b","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「神灵」 có nghĩa là gì?","options":["vị thần","khoa học viễn tưởng","Tunisia","đàng hoàng"],"answer_index":0,"explanation":"神灵 = vị thần"},{"question":"Từ 「科幻」 có nghĩa là gì?","options":["khoa học viễn tưởng","vị thần","Tunisia","đàng hoàng"],"answer_index":0,"explanation":"科幻 = khoa học viễn tưởng"},{"question":"Từ 「突尼斯」 có nghĩa là gì?","options":["Tunisia","vị thần","khoa học viễn tưởng","đàng hoàng"],"answer_index":0,"explanation":"突尼斯 = Tunisia"},{"question":"Từ 「端的」 có nghĩa là gì?","options":["đàng hoàng","vị thần","khoa học viễn tưởng","Tunisia"],"answer_index":0,"explanation":"端的 = đàng hoàng"},{"question":"Từ 「细微」 có nghĩa là gì?","options":["tinh tế","vị thần","khoa học viễn tưởng","Tunisia"],"answer_index":0,"explanation":"细微 = tinh tế"},{"question":"Từ 「终年」 có nghĩa là gì?","options":["quanh năm","vị thần","khoa học viễn tưởng","Tunisia"],"answer_index":0,"explanation":"终年 = quanh năm"},{"question":"Từ 「维族」 có nghĩa là gì?","options":["người Duy Ngô Nhĩ","vị thần","khoa học viễn tưởng","Tunisia"],"answer_index"