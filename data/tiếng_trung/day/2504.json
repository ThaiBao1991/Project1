 được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2504","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"建言を 使います。","line_vi":"Tôi dùng 建言.","focus_words":["建言"]},{"speaker":"B","line_target":"开导 は 何ですか。","line_vi":"开导 là cái gì?","focus_words":["开导"]},{"speaker":"A","line_target":"异物です。","line_vi":"Đó là 异物.","focus_words":["异物"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5cd7e694","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「建言」 có nghĩa là gì?","options":["Đề xuất","soi sáng","Vật lạ","tìm ra nó"],"answer_index":0,"explanation":"建言 = Đề xuất"},{"question":"Từ 「开导」 có nghĩa là gì?","options":["soi sáng","Đề xuất","Vật lạ","tìm ra nó"],"answer_index":0,"explanation":"开导 = soi sáng"},{"question":"Từ 「异物」 có nghĩa là gì?","options":["Vật lạ","Đề xuất","soi sáng","tìm ra nó"],"answer_index":0,"explanation":"异物 = Vật lạ"},{"question":"Từ 「弄清楚」 có nghĩa là gì?","options":["tìm ra nó","Đề xuất","soi sáng","Vật lạ"],"answer_index":0,"explanation":"弄清楚 = tìm ra nó"},{"question":"Từ 「弗格森」 có nghĩa là gì?","options":["ferguson","Đề xuất","soi sáng","Vật lạ"],"answer_index":0,"explanation":"弗格森 = ferguson"},{"question":"Từ 「弹匣」 có nghĩa là gì?","options":["tạp chí","Đề xuất","soi sáng","Vật lạ"],"answer_index":0,"explanation":"弹匣 = tạp chí"},{"question":"Từ 「强迫症」 có nghĩa là gì?","options":["rối loạn ám ảnh cưỡng chế