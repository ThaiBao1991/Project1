vel":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1639","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"承袭を 使います。","line_vi":"Tôi dùng 承袭.","focus_words":["承袭"]},{"speaker":"B","line_target":"抑郁症 は 何ですか。","line_vi":"抑郁症 là cái gì?","focus_words":["抑郁症"]},{"speaker":"A","line_target":"投保です。","line_vi":"Đó là 投保.","focus_words":["投保"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_a8751496","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「承袭」 có nghĩa là gì?","options":["kế thừa","trầm cảm","bảo hiểm","sự khúc xạ"],"answer_index":0,"explanation":"承袭 = kế thừa"},{"question":"Từ 「抑郁症」 có nghĩa là gì?","options":["trầm cảm","kế thừa","bảo hiểm","sự khúc xạ"],"answer_index":0,"explanation":"抑郁症 = trầm cảm"},{"question":"Từ 「投保」 có nghĩa là gì?","options":["bảo hiểm","kế thừa","trầm cảm","sự khúc xạ"],"answer_index":0,"explanation":"投保 = bảo hiểm"},{"question":"Từ 「折射」 có nghĩa là gì?","options":["sự khúc xạ","kế thừa","trầm cảm","bảo hiểm"],"answer_index":0,"explanation":"折射 = sự khúc xạ"},{"question":"Từ 「挚爱」 có nghĩa là gì?","options":["người yêu dấu","kế thừa","trầm cảm","bảo hiểm"],"answer_index":0,"explanation":"挚爱 = người yêu dấu"},{"question":"Từ 「推介」 có nghĩa là gì?","options":["Đề nghị","kế thừa","trầm cảm","bảo hiểm"],"answer_index":0,"explanation":"推介 = Đề ng