chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1999","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"衰弱を 使います。","line_vi":"Tôi dùng 衰弱.","focus_words":["衰弱"]},{"speaker":"B","line_target":"裁减 は 何ですか。","line_vi":"裁减 là cái gì?","focus_words":["裁减"]},{"speaker":"A","line_target":"装机です。","line_vi":"Đó là 装机.","focus_words":["装机"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_56cb726f","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「衰弱」 có nghĩa là gì?","options":["yếu","cắt","Cài đặt","kiếm ăn"],"answer_index":0,"explanation":"衰弱 = yếu"},{"question":"Từ 「裁减」 có nghĩa là gì?","options":["cắt","yếu","Cài đặt","kiếm ăn"],"answer_index":0,"explanation":"裁减 = cắt"},{"question":"Từ 「装机」 có nghĩa là gì?","options":["Cài đặt","yếu","cắt","kiếm ăn"],"answer_index":0,"explanation":"装机 = Cài đặt"},{"question":"Từ 「觅食」 có nghĩa là gì?","options":["kiếm ăn","yếu","cắt","Cài đặt"],"answer_index":0,"explanation":"觅食 = kiếm ăn"},{"question":"Từ 「警犬」 có nghĩa là gì?","options":["chó cảnh sát","yếu","cắt","Cài đặt"],"answer_index":0,"explanation":"警犬 = chó cảnh sát"},{"question":"Từ 「议政」 có nghĩa là gì?","options":["Thảo luận chính trị","yếu","cắt","Cài đặt"],"answer_index":0,"explanation":"议政 = Thảo luận chính trị"},{"question":"Từ 「证言」 có nghĩa là gì?","options":["lời