ences":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 533","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"你家を 使います。","line_vi":"Tôi dùng 你家.","focus_words":["你家"]},{"speaker":"B","line_target":"修理 は 何ですか。","line_vi":"修理 là cái gì?","focus_words":["修理"]},{"speaker":"A","line_target":"元首です。","line_vi":"Đó là 元首.","focus_words":["元首"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_aa51981a","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「你家」 có nghĩa là gì?","options":["nhà của bạn","sửa chữa","nguyên thủ quốc gia","sự rực rỡ"],"answer_index":0,"explanation":"你家 = nhà của bạn"},{"question":"Từ 「修理」 có nghĩa là gì?","options":["sửa chữa","nhà của bạn","nguyên thủ quốc gia","sự rực rỡ"],"answer_index":0,"explanation":"修理 = sửa chữa"},{"question":"Từ 「元首」 có nghĩa là gì?","options":["nguyên thủ quốc gia","nhà của bạn","sửa chữa","sự rực rỡ"],"answer_index":0,"explanation":"元首 = nguyên thủ quốc gia"},{"question":"Từ 「光辉」 có nghĩa là gì?","options":["sự rực rỡ","nhà của bạn","sửa chữa","nguyên thủ quốc gia"],"answer_index":0,"explanation":"光辉 = sự rực rỡ"},{"question":"Từ 「公认」 có nghĩa là gì?","options":["được công nhận","nhà của bạn","sửa chữa","nguyên thủ quốc gia"],"answer_index":0,"explanation":"公认 = được cô