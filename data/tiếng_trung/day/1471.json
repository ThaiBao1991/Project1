c động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1471","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"不留を 使います。","line_vi":"Tôi dùng 不留.","focus_words":["不留"]},{"speaker":"B","line_target":"不知情 は 何ですか。","line_vi":"不知情 là cái gì?","focus_words":["不知情"]},{"speaker":"A","line_target":"不顺です。","line_vi":"Đó là 不顺.","focus_words":["不顺"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_0c8e2c52","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「不留」 có nghĩa là gì?","options":["không ở lại","Không biết","Không ổn","kinh độ đông"],"answer_index":0,"explanation":"不留 = không ở lại"},{"question":"Từ 「不知情」 có nghĩa là gì?","options":["Không biết","không ở lại","Không ổn","kinh độ đông"],"answer_index":0,"explanation":"不知情 = Không biết"},{"question":"Từ 「不顺」 có nghĩa là gì?","options":["Không ổn","không ở lại","Không biết","kinh độ đông"],"answer_index":0,"explanation":"不顺 = Không ổn"},{"question":"Từ 「东经」 có nghĩa là gì?","options":["kinh độ đông","không ở lại","Không biết","Không ổn"],"answer_index":0,"explanation":"东经 = kinh độ đông"},{"question":"Từ 「两手」 có nghĩa là gì?","options":["cả hai tay","không ở lại","Không biết","Không ổn"],"answer_index":0,"explanation":"两手 = cả hai tay"},{"question":"Từ 「两组」 có nghĩa là gì?","options":["hai nhóm","không ở lại","Không biết","Không ổn"],"answer_index":0,"explanation":"两组 = hai nhóm"},{"question":"Từ 「个股」 có nghĩa là gì?","options":["cổ phiếu riêng lẻ","khôn