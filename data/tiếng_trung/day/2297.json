ce":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_8e18399c","audio_ref":"m_73d566ca","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_65cdbd36"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]},{"title":"Thì quá khứ (đã...)","level":"N4","explanation":"Thêm ました vào động từ gốc để nói việc đã xảy ra.","examples":[{"sentence":"昨日、学校に行きました。","meaning_vi":"Hôm qua tôi đi trường."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]},{"title":"Trợ từ ば (nếu...)","level":"N4","explanation":"は + ば = 'nếu... thì': 雨が降れば、行きません.","examples":[{"sentence":"雨が降れば、行きません。","meaning_vi":"Nếu trời mưa thì tôi không đi."},{"sentence":"安ければ、買います。","meaning_vi":"Nếu rẻ thì tôi mua."}],"pronunciation_focus":"Đọc 'ba'.","common_mistakes":"Không dùng ば để nói 'vì' ở mệnh đề phức.","mini_quiz":[{"question":"雨が___、行きません。","options":["れば","たら","なら"],"answer_index":0,"explanation":"Đáp án: れば"}],"references":[]}],"dialogue":[{"title":"Như người bản xứ — Ngày 2297","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"守备を 使います。","line_vi":"Tôi dùng 守备.","focus_words":["守备"]},{"speaker":"B","line_target":"安全部门 は 何ですか。","line_vi":"安全部门 là cái gì?","focus_words":["安全部门"]},{"speaker":"A","line_target":"安然无恙です。","line_vi":"Đó là 安然无恙.","focus_words":["安然无恙"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c9e5cbcc","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「守备」 có nghĩa là gì?","options":["bảo vệ","bộ phận an ninh","an toàn và âm thanh","dễ chịu"],"answer_index":0,"explanation":"守备 = bảo vệ"},{"question":"Từ 「安全部门」 có nghĩa là gì?","options":["bộ phận an ninh","bảo vệ","an toàn và âm thanh","dễ chịu"],"answer_index":0,"explanation":"安全部门 = bộ phận an ninh"},{"question":"Từ 「安然无恙」 có nghĩa là gì?","options":["an toàn và âm thanh","bảo vệ","bộ phận an ninh","dễ chịu"],"answer_index":0,"explanation":"安然无恙 = an toàn và âm thanh"},{"question":"Từ 「宜人」 có nghĩa là gì?","options":["dễ chịu","bảo vệ","bộ phận an ninh","an toàn và âm thanh"],"answer_index":0,"explanation":"宜人 = dễ chịu"},{"question":"Từ 「富农」 có nghĩa là gì?","options":["nông dân giàu có","bảo vệ","bộ phận an ninh","an toàn và âm thanh"],"answer_index":0,"explanation":"富农 = nông dân giàu có"},{"question":"Từ 「小川」 có nghĩa là gì?","options":["Ogawa","bảo vệ","bộ phận an ninh","an toàn và âm thanh"],"answer_index":0,"explanation":"小川 = Ogawa"},{"question":"Từ 「小钱」 có nghĩa là gì?","options":["số tiền nhỏ","bảo vệ","bộ phận an ninh","an toàn và âm thanh"],"answer_index":0,"explanation":"小钱 = số tiền nhỏ"},{"question":"Từ 「嵌入式」 có nghĩa là gì?","options":["Đã nhúng","bảo vệ","bộ phận an ninh","an toàn và âm thanh"],"answer_index":0,"explanation":"嵌入式 = Đã nhúng"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: bảo vệ","options":["守备","安全部门","安然无恙","宜人"],"answer_index":0,"explanation":"守备 = bảo vệ"},{"question":"Chọn từ đúng cho nghĩa: bộ phận an ninh","options":["安全部门","守备","安然无恙","宜人"],"answer_index":0,"explanation":"安全部门 = bộ phận an ninh"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"守备":"m_a12c2735","安全部门":"m_c94d16ce","安然无恙":"m_a8c77503","宜人":"m_6ab3c4fc","富农":"m_231c599d","小川":"m_954041a6","小钱":"m_8e9db8c7","嵌入式":"m_c17b3b45","工兵":"m_c3fb3f23","工程技术":"m_73d566ca"},"dialogue_audio":{"0":"m_c9e5cbcc"}},"media_map":{"m_5c7cbc0d":"media/tiếng_trung/d2297/word_00_8a7c41a5.webp","m_6761ef93":"media/tiếng_trung/d2297/word_01_85068881.webp","m_a40a4e78":"media/tiếng_trung/d2297/word_02_02caf203.webp","m_19b8faf6":"media/tiếng_trung/d2297/word_03_923d6da2.webp","m_67f75f3a":"media/tiếng_trung/d2297/word_04_4624f2c7.webp","m_258f972e":"media/tiếng_trung/d2297/word_05_946765b7.webp","m_c61c8dae":"media/tiếng_trung/d2297/word_06_983fe18b.webp","m_41d5b206":"media/tiếng_trung/d2297/word_07_573c45a6.webp","m_620adc85":"media/tiếng_trung/d2297/word_08_95e21f6e.webp","m_8e18399c":"media/tiếng_trung/d2297/word_09_31c3b5b2.webp","m_a12c2735":"media/tiếng_trung/d2297/audio_vocab_00_de48b0dc.mp3","m_6719b8ad":"media/tiếng_trung/d2297/audio_vocab_00_vi_6329f14f.mp3","m_c94d16ce":"media/tiếng_trung/d2297/audio_vocab_01_ee18801a.mp3","m_49a8baa8":"media/tiếng_trung/d2297/audio_vocab_01_vi_ee18801a.mp3","m_a8c77503":"media/tiếng_trung/d2297/audio_vocab_02_8bf0ef88.mp3","m_354c7fec":"media/tiếng_trung/d2297/audio_vocab_02_vi_74e9efac.mp3","m_6ab3c4fc":"media/tiếng_trung/d2297/audio_vocab_03_a5026f05.mp3","m_9442ef28":"media/tiếng_trung/d2297/audio_vocab_03_vi_a5026f05.mp3","m_231c59