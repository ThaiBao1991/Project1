ote":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d85ffd9d","audio_ref":"m_9fde301d","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_528a4a21"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]},{"title":"Cấu trúc 〜はず","level":"N1","explanation":"〜はず = chắc là (có cơ sở suy luận): 彼は来ないはずです.","examples":[{"sentence":"彼は来ないはずです。","meaning_vi":"Chắc anh ấy sẽ không đến."},{"sentence":"明日は雨はずです。","meaning_vi":"Ngày mai chắc trời mưa."}],"pronunciation_focus":"〜はず = theo dự đoán có cơ sở.","common_mistakes":"Không dùng khi không có cơ sở suy luận.","mini_quiz":[{"question":"彼は来ない___。","options":["はずです","でしょう","かもしれません"],"answer_index":0,"explanation":"Đáp án: はずです"}],"references":[]},{"title":"Cấu trúc 〜 makenai (chắc chắn là không)","level":"N1","explanation":"〜 makenai = chắc chắn là không: それは必要ない makenai.","examples":[{"sentence":"彼は artist ではない。","meaning_vi":"Chắc anh ấy không phải nghệ sĩ."},{"sentence":"静かだ wanakaru. ではない。","meaning_vi":"Nó chắc chắn không yên tĩnh."}],"pronunciation_focus":"〜makenai = chắc chắn là không.","common_mistakes":"Không dùng khi chưa có bằng chứng.","mini_quiz":[{"question":"彼は artist___。","options":["ではない","だ","ではない"],"answer_index":0,"explanation":"Đáp án: ではない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 904","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"人情を 使います。","line_vi":"Tôi dùng 人情.","focus_words":["人情"]},{"speaker":"B","line_target":"传教士 は 何ですか。","line_vi":"传教士 là cái gì?","focus_words":["传教士"]},{"speaker":"A","line_target":"修养です。","line_vi":"Đó là 修养.","focus_words":["修养"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_e564d4e7","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「人情」 có nghĩa là gì?","options":["ủng hộ","nhà truyền giáo","trồng trọt","Độ lệch"],"answer_index":0,"explanation":"人情 = ủng hộ"},{"question":"Từ 「传教士」 có nghĩa là gì?","options":["nhà truyền giáo","ủng hộ","trồng trọt","Độ lệch"],"answer_index":0,"explanation":"传教士 = nhà truyền giáo"},{"question":"Từ 「修养」 có nghĩa là gì?","options":["trồng trọt","ủng hộ","nhà truyền giáo","Độ lệch"],"answer_index":0,"explanation":"修养 = trồng trọt"},{"question":"Từ 「偏差」 có nghĩa là gì?","options":["Độ lệch","ủng hộ","nhà truyền giáo","trồng trọt"],"answer_index":0,"explanation":"偏差 = Độ lệch"},{"question":"Từ 「光是」 có nghĩa là gì?","options":["chỉ","ủng hộ","nhà truyền giáo","trồng trọt"],"answer_index":0,"explanation":"光是 = chỉ"},{"question":"Từ 「入门」 có nghĩa là gì?","options":["Bắt đầu","ủng hộ","nhà truyền giáo","trồng trọt"],"an