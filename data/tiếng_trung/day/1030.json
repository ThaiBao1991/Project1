":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_ee6279a6","audio_ref":"m_b2240d63","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_81561bc4"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Mệnh đề điều kiện (〜ば / と / たら)","level":"N3","explanation":"Ba cách diễn đạt điều kiện: 〜ば (khi), 〜と (vừa... thì), 〜たら (nếu... thì).","examples":[{"sentence":"雨が降ったら、知らせてください。","meaning_vi":"Nếu trời mưa, hãy báo tôi."},{"sentence":"春になったら、旅行に行きます。","meaning_vi":"Khi xuân đến, tôi sẽ đi du lịch."}],"pronunciation_focus":"〜たら đứng sau thì động từ.","common_mistakes":"Đừng dùng と sau câu ngữ pháp phức tạp.","mini_quiz":[{"question":"雨が___、行きません。","options":["降ったら","降ると","降ればたら"],"answer_index":0,"explanation":"Đáp án: 降ったら"}],"references":[]},{"title":"Cấu trúc nguyên nhân (〜ので / 〜から)","level":"N3","explanation":"Vế nguyên nhân + ので/から + vế kết quả: 雨なので、行きません.","examples":[{"sentence":"雨なので、行きません。","meaning_vi":"Vì trời mưa nên tôi không đi."},{"sentence":"忙しいから、休みません。","meaning_vi":"Vì bận nên tôi không nghỉ."}],"pronunciation_focus":"ん de → ので; から đứng sau danh từ.","common_mistakes":"Không dùng ので để nối hai mệnh lệnh (⇒ から).","mini_quiz":[{"question":"雨___、行きません。","options":["なので","だから","けれど"],"answer_index":0,"explanation":"Đáp án: なので"}],"references":[]},{"title":"Cấu trúc mục đích (〜ために)","level":"N3","explanation":"Vì mục đích nên: 日本語を学ぶために、日本に来ました.","examples":[{"sentence":"日本語を学ぶために、日本に来ました。","meaning_vi":"Tôi đến Nhật để học tiếng Nhật."},{"sentence":"会議のために、出張します。","meaning_vi":"Tôi đi công tác vì họp."}],"pronunciation_focus":"Cụm 〜ため đặt trước danh từ.","common_mistakes":"Không dùng ために sau chủ ngữ người.","mini_quiz":[{"question":"日本語を学ぶ___、日本に来ました。","options":["ために","ので","から"],"answer_index":0,"explanation":"Đáp án: ために"}],"references":[]},{"title":"Thể tiếp nhận (passive)","level":"N3","explanation":"Hậu tố られる/れる: 呼ばれる = được gọi; 書かれる = được viết.","examples":[{"sentence":"日本から呼ばれています。","meaning_vi":"Tôi được gọi từ Nhật."},{"sentence":"この本は多くの人に読まれています。","meaning_vi":"Cuốn sách này được nhiều người đọc."}],"pronunciation_focus":"Thể tiếp nhận (potential) — bị động.","common_mistakes":"Đừng lẫn với thể bị động ngoại động từ.","mini_quiz":[{"question":"彼は学生___。","options":["です","されます","ます"],"answer_index":0,"explanation":"Đáp án: です"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1030","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"那一刻を 使います。","line_vi":"Tôi dùng 那一刻.","focus_words":["那一刻"]},{"speaker":"B","line_target":"金星 は 何ですか。","line_vi":"金星 là cái gì?","focus_words":["金星"]},{"speaker":"A","line_target":"闪耀です。","line_vi":"Đó là 闪耀.","focus_words":["闪耀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_40cd4d30","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「那一刻」 có nghĩa là gì?","options":["khoảnh khắc đó","Sao Kim","tỏa sáng","Yahoo"],"answer_index":0,"explanation":"那一刻 = khoảnh khắc đó"},{"question":"Từ 「金星」 có nghĩa là gì?","options":["Sao Kim","khoảnh khắc đó","tỏa sáng","Yahoo"],"answer_index":0,"explanation":"金星 = Sao Kim"},{"question":"Từ 「闪耀」 có nghĩa là gì?","options":["tỏa sáng","khoảnh khắc đó","Sao Kim","Yahoo"],"answer_index":0,"explanation":"闪耀 = tỏa sáng"},{"question":"Từ 「雅虎」 có nghĩa là gì?","options":["Yahoo","khoảnh khắc đó","Sao Kim","tỏa sáng"],"answer_index":0,"explanation":"雅虎 = Yahoo"},{"question":"Từ 「霍尔」 có nghĩa là gì?","options":["Hội trường","khoảnh khắc đó","Sao Kim","tỏa sáng"],"answer_index":0,"explanation":"霍尔 = Hội trường"},{"question":"Từ 「预感」 có nghĩa là gì?","options":["điềm báo","khoảnh khắc đó","Sao Kim","tỏa sáng"],"answer_index":0,"explanation":"预感 = điềm báo"},{"question":"Từ 「领会」 có nghĩa là gì?","options":["hiểu","khoảnh khắc đó","Sao Kim","tỏa sáng"