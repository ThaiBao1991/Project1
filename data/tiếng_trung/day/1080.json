_sentence":"","example_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_4afc701e","audio_ref":"m_3cbaa035","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_2b76efab"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Cấu trúc 〜一方 (mặt khác)","level":"N2","explanation":"〜一方 = mặt khác khi so sánh 2 điều: 増える一方、減る.","examples":[{"sentence":"価格は上がる一方、的需要は下がった。","meaning_vi":"Giá tăng, mặt khác nhu cầu giảm."},{"sentence":"人口は安定する一方、増加はしていない。","meaning_vi":"Dân số ổn định, nhưng không tăng."}],"pronunciation_focus":"〜一方 = mặt khác.","common_mistakes":"Đừng dùng 一方 khi chỉ nói 1 điều.","mini_quiz":[{"question":"増える___、減る。","options":["一方","ので","から"],"answer_index":0,"explanation":"Đáp án: 一方"}],"references":[]},{"title":"Thể sai khiến (causative)","level":"N2","explanation":"〜せる/させる = làm cho ai đó: 子供に野菜を食べさせる.","examples":[{"sentence":"子供に野菜を食べさせます。","meaning_vi":"Tôi bắt đầm ăn rau."},{"sentence":"生徒に Residences を書かせます。","meaning_vi":"Tôi bắt học sinh viết bài."}],"pronunciation_focus":"Godan: e/i → せる; ichidan: させる.","common_mistakes":"Không dùng cho hành động tự nguyện của chủ thể.","mini_quiz":[{"question":"子供に野菜を___ます。","options":["食べさせ","食べさせられ","食べ"],"answer_index":0,"explanation":"Đáp án: 食べさせ"}],"references":[]},{"title":"Ngữ điệu mời gọi (〜ませんか)","level":"N1","explanation":"〜ませんか = mời gọi lịch sự: 一緒に行きませんか.","examples":[{"sentence":"一緒に行きませんか。","meaning_vi":"Đi cùng nhé?"},{"sentence":"お\tSushi食べませんか。","meaning_vi":"Ăn sushi không?"},{"sentence":"ちょっと喝茶しませんか。","meaning_vi":"Uống trà một chút nhé?"}],"pronunciation_focus":"Dấu hiệu trình độ cao — cần mở lời, không dùng để khoe.","common_mistakes":"Không dùng với người trẻ hoặc khi nói quá nhiều lần.","mini_quiz":[{"question":"___ませんか (mời ăn cơm)","options":["一緒","食べ","行きます"],"answer_index":0,"explanation":"Đáp án: 一緒"}],"references":[]},{"title":"Mức chắc chắn (に違いない / だろう / かもしれない)","level":"N1","explanation":"Ba mức: 〜に違いない (chắc chắn) · 〜だろう (chắc là) · 〜かもしれない (có lẽ).","examples":[{"sentence":"明日は雨に違いない。","meaning_vi":"Ngày mai chắc chắn mưa."},{"sentence":"明日は雨だろう。","meaning_vi":"Ngày mai chắc là mưa."},{"sentence":"明日は雨かもしれない。","meaning_vi":"Ngày mai có lẽ mưa."}],"pronunciation_focus":"Sắc xếp: 違いない > だろう > かもしれない.","common_mistakes":"Đừng dùng だろう trong văn viết trang trọng.","mini_quiz":[{"question":"明日は雨___。","options":["に違いない","かもしれない","かも"],"answer_index":0,"explanation":"Đáp án: に違いない"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1080","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"民工を 使います。","line_vi":"Tôi dùng 民工.","focus_words":["民工"]},{"speaker":"B","line_target":"求学 は 何ですか。","line_vi":"求学 là cái gì?","focus_words":["求学"]},{"speaker":"A","line_target":"汇聚です。","line_vi":"Đó là 汇聚.","focus_words":["汇聚"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_1a3db926","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「民工」 có nghĩa là gì?","options":["Lao động nhập cư","học tập","tập hợp","thẩm mỹ viện"],"answer_index":0,"explanation":"民工 = Lao động nhập cư"},{"question":"Từ 「求学」 có nghĩa là gì?","options":["học tập","Lao động nhập cư","tập hợp","thẩm mỹ viện"],"answer_index":0,"explanation":"求学 = học tập"},{"question":"Từ 「汇聚」 có nghĩa là gì?","options":["tập hợp","Lao động nhập cư","học tập","thẩm mỹ viện"],"answer_index":0,"explanation":"汇聚 = tập hợp"},{"question":"Từ 「沙龙」 có nghĩa là gì?","options":["thẩm mỹ viện","Lao động nhập cư","học tập","tập hợp"],"answer_index":0,"explanation":"沙龙 = thẩm mỹ viện"},{"question":"Từ 「油气」 có nghĩa là gì?","options":["dầu khí","Lao động nhập cư","học tập","tập hợp"],"answer_index":0,"explanation":"油气 = dầu khí"},{"question":"Từ 「法文」 có nghĩa là gì?","