ách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 781","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"车票を 使います。","line_vi":"Tôi dùng 车票.","focus_words":["车票"]},{"speaker":"B","line_target":"迈克尔 は 何ですか。","line_vi":"迈克尔 là cái gì?","focus_words":["迈克尔"]},{"speaker":"A","line_target":"运河です。","line_vi":"Đó là 运河.","focus_words":["运河"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_8da90f4d","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「车票」 có nghĩa là gì?","options":["vé","Michael","con kênh","giáo dục nâng cao"],"answer_index":0,"explanation":"车票 = vé"},{"question":"Từ 「迈克尔」 có nghĩa là gì?","options":["Michael","vé","con kênh","giáo dục nâng cao"],"answer_index":0,"explanation":"迈克尔 = Michael"},{"question":"Từ 「运河」 có nghĩa là gì?","options":["con kênh","vé","Michael","giáo dục nâng cao"],"answer_index":0,"explanation":"运河 = con kênh"},{"question":"Từ 「进修」 có nghĩa là gì?","options":["giáo dục nâng cao","vé","Michael","con kênh"],"answer_index":0,"explanation":"进修 = giáo dục nâng cao"},{"question":"Từ 「迟迟」 có nghĩa là gì?","options":["chichi","vé","Michael","con kênh"],"answer_index":0,"explanation":"迟迟 = chichi"},{"question":"Từ 「送往」 có nghĩa là gì?","options":["gửi đến","vé","Michael","con kênh"],"answer_index":0,"explanation":"送往 = gửi đến"},{"question":"Từ 「送来」 có nghĩa là gì?","options":["giao hàng","vé","Michael","con kênh"],"answer_index":0,"explanation":"送来 = giao hàng"},{"question":"Từ 「逆转」 có nghĩa là gì?","options":["Đảo ngược","vé","Michael","con kênh"],"answer_ind