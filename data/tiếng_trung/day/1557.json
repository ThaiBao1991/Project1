":"た gần đuôi, thanh điệu cao.","common_mistakes":"Vừa xảy ra ⇒ 〜ています; đã xong ⇒ 〜ました.","mini_quiz":[{"question":"昨日、本を___。","options":["読みました","読んでいます","読みません"],"answer_index":0,"explanation":"Đáp án: 読みました"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1557","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"幻影を 使います。","line_vi":"Tôi dùng 幻影.","focus_words":["幻影"]},{"speaker":"B","line_target":"得逞 は 何ですか。","line_vi":"得逞 là cái gì?","focus_words":["得逞"]},{"speaker":"A","line_target":"德黑兰です。","line_vi":"Đó là 德黑兰.","focus_words":["德黑兰"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_c8a6a098","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「幻影」 có nghĩa là gì?","options":["bóng ma","thành công","Tehran","gầm lên"],"answer_index":0,"explanation":"幻影 = bóng ma"},{"question":"Từ 「得逞」 có nghĩa là gì?","options":["thành công","bóng ma","Tehran","gầm lên"],"answer_index":0,"explanation":"得逞 = thành công"},{"question":"Từ 「德黑兰」 có nghĩa là gì?","options":["Tehran","bóng ma","thành công","gầm lên"],"answer_index":0,"explanation":"德黑兰 = Tehran"},{"question":"Từ 「怒吼」 có nghĩa là gì?","options":["gầm lên","bóng ma","thành công","Tehran"],"answer_index":0,"explanation":"怒吼 = gầm lên"},{"question":"Từ 「恨不得」 có nghĩa là gì?","options":["không thể chờ đợi","bóng ma","thành công","Tehran"],"answer_index":0,"explanation":"恨不得 = không thể chờ đợi"},{"question":"Từ 「悬赏」 có nghĩa là gì?","options":["Tiền thưởng","bóng ma","thành công","Tehran"],"answer_index":0,"explanation":"悬赏 = Tiền thưởng"},{"question":"Từ 「情谊」 có nghĩa là gì?","options":["tình bạn","bóng ma","thành công","Tehran"],"answer_index":0,"explanation":"情谊 = tình bạn"},{"question":"Từ 「惨剧」 có nghĩa là gì?","options":["Bi kịch","bóng ma","thành công","Tehran"],"answer_index":0,"ex