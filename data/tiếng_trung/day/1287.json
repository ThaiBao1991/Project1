_meaning_vi":"","phonetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_85ed823b","audio_ref":"m_bafbecfd","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_d90b8264"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Ngữ điệu kính ngữ (keigo công sở)","level":"N1","explanation":"Kính ngữ trong công việc: ございます / いたします / いただきます.","examples":[{"sentence":"お水having いただきます。","meaning_vi":"Tôi lấy nước nhé."},{"sentence":"Jc rec 确实いたします。","meaning_vi":"Tôi xác nhận sẽ tham dự."}],"pronunciation_focus":"Cấu trúc: 意向動詞 + いたします/いただきます.","common_mistakes":"Kính ngữ phải tự nhiên, không máy móc.","mini_quiz":[{"question":"お水___。","options":["いただきます","飲みます","飲み"],"answer_index":0,"explanation":"Đáp án: いただきます"}],"references":[]},{"title":"Trợ từ は (wa) — chủ thể","level":"N5","explanation":"は đặt sau danh từ/tính từ để chỉ ra CHỦ THỂ của câu. Dùng để giới thiệu và hỏi đáp.","examples":[{"sentence":"私は学生です。","meaning_vi":"Tôi là sinh viên."},{"sentence":"これは本です。","meaning_vi":"Đây là một cuốn sách."}],"pronunciation_focus":"は đọc là 'wa' nhưng là dấu chủ thể, không phải trợ từ bao hình.","common_mistakes":"Đừng dùng は khi cần phủ định (⇒ が) hoặc khi nhấn mạnh chủ thể.","mini_quiz":[{"question":"___ は学生です。","options":["私","教室","猫"],"answer_index":0,"explanation":"Đáp án: 私"}],"references":[]},{"title":"Trợ từ が (ga) — chủ thể nhấn mạnh","level":"N5","explanation":"が dùng khi câu trả lời 'ai?', khi có từ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]},{"title":"Trợ từ を (o) — tân từ","level":"N5","explanation":"を đặt sau danh từ để chỉ TÂN TỪ (vật bị tác động).","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đọc sách."},{"sentence":"ご飯を食べました。","meaning_vi":"Tôi đã ăn cơm."}],"pronunciation_focus":"を đọc 'o'.","common_mistakes":"Không dùng を cho chủ thể (⇒ が) hay nơi chốn (⇒ に).","mini_quiz":[{"question":"___ を買います。","options":["本","先生","学校"],"answer_index":0,"explanation":"Đáp án: 本"}],"references":[]}],"dialogue":[{"title":"Trung cấp công việc — Ngày 1287","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"并称を 使います。","line_vi":"Tôi dùng 并称.","focus_words":["并称"]},{"speaker":"B","line_target":"弱者 は 何ですか。","line_vi":"弱者 là cái gì?","focus_words":["弱者"]},{"speaker":"A","line_target":"心怀です。","line_vi":"Đó là 心怀.","focus_words":["心怀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_5713dfc3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「并称」 có nghĩa là gì?","options":["Cùng nhau","yếu đuối","trân trọng","trung thành"],"answer_index":0,"explanation":"并称 = Cùng nhau"},{"question":"Từ 「弱者」 có nghĩa là gì?","options":["yếu đuối","Cùng nhau","trân trọng","trung thành"],"answer_index":0,"explanation":"弱者 = yếu đuối"},{"question":"Từ 「心怀」 có nghĩa là gì?","options":["trân trọng","Cùng nhau","yếu đuối","trung thành"],"answer_index":0,"explanation":"心怀 = trân trọng"},{"question":"Từ 「忠心」 có nghĩa là gì?","options":["trung thành","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"忠心 = trung thành"},{"question":"Từ 「性关系」 có nghĩa là gì?","options":["quan hệ tình dục","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"性关系 = quan hệ tình dục"},{"question":"Từ 「怨恨」 có nghĩa là gì?","options":["Oán giận","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"怨恨 = Oán giận"},{"question":"Từ 「总在」 có nghĩa là gì?","options":["luôn ở đó","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"总在 = luôn ở đó"},{"question":"Từ 「恐怖组织」 có nghĩa là gì?","options":["tổ chức khủng bố","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"恐怖组织 = tổ chức khủng bố"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Cùng nhau","options":["并称","弱者","心怀","忠心"],"answer_index":0,"explanation":"并称 = Cùng nhau"},{"question":"Chọn từ đúng cho nghĩa: yếu đuối","options":["弱者","并称","心怀","忠心"],"answer_index":0,"explanation":"弱者 = yếu đuối"}],"common":[],"grammar":[],"mixed":[]},"source":"offline","media":{"vocab_audio":{"并称":"m_42aad1fd","弱者":"m_7e8c698c","心怀":"m_6f4c1bad","忠心":"m_7c255054","性关系":"m_dede5b38","怨恨":"m_7a67299e","总在":"m_b288d7dc","恐怖组织":"m_33dc81b3","悠闲":"m_3b93f806","意在":"m_bafbecfd"},"dialogue_audio":{"0":"m_5713dfc3"}},"media_map":{"m_77f3ed96":"media/tiếng_trung/d1287/word_00_de8ae4c6.webp","m_c4ba0d94":"media/tiếng_trung/d1287/word_01_8cc5117f.webp","m_ef3497fe":"media/tiếng_trung/d1287/word_02_c8b5df3b.webp","m_3ba280ad":"media/tiếng_trung/d1287/word_03_78b4b86e.webp","m_15f414ec":"media/tiếng_trung/d1287/word_04_c137431c.webp","m_5aa37e1e":"media/tiếng_trung/d1287/word_05_760d0deb.webp","m_53f953ef":"media/tiếng_trung/d1287/word_06_7dccc4f3.webp","m_2fa4cf93":"media/tiếng_trung/d1287/word_07_b7fdb603.webp","m_2c4cc2ea":"media/tiếng_trung/d1287/word_08_927ceb38.webp","m_85ed823b":"media/tiếng_trung/d1287/word_09_cb7b257f.webp","m_42aad1fd":"media/tiếng_trung/d1287/audio_vocab_00_18047153.mp3","m_80b79651":"media/tiếng_trung/d1287/audio_vocab_00_vi_e3914aa2.mp3","m_7e8c698c":"media/tiếng_trung/d1287/audio_vocab_01_764bffc9.mp3","m_034737f8":"media/tiếng_trung/d1287/audio_vocab_01_vi_3ddf50d2.mp3","m_6f4c1bad":"media/tiếng_trung/d1287/audio_vocab_02_55a64b3b.mp3","m_95583d01":"media/tiếng_trung/d1287/audio_vocab_02_vi_50126acb.mp3","m_7c255054":"media/tiếng_trung/d1287/audio_vocab_03_47dc600c.mp3","m_d6eca75a":"media/tiếng_trung/d1287/audio_vocab_03_vi_47dc600c.mp3","m_dede5b38":"media/tiế