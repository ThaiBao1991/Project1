":"N5","turns":[{"speaker":"A","line_target":"并称を 使います。","line_vi":"Tôi dùng 并称.","focus_words":["并称"]},{"speaker":"B","line_target":"弱者 は 何ですか。","line_vi":"弱者 là cái gì?","focus_words":["弱者"]},{"speaker":"A","line_target":"心怀です。","line_vi":"Đó là 心怀.","focus_words":["心怀"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":null,"difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「并称」 có nghĩa là gì?","options":["Cùng nhau","yếu đuối","trân trọng","trung thành"],"answer_index":0,"explanation":"并称 = Cùng nhau"},{"question":"Từ 「弱者」 có nghĩa là gì?","options":["yếu đuối","Cùng nhau","trân trọng","trung thành"],"answer_index":0,"explanation":"弱者 = yếu đuối"},{"question":"Từ 「心怀」 có nghĩa là gì?","options":["trân trọng","Cùng nhau","yếu đuối","trung thành"],"answer_index":0,"explanation":"心怀 = trân trọng"},{"question":"Từ 「忠心」 có nghĩa là gì?","options":["trung thành","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"忠心 = trung thành"},{"question":"Từ 「性关系」 có nghĩa là gì?","options":["quan hệ tình dục","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"性关系 = quan hệ tình dục"},{"question":"Từ 「怨恨」 có nghĩa là gì?","options":["Oán giận","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"怨恨 = Oán giận"},{"question":"Từ 「总在」 có nghĩa là gì?","options":["luôn ở đó","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"总在 = luôn ở đó"},{"question":"Từ 「恐怖组织」 có nghĩa là gì?","options":["tổ chức khủng bố","Cùng nhau","yếu đuối","trân trọng"],"answer_index":0,"explanation":"恐怖组织 = tổ chức khủng bố"}],"pattern":[{"question":"Chọn từ đúng cho nghĩa: Cùng nhau","options":["并称","弱者","心怀","忠心"],"answer_index":0,"explanation":"并称 = Cùng nhau"},{"question":"Chọn từ đúng cho nghĩa: yếu đuối","options":["弱者","并称","心怀","忠心"],"answer_index":0,"explanation":"弱者 = yếu đ