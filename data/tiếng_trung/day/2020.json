ừ đứng sau, hoặc khi nhấn mạnh chủ thể.","examples":[{"sentence":"誰ですか。— 田中さんです。","meaning_vi":"Ai đấy? — Anh Tanaka."},{"sentence":"猫がいます。","meaning_vi":"Có con mèo."}],"pronunciation_focus":"が đọc 'ga'.","common_mistakes":"Đừng dùng が cho chủ thể mới (⇒ は).","mini_quiz":[{"question":"これは私___ です。","options":["が","を","へ"],"answer_index":0,"explanation":"Đáp án: が"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 2020","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"机油を 使います。","line_vi":"Tôi dùng 机油.","focus_words":["机油"]},{"speaker":"B","line_target":"李娜 は 何ですか。","line_vi":"李娜 là cái gì?","focus_words":["李娜"]},{"speaker":"A","line_target":"杏仁です。","line_vi":"Đó là 杏仁.","focus_words":["杏仁"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_9e379976","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「机油」 có nghĩa là gì?","options":["dầu động cơ","Lý Na","hạnh nhân","Tiaozi"],"answer_index":0,"explanation":"机油 = dầu động cơ"},{"question":"Từ 「李娜」 có nghĩa là gì?","options":["Lý Na","dầu động cơ","hạnh nhân","Tiaozi"],"answer_index":0,"explanation":"李娜 = Lý Na"},{"question":"Từ 「杏仁」 có nghĩa là gì?","options":["hạnh nhân","dầu động cơ","Lý Na","Tiaozi"],"answer_index":0,"explanation":"杏仁 = hạnh nhân"},{"question":"Từ 「条子」 có nghĩa là gì?","options":["Tiaozi","dầu động cơ","Lý Na","hạnh nhân"],"answer_index":0,"explanation":"条子 = Tiaozi"},{"question":"Từ 「松动」 có nghĩa là gì?","options":["lỏng lẻo","dầu động cơ","Lý Na","hạnh nhân"],"answer_index":0,"explanation":"松动 = lỏng lẻo"},{"question":"Từ 「极有」 có nghĩa là gì?","options":["Rất nhiều","dầu động cơ","Lý Na","hạnh nhân"],"answer_index":0,"explanation":"极有 = Rất nhiều"},{"question":"Từ 「果冻」 có nghĩa là gì?","options":["thạch","dầu động cơ","Lý Na","hạnh nhân"],"answer_index":0,"explana