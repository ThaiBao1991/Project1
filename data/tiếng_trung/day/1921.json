llables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_d20313f2","audio_ref":"m_d1feacdf","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_c7e9f686"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ Ichidan (う-ending)","level":"N4","explanation":"Nhóm ichidan bỏ 'ru' để gốc: 書く→書きます, 泳ぐ→泳ぎます, 死ぬ→死にます.","examples":[{"sentence":"手紙を書きます。","meaning_vi":"Tôi viết thư."},{"sentence":"川で泳ぎます。","meaning_vi":"Tôi bơi ở sông."}],"pronunciation_focus":"Ichidan: chỉ đổi cuối (ru→い, mu→み, nu→に, bu→び, gu→ぎ).","common_mistakes":"Đừng động trực tiếp ichidan (書く ✗ → 書きます ✓).","mini_quiz":[{"question":"手紙を___ます。","options":["書き","書か","書きれ"],"answer_index":0,"explanation":"Đáp án: 書き"}],"references":[]},{"title":"Động từ Godan (u-ending)","level":"N4","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Động từ kép (compound)","level":"N4","explanation":"Ghép 2 động từ: 読む + ます = 読みます (đang đọc) — ichidan chuyển sang TE.","examples":[{"sentence":"本を読みます。","meaning_vi":"Tôi đang đọc sách."},{"sentence":" Marines beaucoup。","meaning_vi":"Cô ấy chạy nhanh."}],"pronunciation_focus":"Khi ghép: ichidan → TE (書く→書いて).","common_mistakes":"Đừng lẫn với ichidan thường.","mini_quiz":[{"question":"本を読み___。","options":["ます","た","ない"],"answer_index":0,"explanation":"Đáp án: ます"}],"references":[]},{"title":"Thì tương lai / thói quen","level":"N4","explanation":"Động từ gốc + ます diễn tả tương lai hoặc thói quen.","examples":[{"sentence":"明日、旅行に行きます。","meaning_vi":"Ngày mai tôi sẽ đi du lịch."},{"sentence":"毎日、走ります。","meaning_vi":"Tôi chạy mỗi ngày."}],"pronunciation_focus":"Tương lai không dùng ました.","common_mistakes":"Đừng dùng ます sau ました.","mini_quiz":[{"question":"明日、___ます。","options":["食べました","食べます","食べない"],"answer_index":1,"explanation":"Đáp án: 食べます"}],"references":[]}],"dialogue":[{"title":"Cao cấp học thuật — Ngày 1921","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"动武を 使います。","line_vi":"Tôi dùng 动武.","focus_words":["动武"]},{"speaker":"B","line_target":"北路 は 何ですか。","line_vi":"北路 là cái gì?","focus_words":["北路"]},{"speaker":"A","line_target":"千秋です。","line_vi":"Đó là 千秋.","focus_words":["千秋"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_04e85f01","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「动武」 có nghĩa là gì?","options":["Dùng vũ lực","Đường Bắc","Tiền Thu","khuyến mãi"],"answer_index":0,"explanation":"动武 = Dùng vũ lực"},{"question":"Từ 「北路」 có nghĩa là gì?","options":["Đường Bắc","Dùng vũ lực","Tiền Thu","khuyến mãi"],"answer_index":0,"explanation":"北路 = Đường Bắc"},{"question":"Từ 「千秋」 có nghĩa là gì?","options":["Tiền Thu","Dùng vũ lực","Đường Bắc","khuyến mãi"],"answer_index":0,"explanation":"千秋 = Tiền Thu"},{"question":"Từ 「升职」 có nghĩa là gì?","options":["khuyến mãi","Dùng vũ lực","Đường Bắc","Tiền Thu"],"answer_index":0,"explanation":"升职 = khuyến mãi"},{"question":"Từ 「华莱士」 có nghĩa là gì?","options":["Wallace","Dùng vũ lực","Đường Bắc","Tiền Thu"],"answer_index":0,"explanation":"华莱士 = Wallace"},{"question":"Từ 「南县」 có nghĩa là gì?","options":["huyện Nam","Dùng vũ lực","Đường Bắc","Tiền Thu"],"answer_index":0,"explanation":"南县 = huyện Nam"},{"question":"Từ 「南口」 có nghĩa là gì?","options":["lối vào phía nam","Dùng vũ lực","Đường Bắc","Tiền Thu"],"answer_index":0,"explanation":"南口 = lối vào phía nam"},{"question":"Từ 「卷烟」 có nghĩa là gì?","options":["thuốc lá",