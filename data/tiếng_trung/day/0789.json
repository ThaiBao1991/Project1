onetic_note":"","syllables":[],"pos":"","example_target":"","example_vi":"","image_prompt":null,"image_ref":"m_f743b1ed","audio_ref":"m_1d42c404","pitch_accent":"","rhymes":[],"etymology":"","sources":[],"meaning_audio_ref":"m_2f17fb52"}],"sentence_patterns":[],"common_sentences":[],"grammar":[{"title":"Động từ godan (u-ending)","level":"N5","explanation":"Nhóm godan đổi e/i → imasu: 飲む→飲みます, 死ぬ→死にます, 待つ→待ちます.","examples":[{"sentence":"水を飲みます。","meaning_vi":"Tôi uống nước."},{"sentence":"友達を待ちます。","meaning_vi":"Tôi đợi bạn."}],"pronunciation_focus":"Godan: đổi e hoặc i ở cuối.","common_mistakes":"Đừng dùng 飲ます (sai) → 飲みます.","mini_quiz":[{"question":"水を___ます。","options":["飲み","飲ま","飲みれ"],"answer_index":0,"explanation":"Đáp án: 飲み"}],"references":[]},{"title":"Tính từ na-ending (い)","level":"N5","explanation":"Tính từ bỏ 'i' gốc + くない: 高い→高くない, 安い→安くない.","examples":[{"sentence":"この本は安いです。","meaning_vi":"Cuốn sách này rẻ."},{"sentence":"この本は安くないです。","meaning_vi":"Cuốn sách này không rẻ."}],"pronunciation_focus":"Tính từ i-adjective đọc bằng 'i'.","common_mistakes":"Tính từ na-adjective (静か, 元気) không dùng くない.","mini_quiz":[{"question":"この本は___くないです。","options":["高い","高","安"],"answer_index":0,"explanation":"Đáp án: 高い"}],"references":[]},{"title":"Cách phủ định với ない + noun","level":"N4","explanation":"Không có (的存在) dùng がありません / ありません: お金がない.","examples":[{"sentence":"お金がありません。","meaning_vi":"Tôi không có tiền."},{"sentence":"時間がないです。","meaning_vi":"Không có thời gian."}],"pronunciation_focus":"Không dùng は cho chủ thể khi phủ định.","common_mistakes":"Đừng dùng は + ない.","mini_quiz":[{"question":"お金が___。","options":["ありません","あります","です"],"answer_index":0,"explanation":"Đáp án: ありません"}],"references":[]},{"title":"Mệnh đề mô tả (です/ます)","level":"N4","explanation":"Kết hợp tính từ + です, danh từ + です, hoặc danh từ + が + danh từ.","examples":[{"sentence":"田中さんは医者です。","meaning_vi":"Anh Tanaka là bác sĩ."},{"sentence":"机の上に本があります。","meaning_vi":"Trên bàn có sách."}],"pronunciation_focus":"は cho chủ thể, が cho chủ ngữ.","common_mistakes":"Đừng dùng profession sau が (× お医者さんがです).","mini_quiz":[{"question":"田中さんは___です。","options":["医者","医者です","医者でした"],"answer_index":0,"explanation":"Đáp án: 医者"}],"references":[]}],"dialogue":[{"title":"Sơ cấp đời sống — Ngày 789","situation":"Hội thoại ngắn dùng từ của bài hôm nay.","level_tag":"N5","turns":[{"speaker":"A","line_target":"尽早を 使います。","line_vi":"Tôi dùng 尽早.","focus_words":["尽早"]},{"speaker":"B","line_target":"巡抚 は 何ですか。","line_vi":"巡抚 là cái gì?","focus_words":["巡抚"]},{"speaker":"A","line_target":"巧妙です。","line_vi":"Đó là 巧妙.","focus_words":["巧妙"]},{"speaker":"B","line_target":"はい、わかりました。","line_vi":"Vâng, tôi hiểu rồi.","focus_words":[]}],"cultural_note":"Hội thoại tối giản luyện phản xạ.","kind":"micro","audio_ref":"m_d28279f3","difficulty":"","new_words":[],"grammar_used":""}],"quiz":{"vocab":[{"question":"Từ 「尽早」 có nghĩa là gì?","options":["càng sớm càng tốt","thống đốc","khéo léo","khổng lồ"],"answer_index":0,"explanation":"尽早 = càng sớm càng tốt"},{"question":"Từ 「巡抚」 có nghĩa là gì?","options":["thống đốc","càng sớm càng tốt","khéo léo","khổng lồ"],"answer_index":0,"explanation":"巡抚 = thống đốc"},{"question":"Từ 「巧妙」 có nghĩa là gì?","options":["khéo léo","càng sớm càng tốt","thống đốc","khổng lồ"],"answer_index":0,"explanation":"巧妙 = khéo léo"},{"question":"Từ 「巨型」 có nghĩa là gì?","options":["khổng lồ","càng sớm càng tốt","thống đốc","khéo léo"],"answer_index":0,"explanation":"巨型 = khổng lồ"},{"question":"Từ 「市内」 có nghĩa là gì?","options":["trong thành phố","càng sớm càng tốt","thống đốc","khéo léo"],"answer_index":0,"explanation":"市内 = trong thành phố"},{"question":"Từ 「帝王」 có nghĩa là gì?","options":["hoàng đế","càng sớm càng tốt","thống đốc","khéo léo"],"answer_index":0,"explanation":"帝王 = hoàng đế"},{"question":"Từ 「平方」 có nghĩa là gì?","options":["hình vuông","càng sớm càng tốt","thống đốc","khéo léo"],"answer_index":0,"explanation":"平方 = hình vuông"},{"question":"Từ 「幻觉」 c